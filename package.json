{
  "name": "concept-boardgame",
  "version": "5.3.0",
  "dependencies": {
    "body-parser": "^1.20.4",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "ent": "^2.2.2",
    "express": "^4.22.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.2",
    "mongoose": "^9.0.2",
    "socket.io": "^4.8.1",
    "uuid": "^8.3.2"
  },
  "scripts": {
    "dev": "nodemon scripts/dev-server.js",
    "dev:simple": "node scripts/dev-server.js",
    "dev:fast": "bash scripts/dev-from-tmp.sh",
    "assets:fetch": "node scripts/fetch-game-assets.js",
    "assets:icons": "node scripts/fetch-game-icons.js",
    "start": "node app.js",
    "check:db": "node scripts/uploadStats.js",
    "season:reset": "node scripts/reset-season.js",
    "plan:werewolf:3": "node scripts/werewolf-role-rotation.js",
    "smoke:rooms": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-room-flow.js",
    "smoke:blackmarket": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-blackmarket-flow.js",
    "smoke:blackmarket:lobby:browser": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/browser-blackmarket-lobby.js",
    "smoke:blackmarket:board:browser": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/browser-blackmarket-board.js",
    "smoke:blackmarket:stats": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/integration-blackmarket-stats.js",
    "smoke:spyfall": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-spyfall.js",
    "smoke:spyfall:mobile": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/browser-spyfall-mobile.js",
    "smoke:werewolf": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-werewolf-flow.js && ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-werewolf-reveal-miss.js",
    "smoke:werewolf:mobile": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/browser-werewolf-mobile.js",
    "smoke:werewolf:selection": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-werewolf-selection.js",
    "smoke:werewolf:roles": "node scripts/smoke-werewolf-role-rules.js",
    "smoke:werewolf:reveal-miss": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-werewolf-reveal-miss.js",
    "smoke:werewolf:5": "ALLOW_LEGACY_SOCKET_IDENTITY=1 SMOKE_WEREWOLF_CASE=5 node scripts/smoke-werewolf-balance.js",
    "smoke:werewolf:6": "ALLOW_LEGACY_SOCKET_IDENTITY=1 SMOKE_WEREWOLF_CASE=6 node scripts/smoke-werewolf-balance.js",
    "smoke:admin:chat": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-admin-room-chat.js",
    "smoke:admin:inbox": "node scripts/smoke-admin-inbox.js",
    "smoke:admin:inbox:browser": "node scripts/smoke-admin-inbox-browser.js",
    "smoke:avatar:frame": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-avatar-frame.js",
    "smoke:room:cleanup": "ALLOW_LEGACY_SOCKET_IDENTITY=1 node scripts/smoke-room-cleanup.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "playwright": "^1.58.2",
    "socket.io-client": "^4.8.3"
  }
}

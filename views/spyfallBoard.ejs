<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/chatPanel.css">
<style>
  * { box-sizing: border-box; }

  /* clip (ไม่ใช่ hidden) — hidden ทำให้ body เป็น scroll container แล้วแถบเวลา sticky ไม่ติดจอ */
  html.sf-active,
  html.sf-active body.content {
    overflow-x: clip;
    margin: 0 !important;
    padding: 0 !important;
    background: #071318 !important;
  }

  /* เจาะจงแบนเนอร์ของ layout — เดิม selector กว้างไปจนกิน <div class="sf-topbar"> ของกระดานเอง */
  html.sf-active .container-fluid > header,
  html.sf-active .footer {
    display: none !important;
  }

  html.sf-active .container-fluid {
    overflow: clip !important;
    padding: 0 !important;
    margin: 0 !important;
    max-width: none !important;
  }

  html.sf-active .container-fluid > .row {
    margin: 0 !important;
  }

  html.sf-active .col-lg-12 {
    padding: 0 !important;
  }

  html.sf-active #music-controls {
    display: none !important;
  }

  :root {
    --sf-bg: #071318;
    --sf-panel: rgba(12, 28, 34, 0.92);
    --sf-line: rgba(94, 234, 212, 0.14);
    --sf-teal: #5eead4;
    --sf-amber: #fbbf24;
    --sf-red: #f87171;
    --sf-text: #ecfdf5;
    --sf-muted: #94a3b8;
  }

  body.content {
    background:
      radial-gradient(circle at 12% 8%, rgba(20, 184, 166, 0.18), transparent 24%),
      radial-gradient(circle at 88% 0%, rgba(251, 191, 36, 0.1), transparent 20%),
      linear-gradient(180deg, #071318 0%, #0b1f24 100%);
  }

  .sf-connection {
    display: none;
    position: fixed;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10001;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--sf-amber);
    color: #111;
    font-weight: 700;
  }

  .sf-page {
    max-width: 920px;
    /* เผื่อที่ให้ปุ่มแชทมุมล่าง ไม่ให้บังปุ่มยืนยันโหวต/เล่นอีกรอบ */
    margin: 16px auto 96px;
    padding: 12px;
    color: var(--sf-text);
    font-family: 'Bai Jamjuree', sans-serif;
  }

  .sf-shell {
    border: 1px solid var(--sf-line);
    border-radius: 28px;
    background: var(--sf-panel);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
    overflow: clip;
  }

  .sf-topbar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 20px 22px;
    border-bottom: 1px solid var(--sf-line);
    background: linear-gradient(135deg, rgba(20, 184, 166, 0.12), rgba(7, 19, 24, 0.9));
  }

  .sf-kicker {
    color: var(--sf-teal);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sf-title {
    margin: 4px 0 0;
    font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif;
    font-size: clamp(1.4rem, 4vw, 2rem);
    color: var(--sf-text);
  }

  .sf-subtitle { color: var(--sf-muted); margin: 6px 0 0; }

  .sf-top-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: flex-start;
    justify-content: flex-end;
  }

  .sf-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--sf-line);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sf-text);
  }

  .sf-chip-btn {
    min-height: 44px;
    cursor: pointer;
    color: var(--sf-text);
    font-family: inherit;
  }

  .sf-chip-danger { border-color: rgba(248, 113, 113, 0.35); color: #fecaca; }
  .sf-chip-exit { border-color: rgba(248, 113, 113, 0.6); color: #fecaca; background: rgba(248, 113, 113, 0.1); font-weight: 700; }
  .sf-round-chip { color: var(--sf-amber); }

  /* กล่าวหา / ไล่กล่าวหา / คะแนน */
  .sf-accuse { text-align: center; }
  .sf-accuse-head { font-size: 0.86rem; font-weight: 700; color: var(--sf-amber); letter-spacing: 0.04em; }
  .sf-accuse-who { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 10px 0 6px; font-size: 1.15rem; overflow-wrap: anywhere; }
  .sf-accuse-count { color: var(--sf-teal); font-weight: 700; margin-bottom: 10px; }
  .sf-yn { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sf-yn .ui-btn { min-height: 56px; font-size: 1.05rem; }
  .sf-accuse-btn { width: 100%; margin-top: 10px; border-color: rgba(251, 191, 36, 0.55) !important; color: #fde68a !important; }
  .sf-points { display: grid; gap: 6px; margin: 12px auto 0; max-width: 360px; text-align: left; }
  .sf-points-row { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 10px; background: rgba(255,255,255,0.04); }
  .sf-points-row.is-top { background: rgba(251, 191, 36, 0.12); }
  .sf-points-row span:first-child { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .sf-points-row .sf-plus { color: #6ee7b7; font-weight: 700; flex: none; }
  .sf-points-row .sf-total { color: var(--sf-amber); font-weight: 700; flex: none; min-width: 3.2em; text-align: right; }
  .sf-points-title { margin: 14px 0 0; font-weight: 700; color: var(--sf-teal); }
  .sf-match-win { margin: 10px auto 0; padding: 10px 12px; border-radius: 14px; background: rgba(251, 191, 36, 0.12); color: #fde68a; font-weight: 700; max-width: 360px; }
  .sf-phase { color: var(--sf-teal); }

  /* แถบ "ตอนนี้" ติดบนจอ: เฟส + เวลาเหลือเห็นตลอด ไม่ต้องเลื่อนหา (สายลับมีรายชื่อสถานที่ยาว) */
  .sf-now-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 22px;
    border-bottom: 1px solid var(--sf-line);
    background: #0b1d22;
  }
  .sf-now-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .sf-now-timer {
    flex: none;
    font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sf-amber);
    font-variant-numeric: tabular-nums;
  }
  .sf-now-timer.is-urgent { color: var(--sf-red); }
  .sf-now-timer.is-idle { display: none; }

  .sf-now-label {
    white-space: nowrap;
    color: var(--sf-teal);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sf-now-copy { color: var(--sf-text); font-size: 1rem; }
  .sf-grid { padding: 18px 22px 24px; }
  .sf-main { display: flex; flex-direction: column; }
  /* ช่วงโหวต/เฉลย: เอาการ์ดที่ต้องกดขึ้นก่อนการ์ดบท */
  .sf-main.stage-first .sf-card-stage { order: -1; }

  .sf-card {
    border: 1px solid var(--sf-line);
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.18);
    padding: 16px;
    margin-bottom: 14px;
  }

  .sf-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .sf-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--sf-teal);
  }

  .sf-timer {
    font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif;
    font-size: 1.4rem;
    color: var(--sf-amber);
  }

  .sf-role-card {
    text-align: center;
    padding: 18px 12px;
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(20, 184, 166, 0.12), rgba(0, 0, 0, 0.2));
    border: 1px solid var(--sf-line);
  }

  .sf-role-card.spy {
    background: linear-gradient(145deg, rgba(248, 113, 113, 0.12), rgba(0, 0, 0, 0.2));
    border-color: rgba(248, 113, 113, 0.28);
  }

  .sf-role-icon { font-size: 2.4rem; margin-bottom: 8px; display: flex; align-items: center; justify-content: center; }
  .sf-role-icon .game-icon { width: 96px; height: 96px; object-fit: cover; border-radius: 18px; border: 1px solid rgba(245, 200, 107, 0.35); }
  .sf-role-icon .game-icon-emoji { line-height: 1; }
  .sf-location-pill .game-icon { width: 44px; height: 44px; object-fit: cover; border-radius: 10px; margin: 0; }
  .sf-location-pill .game-icon-emoji { font-size: 1.2rem; margin: 0; }
  button.sf-location-pill { cursor: pointer; font-family: inherit; min-height: 48px; }
  .sf-location-pill.is-out { opacity: 0.35; text-decoration: line-through; }
  .sf-location-pill.is-out .game-icon { filter: grayscale(1); }
  .sf-location-pill {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 84px;
    padding: 8px 6px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255,255,255,0.08);
    font-size: 0.78rem;
    color: #cbd5e1;
    text-align: center;
    line-height: 1.25;
  }
  .sf-role-name { font-size: 1.35rem; font-weight: 700; color: var(--sf-text); }
  .sf-role-summary { color: var(--sf-muted); margin-top: 8px; line-height: 1.45; }

  .sf-location-name {
    font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif;
    font-size: 1.6rem;
    margin: 10px 0 6px;
    color: var(--sf-amber);
  }

  .sf-location-hint { color: #cbd5e1; }

  .sf-location-pool {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 12px;
  }

  .sf-stage-empty {
    text-align: center;
    color: var(--sf-muted);
    padding: 24px 12px;
  }

  .sf-vote-grid { display: grid; gap: 10px; }

  .sf-vote-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px;
    border-radius: 16px;
    border: 1px solid var(--sf-line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--sf-text);
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
    text-align: left;
  }

  .sf-vote-btn:hover:not(:disabled) {
    border-color: rgba(94, 234, 212, 0.4);
    background: rgba(94, 234, 212, 0.08);
  }

  .sf-vote-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .sf-vote-btn strong { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .sf-vote-btn .sf-tag { margin-left: auto; flex: none; font-size: 0.8rem; color: var(--sf-muted); }

  .sf-turn { text-align: center; margin-bottom: 14px; }
  .sf-turn-label { font-size: 0.8rem; font-weight: 700; color: var(--sf-teal); letter-spacing: 0.08em; }
  .sf-turn-name { font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-size: 1.35rem; font-weight: 700; color: var(--sf-text); overflow-wrap: anywhere; }
  .sf-turn.is-me .sf-turn-name { color: var(--sf-amber); }
  .sf-turn-sub { color: var(--sf-muted); font-size: 0.92rem; margin-top: 4px; line-height: 1.45; }
  .sf-section-label { font-size: 0.82rem; color: var(--sf-muted); margin: 12px 0 8px; }
  .sf-ready { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--sf-line); text-align: center; }
  .sf-ready .ui-btn { width: 100%; }
  .sf-ready .ui-btn.is-on { background: rgba(94, 234, 212, 0.18); border-color: rgba(94, 234, 212, 0.55); }
  .sf-ready-note { color: var(--sf-muted); font-size: 0.86rem; margin-top: 6px; }
  .sf-host-row { margin-top: 10px; }
  .sf-host-row .ui-btn { width: 100%; }
  .sf-confirm-bar { position: sticky; bottom: 76px; margin-top: 12px; z-index: 5; }
  .sf-confirm-bar .ui-btn { width: 100%; }
  .sf-pending { text-align: center; color: var(--sf-muted); font-size: 0.86rem; margin-top: 10px; overflow-wrap: anywhere; }

  .sf-recap-me { display: inline-block; padding: 6px 14px; border-radius: 999px; font-weight: 700; margin-bottom: 8px; }
  .sf-recap-me.win { background: rgba(110, 231, 183, 0.16); color: #6ee7b7; }
  .sf-recap-me.lose { background: rgba(248, 113, 113, 0.14); color: #fca5a5; }
  .sf-recap-why { color: var(--sf-text); line-height: 1.5; margin: 6px 0 10px; }
  .sf-roster { display: grid; gap: 6px; margin: 12px auto 0; max-width: 360px; text-align: left; }
  .sf-roster-row { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px; background: rgba(255,255,255,0.04); }
  .sf-roster-row.is-spy { background: rgba(248, 113, 113, 0.12); }
  .sf-roster-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .sf-roster-name small { display: block; color: var(--sf-muted); }
  .sf-roster-votes { flex: none; font-size: 0.86rem; color: var(--sf-muted); }
  .sf-recap-actions { margin-top: 16px; display: grid; gap: 8px; }
  .sf-recap-actions .ui-btn { width: 100%; }
  .sf-return-note { color: var(--sf-muted); font-size: 0.86rem; margin-top: 10px; }

  .sf-role-hide { min-height: 44px; }
  #rolePanel.is-hidden .sf-role-card { display: none; }
  .sf-role-cover {
    display: none;
    width: 100%;
    min-height: 96px;
    border: 1px dashed var(--sf-line);
    border-radius: 18px;
    background: rgba(0,0,0,0.25);
    color: var(--sf-muted);
    font-family: inherit;
    font-size: 1rem;
    cursor: pointer;
  }
  #rolePanel.is-hidden .sf-role-cover { display: block; }

  .sf-guess-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; max-height: 52vh; overflow-y: auto; padding: 2px; }
  .sf-guess-tile {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    min-height: 72px; padding: 8px 4px; border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.05);
    color: #e2e8f0; font-family: inherit; font-size: 0.82rem; cursor: pointer;
  }
  .sf-guess-tile .game-icon { width: 36px; height: 36px; border-radius: 8px; object-fit: cover; margin: 0; }
  .sf-guess-tile.is-out { opacity: 0.4; }
  .sf-guess-tile.is-picked { border-color: var(--sf-amber); background: rgba(251, 191, 36, 0.16); color: #fff; }

  /* นับถอยหลังกลับห้องรอ: แถบเล็กด้านบน ไม่บังเฉลย */
  #returnToLobbyModal.sf-modal { inset: auto 0 auto 0; top: 12px; background: transparent; pointer-events: none; }
  #returnToLobbyModal .sf-modal-card { padding: 10px 18px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border: 1px solid var(--sf-line); }
  #returnToLobbyModal .sf-modal-card h3 { font-size: 1rem; margin: 0; }
  #returnToLobbyModal .sf-modal-card p { margin: 0; }
  #returnToLobbyModal .sf-countdown { font-size: 1.2rem; }
  .sf-vote-btn.selected {
    border-color: rgba(94, 234, 212, 0.55);
    background: rgba(94, 234, 212, 0.14);
  }

  .sf-vote-btn.voted-flag::after {
    content: '✓ โหวตแล้ว';
    margin-left: auto;
    font-size: 0.82rem;
    color: var(--sf-teal);
  }

  .sf-result { text-align: center; padding: 12px 0; }
  .sf-result h3 {
    font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif;
    font-size: 1.3rem;
    margin: 0 0 10px;
  }
  .sf-result.win-citizens h3 { color: #6ee7b7; }
  .sf-result.win-spy h3 { color: #fca5a5; }

  .sf-feed {
    display: grid;
    gap: 8px;
    max-height: 160px;
    overflow-y: auto;
  }

  .sf-feed-item {
    padding: 8px 10px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.92rem;
    color: #cbd5e1;
  }

  .sf-btn {
    border: none;
    border-radius: 12px;
    min-height: 48px;
    padding: 10px 14px;
    font-family: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .sf-btn-primary { background: linear-gradient(135deg, #14b8a6, #0f766e); color: #fff; }
  .sf-btn-alt { background: rgba(255, 255, 255, 0.08); color: #fff; }
  .sf-btn-outline {
    background: transparent;
    border: 1px solid rgba(248, 113, 113, 0.4);
    color: #fecaca;
    width: 100%;
    margin-bottom: 8px;
  }

  .sf-sidebar {
    position: fixed;
    top: 0;
    right: -320px;
    width: min(320px, 88vw);
    height: 100vh;
    background: #0f172a;
    color: #fff;
    z-index: 9000;
    transition: right 0.25s ease;
    padding: 20px;
    overflow-y: auto;
  }

  .sf-sidebar.open { right: 0; }

  .sf-sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 8999;
  }

  #onlinePlayerList { list-style: none; padding: 0; margin: 0 0 16px; }
  #onlinePlayerList li { padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }

  /* แชทกลาง (chatPanel.css) แต่งสีให้เข้ากับธีม Spyfall */
  .chat-box {
    --chat-accent: #14b8a6;
    --chat-accent-dark: #0f766e;
    --chat-surface: linear-gradient(135deg, #0f172a 0%, #0b1f24 100%);
    --chat-border: rgba(94, 234, 212, 0.22);
    --chat-bubble: #1e293b;
    font-family: 'Bai Jamjuree', sans-serif;
  }

  .chat-toggle {
    --chat-toggle-bg: linear-gradient(135deg, #14b8a6, #0f766e);
    border-radius: 999px;
    padding: 12px 18px;
    box-shadow: 0 8px 24px rgba(20, 184, 166, 0.35);
  }

  .btn-chat-send {
    --chat-send-bg: linear-gradient(135deg, #14b8a6, #0f766e);
    --chat-send-color: #fff;
  }

  .sf-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sf-modal-card {
    background: #111827;
    color: #fff;
    padding: 28px 36px;
    border-radius: 16px;
    text-align: center;
  }

  .sf-countdown { font-size: 2rem; color: var(--sf-amber); font-weight: 700; }

  .sf-manual-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 9500;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .sf-manual-card {
    width: min(520px, 100%);
    max-height: 85vh;
    overflow-y: auto;
    background: #0f172a;
    border: 1px solid var(--sf-line);
    border-radius: 20px;
    padding: 20px;
    color: #e2e8f0;
  }

  .sf-manual-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .sf-manual-body ol { padding-left: 20px; line-height: 1.55; }
  .sf-manual-body p { line-height: 1.5; color: #cbd5e1; }

  @media (prefers-reduced-motion: reduce) {
    .sf-sidebar { transition: none; }
  }

  @media (max-width: 640px) {
    .sf-topbar, .sf-grid, .sf-now-bar { padding-left: 14px; padding-right: 14px; }
    .sf-location-pool { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
    .sf-location-pool .sf-location-pill { width: auto; font-size: 0.72rem; padding: 6px 2px; }
    .sf-location-pill .game-icon { width: 34px; height: 34px; }
    .sf-top-meta .sf-chip { font-size: 0.82rem; }
  }
</style>

<div id="connectionStatus" class="sf-connection">กำลัง reconnect...</div>

<div class="sf-page">
  <div class="sf-shell">
    <div class="sf-topbar">
      <div class="sf-brand">
        <div class="sf-kicker">🕶️ สายลับในสถานที่</div>
        <h1 class="sf-title"><%= room.name %></h1>
        <p class="sf-subtitle">ถาม–ตอบให้เนียน แล้วจับสายลับ</p>
      </div>
      <div class="sf-top-meta">
        <button type="button" id="sfExitBtn" class="sf-chip sf-chip-btn sf-chip-exit">🚪 ออก</button>
        <span id="sfRoundChip" class="sf-chip sf-round-chip" style="display:none;"></span>
        <span class="sf-chip">🆔 <%= room.roomId %></span>
        <span class="sf-chip" id="sfPlayerCountChip">👥 <%= room.playerCount %>/<%= room.maxPlayers %></span>
        <span id="phaseChip" class="sf-chip sf-phase">🎭 รอเริ่ม</span>
        <button type="button" id="sfHowToOpen" class="sf-chip sf-chip-btn">📖 วิธีเล่น</button>
        <button type="button" id="sfSidebarBtn" class="sf-chip sf-chip-btn"><i class="fas fa-users"></i> ผู้เล่น</button>
        <%# แสดงเสมอแล้วซ่อนด้วย JS — หัวหน้าห้องคนใหม่ (คนเดิมออก) จะได้ปุ่มทันทีไม่ต้องรีเฟรช %>
        <button type="button" id="sfEndGameBtn" class="sf-chip sf-chip-btn sf-chip-danger"<% if (!room.admin) { %> style="display:none;"<% } %>>⏹ ยุติเกม</button>
      </div>
    </div>

    <div id="sfNowBar" class="sf-now-bar">
      <div class="sf-now-text" aria-live="polite">
        <span class="sf-now-label">ตอนนี้</span>
        <span id="sfNowCopy" class="sf-now-copy">กำลังโหลดเกม...</span>
      </div>
      <div id="timerDisplay" class="sf-now-timer is-idle" aria-label="เวลาเหลือ">--:--</div>
    </div>

    <div class="sf-grid">
      <main class="sf-main" id="sfMain">
        <section class="sf-card sf-card-role">
          <div class="sf-card-header">
            <div class="sf-card-title">🎭 บทของคุณ</div>
            <button type="button" id="sfHideRoleBtn" class="sf-chip sf-chip-btn sf-role-hide" aria-pressed="false">🙈 ซ่อนบท</button>
          </div>
          <div id="rolePanel" class="sf-role-panel"></div>
        </section>

        <section class="sf-card sf-card-stage">
          <div class="sf-card-header">
            <div class="sf-card-title" id="sfStageTitle">🎮 ตาเล่น</div>
          </div>
          <div id="mainStage" class="sf-stage"></div>
        </section>

        <section class="sf-card sf-card-history">
          <div class="sf-card-title">📢 บันทึกเกม</div>
          <div id="historyFeed" class="sf-feed"></div>
        </section>
      </main>
    </div>
  </div>
</div>

<div id="playerSidebar" class="sf-sidebar">
  <div id="onlinePlayers">
    <h4>ผู้เล่นในห้อง</h4>
    <ul id="onlinePlayerList"></ul>
    <% if (room.admin) { %>
    <div class="sf-admin-block">
      <h5>คำสั่งหัวหน้าห้อง</h5>
      <button id="leaveRoomBtn" type="button" class="sf-btn sf-btn-outline">🚪 ออกจากห้อง</button>
    </div>
    <% } else { %>
    <button id="leaveRoomBtn" type="button" class="sf-btn sf-btn-outline">🚪 ออกจากห้อง</button>
    <% } %>
    <button id="closeSidebarBtn" type="button" class="sf-btn sf-btn-alt">ปิด</button>
  </div>
</div>
<div id="sidebarOverlay" class="sf-sidebar-overlay"></div>

<div id="chatBox" class="chat-box" aria-hidden="true" style="display:none;">
  <div class="chat-header">
    <div class="chat-title">💬 แชท</div>
    <button type="button" id="closeChat" class="chat-close" aria-label="ปิดแชท">✕</button>
  </div>
  <div id="replyPreview" class="chat-reply-preview-bar" style="display:none;">
    <div class="reply-content">
      <span class="reply-indicator">ตอบกลับ</span>
      <span class="reply-player-name"></span>:
      <span class="reply-message-content"></span>
    </div>
    <button type="button" class="reply-cancel-btn" aria-label="ยกเลิกการตอบกลับ">✕</button>
  </div>
  <div id="chatMessages" class="chat-messages" role="log" aria-live="polite"></div>
  <div class="chat-input-wrap">
    <textarea id="chatInput" rows="1" placeholder="พิมพ์ข้อความ..." aria-label="พิมพ์ข้อความ"></textarea>
    <button type="button" id="sendChat" class="btn-chat-send" aria-label="ส่ง">ส่ง</button>
  </div>
</div>
<button type="button" id="toggleChat" class="chat-toggle" aria-expanded="false" aria-controls="chatBox">
  💬 แชท <span id="chatUnreadDot" class="unread-dot" style="display:none;"></span>
</button>

<div id="returnToLobbyModal" class="sf-modal" style="display:none;">
  <div class="sf-modal-card">
    <h3>🎮 จบเกมแล้ว!</h3>
    <p>กำลังพากลับห้องรอ...</p>
    <p id="returnCountdown" class="sf-countdown">5</p>
  </div>
</div>

<div id="sfHowToOverlay" class="sf-manual-overlay" style="display:none;">
  <div class="sf-manual-card">
    <div class="sf-manual-header">
      <div>
        <div class="sf-kicker">📖 วิธีเล่น</div>
        <h2>สายลับในสถานที่</h2>
      </div>
      <button type="button" id="sfHowToClose" class="sf-btn sf-btn-alt">ปิด</button>
    </div>
    <div class="sf-manual-body">
      <p><strong>เป้าหมาย:</strong> พลเมืองจับสายลับ · สายลับหลบรอด หรือทายสถานที่ให้ถูก</p>
      <ol>
        <li><strong>เปิดบท</strong> — พลเมืองเห็นสถานที่ + บท · สายลับไม่เห็น</li>
        <li><strong>🎤 ถาม–ตอบ</strong> — เจ้ามือถามก่อน · คนที่ถูกถามตอบ แล้วถามคนอื่นต่อ · ห้ามถามกลับคนที่เพิ่งถามเรา</li>
        <li><strong>🛑 กล่าวหา</strong> — ใครก็หยุดเวลาได้คนละ 1 ครั้งต่อรอบ · ทุกคนยกเว้นคนถูกกล่าวหาต้องเห็นด้วย ✅ · มีคนไม่เห็นด้วย = เวลาเดินต่อ</li>
        <li><strong>🎯 สายลับ</strong> — หยุดเวลาทายสถานที่ได้ 1 ครั้ง ตอนเวลายังเดิน · ถูกชนะ ผิดแพ้</li>
        <li><strong>⏰ หมดเวลา</strong> — ไล่กล่าวหาทีละคน เริ่มจากเจ้ามือ · ไม่มีใครถูกจับ = สายลับรอด</li>
      </ol>
      <p><strong>คะแนน:</strong> สายลับรอด 2 · จับผิดคน/ทายถูก 4 · จับสายลับได้ พลเมืองคนละ 1 (คนเริ่มกล่าวหา +1) · สายลับรอบก่อนเป็นเจ้ามือรอบใหม่</p>
      <p><strong>ห้องโหวตเสียงข้างมาก:</strong> ไม่มีกล่าวหากลางรอบ · หมดเวลาแล้วโหวตลับครั้งเดียว คะแนนสูงสุดถูกจับ (เสมอ = สายลับรอด)</p>
      <p><strong>สายลับ:</strong> แตะชื่อสถานที่ในรายการเพื่อขีดฆ่าที่ตัดทิ้งแล้ว (เห็นคนเดียว)</p>
    </div>
  </div>
</div>

<%- contentFor('script') %>
<script src="/js/gameIcon.js"></script>
<script src="/js/chatPanel.js"></script>
<script>
$(function() {
  document.documentElement.classList.add('sf-active');

  const socket = window.appSocket || io();

  const roomId = '<%= room.roomId %>';
  const playerId = '<%= player.playerId %>';
  const playerName = '<%= player.name %>';
  let isRoomAdmin = <%= room.admin === true ? 'true' : 'false' %>;
  if (window.partyPlay) window.partyPlay.startSession('spyfall', socket);
  let currentState = <%- safeJson(typeof spyfallState !== 'undefined' ? spyfallState : {}) %>;
  const initialChatHistory = <%- safeJson(typeof chatHistory !== 'undefined' ? chatHistory : []) %>;
  let allowNavigation = false;
  let leaving = false; // กดออกแล้ว — ห้ามดึงกลับเข้าห้อง/เกม
  let timerInterval = null;

  function escapeHtml(text) {
    return String(text || '').replace(/[&<>"']/g, function(char) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char];
    });
  }

  function gameIconHtml(meta, options) {
    if (typeof window.renderGameIcon === 'function') {
      return window.renderGameIcon(meta || {}, options || {});
    }
    const icon = (meta && meta.icon) || '🃏';
    return '<span class="game-icon-emoji">' + escapeHtml(icon) + '</span>';
  }

  // รูปผู้เล่น + กรอบ ใช้ตัว render กลาง (playerAvatar.js) ให้ตรงกับหน้าอื่น
  function playerAvatarHtml(player, size) {
    const meta = {
      avatar: (player && player.avatar) || '👤',
      avatarFrame: player && player.avatarFrame,
      color: (player && player.color) || '#5eead4',
      playerName: player && (player.displayName || player.name || player.playerName)
    };
    if (typeof window.renderPlayerAvatar === 'function') {
      return window.renderPlayerAvatar(meta, { size: size || 32 });
    }
    return '<span style="font-size:1.4rem;">' + escapeHtml(meta.avatar) + '</span>';
  }

  function formatTimer(ms) {
    const total = Math.max(0, Math.ceil(ms / 1000));
    const m = Math.floor(total / 60);
    const s = total % 60;
    return m + ':' + String(s).padStart(2, '0');
  }

  function phaseLabel(phase) {
    const map = {
      reveal: '🎭 เปิดบท',
      discussion: '💬 ช่วงคุย',
      accuse: '🛑 หยุดเวลา กล่าวหา',
      final: '⏰ ไล่กล่าวหา',
      vote: '🗳️ โหวตจับสายลับ',
      finished: '🏁 เฉลยผล',
      lobby: '⏳ รอเริ่ม'
    };
    return map[phase] || '⏳ รอเริ่ม';
  }

  function updateTimer() {
    const $timer = $('#timerDisplay');
    if (currentState && currentState.phase === 'finished' && currentState.nextRoundAt) {
      const leftNext = Math.max(0, Math.ceil((currentState.nextRoundAt - Date.now()) / 1000));
      $('#sfReturnNote').text('รอบต่อไปเริ่มเองใน ' + leftNext + ' วิ');
    } else if (currentState && currentState.phase === 'finished' && currentState.returnLobbyAt) {
      const left = Math.max(0, Math.ceil((currentState.returnLobbyAt - Date.now()) / 1000));
      $('#sfReturnNote').text('กลับห้องรออัตโนมัติใน ' + left + ' วิ');
    }
    if (!currentState?.phaseEndsAt || currentState.phase === 'finished') {
      $timer.text('--:--').addClass('is-idle').removeClass('is-urgent');
      return;
    }
    const remaining = currentState.phaseEndsAt - Date.now();
    $timer.text(formatTimer(remaining)).removeClass('is-idle')
      .toggleClass('is-urgent', remaining <= 30000 && currentState.phase !== 'reveal');
  }

  // สายลับขีดฆ่าสถานที่ที่ตัดทิ้งแล้ว — เก็บแค่ในเครื่องนี้ ต่อรอบ
  function struckKey() {
    return 'sfStruck:' + roomId + ':' + ((currentState && currentState.roundId) || '0');
  }
  function readStruck() {
    try { return JSON.parse(sessionStorage.getItem(struckKey()) || '[]') || []; } catch (e) { return []; }
  }
  function writeStruck(list) {
    try { sessionStorage.setItem(struckKey(), JSON.stringify(list)); } catch (e) {}
  }

  function playerNameById(state, id) {
    const found = (state.players || []).find(function(p) { return p.playerId === id; });
    return found ? found.name : '';
  }

  function renderRolePanel(state) {
    const self = state.self || {};
    const roleInfo = self.roleInfo || {};
    const isSpy = !!self.isSpy;
    const location = state.location;
    const pool = state.locationPool || [];
    const winner = state.winner;

    let body = '';
    if (state.phase === 'finished' && winner) {
      const job = self.locationRoleTitle;
      const finishedIcon = isSpy
        ? { id: 'spy', image: roleInfo.image, icon: roleInfo.icon || '🕶️', alt: 'สายลับ' }
        : { id: 'citizen', image: roleInfo.image, icon: roleInfo.icon || '🎭', alt: 'พลเมือง' };
      body = '<div class="sf-role-card ' + (isSpy ? 'spy' : '') + (window.__sfRevealAnimate ? ' reveal-pop' : '') + '">' +
        '<div class="sf-role-icon">' + gameIconHtml(finishedIcon, { className: 'game-icon' }) + '</div>' +
        '<div class="sf-role-name">' + escapeHtml(isSpy ? (roleInfo.title || 'สายลับ') : (job || roleInfo.title || 'พลเมือง')) + '</div>' +
        '<p class="sf-role-summary">' +
          (isSpy
            ? 'สถานที่คือ <strong>' + escapeHtml(winner.locationName || '-') + '</strong>'
            : 'สถานที่ <strong>' + escapeHtml(winner.locationName || '-') + '</strong> · บทของคุณ <strong>' + escapeHtml(job || '-') + '</strong>') +
        '</p>' +
      '</div>';
    } else if (isSpy) {
      body = '<div class="sf-role-card spy' + (window.__sfRevealAnimate ? ' reveal-pop' : '') + '">' +
        '<div class="sf-role-icon">' + gameIconHtml({ id: 'spy', image: roleInfo.image, icon: roleInfo.icon || '🕶️', alt: 'สายลับ' }, { className: 'game-icon' }) + '</div>' +
        '<div class="sf-role-name">' + escapeHtml(roleInfo.title || 'สายลับ') + '</div>' +
        '<p class="sf-role-summary">' + escapeHtml(roleInfo.summary || 'คุณไม่รู้สถานที่ — ฟังคำถามให้ดีแล้วเดาให้เนียน') + '</p>' +
        (pool.length ? '<div class="sf-location-pool-label" style="font-size:0.8rem;color:#94a3b8;margin-top:8px;">📋 สถานที่ที่เป็นไปได้ — แตะเพื่อขีดฆ่าที่ตัดทิ้งแล้ว (เห็นคนเดียว)</div>' +
          '<div class="sf-location-pool">' + pool.map(function(loc) {
          const out = readStruck().indexOf(loc.id) !== -1;
          return '<button type="button" class="sf-location-pill' + (out ? ' is-out' : '') + '" data-loc-id="' + escapeHtml(loc.id) + '" aria-pressed="' + out + '">' + gameIconHtml({ id: loc.id, image: loc.image, icon: loc.icon, alt: loc.name }, { className: 'game-icon' }) + escapeHtml(loc.name) + '</button>';
        }).join('') + '</div>' : '') +
        (state.canGuessLocation && pool.length
          ? '<div style="margin-top:12px;text-align:center;"><button type="button" id="sfGuessLocationBtn" class="ui-btn ui-btn--primary">🎯 ทายสถานที่</button>' +
            '<div style="font-size:0.8rem;color:#94a3b8;margin-top:6px;">หยุดเวลาทายได้ครั้งเดียว ตอนเวลายังเดิน — ถูกชนะ ผิดแพ้</div></div>'
          : '') +
      '</div>';
    } else if (location) {
      const job = self.locationRoleTitle || '';
      body = '<div class="sf-role-card' + (window.__sfRevealAnimate ? ' reveal-pop' : '') + '">' +
        '<div class="sf-role-icon">' + gameIconHtml({ id: location.id, image: location.image, icon: location.icon || '📍', alt: location.name }, { className: 'game-icon' }) + '</div>' +
        '<div class="sf-role-name">' + escapeHtml(job || roleInfo.title || 'พลเมือง') + '</div>' +
        '<div class="sf-location-name">' + escapeHtml(location.name) + '</div>' +
        '<p class="sf-location-hint">' + escapeHtml(location.hint) + '</p>' +
        '<p class="sf-role-summary">' + (job ? 'บทของคุณคือ <strong>' + escapeHtml(job) + '</strong> — ' : '') +
        'อย่าเปิดเผยสถานที่หรือบทตัวเองตรงๆ — ถามคนอื่นให้หลุดรูด</p>' +
      '</div>';
    } else {
      body = '<div class="sf-stage-empty">รอเกมเริ่ม...</div>';
    }

    if (state.phase !== 'finished' && (isSpy || location)) {
      body = '<button type="button" class="sf-role-cover" id="sfRoleCover">🙈 ซ่อนบทอยู่ — แตะเพื่อดู</button>' + body;
    }
    $('#rolePanel').html(body);
    applyRoleHidden(state.phase !== 'finished' && readRoleHidden());
  }

  // ซ่อนบทกันคนข้างๆ แอบมองจอ (เช่นเห็นปุ่มทายสถานที่ของสายลับ)
  function readRoleHidden() {
    try { return sessionStorage.getItem('sfHideRole') === '1'; } catch (e) { return false; }
  }
  function applyRoleHidden(hidden) {
    $('#rolePanel').toggleClass('is-hidden', !!hidden);
    $('#sfHideRoleBtn').attr('aria-pressed', hidden ? 'true' : 'false').text(hidden ? '👁 ดูบท' : '🙈 ซ่อนบท')
      .toggle(!!currentState && currentState.phase !== 'finished' && currentState.phase !== 'lobby');
  }

  let pendingVoteTarget = null;

  function stageTitle(phase) {
    return ({ reveal: '🎭 จำบทของคุณ', discussion: '🎤 ถาม–ตอบ', accuse: '🛑 กล่าวหา', final: '⏰ ไล่กล่าวหา', vote: '🗳️ โหวตจับสายลับ', finished: '🏁 เฉลย' })[phase] || '🎮 ตาเล่น';
  }

  function renderDiscussion(state, tip) {
    const turn = state.turn || {};
    const self = state.self || {};
    const others = (state.players || []).filter(function(p) { return !p.isSelf; });
    const askerName = turn.askerName || '';
    const canPick = turn.isMyTurn || isRoomAdmin;
    const counts = turn.timesAsked || {};
    let html = '<div class="sf-turn' + (turn.isMyTurn ? ' is-me' : '') + '">' +
      '<div class="sf-turn-label">ตาถาม</div>' +
      '<div class="sf-turn-name">' + (turn.isMyTurn ? '🎤 ตาคุณถาม!' : (askerName ? '🎤 ' + escapeHtml(askerName) : '🎤 ใครก็ได้เริ่มถาม')) + '</div>' +
      '<div class="sf-turn-sub">' +
        (turn.isMyTurn
          ? (turn.lastAskerName ? 'ตอบคำถามของ ' + escapeHtml(turn.lastAskerName) + ' ก่อน แล้ว' : '') + 'เลือก 1 คนด้านล่าง แล้วถามเขา (พูดหรือพิมพ์แชทก็ได้)' +
            (turn.lastAskerName ? ' · ห้ามถามกลับ ' + escapeHtml(turn.lastAskerName) : '')
          : (askerName ? 'รอ ' + escapeHtml(askerName) + ' เลือกคนที่จะถาม · คนที่ถูกถามจะได้ถามต่อ' : escapeHtml(tip))) +
      '</div></div>';

    if (canPick) {
      const allPlayers = (state.players || []);
      const askerId = turn.askerId;
      const pickList = allPlayers.filter(function(p) { return p.playerId !== askerId; });
      html += '<div class="sf-section-label">' + (turn.isMyTurn ? 'คุณจะถามใคร?' : '👑 กดแทน ' + escapeHtml(askerName || 'คนถาม') + ' ได้ ถ้าเขาลืมกด') + '</div>';
      html += '<div class="sf-vote-grid">';
      pickList.forEach(function(p) {
        const blocked = turn.isMyTurn && turn.lastAskerId && p.playerId === turn.lastAskerId;
        const n = Number(counts[p.playerId] || 0);
        html += '<button type="button" class="sf-vote-btn sf-ask-btn" data-target-id="' + escapeHtml(p.playerId) + '"' + (blocked ? ' disabled' : '') + '>' +
          playerAvatarHtml(p, 34) +
          '<strong style="color:' + escapeHtml(p.color || '#fff') + '">' + escapeHtml(p.name) + (p.isSelf ? ' (คุณ)' : '') + '</strong>' +
          '<span class="sf-tag">' + (blocked ? 'เพิ่งถามคุณ' : 'ถูกถาม ' + n + ' ครั้ง') + '</span>' +
        '</button>';
      });
      html += '</div>';
    } else {
      html += '<div class="sf-section-label">ถูกถามไปแล้วกี่ครั้ง (ใครยังไม่โดนถาม ลองถามเขาดู)</div><div class="sf-vote-grid">';
      (state.players || []).forEach(function(p) {
        const isAsker = p.playerId === turn.askerId;
        html += '<div class="sf-vote-btn" style="cursor:default;">' + playerAvatarHtml(p, 30) +
          '<strong style="color:' + escapeHtml(p.color || '#fff') + '">' + escapeHtml(p.name) + (p.isSelf ? ' (คุณ)' : '') + '</strong>' +
          '<span class="sf-tag">' + (isAsker ? '🎤 กำลังถาม' : 'ถูกถาม ' + Number(counts[p.playerId] || 0) + ' ครั้ง') + '</span></div>';
      });
      html += '</div>';
    }

    const ready = state.readyVote || {};
    const unanimous = state.voteMode !== 'majority';
    html += '<div class="sf-ready">';
    if (unanimous) {
      html += (state.canAccuse
        ? '<button type="button" id="sfAccuseBtn" class="ui-btn sf-accuse-btn">🛑 กล่าวหา (หยุดเวลา)</button>' +
          '<div class="sf-ready-note">ได้คนละ 1 ครั้งต่อรอบ · ทุกคนต้องเห็นด้วย</div>'
        : '<button type="button" class="ui-btn sf-accuse-btn" disabled>🛑 รอบนี้คุณกล่าวหาไปแล้ว</button>');
    }
    html += '<button type="button" id="sfReadyVoteBtn" class="ui-btn' + (ready.self ? ' is-on' : '') + '" style="margin-top:10px;" aria-pressed="' + (ready.self ? 'true' : 'false') + '">' +
        (ready.self ? '✓ คุณพร้อมแล้ว (แตะเพื่อยกเลิก)' : (unanimous ? '🙋 พอแล้ว ข้ามเวลา' : '🙋 พร้อมโหวตแล้ว')) + '</button>' +
      '<div class="sf-ready-note">พร้อมแล้ว ' + Number(ready.count || 0) + ' คน · ครบ ' + Number(ready.needed || 0) + ' คน ' +
        (unanimous ? 'ข้ามไปไล่กล่าวหาเลย' : 'ไปโหวตทันที') + ' ไม่ต้องรอหมดเวลา</div>';
    if (isRoomAdmin) {
      html += '<div class="sf-host-row"><button type="button" id="sfEndDiscussionBtn" class="ui-btn ui-btn--ghost">⏭️ จบคุย → ' + (unanimous ? 'ไล่กล่าวหาเลย' : 'ไปโหวตเลย') + ' (หัวหน้าห้อง)</button></div>';
    }
    html += '</div>';
    return html;
  }

  function playerById(state, id) {
    return (state.players || []).find(function(p) { return p.playerId === id; }) || null;
  }

  // คำกล่าวหาที่กำลังโหวต (หยุดเวลากลางรอบ หรือไล่กล่าวหาตอนหมดเวลา)
  function renderAccusation(state) {
    const a = state.accusation;
    const suspect = playerById(state, a.suspectId) || { name: a.suspectName };
    let html = '<div class="sf-accuse">' +
      '<div class="sf-accuse-head">' + (a.kind === 'stop' ? '🛑 ' + escapeHtml(a.accuserName) + ' หยุดเวลา' : '👉 ' + escapeHtml(a.accuserName) + ' กล่าวหา') + '</div>' +
      '<div class="sf-accuse-who">' + playerAvatarHtml(suspect, 40) + '<span><strong>' + escapeHtml(a.suspectName) + '</strong> เป็นสายลับ?</span></div>' +
      '<div class="sf-accuse-count">เห็นด้วย ' + Number(a.yes || 0) + ' / ' + Number(a.needed || 0) + ' · ต้องเห็นด้วยทุกคน</div>';
    if (a.isSuspect) {
      html += '<p class="sf-role-summary">คุณถูกกล่าวหา — คุณไม่ได้โหวต รอคนอื่นตัดสิน</p>';
    } else if (a.canVote) {
      html += '<div class="sf-yn">' +
        '<button type="button" id="sfAgreeBtn" class="ui-btn ui-btn--primary">✅ เห็นด้วย</button>' +
        '<button type="button" id="sfDisagreeBtn" class="ui-btn">❌ ไม่เห็นด้วย</button>' +
      '</div>';
    } else {
      html += '<p class="sf-role-summary">' + (a.accuserId === (state.self || {}).playerId ? 'คุณเป็นคนกล่าวหา (นับว่าเห็นด้วย)' : (a.myVote ? 'คุณเห็นด้วยแล้ว' : 'คุณไม่เห็นด้วย')) + ' — รอคนอื่น</p>';
    }
    if ((a.waitingNames || []).length) {
      html += '<div class="sf-pending">ยังไม่โหวต: ' + escapeHtml(a.waitingNames.join(', ')) + '</div>';
    }
    if (a.kind === 'stop' && state.pausedRemainingMs != null) {
      html += '<div class="sf-pending">⏸ เวลาคุยหยุดไว้ที่ ' + formatTimer(state.pausedRemainingMs) + ' · ไม่ผ่าน = เดินต่อ</div>';
    }
    html += '</div>';
    return html;
  }

  let pendingAccuseTarget = null;

  // หมดเวลา: ไล่กล่าวหาทีละคน เริ่มจากเจ้ามือ
  function renderFinal(state) {
    if (state.accusation) return renderAccusation(state);
    const ft = state.finalTurn || {};
    const others = (state.players || []).filter(function(p) { return !p.isSelf; });
    if (!others.some(function(p) { return p.playerId === pendingAccuseTarget; })) pendingAccuseTarget = null;
    let html = '<div class="sf-turn' + (ft.isMyTurn ? ' is-me' : '') + '">' +
      '<div class="sf-turn-label">หมดเวลา · คนที่ ' + Number(ft.position || 0) + '/' + Number(ft.total || 0) + '</div>' +
      '<div class="sf-turn-name">' + (ft.isMyTurn ? '👉 ตาคุณกล่าวหา!' : '👉 ตา ' + escapeHtml(ft.accuserName || '-')) + '</div>' +
      '<div class="sf-turn-sub">' + (ft.isMyTurn ? 'เลือก 1 คนที่คิดว่าเป็นสายลับ แล้วกดยืนยัน · ทุกคนต้องเห็นด้วย' : 'รอเขาเลือกคนที่จะกล่าวหา · ไม่มีใครถูกจับ = สายลับรอด') + '</div>' +
    '</div>';
    if (ft.isMyTurn) {
      html += '<div class="sf-vote-grid">' + others.map(function(p) {
        const on = p.playerId === pendingAccuseTarget;
        return '<button type="button" class="sf-vote-btn sf-final-pick' + (on ? ' selected' : '') + '" data-target-id="' + escapeHtml(p.playerId) + '" aria-pressed="' + on + '">' +
          playerAvatarHtml(p, 36) + '<strong style="color:' + escapeHtml(p.color || '#fff') + '">' + escapeHtml(p.name) + '</strong>' +
          (on ? '<span class="sf-tag" style="color:var(--sf-amber);">เลือกอยู่</span>' : '') + '</button>';
      }).join('') + '</div>' +
      '<div class="sf-confirm-bar"><button type="button" id="sfFinalConfirmBtn" class="ui-btn ui-btn--primary"' + (pendingAccuseTarget ? '' : ' disabled') + '>' +
        (pendingAccuseTarget ? '👉 กล่าวหา ' + escapeHtml(playerNameById(state, pendingAccuseTarget)) : 'เลือกคนก่อน แล้วกดยืนยัน') + '</button></div>';
    }
    return html;
  }

  function renderVote(state, tip) {
    const players = (state.players || []).filter(function(p) { return !p.isSelf; });
    const selfVoted = !!(state.self && state.self.hasVoted);
    const selfTarget = state.self && state.self.voteTargetId;
    const progress = state.voteProgress || {};
    const submitted = Number(progress.submitted || 0);
    const total = Number(progress.total || 0);
    if (selfVoted || !players.some(function(p) { return p.playerId === pendingVoteTarget; })) {
      pendingVoteTarget = null;
    }
    let html = '<p class="sf-role-summary" style="text-align:center;margin:0 0 6px;">' +
      (selfVoted ? 'ส่งโหวตแล้ว — รอคนอื่น ครบเมื่อไหร่เฉลยทันที' : 'แตะเลือก 1 คนที่คิดว่าเป็นสายลับ แล้วกดยืนยัน') + '</p>';
    if (total > 0) {
      html += '<p style="text-align:center;margin:0 0 12px;color:var(--sf-teal);font-weight:600;">ลงคะแนนแล้ว ' + submitted + ' / ' + total + ' คน</p>';
    }
    html += '<div class="sf-vote-grid">';
    players.forEach(function(player) {
      const isMyPick = selfTarget && player.playerId === selfTarget;
      const isPending = !selfVoted && player.playerId === pendingVoteTarget;
      html += '<button type="button" class="sf-vote-btn sf-vote-pick' + (isMyPick || isPending ? ' selected' : '') + '" data-target-id="' + escapeHtml(player.playerId) + '" aria-pressed="' + (isMyPick || isPending ? 'true' : 'false') + '" ' + (selfVoted ? 'disabled' : '') + '>' +
        playerAvatarHtml(player, 38) +
        '<strong style="color:' + escapeHtml(player.color || '#fff') + '">' + escapeHtml(player.name) + '</strong>' +
        (isMyPick ? '<span class="sf-tag" style="color:var(--sf-teal);">✓ คุณโหวตคนนี้</span>'
          : (isPending ? '<span class="sf-tag" style="color:var(--sf-amber);">เลือกอยู่</span>'
          : (player.hasVoted ? '<span class="sf-tag">ลงคะแนนแล้ว</span>' : ''))) +
      '</button>';
    });
    html += '</div>';
    if (!selfVoted) {
      const pendingName = pendingVoteTarget ? playerNameById(state, pendingVoteTarget) : '';
      html += '<div class="sf-confirm-bar"><button type="button" id="sfConfirmVoteBtn" class="ui-btn ui-btn--primary"' + (pendingVoteTarget ? '' : ' disabled') + '>' +
        (pendingVoteTarget ? '🗳️ ยืนยันโหวต ' + escapeHtml(pendingName) : 'เลือกคนก่อน แล้วกดยืนยัน') + '</button></div>';
    }
    const waiting = (state.players || []).filter(function(p) { return !p.hasVoted && !(p.isSelf && selfVoted); }).map(function(p) { return p.isSelf ? 'คุณ' : p.name; });
    if (waiting.length && submitted < total) {
      html += '<div class="sf-pending">ยังไม่โหวต: ' + escapeHtml(waiting.join(', ')) + '</div>';
    }
    return html;
  }

  function recapWhy(w, state) {
    const spy = escapeHtml(w.spyName || '-');
    const place = escapeHtml(w.locationName || '-');
    if (w.spyGuess) {
      return w.spyGuess.correct
        ? 'สายลับ ' + spy + ' ฟังคำถามจนเดาถูกว่าคือ <strong>' + place + '</strong>'
        : 'สายลับ ' + spy + ' ทายว่า <strong>' + escapeHtml(w.spyGuess.locationName || '-') + '</strong> แต่ที่จริงคือ <strong>' + place + '</strong>';
    }
    if (w.spyLeft) return 'สายลับ ' + spy + ' ออกจากเกมกลางคัน';
    if (w.reason === 'convicted_spy') return 'ทุกคนเห็นด้วยกับ ' + escapeHtml(w.accuserName || '-') + ' ว่า ' + spy + ' คือสายลับ — ถูกต้อง!';
    if (w.reason === 'convicted_innocent') return 'ทุกคนเห็นด้วยว่า ' + escapeHtml(w.accusedName || '-') + ' คือสายลับ แต่ผิด — สายลับตัวจริงคือ ' + spy;
    if (w.reason === 'no_conviction') return 'ไม่มีคำกล่าวหาไหนได้เสียงเอกฉันท์ — สายลับ ' + spy + ' จึงรอด';
    if (!w.topVotes) return 'ไม่มีใครโหวตเลย — สายลับ ' + spy + ' จึงรอด';
    if (w.wasTie) return 'คะแนนโหวตเสมอกัน — ไม่มีใครถูกจับ สายลับ ' + spy + ' จึงรอด';
    if (w.accusedPlayerId === w.spyPlayerId) return 'ส่วนใหญ่โหวตจับ ' + spy + ' ซึ่งเป็นสายลับจริง (' + w.topVotes + ' เสียง)';
    const accused = (state.players || []).find(function(p) { return p.playerId === w.accusedPlayerId; });
    return 'ส่วนใหญ่โหวต ' + escapeHtml(w.accusedName || '-') + (accused && accused.roleTitle ? ' (' + escapeHtml(accused.roleTitle) + ')' : '') +
      ' ซึ่งไม่ใช่สายลับ — สายลับตัวจริงคือ ' + spy;
  }

  function renderFinished(state) {
    const w = state.winner;
    const citizensWin = w.team === 'citizens';
    const selfIsSpy = !!(state.self && state.self.isSpy);
    const iWon = selfIsSpy ? !citizensWin : citizensWin;
    const counts = w.voteCounts || {};
    const roster = (state.players || []).slice().sort(function(a, b) {
      return (b.isSpy ? 1 : 0) - (a.isSpy ? 1 : 0) || Number(counts[b.playerId] || 0) - Number(counts[a.playerId] || 0);
    });
    const showVotes = !w.spyGuess && /^majority/.test(w.reason || '');
    const rosterHtml = '<div class="sf-roster">' + roster.map(function(p) {
      const n = Number(counts[p.playerId] || 0);
      return '<div class="sf-roster-row' + (p.isSpy ? ' is-spy' : '') + '">' + playerAvatarHtml(p, 30) +
        '<span class="sf-roster-name"><strong>' + escapeHtml(p.name) + (p.isSelf ? ' (คุณ)' : '') + '</strong>' +
        '<small>' + (p.isSpy ? '🕶️ สายลับ' : '🎭 ' + escapeHtml(p.roleTitle || 'พลเมือง')) + '</small></span>' +
        (showVotes ? '<span class="sf-roster-votes">' + n + ' เสียง</span>' : '') + '</div>';
    }).join('') + '</div>';
    const m = state.match || null;
    const pts = w.points || {};
    const multi = m && m.totalRounds > 1;
    let scoreHtml = '';
    if (m) {
      const topIds = m.over ? (m.winnerIds || []) : [];
      scoreHtml = '<div class="sf-points-title">' + (multi ? '🏆 คะแนนรวม (รอบ ' + m.round + '/' + m.totalRounds + ')' : '🏆 คะแนนรอบนี้') + '</div>' +
        '<div class="sf-points">' + (m.scoreboard || []).map(function(row) {
          const plus = Number(pts[row.playerId] || 0);
          return '<div class="sf-points-row' + (topIds.indexOf(row.playerId) !== -1 ? ' is-top' : '') + '"><span>' + escapeHtml(row.name) + (row.playerId === (state.self || {}).playerId ? ' (คุณ)' : '') + (row.present ? '' : ' · ออกแล้ว') + '</span>' +
            '<span class="sf-plus">' + (plus ? '+' + plus : '') + '</span>' +
            (multi ? '<span class="sf-total">' + Number(row.score || 0) + '</span>' : '') + '</div>';
        }).join('') + '</div>';
      if (m.over && multi) {
        const names = (m.scoreboard || []).filter(function(r) { return topIds.indexOf(r.playerId) !== -1; }).map(function(r) { return r.name; });
        scoreHtml += '<div class="sf-match-win">' + (names.length ? '🏆 ชนะทั้งเกม: ' + escapeHtml(names.join(', ')) : 'จบเกม') + (m.endedEarly ? ' (ผู้เล่นไม่พอ จบก่อนครบรอบ)' : '') + '</div>';
      }
    }
    const matchContinues = m && !m.over;
    return '<div class="sf-result ' + (citizensWin ? 'win-citizens' : 'win-spy') + (window.__sfRevealAnimate ? ' win-pop' : '') + '">' +
      '<div class="sf-recap-me ' + (iWon ? 'win' : 'lose') + '">' + (iWon ? '🎉 คุณชนะ' : '😵 คุณแพ้') + (selfIsSpy ? ' (คุณคือสายลับ)' : '') + '</div>' +
      '<h3>' + escapeHtml(w.teamLabel || '') + '</h3>' +
      '<p class="sf-recap-why">' + recapWhy(w, state) + '</p>' +
      '<p>สถานที่: <strong>' + gameIconHtml({ id: w.locationId, image: w.locationImage, icon: w.locationIcon, alt: w.locationName }, { className: 'game-icon', px: 22 }) + ' ' + escapeHtml(w.locationName || '') + '</strong></p>' +
      rosterHtml + scoreHtml +
      '<div class="sf-recap-actions">' +
        (matchContinues
          ? (isRoomAdmin
            ? '<button type="button" id="sfNextRoundBtn" class="ui-btn ui-btn--primary">▶ เริ่มรอบ ' + (m.round + 1) + '/' + m.totalRounds + ' เลย</button>'
            : '<div class="sf-return-note">สายลับรอบนี้จะเป็นเจ้ามือรอบหน้า</div>')
          : (isRoomAdmin
            ? '<button type="button" id="sfRematchBtn" class="ui-btn ui-btn--primary">🎲 เล่นใหม่' + (multi ? 'ทั้งเกม' : 'อีกรอบ') + ' (สุ่มสถานที่ใหม่)</button>' +
              '<button type="button" id="sfBackLobbyBtn" class="ui-btn">🏠 กลับห้องรอเลย</button>'
            : '<div class="sf-return-note">รอหัวหน้าห้องกดเล่นอีกรอบ</div>')) +
        '<button type="button" id="sfShareBtn" class="ui-btn ui-btn--ghost">📸 เซฟผล</button>' +
      '</div>' +
      '<div class="sf-return-note" id="sfReturnNote"></div>' +
    '</div>';
  }

  function renderStage(state) {
    const $stage = $('#mainStage');
    const tip = (state.phaseTips && state.phaseTips[state.phase]) || '';
    $('#sfStageTitle').text(stageTitle(state.phase));
    $('#sfMain').toggleClass('stage-first', ['vote', 'finished', 'accuse', 'final'].indexOf(state.phase) !== -1);

    if (state.phase === 'accuse' && state.accusation) {
      $stage.html(renderAccusation(state));
      return;
    }
    if (state.phase === 'final') {
      $stage.html(renderFinal(state));
      return;
    }
    if (state.phase === 'vote') {
      $stage.html(renderVote(state, tip));
      return;
    }
    if (state.phase === 'finished' && state.winner) {
      $stage.html(renderFinished(state));
      return;
    }
    if (state.phase === 'discussion') {
      $stage.html(renderDiscussion(state, tip));
      return;
    }
    if (state.phase === 'reveal') {
      $stage.html('<div class="sf-stage-empty">' + escapeHtml(tip) + '<br><span style="color:var(--sf-muted);font-size:0.92rem;">ช่วงคุย ระบบจะสุ่มคนถามคนแรก · ถามกันด้วยเสียงหรือในแชทก็ได้</span></div>');
      return;
    }
    $stage.html('<div class="sf-stage-empty">รอเกมเริ่ม...</div>');
  }

  function nowCopy(state) {
    if (state.phase === 'discussion' && state.turn) {
      if (state.turn.isMyTurn) return '🎤 ตาคุณถาม — เลือกคนแล้วถามเขา';
      if (state.turn.askerName) return '🎤 ตา ' + state.turn.askerName + ' ถาม';
    }
    if (state.accusation && (state.phase === 'accuse' || state.phase === 'final')) {
      const a = state.accusation;
      if (a.isSuspect) return '🛑 คุณถูกกล่าวหา — รอคนอื่นตัดสิน';
      if (a.canVote) return '🛑 ' + a.suspectName + ' เป็นสายลับไหม? กดเห็นด้วย/ไม่เห็นด้วย';
      return '🛑 รอคนอื่นโหวตคำกล่าวหา';
    }
    if (state.phase === 'final' && state.finalTurn) {
      return state.finalTurn.isMyTurn ? '👉 ตาคุณกล่าวหา — เลือก 1 คน' : '👉 ตา ' + (state.finalTurn.accuserName || '-') + ' กล่าวหา';
    }
    if (state.phase === 'vote') {
      return state.self && state.self.hasVoted ? 'โหวตแล้ว — รอคนอื่น' : 'โหวต 1 คนที่คิดว่าเป็นสายลับ';
    }
    return (state.phaseTips && state.phaseTips[state.phase]) || 'เล่นต่อได้เลย';
  }

  function renderHistory(state) {
    const items = state.history || [];
    if (!items.length) {
      $('#historyFeed').html('<div class="sf-feed-item">ยังไม่มีเหตุการณ์</div>');
      return;
    }
    $('#historyFeed').html(items.map(function(item) {
      return '<div class="sf-feed-item">' + escapeHtml(item.icon) + ' ' + escapeHtml(item.text) + '</div>';
    }).join(''));
  }

  function renderRoundChip(state) {
    const m = state && state.match;
    if (!m) { $('#sfRoundChip').hide(); return; }
    $('#sfRoundChip').text('รอบ ' + m.round + '/' + m.totalRounds + (m.dealerName ? ' · เจ้ามือ ' + m.dealerName : '')).show();
  }

  function renderState(state) {
    if (leaving) return;
    if (!state) {
      // ไม่ได้อยู่ในรอบนี้ (เช่นเข้าห้องตอนเกมเริ่มไปแล้ว) — บอกให้ชัด แทนที่จะค้าง "กำลังโหลด"
      if (!currentState || !currentState.self) {
        $('#sfNowCopy').text('คุณไม่ได้อยู่ในรอบนี้ — รอรอบหน้าในห้องรอ');
        $('#rolePanel').html('<div class="sf-stage-empty">รอบนี้เริ่มไปแล้ว ดูแชทได้ แล้วรอเล่นรอบหน้า</div>');
        $('#mainStage').html('<div class="sf-stage-empty"><a class="ui-btn" href="/room/' + roomId + '?playerId=' + playerId + '">🏠 กลับห้องรอ</a></div>');
      }
      return;
    }
    // จังหวะพีค: เข้าเฟสเปิดบท/ประกาศผล "ครั้งแรก" เท่านั้น (กันเด้งซ้ำทุก broadcast)
    const prevPhase = currentState && currentState.phase;
    const prevMyTurn = !!(currentState && currentState.turn && currentState.turn.isMyTurn);
    const prevAccusation = currentState && currentState.accusation;
    if (prevPhase && state.phase !== prevPhase) pendingAccuseTarget = null;
    const enteredReveal = state.phase === 'reveal' && prevPhase !== 'reveal';
    const enteredFinish = state.phase === 'finished' && prevPhase !== 'finished';
    window.__sfRevealAnimate = enteredReveal || enteredFinish;
    if (window.__sfRevealAnimate) {
      window.gameHaptic(enteredFinish ? [15, 60, 25, 60, 40] : [20, 60, 30]);
    }
    currentState = state;

    $('#phaseChip').text(phaseLabel(state.phase));
    renderRoundChip(state);
    $('#sfEndGameBtn').toggle(isRoomAdmin && state.phase !== 'finished');
    $('#sfNowCopy').text(nowCopy(state));
    if (state.phase === 'discussion' && state.turn && state.turn.isMyTurn && !prevMyTurn) {
      window.gameHaptic && window.gameHaptic([15, 40, 15]);
    }
    if (state.accusation && !(prevAccusation && prevAccusation.suspectId === state.accusation.suspectId && prevAccusation.accuserId === state.accusation.accuserId)) {
      window.gameHaptic && window.gameHaptic([25, 50, 25]);
    }

    renderRolePanel(state);
    renderStage(state);
    renderHistory(state);
    updateTimer();
  }

  function startTimerTick() {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(updateTimer, 1000);
  }

  socket.on('connect', function() {
    if (leaving) return;
    $('#connectionStatus').hide();
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId: roomId, playerId: playerId });
    socket.emit('spyfall_requestState', { roomId: roomId, playerId: playerId });
  });

  socket.on('disconnect', function() {
    $('#connectionStatus').show();
  });

  socket.on('spyfallState', function(state) {
    renderState(state);
  });

  socket.on('gameStarting', function() {
    if (leaving) return;
    allowNavigation = true;
    window.location.href = '/game/' + roomId + '?playerId=' + playerId;
  });

  socket.on('returnToLobby', function(data) {
    if (leaving) return;
    $('#returnToLobbyModal').css('display', 'flex');
    let countdown = data.countdown || 5;
    $('#returnCountdown').text(countdown);
    const interval = setInterval(function() {
      countdown -= 1;
      $('#returnCountdown').text(countdown);
      if (countdown <= 0) clearInterval(interval);
    }, 1000);
  });

  socket.on('redirectToLobby', function() {
    if (leaving) return;
    allowNavigation = true;
    window.location.href = '/room/' + roomId + '?playerId=' + playerId;
  });

  socket.on('restartGame', function() {
    if (leaving) return;
    allowNavigation = true;
    window.location.href = '/room/' + roomId + '?playerId=' + playerId;
  });

  socket.on('roomUpdate', function(data) {
    if (leaving) return;
    if (data && data.admin) {
      const nowAdmin = data.admin === playerId;
      if (nowAdmin !== isRoomAdmin) {
        isRoomAdmin = nowAdmin;
        if (currentState && currentState.self) renderState(currentState);
      }
    }
    if (data && data.players) {
      const onlineCount = data.players.filter(function(p) { return p.online !== false; }).length;
      $('#sfPlayerCountChip').text('👥 ' + onlineCount + '/<%= room.maxPlayers %>');
      $('#onlinePlayerList').empty();
      data.players.forEach(function(player) {
        $('#onlinePlayerList').append(
          '<li style="display:flex;align-items:center;gap:8px;">' +
            playerAvatarHtml(player, 28) +
            '<span style="color:' + escapeHtml(player.color || '#fff') + '">' + escapeHtml(player.displayName || player.playerName) + '</span>' +
            (player.online === false ? '<span style="margin-left:auto;font-size:0.75rem;color:var(--sf-muted);">ออฟไลน์</span>' : '') +
          '</li>'
        );
      });
    }
  });

  // แชทกลางแบบเดียวกับ Insider (ตอบกลับ / ปัดเพื่อตอบ / จุดแจ้งข้อความใหม่ / รูป+กรอบผู้เล่น)
  const spyfallChat = window.initChatPanel({
    socket: socket,
    playerId: playerId,
    playerName: playerName
  });
  (initialChatHistory || []).forEach(function(entry) {
    spyfallChat?.appendMessage(entry, { silent: true });
  });

  $(document).on('click', '#sfEndDiscussionBtn', function() {
    Swal.fire({
      icon: 'question',
      title: (currentState && currentState.voteMode === 'majority') ? 'จบช่วงคุยและไปโหวตเลย?' : 'จบช่วงคุย ไล่กล่าวหาเลย?',
      text: 'ใช้เมื่อทุกคนพร้อมแล้ว — เวลาที่เหลือจะถูกข้าม',
      showCancelButton: true,
      confirmButtonText: 'ไปโหวต',
      cancelButtonText: 'ยกเลิก',
      background: '#111',
      color: '#fff'
    }).then(function(result) {
      if (!result.isConfirmed) return;
      socket.emit('spyfall_endDiscussion', {}, function(res) {
        if (res && !res.success) {
          Swal.fire({ icon: 'warning', title: res.error || 'ไม่สำเร็จ', background: '#111', color: '#fff' });
        }
      });
    });
  });

  function swalError(title) {
    Swal.fire({ icon: 'warning', title: title || 'ไม่สำเร็จ', background: '#111', color: '#fff' });
  }

  // สายลับทายสถานที่ — แตะการ์ดสถานที่ (ปุ่มใหญ่ กดง่ายบนมือถือ) แล้วยืนยันอีกชั้น (ทายได้ครั้งเดียว)
  let guessInFlight = false;
  $(document).on('click', '#sfGuessLocationBtn', function() {
    if (guessInFlight || !currentState || !currentState.canGuessLocation) return;
    const pool = currentState.locationPool || [];
    const struck = readStruck();
    const ordered = pool.filter(function(loc) { return struck.indexOf(loc.id) === -1; })
      .concat(pool.filter(function(loc) { return struck.indexOf(loc.id) !== -1; }));
    const nameById = {};
    pool.forEach(function(loc) { nameById[loc.id] = loc.name; });
    let picked = null;
    Swal.fire({
      title: '🎯 ทายสถานที่',
      html: '<div style="font-size:0.9rem;color:#cbd5e1;margin-bottom:10px;">ถูก = สายลับชนะทันที · ผิด = แพ้ทันที' + (struck.length ? '<br>ที่ขีดฆ่าไว้อยู่ท้ายรายการ' : '') + '</div>' +
        '<div class="sf-guess-grid">' + ordered.map(function(loc) {
          return '<button type="button" class="sf-guess-tile' + (struck.indexOf(loc.id) !== -1 ? ' is-out' : '') + '" data-loc-id="' + escapeHtml(loc.id) + '">' +
            gameIconHtml({ id: loc.id, image: loc.image, icon: loc.icon, alt: loc.name }, { className: 'game-icon' }) + escapeHtml(loc.name) + '</button>';
        }).join('') + '</div>',
      showCancelButton: true,
      confirmButtonText: 'ต่อไป',
      cancelButtonText: 'ยกเลิก',
      background: '#111',
      color: '#fff',
      didOpen: function(popup) {
        $(popup).on('click', '.sf-guess-tile', function() {
          picked = String($(this).data('loc-id'));
          $(popup).find('.sf-guess-tile').removeClass('is-picked');
          $(this).addClass('is-picked');
          Swal.getConfirmButton().textContent = 'ทาย "' + (nameById[picked] || picked) + '"';
          Swal.resetValidationMessage();
        });
      },
      preConfirm: function() {
        if (!picked) {
          Swal.showValidationMessage('แตะเลือกสถานที่ก่อน');
          return false;
        }
        return picked;
      }
    }).then(function(pick) {
      if (!pick.isConfirmed || !pick.value) return;
      const locationId = pick.value;
      const name = nameById[locationId] || locationId;
      return Swal.fire({
        icon: 'warning',
        title: 'ยืนยันทาย "' + name + '"?',
        text: 'ทายได้ครั้งเดียว ยกเลิกไม่ได้ — ผิดแพ้ทันที',
        showCancelButton: true,
        confirmButtonText: 'ยืนยันทายสถานที่',
        cancelButtonText: 'ยกเลิก',
        background: '#111',
        color: '#fff'
      }).then(function(confirm) {
        if (!confirm.isConfirmed) return;
        guessInFlight = true;
        socket.emit('spyfall_guessLocation', { locationId: locationId }, function(res) {
          guessInFlight = false;
          if (res && !res.success) swalError(res.error || 'ทายไม่สำเร็จ');
        });
      });
    });
  });

  // สายลับขีดฆ่าสถานที่ในรายการ (กันลืมว่าตัดอะไรทิ้งไปแล้ว)
  $(document).on('click', '.sf-location-pool .sf-location-pill', function() {
    const id = String($(this).data('loc-id') || '');
    if (!id) return;
    const list = readStruck();
    const at = list.indexOf(id);
    if (at === -1) list.push(id); else list.splice(at, 1);
    writeStruck(list);
    $(this).toggleClass('is-out', at === -1).attr('aria-pressed', at === -1 ? 'true' : 'false');
  });

  // ซ่อน/ดูบท
  $(document).on('click', '#sfHideRoleBtn, #sfRoleCover', function() {
    const next = !$('#rolePanel').hasClass('is-hidden');
    try { sessionStorage.setItem('sfHideRole', next ? '1' : '0'); } catch (e) {}
    applyRoleHidden(next);
  });

  // ส่งตาถาม: คนที่ถึงตาแตะคนที่จะถาม → คนนั้นได้ถามต่อ
  let askInFlight = false;
  $(document).on('click', '.sf-ask-btn', function() {
    const targetId = $(this).data('target-id');
    if (!targetId || askInFlight || $(this).prop('disabled')) return;
    askInFlight = true;
    $('.sf-ask-btn').prop('disabled', true);
    $(this).addClass('selected');
    window.gameHaptic && window.gameHaptic(15);
    socket.emit('spyfall_passQuestion', { targetPlayerId: targetId }, function(res) {
      askInFlight = false;
      if (res && !res.success) {
        swalError(res.error);
        if (currentState) renderStage(currentState);
      }
    });
  });

  let readyInFlight = false;
  $(document).on('click', '#sfReadyVoteBtn', function() {
    if (readyInFlight) return;
    readyInFlight = true;
    $(this).prop('disabled', true);
    window.gameHaptic && window.gameHaptic(15);
    socket.emit('spyfall_readyVote', {}, function(res) {
      readyInFlight = false;
      $('#sfReadyVoteBtn').prop('disabled', false);
      if (res && !res.success) swalError(res.error);
    });
  });

  // โหวต 2 จังหวะ: แตะเลือก (เปลี่ยนใจได้) → กดยืนยัน — กันนิ้วลั่นโหวตผิดคนแบบย้อนไม่ได้
  let voteInFlight = false;

  $(document).on('click', '.sf-vote-pick', function() {
    const targetId = $(this).data('target-id');
    if (!targetId || voteInFlight || currentState.self?.hasVoted) return;
    pendingVoteTarget = String(targetId);
    window.gameHaptic && window.gameHaptic(10);
    renderStage(currentState);
  });

  $(document).on('click', '#sfConfirmVoteBtn', function() {
    const targetId = pendingVoteTarget;
    if (!targetId || voteInFlight || currentState.self?.hasVoted) return;
    voteInFlight = true;
    $(this).prop('disabled', true).text('กำลังส่งโหวต...');
    $('.sf-vote-pick').prop('disabled', true);
    window.gameHaptic && window.gameHaptic(15);

    socket.emit('spyfall_vote', { targetPlayerId: targetId }, function(res) {
      voteInFlight = false;
      if (res && !res.success) {
        swalError(res.error || 'โหวตไม่สำเร็จ');
        if (currentState) renderStage(currentState);
      }
    });
  });

  $(document).on('click', '#sfBackLobbyBtn', function() {
    socket.emit('spyfall_restartGame', {}, function(res) {
      if (res && !res.success) swalError(res.error);
    });
  });

  $('#sfHowToOpen, #sfHowToClose').on('click', function() {
    const open = $('#sfHowToOverlay').is(':hidden');
    $('#sfHowToOverlay').toggle(open);
  });

  $('#sfHowToOverlay').on('click', function(e) {
    if (e.target === this) $(this).hide();
  });

  function toggleSidebar() {
    $('#playerSidebar').toggleClass('open');
    $('#sidebarOverlay').toggle();
  }

  $('#sfSidebarBtn, #closeSidebarBtn, #sidebarOverlay').on('click', toggleSidebar);

  $(document).on('click', '#sfRematchBtn', function() {
    socket.emit('spyfall_restartGame', { rematch: true }, function(res) {
      if (res && !res.success) {
        Swal.fire({ icon: 'error', title: res.error || 'เริ่มใหม่ไม่สำเร็จ', background: '#111', color: '#fff' });
      }
    });
  });

  $(document).on('click', '#sfShareBtn', function() {
    if (!window.partyPlay || !currentState || !currentState.winner) return;
    const w = currentState.winner;
    window.partyPlay.shareResult({
      mode: 'Spyfall',
      headline: w.teamLabel || (w.team === 'citizens' ? 'พลเมืองชนะ' : 'สายลับชนะ'),
      sub: 'สายลับ: ' + (w.spyName || '-') + ' · สถานที่: ' + (w.locationName || '-'),
      lines: (currentState.players || []).map(function(p) {
        return (p.name || '-') + (p.playerId === w.spyPlayerId ? ' · สายลับ' : '');
      }),
      accent: '#14b8a6',
      fileName: 'spyfall-result'
    });
  });

  // ออกจากห้อง: บอกผลที่ตามมาตามช่วงของเกม
  function exitConsequences() {
    const st = currentState || {};
    const self = st.self || {};
    const phase = st.phase;
    const live = ['reveal', 'discussion', 'accuse', 'final', 'vote'].indexOf(phase) !== -1;
    const lines = [];
    if (!self.playerId) {
      lines.push('คุณไม่ได้เล่นรอบนี้ — กลับไปหน้ารวมห้อง');
      return lines;
    }
    if (phase === 'finished') {
      lines.push(st.match && !st.match.over ? 'จบรอบนี้แล้ว — คุณจะไม่ได้เล่นรอบต่อไป แต้มสะสมไม่นับต่อ' : 'จบเกมแล้ว — กลับไปหน้ารวมห้อง');
    } else if (live) {
      if (self.isSpy) {
        lines.push('คุณเป็นสายลับ — ออกตอนนี้ = พลเมืองชนะรอบนี้');
      } else {
        if (st.accusation && st.accusation.suspectId === self.playerId) lines.push('คุณถูกกล่าวหาอยู่ — คำกล่าวหานี้จะถูกยกเลิก');
        else if (st.turn && st.turn.isMyTurn) lines.push('ตาคุณถามอยู่ — ตาจะส่งให้คนอื่น');
        else if (st.finalTurn && st.finalTurn.isMyTurn) lines.push('ตาคุณกล่าวหาอยู่ — ข้ามไปคนต่อไป');
        lines.push('รอบนี้เล่นต่อโดยไม่มีคุณ · แต้มสะสมไม่นับต่อ');
      }
      const others = (st.players || []).filter(function(p) { return !p.isSelf; }).length;
      if (others < 3) lines.push('เหลือไม่ถึง 3 คน — รอบหน้าเริ่มไม่ได้');
    }
    if (isRoomAdmin) lines.push('คุณเป็นหัวหน้าห้อง — หัวหน้าจะย้ายไปคนอื่น');
    return lines;
  }

  function leaveRoomNow() {
    if (leaving) return;
    leaving = true;
    allowNavigation = true;
    let gone = false;
    const go = function() {
      if (gone) return;
      gone = true;
      window.location.href = '/rooms?playerId=' + playerId;
    };
    setTimeout(go, 4000); // ไม่มีคำตอบใน 4 วิ ก็ออกเลย
    socket.emit('leaveRoom', { roomId: roomId, playerId: playerId }, go);
  }

  function confirmExit() {
    Swal.fire({
      icon: 'question',
      title: 'ออกจากห้อง?',
      html: '<ul style="text-align:left;margin:0;padding-left:1.2em;line-height:1.55;">' + exitConsequences().map(function(t) { return '<li>' + escapeHtml(t) + '</li>'; }).join('') + '</ul>',
      showCancelButton: true,
      confirmButtonText: 'ออกจากห้อง',
      cancelButtonText: 'อยู่ต่อ',
      confirmButtonColor: '#b91c1c',
      reverseButtons: true,
      background: '#111',
      color: '#fff'
    }).then(function(result) {
      if (result.isConfirmed) leaveRoomNow();
    });
  }

  $('#sfExitBtn').on('click', confirmExit);
  $(document).on('click', '#leaveRoomBtn', function() {
    $('#playerSidebar').removeClass('open');
    $('#sidebarOverlay').hide();
    confirmExit();
  });

  // 🛑 กล่าวหา (หยุดเวลา): เลือกคน → ยืนยัน
  let accuseInFlight = false;
  function sendAccusation(eventName, targetId) {
    if (accuseInFlight) return;
    accuseInFlight = true;
    socket.emit(eventName, { targetPlayerId: targetId }, function(res) {
      accuseInFlight = false;
      if (res && !res.success) swalError(res.error);
    });
  }
  $(document).on('click', '#sfAccuseBtn', function() {
    if (!currentState || !currentState.canAccuse) return;
    const others = (currentState.players || []).filter(function(p) { return !p.isSelf; });
    let picked = null;
    Swal.fire({
      title: '🛑 กล่าวหาใคร?',
      html: '<div style="font-size:0.9rem;color:#cbd5e1;margin-bottom:10px;">เวลาจะหยุด · ทุกคน (ยกเว้นคนถูกกล่าวหา) ต้องเห็นด้วย · ได้ครั้งเดียวต่อรอบ</div>' +
        '<div class="sf-guess-grid">' + others.map(function(p) {
          return '<button type="button" class="sf-guess-tile sf-accuse-tile" data-target-id="' + escapeHtml(p.playerId) + '">' + playerAvatarHtml(p, 30) + escapeHtml(p.name) + '</button>';
        }).join('') + '</div>',
      showCancelButton: true,
      confirmButtonText: 'ต่อไป',
      cancelButtonText: 'ยกเลิก',
      background: '#111',
      color: '#fff',
      didOpen: function(popup) {
        $(popup).on('click', '.sf-accuse-tile', function() {
          picked = String($(this).data('target-id'));
          $(popup).find('.sf-accuse-tile').removeClass('is-picked');
          $(this).addClass('is-picked');
          Swal.getConfirmButton().textContent = '🛑 กล่าวหา ' + (playerNameById(currentState, picked) || '');
          Swal.resetValidationMessage();
        });
      },
      preConfirm: function() {
        if (!picked) {
          Swal.showValidationMessage('แตะเลือกคนก่อน');
          return false;
        }
        return picked;
      }
    }).then(function(r) {
      if (r.isConfirmed && r.value) sendAccusation('spyfall_accuse', r.value);
    });
  });

  $(document).on('click', '.sf-final-pick', function() {
    pendingAccuseTarget = String($(this).data('target-id'));
    window.gameHaptic && window.gameHaptic(10);
    renderStage(currentState);
  });
  $(document).on('click', '#sfFinalConfirmBtn', function() {
    if (!pendingAccuseTarget) return;
    $(this).prop('disabled', true);
    sendAccusation('spyfall_finalAccuse', pendingAccuseTarget);
  });

  let accuseVoteInFlight = false;
  $(document).on('click', '#sfAgreeBtn, #sfDisagreeBtn', function() {
    if (accuseVoteInFlight) return;
    accuseVoteInFlight = true;
    const agree = this.id === 'sfAgreeBtn';
    $('#sfAgreeBtn, #sfDisagreeBtn').prop('disabled', true);
    window.gameHaptic && window.gameHaptic(15);
    socket.emit('spyfall_accuseVote', { agree: agree }, function(res) {
      accuseVoteInFlight = false;
      if (res && !res.success) {
        swalError(res.error);
        if (currentState) renderStage(currentState);
      }
    });
  });

  $(document).on('click', '#sfNextRoundBtn', function() {
    $(this).prop('disabled', true);
    socket.emit('spyfall_nextRound', {}, function(res) {
      if (res && !res.success) swalError(res.error);
    });
  });

  $('#sfEndGameBtn').on('click', function() {
    Swal.fire({
      icon: 'warning',
      title: 'ยุติเกมกลางคันและกลับห้องรอ?',
      text: 'รอบนี้จะไม่นับผล ทุกคนกลับห้องรอ',
      showCancelButton: true,
      confirmButtonText: 'ยุติเกม',
      cancelButtonText: 'ยกเลิก',
      background: '#111',
      color: '#fff'
    }).then(function(result) {
      if (result.isConfirmed) {
        socket.emit('spyfall_restartGame', {}, function(res) {
          if (res && !res.success) {
            Swal.fire({ icon: 'error', title: res.error || 'ไม่สำเร็จ', background: '#111', color: '#fff' });
          }
        });
      }
    });
  });

  window.addEventListener('beforeunload', function(e) {
    if (!allowNavigation) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  socket.emit('initPlayer', playerId);
  socket.emit('setRoom', { roomId: roomId, playerId: playerId });
  renderState(currentState);
  startTimerTick();
  socket.emit('spyfall_requestState', { roomId: roomId, playerId: playerId });
});
</script>

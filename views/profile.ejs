<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<%
    const S = stats || {};
    const roleStats = S.roleStats || {};
    const winByRole = S.winByRole || {};
    const modeStats = S.modeStats || {};
    const history = Array.isArray(S.gameHistory) ? S.gameHistory : [];
    const totalGames = S.totalGames || 0;
    const totalWins = S.wins || 0;
    const winRate = totalGames > 0 ? Math.round((totalWins / totalGames) * 100) : 0;

    const MODES = [
        { id: 'werewolf', icon: '🐺', label: 'Werewolf' },
        { id: 'insider', icon: '🎯', label: 'Insider' },
        { id: 'blackmarket', icon: '🎩', label: 'Black Market' },
        { id: 'spyfall', icon: '🕵️', label: 'Spyfall' },
        { id: 'coup', icon: '👑', label: 'Coup' },
        { id: 'liar', icon: '🃏', label: 'ไพ่โกหก' },
        { id: 'poker5', icon: '♠\uFE0E', label: 'ไพ่ 5 ใบ' },
        { id: 'poker4', icon: '♦\uFE0E', label: 'สี่ใบเก', tone: 'red' }
    ];
    const modeById = {};
    MODES.forEach(m => { modeById[m.id] = m; });

    const modeRows = MODES.map(m => {
        const row = modeStats[m.id] || {};
        const games = row.games || 0;
        const wins = row.wins || 0;
        return { ...m, games, wins, losses: row.losses || Math.max(0, games - wins), rate: games > 0 ? Math.round((wins / games) * 100) : 0 };
    });
    const playedModes = modeRows.filter(m => m.games > 0).sort((a, b) => b.games - a.games);
    const untriedModes = modeRows.filter(m => m.games === 0);
    const favorite = playedModes[0] || null;

    const insiderRoles = [
        { icon: '👑', label: 'ผู้ดำเนินเกม', times: roleStats.gameMasterCount || 0, wins: null },
        { icon: '😈', label: 'จอมบงการ', times: roleStats.traitorCount || 0, wins: winByRole.winAsTraitor || 0 },
        { icon: '👤', label: 'พลเมือง', times: roleStats.citizenCount || 0, wins: winByRole.winAsCitizen || 0 }
    ].filter(r => r.times > 0);
    const wolfRoleStats = roleStats.werewolf || {};
    const wolfWinStats = winByRole.werewolf || {};
    const werewolfRoleRows = (typeof werewolfRoles !== 'undefined' ? werewolfRoles : [])
        .map(r => ({ icon: r.icon, label: r.label, times: wolfRoleStats[r.id] || 0, wins: wolfWinStats[r.id] || 0 }))
        .filter(r => r.times > 0)
        .sort((a, b) => b.times - a.times);
    const bmRoleStats = roleStats.blackmarket || {};
    const bmWinStats = winByRole.blackmarket || {};
    const blackMarketRoleRows = [
        { id: 'boss', icon: '🎩', label: 'เจ้าพ่อ' },
        { id: 'broker', icon: '🕴️', label: 'นายหน้า' },
        { id: 'smuggler', icon: '🚚', label: 'คนส่งของ' },
        { id: 'fixer', icon: '🧹', label: 'คนเคลียร์ทาง' },
        { id: 'hitman', icon: '🔫', label: 'มือเก็บงาน' },
        { id: 'mole', icon: '🕶️', label: 'สายข่าว' },
        { id: 'doubleAgent', icon: '🃏', label: 'สองหน้า' }
    ].map(r => ({ ...r, times: bmRoleStats[r.id] || 0, wins: bmWinStats[r.id] || 0 }))
     .filter(r => r.times > 0)
     .sort((a, b) => b.times - a.times);
    const roleGroups = [
        { mode: modeById.werewolf, rows: werewolfRoleRows },
        { mode: modeById.insider, rows: insiderRoles },
        { mode: modeById.blackmarket, rows: blackMarketRoleRows }
    ].filter(g => g.rows.length > 0);

    function ago(value) {
        if (!value) return null;
        const seconds = (Date.now() - new Date(value).getTime()) / 1000;
        if (!Number.isFinite(seconds)) return null;
        if (seconds < 60) return 'เมื่อกี้';
        if (seconds < 3600) return Math.floor(seconds / 60) + ' นาทีที่แล้ว';
        if (seconds < 86400) return Math.floor(seconds / 3600) + ' ชม.ที่แล้ว';
        if (seconds < 86400 * 30) return Math.floor(seconds / 86400) + ' วันที่แล้ว';
        return new Date(value).toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' });
    }
    const lastPlayed = ago(S.lastPlayedAt);
    const recoveryCode = typeof viewerRecoveryCode !== 'undefined' ? viewerRecoveryCode : null;
    const googleOn = typeof googleClientId !== 'undefined' && googleClientId;
    const googleLinked = typeof viewerGoogleLinked !== 'undefined' && viewerGoogleLinked;
    const googleEmail = typeof viewerGoogleEmail !== 'undefined' ? viewerGoogleEmail : null;
    const chipBalance = typeof chips === 'number' ? chips : null;
%>
<style>
    .pf {
        --pf-surface: oklch(0.22 0.035 285);
        --pf-surface-2: oklch(0.27 0.04 285);
        --pf-sunken: oklch(0.17 0.03 285);
        --pf-line: oklch(0.42 0.04 285 / 0.55);
        --pf-ink: oklch(0.96 0.01 285);
        --pf-soft: oklch(0.8 0.025 285);
        --pf-muted: oklch(0.68 0.03 285);
        --pf-accent: oklch(0.66 0.2 28);
        --pf-accent-ink: oklch(0.98 0.01 28);
        --pf-gold: oklch(0.84 0.14 85);
        --pf-loss: oklch(0.7 0.09 20);
        --pf-good: oklch(0.82 0.13 165);
        --space-xs: 4px; --space-sm: 8px; --space-md: 12px; --space-lg: 16px;
        --space-xl: 24px; --space-2xl: 32px; --space-3xl: 48px;
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
        --display: 'Chakra Petch', 'Bai Jamjuree', sans-serif;

        max-width: 980px;
        margin: 0 auto var(--space-3xl);
        padding: 0 var(--space-lg);
        color: var(--pf-ink);
        font-family: 'Bai Jamjuree', sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        text-align: left;
    }
    .pf *, .pf *::before, .pf *::after { box-sizing: border-box; }
    .pf button { font-family: inherit; }

    /* ---------- top bar ---------- */
    .pf-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-md) 0 var(--space-lg);
    }
    .pf-back {
        display: inline-flex;
        align-items: center;
        gap: var(--space-sm);
        min-height: 44px;
        padding: 0 var(--space-lg) 0 var(--space-md);
        border-radius: 999px;
        background: var(--pf-surface);
        border: 1px solid var(--pf-line);
        color: var(--pf-soft);
        font-weight: 600;
        text-decoration: none;
    }
    .pf-back:hover { color: var(--pf-ink); text-decoration: none; background: var(--pf-surface-2); }
    .pf-top-title { font-family: var(--display); font-weight: 600; letter-spacing: 0.08em; color: var(--pf-muted); font-size: 0.8rem; text-transform: uppercase; }

    /* ---------- player pass ---------- */
    .pf-layout { display: grid; gap: var(--space-xl); }
    .pf-pass {
        position: relative;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: var(--space-lg) var(--space-xl);
        align-items: center;
        padding: var(--space-2xl) var(--space-xl) var(--space-xl);
        background:
            repeating-linear-gradient(-45deg, color-mix(in oklch, var(--me) 30%, transparent) 0 6px, transparent 6px 14px) top / 100% 10px no-repeat,
            radial-gradient(120% 90% at 0% 0%, color-mix(in oklch, var(--me) 22%, transparent), transparent 60%),
            var(--pf-surface);
        border: 1px solid var(--pf-line);
        /* มุมบากแบบบัตรผ่าน */
        clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 28px 100%, 0 calc(100% - 28px));
        animation: pfRise 0.6s var(--ease-out) both;
    }
    .pf-pass-avatar { position: relative; }
    .pf-pass-avatar .player-avatar { transition: transform 0.25s var(--ease-out); }
    .pf-pass-avatar.is-bumped .player-avatar { transform: scale(0.9); }
    .pf-kicker {
        margin: 0 0 var(--space-xs);
        font-family: var(--display);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--pf-muted);
    }
    .pf-name {
        margin: 0;
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.6rem);
        line-height: 1.1;
        color: var(--me);
        overflow-wrap: anywhere;
    }
    .pf-tags { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-md); }
    .pf-tag {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        background: var(--pf-sunken);
        color: var(--pf-soft);
    }
    .pf-tag.is-safe { color: var(--pf-good); }
    .pf-tag.is-warn { color: var(--pf-gold); background: color-mix(in oklch, var(--pf-gold) 14%, var(--pf-sunken)); border: 0; cursor: pointer; }

    .pf-tally {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin: var(--space-sm) 0 0;
        padding-top: var(--space-lg);
        border-top: 1px dashed var(--pf-line);
    }
    .pf-tally > div { padding: 0 var(--space-sm); }
    .pf-tally > div + div { border-left: 1px solid var(--pf-line); }
    .pf-tally dt { font-size: 0.8rem; color: var(--pf-muted); font-weight: 500; }
    .pf-tally dd { margin: 0; font-family: var(--display); font-size: 1.5rem; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }
    .pf-tally .is-win { color: var(--pf-gold); }
    .pf-fav { grid-column: 1 / -1; margin: 0; color: var(--pf-soft); font-size: 0.95rem; }
    .pf-fav b { color: var(--pf-ink); }

    /* ---------- tabs ---------- */
    .pf-tabs {
        position: sticky;
        top: 0;
        z-index: 5;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-xs);
        padding: var(--space-xs);
        border-radius: 14px;
        background: color-mix(in oklch, var(--pf-sunken) 92%, transparent);
        border: 1px solid var(--pf-line);
        backdrop-filter: blur(8px);
    }
    .pf-tab {
        min-height: 44px;
        border: 0;
        border-radius: 10px;
        background: transparent;
        color: var(--pf-muted);
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
    }
    .pf-tab:hover { color: var(--pf-ink); }
    .pf-tab[aria-selected="true"] { background: var(--pf-accent); color: var(--pf-accent-ink); }
    .pf-tab:focus-visible, .pf button:focus-visible, .pf a:focus-visible, .pf input:focus-visible, .pf summary:focus-visible {
        outline: 2px solid var(--pf-gold);
        outline-offset: 2px;
    }

    .pf-panel { display: grid; gap: var(--space-2xl); padding-top: var(--space-xl); animation: pfFade 0.35s var(--ease-out) both; }
    .pf-panel[hidden] { display: none; }
    .pf-block { display: grid; gap: var(--space-md); }
    .pf-h {
        margin: 0;
        font-family: var(--display);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--pf-ink);
    }
    .pf-sub { margin: -4px 0 0; color: var(--pf-muted); font-size: 0.92rem; max-width: 60ch; }

    /* ---------- stats ---------- */
    .pf-modes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
    .pf-mode {
        display: grid;
        grid-template-columns: 2.25rem minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--space-xs) var(--space-md);
        padding: var(--space-md) var(--space-lg);
        border-radius: 12px;
        background: var(--pf-surface);
    }
    .pf-mode-icon { font-size: 1.5rem; line-height: 1; text-align: center; color: var(--pf-ink); }
    .pf-mode-icon.is-red, .pf-game-icon.is-red { color: oklch(0.68 0.2 25); }
    .pf-mode-name { font-weight: 600; }
    .pf-mode-count { color: var(--pf-muted); font-size: 0.88rem; font-variant-numeric: tabular-nums; }
    .pf-mode-rate { font-family: var(--display); font-weight: 700; font-size: 1.2rem; font-variant-numeric: tabular-nums; text-align: right; }
    .pf-meter {
        grid-column: 2 / -1;
        height: 6px;
        border-radius: 999px;
        background: var(--pf-sunken);
        overflow: hidden;
    }
    .pf-meter > span {
        display: block;
        height: 100%;
        width: var(--rate);
        border-radius: inherit;
        background: var(--pf-gold);
        transform-origin: left;
        animation: pfGrow 0.8s var(--ease-out) both;
    }
    .pf-untried { margin: 0; color: var(--pf-muted); font-size: 0.92rem; }

    .pf-roles { display: grid; gap: var(--space-sm); }
    .pf-rolegroup { border-radius: 12px; background: var(--pf-surface); }
    .pf-rolegroup > summary {
        display: flex; align-items: center; gap: var(--space-sm);
        min-height: 48px;
        padding: 0 var(--space-lg);
        font-weight: 600;
        cursor: pointer;
        list-style: none;
    }
    .pf-rolegroup > summary::-webkit-details-marker { display: none; }
    .pf-rolegroup > summary::after { content: '▾'; margin-left: auto; color: var(--pf-muted); transition: transform 0.2s var(--ease-out); }
    .pf-rolegroup[open] > summary::after { transform: rotate(180deg); }
    .pf-rolelist {
        list-style: none;
        margin: 0;
        padding: 0 var(--space-lg) var(--space-lg);
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: var(--space-sm);
    }
    .pf-role {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto;
        column-gap: var(--space-sm);
        padding: var(--space-sm) var(--space-md);
        border-radius: 10px;
        background: var(--pf-sunken);
    }
    .pf-role-icon { grid-row: span 2; font-size: 1.4rem; align-self: center; }
    .pf-role-label { font-weight: 600; font-size: 0.92rem; }
    .pf-role-meta { font-size: 0.8rem; color: var(--pf-muted); font-variant-numeric: tabular-nums; }
    .pf-role-meta b { color: var(--pf-gold); font-weight: 600; }

    .pf-empty {
        display: grid;
        justify-items: start;
        gap: var(--space-md);
        padding: var(--space-xl);
        border-radius: 14px;
        border: 1px dashed var(--pf-line);
        color: var(--pf-soft);
    }
    .pf-empty p { margin: 0; max-width: 46ch; }

    /* ---------- buttons ---------- */
    .pf-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: var(--space-sm);
        min-height: 44px;
        padding: 0 var(--space-lg);
        border-radius: 10px;
        border: 1px solid var(--pf-line);
        background: var(--pf-surface-2);
        color: var(--pf-ink);
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.2s var(--ease-out), transform 0.1s;
    }
    .pf-btn:hover { background: color-mix(in oklch, var(--pf-surface-2) 70%, var(--pf-ink) 10%); color: var(--pf-ink); text-decoration: none; }
    .pf-btn.is-primary { background: var(--pf-accent); border-color: transparent; color: var(--pf-accent-ink); }
    .pf-btn.is-primary:hover { background: color-mix(in oklch, var(--pf-accent) 88%, white); }
    .pf-btn.is-quiet { background: transparent; border-color: transparent; color: var(--pf-muted); padding: 0 var(--space-sm); }
    .pf-btn.is-quiet:hover { color: var(--pf-ink); background: transparent; }
    .pf-btn:disabled { opacity: 0.55; cursor: progress; }

    /* ---------- style editor ---------- */
    .pf-field { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
    .pf-input {
        flex: 1 1 200px;
        min-width: 0;
        min-height: 44px;
        padding: 0 var(--space-md);
        border-radius: 10px;
        border: 1px solid var(--pf-line);
        background: var(--pf-sunken);
        color: var(--pf-ink);
        font: inherit;
        font-size: 1rem;
    }
    .pf-input:focus { border-color: var(--pf-gold); outline: none; }
    .pf-hint { margin: 0; font-size: 0.85rem; color: var(--pf-muted); }
    .pf-swatches, .pf-avatars, .pf-frames { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
    .pf-swatch {
        width: 44px; height: 44px;
        border-radius: 50%;
        border: 3px solid transparent;
        background: var(--c);
        box-shadow: inset 0 0 0 2px oklch(0.15 0.02 285 / 0.4);
        cursor: pointer;
        transition: transform 0.2s var(--ease-out);
    }
    .pf-swatch:hover { transform: scale(1.08); }
    .pf-swatch[aria-pressed="true"] { border-color: var(--pf-ink); transform: scale(1.08); }
    .pf-pick {
        display: grid; place-items: center;
        width: 52px; height: 52px;
        border-radius: 12px;
        border: 2px solid transparent;
        background: var(--pf-surface);
        font-size: 1.6rem;
        cursor: pointer;
        transition: transform 0.2s var(--ease-out), background 0.2s;
    }
    .pf-pick:hover { background: var(--pf-surface-2); transform: translateY(-2px); }
    .pf-pick[aria-pressed="true"] { border-color: var(--pf-gold); background: var(--pf-surface-2); }
    .pf-frames .pf-pick { width: 64px; height: 64px; }

    /* ---------- history ---------- */
    .pf-games { display: grid; gap: var(--space-sm); }
    .pf-game { border-radius: 12px; background: var(--pf-surface); }
    .pf-game > summary {
        display: grid;
        grid-template-columns: auto 1.75rem minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--space-md);
        min-height: 56px;
        padding: var(--space-sm) var(--space-lg);
        cursor: pointer;
        list-style: none;
    }
    .pf-game > summary::-webkit-details-marker { display: none; }
    .pf-result {
        min-width: 3.4rem;
        padding: 2px 10px;
        border-radius: 999px;
        font-family: var(--display);
        font-size: 0.85rem;
        font-weight: 700;
        text-align: center;
    }
    .pf-result.is-win { background: color-mix(in oklch, var(--pf-gold) 22%, transparent); color: var(--pf-gold); }
    .pf-result.is-loss { background: var(--pf-sunken); color: var(--pf-loss); }
    .pf-game-icon { font-size: 1.3rem; text-align: center; color: var(--pf-ink); }
    .pf-game-main { min-width: 0; }
    .pf-game-title { display: block; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pf-game-role { display: block; font-size: 0.85rem; color: var(--pf-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pf-game-when { font-size: 0.8rem; color: var(--pf-muted); white-space: nowrap; }
    .pf-game-body {
        display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-lg);
        margin: 0;
        padding: 0 var(--space-lg) var(--space-lg) calc(var(--space-lg) + 3.4rem + var(--space-md));
        font-size: 0.9rem;
        color: var(--pf-soft);
    }

    /* ---------- account ---------- */
    .pf-account { display: grid; gap: var(--space-xl); }
    .pf-option {
        display: grid;
        gap: var(--space-md);
        padding: var(--space-xl);
        border-radius: 14px;
        background: var(--pf-surface);
    }
    .pf-option.is-recommended { background: color-mix(in oklch, var(--pf-good) 8%, var(--pf-surface)); }
    .pf-option-head { display: flex; align-items: center; gap: var(--space-sm); flex-wrap: wrap; }
    .pf-option-head .pf-h { font-size: 1.05rem; }
    .pf-pill { padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; background: color-mix(in oklch, var(--pf-good) 20%, transparent); color: var(--pf-good); }
    .pf-code-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); }
    .pf-code {
        font-family: var(--display);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        padding: var(--space-sm) var(--space-lg);
        border-radius: 10px;
        background: var(--pf-sunken);
        color: var(--pf-gold);
        font-variant-numeric: tabular-nums;
    }
    .pf-restore > summary { cursor: pointer; color: var(--pf-soft); font-weight: 600; min-height: 44px; display: flex; align-items: center; }
    .pf-restore[open] > summary { margin-bottom: var(--space-sm); }
    .pf-restore .pf-input { letter-spacing: 0.12em; text-transform: uppercase; }

    /* ---------- toast ---------- */
    .pf-toast {
        position: fixed;
        left: 50%;
        /* อยู่เหนือ footer นำทางที่ตรึงล่างจอ */
        bottom: calc(88px + env(safe-area-inset-bottom));
        z-index: 9000;
        max-width: calc(100vw - 32px);
        padding: var(--space-md) var(--space-xl);
        border-radius: 999px;
        background: oklch(0.96 0.01 285);
        color: oklch(0.2 0.03 285);
        font-family: 'Bai Jamjuree', sans-serif;
        font-weight: 600;
        box-shadow: 0 10px 30px oklch(0.1 0.02 285 / 0.5);
        transform: translate(-50%, 150%);
        opacity: 0;
        transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
        pointer-events: none;
    }
    .pf-toast.is-on { transform: translate(-50%, 0); opacity: 1; }
    .pf-toast.is-error { background: oklch(0.66 0.2 28); color: oklch(0.98 0.01 28); }

    @keyframes pfRise { from { opacity: 0; transform: translateY(14px); } }
    @keyframes pfFade { from { opacity: 0; transform: translateY(6px); } }
    @keyframes pfGrow { from { transform: scaleX(0); } }

    /* ---------- desktop: pass sticks on the left ---------- */
    @media (min-width: 900px) {
        .pf-layout { grid-template-columns: 330px minmax(0, 1fr); align-items: start; }
        .pf-side { position: sticky; top: var(--space-lg); }
        .pf-pass { grid-template-columns: 1fr; justify-items: start; }
        .pf-tally, .pf-fav { justify-self: stretch; }
        .pf-tally { grid-template-columns: repeat(2, 1fr); row-gap: var(--space-md); }
        .pf-tally > div:nth-child(3) { border-left: 0; }
    }
    @media (max-width: 420px) {
        .pf-pass { padding: var(--space-xl) var(--space-lg) var(--space-lg); column-gap: var(--space-lg); }
        .pf-tally dd { font-size: 1.25rem; }
        .pf-tab { font-size: 0.88rem; }
        .pf-game > summary { grid-template-columns: auto minmax(0, 1fr) auto; }
        .pf-game-icon { display: none; }
        .pf-game-body { padding-left: var(--space-lg); }
    }
    @media (prefers-reduced-motion: reduce) {
        .pf-pass, .pf-panel, .pf-meter > span { animation: none; }
        .pf-toast { transition: opacity 0.2s; }
    }
</style>

<main class="pf" style="--me: <%= player.color %>;">
    <p class="pf-top"><span class="pf-top-title">Player Pass</span></p>

    <div class="pf-layout">
        <aside class="pf-side">
            <section class="pf-pass" aria-label="บัตรนักเล่น">
                <div class="pf-pass-avatar" id="pfAvatar"
                     data-avatar="<%= player.avatar || '👤' %>"
                     data-frame="<%= player.avatarFrame || 'none' %>"></div>
                <div>
                    <p class="pf-kicker"><%= lastPlayed ? 'เล่นล่าสุด ' + lastPlayed : 'ยังไม่เคยเล่น' %></p>
                    <h1 class="pf-name" id="pfName"><%= player.playerName %></h1>
                    <div class="pf-tags">
                        <% if (googleLinked) { %>
                            <span class="pf-tag is-safe"><i class="fab fa-google" aria-hidden="true"></i> บัญชีปลอดภัย</span>
                        <% } else { %>
                            <button type="button" class="pf-tag is-warn" data-goto="account">⚠️ ยังไม่ได้เก็บบัญชี</button>
                        <% } %>
                    </div>
                </div>
                <dl class="pf-tally">
                    <div><dt>เกม</dt><dd><%= totalGames.toLocaleString('th-TH') %></dd></div>
                    <div><dt>ชนะ</dt><dd class="is-win"><%= totalWins.toLocaleString('th-TH') %></dd></div>
                    <div><dt>อัตราชนะ</dt><dd><%= winRate %>%</dd></div>
                    <div><dt>ชิป</dt><dd><%= chipBalance !== null ? chipBalance.toLocaleString('th-TH') : '–' %></dd></div>
                </dl>
                <% if (favorite) { %>
                    <p class="pf-fav">ถนัดสุด <b><%= favorite.icon %> <%= favorite.label %></b> · เล่น <%= favorite.games %> เกม ชนะ <%= favorite.rate %>%</p>
                <% } %>
            </section>
        </aside>

        <div class="pf-main">
            <div class="pf-tabs" role="tablist" aria-label="ส่วนของโปรไฟล์">
                <button type="button" class="pf-tab" role="tab" id="tab-stats" aria-controls="panel-stats" data-tab="stats">สถิติ</button>
                <button type="button" class="pf-tab" role="tab" id="tab-style" aria-controls="panel-style" data-tab="style">แต่งตัว</button>
                <button type="button" class="pf-tab" role="tab" id="tab-history" aria-controls="panel-history" data-tab="history">ประวัติ</button>
                <button type="button" class="pf-tab" role="tab" id="tab-account" aria-controls="panel-account" data-tab="account">บัญชี</button>
            </div>

            <!-- ============ สถิติ ============ -->
            <section class="pf-panel" role="tabpanel" id="panel-stats" aria-labelledby="tab-stats">
                <% if (playedModes.length === 0) { %>
                    <div class="pf-empty">
                        <p>ยังไม่มีสถิติ เล่นเกมแรกเลย แล้วตัวเลขทั้งหมดจะมาโผล่ตรงนี้</p>
                        <a href="/rooms" class="pf-btn is-primary">🎮 หาห้องเล่น</a>
                    </div>
                <% } else { %>
                    <div class="pf-block">
                        <h2 class="pf-h">แต่ละเกม</h2>
                        <ul class="pf-modes">
                            <% playedModes.forEach(function(m) { %>
                                <li class="pf-mode">
                                    <span class="pf-mode-icon<%= m.tone === 'red' ? ' is-red' : '' %>" aria-hidden="true"><%= m.icon %></span>
                                    <span>
                                        <span class="pf-mode-name"><%= m.label %></span>
                                        <span class="pf-mode-count"> · <%= m.games %> เกม · ชนะ <%= m.wins %> แพ้ <%= m.losses %></span>
                                    </span>
                                    <span class="pf-mode-rate"><%= m.rate %>%</span>
                                    <span class="pf-meter" role="img" aria-label="อัตราชนะ <%= m.rate %>%"><span style="--rate: <%= m.rate %>%;"></span></span>
                                </li>
                            <% }); %>
                        </ul>
                        <% if (untriedModes.length) { %>
                            <p class="pf-untried">ยังไม่เคยลอง: <%= untriedModes.map(m => m.icon + ' ' + m.label).join(' · ') %></p>
                        <% } %>
                    </div>

                    <% if (roleGroups.length) { %>
                        <div class="pf-block">
                            <h2 class="pf-h">บทบาทที่ได้</h2>
                            <div class="pf-roles">
                                <% roleGroups.forEach(function(group, index) { %>
                                    <details class="pf-rolegroup" <%= index === 0 ? 'open' : '' %>>
                                        <summary><span aria-hidden="true"><%= group.mode.icon %></span> <%= group.mode.label %></summary>
                                        <ul class="pf-rolelist">
                                            <% group.rows.forEach(function(role) { %>
                                                <li class="pf-role">
                                                    <span class="pf-role-icon" aria-hidden="true"><%= role.icon %></span>
                                                    <span class="pf-role-label"><%= role.label %></span>
                                                    <span class="pf-role-meta"><%= role.times %> ครั้ง<% if (role.wins !== null) { %> · ชนะ <b><%= role.wins %></b><% } %></span>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    </details>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </section>

            <!-- ============ แต่งตัว ============ -->
            <section class="pf-panel" role="tabpanel" id="panel-style" aria-labelledby="tab-style" hidden>
                <div class="pf-block">
                    <h2 class="pf-h">ชื่อ</h2>
                    <form class="pf-field" id="pfNameForm">
                        <input class="pf-input" type="text" id="playerNameInput" value="<%= player.playerName %>" maxlength="20" autocomplete="off" aria-label="ชื่อผู้เล่น">
                        <button type="submit" class="pf-btn is-primary" id="updateNameBtn">บันทึกชื่อ</button>
                    </form>
                    <p class="pf-hint">2–20 ตัวอักษร ห้ามซ้ำกับคนอื่น</p>
                </div>

                <div class="pf-block">
                    <h2 class="pf-h">สีประจำตัว</h2>
                    <div class="pf-swatches" role="group" aria-label="สีชื่อ">
                        <% availableColors.forEach(function(color) { %>
                            <button type="button" class="pf-swatch" data-color="<%= color %>" style="--c: <%= color %>;"
                                    aria-pressed="<%= color === player.color ? 'true' : 'false' %>" aria-label="สี <%= color %>"></button>
                        <% }); %>
                    </div>
                </div>

                <div class="pf-block">
                    <h2 class="pf-h">หน้าตา</h2>
                    <div class="pf-avatars" id="avatarSelection" role="group" aria-label="อวาตาร์"><p class="pf-hint">กำลังโหลด…</p></div>
                </div>

                <div class="pf-block">
                    <h2 class="pf-h">กรอบ</h2>
                    <div class="pf-frames" id="frameSelection" role="group" aria-label="กรอบอวาตาร์"><p class="pf-hint">กำลังโหลด…</p></div>
                </div>
            </section>

            <!-- ============ ประวัติ ============ -->
            <section class="pf-panel" role="tabpanel" id="panel-history" aria-labelledby="tab-history" hidden>
                <% if (history.length === 0) { %>
                    <div class="pf-empty">
                        <p>ยังไม่มีเกมที่จบ ทุกเกมที่เล่นจนจบจะถูกเก็บไว้ตรงนี้ ทั้งบทบาท ทีมที่ชนะ และคำที่ได้</p>
                        <a href="/rooms" class="pf-btn is-primary">🎮 หาห้องเล่น</a>
                    </div>
                <% } else { %>
                    <div class="pf-games">
                        <% history.forEach(function(game) {
                            const mode = modeById[game.mode] || modeById.insider;
                            const when = ago(game.date);
                            const role = game.role && game.role !== 'ไม่ทราบ' ? game.role : null;
                            const room = game.roomName && game.roomName !== mode.label ? game.roomName : null;
                            const subline = [role, room].filter(Boolean).join(' · ');
                        %>
                            <details class="pf-game">
                                <summary>
                                    <span class="pf-result <%= game.won ? 'is-win' : 'is-loss' %>"><%= game.won ? 'ชนะ' : 'แพ้' %></span>
                                    <span class="pf-game-icon<%= mode.tone === 'red' ? ' is-red' : '' %>" aria-hidden="true"><%= mode.icon %></span>
                                    <span class="pf-game-main">
                                        <span class="pf-game-title"><%= mode.label %></span>
                                        <% if (subline) { %><span class="pf-game-role"><%= subline %></span><% } %>
                                    </span>
                                    <span class="pf-game-when"><%= when || '' %></span>
                                </summary>
                                <p class="pf-game-body">
                                    <% if (game.mode === 'werewolf') { %>
                                        <span>ทีม <%= game.team === 'werewolf' ? 'หมาป่า 🐾' : 'ชาวบ้าน 🏡' %></span>
                                        <span>ทีมชนะ <%= game.winnerLabel || (game.winner === 'werewolf' ? 'หมาป่า' : 'ชาวบ้าน') %></span>
                                        <span>จบวันที่ <%= game.dayNumber || 0 %></span>
                                        <span><%= game.survived ? '✨ รอดจนจบ' : '💀 ไม่รอด' %></span>
                                    <% } else if (game.mode === 'blackmarket') { %>
                                        <span>เจ้าโต๊ะ <%= game.winnerLabel || '—' %></span>
                                        <span>👑 <%= game.influence || 0 %> · 💵 <%= game.cash || 0 %> · 🔥 <%= game.heat || 0 %></span>
                                        <% if (game.resultText) { %><span><%= game.resultText %></span><% } %>
                                    <% } else if (game.mode === 'spyfall') { %>
                                        <span>📍 <%= game.location || 'ไม่ทราบสถานที่' %></span>
                                        <span>สายลับ <%= game.spyName || '—' %></span>
                                        <span><%= game.citizensWon ? 'พลเมืองชนะ' : 'สายลับรอด' %></span>
                                    <% } else if (!game.mode || game.mode === 'insider') { %>
                                        <% if (game.word) { %><span>คำ “<%= game.word %>”</span><% } %>
                                        <% if (game.traitor) { %><span>จอมบงการ <%= game.traitor %></span><% } %>
                                    <% } else if (game.resultText) { %>
                                        <span><%= game.resultText %></span>
                                    <% } %>
                                    <% if (game.playerCount) { %><span>👥 <%= game.playerCount %> คน</span><% } %>
                                    <% if (game.date) { %><span><%= new Date(game.date).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Bangkok' }) %></span><% } %>
                                </p>
                            </details>
                        <% }); %>
                    </div>
                <% } %>
            </section>

            <!-- ============ บัญชี ============ -->
            <section class="pf-panel" role="tabpanel" id="panel-account" aria-labelledby="tab-account" hidden>
                <div class="pf-account">
                    <% if (googleOn) { %>
                        <div class="pf-option is-recommended">
                            <div class="pf-option-head">
                                <h2 class="pf-h"><i class="fab fa-google" aria-hidden="true"></i> บัญชี Google</h2>
                                <% if (!googleLinked) { %><span class="pf-pill">แนะนำ</span><% } %>
                            </div>
                            <% if (googleLinked) { %>
                                <p class="pf-sub">ผูกแล้ว<% if (googleEmail) { %> กับ <b><%= googleEmail %></b><% } %> เปลี่ยนเครื่องหรือล้างเบราว์เซอร์ กดล็อกอินด้วย Gmail นี้ก็ได้บัญชีคืน</p>
                                <div><button type="button" class="pf-btn is-quiet" id="googleUnlink">ยกเลิกการผูก</button></div>
                            <% } else { %>
                                <p class="pf-sub">ผูกกับ Gmail ครั้งเดียว เปลี่ยนมือถือเมื่อไหร่ก็ล็อกอินกลับมา ถ้วยและสถิติอยู่ครบ ไม่ต้องจำรหัส</p>
                                <div data-google-signin data-google-text="continue_with"></div>
                            <% } %>
                        </div>
                    <% } %>

                    <div class="pf-option">
                        <h2 class="pf-h">🔑 รหัสกู้บัญชี</h2>
                        <p class="pf-sub"><%= googleOn ? 'ใช้แทน Google ได้ ' : '' %>แคปเก็บไว้ ถ้าล้างเบราว์เซอร์หรือเปลี่ยนเครื่อง ใช้รหัสนี้เอาบัญชีคืน ใครมีรหัสนี้เข้าบัญชีคุณได้ อย่าให้คนอื่นดู</p>
                        <% if (recoveryCode) { %>
                            <div class="pf-code-row">
                                <code class="pf-code" id="recoveryCode" data-code="<%= recoveryCode %>">••••-••••-••••</code>
                                <button type="button" class="pf-btn" id="recoveryReveal">แสดง</button>
                                <button type="button" class="pf-btn" id="recoveryCopy">คัดลอก</button>
                            </div>
                        <% } else { %>
                            <p class="pf-hint">รหัสจะพร้อมหลังเล่นเกมแรก</p>
                        <% } %>
                        <details class="pf-restore">
                            <summary>มีรหัสจากเครื่องอื่น? เอาบัญชีนั้นมาที่เครื่องนี้</summary>
                            <form class="pf-field" id="pfRestoreForm">
                                <input class="pf-input" type="text" id="recoveryInput" placeholder="XXXX-XXXX-XXXX" maxlength="14" autocomplete="off" aria-label="รหัสกู้บัญชี">
                                <button type="submit" class="pf-btn is-primary" id="recoveryRestore">กู้บัญชี</button>
                            </form>
                            <p class="pf-hint" style="margin-top: 8px;">บัญชีที่ใช้อยู่บนเครื่องนี้จะถูกสลับออก</p>
                        </details>
                    </div>
                </div>
            </section>
        </div>
    </div>
</main>
<div class="pf-toast" id="pfToast" role="status" aria-live="polite"></div>

<%- contentFor('footer') %>
<%- include('partials/footerNav', { back: { href: '/', label: 'กลับหน้าหลัก' } }) %>

<%- contentFor('script') %>
<script>
(function() {
    var root = document.querySelector('.pf');
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var state = {
        avatar: document.getElementById('pfAvatar').getAttribute('data-avatar') || '👤',
        frame: document.getElementById('pfAvatar').getAttribute('data-frame') || 'none',
        color: '<%= player.color %>',
        name: document.getElementById('pfName').textContent
    };

    /* ---------- toast แทน popup — ไม่ขวางการกดต่อ ---------- */
    var toastEl = document.getElementById('pfToast');
    var toastTimer = null;
    function toast(text, isError) {
        toastEl.textContent = text;
        toastEl.classList.toggle('is-error', !!isError);
        toastEl.classList.add('is-on');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function() { toastEl.classList.remove('is-on'); }, isError ? 3200 : 1800);
    }

    function postJson(url, body) {
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body || {})
        }).then(function(r) { return r.json(); });
    }

    /* ---------- บัตรนักเล่น ---------- */
    function renderPass(bump) {
        var box = document.getElementById('pfAvatar');
        var size = window.innerWidth < 420 ? 84 : 104;
        box.innerHTML = window.PlayerAvatar
            ? PlayerAvatar.render({ avatar: state.avatar, avatarFrame: state.frame, color: state.color, playerName: state.name }, { size: size })
            : '<span style="font-size:48px">' + state.avatar + '</span>';
        if (bump && !reducedMotion) {
            box.classList.add('is-bumped');
            requestAnimationFrame(function() { requestAnimationFrame(function() { box.classList.remove('is-bumped'); }); });
        }
    }
    renderPass(false);

    /* ---------- แท็บ (จำแท็บไว้ใน URL #) ---------- */
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.pf-tab'));
    function selectTab(name, focus) {
        var found = tabs.some(function(t) { return t.getAttribute('data-tab') === name; });
        if (!found) name = 'stats';
        tabs.forEach(function(tab) {
            var on = tab.getAttribute('data-tab') === name;
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
            tab.tabIndex = on ? 0 : -1;
            document.getElementById(tab.getAttribute('aria-controls')).hidden = !on;
            if (on && focus) tab.focus();
        });
        if (history.replaceState) history.replaceState(null, '', '#' + name);
        if (name === 'style') loadWardrobe();
    }
    tabs.forEach(function(tab, i) {
        tab.addEventListener('click', function() { selectTab(tab.getAttribute('data-tab')); });
        tab.addEventListener('keydown', function(e) {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            var next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
            selectTab(next.getAttribute('data-tab'), true);
        });
    });
    document.querySelectorAll('[data-goto]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            selectTab(btn.getAttribute('data-goto'));
            document.querySelector('.pf-tabs').scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
        });
    });
    selectTab((location.hash || '#stats').slice(1));

    /* ---------- ชื่อ ---------- */
    document.getElementById('pfNameForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var input = document.getElementById('playerNameInput');
        var btn = document.getElementById('updateNameBtn');
        var newName = input.value.trim();
        if (!newName) { toast('ใส่ชื่อก่อนนะ', true); input.focus(); return; }
        if (newName === state.name) { toast('ชื่อนี้ใช้อยู่แล้ว'); return; }
        btn.disabled = true;
        postJson('/profile/updateName', { name: newName }).then(function(res) {
            if (!res.success) throw new Error(res.error || 'บันทึกชื่อไม่สำเร็จ');
            state.name = newName;
            document.getElementById('pfName').textContent = newName;
            toast('เปลี่ยนชื่อแล้ว ✓');
        }).catch(function(err) {
            toast(err.message || 'บันทึกชื่อไม่สำเร็จ', true);
        }).then(function() { btn.disabled = false; });
    });

    /* ---------- สี (เปลี่ยนทันที ถ้าพังค่อยย้อน) ---------- */
    document.querySelectorAll('.pf-swatch').forEach(function(sw) {
        sw.addEventListener('click', function() {
            var color = sw.getAttribute('data-color');
            if (color === state.color) return;
            var previous = state.color;
            applyColor(color);
            postJson('/profile/updateColor', { color: color }).then(function(res) {
                if (!res.success) throw new Error(res.error || 'เปลี่ยนสีไม่สำเร็จ');
                toast('เปลี่ยนสีแล้ว ✓');
            }).catch(function(err) {
                applyColor(previous);
                toast(err.message || 'เปลี่ยนสีไม่สำเร็จ', true);
            });
        });
    });
    function applyColor(color) {
        state.color = color;
        root.style.setProperty('--me', color);
        document.querySelectorAll('.pf-swatch').forEach(function(sw) {
            sw.setAttribute('aria-pressed', sw.getAttribute('data-color') === color ? 'true' : 'false');
        });
        renderPass(false);
    }

    /* ---------- อวาตาร์ + กรอบ (โหลดเมื่อเปิดแท็บแต่งตัว) ---------- */
    var wardrobeLoaded = false;
    function loadWardrobe() {
        if (wardrobeLoaded) return;
        wardrobeLoaded = true;
        fetch('/api/avatars', { credentials: 'same-origin' }).then(function(r) { return r.json(); }).then(function(data) {
            var avatars = Array.isArray(data && data.avatars) ? data.avatars : [];
            var frames = Array.isArray(data && data.frames) ? data.frames : [];
            var avatarBox = document.getElementById('avatarSelection');
            avatarBox.innerHTML = '';
            avatars.forEach(function(avatar) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'pf-pick';
                b.textContent = avatar;
                b.setAttribute('data-avatar', avatar);
                b.setAttribute('aria-pressed', avatar === state.avatar ? 'true' : 'false');
                b.setAttribute('aria-label', 'อวาตาร์ ' + avatar);
                avatarBox.appendChild(b);
            });
            var frameBox = document.getElementById('frameSelection');
            frameBox.innerHTML = '';
            frames.forEach(function(frame) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'pf-pick';
                b.title = frame.name;
                b.setAttribute('aria-label', 'กรอบ ' + frame.name);
                b.setAttribute('data-frame', frame.id);
                b.setAttribute('aria-pressed', frame.id === state.frame ? 'true' : 'false');
                b.innerHTML = window.PlayerAvatar
                    ? PlayerAvatar.render({ avatar: state.avatar, avatarFrame: frame.id, color: state.color }, { size: 44 })
                    : frame.name;
                frameBox.appendChild(b);
            });
            if (!avatars.length) avatarBox.innerHTML = '<p class="pf-hint">ไม่พบอวาตาร์</p>';
            if (!frames.length) frameBox.innerHTML = '<p class="pf-hint">ไม่พบกรอบ</p>';
        }).catch(function() {
            wardrobeLoaded = false;
            document.getElementById('avatarSelection').innerHTML = '<p class="pf-hint">โหลดไม่สำเร็จ ลองเปิดแท็บนี้ใหม่</p>';
            document.getElementById('frameSelection').innerHTML = '';
        });
    }

    function refreshFramePreviews() {
        document.querySelectorAll('#frameSelection .pf-pick').forEach(function(b) {
            if (!window.PlayerAvatar) return;
            b.innerHTML = PlayerAvatar.render({ avatar: state.avatar, avatarFrame: b.getAttribute('data-frame'), color: state.color }, { size: 44 });
        });
    }

    function pickHandler(kind) {
        return function(e) {
            var b = e.target.closest('.pf-pick');
            if (!b) return;
            var value = b.getAttribute(kind === 'avatar' ? 'data-avatar' : 'data-frame');
            var previous = state[kind];
            if (value === previous) return;
            setPick(kind, value);
            var req = kind === 'avatar'
                ? postJson('/profile/updateAvatar', { avatar: value })
                : postJson('/profile/updateAvatarFrame', { frameId: value });
            req.then(function(res) {
                if (!res.success) throw new Error(res.error || 'บันทึกไม่สำเร็จ');
                toast(kind === 'avatar' ? 'เปลี่ยนหน้าตาแล้ว ✓' : 'ใส่กรอบแล้ว ✓');
            }).catch(function(err) {
                setPick(kind, previous);
                toast(err.message || 'บันทึกไม่สำเร็จ', true);
            });
        };
    }
    function setPick(kind, value) {
        state[kind] = value;
        var attr = kind === 'avatar' ? 'data-avatar' : 'data-frame';
        var box = document.getElementById(kind === 'avatar' ? 'avatarSelection' : 'frameSelection');
        box.querySelectorAll('.pf-pick').forEach(function(b) {
            b.setAttribute('aria-pressed', b.getAttribute(attr) === value ? 'true' : 'false');
        });
        if (kind === 'avatar') refreshFramePreviews();
        renderPass(true);
    }
    document.getElementById('avatarSelection').addEventListener('click', pickHandler('avatar'));
    document.getElementById('frameSelection').addEventListener('click', pickHandler('frame'));

    /* ---------- บัญชี ---------- */
    var codeEl = document.getElementById('recoveryCode');
    if (codeEl) {
        var code = codeEl.getAttribute('data-code');
        try { localStorage.setItem('insiderGameRecoveryCode', code); } catch (e) {}
        document.getElementById('recoveryReveal').addEventListener('click', function() {
            var show = codeEl.textContent !== code;
            codeEl.textContent = show ? code : '••••-••••-••••';
            this.textContent = show ? 'ซ่อน' : 'แสดง';
        });
        document.getElementById('recoveryCopy').addEventListener('click', function() {
            if (!navigator.clipboard) { toast('คัดลอกไม่ได้ กด "แสดง" แล้วจดไว้แทน', true); return; }
            navigator.clipboard.writeText(code).then(function() { toast('คัดลอกรหัสแล้ว ✓'); }, function() {
                toast('คัดลอกไม่ได้ กด "แสดง" แล้วจดไว้แทน', true);
            });
        });
    }

    var unlinkBtn = document.getElementById('googleUnlink');
    if (unlinkBtn) {
        unlinkBtn.addEventListener('click', function() {
            var ask = window.Swal
                ? Swal.fire({
                    icon: 'warning',
                    title: 'ยกเลิกการผูก Google?',
                    text: 'ถ้าล้างเบราว์เซอร์หลังจากนี้ จะต้องใช้รหัสกู้บัญชีแทน',
                    showCancelButton: true,
                    confirmButtonText: 'ยกเลิกการผูก',
                    cancelButtonText: 'ไม่ใช่',
                    background: '#1e1e2e',
                    color: '#fff'
                }).then(function(r) { return r.isConfirmed; })
                : Promise.resolve(confirm('ยกเลิกการผูก Google?'));
            ask.then(function(ok) {
                if (!ok) return;
                fetch('/api/auth/google/unlink', { method: 'POST', credentials: 'same-origin' })
                    .then(function() { location.reload(); });
            });
        });
    }

    document.getElementById('pfRestoreForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var btn = document.getElementById('recoveryRestore');
        btn.disabled = true;
        postJson('/api/identity/restore', { code: document.getElementById('recoveryInput').value }).then(function(res) {
            if (!res.success) throw new Error(res.error || 'รหัสไม่ถูกต้อง');
            localStorage.setItem('insiderGamePlayerId', res.playerId);
            localStorage.setItem('insiderGameRecoveryCode', res.recoveryCode);
            location.replace('/profile');
        }).catch(function(err) {
            toast(err.message || 'กู้บัญชีไม่สำเร็จ', true);
            btn.disabled = false;
        });
    });
})();
</script>

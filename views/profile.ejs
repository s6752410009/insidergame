<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
    .profile-container {
        max-width: 1200px;
        margin: 30px auto;
        padding: 20px;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .profile-container h1 {
        margin-bottom: 40px;
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 2.8em;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        letter-spacing: 2px;
        text-align: center;
    }
    
    .profile-section {
        background: linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 100%);
        border: 3px solid #444;
        border-radius: 15px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.5);
    }
    
    .profile-section h2 {
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.8em;
        margin-bottom: 25px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
        border-bottom: 2px solid #e74c3c;
        padding-bottom: 10px;
    }
    
    .form-group {
        margin-bottom: 25px;
    }
    
    .form-group label {
        display: block;
        margin-bottom: 10px;
        font-weight: 600;
        color: #fff;
        font-size: 1.1em;
        font-family: 'Rajdhani', sans-serif;
    }
    
    #playerNameInput {
        flex: 1;
        padding: 12px 16px;
        border: 2px solid #444;
        border-radius: 8px;
        background: #1a1a1a;
        color: #fff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1em;
    }
    
    #playerNameInput:focus {
        outline: none;
        border-color: #e74c3c;
        box-shadow: 0 0 10px rgba(231, 76, 60, 0.3);
    }
    
    .btn-profile {
        padding: 12px 24px;
        border: 2px solid #e74c3c;
        border-radius: 8px;
        background: #e74c3c;
        color: #fff;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        font-size: 1em;
        cursor: pointer;
        transition: all 0.3s;
        text-transform: uppercase;
    }
    
    .btn-profile:hover {
        background: #c0392b;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(231, 76, 60, 0.4);
    }
    
    .color-btn {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s;
        border: 3px solid transparent;
    }
    
    .color-btn:hover {
        transform: scale(1.15);
        box-shadow: 0 4px 12px rgba(255,255,255,0.3);
    }
    
    .color-btn.active {
        border-color: #fff;
        box-shadow: 0 0 15px rgba(255,255,255,0.5);
    }
    
    .player-id {
        margin-top: 25px;
        padding: 20px;
        background: #1a1a1a;
        border: 2px solid #444;
        border-radius: 8px;
    }
    
    .player-id p {
        margin: 0;
        color: #aaa;
        font-size: 0.95em;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .player-id code {
        background: #2d2d2d;
        padding: 4px 10px;
        border-radius: 5px;
        color: #ff6b6b;
        font-family: 'Courier New', monospace;
        border: 1px solid #444;
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 22px;
    }
    
    .stat-card {
        background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
        border: 2px solid #444;
        border-radius: 12px;
        padding: 10px 8px;
        text-align: center;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
    }
    
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #e74c3c, #c0392b);
    }
    
    .stat-card:hover {
        transform: translateY(-2px);
        border-color: #e74c3c;
        box-shadow: 0 8px 20px rgba(231, 76, 60, 0.28);
    }
    
    .stat-icon {
        font-size: 1.35em;
        margin-bottom: 4px;
        display: block;
        line-height: 1;
    }
    
    .stat-value {
        font-size: 1.25em;
        font-weight: 900;
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        margin: 2px 0;
        line-height: 1.1;
        text-shadow: none;
    }
    
    .stat-label {
        color: #aaa;
        font-size: 0.68rem;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        margin-top: 4px;
        line-height: 1.25;
    }
    
    .stats-section-title {
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.1em;
        margin-top: 20px;
        margin-bottom: 12px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
        border-bottom: 2px solid #444;
        padding-bottom: 10px;
    }
    
    .role-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 22px;
    }
    
    .role-stat-card {
        background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
        border: 3px solid #444;
        border-left: 5px solid;
        border-radius: 12px;
        padding: 10px 8px;
        text-align: center;
        transition: all 0.3s;
    }
    
    .role-stat-card:hover {
        transform: translateX(5px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.5);
    }
    
    .role-stat-card.citizen {
        border-left-color: #3498db;
    }
    
    .role-stat-card.traitor {
        border-left-color: #e74c3c;
    }
    
    .role-stat-card.gamemaster {
        border-left-color: #f39c12;
    }

    .role-stat-card.werewolf-role {
        border-left-color: #c0392b;
    }

    .role-stat-card.village-role {
        border-left-color: #3498db;
    }

    .role-stat-card.support-role {
        border-left-color: #16a085;
    }

    .role-stat-card.mode-insider {
        border-left-color: #8e44ad;
    }

    .role-stat-card.mode-werewolf {
        border-left-color: #c0392b;
    }

    .role-stat-card.mode-blackmarket {
        border-left-color: #f6d365;
    }

    .role-stat-card.mode-spyfall {
        border-left-color: #1abc9c;
    }

    .role-stat-card.blackmarket-role {
        border-left-color: #f6d365;
    }
    
    .role-stat-icon {
        font-size: 1.35em;
        margin-bottom: 4px;
        line-height: 1;
    }
    
    .role-stat-value {
        font-size: 1.25em;
        font-weight: 900;
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        margin: 2px 0;
        line-height: 1.1;
    }
    
    .role-stat-label {
        color: #aaa;
        font-size: 0.68rem;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        line-height: 1.25;
    }
    
    .empty-stats {
        text-align: center;
        padding: 60px 40px;
        color: #aaa;
    }
    
    .empty-stats p {
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.3em;
        margin: 10px 0;
    }
    
    .empty-stats p:first-child {
        font-size: 1.6em;
        color: #fff;
        font-weight: 600;
    }
    
    .last-played {
        margin-top: 30px;
        padding: 20px;
        background: #1a1a1a;
        border: 2px solid #444;
        border-radius: 8px;
    }
    
    .last-played p {
        margin: 0;
        color: #aaa;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1em;
    }
    
    .last-played strong {
        color: #fff;
    }
    
    /* Game History Styles */
    .game-history-section {
        background: linear-gradient(135deg, #1e3a5f 0%, #0d1f3c 100%);
        border: 3px solid #2c5282;
        border-radius: 15px;
        padding: 30px;
        margin-top: 30px;
    }
    
    .game-history-section h2 {
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.6em;
        margin-bottom: 20px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
        border-bottom: 2px solid #4299e1;
        padding-bottom: 10px;
    }
    
    .game-history-list {
        max-height: 400px;
        overflow-y: auto;
    }
    
    .game-history-item {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-left: 4px solid #4299e1;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 12px;
        transition: all 0.2s;
    }
    
    .game-history-item:hover {
        transform: translateX(5px);
        background: rgba(255,255,255,0.08);
    }
    
    .game-history-item.won {
        border-left-color: #48bb78;
    }
    
    .game-history-item.lost {
        border-left-color: #fc8181;
    }
    
    .game-history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        gap: 10px;
        flex-wrap: wrap;
    }

    .game-history-topline {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    
    .game-history-result {
        font-weight: 700;
        font-size: 1.1em;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .game-history-result.won {
        color: #48bb78;
    }
    
    .game-history-result.lost {
        color: #fc8181;
    }
    
    .game-history-date {
        color: #a0aec0;
        font-size: 0.85em;
    }

    .game-mode-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.85em;
        font-weight: 700;
        color: #fff;
        background: rgba(255,255,255,0.1);
    }

    .game-mode-badge.insider {
        background: rgba(52, 152, 219, 0.2);
        color: #8fd3ff;
    }

    .game-mode-badge.werewolf {
        background: rgba(192, 57, 43, 0.2);
        color: #ffb4a8;
    }

    .game-mode-badge.blackmarket {
        background: rgba(246, 211, 101, 0.18);
        color: #fde68a;
    }

    .game-mode-badge.spyfall {
        background: rgba(26, 188, 156, 0.18);
        color: #7bedd6;
    }
    
    .game-history-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 8px;
        font-size: 0.9em;
        color: #e2e8f0;
    }
    
    .game-history-detail {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .game-history-detail-icon {
        font-size: 0.9em;
    }
    
    .game-history-empty {
        text-align: center;
        padding: 40px;
        color: #a0aec0;
    }
    
    .game-history-empty p {
        font-size: 1.1em;
        margin: 10px 0;
    }
    
    /* SweetAlert2 Dark Theme */
    .swal2-popup {
        background: #1e1e1e !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
    }
    
    .swal2-title {
        color: #fff !important;
        font-family: 'Orbitron', sans-serif !important;
        font-weight: 700 !important;
    }
    
    .swal2-content {
        color: #ddd !important;
    }
    
    .swal2-confirm {
        background: #e74c3c !important;
        border-color: #c0392b !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 600 !important;
    }
    
    .swal2-confirm:hover {
        background: #c0392b !important;
    }
    
    /* Avatar Selection */
    .avatar-selection {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        justify-items: center;
    }
    
    .avatar-btn {
        width: 100%;
        max-width: 52px;
        aspect-ratio: 1;
        border-radius: 50%;
        background: #1a1a1a;
        border: 2px solid #444;
        font-size: 1.35em;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }
    
    .avatar-btn:hover {
        transform: scale(1.15);
        border-color: #e74c3c;
    }
    
    .avatar-btn.active {
        border-color: #fff;
        box-shadow: 0 0 15px rgba(255,255,255,0.5);
        background: #333;
    }
    
    /* Frame Selection */
    .frame-selection {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        justify-items: center;
    }
    
    .frame-btn {
        width: 100%;
        max-width: 56px;
        aspect-ratio: 1;
        border-radius: 50%;
        background: #1a1a1a;
        border: 3px solid #444;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 0;
    }
    
    .frame-btn:hover {
        transform: scale(1.1);
    }
    
    .frame-btn.active {
        border-color: #fff;
        box-shadow: 0 0 20px rgba(255,255,255,0.5);
    }
    
    .frame-btn .frame-preview {
        width: 72%;
        height: 72%;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1em;
    }
    
    .frame-btn .frame-name {
        display: none;
    }
    
    .avatar-preview-box {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
        padding: 20px;
        background: #1a1a1a;
        border-radius: 12px;
        border: 2px solid #444;
    }
    
    .avatar-preview {
        position: relative;
        width: 90px;
        height: 90px;
    }
    
    .avatar-preview-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5em;
        border: 4px solid;
        background: rgba(255,255,255,0.05);
        position: relative;
        z-index: 2;
    }
    
    .avatar-preview-frame {
        position: absolute;
        top: -5px;
        left: -5px;
        right: -5px;
        bottom: -5px;
        border-radius: 50%;
        z-index: 1;
    }
    
    .avatar-preview-info h3 {
        margin: 0 0 5px 0;
        font-family: 'Orbitron', sans-serif;
    }
    
    .avatar-preview-info p {
        margin: 0;
        color: #888;
        font-size: 0.9em;
    }

    :root {
        --identity-bg: #09090b;
        --identity-surface: rgba(18, 18, 20, 0.86);
        --identity-card: rgba(26, 26, 46, 0.72);
        --identity-ink: #f5efe3;
        --identity-muted: #b8ada0;
        --identity-line: rgba(255, 255, 255, 0.1);
        --identity-accent: #e74c3c;
        --identity-accent-deep: #c0392b;
        --identity-highlight: #f5c86b;
        --identity-shadow: 0 32px 100px rgba(0, 0, 0, 0.52);
        --identity-panel: linear-gradient(145deg, rgba(12, 12, 14, 0.98), rgba(26, 17, 15, 0.94));
        --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
        --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    }

    body.content {
        background:
            radial-gradient(circle at 8% 10%, rgba(127, 29, 29, 0.42), transparent 18%),
            radial-gradient(circle at 92% 0%, rgba(180, 83, 9, 0.18), transparent 16%),
            linear-gradient(180deg, #09090b 0%, #110d0c 45%, #17110f 100%);
    }

    @keyframes profileRise {
        from {
            opacity: 0;
            transform: translate3d(0, 28px, 0) scale(0.985);
        }
        to {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
        }
    }

    @keyframes profileFloat {
        0%, 100% {
            transform: translate3d(0, 0, 0);
        }
        50% {
            transform: translate3d(0, -8px, 0);
        }
    }

    @keyframes profileAuraPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(245, 200, 107, 0.16);
        }
        50% {
            box-shadow: 0 0 0 12px rgba(245, 200, 107, 0);
        }
    }

    @keyframes profileGlowSweep {
        0% {
            transform: translate3d(-140%, 0, 0) rotate(8deg);
        }
        100% {
            transform: translate3d(140%, 0, 0) rotate(8deg);
        }
    }

    .profile-container {
        max-width: 1180px;
        margin: 24px auto 40px;
        padding: 0 18px 24px;
        color: var(--identity-ink);
        font-family: 'Bai Jamjuree', 'Rajdhani', sans-serif;
        opacity: 0;
        transform: translate3d(0, 18px, 0);
        transition: opacity 0.48s var(--ease-out-expo), transform 0.48s var(--ease-out-expo);
    }

    .profile-container.is-ready {
        opacity: 1;
        transform: translate3d(0, 0, 0);
    }

    .motion-enter {
        opacity: 0;
        transform: translate3d(0, 28px, 0);
    }

    .profile-container.is-ready .motion-enter {
        animation: profileRise 0.72s var(--ease-out-expo) forwards;
        animation-delay: calc(var(--enter-delay, 0) * 1ms);
    }

    .reveal-item {
        opacity: 0;
        transform: translate3d(0, 22px, 0);
        transition: opacity 0.48s var(--ease-out-expo), transform 0.48s var(--ease-out-expo);
        transition-delay: calc(var(--reveal-delay, 0) * 1ms);
    }

    .reveal-item.is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
    }

    .profile-container h1 {
        margin: 0 0 20px 0;
        color: var(--identity-ink);
        font-family: 'Chakra Petch', 'Orbitron', sans-serif;
        text-align: left;
        text-shadow: none;
        letter-spacing: -0.03em;
        font-size: clamp(2.4rem, 4vw, 4rem);
    }

    .profile-shell {
        display: grid;
        gap: 18px;
    }

    .identity-hero {
        display: grid;
        grid-template-columns: minmax(300px, 0.92fr) minmax(0, 1.08fr);
        gap: 18px;
    }

    .profile-section {
        background:
            radial-gradient(circle at top right, rgba(245, 200, 107, 0.1), transparent 28%),
            radial-gradient(circle at bottom left, rgba(231, 76, 60, 0.08), transparent 24%),
            var(--identity-panel);
        border: 1px solid rgba(245, 200, 107, 0.14);
        border-radius: 28px;
        padding: 26px;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), var(--identity-shadow);
        color: var(--identity-ink);
    }

    .profile-section h2,
    .stats-section-title,
    .game-history-section h2 {
        color: var(--identity-ink);
        font-family: 'Chakra Petch', 'Orbitron', sans-serif;
        text-shadow: none;
        border-bottom: 1px solid var(--identity-line);
        padding-bottom: 12px;
        margin-bottom: 18px;
    }

    .identity-summary {
        position: relative;
        overflow: hidden;
    }

    .identity-summary::after {
        content: '';
        position: absolute;
        inset: 14px;
        border: 1px dashed rgba(245, 200, 107, 0.14);
        border-radius: 22px;
        pointer-events: none;
    }

    .identity-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(231, 76, 60, 0.14);
        color: #ffb4a8;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .identity-summary-grid {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 18px;
        margin-top: 18px;
    }

    .identity-preview-card {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 18px;
        align-items: center;
        padding: 18px;
        border-radius: 24px;
        background: linear-gradient(145deg, #1a1a2e 0%, #16213e 100%);
        border: 1px solid rgba(245, 200, 107, 0.18);
        color: var(--identity-ink);
        box-shadow: 0 14px 32px rgba(0, 0, 0, 0.28);
        animation: profileFloat 6.2s ease-in-out infinite;
    }

    .avatar-preview-box {
        align-items: center;
        gap: 18px;
        margin-bottom: 0;
        padding: 0;
        background: transparent;
        border: 0;
    }

    .avatar-preview {
        width: 104px;
        height: 104px;
        filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.18));
    }

    .avatar-preview-inner {
        border-width: 5px;
        background: rgba(255,255,255,0.08);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
        transition: transform 0.22s var(--ease-out-quart), border-color 0.22s var(--ease-out-quart), box-shadow 0.22s var(--ease-out-quart);
    }

    .avatar-preview-frame {
        top: -7px;
        left: -7px;
        right: -7px;
        bottom: -7px;
        animation: profileAuraPulse 2.8s ease-out infinite;
    }

    .identity-name {
        margin: 0 0 8px;
        font-family: 'Chakra Petch', 'Orbitron', sans-serif;
        font-size: 1.9rem;
        line-height: 1;
    }

    .identity-note {
        margin: 0;
        color: var(--identity-muted);
        line-height: 1.6;
    }

    .identity-editor {
        display: grid;
        gap: 18px;
        align-content: start;
    }

    .identity-copy {
        margin: -4px 0 6px;
        color: var(--identity-muted);
        line-height: 1.7;
        max-width: 56ch;
    }

    .identity-form-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    #playerNameInput {
        flex: 1;
        min-width: 220px;
        padding: 14px 18px;
        border-radius: 16px;
        border: 2px solid #333;
        background: #0d0d1a;
        color: #fff;
    }

    #playerNameInput:focus {
        border-color: var(--identity-accent);
        box-shadow: 0 0 0 4px rgba(231, 76, 60, 0.18);
    }

    .btn-profile {
        min-height: 54px;
        padding: 0 24px;
        position: relative;
        overflow: hidden;
        border: 0;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--identity-accent), var(--identity-accent-deep));
        box-shadow: 0 18px 28px rgba(231, 76, 60, 0.22);
        font-family: 'Chakra Petch', 'Rajdhani', sans-serif;
        text-transform: none;
        transition: transform 0.14s var(--ease-out-quart), box-shadow 0.22s var(--ease-out-quart), filter 0.22s var(--ease-out-quart);
    }

    .btn-profile::after {
        content: '';
        position: absolute;
        inset: -30% auto -30% -18%;
        width: 34%;
        background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.34), rgba(255,255,255,0));
        transform: translate3d(-160%, 0, 0) rotate(10deg);
        pointer-events: none;
    }

    .btn-profile:hover {
        transform: translate3d(0, -2px, 0);
        filter: saturate(1.04);
        box-shadow: 0 24px 34px rgba(231, 76, 60, 0.3);
    }

    .btn-profile:hover::after {
        animation: profileGlowSweep 0.9s var(--ease-out-quart);
    }

    .btn-profile:active {
        transform: translate3d(0, 1px, 0) scale(0.985);
    }

    .identity-color-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .color-btn {
        width: 52px;
        height: 52px;
        border: 4px solid rgba(255,255,255,0.22);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.28);
        transition: transform 0.18s var(--ease-out-quart), box-shadow 0.18s var(--ease-out-quart), border-color 0.18s var(--ease-out-quart);
    }

    .color-btn:hover {
        transform: translate3d(0, -3px, 0) scale(1.06);
        box-shadow: 0 16px 26px rgba(0, 0, 0, 0.36);
    }

    .color-btn.active {
        border-color: var(--identity-highlight);
        box-shadow: 0 0 0 4px rgba(245, 200, 107, 0.2);
    }

    .identity-current-name {
        margin: 12px 0 0;
        color: var(--identity-muted);
    }

    .player-id {
        margin-top: 0;
        padding: 18px;
        background: rgba(0, 0, 0, 0.28);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
    }

    .player-id p,
    .last-played p {
        color: var(--identity-muted);
    }

    .player-id code {
        background: rgba(255, 255, 255, 0.06);
        color: var(--identity-highlight);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .avatar-studio-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .avatar-selection,
    .frame-selection {
        gap: 8px;
    }

    .avatar-btn,
    .frame-btn {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.12);
        box-shadow: 0 12px 22px rgba(0, 0, 0, 0.22);
        transition: transform 0.2s var(--ease-out-quart), box-shadow 0.2s var(--ease-out-quart), border-color 0.2s var(--ease-out-quart), background 0.2s var(--ease-out-quart);
    }

    .avatar-btn:hover,
    .frame-btn:hover {
        transform: translate3d(0, -3px, 0) scale(1.04);
        box-shadow: 0 18px 30px rgba(0, 0, 0, 0.32);
        background: rgba(255,255,255,0.09);
    }

    .avatar-btn.active,
    .frame-btn.active {
        border-color: var(--identity-accent);
        box-shadow: 0 0 0 4px rgba(231, 76, 60, 0.18);
        background: rgba(231, 76, 60, 0.12);
        transform: translate3d(0, -2px, 0);
    }

    .stats-section {
        display: grid;
        gap: 14px;
    }

    .stats-section > h2 {
        margin: 0 0 4px;
        font-size: 1.25em;
        padding-bottom: 8px;
    }

    .stats-grid .stat-card,
    .role-stat-card,
    .game-history-item,
    .last-played {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 18px 36px rgba(0, 0, 0, 0.24);
        color: var(--identity-ink);
    }

    .game-history-section {
        background: linear-gradient(145deg, rgba(30, 58, 95, 0.42) 0%, rgba(13, 31, 60, 0.62) 100%) !important;
        border: 1px solid rgba(66, 153, 225, 0.28) !important;
        box-shadow: 0 18px 36px rgba(0, 0, 0, 0.24);
        color: var(--identity-ink);
    }

    .game-history-section h2 {
        border-bottom-color: rgba(66, 153, 225, 0.35);
    }

    .stat-card::before {
        background: linear-gradient(90deg, var(--identity-accent), var(--identity-highlight));
    }

    .stat-card:hover,
    .role-stat-card:hover,
    .game-history-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 22px 40px rgba(0, 0, 0, 0.32);
        border-color: rgba(245, 200, 107, 0.22) !important;
    }

    .profile-container .form-group label {
        color: var(--identity-muted);
    }

    .role-stat-card {
        border-left-width: 1px !important;
    }

    .stat-label,
    .role-stat-label,
    .game-history-date,
    .game-history-empty,
    .empty-stats,
    .empty-stats p,
    .game-history-details {
        color: var(--identity-muted);
    }

    .game-history-section {
        margin-top: 0;
    }

    @media (max-width: 900px) {
        .identity-hero {
            grid-template-columns: 1fr;
        }

        .identity-preview-card {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
        }

        .profile-container h1 {
            text-align: center;
        }
    }

    @media (max-width: 640px) {
        .profile-container {
            padding: 0 12px 20px;
        }

        .profile-section {
            padding: 18px;
            border-radius: 22px;
        }

        .identity-form-row {
            flex-direction: column;
        }

        #playerNameInput,
        .btn-profile {
            width: 100%;
        }

        .stats-grid,
        .role-stats-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 8px;
        }

        .stat-card,
        .role-stat-card {
            padding: 8px 6px;
        }

        .stat-icon {
            font-size: 1.2em;
        }

        .stat-value {
            font-size: 1.1em;
        }

        .avatar-btn {
            max-width: 46px;
            font-size: 1.2em;
        }

        .frame-btn {
            max-width: 50px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }

        .profile-container,
        .motion-enter,
        .reveal-item {
            opacity: 1 !important;
            transform: none !important;
        }
    }
</style>

<div class="profile-container">
    <div class="profile-shell">
    <h1 class="motion-enter" style="--enter-delay: 40;">Identity Studio</h1>

    <div class="identity-hero">
        <div class="profile-section identity-summary motion-enter" style="--enter-delay: 120;">
            <span class="identity-kicker">Player Identity</span>
            <div class="identity-summary-grid">
                <div class="identity-preview-card">
                    <div class="avatar-preview-box">
                        <div class="avatar-preview">
                            <div class="avatar-preview-inner" id="avatarPreviewInner" style="border-color: <%= player.color %>;">
                                <%= player.avatar || '👤' %>
                            </div>
                            <div class="avatar-preview-frame" id="avatarPreviewFrame"></div>
                        </div>
                    </div>
                    <div class="avatar-preview-info">
                        <h3 class="identity-name" style="color: <%= player.color %>;"><%= player.playerName %></h3>
                        <p class="identity-note">ภาพลักษณ์นี้จะตามคุณไปทั้งใน lobby, leaderboard และตอนเพื่อนเปิดดูโปรไฟล์</p>
                    </div>
                </div>
                <div class="player-id">
                    <p style="margin-bottom: 5px;"><strong>🆔 Player ID</strong></p>
                    <p><code style="display: block; word-break: break-all; font-size: 0.95em;"><%= player.playerId %></code></p>
                </div>
            </div>
        </div>

        <div class="profile-section identity-editor motion-enter" style="--enter-delay: 220;">
            <div>
                <h2>ตั้งชื่อและโทนของคุณ</h2>
                <p class="identity-copy">หน้านี้ทำไว้ให้เปลี่ยนชื่อ สี และลุคได้เร็วขึ้นก่อนเข้าวงจริง เลือกให้เพื่อนมองแวบเดียวก็รู้ว่าเป็นคุณ</p>
            </div>

            <div class="form-group">
                <label>✏️ ชื่อผู้เล่น</label>
                <div class="identity-form-row">
                    <input type="text" id="playerNameInput" value="<%= player.playerName %>">
                    <button id="updateNameBtn" class="btn-profile">บันทึกชื่อ</button>
                </div>
            </div>

            <div class="form-group">
                <label>🎨 สีชื่อ</label>
                <div class="identity-color-row">
                    <% availableColors.forEach(function(color) { %>
                        <button class="color-btn <%= color === player.color ? 'active' : '' %>"
                                data-color="<%= color %>"
                                style="background: <%= color %>;">
                        </button>
                    <% }); %>
                </div>
                <p class="identity-current-name">สีปัจจุบัน: <strong style="color: <%= player.color %>; font-size: 1.1em;"><%= player.playerName %></strong></p>
            </div>
        </div>
    </div>

    <div class="profile-section motion-enter" style="--enter-delay: 320;">
        <h2>ปรับ Avatar และกรอบ</h2>
        <div class="avatar-studio-grid">
            <div class="form-group">
                <label>😀 เลือก Avatar</label>
                <div class="avatar-selection" id="avatarSelection">
                    <!-- Loaded by JS -->
                </div>
            </div>

            <div class="form-group" style="margin-top: 0;">
                <label>✨ เลือกกรอบ</label>
                <div class="frame-selection" id="frameSelection">
                    <!-- Loaded by JS -->
                </div>
            </div>
        </div>
    </div>

    <div class="stats-section">
        <h2>📊 สถิติการเล่น</h2>
        
        <%
            // ใช้ค่า default ถ้ายังไม่มีสถิติ - แสดงเป็น 0 ทุกอัน
            const displayStats = stats || {
                totalGames: 0,
                wins: 0,
                losses: 0,
                roleStats: {
                    gameMasterCount: 0,
                    traitorCount: 0,
                    citizenCount: 0,
                    werewolf: {
                        villager: 0,
                        werewolf: 0,
                        alphaWolf: 0,
                        mayor: 0,
                        bodyguard: 0,
                        seer: 0,
                        doctor: 0,
                        revealer: 0
                    }
                },
                winByRole: {
                    winAsTraitor: 0,
                    winAsCitizen: 0,
                    werewolf: {
                        villager: 0,
                        werewolf: 0,
                        alphaWolf: 0,
                        mayor: 0,
                        bodyguard: 0,
                        seer: 0,
                        doctor: 0,
                        revealer: 0
                    }
                },
                modeStats: {
                    insider: { games: 0, wins: 0, losses: 0 },
                    werewolf: { games: 0, wins: 0, losses: 0 },
                    blackmarket: { games: 0, wins: 0, losses: 0 },
                    spyfall: { games: 0, wins: 0, losses: 0 }
                },
                lastPlayedAt: null,
                gameHistory: []
            };
            // Ensure gameHistory exists for old stats
            if (!displayStats.gameHistory) {
                displayStats.gameHistory = [];
            }
            if (!displayStats.roleStats.werewolf) {
                displayStats.roleStats.werewolf = { villager: 0, werewolf: 0, alphaWolf: 0, mayor: 0, bodyguard: 0, seer: 0, doctor: 0, revealer: 0 };
            }
            if (!displayStats.winByRole.werewolf) {
                displayStats.winByRole.werewolf = { villager: 0, werewolf: 0, alphaWolf: 0, mayor: 0, bodyguard: 0, seer: 0, doctor: 0, revealer: 0 };
            }
            if (!displayStats.modeStats) {
                displayStats.modeStats = {
                    insider: { games: 0, wins: 0, losses: 0 },
                    werewolf: { games: 0, wins: 0, losses: 0 },
                    blackmarket: { games: 0, wins: 0, losses: 0 },
                    spyfall: { games: 0, wins: 0, losses: 0 }
                };
            }
            if (!displayStats.roleStats.blackmarket) {
                displayStats.roleStats.blackmarket = { boss: 0, broker: 0, smuggler: 0, fixer: 0, hitman: 0, mole: 0, doubleAgent: 0 };
            }
            if (!displayStats.winByRole.blackmarket) {
                displayStats.winByRole.blackmarket = { boss: 0, broker: 0, smuggler: 0, fixer: 0, hitman: 0, mole: 0, doubleAgent: 0 };
            }
            const winRate = displayStats.totalGames > 0 ? Math.round((displayStats.wins / displayStats.totalGames) * 100) : 0;
            const insiderStats = displayStats.modeStats.insider || { games: 0, wins: 0, losses: 0 };
            const werewolfStats = displayStats.modeStats.werewolf || { games: 0, wins: 0, losses: 0 };
            const blackMarketStats = displayStats.modeStats.blackmarket || { games: 0, wins: 0, losses: 0 };
            const spyfallStats = displayStats.modeStats.spyfall || { games: 0, wins: 0, losses: 0 };
            const insiderWinRate = insiderStats.games > 0 ? Math.round((insiderStats.wins / insiderStats.games) * 100) : 0;
            const werewolfWinRate = werewolfStats.games > 0 ? Math.round((werewolfStats.wins / werewolfStats.games) * 100) : 0;
            const blackMarketWinRate = blackMarketStats.games > 0 ? Math.round((blackMarketStats.wins / blackMarketStats.games) * 100) : 0;
            const spyfallWinRate = spyfallStats.games > 0 ? Math.round((spyfallStats.wins / spyfallStats.games) * 100) : 0;
            const blackMarketRoleCards = [
                { id: 'boss', icon: '🎩', label: 'เจ้าพ่อ', className: 'blackmarket-role' },
                { id: 'broker', icon: '🕴️', label: 'นายหน้า', className: 'blackmarket-role' },
                { id: 'smuggler', icon: '🚚', label: 'คนส่งของ', className: 'blackmarket-role' },
                { id: 'fixer', icon: '🧹', label: 'คนเคลียร์ทาง', className: 'blackmarket-role' },
                { id: 'hitman', icon: '🔫', label: 'มือเก็บงาน', className: 'blackmarket-role' },
                { id: 'mole', icon: '🕶️', label: 'สายข่าว', className: 'blackmarket-role' },
                { id: 'doubleAgent', icon: '🃏', label: 'สองหน้า', className: 'blackmarket-role' }
            ];
            const werewolfRoleCards = [
                { id: 'villager', icon: '🙂', label: 'ชาวบ้าน', className: 'village-role' },
                { id: 'werewolf', icon: '🐺', label: 'หมาป่า', className: 'werewolf-role' },
                { id: 'alphaWolf', icon: '👑', label: 'อัลฟ่าหมาป่า', className: 'werewolf-role' },
                { id: 'mayor', icon: '🎖️', label: 'นายก', className: 'village-role' },
                { id: 'bodyguard', icon: '🛡️', label: 'บอดี้การ์ด', className: 'support-role' },
                { id: 'seer', icon: '🔮', label: 'Seer', className: 'support-role' },
                { id: 'doctor', icon: '💉', label: 'หมอ', className: 'support-role' },
                { id: 'revealer', icon: '💥', label: 'จอมเปิดโปง', className: 'support-role' }
            ];
        %>
        
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-icon">🎮</span>
                <div class="stat-value" style="color: #3498db;"><%= displayStats.totalGames %></div>
                <div class="stat-label">เกมทั้งหมด</div>
            </div>
            
            <div class="stat-card">
                <span class="stat-icon">🏆</span>
                <div class="stat-value" style="color: #27ae60;"><%= displayStats.wins %></div>
                <div class="stat-label">ชนะ</div>
            </div>
            
            <div class="stat-card">
                <span class="stat-icon">💔</span>
                <div class="stat-value" style="color: #e74c3c;"><%= displayStats.losses %></div>
                <div class="stat-label">แพ้</div>
            </div>
            
            <div class="stat-card">
                <span class="stat-icon">📈</span>
                <div class="stat-value" style="color: #f39c12;">
                    <%= winRate %>%
                </div>
                <div class="stat-label">อัตราชนะ</div>
            </div>
        </div>

        <h3 class="stats-section-title">🧭 สรุปตามโหมด</h3>
        <div class="role-stats-grid">
            <div class="role-stat-card mode-insider">
                <div class="role-stat-icon">🎯</div>
                <div class="role-stat-value" style="color: #9b59b6;"><%= insiderStats.games %></div>
                <div class="role-stat-label">Insider · ชนะ <%= insiderStats.wins %> · แพ้ <%= insiderStats.losses %> · <%= insiderWinRate %>%</div>
            </div>
            <div class="role-stat-card mode-werewolf">
                <div class="role-stat-icon">🐺</div>
                <div class="role-stat-value" style="color: #ff8f7b;"><%= werewolfStats.games %></div>
                <div class="role-stat-label">Werewolf · ชนะ <%= werewolfStats.wins %> · แพ้ <%= werewolfStats.losses %> · <%= werewolfWinRate %>%</div>
            </div>
            <div class="role-stat-card mode-blackmarket">
                <div class="role-stat-icon">🎩</div>
                <div class="role-stat-value" style="color: #f6d365;"><%= blackMarketStats.games %></div>
                <div class="role-stat-label">Black Market · ชนะ <%= blackMarketStats.wins %> · แพ้ <%= blackMarketStats.losses %> · <%= blackMarketWinRate %>%</div>
            </div>
            <div class="role-stat-card mode-spyfall">
                <div class="role-stat-icon">🕵️</div>
                <div class="role-stat-value" style="color: #1abc9c;"><%= spyfallStats.games %></div>
                <div class="role-stat-label">Spyfall · ชนะ <%= spyfallStats.wins %> · แพ้ <%= spyfallStats.losses %> · <%= spyfallWinRate %>%</div>
            </div>
        </div>

        <h3 class="stats-section-title">🎭 Insider: สถิติตามบทบาท</h3>
        <div class="role-stats-grid">
            <div class="role-stat-card gamemaster">
                <div class="role-stat-icon">👑</div>
                <div class="role-stat-value" style="color: #f39c12;"><%= displayStats.roleStats.gameMasterCount %></div>
                <div class="role-stat-label">ผู้ดำเนินเกม</div>
            </div>
            
            <div class="role-stat-card traitor">
                <div class="role-stat-icon">😈</div>
                <div class="role-stat-value" style="color: #e74c3c;"><%= displayStats.roleStats.traitorCount %></div>
                <div class="role-stat-label">จอมบงการ</div>
            </div>
            
            <div class="role-stat-card citizen">
                <div class="role-stat-icon">👤</div>
                <div class="role-stat-value" style="color: #3498db;"><%= displayStats.roleStats.citizenCount %></div>
                <div class="role-stat-label">พลเมือง</div>
            </div>
        </div>

        <h3 class="stats-section-title">🐺 Werewolf: บทบาทที่เคยได้รับ</h3>
        <div class="role-stats-grid">
            <% werewolfRoleCards.forEach(function(role) { %>
                <div class="role-stat-card <%= role.className %>">
                    <div class="role-stat-icon"><%= role.icon %></div>
                    <div class="role-stat-value" style="color: #fff;"><%= displayStats.roleStats.werewolf[role.id] || 0 %></div>
                    <div class="role-stat-label"><%= role.label %></div>
                </div>
            <% }); %>
        </div>

        <h3 class="stats-section-title">🎯 Insider: ชนะตามบทบาท</h3>
        <div class="role-stats-grid">
            <div class="role-stat-card traitor">
                <div class="role-stat-icon">😈</div>
                <div class="role-stat-value" style="color: #e74c3c;"><%= displayStats.winByRole.winAsTraitor %></div>
                <div class="role-stat-label">ชนะเป็นจอมบงการ</div>
            </div>
            
            <div class="role-stat-card citizen">
                <div class="role-stat-icon">👤</div>
                <div class="role-stat-value" style="color: #3498db;"><%= displayStats.winByRole.winAsCitizen %></div>
                <div class="role-stat-label">ชนะเป็นพลเมือง</div>
            </div>
        </div>

        <h3 class="stats-section-title">🏁 Werewolf: ชนะตามบทบาท</h3>
        <div class="role-stats-grid">
            <% werewolfRoleCards.forEach(function(role) { %>
                <div class="role-stat-card <%= role.className %>">
                    <div class="role-stat-icon"><%= role.icon %></div>
                    <div class="role-stat-value" style="color: #fff;"><%= displayStats.winByRole.werewolf[role.id] || 0 %></div>
                    <div class="role-stat-label">ชนะเป็น <%= role.label %></div>
                </div>
            <% }); %>
        </div>


        <h3 class="stats-section-title">🎩 Black Market: บทบาทที่เคยได้รับ</h3>
        <div class="role-stats-grid">
            <% blackMarketRoleCards.forEach(function(role) { %>
                <% if ((displayStats.roleStats.blackmarket[role.id] || 0) > 0) { %>
                <div class="role-stat-card <%= role.className %>">
                    <div class="role-stat-icon"><%= role.icon %></div>
                    <div class="role-stat-value" style="color: #fff;"><%= displayStats.roleStats.blackmarket[role.id] || 0 %></div>
                    <div class="role-stat-label"><%= role.label %></div>
                </div>
                <% } %>
            <% }); %>
        </div>

        <h3 class="stats-section-title">🎩 Black Market: ชนะตามบทบาท</h3>
        <div class="role-stats-grid">
            <% blackMarketRoleCards.forEach(function(role) { %>
                <% if ((displayStats.winByRole.blackmarket[role.id] || 0) > 0) { %>
                <div class="role-stat-card <%= role.className %>">
                    <div class="role-stat-icon"><%= role.icon %></div>
                    <div class="role-stat-value" style="color: #fff;"><%= displayStats.winByRole.blackmarket[role.id] || 0 %></div>
                    <div class="role-stat-label">ชนะเป็น <%= role.label %></div>
                </div>
                <% } %>
            <% }); %>
        </div>

        <h3 class="stats-section-title">🕵️ Spyfall: สรุปบทบาท</h3>
        <div class="role-stats-grid">
            <div class="role-stat-card traitor">
                <div class="role-stat-icon">🕶️</div>
                <div class="role-stat-value" style="color: #1abc9c;"><%= spyfallStats.games > 0 ? spyfallStats.games : 0 %></div>
                <div class="role-stat-label">เกม Spyfall ทั้งหมด (ดูบทบาทแต่ละเกมในประวัติ)</div>
            </div>
        </div>

        <div class="last-played">
            <p>
                <strong>🕐 เล่นครั้งล่าสุด:</strong> 
                <% if (displayStats.lastPlayedAt) { %>
                    <%= new Date(displayStats.lastPlayedAt).toLocaleString('th-TH') %>
                <% } else { %>
                    <span style="color: #888;">ยังไม่เคยเล่น</span>
                <% } %>
            </p>
        </div>
        
        <!-- Game History Section -->
        <div class="game-history-section">
            <h2>📜 ประวัติเกมล่าสุด</h2>
            <div class="game-history-list">
                <% if (displayStats.gameHistory && displayStats.gameHistory.length > 0) { %>
                    <% displayStats.gameHistory.forEach(function(game) { %>
                        <% const gameMode = game.mode || 'insider'; %>
                        <% const modeLabels = { insider: '🎯 Insider', werewolf: '🐺 Werewolf', blackmarket: '🎩 Black Market', spyfall: '🕵️ Spyfall' }; %>
                        <% const modeBadgeClass = ['insider', 'werewolf', 'blackmarket', 'spyfall'].includes(gameMode) ? gameMode : 'insider'; %>
                        <div class="game-history-item <%= game.won ? 'won' : 'lost' %>">
                            <div class="game-history-header">
                                <div class="game-history-topline">
                                    <span class="game-history-result <%= game.won ? 'won' : 'lost' %>">
                                        <%= game.won ? '🏆 ชนะ' : '💔 แพ้' %>
                                    </span>
                                    <span class="game-mode-badge <%= modeBadgeClass %>"><%= modeLabels[modeBadgeClass] || modeLabels.insider %></span>
                                </div>
                                <span class="game-history-date">
                                    <%= new Date(game.date).toLocaleString('th-TH', { 
                                        year: 'numeric', 
                                        month: 'short', 
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </span>
                            </div>
                            <div class="game-history-details">
                                <div class="game-history-detail">
                                    <span class="game-history-detail-icon">🎭</span>
                                    <span><%= game.role %></span>
                                </div>
                                <div class="game-history-detail">
                                    <span class="game-history-detail-icon">🏠</span>
                                    <span><%= game.roomName || 'ไม่ทราบห้อง' %></span>
                                </div>
                                <% if (gameMode === 'werewolf') { %>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon"><%= game.team === 'werewolf' ? '🐾' : '🏡' %></span>
                                        <span>ทีม: <%= game.team === 'werewolf' ? 'หมาป่า' : 'ชาวบ้าน' %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">🏁</span>
                                        <span>ทีมชนะ: <%= game.winnerLabel || (game.winner === 'werewolf' ? 'หมาป่า' : 'ชาวบ้าน') %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">🌅</span>
                                        <span>ถึงวันที่ <%= game.dayNumber || 0 %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon"><%= game.survived ? '✨' : '💀' %></span>
                                        <span><%= game.survived ? 'อยู่รอดจนจบ' : 'ไม่รอดจนจบ' %></span>
                                    </div>
                                <% } else if (gameMode === 'blackmarket') { %>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">👑</span>
                                        <span>เจ้าโต๊ะ: <%= game.winnerLabel || 'ไม่ทราบ' %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">🎩</span>
                                        <span><%= game.winnerRole || '-' %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">📊</span>
                                        <span>👑 <%= game.influence || 0 %> · 💵 <%= game.cash || 0 %> · 🔥 <%= game.heat || 0 %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">🎯</span>
                                        <span><%= game.resultText || (game.won ? 'คุมเมืองสำเร็จ' : 'พลาดโต๊ะนี้') %></span>
                                    </div>
                                <% } else if (gameMode === 'spyfall') { %>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">📍</span>
                                        <span>สถานที่: <%= game.location || 'ไม่ทราบ' %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">🕶️</span>
                                        <span>สายลับ: <%= game.spyName || 'ไม่ทราบ' %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">🏁</span>
                                        <span><%= game.citizensWon ? 'พลเมืองชนะ' : 'สายลับรอด' %></span>
                                    </div>
                                <% } else { %>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">📝</span>
                                        <span><%= game.word %></span>
                                    </div>
                                    <div class="game-history-detail">
                                        <span class="game-history-detail-icon">🔴</span>
                                        <span>จอมบงการ: <%= game.traitor %></span>
                                    </div>
                                <% } %>
                                <div class="game-history-detail">
                                    <span class="game-history-detail-icon">👥</span>
                                    <span><%= game.playerCount %> คน</span>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="game-history-empty">
                        <p>📭 ยังไม่มีประวัติเกม</p>
                        <p style="font-size: 0.9em;">เริ่มเล่นเพื่อบันทึกประวัติ!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
</div>

<%- contentFor('footer') %>
<div class="container">
    <a href="/?playerId=<%= player.playerId %>" class="btn btn-dark" style="font-family: 'Rajdhani', sans-serif; font-weight: 600;">← กลับไป Lobby</a>
</div>

<%- contentFor('script') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
$(function() {
    const playerId = '<%= player.playerId %>';
    
    // Update name
    $('#updateNameBtn').on('click', function() {
        const newName = $('#playerNameInput').val().trim();
        if (!newName) {
            Swal.fire({
                icon: 'warning',
                title: '⚠️ กรุณากรอกชื่อ',
                text: 'ชื่อไม่สามารถว่างได้',
                background: '#1e1e1e',
                color: '#fff',
                confirmButtonColor: '#f39c12'
            });
            return;
        }

        $.ajax({
            url: '/profile/updateName?playerId=' + playerId,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ name: newName }),
            success: function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '✅ บันทึกสำเร็จ',
                        text: 'ชื่อถูกอัปเดตแล้ว',
                        timer: 2000,
                        showConfirmButton: false,
                        background: '#1e1e1e',
                        color: '#fff'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: '❌ บันทึกไม่สำเร็จ',
                        text: response.error || 'เกิดข้อผิดพลาด',
                        background: '#1e1e1e',
                        color: '#fff',
                        confirmButtonColor: '#e74c3c'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    icon: 'error',
                    title: '❌ เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถอัปเดตชื่อได้',
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c'
                });
            }
        });
    });

    // Update color
    $('.color-btn').on('click', function() {
        const color = $(this).data('color');
        
        $.ajax({
            url: '/profile/updateColor?playerId=' + playerId,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ color: color }),
            success: function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '✅ เปลี่ยนสีสำเร็จ',
                        timer: 1500,
                        showConfirmButton: false,
                        background: '#1e1e1e',
                        color: '#fff'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: '❌ เปลี่ยนสีไม่สำเร็จ',
                        text: response.error || 'เกิดข้อผิดพลาด',
                        background: '#1e1e1e',
                        color: '#fff',
                        confirmButtonColor: '#e74c3c'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    icon: 'error',
                    title: '❌ เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเปลี่ยนสีได้',
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c'
                });
            }
        });
    });
    
    // Current values
    let currentAvatar = '<%= player.avatar || "👤" %>';
    let currentFrame = '<%= player.avatarFrame || "none" %>';
    const playerColor = '<%= player.color %>';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    // Frame styles
    const frameStyles = {
        'none': 'none',
        'bronze': 'linear-gradient(135deg, #cd7f32 0%, #8b4513 100%)',
        'silver': 'linear-gradient(135deg, #c0c0c0 0%, #808080 100%)',
        'gold': 'linear-gradient(135deg, #ffd700 0%, #ff8c00 100%)',
        'diamond': 'linear-gradient(135deg, #b9f2ff 0%, #00bfff 100%)',
        'fire': 'linear-gradient(135deg, #ff4500 0%, #ff0000 100%)',
        'rainbow': 'linear-gradient(135deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #8b00ff)',
        'neon': 'linear-gradient(135deg, #00ff00 0%, #00ffff 50%, #ff00ff 100%)'
    };
    
    // Load avatars and frames
    console.log('Loading avatars...');
    $.ajax({
        url: '/api/avatars',
        method: 'GET',
        dataType: 'json',
        success: function(data) {
            console.log('Avatars API response:', data);
            
            // ตรวจสอบว่า data มีโครงสร้างถูกต้อง
            var avatars = (data && Array.isArray(data.avatars)) ? data.avatars : [];
            var frames = (data && Array.isArray(data.frames)) ? data.frames : [];
            
            // Render avatars
            var $avatarContainer = $('#avatarSelection');
            $avatarContainer.empty();
            if (avatars.length > 0) {
                for (var i = 0; i < avatars.length; i++) {
                    var avatar = avatars[i];
                    var isActive = avatar === currentAvatar ? 'active' : '';
                    $avatarContainer.append('<button class="avatar-btn ' + isActive + '" data-avatar="' + avatar + '">' + avatar + '</button>');
                }
            } else {
                $avatarContainer.html('<p style="color:#aaa;">ไม่พบ Avatar</p>');
            }
            
            // Render frames
            var $frameContainer = $('#frameSelection');
            $frameContainer.empty();
            if (frames.length > 0) {
                for (var j = 0; j < frames.length; j++) {
                    var frame = frames[j];
                    var frameActive = frame.id === currentFrame ? 'active' : '';
                    var bgStyle = frame.style !== 'none' ? 'background: ' + frame.style + ';' : 'background: #333;';
                    $frameContainer.append('<button type="button" class="frame-btn ' + frameActive + '" data-frame="' + frame.id + '" title="' + frame.name + '"><div class="frame-preview" style="' + bgStyle + '">👤</div></button>');
                }
            } else {
                $frameContainer.html('<p style="color:#aaa;">ไม่พบกรอบ Avatar</p>');
            }
            
            // Update preview frame
            updateFramePreview();
        },
        error: function(xhr, status, error) {
            console.error('Failed to load avatars:', error);
            $('#avatarSelection').html('<p style="color:#f00;">โหลดไม่สำเร็จ: ' + error + '</p>');
            $('#frameSelection').html('<p style="color:#f00;">โหลดไม่สำเร็จ</p>');
        }
    });
    
    // Update preview
    function updateFramePreview() {
        const frameStyle = frameStyles[currentFrame];
        if (frameStyle && frameStyle !== 'none') {
            $('#avatarPreviewFrame').css('background', frameStyle).show();
        } else {
            $('#avatarPreviewFrame').hide();
        }
        const $avatarPreviewInner = $('#avatarPreviewInner');
        $avatarPreviewInner.text(currentAvatar);
        if (!reducedMotion) {
            $avatarPreviewInner.stop(true, true).css('transform', 'scale(0.88)').animate({ opacity: 0.72 }, 90, function() {
                $avatarPreviewInner.css('transform', 'scale(1)');
                $avatarPreviewInner.animate({ opacity: 1 }, 140);
            });
        }
    }

    function activateProfileMotion() {
        $('.profile-container').addClass('is-ready');

        if (reducedMotion) {
            $('.stats-grid .stat-card, .role-stats-grid .role-stat-card, .game-history-item, .last-played, .game-history-section').addClass('is-visible');
            return;
        }

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.12,
            rootMargin: '0px 0px -24px 0px'
        });

        $('.stats-grid .stat-card, .role-stats-grid .role-stat-card, .game-history-item, .last-played, .game-history-section').each(function(index) {
            this.classList.add('reveal-item');
            this.style.setProperty('--reveal-delay', String(Math.min(index * 36, 220)));
            observer.observe(this);
        });
    }
    
    // Avatar click
    $(document).on('click', '.avatar-btn', function() {
        const avatar = $(this).data('avatar');
        
        $.ajax({
            url: '/profile/updateAvatar?playerId=' + playerId,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ avatar: avatar }),
            success: function(response) {
                if (response.success) {
                    currentAvatar = avatar;
                    $('.avatar-btn').removeClass('active');
                    $(`.avatar-btn[data-avatar="${avatar}"]`).addClass('active');
                    updateFramePreview();
                    
                    Swal.fire({
                        icon: 'success',
                        title: '✅ เปลี่ยน Avatar สำเร็จ',
                        timer: 1200,
                        showConfirmButton: false,
                        background: '#1e1e1e',
                        color: '#fff'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: '❌ เปลี่ยน Avatar ไม่สำเร็จ',
                        text: response.error || 'เกิดข้อผิดพลาด',
                        background: '#1e1e1e',
                        color: '#fff',
                        confirmButtonColor: '#e74c3c'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    icon: 'error',
                    title: '❌ เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเปลี่ยน Avatar ได้',
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c'
                });
            }
        });
    });
    
    // Frame click
    $(document).on('click', '.frame-btn', function() {
        const frameId = $(this).data('frame');
        
        $.ajax({
            url: '/profile/updateAvatarFrame?playerId=' + playerId,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ frameId: frameId }),
            success: function(response) {
                if (response.success) {
                    currentFrame = frameId;
                    $('.frame-btn').removeClass('active');
                    $(`.frame-btn[data-frame="${frameId}"]`).addClass('active');
                    updateFramePreview();
                    
                    Swal.fire({
                        icon: 'success',
                        title: '✅ เปลี่ยนกรอบสำเร็จ',
                        timer: 1200,
                        showConfirmButton: false,
                        background: '#1e1e1e',
                        color: '#fff'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: '❌ เปลี่ยนกรอบไม่สำเร็จ',
                        text: response.error || 'เกิดข้อผิดพลาด',
                        background: '#1e1e1e',
                        color: '#fff',
                        confirmButtonColor: '#e74c3c'
                    });
                }
            },
            error: function() {
                Swal.fire({
                    icon: 'error',
                    title: '❌ เกิดข้อผิดพลาด',
                    text: 'ไม่สามารถเปลี่ยนกรอบได้',
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c'
                });
            }
        });
    });

    if (!reducedMotion) {
        window.requestAnimationFrame(function() {
            window.requestAnimationFrame(activateProfileMotion);
        });
    } else {
        activateProfileMotion();
    }
});
</script>

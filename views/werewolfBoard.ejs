    function buildTargetCards(action, handlerName, buttonClass, handlerArg) {
      if (!action.targets || action.targets.length === 0) {
        if (!action.allowSkip) {
          return '<div class="target-card subtle">ไม่มีเป้าหมายให้เลือก</div>';
        }
        return '';
      }

      const actionType = handlerArg || action.type || 'day-vote';
      const theme = getActionTheme(actionType);
      const voteTallies = action.voteTallies || {};
      const voteSummary = action.dayVoteSummary || null;
      const voteSummaryMap = new Map(((voteSummary && voteSummary.targets) || []).map(function(target) {
        return [target.playerId, target];
      }));

      const cards = action.targets.map(function(target) {
        const roomPlayer = getPlayerById(target.playerId) || {};
        const isSelected = action.selectedTargetId && action.selectedTargetId === target.playerId;
        const isDisabled = Boolean(action.locked && !isSelected);
        const targetSummary = voteSummaryMap.get(target.playerId) || null;
        const voteCount = Number(targetSummary?.count || voteTallies[target.playerId] || roomPlayer.voteCount || 0);
        const voterEntries = Array.isArray(targetSummary?.voters) ? targetSummary.voters : [];
        const selectionIcon = getActionSelectionIcon(actionType, isSelected);
        const selectionLabel = getActionSelectionLabel(actionType, isSelected, action.locked);
        const badges = [];

        if (roomPlayer.isSelf) {
          badges.push('<span class="target-card-badge badge-self">🫵 คุณ</span>');
        }
        if (roomPlayer.voteWeight > 1) {
          badges.push(`<span class="target-card-badge badge-weight">🎖️ เสียง ${roomPlayer.voteWeight}</span>`);
        }
        if (roomPlayer.revealedRole) {
          badges.push(`<span class="target-card-badge badge-revealed">🎭 ${escapeHtml(roomPlayer.revealedRole)}</span>`);
        }
        if (roomPlayer.alive === false) {
          badges.push('<span class="target-card-badge badge-dead">💀 ออกแล้ว</span>');
        }

        const statusClass = isSelected ? 'status-selected' : (action.locked ? 'status-locked' : 'status-ready');
        const statusIcon = isSelected ? selectionIcon : (action.locked ? '🔒' : actionEmoji(actionType));
        const votersHtml = voterEntries.length
          ? voterEntries.map(function(voter) {
              const weightedClass = voter.weight > 1 ? 'weighted' : '';
              const suffix = voter.weight > 1 ? ` x${voter.weight}` : '';
              return `<span class="target-card-voter-pill ${weightedClass}">${escapeHtml(voter.name)}${escapeHtml(suffix)}</span>`;
            }).join('')
          : '<span class="target-card-voter-pill empty">ยังไม่มีคนลงให้</span>';
        return `
          <div class="target-card target-theme-${theme} ${isSelected ? 'target-selected' : ''} ${isDisabled ? 'target-disabled' : ''} ${isDisabled ? '' : 'target-card-actionable'}" data-action-type="${escapeHtml(actionType)}" data-target-player-id="${escapeHtml(target.playerId)}" ${isDisabled ? '' : `onclick="${handlerName}(${handlerName === 'selectNightTarget' ? `'${actionType}', '${target.playerId}'` : `'${target.playerId}'`})"`}>
            <div class="target-card-particle-layer" aria-hidden="true"></div>
            <div class="target-card-head">
              <div class="target-card-title">
                <div class="target-card-avatar" style="background:${escapeHtml(roomPlayer.color || 'rgba(255,255,255,0.08)')};">${escapeHtml(roomPlayer.avatar || '👤')}</div>
                <div class="target-card-text">
                  <div class="target-card-name"><strong>${escapeHtml(target.name)}</strong></div>
                  <div class="target-card-meta">
                    <span class="target-card-tag">${roomPlayer.alive === false ? '💀 ออกจากเกมแล้ว' : '✨ ยังอยู่ในเกม'}</span>
                    ${voteCount > 0 ? `<span class="target-card-votes">🗳️ ${voteCount} โหวต</span>` : ''}
                  </div>
                </div>
              </div>
              <div class="target-card-status ${statusClass}">${statusIcon} ${escapeHtml(isSelected ? 'เลือกแล้ว' : (action.locked ? 'ล็อกแล้ว' : 'พร้อมเลือก'))}</div>
            </div>
            <div class="target-card-body">
              ${badges.length ? `<div class="target-card-meta">${badges.join('')}</div>` : ''}
              ${actionType === 'day-vote' ? `<div class="target-card-voters">${votersHtml}</div>` : ''}
              <div class="target-card-foot">
                <div class="target-card-tap">${selectionIcon} ${escapeHtml(selectionLabel)}</div>
                ${action.locked && !isSelected ? '<span class="target-card-tag">รอรอบถัดไป</span>' : ''}
              </div>
            </div>
          </div>
        `;
      });

      if (action.allowSkip) {
        const isSkipSelected = action.selectedTargetId === '__skip__';
        const isSkipDisabled = Boolean(action.locked && !isSkipSelected);
        const skipCount = Number(action.skipVoteWeight || 0);
        const skipVoters = (voteSummary && Array.isArray(voteSummary.skipVoters)) ? voteSummary.skipVoters : [];
        const skipVotersHtml = skipVoters.length
          ? skipVoters.map(function(voter) {
              const suffix = voter.weight > 1 ? ` x${voter.weight}` : '';
              return `<span class="target-card-voter-pill ${voter.weight > 1 ? 'weighted' : ''}">${escapeHtml(voter.name)}${escapeHtml(suffix)}</span>`;
            }).join('')
          : '<span class="target-card-voter-pill empty">ยังไม่มีคนข้าม</span>';
        cards.push(`
          <div class="target-card target-theme-skip ${isSkipSelected ? 'target-selected' : ''} ${isSkipDisabled ? 'target-disabled' : ''} ${isSkipDisabled ? '' : 'target-card-actionable'}" data-action-type="action-skip" data-target-player-id="__skip__" ${isSkipDisabled ? '' : `onclick="${handlerName}(${handlerName === 'selectNightTarget' ? `'${actionType}', '__skip__'` : `'__skip__'`})"`}>
            <div class="target-card-particle-layer" aria-hidden="true"></div>
            <div class="target-card-head">
              <div class="target-card-title">
                <div class="target-card-avatar" style="background:linear-gradient(145deg, rgba(148,163,184,0.35), rgba(71,85,105,0.6));">🫥</div>
                <div class="target-card-text">
                  <div class="target-card-name"><strong>ข้ามรอบนี้</strong></div>
                  <div class="target-card-meta">
                    <span class="target-card-tag">ไม่ลงเป้าที่ผู้เล่นคนไหน</span>
                    ${skipCount > 0 ? `<span class="target-card-votes">⏭️ ${skipCount} เสียง</span>` : ''}
                  </div>
                </div>
              </div>
              <div class="target-card-status ${isSkipSelected ? 'status-selected' : (action.locked ? 'status-locked' : 'status-ready')}">${isSkipSelected ? '😌' : (action.locked ? '🔒' : '⏭️')} ${isSkipSelected ? 'เลือกข้ามแล้ว' : (action.locked ? 'ล็อกแล้ว' : 'พร้อมข้าม')}</div>
            </div>
            <div class="target-card-body">
              ${actionType === 'day-vote' ? `<div class="target-card-voters">${skipVotersHtml}</div>` : ''}
              <div class="target-card-hint">เหมาะตอนยังข้อมูลไม่พอ หรืออยากดันเกมไปเฟสถัดไปโดยไม่เทคะแนนให้ใคร</div>
            </div>
          </div>
        `);
      }

      return cards.join('');
    }

    window.selectNightTarget = function(actionType, targetPlayerId) {
      submitNightAction(actionType, targetPlayerId);
    };

    window.selectVoteTarget = function(targetPlayerId) {
      submitDayVote(targetPlayerId);
    };

    window.skipDiscussionPhase = function() {
      submitDiscussionSkip();
    };

    window.revealMayorRole = function() {
      submitMayorReveal();
    };

    window.selectRevealTarget = function(targetPlayerId) {
      Swal.fire({
        icon: 'warning',
        title: 'ยืนยันใช้สกิลเปิดโปง',
        text: 'ถ้าเปิดโปงผิด ตัวคุณจะตายทันที',
        showCancelButton: true,
        confirmButtonText: 'ใช้สกิล',
        cancelButtonText: 'ยกเลิก',
        background: '#1e1e1e',
        color: '#fff'
      }).then(function(result) {
        if (result.isConfirmed) {
          submitRevealAction(targetPlayerId);
        }
      });
    };

    function renderActionPanels(actionState, phase, winner) {
      const $root = $('#actionPanels');
      $root.empty();

      if (winner) {
        if (isRoomAdmin) {
          $root.append('<div class="history-row">เกมจบแล้ว กดเริ่มรอบใหม่เพื่อกลับไปจัดทีมใหม่ในห้องได้</div>');
        } else {
          $root.append('<div class="history-row">เกมจบแล้ว รอหัวหน้าห้องกดเริ่มรอบใหม่ หรือออกกลับไปที่ห้อง</div>');
        }
        syncMobileGamePanel();
        return;
      }

      if (phase === 'night') {
        const actions = actionState?.nightActions || [];
        if (actions.length === 0) {
          $root.append('<div class="history-row">😴 คืนนี้คุณไม่มีสกิล ให้คุยวางแผนหรือรอระบบสรุปช่วงนี้ได้เลย</div>');
        } else {
          actions.forEach(function(action) {
            const targetCards = buildTargetCards(action, 'selectNightTarget', '', action.type);
            const extraState = targetCards ? `<div class="target-grid">${targetCards}</div>` : `<div class="subtle" style="margin-top:10px;">${escapeHtml(action.emptyStateText || 'รอให้คืนดำเนินต่อ')}</div>`;
            $root.append(`
              <div class="history-row" style="display:block;">
                <div class="action-title"><span>${actionEmoji(action.type)}</span><strong>${escapeHtml(action.label)}</strong></div>
                <div class="subtle">${escapeHtml(action.description)}</div>
                ${extraState}
              </div>
            `);
          });
        }
        syncMobileGamePanel();
        return;
      }

      if (phase === 'day-discussion') {
        const discussion = actionState?.discussionActions || {};
        const skipCount = Number(discussion.skipCount || 0);
        const totalAlive = Number(discussion.totalAlive || 0);
        const mayorHtml = discussion.canRevealMayor
          ? '<button class="action-btn" onclick="revealMayorRole()">🎖️ เปิดเผยตัวว่าเป็นนายกเพื่อให้เสียงโหวตเป็น 2</button>'
          : (discussion.mayorRevealed
            ? `<div class="highlight" style="margin-top:12px;">🎖️ คุณเปิดเผยตัวแล้ว เสียงโหวตของคุณตอนนี้เป็น ${discussion.currentVoteWeight || 2}</div>`
            : '');
        const statusText = totalAlive > 0
          ? `ตอนนี้มี ${skipCount}/${totalAlive} คนกดพร้อมข้ามช่วงคุยแล้ว ถ้าครบทุกคนจะเปิดโหวตทันที`
          : 'กำลังรอระบบอัปเดตจำนวนผู้เล่นที่ยังอยู่ในเกม';
        const buttonHtml = discussion.canSkip
          ? '<button class="action-btn" onclick="skipDiscussionPhase()">⏭️ พร้อมแล้ว ข้ามไปโหวต</button>'
          : (discussion.hasSkipped
            ? '<button class="action-btn selected" disabled>✅ คุณกดพร้อมแล้ว</button>'
            : '<button class="action-btn" disabled>⏳ รอช่วงพูดคุย</button>');

        $root.append(`
          <div class="history-row" style="display:block;">
            <div class="action-title"><span>💬</span><strong>ช่วงคุยก่อนโหวต</strong></div>
            <div class="subtle">คุยหาหลักฐาน จับพิรุธ และค่อยตัดสินใจว่าจะเปิดโหวตทันทีหรือปล่อยให้เวลาคุยหมดเอง</div>
            <div class="highlight" style="margin-top:8px;">${escapeHtml(statusText)}</div>
            <div style="margin-top:12px;">${buttonHtml}</div>
            ${mayorHtml ? `<div style="margin-top:12px;">${mayorHtml}</div>` : ''}
          </div>
        `);
        syncMobileGamePanel();
        return;
      }

      if (phase === 'day-vote') {
        const dayActions = actionState?.dayActions || {};
        const voteBoardHtml = buildVoteProgressBoardHtml(dayActions.dayVoteSummary);
        const skipVoteText = Number(dayActions.skipVoteWeight || 0) > 0
          ? ` | ข้ามโหวต ${dayActions.skipVoteWeight}/${dayActions.totalVoteWeight || 0} เสียง`
          : '';
        const mayorVoteHtml = dayActions.canRevealMayor
          ? '<div style="margin-top:12px;"><button class="action-btn" onclick="revealMayorRole()">🎖️ เปิดเผยตัวว่าเป็นนายกเพื่อให้เสียงโหวตเป็น 2</button></div>'
          : (dayActions.mayorRevealed
            ? `<div class="highlight" style="margin-top:10px;">🎖️ คุณเปิดเผยตัวแล้ว เสียงโหวตของคุณตอนนี้เป็น ${dayActions.currentVoteWeight || 2}</div>`
            : '');
        $root.append(`<div class="history-row" style="display:block;">☀️ กลางวันนี้คุยและลงคะแนนแบบเปิด ผลโหวตสดจะขึ้นบนการ์ดแต่ละคนทันที ถ้าเสียงข้ามโหวตเกินครึ่งจะตัดเข้ากลางคืนทันที${skipVoteText}${mayorVoteHtml}</div>`);
        if (dayActions.canVote) {
          $root.append(`
            <div class="history-row" style="display:block;">
              <div class="action-title"><span>🗳️</span><strong>สิทธิ์โหวตกลางวันของทุกคน</strong></div>
              <div class="subtle">เลือก 1 คนเพื่อขับออกจากหมู่บ้าน ตอนนี้มีคนลงคะแนนแล้ว ${dayActions.completedVotes || 0}/${dayActions.totalVoters || 0} คน ถ้าทุกคนลงครบระบบจะสรุปทันที</div>
              ${voteBoardHtml}
              <div class="target-grid">${buildTargetCards({ targets: dayActions.voteTargets, selectedTargetId: dayActions.selectedVoteTargetId, allowSkip: dayActions.allowSkipVote, voteTallies: dayActions.voteTallies, dayVoteSummary: dayActions.dayVoteSummary, skipVoteWeight: dayActions.skipVoteWeight }, 'selectVoteTarget', '', 'day-vote')}</div>
            </div>
          `);
        } else {
          $root.append('<div class="history-row">✅ คุณลงคะแนนแล้ว แต่ยังเปลี่ยนใจได้จนกว่าจะหมดเวลา</div>');
        }

        if (dayActions.canReveal) {
          $root.append(`
            <div class="history-row" style="display:block;">
              <div class="action-title"><span>💥</span><strong>สกิลจอมเปิดโปง</strong></div>
              <div class="subtle">ถ้าเลือกหมาป่าถูก หมาป่าจะตายทันที ถ้าพลาดคุณตายเอง</div>
              <div class="target-grid">${buildTargetCards({ targets: dayActions.revealTargets }, 'selectRevealTarget', 'reveal', 'reveal-action')}</div>
            </div>
          `);
        } else if (dayActions.revealUsed) {
          $root.append('<div class="history-row">💥 คุณใช้สกิลเปิดโปงไปแล้ว</div>');
        }
        syncMobileGamePanel();
        return;
      }

      $root.append('<div class="history-row">🎬 กำลังรอให้รอบเริ่ม</div>');
      syncMobileGamePanel();
    }

    function renderWinner(winner) {
      const $banner = $('#winnerBanner');
      if (!winner) {
        $banner.hide();
        return;
      }

      const winnerText = winner === 'village' ? 'ชาวบ้านชนะแล้ว' : (winner === 'werewolf' ? 'ฝั่งหมาป่าชนะแล้ว' : 'คนบ้าชนะคนเดียวแล้ว');
      const actionHtml = isRoomAdmin
        ? '<div class="winner-actions"><button id="restartWerewolfGame" class="werewolf-btn">🎲 เล่นรอบใหม่</button><button id="backToRoomLobby" class="ghost-btn">🏠 กลับไปที่ห้อง</button></div>'
        : '<div class="winner-actions"><button id="backToRoomLobby" class="ghost-btn">🏠 กลับไปที่ห้อง</button></div>';
      $banner.html('<div>' + (winner === 'village' ? '🏡 ' : (winner === 'werewolf' ? '🐺 ' : '🤪 ')) + winnerText + '</div>' + actionHtml);
      $banner.show();
    }

    function buildPhaseTransitionCopy(state) {
      if (!state || !state.phase) {
        return null;
      }

      if (state.phase === 'night') {
        return {
          title: `🌙 คืน ${state.dayNumber || 1}`,
          subtitle: state.dayNumber === 1
            ? 'คืนแรกเริ่มแล้ว คืนนี้หมาป่ายังฆ่าใครไม่ได้'
            : 'กลางคืนเริ่มแล้ว คนมีบทกดความสามารถของตัวเองได้เลย'
        };
      }

      if (state.phase === 'day-discussion') {
        return {
          title: `☀️ เช้าวันที่ ${state.dayNumber || 1}`,
          subtitle: 'เปิดช่วงคุยก่อนโหวต ถ้าทุกคนพร้อมสามารถกดข้ามไปเปิดโหวตได้ทันที'
        };
      }

      if (state.phase === 'day-vote') {
        return {
          title: `🗳️ เริ่มโหวตวันที่ ${state.dayNumber || 1}`,
          subtitle: 'ช่วงพูดคุยจบแล้ว ทุกคนลงคะแนนแบบเปิดได้เลย'
        };
      }

      if (state.phase === 'finished' && state.winner) {
        return {
          title: state.winner === 'village' ? '🏡 ชาวบ้านชนะ' : '🐺 หมาป่าชนะ',
          subtitle: 'รอบนี้จบแล้ว จะเล่นต่อหรือกลับไปจัดห้องใหม่ก็ได้'
        };
      }

      return null;
    }

    function clearPhaseTransitionSequence() {
      phaseTransitionTimeouts.forEach(function(timeoutId) {
        clearTimeout(timeoutId);
      });
      phaseTransitionTimeouts = [];
    }

    function buildPhaseTransitionSteps(state) {
      const phaseCopy = buildPhaseTransitionCopy(state);
      if (!phaseCopy) {
        return [];
      }

      if (state.phase === 'day-discussion' && state.morningAnnouncement) {
        const morningSound = state.morningAnnouncement.outcomeType === 'death'
          ? 'morning-death'
          : (state.morningAnnouncement.outcomeType === 'saved' ? 'morning-saved' : 'morning-peaceful');

        return [
          {
            title: phaseCopy.title,
            subtitle: 'หมู่บ้านกำลังตื่นขึ้นและรับฟังข่าวจากเมื่อคืน',
            duration: 2500,
            sound: morningSound
          },
          {
            title: state.morningAnnouncement.lead,
            subtitle: state.morningAnnouncement.detail,
            duration: 3800
          },
          {
            title: phaseCopy.title,
            subtitle: phaseCopy.subtitle,
            duration: 2600
          }
        ];
      }

      if (state.phase === 'night' && state.dayResolutionAnnouncement) {
        const voteSummarySound = state.dayResolutionAnnouncement.outcomeType === 'eliminated'
          ? 'vote-summary-eliminated'
          : 'vote-summary-tie';

        return [
          {
            title: '📢 สรุปผลโหวต',
            subtitle: 'หมู่บ้านกำลังปิดฉากเวลากลางวัน',
            duration: 2200,
            sound: voteSummarySound
          },
          {
            title: state.dayResolutionAnnouncement.lead,
            subtitle: state.dayResolutionAnnouncement.detail,
            duration: 3400
          },
          {
            title: phaseCopy.title,
            subtitle: phaseCopy.subtitle,
            duration: 2600,
            sound: 'nightfall'
          }
        ];
      }

      return [{
        title: phaseCopy.title,
        subtitle: phaseCopy.subtitle,
        duration: 3200,
        sound: state.phase === 'night' ? 'nightfall' : null
      }];
    }

    function showPhaseTransition(state) {
      const steps = buildPhaseTransitionSteps(state);
      if (steps.length === 0) {
        return;
      }

      clearPhaseTransitionSequence();

      $('#werewolfShell').addClass('phase-lock');
      $('#phaseTransitionBanner').addClass('visible');

      function applyStep(index) {
        const step = steps[index];
        if (!step) {
          $('#phaseTransitionBanner').removeClass('visible');
          $('#werewolfShell').removeClass('phase-lock');
          return;
        }

        $('#phaseTransitionTitle').text(step.title);
        $('#phaseTransitionSubtitle').text(step.subtitle);
        if (step.sound) {
          playSound(step.sound);
        }

        const timeoutId = setTimeout(function() {
          applyStep(index + 1);
        }, step.duration || 2000);

        phaseTransitionTimeouts.push(timeoutId);
      }

      applyStep(0);
    }

    function setMobileView(view) {
      const nextView = view === 'game' ? 'game' : 'chat';
      $('.ww-view-tab').removeClass('active');
      $('.ww-view-tab[data-view="' + nextView + '"]').addClass('active');

      if (nextView === 'game') {
        $('.ww-chat-view').addClass('hidden');
        $('.ww-composer').hide();
        $('.ww-desktop-layout').addClass('game-active');
        $('#mobileGamePanel').addClass('active');
        syncMobileGamePanel();
        return;
      }

      $('.ww-chat-view').removeClass('hidden');
      $('.ww-composer').show();
      $('.ww-desktop-layout').removeClass('game-active');
      $('#mobileGamePanel').removeClass('active');
      scrollChatToBottom();
    }

    function renderState(state) {
      const previousPhase = currentState.phase;
      currentState = state || {};
      setActionButtonsPending(false);
      $('#phaseLabel').text(phaseLabel(currentState.phase));
      $('#phaseLabelSide').text(phaseLabel(currentState.phase));
      $('#mobilePhaseLabel').text(phaseLabel(currentState.phase));
      $('#dayNumber').text(currentState.dayNumber || 0);
      $('#myRoleName').text((currentState.playerRole ? roleEmoji(currentState.playerRole.id) + ' ' : '') + (currentState.playerRole?.thaiName || 'ยังไม่เปิดเผยบทบาท'));
      $('#myRoleTeam').text((currentState.playerRole ? teamEmoji(currentState.playerRole.team) + ' ' : '') + (currentState.playerRole?.team || '-'));
      $('#myRoleDescription').text(currentState.playerRole?.description || 'เมื่อเริ่มเกมแล้ว บทบาทของคุณจะปรากฏที่นี่');
      startPhaseCountdown(currentState.phaseEndsAt || null);
      renderWinner(currentState.winner);
      renderPlayers(currentState.players || []);
      syncHistoryToChat(currentState.history || []);
      renderNotes(currentState.personalNotes || {});
      renderRoomRoleSummary();
      renderActionPanels(currentState.actionState || {}, currentState.phase, currentState.winner);
      syncChatComposerState(currentState);
      syncWolfChatFilterVisibility(currentState);
      syncAmbientForState(currentState);
      syncMobileHeaderState();
      syncMobileGamePanel();

      const isPhaseChanged = Boolean(previousPhase && previousPhase !== currentState.phase);
      const shouldShowRoleAnnouncement = currentState.phase === 'night'
        && Number(currentState.dayNumber || 1) === 1
        && currentState.playerRole?.id;
      const announcementKey = shouldShowRoleAnnouncement
        ? [roomId, currentState.dayNumber || 1, currentState.playerRole?.id || 'unknown'].join('|')
        : null;

      if (shouldShowRoleAnnouncement && announcementKey !== lastRoleAnnouncementKey) {
        lastRoleAnnouncementKey = announcementKey;
        showRoleAnnouncement(currentState, function() {
          if (isMobileLayout()) {
            setMobileView('game');
          }
          if (isPhaseChanged) {
            showPhaseTransition(currentState);
          }
        });
      } else if (isPhaseChanged) {
        showPhaseTransition(currentState);
      }

      lastRenderedPhase = currentState.phase || null;
    }

    function bindRoom() {
      socket.emit('initPlayer', playerId);
      socket.emit('setRoom', { roomId: roomId, playerId: playerId });
      socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
    }

    activateViewportLock();
    renderInitialChatHistory();
    renderState(currentState);
    bindRoom();
    syncMobileHeaderState();
    syncMobileGamePanel();

    // View switcher (mobile)
    $(document).on('click', '.ww-view-tab', function() {
      setMobileView($(this).data('view'));
    });

    // Delegate winner/restart buttons from mobile panels
    $(document).on('click', '#mobileActionPanels #restartWerewolfGame, #mobileWinnerBanner #restartWerewolfGame', function() {
      socket.emit('werewolf_restartGame', { roomId: roomId }, function(response) {
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'เริ่มรอบใหม่ไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
        }
      });
    });
    $(document).on('click', '#mobileActionPanels #backToRoomLobby, #mobileWinnerBanner #backToRoomLobby', function() {
      allowNavigation = true;
      window.location.href = '/room/' + roomId + '?playerId=' + playerId;
    });

    // Mobile winner bar buttons (use class-based delegation)
    $(document).on('click', '#mobileWinnerBtns .werewolf-btn', function() {
      socket.emit('werewolf_restartGame', { roomId: roomId }, function(response) {
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'เริ่มรอบใหม่ไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
        }
      });
    });
    $(document).on('click', '#mobileWinnerBtns .ghost-btn', function() {
      allowNavigation = true;
      window.location.href = '/room/' + roomId + '?playerId=' + playerId;
    });

    socket.on('reconnect', function() {
      bindRoom();
    });

    window.addEventListener('beforeunload', function(e) {
      if (allowNavigation) {
        return;
      }

      e.preventDefault();
      e.returnValue = 'คุณกำลังอยู่ในเกม Werewolf ต้องการออกจริงหรือ?';
      return e.returnValue;
    });

    window.addEventListener('pagehide', function() {
      if (allowNavigation) {
        return;
      }

      sessionStorage.setItem('werewolfHiddenTime', Date.now().toString());
    });

    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'hidden') {
        wasHidden = true;
        sessionStorage.setItem('werewolfHiddenTime', Date.now().toString());
        return;
      }

      if (!wasHidden) {
        return;
      }

      wasHidden = false;
      socket.emit('checkRoomStatus', { roomId: roomId, playerId: playerId });
      socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
    });

    socket.on('werewolfState', function(state) {
      setActionButtonsPending(false);
      renderState(state);
    });

    socket.on('roomUpdate', function(payload) {
      if (!payload || !payload.players) {
        return;
      }

      $('#onlineCount').text(payload.playerCount || payload.onlineCount || payload.players.filter(function(player) { return player.online; }).length);

      const mergedPlayers = (currentState.players || []).map(function(player) {
        const roomPlayer = payload.players.find(function(candidate) {
          return candidate.playerId === player.playerId;
        });
        return roomPlayer ? { ...player, name: roomPlayer.playerName } : player;
      });

      renderState({ ...currentState, players: mergedPlayers });
    });

    socket.on('newMessage', function(data) {
      appendChatMessage(data);
    });

    socket.on('werewolfChatSync', function(entries) {
      $('#werewolfChatMessages').empty();
      renderedMessageIds.clear();
      (entries || []).forEach(function(entry) {
        appendChatMessage(entry, { silent: true });
      });
      applyChatFilter();
      scrollChatToBottom();
    });

    socket.on('chatError', function(data) {
      Swal.fire({
        icon: 'warning',
        title: 'ส่งข้อความไม่ได้',
        text: data?.message || 'ข้อความนี้ส่งไม่ได้ในสถานะปัจจุบัน',
        background: '#1e1e1e',
        color: '#fff'
      });
    });

    socket.on('werewolf_admin_roles', function(data) {
      showAdminReveal(data);
    });

    socket.on('restartGame', function() {
      Swal.fire({
        icon: 'info',
        title: 'เกมถูกรีเซ็ต',
        text: 'กำลังกลับไปที่ lobby ห้อง',
        background: '#1e1e1e',
        color: '#fff',
        timer: 2000,
        showConfirmButton: false
      }).then(function() {
        allowNavigation = true;
        window.location.href = '/room/' + roomId + '?playerId=' + playerId;
      });
    });

    socket.on('kickedFromRoom', function(data) {
      allowNavigation = true;
      Swal.fire({
        icon: 'warning',
        title: 'คุณถูกนำออกจากห้อง',
        text: data.message || 'คุณไม่ได้อยู่ในห้องนี้แล้ว',
        background: '#1e1e1e',
        color: '#fff'
      }).then(function() {
        window.location.href = '/rooms?playerId=' + playerId;
      });
    });

    socket.on('roomClosed', function(data) {
      allowNavigation = true;
      Swal.fire({
        icon: 'warning',
        title: 'ห้องถูกปิด',
        text: data.message || 'ห้องนี้ถูกปิดไปแล้ว',
        background: '#1e1e1e',
        color: '#fff'
      }).then(function() {
        window.location.href = '/rooms?playerId=' + playerId;
      });
    });

    $('#openModeGuide').on('click', function() {
      showModeGuidePopup();
    });

    $('#openRoleCatalog, #openRoleCatalogInline').on('click', function() {
      showRoleCatalogPopup();
    });

    $(document).on('click', '#restartWerewolfGame', function() {
      socket.emit('werewolf_restartGame', { roomId: roomId }, function(response) {
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'เริ่มรอบใหม่ไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
        }
      });
    });

    $(document).on('click', '#backToRoomLobby', function() {
      allowNavigation = true;
      window.location.href = '/room/' + roomId + '?playerId=' + playerId;
    });

    $('#sendWerewolfChat').on('click', function() {
      const $input = $('#werewolfChatInput');
      const message = $input.val().trim();
      if (!message) {
        return;
      }

      if (message === '/m') {
        socket.emit('werewolf_admin_request_roles', { roomId: roomId }, function(response) {
          if (!response || !response.success) {
            Swal.fire({
              icon: 'warning',
              title: 'ใช้ /m ไม่ได้',
              text: response?.error || 'คำสั่งนี้ใช้ได้เฉพาะหัวหน้าห้องเท่านั้น',
              background: '#1e1e1e',
              color: '#fff'
            });
          }
        });
        setReplyPreview(null);
        $input.val('').focus();
        return;
      }

      const composerState = getChatComposerState(currentState);
      if (composerState.chatLocked) {
        Swal.fire({
          icon: 'warning',
          title: 'ส่งข้อความไม่ได้',
          text: !composerState.isAlive
            ? 'คุณตายแล้ว จึงส่งข้อความในเกมนี้ไม่ได้'
            : 'ตอนกลางคืนมีเฉพาะหมาป่าที่ยังมีชีวิตเท่านั้นที่คุยกันเองได้',
          background: '#1e1e1e',
          color: '#fff'
        });
        return;
      }

      const payload = { message: message, playerName: myPlayerName };
      if (replyingTo) {
        payload.replyTo = replyingTo;
      }

      socket.emit('sendMessage', payload);
      setReplyPreview(null);
      $input.val('').focus();
    });

    $(document).on('click', '.chat-tab', function() {
      const nextFilter = $(this).data('chat-filter') || 'all';
      if (nextFilter === currentChatFilter) {
        return;
      }

      currentChatFilter = nextFilter;
      applyChatFilter();
    });

    $(document).on('click', '.chat-reply-btn', function() {
      const $wrapper = $(this).closest('.chat-message-wrapper');
      setReplyFromWrapper($wrapper);
    });

    $('#cancelWerewolfReply').on('click', function() {
      setReplyPreview(null);
    });

    $(document).on('touchstart', '.chat-message-wrapper[data-chat-group="player"]', function(e) {
      const touches = e.originalEvent.touches;
      if (!touches || !touches.length) {
        return;
      }

      touchStartX = touches[0].clientX;
      touchStartY = touches[0].clientY;
      swipingWrapper = $(this);
    });

    $(document).on('touchmove', '.chat-message-wrapper[data-chat-group="player"]', function(e) {
      if (!swipingWrapper || !swipingWrapper.length) {
        return;
      }

      const touches = e.originalEvent.touches;
      if (!touches || !touches.length) {
        return;
      }

      const diffX = touches[0].clientX - touchStartX;
      const diffY = Math.abs(touches[0].clientY - touchStartY);

      if (diffY > 48 || diffX <= 20) {
        return;
      }

      e.preventDefault();

      const swipeDistance = Math.min(diffX, 104);
      swipingWrapper.css('transform', 'translateX(' + swipeDistance + 'px)');

      if (diffX > 82) {
        swipingWrapper.addClass('swiping swiped');
      } else {
        swipingWrapper.addClass('swiping').removeClass('swiped');
      }
    });

    $(document).on('touchend touchcancel', '.chat-message-wrapper[data-chat-group="player"]', function(e) {
      if (!swipingWrapper || !swipingWrapper.length) {
        return;
      }

      const changedTouches = e.originalEvent.changedTouches;
      const diffX = changedTouches && changedTouches.length
        ? changedTouches[0].clientX - touchStartX
        : 0;
      const $targetWrapper = swipingWrapper;

      $targetWrapper.css('transform', '');
      $targetWrapper.removeClass('swiping swiped');
      swipingWrapper = null;

      if (diffX > 82) {
        setReplyFromWrapper($targetWrapper);
        if (navigator.vibrate) {
          navigator.vibrate(35);
        }
      }
    });

    $('#werewolfChatInput').on('keydown', function(event) {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        $('#sendWerewolfChat').click();
      }
    });

    $('#leaveWerewolfRoom').on('click', function() {
      allowNavigation = true;
      socket.emit('leaveRoom', { roomId: roomId, playerId: playerId }, function() {
        window.location.href = '/rooms?playerId=' + playerId;
      });
    });

    $(document).on('click', '.target-card-actionable', function() {
      triggerActionCardFeedback(this, this.dataset.actionType || 'action-confirm');
    });
  });
</script>
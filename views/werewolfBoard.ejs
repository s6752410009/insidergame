    function phaseLabel(phase) {
      const labels = {
        lobby: '🏕️ เตรียมตัว',
        night: '🌙 กลางคืน',
        'day-discussion': '☀️ ประชุม',
        'day-vote': '🗳️ โหวต',
        finished: '🏁 จบ'
      };

      return labels[phase] || phase || 'lobby';
    }

    function formatCountdown(phaseEndsAt) {
      if (!phaseEndsAt) {
        return '-';
      }

      const secondsLeft = Math.max(0, Math.ceil((phaseEndsAt - Date.now()) / 1000));
      const minutes = Math.floor(secondsLeft / 60);
      const seconds = secondsLeft % 60;
      return minutes + ':' + String(seconds).padStart(2, '0');
    }

    function startPhaseCountdown(phaseEndsAt) {
      if (phaseCountdownInterval) {
        clearInterval(phaseCountdownInterval);
      }

      if (activePhaseDeadline !== phaseEndsAt) {
        lastWarningKey = null;
        activePhaseDeadline = phaseEndsAt || null;
      }
      $('#phaseCountdown').text(formatCountdown(phaseEndsAt));
      $('#mobilePhaseCountdown').text(formatCountdown(phaseEndsAt));
      $('#phaseHudTimer').text(formatCountdown(phaseEndsAt));
      if (!phaseEndsAt) {
        return;
      }

      phaseCountdownInterval = setInterval(function() {
        const secondsLeft = Math.max(0, Math.ceil((phaseEndsAt - Date.now()) / 1000));
        $('#phaseCountdown').text(formatCountdown(phaseEndsAt));
        $('#mobilePhaseCountdown').text(formatCountdown(phaseEndsAt));
        $('#phaseHudTimer').text(formatCountdown(phaseEndsAt));
        if (secondsLeft <= 10 && secondsLeft > 0 && lastWarningKey !== String(phaseEndsAt)) {
          lastWarningKey = String(phaseEndsAt);
          playSound('warning');
          appendChatMessage({
            playerName: 'System',
            message: 'ใกล้หมดเวลาแล้ว ระบบจะสรุปช่วงนี้ให้อัตโนมัติ',
            timestamp: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Bangkok' }),
            avatar: '⏳'
          }, { silent: true });
        }
        if (Date.now() >= phaseEndsAt) {
          clearInterval(phaseCountdownInterval);
          phaseCountdownInterval = null;
        }
      }, 1000);
    }

    function getAudioContext() {
      if (audioContext) {
        return audioContext;
      }

      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) {
        return null;
      }

      audioContext = new AudioContextClass();
      return audioContext;
    }

    function bindAudioUnlock() {
      if (audioUnlockBound) {
        return;
      }

      audioUnlockBound = true;
      const unlockAudio = function() {
        const context = getAudioContext();
        if (!context) {
          return;
        }

        context.resume().catch(function() {}).finally(function() {
          syncAmbientForState(currentState);
        });

        document.removeEventListener('pointerdown', unlockAudio);
        document.removeEventListener('keydown', unlockAudio);
      };

      document.addEventListener('pointerdown', unlockAudio, { once: true });
      document.addEventListener('keydown', unlockAudio, { once: true });
    }

    function stopAmbient(fadeSeconds) {
      if (!ambientController) {
        return;
      }

      const context = getAudioContext();
      if (!context) {
        ambientController = null;
        return;
      }

      const fade = typeof fadeSeconds === 'number' ? fadeSeconds : 0.8;
      const now = context.currentTime;

      if (ambientController.masterGain) {
        ambientController.masterGain.gain.cancelScheduledValues(now);
        ambientController.masterGain.gain.setValueAtTime(Math.max(0.0001, ambientController.masterGain.gain.value || 0.0001), now);
        ambientController.masterGain.gain.exponentialRampToValueAtTime(0.0001, now + fade);
      }

      const nodes = ambientController;
      setTimeout(function() {
        (nodes.oscillators || []).forEach(function(oscillator) {
          try {
            oscillator.stop();
          } catch (error) {}
          try {
            oscillator.disconnect();
          } catch (error) {}
        });

        if (nodes.lfo) {
          try {
            nodes.lfo.stop();
          } catch (error) {}
          try {
            nodes.lfo.disconnect();
          } catch (error) {}
        }

        if (nodes.lfoGain) {
          try {
            nodes.lfoGain.disconnect();
          } catch (error) {}
        }

        if (nodes.masterGain) {
          try {
            nodes.masterGain.disconnect();
          } catch (error) {}
        }
      }, Math.max(50, fade * 1000 + 120));

      ambientController = null;
    }

    function startAmbient(phase) {
      const context = getAudioContext();
      if (!context) {
        return;
      }

      if (context.state === 'suspended') {
        bindAudioUnlock();
        return;
      }

      stopAmbient(0.45);

      if (phase !== 'night' && phase !== 'day-discussion' && phase !== 'day-vote') {
        return;
      }

      const now = context.currentTime;
      const masterGain = context.createGain();
      masterGain.gain.setValueAtTime(0.0001, now);
      masterGain.connect(context.destination);

      const primary = context.createOscillator();
      const secondary = context.createOscillator();
      const primaryGain = context.createGain();
      const secondaryGain = context.createGain();
      const lfo = context.createOscillator();
      const lfoGain = context.createGain();

      if (phase === 'night') {
        primary.type = 'sine';
        secondary.type = 'triangle';
        primary.frequency.setValueAtTime(110.0, now);
        secondary.frequency.setValueAtTime(164.81, now);
        primaryGain.gain.setValueAtTime(0.0048, now);
        secondaryGain.gain.setValueAtTime(0.0022, now);
        lfo.frequency.setValueAtTime(0.08, now);
        lfoGain.gain.setValueAtTime(0.0009, now);
      } else {
        primary.type = 'sine';
        secondary.type = 'sine';
        primary.frequency.setValueAtTime(196.0, now);
        secondary.frequency.setValueAtTime(246.94, now);
        primaryGain.gain.setValueAtTime(0.0022, now);
        secondaryGain.gain.setValueAtTime(0.0012, now);
        lfo.frequency.setValueAtTime(0.09, now);
        lfoGain.gain.setValueAtTime(0.00045, now);
      }

      primary.connect(primaryGain);
      secondary.connect(secondaryGain);
      primaryGain.connect(masterGain);
      secondaryGain.connect(masterGain);
      lfo.connect(lfoGain);
      lfoGain.connect(masterGain.gain);

      primary.start(now);
      secondary.start(now);
      lfo.start(now);

      const targetGain = phase === 'night' ? 0.13 : (phase === 'day-discussion' ? 0.07 : 0.08);
      masterGain.gain.exponentialRampToValueAtTime(targetGain, now + 1.6);

      ambientController = {
        phase: phase,
        masterGain: masterGain,
        oscillators: [primary, secondary],
        lfo: lfo,
        lfoGain: lfoGain
      };
    }

    function syncAmbientForState(state) {
      const phase = state?.phase;
      const winner = state?.winner;

      if (winner || (phase !== 'night' && phase !== 'day-discussion' && phase !== 'day-vote')) {
        stopAmbient(0.8);
        return;
      }

      if (ambientController && ambientController.phase === phase) {
        return;
      }

      startAmbient(phase);
    }

    function playToneSequence(notes, options) {
      const context = getAudioContext();
      if (!context || !Array.isArray(notes) || notes.length === 0) {
        return;
      }

      const settings = options || {};
      if (context.state === 'suspended') {
        context.resume().catch(function() {});
      }

      let currentTime = context.currentTime + 0.02;
      notes.forEach(function(note) {
        const oscillator = context.createOscillator();
        const gainNode = context.createGain();
        const duration = note.duration || 0.18;
        const volume = note.volume || settings.volume || 0.05;

        oscillator.type = note.wave || settings.wave || 'sine';
        oscillator.frequency.setValueAtTime(note.frequency, currentTime);

        gainNode.gain.setValueAtTime(0.0001, currentTime);
        gainNode.gain.exponentialRampToValueAtTime(volume, currentTime + 0.02);
        gainNode.gain.exponentialRampToValueAtTime(0.0001, currentTime + duration);

        oscillator.connect(gainNode);
        gainNode.connect(context.destination);

        oscillator.start(currentTime);
        oscillator.stop(currentTime + duration + 0.02);

        currentTime += duration + (note.gap || settings.gap || 0.04);
      });
    }

    function playMorningSound(outcomeType) {
      if (outcomeType === 'death') {
        playToneSequence([
          { frequency: 392.0, duration: 0.2, wave: 'triangle', volume: 0.04 },
          { frequency: 349.23, duration: 0.2, wave: 'triangle', volume: 0.042 },
          { frequency: 293.66, duration: 0.34, wave: 'sine', volume: 0.046, gap: 0.06 }
        ]);
        return;
      }

      if (outcomeType === 'saved') {
        playToneSequence([
          { frequency: 523.25, duration: 0.14, wave: 'triangle', volume: 0.04 },
          { frequency: 659.25, duration: 0.16, wave: 'triangle', volume: 0.044 },
          { frequency: 587.33, duration: 0.24, wave: 'sine', volume: 0.042 }
        ]);
        return;
      }

      playToneSequence([
        { frequency: 523.25, duration: 0.16, wave: 'triangle', volume: 0.042 },
        { frequency: 659.25, duration: 0.18, wave: 'triangle', volume: 0.048 },
        { frequency: 783.99, duration: 0.28, wave: 'triangle', volume: 0.054 },
        { frequency: 880.0, duration: 0.18, wave: 'sine', volume: 0.038, gap: 0.05 }
      ]);
    }

    function playNightSound() {
      playToneSequence([
        { frequency: 220.0, duration: 0.2, wave: 'sawtooth', volume: 0.032 },
        { frequency: 196.0, duration: 0.22, wave: 'triangle', volume: 0.034 },
        { frequency: 174.61, duration: 0.34, wave: 'sine', volume: 0.038, gap: 0.06 }
      ]);
    }

    function playSound(type) {
      if (type === 'morning-peaceful') {
        playMorningSound('peaceful');
        return;
      }

      if (type === 'morning-death') {
        playMorningSound('death');
        return;
      }

      if (type === 'morning-saved') {
        playMorningSound('saved');
        return;
      }

      if (type === 'nightfall') {
        playNightSound();
        return;
      }

      if (type === 'vote-summary-eliminated') {
        playToneSequence([
          { frequency: 369.99, duration: 0.18, wave: 'sawtooth', volume: 0.04 },
          { frequency: 311.13, duration: 0.2, wave: 'triangle', volume: 0.042 },
          { frequency: 261.63, duration: 0.3, wave: 'sine', volume: 0.046 }
        ]);
        return;
      }

      if (type === 'vote-summary-tie') {
        playToneSequence([
          { frequency: 415.3, duration: 0.12, wave: 'triangle', volume: 0.03 },
          { frequency: 415.3, duration: 0.12, wave: 'triangle', volume: 0.028, gap: 0.03 },
          { frequency: 369.99, duration: 0.24, wave: 'sine', volume: 0.032 }
        ]);
        return;
      }

      if (type === 'action-kill') {
        playToneSequence([
          { frequency: 174.61, duration: 0.05, wave: 'square', volume: 0.034 },
          { frequency: 138.59, duration: 0.08, wave: 'sawtooth', volume: 0.05, gap: 0.02 },
          { frequency: 103.83, duration: 0.16, wave: 'sawtooth', volume: 0.062 },
          { frequency: 77.78, duration: 0.22, wave: 'triangle', volume: 0.056, gap: 0.03 }
        ]);
        return;
      }

      if (type === 'action-seer') {
        playToneSequence([
          { frequency: 587.33, duration: 0.05, wave: 'triangle', volume: 0.024 },
          { frequency: 783.99, duration: 0.08, wave: 'sine', volume: 0.03 },
          { frequency: 1046.5, duration: 0.12, wave: 'triangle', volume: 0.036, gap: 0.03 },
          { frequency: 1318.51, duration: 0.18, wave: 'sine', volume: 0.03 }
        ]);
        return;
      }

      if (type === 'action-protect') {
        playToneSequence([
          { frequency: 349.23, duration: 0.08, wave: 'triangle', volume: 0.03 },
          { frequency: 523.25, duration: 0.11, wave: 'triangle', volume: 0.034 },
          { frequency: 698.46, duration: 0.14, wave: 'sine', volume: 0.036 },
          { frequency: 523.25, duration: 0.12, wave: 'triangle', volume: 0.032, gap: 0.02 }
        ]);
        return;
      }

      if (type === 'action-heal') {
        playToneSequence([
          { frequency: 523.25, duration: 0.08, wave: 'sine', volume: 0.028 },
          { frequency: 659.25, duration: 0.1, wave: 'triangle', volume: 0.032 },
          { frequency: 783.99, duration: 0.12, wave: 'sine', volume: 0.034 },
          { frequency: 987.77, duration: 0.18, wave: 'triangle', volume: 0.036 }
        ]);
        return;
      }

      if (type === 'action-poison') {
        playToneSequence([
          { frequency: 392.0, duration: 0.06, wave: 'square', volume: 0.03 },
          { frequency: 329.63, duration: 0.08, wave: 'square', volume: 0.034 },
          { frequency: 246.94, duration: 0.12, wave: 'sawtooth', volume: 0.038, gap: 0.02 },
          { frequency: 207.65, duration: 0.18, wave: 'triangle', volume: 0.04 }
        ]);
        return;
      }

      if (type === 'action-vote') {
        playToneSequence([
          { frequency: 220.0, duration: 0.05, wave: 'triangle', volume: 0.028 },
          { frequency: 164.81, duration: 0.08, wave: 'triangle', volume: 0.03, gap: 0.02 },
          { frequency: 220.0, duration: 0.07, wave: 'triangle', volume: 0.028 },
          { frequency: 146.83, duration: 0.14, wave: 'sine', volume: 0.03 }
        ]);
        return;
      }

      if (type === 'action-reveal') {
        playToneSequence([
          { frequency: 493.88, duration: 0.06, wave: 'square', volume: 0.03 },
          { frequency: 659.25, duration: 0.08, wave: 'sawtooth', volume: 0.034 },
          { frequency: 880.0, duration: 0.12, wave: 'triangle', volume: 0.036, gap: 0.03 },
          { frequency: 1174.66, duration: 0.14, wave: 'sine', volume: 0.038 }
        ]);
        return;
      }

      if (type === 'action-skip') {
        playToneSequence([
          { frequency: 392.0, duration: 0.05, wave: 'sine', volume: 0.022 },
          { frequency: 349.23, duration: 0.08, wave: 'triangle', volume: 0.024 },
          { frequency: 293.66, duration: 0.14, wave: 'sine', volume: 0.024 }
        ]);
        return;
      }

      if (type === 'action-mayor' || type === 'action-confirm') {
        playToneSequence([
          { frequency: 523.25, duration: 0.06, wave: 'triangle', volume: 0.026 },
          { frequency: 659.25, duration: 0.09, wave: 'triangle', volume: 0.03 },
          { frequency: 783.99, duration: 0.14, wave: 'sine', volume: 0.032 }
        ]);
        return;
      }

      let source = '/static/sound/ding.mp3';
      if (type === 'phase') {
        source = '/static/sound/go.mp3';
      } else if (type === 'warning') {
        source = '/static/sound/dong.mp3';
      } else if (type === 'chat') {
        source = '/static/sound/popup.mp3';
      }

      const audio = new Audio(source);
      audio.play().catch(function() {});
    }

    function renderPlayers(players) {
      const $root = $('#werewolfPlayers');
      $root.empty();

      if (!players || players.length === 0) {
        $root.append('<div class="history-row">รอผู้เล่น...</div>');
        return;
      }

      const phase = currentState?.phase || '';
      const isNight = phase === 'night';
      const isVote = phase === 'day-vote';

      // Vote-phase data
      const pendingIds = new Set(((currentState?.actionState?.dayActions?.dayVoteSummary?.pendingActors) || []).map(function(player) {
        return player.playerId;
      }));
      const completedIds = new Set((currentState?.actionState?.dayActions?.dayVoteSummary?.completedActors) || []);

      // Build voter→target map and target→voteCount map from dayVoteSummary
      const voterToTarget = new Map();
      const targetVoteCounts = new Map();
      if (isVote) {
        const targets = (currentState?.actionState?.dayActions?.dayVoteSummary?.targets) || [];
        targets.forEach(function(t) {
          targetVoteCounts.set(t.playerId, Number(t.count || 0));
          (t.voters || []).forEach(function(v) {
            voterToTarget.set(v.playerId, t.playerId);
          });
        });
      }

      // Night: collect all targetable player IDs
      const nightTargetableIds = new Set();
      if (isNight) {
        getActiveNightActions(currentState).forEach(function(action) {
          (action.targets || []).forEach(function(t) {
            nightTargetableIds.add(t.playerId);
          });
        });
      }

      // Player name lookup
      const nameById = new Map((players || []).map(function(p) { return [p.playerId, p.name]; }));

      // Toggle night-phase class on grid
      $root.toggleClass('night-phase', isNight);

      players.forEach(function(player, index) {
        const seatNumber = index + 1;
        const avatarEmoji = player.revealedRole ? roleEmoji(player.revealedRole) : (player.avatar || '👤');
        const avatarBg = player.color || '#2563eb';
        const isPending = isVote && player.alive && pendingIds.has(player.playerId);
        const isCompleted = isVote && player.alive && completedIds.has(player.playerId);
        const isNightTarget = isNight && nightTargetableIds.has(player.playerId);

        const statusParts = [];
        if (!player.alive) {
          statusParts.push('<div class="player-status-tag dead">💀 ตาย</div>');
        } else if (isPending) {
          statusParts.push('<div class="player-status-tag">⏳</div>');
        } else if (isCompleted) {
          statusParts.push('<div class="player-status-tag voted">✅</div>');
        }
        if (player.voteWeight > 1) {
          statusParts.push('<div class="player-status-tag mayor-tag">🎖️</div>');
        }
        if (player.revealedRole) {
          statusParts.push(`<div class="player-status-tag">${escapeHtml(player.revealedRole)}</div>`);
        }

        // Vote badge: show who this player voted for
        if (isVote && voterToTarget.has(player.playerId)) {
          const targetId = voterToTarget.get(player.playerId);
          const targetName = nameById.get(targetId) || '?';
          statusParts.push(`<div class="player-vote-badge">→ ${escapeHtml(targetName)}</div>`);
        }
        // Vote badge: show how many votes this player received
        if (isVote && (targetVoteCounts.get(player.playerId) || 0) > 0) {
          statusParts.push(`<div class="player-vote-badge received">🗳 ${targetVoteCounts.get(player.playerId)}</div>`);
        }

        // Target-on-grid: check if this player is a valid target
        const isTarget = currentMobileTargetAction && currentMobileTargetAction.targetIds.has(player.playerId);
        const isTargetSelected = isTarget && currentMobileTargetAction.selectedId === player.playerId;
        const isRevealTarget = isTarget && currentMobileTargetAction && currentMobileTargetAction.actionType === 'reveal-action';

        $root.append(`
          <div class="player-row ${player.alive ? '' : 'dead'} ${player.isSelf ? 'self-seat' : ''} ${player.revealedRole ? 'revealed-seat' : ''} ${isPending ? 'pending-decision' : ''} ${isCompleted ? 'completed-decision' : ''} ${isNightTarget ? 'night-targetable' : ''} ${isTarget ? 'seat-target' : ''} ${isRevealTarget ? 'reveal-target' : ''} ${isTargetSelected ? 'target-selected' : ''}" data-player-id="${escapeHtml(player.playerId)}">
            <div class="player-seat-number">${seatNumber}</div>
            <div class="player-avatar-stage" style="background:${escapeHtml(avatarBg)};">${avatarEmoji}</div>
            <div class="player-name">${escapeHtml(player.name)}</div>
            ${statusParts.join('')}
          </div>
        `);
      });
    }

    // ===== UPDATE MOBILE TARGET ACTION (set before renderPlayers) =====
    function updateMobileTargetAction() {
      const phase = currentState.phase || '';
      const winner = currentState.winner;
      const actionState = currentState.actionState || {};

      // Reset targeting
      currentMobileTargetAction = null;

      if (winner) return;

      if (phase !== 'day-vote') {
        preferredDayTargetMode = null;
      }

      if (phase === 'night') {
        var actions = actionState.nightActions || [];
        if (actions.length > 0) {
          var firstAction = getPreferredNightAction(actions);
          if (firstAction) {
            var targetIds = new Set((firstAction.targets || []).map(function(t) { return t.playerId; }));
            currentMobileTargetAction = {
              handlerName: 'selectNightTarget',
              actionType: firstAction.type,
              targetIds: targetIds,
              selectedId: firstAction.selectedTargetId || null,
              allowSkip: Boolean(firstAction.allowSkip)
            };
          }
        }
        return;
      }

      if (phase === 'day-vote') {
        var dayActions = actionState.dayActions || {};
        var voteTargets = dayActions.voteTargets || [];
        var revealTargetsVote = dayActions.revealTargets || [];
        var pendingRevealTargetIdVote = dayActions.pendingRevealTargetId || null;
        if (preferredDayTargetMode === 'reveal' && dayActions.canReveal && revealTargetsVote.length > 0) {
          var revealTargetIdsVote = new Set(revealTargetsVote.map(function(t) { return t.playerId; }));
          currentMobileTargetAction = {
            handlerName: 'selectRevealTarget',
            actionType: 'reveal-action',
            targetIds: revealTargetIdsVote,
            selectedId: pendingRevealTargetIdVote,
            allowSkip: false
          };
          return;
        }
        if (pendingRevealTargetIdVote) {
          currentMobileTargetAction = {
            handlerName: 'selectRevealTarget',
            actionType: 'reveal-action',
            targetIds: new Set([pendingRevealTargetIdVote]),
            selectedId: pendingRevealTargetIdVote,
            allowSkip: false
          };
          return;
        }
        if (voteTargets.length > 0) {
          var vTargetIds = new Set(voteTargets.map(function(t) { return t.playerId; }));
          currentMobileTargetAction = {
            handlerName: 'selectVoteTarget',
            actionType: 'day-vote',
            targetIds: vTargetIds,
            selectedId: dayActions.selectedVoteTargetId || null,
            allowSkip: dayActions.allowSkipVote
          };
        }
        return;
      }

      if (phase === 'day-discussion') {
        var discussion = actionState.discussionActions || {};
        var revealTargets = discussion.revealTargets || [];
        var pendingRevealTargetId = discussion.pendingRevealTargetId || null;
        if (pendingRevealTargetId) {
          currentMobileTargetAction = {
            handlerName: 'selectRevealTarget',
            actionType: 'reveal-action',
            targetIds: new Set([pendingRevealTargetId]),
            selectedId: pendingRevealTargetId,
            allowSkip: false
          };
          return;
        }
        if (discussion.canReveal && revealTargets.length > 0) {
          var rTargetIds = new Set(revealTargets.map(function(t) { return t.playerId; }));
          currentMobileTargetAction = {
            handlerName: 'selectRevealTarget',
            actionType: 'reveal-action',
            targetIds: rTargetIds,
            selectedId: pendingRevealTargetId,
            allowSkip: false
          };
        }
        return;
      }
    }

    // ===== RENDER MOBILE HINT BAR (unified: role + action + notes) =====
    function renderMobileHint() {
      var $hint = $('#mobileHint');
      var phase = currentState.phase || '';
      var role = currentState.playerRole;
      var actionState = currentState.actionState || {};
      var notes = currentState.personalNotes || {};
      var winner = currentState.winner;

      // Role pill text
      var rolePill = role
        ? '<span class="hint-role">' + roleEmoji(role.id) + ' ' + escapeHtml(role.thaiName || role.id) + '</span><span class="hint-sep">·</span>'
        : '';

      // Build note pills HTML
      var noteItems = buildNoteItems(notes, role ? role.id : null);
      var pillsHtml = noteItems.length
        ? '<div class="hint-pills">' + noteItems.map(function(item) {
            return '<span class="hint-pill tone-' + escapeHtml(item.tone || 'info') + '">' + (item.icon || '') + ' ' + escapeHtml(item.body || '') + '</span>';
          }).join('') + '</div>'
        : '';

      if (winner) {
        var btns = '';
        if (isRoomAdmin) btns += '<button class="hint-btn" onclick="document.getElementById(\'restartWerewolfGame\')?.click()">🎲 เล่นอีก</button>';
        btns += '<button class="hint-btn btn-skip" onclick="document.getElementById(\'backToRoomLobby\')?.click()">🏠 กลับ</button>';
        $hint.html('<div class="hint-bar">' + rolePill + '<span class="hint-text">🏁 จบรอบ!</span>' + btns + pillsHtml + '</div>');
        return;
      }

      if (phase === 'night') {
        var actions = actionState.nightActions || [];
        var nightState = actionState.nightStatus || {};
        var nightSkipCount = Number(nightState.skipCount || 0);
        var nightSkipNeeded = Number(nightState.skipNeeded || nightState.totalAlive || 0);
        var nightSkipHtml = '';
        if (nightState.canSkip) {
          nightSkipHtml = '<button class="hint-btn btn-skip" onclick="skipNightPhase()">⏭️ พร้อมข้าม</button>';
        } else if (nightState.hasSkipped) {
          nightSkipHtml = '<span class="hint-btn btn-done" style="cursor:default;">✅ พร้อมแล้ว</span>';
        }
        if (actions.length === 0) {
          var seerTagHtml = '';
          if (notes && Array.isArray(notes.seerHistory) && notes.seerHistory.length > 0) {
            var lastSeer = notes.seerHistory[0];
            seerTagHtml = buildSeerResultBadge(lastSeer, { compact: true });
          }
          var nightWaitText = nightSkipNeeded > 0
            ? '😴 พร้อมข้าม ' + nightSkipCount + '/' + nightSkipNeeded
            : '😴 รอเช้า...';
          var focusClassIdle = nightState.canSkip ? ' hint-focus' : '';
          $hint.html('<div class="hint-bar hint-night' + focusClassIdle + '">' + rolePill + '<span class="hint-text">' + nightWaitText + '</span>' + nightSkipHtml + seerTagHtml + pillsHtml + '</div>');
          return;
        }
        var action = actions[0];
        if (isWitchChoiceNight(actions)) {
          action = getPreferredNightAction(actions);
        }
        if (!action) {
          var potionBtnsOnly = actions.map(function(option) {
            var iconOnly = option.type === 'witch-heal' ? '🧪' : '☠️';
            var shortLabelOnly = option.type === 'witch-heal' ? 'ยาช่วยชีวิต' : 'ยาพิษ';
            return '<button class="hint-btn" onclick="selectWitchPotion(\'' + escapeHtml(option.type) + '\')">' + iconOnly + ' ' + shortLabelOnly + '</button>';
          }).join('');
          var focusClassPotion = ' hint-focus';
          $hint.html('<div class="hint-bar hint-night' + focusClassPotion + '">' + rolePill + '<span class="hint-text">🧙‍♀️ เลือกยาก่อน แล้วค่อยเลือกคน</span>' + potionBtnsOnly + nightSkipHtml + pillsHtml + '</div>');
          return;
        }
        var actionLabel = (actionEmoji(action.type) || '🌙') + ' ' + escapeHtml(action.label || 'เลือกเป้าหมาย');
        var status = action.locked ? '✅ เลือกแล้ว' : '👆 แตะที่ผู้เล่น';
        if (isWitchChoiceNight(actions) && !action.selectedTargetId) {
          status = '🧙‍♀️ เลือกยาก่อน แล้วค่อยเลือกคน';
        }
        var nightBtns = '';
        if (action.allowSkip && !action.locked) {
          nightBtns = '<button class="hint-btn btn-skip" onclick="selectNightTarget(\'' + escapeHtml(action.type) + '\', \'__skip__\')">⏭️ ข้าม</button>';
        }
        if (isWitchChoiceNight(actions)) {
          var potionBtns = actions.map(function(option) {
            var selectedClass = option.type === selectedWitchNightActionType ? ' btn-done' : '';
            var icon = option.type === 'witch-heal' ? '🧪' : '☠️';
            var shortLabel = option.type === 'witch-heal' ? 'ยาช่วยชีวิต' : 'ยาพิษ';
            return '<button class="hint-btn' + selectedClass + '" onclick="selectWitchPotion(\'' + escapeHtml(option.type) + '\')">' + icon + ' ' + shortLabel + '</button>';
          }).join('');
          nightBtns = potionBtns + nightBtns;
        }
        nightBtns += nightSkipHtml;
        var seerTagHtml2 = '';
        if (notes && Array.isArray(notes.seerHistory) && notes.seerHistory.length > 0) {
          var lastSeer2 = notes.seerHistory[0];
          seerTagHtml2 = buildSeerResultBadge(lastSeer2, { compact: true });
        }
        var focusClass = (action.locked && !nightState.canSkip) ? '' : ' hint-focus';
        var nightMetaHtml = nightSkipNeeded > 0 ? '<span class="hint-sep">·</span><span class="hint-text">⏭️ ' + nightSkipCount + '/' + nightSkipNeeded + '</span>' : '';
        $hint.html('<div class="hint-bar hint-night' + focusClass + '">' + rolePill + '<span class="hint-text">' + actionLabel + '</span><span class="hint-sep">·</span><span class="hint-text">' + status + '</span>' + nightMetaHtml + nightBtns + seerTagHtml2 + pillsHtml + '</div>');
        return;
      }

      if (phase === 'day-discussion') {
        var disc = actionState.discussionActions || {};
        var skipCount = Number(disc.skipCount || 0);
        var skipNeeded = Number(disc.skipNeeded || disc.totalAlive || 0);
        var btnsHtml = '';
        if (disc.canSkip) {
          btnsHtml += '<button class="hint-btn" onclick="skipDiscussionPhase()">⏩ ข้าม</button>';
        } else if (disc.hasSkipped) {
          btnsHtml += '<span class="hint-btn btn-done" style="cursor:default;">✅ พร้อม</span>';
        }
        if (disc.canRevealMayor) {
          btnsHtml += '<button class="hint-btn btn-reveal" onclick="revealMayorRole()">🎖️ เปิดนายก</button>';
        } else if (disc.mayorRevealed) {
          btnsHtml += '<span class="hint-text" style="color:#fbbf24;">🎖️ โหวต ×' + (disc.currentVoteWeight || 2) + '</span>';
        }
        if (disc.canReveal) {
          btnsHtml += '<button class="hint-btn btn-reveal" onclick="selectRevealTarget(\'__show__\')">💥 เลือกเป้าเปิดโปง</button>';
        } else if (disc.pendingRevealTargetId) {
          btnsHtml += '<span class="hint-text" style="color:#fda4af;">🎯 ล็อกเป้า ' + escapeHtml(disc.pendingRevealTargetName || 'ไว้แล้ว') + '</span>';
        } else if (disc.revealUsed) {
          btnsHtml += '<span class="hint-text" style="color:#fda4af;">💥 ใช้สกิลแล้ว</span>';
        }
        var focusClass2 = (disc.canSkip || disc.canRevealMayor || disc.canReveal) ? ' hint-focus' : '';
        $hint.html('<div class="hint-bar hint-discussion' + focusClass2 + '">' + rolePill + '<span class="hint-text">💬 ข้าม ' + skipCount + '/' + skipNeeded + '</span>' + btnsHtml + pillsHtml + '</div>');
        return;
      }

      if (phase === 'day-vote') {
        var dayActions = actionState.dayActions || {};
        var completed = dayActions.completedVotes || 0;
        var total = dayActions.totalVoters || 0;
        var voteThreshold = dayActions.voteThreshold || 0;
        var leadingVoteWeight = Number(dayActions.dayVoteSummary?.leadingVoteWeight || 0);
        var submittedVoteWeight = Number(dayActions.dayVoteSummary?.totalSubmittedVoteWeight || 0);
        var totalVoteWeight = Number(dayActions.dayVoteSummary?.totalVoteWeight || dayActions.totalVoteWeight || 0);
        var seerTagVote = '';
        if (notes && Array.isArray(notes.seerHistory) && notes.seerHistory.length > 0) {
          var lastSeerVote = notes.seerHistory[0];
          seerTagVote = buildSeerResultBadge(lastSeerVote, { compact: true });
        }
        var vBtns = '';
        if (dayActions.canVote) {
          vBtns += preferredDayTargetMode === 'reveal'
            ? '<button class="hint-btn" onclick="selectVoteTarget(\'__show__\')">🗳️ กลับไปโหวต</button>'
            : '<span class="hint-text" style="color:#97a4bf;">👆 แตะเพื่อโหวต</span>';
        } else {
          vBtns += '<span class="hint-text" style="color:#6ee7b7;">✅ โหวตแล้ว</span>';
        }
        if (dayActions.allowSkipVote && dayActions.canVote) {
          vBtns += '<button class="hint-btn btn-skip" onclick="selectVoteTarget(\'__skip__\')">⏭️ ข้าม</button>';
        }
        if (dayActions.canRevealMayor) {
          vBtns += '<button class="hint-btn btn-reveal" onclick="revealMayorRole()">🎖️ เปิดนายก</button>';
        } else if (dayActions.mayorRevealed) {
          vBtns += '<span class="hint-text" style="color:#fbbf24;">🎖️ ×' + (dayActions.currentVoteWeight || 2) + '</span>';
        }
        if (dayActions.canReveal) {
          vBtns += preferredDayTargetMode === 'reveal'
            ? '<span class="hint-text" style="color:#fda4af;">💥 กำลังเลือกเป้าเปิดโปง</span>'
            : '<button class="hint-btn btn-reveal" onclick="selectRevealTarget(\'__show__\')">💥 ใช้สกิลเปิดโปง</button>';
        } else if (dayActions.pendingRevealTargetId) {
          vBtns += '<span class="hint-text" style="color:#fda4af;">🎯 ล็อกเป้า ' + escapeHtml(dayActions.pendingRevealTargetName || 'ไว้แล้ว') + '</span>';
        }
        var focusClass3 = dayActions.canVote ? ' hint-focus' : '';
        $hint.html('<div class="hint-bar hint-vote' + focusClass3 + '">' + rolePill + '<span class="hint-text">🗳️ คะแนนนำ ' + leadingVoteWeight + '/' + voteThreshold + ' • ลงแล้ว ' + submittedVoteWeight + '/' + totalVoteWeight + ' เสียง</span>' + vBtns + seerTagVote + pillsHtml + '</div>');
        return;
      }

      // Default/lobby
      $hint.html('<div class="hint-bar">' + rolePill + '<span class="hint-text">🎬 รอเริ่มเกม...</span></div>');
    }

    function syncHistoryToChat(history) {
      if (!history || history.length === 0) {
        return;
      }

      history.slice().reverse().forEach(function(entry) {
        if (entry.type === 'system') {
          return;
        }

        const historyKey = [entry.at || '', entry.type || '', entry.message || ''].join('|');
        if (seenHistoryKeys.has(historyKey)) {
          return;
        }

        seenHistoryKeys.add(historyKey);
        appendChatMessage({
          messageId: `history-${historyKey}`,
          playerName: 'System',
          message: entry.message,
          messageType: `history-${entry.type || 'system'}`,
          timestamp: entry.at ? new Date(entry.at).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Bangkok' }) : '',
          avatar: '📜'
        }, { silent: true });
      });
    }

    function classifyMessageType(data) {
      if (data.messageType) {
        return data.messageType;
      }

      if (data.playerName !== 'System') {
        return 'player';
      }

      if (/เข้าห้อง|ออกจากห้อง|หลุดการเชื่อมต่อ/.test(data.message || '')) {
        return 'presence';
      }

      return 'system';
    }

    function classifyChatGroup(data) {
      const messageType = classifyMessageType(data);
      if (messageType === 'wolf-team') {
        return 'wolf';
      }

      return messageType === 'player' ? 'player' : 'system';
    }

    function getChatChannelBadge(messageType) {
      if (messageType === 'wolf-team') {
        return {
          className: 'channel-wolf',
          label: '🐺 แชทหมาป่า'
        };
      }

      if (messageType === 'player') {
        return {
          className: 'channel-public',
          label: '💬 วงหลัก'
        };
      }

      return {
        className: 'channel-system',
        label: '📣 ระบบ'
      };
    }

    function syncWolfChatFilterVisibility(state) {
      const canSeeWolfChat = ['werewolf', 'alphaWolf'].includes(state?.playerRole?.id || '');
      const $wolfTab = $('.chat-tab[data-chat-filter="wolf"]');
      $wolfTab.toggle(canSeeWolfChat);

      if (!canSeeWolfChat && currentChatFilter === 'wolf') {
        currentChatFilter = 'all';
      }
    }

    function buildVoteProgressBoardHtml(summary) {
      if (!summary) {
        return '';
      }

      const pendingNames = (summary.pendingActors || []).map(function(player) {
        return player.name;
      });
      const completedActors = new Set(Array.isArray(summary.completedActors) ? summary.completedActors : []);
      const alivePlayers = (currentState?.players || []).filter(function(player) {
        return player.alive !== false;
      });
      let statusText = `ตัดสินใจแล้ว ${summary.totalCompletedDecisions || 0}/${summary.totalAlive || 0} คน`;
      if (pendingNames.length) {
        statusText += ` • รอ ${pendingNames.join(', ')}`;
      } else {
        statusText += ' • ครบทุกคนแล้ว';
      }

      const pills = (summary.voterChoices || []).map(function(choice) {
        const suffix = choice.weight > 1 ? ` (${choice.weight} เสียง)` : '';
        return `<span class="target-vote-live-pill">${escapeHtml(choice.voterName)}${escapeHtml(suffix)} <span class="target-vote-live-arrow">→</span> ${escapeHtml(choice.targetName)}</span>`;
      });

      if (!pills.length) {
        pills.push('<span class="target-vote-live-pill empty">ยังไม่มีใครลงคะแนน</span>');
      }

      const pressureBadges = alivePlayers.map(function(player) {
        const isPending = !completedActors.has(player.playerId);
        return `<span class="target-vote-pending-badge ${isPending ? '' : 'done'}">${isPending ? '⏳' : '✅'} ${escapeHtml(player.name)} ${isPending ? 'ยังไม่ตัดสินใจ' : 'ตัดสินใจแล้ว'}</span>`;
      }).join('');

      return `
        <div class="target-vote-live-board">
          <div class="target-vote-live-head">
            <div class="target-vote-live-title">ทุกคนเห็นสดว่าใครโหวตใคร</div>
            <div class="target-vote-live-status">${escapeHtml(statusText)}</div>
          </div>
          <div class="target-vote-pending-row">${pressureBadges}</div>
          <div class="target-vote-live-feed">${pills.join('')}</div>
        </div>
      `;
    }

    function syncTurnSpotlight() {
      const hasFocus = !pendingActionSubmission
        && !$('#werewolfShell').hasClass('phase-lock')
        && $('.turn-focus').length > 0
        && hasLiveTurnFocus(currentState);
      $('#werewolfShell').toggleClass('my-turn-active', hasFocus);
    }

    function getChatComposerState(state) {
      const selfPlayer = (state?.players || []).find(function(player) {
        return player.isSelf;
      });
      const roleId = state?.playerRole?.id || null;
      const phase = state?.phase || 'lobby';
      const isAlive = !selfPlayer || selfPlayer.alive;
      const canWolfNightChat = phase === 'night' && isAlive && (roleId === 'werewolf' || roleId === 'alphaWolf');
      const chatLocked = Boolean(state?.winner)
        ? false
        : (!isAlive || (phase === 'night' && !canWolfNightChat));

      return {
        isAlive,
        phase,
        canWolfNightChat,
        chatLocked,
        adminCommandOnly: Boolean(canUseAdminReveal && chatLocked)
      };
    }

    function syncChatComposerState(state) {
      const composerState = getChatComposerState(state);
      const placeholder = !composerState.isAlive
        ? (composerState.adminCommandOnly
          ? 'คุณตายแล้ว แชทปกติถูกปิด แต่ยังใช้ช่องนี้สำหรับคำสั่งผู้ดูแลได้'
          : 'คุณตายแล้ว จึงไม่สามารถพิมพ์ข้อความได้')
        : (composerState.canWolfNightChat
          ? 'แชทลับหมาป่า ใช้คุยกันเฉพาะทีมหมาป่าในตอนกลางคืน'
          : (composerState.phase === 'night'
            ? (composerState.adminCommandOnly
              ? 'ตอนกลางคืนหมู่บ้านคุยไม่ได้ แต่ช่องนี้ยังรองรับคำสั่งผู้ดูแล'
              : 'ตอนกลางคืนหมู่บ้านยังคุยไม่ได้')
            : 'พิมพ์ข้อความของคุณ...'));

      $('#werewolfChatInput').prop('disabled', composerState.chatLocked && !composerState.adminCommandOnly).attr('placeholder', placeholder);
      $('#sendWerewolfChat').prop('disabled', composerState.chatLocked && !composerState.adminCommandOnly);
    }

    function showAdminReveal(data) {
      if (!data) {
        return;
      }

      const phaseText = phaseLabel(data.phase || 'lobby');
      const playerRows = (data.players || []).map(function(player) {
        const statusText = player.alive ? 'ยังอยู่' : 'ตายแล้ว';
        const teamText = teamEmoji(player.team) + ' ' + escapeHtml(player.team || '-');
        return '<div style="display:flex; justify-content:space-between; gap:12px; padding:10px 12px; margin-top:8px; border-radius:12px; background:rgba(255,255,255,0.06); text-align:left;">'
          + '<div><div style="font-weight:700; color:#fff;">' + escapeHtml(player.name) + '</div><div style="color:#cbd5e1; font-size:0.9rem;">'
          + escapeHtml(player.roleName || player.roleId || '-') + ' • ' + teamText + '</div></div>'
          + '<div style="align-self:center; color:' + (player.alive ? '#f8d189' : '#94a3b8') + '; font-weight:700; white-space:nowrap;">' + statusText + '</div></div>';
      }).join('');

      const html = '<div style="text-align:left;">'
        + '<div style="margin-bottom:12px; padding:12px 14px; border-radius:14px; background:rgba(255,255,255,0.06);">'

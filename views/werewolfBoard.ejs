  .target-card-particle-layer { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
  .target-card-particle { position: absolute; left: var(--particle-left, 50%); top: var(--particle-top, 50%); width: var(--particle-size, 12px); height: var(--particle-size, 12px); border-radius: 999px; background: var(--particle-color, rgba(255,255,255,0.8)); box-shadow: 0 0 14px var(--particle-color, rgba(255,255,255,0.55)); opacity: 0; transform: translate(-50%, -50%) scale(0.35); animation: targetParticleBurst 0.64s ease-out forwards; }
  .target-card-particle.shape-drop { border-radius: 70% 70% 70% 0; transform: translate(-50%, -50%) rotate(45deg) scale(0.35); }
  .target-card-particle.shape-ring { background: transparent; border: 2px solid var(--particle-color, rgba(255,255,255,0.8)); box-shadow: none; }
  @keyframes targetCardFlash {
    0% { opacity: 0; transform: scale(0.42); }
    28% { opacity: 0.72; }
    100% { opacity: 0; transform: scale(1.14); }
  }
  @keyframes targetParticleBurst {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
    18% { opacity: 0.95; }
    100% { opacity: 0; transform: translate(calc(-50% + var(--particle-x, 0px)), calc(-50% + var(--particle-y, 0px))) scale(1.1); }
  }
  @keyframes targetCardSelectedPulse {
    0%, 100% { box-shadow: 0 0 0 1px rgba(250,204,21,0.22), 0 18px 36px rgba(0,0,0,0.28); }
    50% { box-shadow: 0 0 0 1px rgba(250,204,21,0.35), 0 22px 40px rgba(0,0,0,0.34), 0 0 28px rgba(250,204,21,0.16); }
  }
  .action-title { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
  .player-row { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 4px 10px; border-radius: 16px; background: linear-gradient(145deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02)); border: 1px solid rgba(255,255,255,0.06); text-align: center; overflow: hidden; min-width: 0; }

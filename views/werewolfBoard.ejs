    function formatCountdown(phaseEndsAt) {
      if (!phaseEndsAt) {
        return '-';
      }

      const secondsLeft = Math.max(0, Math.ceil((phaseEndsAt - Date.now()) / 1000));
      const minutes = Math.floor(secondsLeft / 60);
      const seconds = secondsLeft % 60;
      return minutes + ':' + String(seconds).padStart(2, '0');
    }

    function startPhaseCountdown(phaseEndsAt) {
      if (phaseCountdownInterval) {
        clearInterval(phaseCountdownInterval);
      }

      if (activePhaseDeadline !== phaseEndsAt) {
        lastWarningKey = null;
        activePhaseDeadline = phaseEndsAt || null;
      }
      $('#phaseCountdown').text(formatCountdown(phaseEndsAt));
      $('#mobilePhaseCountdown').text(formatCountdown(phaseEndsAt));
      if (!phaseEndsAt) {
        return;
      }

      phaseCountdownInterval = setInterval(function() {
        const secondsLeft = Math.max(0, Math.ceil((phaseEndsAt - Date.now()) / 1000));
        $('#phaseCountdown').text(formatCountdown(phaseEndsAt));
        $('#mobilePhaseCountdown').text(formatCountdown(phaseEndsAt));
        if (secondsLeft <= 10 && secondsLeft > 0 && lastWarningKey !== String(phaseEndsAt)) {
          lastWarningKey = String(phaseEndsAt);
          playSound('warning');
          appendChatMessage({
            playerName: 'System',
            message: 'ใกล้หมดเวลาแล้ว ระบบจะสรุปช่วงนี้ให้อัตโนมัติ',
            timestamp: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Bangkok' }),
            avatar: '⏳'
          }, { silent: true });
        }
        if (Date.now() >= phaseEndsAt) {
          clearInterval(phaseCountdownInterval);
          phaseCountdownInterval = null;
        }
      }, 1000);
    }

    function getAudioContext() {
      if (audioContext) {
        return audioContext;
      }

      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) {
        return null;
      }

      audioContext = new AudioContextClass();
      return audioContext;
    }

    function bindAudioUnlock() {
      if (audioUnlockBound) {
        return;
      }

      audioUnlockBound = true;
      const unlockAudio = function() {
        const context = getAudioContext();
        if (!context) {
          return;
        }

        context.resume().catch(function() {}).finally(function() {
          syncAmbientForState(currentState);
        });

        document.removeEventListener('pointerdown', unlockAudio);
        document.removeEventListener('keydown', unlockAudio);
      };

      document.addEventListener('pointerdown', unlockAudio, { once: true });
      document.addEventListener('keydown', unlockAudio, { once: true });
    }

    function stopAmbient(fadeSeconds) {
      if (!ambientController) {
        return;
      }

      const context = getAudioContext();
      if (!context) {
        ambientController = null;
        return;
      }

      const fade = typeof fadeSeconds === 'number' ? fadeSeconds : 0.8;
      const now = context.currentTime;

      if (ambientController.masterGain) {
        ambientController.masterGain.gain.cancelScheduledValues(now);
        ambientController.masterGain.gain.setValueAtTime(Math.max(0.0001, ambientController.masterGain.gain.value || 0.0001), now);
        ambientController.masterGain.gain.exponentialRampToValueAtTime(0.0001, now + fade);
      }

      const nodes = ambientController;
      setTimeout(function() {
        (nodes.oscillators || []).forEach(function(oscillator) {
          try {
            oscillator.stop();
          } catch (error) {}
          try {
            oscillator.disconnect();
          } catch (error) {}
        });

        if (nodes.lfo) {
          try {
            nodes.lfo.stop();
          } catch (error) {}
          try {
            nodes.lfo.disconnect();
          } catch (error) {}
        }

        if (nodes.lfoGain) {
          try {
            nodes.lfoGain.disconnect();
          } catch (error) {}
        }

        if (nodes.masterGain) {
          try {
            nodes.masterGain.disconnect();
          } catch (error) {}
        }
      }, Math.max(50, fade * 1000 + 120));

      ambientController = null;
    }

    function startAmbient(phase) {
      const context = getAudioContext();
      if (!context) {
        return;
      }

      if (context.state === 'suspended') {
        bindAudioUnlock();
        return;
      }

      stopAmbient(0.45);

      if (phase !== 'night' && phase !== 'day-discussion' && phase !== 'day-vote') {
        return;
      }

      const now = context.currentTime;
      const masterGain = context.createGain();
      masterGain.gain.setValueAtTime(0.0001, now);
      masterGain.connect(context.destination);

      const primary = context.createOscillator();
      const secondary = context.createOscillator();
      const primaryGain = context.createGain();
      const secondaryGain = context.createGain();
      const lfo = context.createOscillator();
      const lfoGain = context.createGain();

      if (phase === 'night') {
        primary.type = 'sine';
        secondary.type = 'triangle';
        primary.frequency.setValueAtTime(110.0, now);
        secondary.frequency.setValueAtTime(164.81, now);
        primaryGain.gain.setValueAtTime(0.0048, now);
        secondaryGain.gain.setValueAtTime(0.0022, now);
        lfo.frequency.setValueAtTime(0.08, now);
        lfoGain.gain.setValueAtTime(0.0009, now);
      } else {
        primary.type = 'sine';
        secondary.type = 'sine';
        primary.frequency.setValueAtTime(196.0, now);
        secondary.frequency.setValueAtTime(246.94, now);
        primaryGain.gain.setValueAtTime(0.0022, now);
        secondaryGain.gain.setValueAtTime(0.0012, now);
        lfo.frequency.setValueAtTime(0.09, now);
        lfoGain.gain.setValueAtTime(0.00045, now);
      }

      primary.connect(primaryGain);
      secondary.connect(secondaryGain);
      primaryGain.connect(masterGain);
      secondaryGain.connect(masterGain);
      lfo.connect(lfoGain);
      lfoGain.connect(masterGain.gain);

      primary.start(now);
      secondary.start(now);
      lfo.start(now);

      const targetGain = phase === 'night' ? 0.13 : (phase === 'day-discussion' ? 0.07 : 0.08);
      masterGain.gain.exponentialRampToValueAtTime(targetGain, now + 1.6);

      ambientController = {
        phase: phase,
        masterGain: masterGain,
        oscillators: [primary, secondary],
        lfo: lfo,
        lfoGain: lfoGain
      };
    }

    function syncAmbientForState(state) {
      const phase = state?.phase;
      const winner = state?.winner;

      if (winner || (phase !== 'night' && phase !== 'day-discussion' && phase !== 'day-vote')) {
        stopAmbient(0.8);
        return;
      }

      if (ambientController && ambientController.phase === phase) {
        return;
      }

      startAmbient(phase);
    }

    function playToneSequence(notes, options) {
      const context = getAudioContext();
      if (!context || !Array.isArray(notes) || notes.length === 0) {
        return;
      }

      const settings = options || {};
      if (context.state === 'suspended') {
        context.resume().catch(function() {});
      }

      let currentTime = context.currentTime + 0.02;
      notes.forEach(function(note) {
        const oscillator = context.createOscillator();
        const gainNode = context.createGain();
        const duration = note.duration || 0.18;
        const volume = note.volume || settings.volume || 0.05;

        oscillator.type = note.wave || settings.wave || 'sine';
        oscillator.frequency.setValueAtTime(note.frequency, currentTime);

        gainNode.gain.setValueAtTime(0.0001, currentTime);
        gainNode.gain.exponentialRampToValueAtTime(volume, currentTime + 0.02);
        gainNode.gain.exponentialRampToValueAtTime(0.0001, currentTime + duration);

        oscillator.connect(gainNode);
        gainNode.connect(context.destination);

        oscillator.start(currentTime);
        oscillator.stop(currentTime + duration + 0.02);

        currentTime += duration + (note.gap || settings.gap || 0.04);
      });
    }

    function playMorningSound(outcomeType) {
      if (outcomeType === 'death') {
        playToneSequence([
          { frequency: 392.0, duration: 0.2, wave: 'triangle', volume: 0.04 },
          { frequency: 349.23, duration: 0.2, wave: 'triangle', volume: 0.042 },
          { frequency: 293.66, duration: 0.34, wave: 'sine', volume: 0.046, gap: 0.06 }
        ]);
        return;
      }

      if (outcomeType === 'saved') {
        playToneSequence([
          { frequency: 523.25, duration: 0.14, wave: 'triangle', volume: 0.04 },
          { frequency: 659.25, duration: 0.16, wave: 'triangle', volume: 0.044 },
          { frequency: 587.33, duration: 0.24, wave: 'sine', volume: 0.042 }
        ]);
        return;
      }

      playToneSequence([
        { frequency: 523.25, duration: 0.16, wave: 'triangle', volume: 0.042 },
        { frequency: 659.25, duration: 0.18, wave: 'triangle', volume: 0.048 },
        { frequency: 783.99, duration: 0.28, wave: 'triangle', volume: 0.054 },
        { frequency: 880.0, duration: 0.18, wave: 'sine', volume: 0.038, gap: 0.05 }
      ]);
    }

    function playNightSound() {
      playToneSequence([
        { frequency: 220.0, duration: 0.2, wave: 'sawtooth', volume: 0.032 },
        { frequency: 196.0, duration: 0.22, wave: 'triangle', volume: 0.034 },
        { frequency: 174.61, duration: 0.34, wave: 'sine', volume: 0.038, gap: 0.06 }
      ]);
    }

    function playSound(type) {
      if (type === 'morning-peaceful') {
        playMorningSound('peaceful');
        return;
      }

      if (type === 'morning-death') {
        playMorningSound('death');
        return;
      }

      if (type === 'morning-saved') {
        playMorningSound('saved');
        return;
      }

      if (type === 'nightfall') {
        playNightSound();
        return;
      }

      if (type === 'vote-summary-eliminated') {
        playToneSequence([
          { frequency: 369.99, duration: 0.18, wave: 'sawtooth', volume: 0.04 },
          { frequency: 311.13, duration: 0.2, wave: 'triangle', volume: 0.042 },
          { frequency: 261.63, duration: 0.3, wave: 'sine', volume: 0.046 }
        ]);
        return;
      }

      if (type === 'vote-summary-tie') {
        playToneSequence([
          { frequency: 415.3, duration: 0.12, wave: 'triangle', volume: 0.03 },
          { frequency: 415.3, duration: 0.12, wave: 'triangle', volume: 0.028, gap: 0.03 },
          { frequency: 369.99, duration: 0.24, wave: 'sine', volume: 0.032 }
        ]);
        return;
      }

      if (type === 'action-kill') {
        playToneSequence([
          { frequency: 174.61, duration: 0.05, wave: 'square', volume: 0.034 },
          { frequency: 138.59, duration: 0.08, wave: 'sawtooth', volume: 0.05, gap: 0.02 },
          { frequency: 103.83, duration: 0.16, wave: 'sawtooth', volume: 0.062 },
          { frequency: 77.78, duration: 0.22, wave: 'triangle', volume: 0.056, gap: 0.03 }
        ]);
        return;
      }

      if (type === 'action-seer') {
        playToneSequence([
          { frequency: 587.33, duration: 0.05, wave: 'triangle', volume: 0.024 },
          { frequency: 783.99, duration: 0.08, wave: 'sine', volume: 0.03 },
          { frequency: 1046.5, duration: 0.12, wave: 'triangle', volume: 0.036, gap: 0.03 },
          { frequency: 1318.51, duration: 0.18, wave: 'sine', volume: 0.03 }
        ]);
        return;
      }

      if (type === 'action-protect') {
        playToneSequence([
          { frequency: 349.23, duration: 0.08, wave: 'triangle', volume: 0.03 },
          { frequency: 523.25, duration: 0.11, wave: 'triangle', volume: 0.034 },
          { frequency: 698.46, duration: 0.14, wave: 'sine', volume: 0.036 },
          { frequency: 523.25, duration: 0.12, wave: 'triangle', volume: 0.032, gap: 0.02 }
        ]);
        return;
      }

      if (type === 'action-heal') {
        playToneSequence([
          { frequency: 523.25, duration: 0.08, wave: 'sine', volume: 0.028 },
          { frequency: 659.25, duration: 0.1, wave: 'triangle', volume: 0.032 },
          { frequency: 783.99, duration: 0.12, wave: 'sine', volume: 0.034 },
          { frequency: 987.77, duration: 0.18, wave: 'triangle', volume: 0.036 }
        ]);
        return;
      }

      if (type === 'action-poison') {
        playToneSequence([
          { frequency: 392.0, duration: 0.06, wave: 'square', volume: 0.03 },
          { frequency: 329.63, duration: 0.08, wave: 'square', volume: 0.034 },
          { frequency: 246.94, duration: 0.12, wave: 'sawtooth', volume: 0.038, gap: 0.02 },
          { frequency: 207.65, duration: 0.18, wave: 'triangle', volume: 0.04 }
        ]);
        return;
      }

      if (type === 'action-vote') {
        playToneSequence([
          { frequency: 220.0, duration: 0.05, wave: 'triangle', volume: 0.028 },
          { frequency: 164.81, duration: 0.08, wave: 'triangle', volume: 0.03, gap: 0.02 },
          { frequency: 220.0, duration: 0.07, wave: 'triangle', volume: 0.028 },
          { frequency: 146.83, duration: 0.14, wave: 'sine', volume: 0.03 }
        ]);
        return;
      }

      if (type === 'action-reveal') {
        playToneSequence([
          { frequency: 493.88, duration: 0.06, wave: 'square', volume: 0.03 },
          { frequency: 659.25, duration: 0.08, wave: 'sawtooth', volume: 0.034 },
          { frequency: 880.0, duration: 0.12, wave: 'triangle', volume: 0.036, gap: 0.03 },
          { frequency: 1174.66, duration: 0.14, wave: 'sine', volume: 0.038 }
        ]);
        return;
      }

      if (type === 'action-skip') {
        playToneSequence([
          { frequency: 392.0, duration: 0.05, wave: 'sine', volume: 0.022 },
          { frequency: 349.23, duration: 0.08, wave: 'triangle', volume: 0.024 },
          { frequency: 293.66, duration: 0.14, wave: 'sine', volume: 0.024 }
        ]);
        return;
      }

      if (type === 'action-mayor' || type === 'action-confirm') {
        playToneSequence([
          { frequency: 523.25, duration: 0.06, wave: 'triangle', volume: 0.026 },
          { frequency: 659.25, duration: 0.09, wave: 'triangle', volume: 0.03 },
          { frequency: 783.99, duration: 0.14, wave: 'sine', volume: 0.032 }
        ]);
        return;
      }

      let source = '/static/sound/ding.mp3';
      if (type === 'phase') {
        source = '/static/sound/go.mp3';
      } else if (type === 'warning') {
        source = '/static/sound/dong.mp3';
      } else if (type === 'chat') {
        source = '/static/sound/popup.mp3';
      }

      const audio = new Audio(source);
      audio.play().catch(function() {});
    }

    function renderPlayers(players) {
      const $root = $('#werewolfPlayers');
      $root.empty();

      if (!players || players.length === 0) {
        $root.append('<div class="history-row">ยังไม่มีข้อมูลผู้เล่น</div>');
        return;
      }

      players.forEach(function(player) {
        const aliveText = player.alive ? 'ยังอยู่ในเกม' : 'ออกจากเกมแล้ว';
        const selfText = player.isSelf ? ' (คุณ)' : '';
        const revealText = player.revealedRole ? `<div class="subtle">บทบาท: ${escapeHtml(player.revealedRole)}</div>` : '';
        const mayorText = player.voteWeight > 1 ? `<div class="highlight">🎖️ โหวตหนัก ${player.voteWeight} เสียง</div>` : '';
        const playerEmoji = player.revealedRole ? '🎭' : (player.isSelf ? '🫵' : '👤');
        $root.append(`
          <div class="player-row ${player.alive ? '' : 'dead'}">
            <div>
              <div class="player-name-line"><span>${playerEmoji}</span><strong>${escapeHtml(player.name)}${selfText}</strong></div>
              ${revealText}
              ${mayorText}
            </div>
            <div class="player-side-meta">
              <div class="player-status-badge ${player.alive ? 'alive' : 'dead'}">${statusEmoji(player.alive)} ${aliveText}</div>
            </div>
          </div>
        `);
      });
    }

    function syncHistoryToChat(history) {
      if (!history || history.length === 0) {
        return;
      }

      history.slice().reverse().forEach(function(entry) {
        if (entry.type === 'system') {
          return;
        }

        const historyKey = [entry.at || '', entry.type || '', entry.message || ''].join('|');
        if (seenHistoryKeys.has(historyKey)) {
          return;
        }

        seenHistoryKeys.add(historyKey);
        appendChatMessage({
          messageId: `history-${historyKey}`,
          playerName: 'System',
          message: entry.message,
          messageType: `history-${entry.type || 'system'}`,
          timestamp: entry.at ? new Date(entry.at).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Bangkok' }) : '',
          avatar: '📜'
        }, { silent: true });
      });
    }

    function classifyMessageType(data) {
      if (data.messageType) {
        return data.messageType;
      }

      if (data.playerName !== 'System') {
        return 'player';
      }

      if (/เข้าห้อง|ออกจากห้อง|หลุดการเชื่อมต่อ/.test(data.message || '')) {
        return 'presence';
      }

      return 'system';
    }

    function classifyChatGroup(data) {
      const messageType = classifyMessageType(data);
      if (messageType === 'wolf-team') {
        return 'wolf';
      }

      return messageType === 'player' ? 'player' : 'system';
    }

    function getChatChannelBadge(messageType) {
      if (messageType === 'wolf-team') {
        return {
          className: 'channel-wolf',
          label: '🐺 แชทหมาป่า'
        };
      }

      if (messageType === 'player') {
        return {
          className: 'channel-public',
          label: '💬 วงหลัก'
        };
      }

      return {
        className: 'channel-system',
        label: '📣 ระบบ'
      };
    }

    function syncWolfChatFilterVisibility(state) {
      const canSeeWolfChat = ['werewolf', 'alphaWolf'].includes(state?.playerRole?.id || '');
      const $wolfTab = $('.chat-tab[data-chat-filter="wolf"]');
      $wolfTab.toggle(canSeeWolfChat);

      if (!canSeeWolfChat && currentChatFilter === 'wolf') {
        currentChatFilter = 'all';
      }
    }

    function buildVoteProgressBoardHtml(summary) {
      if (!summary) {
        return '';
      }

      const pendingNames = (summary.pendingActors || []).map(function(player) {
        return player.name;
      });
      let statusText = `ตัดสินใจแล้ว ${summary.totalCompletedDecisions || 0}/${summary.totalAlive || 0} คน`;
      if (pendingNames.length) {
        statusText += ` • รอ ${pendingNames.join(', ')}`;
      } else {
        statusText += ' • ครบทุกคนแล้ว';
      }

      const pills = (summary.voterChoices || []).map(function(choice) {
        const suffix = choice.weight > 1 ? ` (${choice.weight} เสียง)` : '';
        return `<span class="target-vote-live-pill">${escapeHtml(choice.voterName)}${escapeHtml(suffix)} <span class="target-vote-live-arrow">→</span> ${escapeHtml(choice.targetName)}</span>`;
      });

      if (!pills.length) {
        pills.push('<span class="target-vote-live-pill empty">ยังไม่มีใครลงคะแนน</span>');
      }

      return `
        <div class="target-vote-live-board">
          <div class="target-vote-live-head">
            <div class="target-vote-live-title">ทุกคนเห็นสดว่าใครโหวตใคร</div>
            <div class="target-vote-live-status">${escapeHtml(statusText)}</div>
          </div>
          <div class="target-vote-live-feed">${pills.join('')}</div>
        </div>
      `;
    }

    function getChatComposerState(state) {
      const selfPlayer = (state?.players || []).find(function(player) {
        return player.isSelf;
      });
      const roleId = state?.playerRole?.id || null;
      const phase = state?.phase || 'lobby';
      const isAlive = !selfPlayer || selfPlayer.alive;
      const canWolfNightChat = phase === 'night' && isAlive && (roleId === 'werewolf' || roleId === 'alphaWolf');
      const chatLocked = Boolean(state?.winner)
        ? false
        : (!isAlive || (phase === 'night' && !canWolfNightChat));

      return {
        isAlive,
        phase,
        canWolfNightChat,
        chatLocked,
        adminCommandOnly: Boolean(isRoomAdmin && chatLocked)
      };
    }

    function syncChatComposerState(state) {
      const composerState = getChatComposerState(state);
      const placeholder = !composerState.isAlive
        ? (composerState.adminCommandOnly
          ? 'คุณตายแล้ว แชทปกติถูกปิด แต่ยังใช้ช่องนี้สำหรับคำสั่งผู้ดูแลได้'
          : 'คุณตายแล้ว จึงไม่สามารถพิมพ์ข้อความได้')
        : (composerState.canWolfNightChat
          ? 'แชทลับหมาป่า ใช้คุยกันเฉพาะทีมหมาป่าในตอนกลางคืน'
          : (composerState.phase === 'night'
            ? (composerState.adminCommandOnly
              ? 'ตอนกลางคืนหมู่บ้านคุยไม่ได้ แต่ช่องนี้ยังรองรับคำสั่งผู้ดูแล'
              : 'ตอนกลางคืนหมู่บ้านยังคุยไม่ได้')
            : 'พิมพ์ข้อความของคุณ...'));

      $('#werewolfChatInput').prop('disabled', composerState.chatLocked && !composerState.adminCommandOnly).attr('placeholder', placeholder);
      $('#sendWerewolfChat').prop('disabled', composerState.chatLocked && !composerState.adminCommandOnly);
    }

    function showAdminReveal(data) {
      if (!data) {
        return;
      }

      const phaseText = phaseLabel(data.phase || 'lobby');
      const playerRows = (data.players || []).map(function(player) {
        const statusText = player.alive ? 'ยังอยู่' : 'ตายแล้ว';
        const teamText = teamEmoji(player.team) + ' ' + escapeHtml(player.team || '-');
        return '<div style="display:flex; justify-content:space-between; gap:12px; padding:10px 12px; margin-top:8px; border-radius:12px; background:rgba(255,255,255,0.06); text-align:left;">'
          + '<div><div style="font-weight:700; color:#fff;">' + escapeHtml(player.name) + '</div><div style="color:#cbd5e1; font-size:0.9rem;">'
          + escapeHtml(player.roleName || player.roleId || '-') + ' • ' + teamText + '</div></div>'
          + '<div style="align-self:center; color:' + (player.alive ? '#f8d189' : '#94a3b8') + '; font-weight:700; white-space:nowrap;">' + statusText + '</div></div>';
      }).join('');

      const html = '<div style="text-align:left;">'
        + '<div style="margin-bottom:12px; padding:12px 14px; border-radius:14px; background:rgba(255,255,255,0.06);">'
        + '<div style="font-weight:700; color:#fff;">ห้อง: ' + escapeHtml(data.roomName || roomId) + '</div>'
        + '<div style="color:#cbd5e1; margin-top:4px;">เฟส: ' + escapeHtml(phaseText) + ' | วันที่ ' + escapeHtml(String(data.dayNumber || 0)) + '</div>'
        + '</div>'
        + '<div style="max-height:50vh; overflow:auto; padding-right:4px;">' + (playerRows || '<div style="color:#cbd5e1;">ยังไม่มีข้อมูลผู้เล่น</div>') + '</div>'
        + '</div>';

      Swal.fire({
        title: 'ข้อมูลผู้ดูแล',
        html: html,
        width: 640,
        confirmButtonText: 'ปิด',
        background: '#101726',
        color: '#f8fafc'
      });
    }

    function applyChatFilter() {
      const shouldStickToBottom = isChatNearBottom();

      $('#werewolfChatMessages .chat-message-wrapper').each(function() {
        const group = $(this).data('chat-group') || 'system';
        const shouldShow = currentChatFilter === 'all' || group === currentChatFilter;
        $(this).toggle(shouldShow);
      });

      $('.chat-tab').removeClass('active');
      $('.chat-tab[data-chat-filter="' + currentChatFilter + '"]').addClass('active');

      if (shouldStickToBottom) {
        scrollChatToBottom();
      }
    }

    function scrollChatToBottom() {
      const area = $('#werewolfChatMessages')[0];
      if (!area) {
        return;
      }

      area.scrollTop = area.scrollHeight;
    }

    function isChatNearBottom() {
      const area = $('#werewolfChatMessages')[0];
      if (!area) {
        return true;
      }

      return area.scrollHeight - area.scrollTop - area.clientHeight < 72;
    }

    function setReplyFromWrapper($wrapper) {
      if (!$wrapper || !$wrapper.length || $wrapper.data('chat-group') !== 'player') {
        return;
      }

      setReplyPreview({
        id: $wrapper.data('message-id') || '',
        name: $wrapper.data('player-name') || 'ข้อความ',
        content: $wrapper.data('message-text') || ''
      });
      $('#werewolfChatInput').focus();
    }

    function setReplyPreview(replyData) {
      replyingTo = replyData;

      if (!replyData) {
        $('#werewolfReplyPreview').hide();
        $('#werewolfReplyPreviewTitle').text('');
        $('#werewolfReplyPreviewText').text('');
        return;
      }

      $('#werewolfReplyPreviewTitle').text('ตอบกลับ ' + (replyData.name || 'ข้อความ'));
      $('#werewolfReplyPreviewText').text(replyData.content || '');
      $('#werewolfReplyPreview').show();
    }

    function noteToneForRole(roleId) {
      const tones = {
        seer: 'seer',
        doctor: 'doctor',
        witch: 'witch',
        fool: 'fool',
        bodyguard: 'bodyguard',
        mayor: 'mayor',
        revealer: 'revealer',
        werewolf: 'werewolf',
        alphaWolf: 'werewolf',
        villager: 'villager'
      };

      return tones[roleId] || 'info';
    }

    function buildNoteItems(notes, roleId) {
      const items = [];
      const roleTone = noteToneForRole(roleId);

      if (notes && notes.lastNightResult) {
        items.push({
          priority: 100,
          tone: 'alert',
          icon: '📝',
          label: 'เหตุการณ์ล่าสุด',
          body: notes.lastNightResult
        });
      }

      if (Array.isArray(notes?.seerHistory) && notes.seerHistory.length > 0) {
        notes.seerHistory.forEach(function(entry, index) {
          const dayText = entry?.dayNumber ? 'คืน ' + entry.dayNumber + ': ' : '';
          items.push({
            priority: index === 0 ? 95 : (80 - index),
            tone: 'seer',
            icon: '🔮',
            label: index === 0 ? 'ผลตรวจล่าสุด' : 'ประวัติผลตรวจ',
            body: dayText + (entry?.summary || '-')
          });
        });
      } else if (notes && notes.lastSeenRole) {
        items.push({
          priority: 95,
          tone: 'seer',
          icon: '🔮',
          label: 'ผลตรวจล่าสุด',
          body: notes.lastSeenRole
        });
      }

      if (Array.isArray(notes?.roleNotes) && notes.roleNotes.length > 0) {
        notes.roleNotes.forEach(function(item, index) {
          items.push({
            priority: 60 - index,
            tone: roleTone,
            icon: roleEmoji(roleId),
            label: 'ข้อมูลบทบาท',
            body: item
          });
        });
      }

      return items.sort(function(left, right) {
        return (right.priority || 0) - (left.priority || 0);
      });
    }

    function renderNoteCards(items) {
      if (!items.length) {
        return '<div class="note-row note-empty">ยังไม่มีข้อมูลลับเพิ่มเติม</div>';
      }

      return items.map(function(item) {
        return `
          <div class="note-row note-${escapeHtml(item.tone || 'info')}">
            <div class="note-head">
              <span class="note-icon">${escapeHtml(item.icon || 'ℹ️')}</span>
              <span class="note-label">${escapeHtml(item.label || 'ข้อมูล')}</span>
            </div>
            <div class="note-body">${escapeHtml(item.body || '-')}</div>
          </div>
        `;
      }).join('');
    }

    function renderNotes(notes) {
      const $root = $('#personalNotes');
      $root.empty();

      const items = buildNoteItems(notes, currentState.playerRole?.id);

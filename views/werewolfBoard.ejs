      setReplyFromWrapper($wrapper);
    });

    $('#cancelWerewolfReply').on('click', function() {
      setReplyPreview(null);
    });

    $(document).on('touchstart', '.chat-message-wrapper[data-chat-group="player"]', function(e) {
      const touches = e.originalEvent.touches;
      if (!touches || !touches.length) {
        return;
      }

      touchStartX = touches[0].clientX;
      touchStartY = touches[0].clientY;
      swipingWrapper = $(this);
    });

    $(document).on('touchmove', '.chat-message-wrapper[data-chat-group="player"]', function(e) {
      if (!swipingWrapper || !swipingWrapper.length) {
        return;
      }

      const touches = e.originalEvent.touches;
      if (!touches || !touches.length) {
        return;
      }

      const diffX = touches[0].clientX - touchStartX;
      const diffY = Math.abs(touches[0].clientY - touchStartY);

      if (diffY > 48 || diffX <= 20) {
        return;
      }

      e.preventDefault();

      const swipeDistance = Math.min(diffX, 104);
      swipingWrapper.css('transform', 'translateX(' + swipeDistance + 'px)');

      if (diffX > 82) {
        swipingWrapper.addClass('swiping swiped');
      } else {
        swipingWrapper.addClass('swiping').removeClass('swiped');
      }
    });

    $(document).on('touchend touchcancel', '.chat-message-wrapper[data-chat-group="player"]', function(e) {
      if (!swipingWrapper || !swipingWrapper.length) {
        return;
      }

      const changedTouches = e.originalEvent.changedTouches;
      const diffX = changedTouches && changedTouches.length
        ? changedTouches[0].clientX - touchStartX
        : 0;
      const $targetWrapper = swipingWrapper;

      $targetWrapper.css('transform', '');
      $targetWrapper.removeClass('swiping swiped');
      swipingWrapper = null;

      if (diffX > 82) {
        setReplyFromWrapper($targetWrapper);
        if (navigator.vibrate) {
          navigator.vibrate(35);
        }
      }
    });

    $('#werewolfChatInput').on('keydown', function(event) {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        $('#sendWerewolfChat').click();
      }
    });

    $('#werewolfChatInput').on('focus', function() {
      if (!isMobileLayout()) {
        return;
      }

      window.setTimeout(function() {
        syncViewportHeight();
        scrollChatToBottom();
      }, 80);
      window.setTimeout(function() {
        syncViewportHeight();
        scrollChatToBottom();
      }, 260);
    });

    $('#werewolfChatInput').on('blur', function() {
      if (!isMobileLayout()) {
        return;
      }

      window.setTimeout(syncViewportHeight, 160);
    });

    $('#leaveWerewolfRoom').on('click', function() {
      Swal.fire({
        icon: 'question',
        title: 'ออกจากห้อง?',
        text: 'ต้องการออกจากห้อง Werewolf นี้หรือไม่?',
        background: '#111827',
        color: '#fff',
        showCancelButton: true,
        confirmButtonText: 'ออกจากห้อง',
        cancelButtonText: 'ยกเลิก',
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#475569'
      }).then(function(result) {
        if (!result.isConfirmed) {
          return;
        }

        allowNavigation = true;
        socket.emit('leaveRoom', { roomId: roomId, playerId: playerId }, function() {
          window.location.href = '/rooms?playerId=' + playerId;
        });
      });
    });

    $(document).on('click', '.target-card-actionable', function() {
      triggerActionCardFeedback(this, this.dataset.actionType || 'action-confirm');
    });

    // Tap-to-target: click on player seat in mobile grid
    $(document).on('click', '#mobileInlinePlayerGrid .player-row.seat-target, #werewolfPlayers .player-row.seat-target', function() {
      if (!currentMobileTargetAction) return;
      var playerId = $(this).attr('data-player-id');
      if (!playerId) return;
      var action = currentMobileTargetAction;
      if (action.handlerName === 'selectNightTarget') {
        selectNightTarget(action.actionType, playerId);
      } else if (action.handlerName === 'selectVoteTarget') {
        selectVoteTarget(playerId);
      } else if (action.handlerName === 'selectRevealTarget') {
        selectRevealTarget(playerId);
      }
    });

    // ===== FLOATING CHAT OVERLAY (mobile) =====
    function openChatOverlay() {
      $('#chatOverlay').addClass('open');
      $('#chatFab').hide();
      $('#chatFabBadge').text('0').removeClass('active');
      scrollChatToBottom();
      setTimeout(function() { $('#overlayChatInput').focus(); }, 350);
    }

    function closeChatOverlay() {
      $('#chatOverlay').removeClass('open');
      setTimeout(function() { $('#chatFab').show(); }, 300);
    }

    $('#chatFab').on('click', openChatOverlay);
    $('#chatOverlayClose').on('click', closeChatOverlay);
    $('#chatOverlayBg').on('click', closeChatOverlay);

    // Overlay chat send
    $('#overlaySendChat').on('click', function() {
      var msg = $('#overlayChatInput').val().trim();
      if (!msg) return;
      socket.emit('sendMessage', { message: msg, playerName: myPlayerName, replyTo: replyingTo });
      $('#overlayChatInput').val('');
      replyingTo = null;
      $('#overlayReplyPreview').hide();
    });

    $('#overlayChatInput').on('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        $('#overlaySendChat').click();
      }
    });

    // Overlay chat filter tabs
    $(document).on('click', '#overlayChatFilters .chat-tab', function() {
      currentChatFilter = $(this).data('chat-filter');
      applyChatFilter();
    });

    // Cancel reply in overlay
    $('#overlayCancelReply').on('click', function() {
      replyingTo = null;
      $('#overlayReplyPreview').hide();
    });

    // ===== WIN SCREEN OVERLAY =====
    var winScreenShown = false;

    function showWinScreen(state) {
      if (!state || !state.winner) return;
      if (winScreenShown) return;
      winScreenShown = true;

      var winner = state.winner;
      var players = state.players || [];
      var history = state.history || [];

      // Title
      var titleEmoji = winner === 'village' ? '🏡' : (winner === 'werewolf' ? '🐺' : '🤪');
      var titleText = winner === 'village' ? 'ชาวบ้านชนะ!' : (winner === 'werewolf' ? 'หมาป่าชนะ!' : 'คนบ้าชนะ!');
      $('#winTitle').html(titleEmoji + ' ' + titleText);

      // Subtitle
      var aliveCount = players.filter(function(p) { return p.alive; }).length;
      var deadCount = players.length - aliveCount;
      $('#winSubtitle').text('จบเกมแล้ว · รอดชีวิต ' + aliveCount + ' คน · เสียชีวิต ' + deadCount + ' คน');

      // Player grid
      var gridHtml = '';
      players.forEach(function(p) {
        var teamClass = '';
        var roleTeam = p.roleTeam || '';
        if (roleTeam === 'werewolf') teamClass = 'team-werewolf';
        else if (roleTeam === 'village') teamClass = 'team-village';
        else if (roleTeam === 'solo') teamClass = 'team-solo';

        var deadClass = p.alive ? '' : 'dead-player';
        var statusHtml = p.alive
          ? '<div class="win-player-status alive">รอดชีวิต</div>'
          : '<div class="win-player-status dead">☠ เสียชีวิต</div>';

        var roleName = p.roleThaiName || p.revealedRole || '?';
        var roleIcon = roleEmoji(p.roleId || '');

        gridHtml += '<div class="win-player-card ' + teamClass + ' ' + deadClass + '">';
        gridHtml += '<div class="win-player-avatar">' + (p.avatar || '👤') + '</div>';
        gridHtml += '<div class="win-player-name" style="color:' + escapeHtml(p.color || '#fff') + ';">' + escapeHtml(p.name) + '</div>';
        gridHtml += '<div class="win-player-role">' + roleIcon + ' ' + escapeHtml(roleName) + '</div>';
        gridHtml += statusHtml;
        gridHtml += '</div>';
      });
      $('#winPlayersGrid').html(gridHtml);

      // Game summary from history
      var summaryLines = [];
      history.forEach(function(h) {
        if (h.type === 'night' || h.type === 'day' || h.type === 'result') {
          summaryLines.push(h.message);
        }
      });
      if (summaryLines.length > 0) {
        var maxLines = Math.min(summaryLines.length, 3);
        $('#winSummaryBody').html(summaryLines.slice(-maxLines).map(function(line) {
          return '<div class="win-summary-item">' + escapeHtml(line) + '</div>';
        }).join(''));
        $('#winSummary').show();
      }

      // Action buttons
      var actionsHtml = '';
      if (isRoomAdmin) {
        actionsHtml += '<button id="winRestartGame" class="werewolf-btn">🎲 เล่นอีก!</button>';
      }
      actionsHtml += '<button id="winBackToLobby" class="ghost-btn">🏠 กลับห้อง</button>';
      actionsHtml += '<button id="winDismiss" class="ghost-btn">✕ ปิด</button>';
      $('#winActions').html(actionsHtml);

      $('#winOverlay').addClass('open');
    }

    function hideWinScreen() {
      $('#winOverlay').removeClass('open');
    }

    $(document).on('click', '#winDismiss', hideWinScreen);
    $(document).on('click', '#winRestartGame', function() {
      socket.emit('werewolf_restartGame', { roomId: roomId }, function(response) {
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'เริ่มรอบใหม่ไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
        }
      });
      hideWinScreen();
    });
    $(document).on('click', '#winBackToLobby', function() {
      allowNavigation = true;
      window.location.href = '/room/' + roomId + '?playerId=' + playerId;
    });

  });
</script>

    function appendChatMessage(data, options) {
      const settings = options || {};
      const shouldStickToBottom = settings.forceScroll || isChatNearBottom();
      if (data.messageId && renderedMessageIds.has(data.messageId)) {
        return;
      }

      if (data.messageId) {
        renderedMessageIds.add(data.messageId);
      }

      const $area = $('#werewolfChatMessages');
      const safeName = escapeHtml(data.playerName);
      const safeMsg = escapeHtml(data.message);
      const timestamp = data.timestamp || '';
      const avatar = data.avatar || '👤';
      const isSystem = data.playerName === 'System';
      const isSelf = data.playerName === myPlayerName;
      const messageType = classifyMessageType(data);
      const chatGroup = classifyChatGroup(data);
      const channelBadge = getChatChannelBadge(messageType);
      const wrapperClass = isSystem ? 'system' : (isSelf ? 'self' : 'other');
      const decoratedName = isSystem ? '📣 System' : safeName;
      const replyBlock = data.replyTo
        ? `<div class="chat-reply-quote"><div class="reply-name">${escapeHtml(data.replyTo.name || 'ข้อความก่อนหน้า')}</div><div>${escapeHtml(data.replyTo.content || '')}</div></div>`
        : '';
      const canReply = !isSystem;
      const replyButton = canReply ? `<button class="chat-reply-btn" type="button" title="ตอบกลับ">↩</button>` : '';
      const swipeIndicator = canReply ? '<div class="swipe-reply-indicator">↪ ตอบกลับ</div>' : '';
      const avatarMarkup = isSystem ? '' : `<div class="chat-avatar">${avatar}</div>`;
      const nameColor = !isSystem && data.color ? data.color : '#f4f6fb';

      $area.append(`
        <div class="chat-message-wrapper ${wrapperClass} chat-group-${chatGroup}" data-message-id="${escapeHtml(data.messageId || '')}" data-player-name="${safeName}" data-message-text="${safeMsg}" data-chat-group="${chatGroup}">
          ${swipeIndicator}
          <div class="chat-message-row">
            ${avatarMarkup}
            <div class="chat-message-bubble message-${escapeHtml(messageType)}">
              ${replyBlock}
              <div class="chat-channel-badge ${escapeHtml(channelBadge.className)}">${escapeHtml(channelBadge.label)}</div>
              <div class="chat-message-name" style="color:${escapeHtml(nameColor)};">${decoratedName}</div>
              <div class="chat-message-body">${safeMsg}</div>
            </div>
            ${replyButton}
          </div>
          <div class="chat-message-meta">${escapeHtml(timestamp)}</div>
        </div>
      `);

      applyChatFilter();

      if (shouldStickToBottom) {
        scrollChatToBottom();
      }

      if (!settings.silent && !isSelf) {
        playSound('chat');
      }
    }

    function renderInitialChatHistory() {
      $('#werewolfChatMessages').empty();
      renderedMessageIds.clear();
      (initialChatHistory || []).forEach(function(entry) {
        const entryType = classifyMessageType(entry);
        if (currentState.phase !== 'lobby' && entry.playerName === 'System' && entryType === 'presence') {
          return;
        }

        appendChatMessage(entry, { silent: true });
      });

      syncWolfChatFilterVisibility(currentState);
      applyChatFilter();
    }

    function submitNightAction(actionType, targetPlayerId) {
      if (currentState.phase !== 'night') {
        socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
        return;
      }
      if (pendingActionSubmission) {
        return;
      }
      setActionButtonsPending(true);
      socket.emit('werewolf_submitNightAction', { roomId: roomId, targetPlayerId: targetPlayerId, actionType: actionType }, function(response) {
        if (!response || !response.success) {
          setActionButtonsPending(false);
          Swal.fire({ icon: 'error', title: 'สั่ง action ไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
          return;
        }
        playActionSelectionSound(actionType, targetPlayerId);
      });
    }


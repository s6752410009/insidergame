<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }

  /* ===== PHASE TRANSITION OVERLAY ===== */
  .phase-transition-banner { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(7,10,18,0.72); backdrop-filter: blur(10px); opacity: 0; pointer-events: none; transition: opacity 0.45s ease; z-index: 1200; }
  .phase-transition-banner.visible { opacity: 1; pointer-events: auto; }
  .phase-transition-card { min-width: min(88vw, 420px); max-width: 92vw; padding: 32px 28px; border-radius: 24px; border: 1px solid rgba(255,255,255,0.18); background: linear-gradient(135deg, rgba(30,40,70,0.97), rgba(20,28,50,0.98)); box-shadow: 0 24px 60px rgba(0,0,0,0.6), 0 0 80px rgba(139,92,246,0.12); text-align: center; transform: translateY(18px) scale(0.96); transition: transform 0.55s ease, opacity 0.55s ease; }
  .phase-transition-banner.visible .phase-transition-card { transform: translateY(0) scale(1); }
  .phase-transition-title { font-family: 'Orbitron', sans-serif; font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 700; margin-bottom: 12px; color: #fff; text-shadow: 0 2px 12px rgba(139,92,246,0.4); }
  .phase-transition-subtitle { color: #e2e8f0; font-size: 1.1rem; line-height: 1.5; text-shadow: 0 1px 4px rgba(0,0,0,0.3); }

  .role-announce-banner { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(6, 10, 18, 0.78); backdrop-filter: blur(12px); opacity: 0; pointer-events: none; transition: opacity 0.35s ease; z-index: 1300; }
  .role-announce-banner.visible { opacity: 1; pointer-events: auto; }
  .role-announce-card { width: min(92vw, 520px); padding: 28px 24px; border-radius: 28px; border: 1px solid rgba(255,255,255,0.16); background: linear-gradient(160deg, rgba(18,24,44,0.98), rgba(28,37,68,0.98)); box-shadow: 0 28px 80px rgba(0,0,0,0.6), 0 0 90px rgba(96,165,250,0.15); text-align: center; transform: translateY(22px) scale(0.96); transition: transform 0.45s ease, opacity 0.45s ease; }
  .role-announce-banner.visible .role-announce-card { transform: translateY(0) scale(1); }
  .role-announce-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,0.08); color: #dbeafe; font-weight: 700; font-size: 0.86rem; margin-bottom: 14px; }
  .role-announce-name { font-family: 'Orbitron', sans-serif; font-size: clamp(1.5rem, 5vw, 2.15rem); font-weight: 700; color: #ffffff; margin-bottom: 10px; text-shadow: 0 6px 30px rgba(96,165,250,0.3); }
  .role-announce-team { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.08); color: #fde68a; font-weight: 700; margin-bottom: 14px; }
  .role-announce-desc { color: #e2e8f0; font-size: 1rem; line-height: 1.55; margin-bottom: 12px; }
  .role-announce-hint { padding: 12px 14px; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); color: #f8fafc; font-size: 0.96rem; line-height: 1.5; }

  /* ===== MOBILE-FIRST: full-viewport flex column ===== */
  .ww-page {
    font-family: 'Rajdhani', sans-serif;
    color: #f4f6fb;
    display: flex;
    flex-direction: column;
    height: 100svh;
    overflow: hidden;
  }

  /* -- top bar (mobile) -- */
  .ww-topbar { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 10px; background: linear-gradient(135deg, #0e121c, #171c2a); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .ww-topbar-info { min-width: 0; }
  .ww-topbar-title { font-family: 'Orbitron', sans-serif; font-size: 0.88rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ww-topbar-meta { font-size: 0.82rem; color: #cfd8eb; }
  .ww-topbar-actions { display: flex; gap: 6px; flex-shrink: 0; }
  .ww-topbar-btn { border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: rgba(255,255,255,0.05); color: #f4f6fb; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.78rem; padding: 6px 10px; cursor: pointer; white-space: nowrap; }
  .ww-topbar-btn.danger { background: linear-gradient(135deg, #c0392b, #7f1d1d); border: 0; }

  /* -- view switcher (mobile: 2 tabs Chat/Game) -- */
  .ww-view-switcher { flex-shrink: 0; display: flex; background: rgba(20,25,39,0.95); border-bottom: 1px solid rgba(255,255,255,0.04); }
  .ww-view-tab { flex: 1; border: 0; background: transparent; color: #8896b3; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.92rem; padding: 10px 0; cursor: pointer; text-align: center; border-bottom: 2px solid transparent; transition: color 0.2s, border-color 0.2s; }
  .ww-view-tab.active { color: #fff; border-bottom-color: #e74c3c; }
  .ww-view-tab .ww-tab-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; height: 18px; padding: 0 5px; margin-left: 4px; border-radius: 999px; background: #e74c3c; color: #fff; font-size: 0.68rem; font-weight: 700; vertical-align: middle; }

  /* -- mobile game panel (scrollable, shown when game tab active) -- */
  .ww-game-panel { display: none; flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 10px; }
  .ww-game-panel.active { display: flex; flex-direction: column; gap: 12px; }
  .ww-game-section { padding: 12px; border-radius: 14px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); }
  .ww-game-section-title { font-family: 'Orbitron', sans-serif; font-size: 0.92rem; font-weight: 700; margin: 0 0 8px; }
  .ww-game-links { display: flex; gap: 8px; }
  .ww-game-link { border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: rgba(255,255,255,0.04); color: #cfd8eb; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.82rem; padding: 6px 12px; cursor: pointer; }

  /* -- mobile winner bar (shows above chat/game when game ends) -- */
  .ww-mobile-winner { display: none; flex-shrink: 0; padding: 10px; background: linear-gradient(135deg, rgba(34,197,94,0.2), rgba(21,128,61,0.25)); border-bottom: 1px solid rgba(134,239,172,0.2); }
  .ww-mobile-winner.active { display: block; }
  .ww-mobile-winner-text { font-weight: 700; font-size: 1rem; text-align: center; margin-bottom: 8px; }
  .ww-mobile-winner-btns { display: flex; gap: 8px; justify-content: center; }
  .ww-mobile-winner-btns .werewolf-btn, .ww-mobile-winner-btns .ghost-btn { font-size: 0.88rem; padding: 8px 14px; }

  /* -- chat head (hidden on mobile, shows h3+pill on desktop) -- */
  .ww-chat-head { display: none; }

  /* -- chat/composer hidden when game tab is active -- */
  .ww-chat-view { display: contents; }
  .ww-chat-view.hidden { display: none; }

  /* -- filter tabs -- */
  .ww-filters { flex-shrink: 0; display: flex; gap: 6px; padding: 6px 10px; }
  .chat-tab { border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); color: #cfd8eb; border-radius: 999px; padding: 5px 12px; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.82rem; cursor: pointer; }
  .chat-tab.active { background: linear-gradient(135deg, rgba(37,99,235,0.26), rgba(29,78,216,0.18)); border-color: rgba(96,165,250,0.24); color: #fff; }

  /* -- chat messages -- */
  .ww-chat-scroll { flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 8px 10px; display: flex; flex-direction: column; gap: 6px; }

  /* -- composer -- */
  .ww-composer { flex-shrink: 0; padding: 8px 10px; padding-bottom: calc(8px + env(safe-area-inset-bottom, 0px)); background: rgba(14,18,28,0.96); border-top: 1px solid rgba(255,255,255,0.06); }
  .ww-reply-bar { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 10px; margin-bottom: 6px; border-radius: 10px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); }
  .ww-reply-bar-main { min-width: 0; }
  .ww-reply-bar-title { color: #f8d189; font-weight: 700; font-size: 0.86rem; }
  .ww-reply-bar-text { color: #c8d2e6; font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ww-reply-cancel { border: 0; background: transparent; color: #cdd5e5; font-size: 1.2rem; cursor: pointer; }
  .ww-input-row { display: flex; gap: 8px; align-items: flex-end; }
  .ww-input-row textarea { flex: 1; min-height: 38px; max-height: 80px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.12); background: rgba(10,15,25,0.9); color: #fff; padding: 8px 12px; font-family: 'Rajdhani', sans-serif; font-size: 0.92rem; resize: none; }
  .ww-input-row textarea:focus { outline: none; border-color: rgba(231,76,60,0.65); }
  .ww-send-btn { border: 0; border-radius: 10px; padding: 8px 16px; background: linear-gradient(135deg, #c0392b, #7f1d1d); color: #fff; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.92rem; cursor: pointer; white-space: nowrap; align-self: stretch; }

  /* -- desktop-only blocks: hidden on mobile -- */
  .ww-desktop-hero { display: none; }
  .ww-action-section { display: none; }

  /* -- desktop layout: on mobile, becomes a flex column for chat -- */
  .ww-desktop-layout { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; }
  .ww-desktop-layout > .ww-col-left { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; }
  .ww-desktop-layout > .ww-col-right { display: none; }
  .ww-chat-wrap { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; }
  .ww-chat-head { display: none; }

  /* ===== CHAT MESSAGE BUBBLES ===== */
  .chat-message-wrapper { position: relative; display: flex; flex-direction: column; gap: 2px; transition: transform 0.18s ease; }
  .chat-message-wrapper.self { align-items: flex-end; }
  .chat-message-wrapper.other { align-items: flex-start; }
  .chat-message-wrapper.system { align-items: center; }
  .chat-message-row { display: flex; align-items: flex-end; gap: 6px; max-width: min(88%, 560px); }
  .chat-message-wrapper.self .chat-message-row { flex-direction: row-reverse; }
  .chat-message-wrapper.system .chat-message-row { max-width: min(80%, 460px); justify-content: center; }
  .chat-avatar { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,0.08); flex-shrink: 0; font-size: 0.9rem; }
  .chat-message-bubble { min-width: 80px; max-width: 100%; padding: 8px 12px; border-radius: 14px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); }
  .chat-message-wrapper.self .chat-message-bubble { background: linear-gradient(135deg, rgba(37,99,235,0.3), rgba(29,78,216,0.22)); border-color: rgba(96,165,250,0.2); }
  .chat-message-wrapper.other .chat-message-bubble { background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03)); }
  .chat-message-wrapper.system .chat-message-bubble { min-width: 0; text-align: center; border-radius: 12px; padding: 6px 12px; }
  .chat-message-wrapper.system .chat-message-bubble.message-presence { background: linear-gradient(135deg, rgba(14,165,233,0.18), rgba(59,130,246,0.12)); border-color: rgba(125,211,252,0.18); }
  .chat-message-wrapper.system .chat-message-bubble.message-phase,
  .chat-message-wrapper.system .chat-message-bubble.message-history-night,
  .chat-message-wrapper.system .chat-message-bubble.message-history-day { background: linear-gradient(135deg, rgba(168,85,247,0.18), rgba(236,72,153,0.12)); border-color: rgba(216,180,254,0.16); }
  .chat-message-wrapper.system .chat-message-bubble.message-admin { background: linear-gradient(135deg, rgba(245,158,11,0.18), rgba(234,88,12,0.13)); border-color: rgba(253,224,71,0.14); }
  .chat-message-wrapper.system .chat-message-bubble.message-history-result,
  .chat-message-wrapper.system .chat-message-bubble.message-system { background: linear-gradient(135deg, rgba(34,197,94,0.16), rgba(20,184,166,0.1)); border-color: rgba(134,239,172,0.16); }
  .chat-message-name { font-weight: 700; font-size: 0.82rem; margin-bottom: 2px; }
  .chat-message-wrapper.system .chat-message-name { display: flex; justify-content: center; font-size: 0.78rem; }
  .chat-message-body { white-space: pre-wrap; word-break: break-word; font-size: 0.92rem; }
  .chat-message-meta { font-size: 0.72rem; color: #97a4bf; padding: 0 4px; }
  .chat-message-wrapper.self .chat-message-meta { text-align: right; }
  .chat-message-wrapper.system .chat-message-meta { text-align: center; }
  .chat-reply-btn { width: 26px; height: 26px; border: 0; border-radius: 999px; background: rgba(255,255,255,0.08); color: #dbe5ff; cursor: pointer; opacity: 0; transition: opacity 0.2s; flex-shrink: 0; font-size: 0.78rem; }
  .chat-reply-btn:focus-visible { opacity: 1; }
  .chat-reply-quote { margin-bottom: 6px; padding: 6px 8px; border-radius: 8px; border-left: 3px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); font-size: 0.82rem; }
  .chat-reply-quote .reply-name { font-weight: 700; margin-bottom: 1px; color: #f8d189; }
  .swipe-reply-indicator { position: absolute; left: -10px; top: 50%; transform: translate(-8px, -50%); opacity: 0; transition: opacity 0.18s; color: #f8d189; font-size: 0.9rem; pointer-events: none; }
  .chat-message-wrapper.swiping .swipe-reply-indicator,
  .chat-message-wrapper.swiped .swipe-reply-indicator { opacity: 1; transform: translate(0, -50%); }
  @media (hover: hover) { .chat-message-row:hover .chat-reply-btn { opacity: 1; } }
  @media (hover: none) { .chat-reply-btn { opacity: 0.7; } }

  /* ===== GAME-SPECIFIC SHARED ===== */
  .werewolf-btn, .action-btn, .ghost-btn { border: 0; border-radius: 10px; padding: 10px 16px; font-family: 'Rajdhani', sans-serif; font-weight: 700; cursor: pointer; color: #fff; }
  .werewolf-btn { background: linear-gradient(135deg, #c0392b, #7f1d1d); }
  .ghost-btn { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1); }
  .action-btn { background: linear-gradient(135deg, #2563eb, #1d4ed8); width: 100%; }
  .action-btn.reveal { background: linear-gradient(135deg, #d97706, #b45309); }
  .action-btn.selected { box-shadow: 0 0 0 2px rgba(255,255,255,0.16) inset; }
  .action-btn:disabled, .werewolf-btn:disabled, .ghost-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .history-row, .player-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; background: rgba(255,255,255,0.04); }
  .note-row { display: grid; gap: 8px; padding: 12px 13px; border-radius: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); }
  .note-row.note-empty { color: #aab4c8; }
  .note-row.note-seer { background: linear-gradient(135deg, rgba(79,70,229,0.18), rgba(59,130,246,0.08)); border-color: rgba(129,140,248,0.22); }
  .note-row.note-doctor { background: linear-gradient(135deg, rgba(5,150,105,0.18), rgba(16,185,129,0.08)); border-color: rgba(110,231,183,0.18); }
  .note-row.note-bodyguard { background: linear-gradient(135deg, rgba(234,179,8,0.18), rgba(245,158,11,0.08)); border-color: rgba(253,224,71,0.2); }
  .note-row.note-mayor { background: linear-gradient(135deg, rgba(249,115,22,0.18), rgba(234,88,12,0.08)); border-color: rgba(251,191,36,0.18); }
  .note-row.note-revealer { background: linear-gradient(135deg, rgba(244,114,182,0.18), rgba(236,72,153,0.08)); border-color: rgba(251,207,232,0.18); }
  .note-row.note-werewolf { background: linear-gradient(135deg, rgba(192,57,43,0.2), rgba(127,29,29,0.1)); border-color: rgba(248,113,113,0.2); }
  .note-row.note-villager { background: linear-gradient(135deg, rgba(34,197,94,0.16), rgba(20,184,166,0.08)); border-color: rgba(134,239,172,0.16); }
  .note-row.note-info { background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03)); }
  .note-row.note-alert { background: linear-gradient(135deg, rgba(239,68,68,0.18), rgba(220,38,38,0.08)); border-color: rgba(252,165,165,0.2); }
  .note-head { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .note-icon { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: rgba(255,255,255,0.1); font-size: 0.95rem; flex-shrink: 0; }
  .note-label { font-size: 0.83rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: #d8e2f5; }
  .note-body { color: #f5f7fc; line-height: 1.45; font-size: 0.98rem; }
  .note-body strong { color: #fff4c2; font-weight: 700; }
  .player-grid, .actions-grid, .note-grid, .target-grid { display: grid; gap: 8px; }
  .target-grid { grid-template-columns: 1fr; margin-top: 10px; }
  .target-card { padding: 10px; border-radius: 12px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); }
  .target-card-title { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
  .action-title { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
  .player-row.dead { opacity: 0.55; }
  .player-name-line { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .player-status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 999px; font-size: 0.82rem; background: rgba(255,255,255,0.06); }
  .player-status-badge.alive { color: #f8d189; }
  .player-status-badge.dead { color: #aab4c8; }
  .subtle { color: #aab4c8; }
  .highlight { color: #f8d189; }
  .winner-banner { margin-top: 12px; padding: 12px; border-radius: 12px; background: linear-gradient(135deg, rgba(34,197,94,0.18), rgba(21,128,61,0.24)); color: #dcfce7; font-weight: 700; }
  .winner-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
  .phase-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; background: rgba(231,76,60,0.15); color: #ffd4c7; font-weight: 700; font-size: 0.86rem; }
  .team-badge { display: inline-block; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,0.08); margin-bottom: 8px; }
  .role-name { font-size: 1.5rem; font-weight: 700; margin-bottom: 6px; }
  .note-inline { margin-top: 10px; display: grid; gap: 6px; }

  .ww-page.phase-lock .action-btn, .ww-page.phase-lock .werewolf-btn, .ww-page.phase-lock .ghost-btn, .ww-page.phase-lock textarea { pointer-events: none; opacity: 0.7; }

  /* ===== DESKTOP OVERRIDES (≥961px) ===== */
  .ww-card { background: linear-gradient(145deg, #141927, #1b2232); border: 1px solid rgba(255,255,255,0.06); border-radius: 20px; padding: 20px; box-shadow: 0 12px 28px rgba(0,0,0,0.25); }
  .ww-card h2, .ww-card h3 { margin-top: 0; font-family: 'Orbitron', sans-serif; }
  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px; background: rgba(255,255,255,0.08); color: #dde5f8; }
  .role-banner { margin-top: 14px; padding: 18px; border-radius: 18px; background: linear-gradient(135deg, rgba(192,57,43,0.15), rgba(52,73,94,0.22)); border: 1px solid rgba(255,255,255,0.08); }

  @media (min-width: 961px) {
    .ww-page { height: auto; overflow: visible; max-width: 1320px; margin: 24px auto; padding: 20px; }
    .ww-topbar { display: none; }
    .ww-view-switcher { display: none; }
    .ww-mobile-winner { display: none !important; }
    .ww-game-panel { display: none !important; }
    .ww-chat-view { display: contents !important; }
    .ww-desktop-hero { display: flex; justify-content: space-between; align-items: center; gap: 18px; margin-bottom: 24px; padding: 24px; border-radius: 22px; background: radial-gradient(circle at top left, rgba(192,57,43,0.35), transparent 34%), linear-gradient(135deg, #0e121c 0%, #171c2a 60%, #20283a 100%); border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 18px 46px rgba(0,0,0,0.35); }
    .ww-desktop-hero h1 { margin: 0 0 8px; font-family: 'Orbitron', sans-serif; font-size: 2rem; }
    .ww-desktop-layout { display: grid; grid-template-columns: 1.5fr 0.85fr; gap: 18px; flex: none; }
    .ww-desktop-layout > .ww-col-left { display: grid; gap: 18px; }
    .ww-desktop-layout > .ww-col-right { display: grid; gap: 18px; }

    /* Chat section becomes a card on desktop */
    .ww-chat-wrap { display: block; flex: none; background: linear-gradient(145deg, #141927, #1b2232); border: 1px solid rgba(255,255,255,0.06); border-radius: 20px; padding: 20px; box-shadow: 0 12px 28px rgba(0,0,0,0.25); }
    .ww-chat-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
    .ww-chat-head h3 { margin: 0; font-family: 'Orbitron', sans-serif; }
    .ww-filters { padding: 0; margin-bottom: 12px; }
    .ww-chat-scroll { flex: none; min-height: 480px; max-height: 56vh; padding: 8px 4px 8px 0; }
    .ww-composer { padding: 0; padding-top: 14px; border-top: 0; background: transparent; }
    .ww-input-row textarea { max-height: none; resize: vertical; padding: 12px 14px; border-radius: 12px; }

    .ww-action-section { display: block; }
  }
</style>

<!-- ===== PHASE TRANSITION OVERLAY ===== -->

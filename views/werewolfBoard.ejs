<%- contentFor('script') %>
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  $(function() {
    const socket = io();
    const roomId = '<%= room.roomId %>';
    const playerId = '<%= player.playerId %>';
    const myPlayerName = '<%= player.name %>';
    const isRoomAdmin = <%= room.admin === true ? 'true' : 'false' %>;
    let canUseAdminReveal = <%= (room.admin === true || room.isSiteAdmin) ? 'true' : 'false' %>;
    const initialChatHistory = <%- JSON.stringify(typeof chatHistory !== 'undefined' ? chatHistory : []) %>;
    let currentState = <%- JSON.stringify(typeof werewolfState !== 'undefined' ? werewolfState : {}) %>;
    let allowNavigation = false;
    let phaseCountdownInterval = null;
    let lastRenderedPhase = currentState.phase || null;
    let lastWarningKey = null;
    let activePhaseDeadline = currentState.phaseEndsAt || null;
    let wasHidden = false;
    let hasInitiallyConnected = false;
    let phaseTransitionTimeouts = [];
    let roleAnnouncementTimeout = null;
    let lastRoleAnnouncementKey = null;
    let audioContext = null;
    let ambientController = null;
    let audioUnlockBound = false;
    let pendingActionSubmission = false;
    let replyingTo = null;
    let gmToastTimeout = null;
    let currentChatFilter = 'all';
    let touchStartX = 0;
    let touchStartY = 0;
    let swipingWrapper = null;
    let currentMobileTargetAction = null; // { handlerName, actionType, targetIds: Set, selectedId, allowSkip }
    let selectedWitchNightActionType = null;
    let preferredDayTargetMode = null;
    const seenHistoryKeys = new Set();
    const renderedMessageIds = new Set();

    function activateViewportLock() {
      document.documentElement.classList.add('ww-active');
    }

    function escapeHtml(value) {
      return $('<div>').text(value || '').html();
    }

    function showGmToast(message, duration) {
      var $toast = $('#gmToast');
      $toast.text(message).addClass('visible');
      clearTimeout(gmToastTimeout);
      gmToastTimeout = setTimeout(function() {
        $toast.removeClass('visible');
      }, duration || 5000);
    }

    function syncPhaseTheme(phase) {
      var $shell = $('#werewolfShell');
      $shell.removeClass('phase-lobby phase-night phase-day-discussion phase-day-vote phase-finished');
      if (phase) {
        $shell.addClass('phase-' + phase);
      }
    }

    function getGmMessage(state) {
      var phase = state?.phase || 'lobby';
      var selfPlayer = (state?.players || []).find(function(p) { return p.isSelf; });
      var isAlive = !selfPlayer || selfPlayer.alive !== false;
      var nightActions = getActiveNightActions(state);
      var canActNight = nightActions.some(function(a) { return Array.isArray(a.targets) && (a.targets.length > 0 || a.allowSkip); });
      var dayActions = state?.actionState?.dayActions || {};

      if (phase === 'lobby') return '🏕️ รอผู้เล่นครบ แล้วเริ่มเกม!';
      if (phase === 'finished') {
        var w = state?.winner;
        if (w === 'village') return '🏡 ชาวบ้านชนะ! เล่นรอบใหม่?';
        if (w === 'werewolf') return '🐺 หมาป่าชนะ! เล่นรอบใหม่?';
        return '🏁 จบเกม!';
      }
      if (!isAlive) return '💀 คุณตายแล้ว — ดูเกมต่อได้';
      if (phase === 'night') return canActNight ? '🌙 กลางคืน — ถึงตาคุณแล้ว!' : '🌙 กลางคืน — รอทุกคนเล่นจบ';
      if (phase === 'day-discussion') return '☀️ เช้าแล้ว! คุยหาคนผิดกัน';
      if (phase === 'day-vote') return dayActions.canVote ? '🗳️ โหวต! เลือกคนที่สงสัย' : '🗳️ รอผลโหวต...';
      return '';
    }

    function roleEmoji(roleId) {
      const icons = {
        villager: '🙂',
        werewolf: '🐺',
        alphaWolf: '👑',
        mayor: '🎖️',
        bodyguard: '🛡️',
        seer: '🔮',
        doctor: '💉',
        witch: '🧙‍♀️',
        fool: '🤪',
        revealer: '💥'
      };

      return icons[roleId] || '🎭';
    }

    function phaseIcon(phase) {
      const icons = {
        lobby: '🏕️',
        night: '🌙',
        'day-discussion': '💬',
        'day-vote': '☀️',
        finished: '🏁'
      };

      return icons[phase] || '🎯';
    }

    function teamEmoji(team) {
      const icons = {
        village: '🏡',
        werewolf: '🐺',
        solo: '🎭'
      };

      return icons[team] || '🎭';
    }

    function teamLabel(team) {
      const labels = {
        village: 'ฝ่ายชาวบ้าน',
        werewolf: 'ฝ่ายหมาป่า',
        solo: 'บทเดี่ยว'
      };

      return labels[team] || (team || '-');
    }

    function getSeerResultBadgeLabel(resultCode) {
      if (resultCode === 'good') return 'ออร่าดี';
      if (resultCode === 'bad') return 'ออร่าไม่ดี';
      return 'ออร่าไม่ทราบ';
    }

    function getSeerResultBadgeClass(resultCode) {
      if (resultCode === 'good') return 'result-good';
      if (resultCode === 'bad') return 'result-bad';
      return 'result-unknown';
    }

    function buildSeerResultBadge(entry, options) {
      if (!entry) {
        return '';
      }

      var config = options || {};
      var resultCode = entry.resultCode || 'unknown';
      var badgeClass = getSeerResultBadgeClass(resultCode);
      var badgeLabel = getSeerResultBadgeLabel(resultCode);
      var dayLabel = entry.dayNumber ? 'คืน ' + entry.dayNumber : 'ผลล่าสุด';
      var targetName = escapeHtml(entry.targetName || 'เป้าหมาย');
      var badgeHtml = '<span class="seer-result-badge ' + badgeClass + '">' + escapeHtml(badgeLabel) + '</span>';
      var textHtml = '<span class="seer-result-inline"><span class="seer-result-day">' + escapeHtml(dayLabel) + '</span><strong class="seer-result-target">' + targetName + '</strong></span>';

      if (config.compact) {
        return '<span class="hint-seer-tag">' + badgeHtml + textHtml + '</span>';
      }

      return '<div class="seer-result-inline">' + badgeHtml + textHtml + '</div>';
    }

    function getRoomRoleSummaryItems() {
      const rolePlan = Array.isArray(currentState.rolePlan) ? currentState.rolePlan : [];
      const roleCatalog = Array.isArray(currentState.roleCatalog) ? currentState.roleCatalog : [];
      const roleMap = new Map();

      rolePlan.forEach(function(role) {
        if (!role || !role.id) {
          return;
        }

        const existing = roleMap.get(role.id);
        if (existing) {
          existing.count += 1;
          return;
        }

        roleMap.set(role.id, {
          id: role.id,
          thaiName: role.thaiName,
          team: role.team,
          description: role.description,
          count: 1
        });
      });

      if (!roleMap.size) {
        roleCatalog.filter(function(role) {
          return role.enabledInRoom;
        }).forEach(function(role) {
          roleMap.set(role.id, {
            id: role.id,
            thaiName: role.thaiName,
            team: role.team,
            description: role.description,
            count: 1
          });
        });
      }

      return Array.from(roleMap.values()).sort(function(left, right) {
        if (left.team === right.team) {
          return String(left.thaiName || '').localeCompare(String(right.thaiName || ''), 'th');
        }

        const order = { werewolf: 0, village: 1, solo: 2 };
        return (order[left.team] ?? 9) - (order[right.team] ?? 9);
      });
    }

    function buildRoomRoleSummaryHtml() {
      const items = getRoomRoleSummaryItems();
      if (!items.length) {
        return '<div class="room-role-card"><div class="room-role-card-body">ยังไม่พบบทที่เปิดใช้ในห้องนี้</div></div>';
      }

      return items.map(function(role) {
        const countLabel = role.count > 1 ? `มี ${role.count} ใบ` : 'มี 1 ใบ';
        return `
          <div class="room-role-card">
            <div class="room-role-card-head">
              <div class="room-role-card-title">${roleEmoji(role.id)} <span>${escapeHtml(role.thaiName || role.id)}</span></div>
              <div class="room-role-count">${escapeHtml(countLabel)}</div>
            </div>
            <div class="room-role-card-body">${escapeHtml(role.description || 'ไม่มีคำอธิบาย')}</div>
            <div class="room-role-card-body">🏁 ${escapeHtml(role.winCondition || 'ชนะตามเงื่อนไขของทีมตัวเอง')}</div>
            <div class="room-role-card-team">${teamEmoji(role.team)} ${escapeHtml(teamLabel(role.team))}</div>
          </div>
        `;
      }).join('');
    }

    function renderRoomRoleSummary() {
      const html = buildRoomRoleSummaryHtml();
      $('#roomRoleSummary').html(html);
      $('#mobileRoomRoleSummary').html(html);
      renderRoleStrip();
    }

    function renderRoleStrip() {
      const roleCatalog = Array.isArray(currentState.roleCatalog) ? currentState.roleCatalog : [];
      const activeCounts = new Map();
      const orderedRoleIds = ['werewolf', 'alphaWolf', 'seer', 'doctor', 'bodyguard', 'witch', 'fool', 'mayor', 'revealer'];

      (Array.isArray(currentState.rolePlan) ? currentState.rolePlan : []).forEach(function(role) {
        if (!role || !role.id) {
          return;
        }

        activeCounts.set(role.id, (activeCounts.get(role.id) || 0) + 1);
      });

      const roleById = new Map(roleCatalog.map(function(role) {
        return [role.id, role];
      }));
      const orderedCatalog = orderedRoleIds.map(function(roleId) {
        return roleById.get(roleId);
      }).filter(Boolean);

      const items = orderedCatalog.map(function(role) {
        return {
          id: role.id,
          thaiName: role.thaiName,
          team: role.team,
          count: activeCounts.get(role.id) || 0,
          active: activeCounts.has(role.id)
        };
      });

      if (!items.length) {
        $('#roleStrip').empty();
        $('#mobileInlineRoleStrip').empty();
        return;
      }

      var html = items.map(function(role) {
        var teamClass = role.team === 'werewolf' ? 'team-werewolf' : (role.team === 'solo' ? 'team-solo' : 'team-village');
        var stateClass = role.active ? 'is-active' : 'is-inactive';
        var statusLabel = role.active ? 'มีบทนี้ในเกม' : 'ไม่มีบทนี้ในเกม';
        return '<div class="role-strip-item ' + teamClass + ' ' + stateClass + '" title="' + escapeHtml((role.thaiName || role.id) + ' - ' + statusLabel) + '"><span class="rs-emoji">' + roleEmoji(role.id) + '</span></div>';
      }).join('');
      $('#roleStrip').html(html);
      $('#mobileInlineRoleStrip').html(html);
    }

    function roleActionHint(role) {
      if (!role || !role.id) {
        return 'อ่านบทของคุณให้ครบ แล้วรอระบบเริ่มเกม';
      }

      const hints = {
        villager: 'คุณไม่มีสกิลกดใช้ ให้โฟกัสการฟังแชท จับพิรุธ และโหวตคนที่น่าสงสัยที่สุดตอนกลางวัน',
        werewolf: 'คุณอยู่ฝั่งหมาป่า กลางคืนให้คุยกับทีมและเลือกเป้าหมายเมื่อระบบเปิดให้ลงมือ',
        alphaWolf: 'คุณเป็นหมาป่าฝั่งนำ โหวตล่ากลางคืนหนัก 2 เสียง และถ้า Seer ตรวจคุณจะขึ้นว่าไม่ทราบ',
        mayor: 'ตอนเช้าคุณกดเปิดตัวได้เอง ถ้าเปิดแล้วเสียงโหวตของคุณจะกลายเป็น 2 เสียง',
        bodyguard: 'กลางคืนคุณเลือกคุ้มกันผู้เล่นได้ 1 คน เลือกคนสำคัญที่ไม่อยากให้ถูกเก็บ',
        seer: 'กลางคืนคุณเลือกตรวจผู้เล่นได้ 1 คน แต่ผลจะเห็นแค่ ดี, ไม่ดี หรือ ไม่ทราบ',
        doctor: 'กลางคืนคุณเลือกช่วยผู้เล่นได้ 1 คน เพื่อกันการถูกกำจัด',
        witch: 'กลางคืนคุณมียาช่วยชีวิต 1 ครั้งไว้กันตายคืนนี้ และยาพิษ 1 ครั้ง ใช้ได้คืนละ 1 อย่างเท่านั้น',
        fool: 'คุณเป็นบทเดี่ยว หมาป่าฆ่าคุณไม่ได้ และถ้าถูกโหวตออกตอนกลางวันคุณจะชนะทันที',
        revealer: 'ตอนกลางวันคุณมีสกิลเปิดโปง 1 ครั้ง ใช้ได้ทั้งช่วงประชุมและช่วงโหวต เมื่อล็อกเป้าแล้วระบบจะรอจนหมดเวลาแล้วค่อยเฉลยว่าคุณเปิดโปงถูกหรือผิด ถ้าพลาดตอนเฉลยคุณจะล้มแทนเอง'
      };

      return hints[role.id] || 'ดูคำอธิบายบทของคุณ แล้วลงมือเมื่อถึงช่วงที่ระบบเปิดให้ใช้ความสามารถ';
    }

    function clearRoleAnnouncement() {
      if (roleAnnouncementTimeout) {
        clearTimeout(roleAnnouncementTimeout);
        roleAnnouncementTimeout = null;
      }
      $('#roleAnnouncementBanner').removeClass('visible');
    }

    function showRoleAnnouncement(state, onDone) {
      const role = state?.playerRole || {};

      if (!role.id) {
        if (typeof onDone === 'function') {
          onDone();
        }
        return;
      }

      clearRoleAnnouncement();
      $('#werewolfShell').addClass('phase-lock');
      $('#roleAnnouncementName').text(roleEmoji(role.id) + ' ' + (role.thaiName || 'ยังไม่เปิดเผยบทบาท'));
      $('#roleAnnouncementTeam').text(teamEmoji(role.team) + ' ' + (role.team || '-'));
      $('#roleAnnouncementDescription').text(role.description || 'บทของคุณถูกเปิดเผยแล้ว');
      $('#roleAnnouncementHint').text(roleActionHint(role));
      $('#roleAnnouncementBanner').addClass('visible');

      roleAnnouncementTimeout = setTimeout(function() {
        $('#roleAnnouncementBanner').removeClass('visible');
        roleAnnouncementTimeout = null;
        if (!$('#phaseTransitionBanner').hasClass('visible')) {
          $('#werewolfShell').removeClass('phase-lock');
        }
        if (typeof onDone === 'function') {
          onDone();
        }
      }, 4000);
    }

    function actionEmoji(actionType) {
      const icons = {
        'night-kill': '🐾',
        'seer-check': '🔮',
        'doctor-save': '💉',
        'bodyguard-protect': '🛡️',
        'witch-heal': '🧪',
        'witch-poison': '☠️',
        'witch-rest': '🔮',
        'mayor-reveal': '🎖️'
      };

      return icons[actionType] || '🎯';
    }

    function statusEmoji(alive) {
      return alive ? '✨' : '💀';
    }

    function getPlayerById(targetPlayerId) {
      return (currentState?.players || []).find(function(player) {
        return player.playerId === targetPlayerId;
      }) || null;
    }

    function getSelfPlayer() {
      return getPlayerById(playerId);
    }

    function describeTarget(targetPlayerId, fallbackLabel) {
      if (!targetPlayerId) {
        return fallbackLabel || 'เป้าหมาย';
      }

      if (targetPlayerId === '__skip__') {
        return 'ข้ามรอบนี้';
      }

      return getPlayerById(targetPlayerId)?.name || fallbackLabel || 'เป้าหมาย';
    }

    function getActiveNightActions(state) {
      return Array.isArray(state?.actionState?.nightActions)
        ? state.actionState.nightActions.filter(function(action) {
            return action && Object.prototype.hasOwnProperty.call(action, 'targets');
          })
        : [];
    }

    function isWitchNightActionType(actionType) {
      return actionType === 'witch-heal' || actionType === 'witch-poison';
    }

    function isWitchChoiceNight(actions) {
      return Array.isArray(actions)
        && actions.length > 1
        && actions.every(function(action) { return isWitchNightActionType(action?.type); });
    }

    function getPreferredNightAction(actions) {
      if (!Array.isArray(actions) || actions.length === 0) {
        return null;
      }

      if (!isWitchChoiceNight(actions)) {
        return actions[0];
      }

      const selectedAction = actions.find(function(action) {
        return action?.type === selectedWitchNightActionType;
      });
      if (selectedAction) {
        return selectedAction;
      }

      const preLockedAction = actions.find(function(action) {
        return !!action?.selectedTargetId;
      });
      return preLockedAction || null;
    }

    function syncSelectedWitchNightAction(state) {
      const actions = getActiveNightActions(state);
      if (!isWitchChoiceNight(actions)) {
        selectedWitchNightActionType = null;
        return;
      }

      const alreadySelected = actions.find(function(action) {
        return !!action?.selectedTargetId;
      });
      if (alreadySelected) {
        selectedWitchNightActionType = alreadySelected.type;
        return;
      }

      const stillValid = actions.some(function(action) {
        return action?.type === selectedWitchNightActionType;
      });
      if (!stillValid) {
        selectedWitchNightActionType = null;
      }
    }

    function buildWitchPotionSelector(actions) {
      if (!isWitchChoiceNight(actions)) {
        return '';
      }

      return `
        <div class="target-grid">
          ${actions.map(function(action) {
            const isSelected = action.type === selectedWitchNightActionType;
            const icon = action.type === 'witch-heal' ? '🧪' : '☠️';
            const badge = action.type === 'witch-heal' ? 'ยาช่วยชีวิต' : 'ยาพิษ';
            const theme = getActionTheme(action.type);
            return `
              <div class="target-card target-theme-${theme} ${isSelected ? 'target-selected' : 'target-card-actionable'}" onclick="selectWitchPotion('${action.type}')">
                <div class="target-card-particle-layer" aria-hidden="true"></div>
                <div class="target-card-head">
                  <div class="target-card-title">
                    <div class="target-card-avatar" style="background:rgba(255,255,255,0.08);">${icon}</div>
                    <div class="target-card-text">
                      <div class="target-card-name"><strong>${icon} ${escapeHtml(action.label || badge)}</strong></div>
                      <div class="target-card-meta"><span class="target-card-tag">เลือกยาก่อน แล้วค่อยเลือกคน</span></div>
                    </div>
                  </div>
                  <div class="target-card-status ${isSelected ? 'status-selected' : 'status-ready'}">${isSelected ? '✅ เลือกแล้ว' : '👆 เลือกยา'}</div>
                </div>
                <div class="target-card-body">
                  <div class="target-card-hint">${escapeHtml(action.description || '')}</div>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

    function hasLiveTurnFocus(state) {
      if (!state || state.winner) {
        return false;
      }

      const selfPlayer = (state.players || []).find(function(player) {
        return player.isSelf;
      });
      if (selfPlayer && selfPlayer.alive === false) {
        return false;
      }

      if (state.phase === 'night') {
        const nightStatus = state?.actionState?.nightStatus || {};
        return getActiveNightActions(state).some(function(action) {
          return Array.isArray(action.targets) && (action.targets.length > 0 || action.allowSkip);
        }) || Boolean(nightStatus.canSkip);
      }

      if (state.phase === 'day-discussion') {
        const discussion = state?.actionState?.discussionActions || {};
        return Boolean(discussion.canSkip || discussion.canRevealMayor || discussion.canReveal);
      }

      if (state.phase === 'day-vote') {
        const dayActions = state?.actionState?.dayActions || {};
        return Boolean(dayActions.canVote || dayActions.canReveal || dayActions.canRevealMayor);
      }

      return false;
    }

    function buildPhaseRecapModel(state) {
      const phase = state?.phase || 'lobby';
      const selfPlayer = (state?.players || []).find(function(player) {
        return player.isSelf;
      });
      const isAlive = !selfPlayer || selfPlayer.alive !== false;
      const nightActions = getActiveNightActions(state);
      const dayActions = state?.actionState?.dayActions || {};
      const daySummary = dayActions.dayVoteSummary || null;
      const discussion = state?.actionState?.discussionActions || {};
      const nightStatus = state?.actionState?.nightStatus || {};
      const morning = state?.morningAnnouncement || null;
      const dayResolution = state?.dayResolutionAnnouncement || null;
      const finalAnnouncement = morning || dayResolution || null;

      const model = {
        title: phase === 'finished' ? 'สรุปรอบ' : 'สถานะเกม',
        phaseText: phaseLabel(phase),
        kicker: phase === 'finished' ? 'จบรอบ' : 'สรุปสถานการณ์',
        tone: phase === 'finished' ? 'cinematic' : 'normal',
        sections: []
      };

      if (phase === 'night') {
        const canAct = nightActions.some(function(action) {
          return Array.isArray(action.targets) && (action.targets.length > 0 || action.allowSkip);
        });
        const canSkipNight = Boolean(nightStatus.canSkip || nightStatus.hasSkipped);
        model.sections = [
          {
            label: 'เมื่อกี้',
            body: dayResolution ? dayResolution.lead : (Number(state?.dayNumber || 1) === 1 ? 'เสียงในหมู่บ้านค่อย ๆ ดับลง คืนแรกกำลังเปิดฉาก' : 'เวลากลางวันปิดฉากแล้ว และความมืดกลับมาครอบหมู่บ้านอีกครั้ง')
          },
          {
            label: 'ทำอะไรได้',
            body: !isAlive
              ? 'ตายแล้ว ดูได้อย่างเดียว'
              : (canAct
                ? 'ถึงตาคุณแล้ว เลือกสกิลและตัดสินใจให้ทันก่อนหมดเวลา'
                : (canSkipNight
                  ? 'คืนนี้คุณไม่มีสกิลให้กดแล้ว ถ้าพร้อมก็ลงชื่อข้ามคืนได้'
                  : 'คืนนี้คุณไม่มีสกิลให้กด เหลือแค่รอฟังผลตอนเช้า'))
          },
          {
            label: 'เป้าหมาย',
            body: !isAlive
              ? 'เก็บข้อมูลจากแชทและสีหน้าคนในโต๊ะไว้ใช้ตอนเช้า'
              : (canAct
                ? 'ล็อกคำสั่งของคุณให้เรียบร้อย ก่อนเสียงนับถอยหลังจบลง'
                : (Number(nightStatus.skipNeeded || 0) > 0
                  ? `ตอนนี้มีคนกดข้ามคืนแล้ว ${Number(nightStatus.skipCount || 0)}/${Number(nightStatus.skipNeeded || 0)} คน`
                  : 'รอให้ทุกคนปิดคำสั่งของคืน แล้วค่อยเช็กข่าวตอนรุ่งเช้า'))
          }
        ];
        return model;
      }

      if (phase === 'day-discussion') {
        model.sections = [
          {
            label: 'เมื่อคืน',
            body: morning ? morning.lead : 'กลางคืนเพิ่งปิดฉาก และทุกคนกำลังรอฟังข่าวแรกของเช้านี้'
          },
          {
            label: 'ทำอะไรได้',
            body: !isAlive
              ? 'ตายแล้ว อ่านแชทได้อย่างเดียว'
              : (discussion.canSkip
                ? 'คุย เก็บพิรุธ และถ้าทั้งโต๊ะพร้อมก็ข้ามไปเปิดโหวตได้'
                : 'ตอนนี้ยังต้องคุยต่อไป รอให้วงประชุมเปิดทางไปสู่การโหวต')
          },
          {
            label: 'เป้าหมาย',
            body: !isAlive
              ? 'จับทิศทางของกระแสสงสัย ว่าโต๊ะกำลังจะเทไปทางใคร'
              : 'บีบวงผู้ต้องสงสัยให้แคบที่สุด ก่อนจะถึงเวลายกมือโหวต'
          }
        ];
        return model;
      }

      if (phase === 'day-vote') {
        const submittedWeight = Number(daySummary?.totalSubmittedVoteWeight || 0);
        const totalWeight = Number(daySummary?.totalVoteWeight || dayActions.totalVoteWeight || 0);
        const threshold = Number(dayActions.voteThreshold || 0);
        model.sections = [
          {
            label: 'เมื่อกี้',
            body: morning ? (morning.detail || morning.lead) : 'วงประชุมปิดลงแล้ว และตอนนี้ทุกเสียงมีผลทันที'
          },
          {
            label: 'ทำอะไรได้',
            body: !isAlive
              ? 'ดูผลโหวตสดได้ แต่โหวตไม่ได้'
              : (dayActions.canVote
                ? 'เลือกคนที่สงสัยที่สุด หรือจะเก็บเสียงไว้ด้วยการข้ามโหวตก็ได้'
                : 'คุณตัดสินใจแล้ว แต่ยังเปลี่ยนใจได้จนกว่าเวลาของวันจะหมด')
          },
          {
            label: 'เป้าหมาย',
            body: totalWeight > 0
              ? `ตอนนี้ลงคะแนนแล้ว ${submittedWeight}/${totalWeight} เสียง • ต้องถึง ${threshold} เสียงจึงจะลากใครออกได้`
              : 'ชั่งใจให้ดีว่าใครควรถูกลากออกจากหมู่บ้านในวันนี้'
          }
        ];
        return model;
      }

      if (phase === 'finished') {
        const winnerText = state?.winner === 'village'
          ? '🏡 ชาวบ้านชนะ!'
          : (state?.winner === 'werewolf' ? '🐺 หมาป่าชนะ!' : '🤪 คนบ้าชนะ!');
        model.sections = [
          {
            label: 'ผลรอบนี้',
            body: winnerText
          },
          {
            label: 'ช็อตตัดสิน',
            body: finalAnnouncement ? (finalAnnouncement.detail || finalAnnouncement.lead) : 'เกมจบตามเงื่อนไขชัยชนะของฝั่งที่เหลืออยู่'
          },
          {
            label: 'ทำอะไรต่อ',
            body: isRoomAdmin ? 'ถ้าจะเปิดล่าอีกรอบ กดเริ่มเกมใหม่ได้ทันที' : 'รอหัวหน้าห้องตัดสินใจว่าจะเปิดรอบถัดไปเมื่อไร'
          }
        ];
        return model;
      }

      model.sections = [
        {
          label: 'เมื่อกี้',
          body: 'กำลังจัดห้อง เตรียมเริ่ม Werewolf'
        },
        {
          label: 'ทำอะไรได้',
          body: 'เช็กบทที่เปิด แล้วรอเริ่มเกม'
        },
        {
          label: 'เป้าหมาย',
          body: 'เตรียมตัวก่อนเข้าคืนแรก'
        }
      ];
      return model;
    }

    function buildPhaseRecapHtml(state) {
      const recap = buildPhaseRecapModel(state);
      if (!recap || !Array.isArray(recap.sections) || recap.sections.length === 0) {
        return '';
      }

      return `
        <div class="phase-recap-card ${recap.tone === 'cinematic' ? 'recap-cinematic' : ''}">
          <div class="phase-recap-head">
            <div>
              <div class="phase-recap-kicker">📌 ${escapeHtml(recap.kicker || 'Phase Recap')}</div>
              <div class="phase-recap-title">${escapeHtml(recap.title || 'สรุปเฟส')}</div>
            </div>
            <div class="phase-recap-phase">${escapeHtml(recap.phaseText || '')}</div>
          </div>
          <div class="phase-recap-grid">
            ${recap.sections.map(function(section) {
              return `
                <div class="phase-recap-item">
                  <div class="phase-recap-label">${escapeHtml(section.label || '')}</div>
                  <div class="phase-recap-body">${escapeHtml(section.body || '-')}</div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    function decisionReceiptTone(actionType, locked) {
      if (locked) {
        return 'tone-lock';
      }
      if (actionType === 'day-vote' || actionType === 'discussion-skip') {
        return 'tone-vote';
      }
      if (actionType === 'night-kill' || actionType === 'witch-poison' || actionType === 'reveal-action') {
        return 'tone-heavy';
      }
      return 'tone-soft';
    }

    function buildDecisionReceiptItems(state) {
      const phase = state?.phase || 'lobby';
      const items = [];
      const nightStatus = state?.actionState?.nightStatus || {};
      const dayActions = state?.actionState?.dayActions || {};
      const discussion = state?.actionState?.discussionActions || {};

      if (phase === 'night') {
        getActiveNightActions(state).forEach(function(action) {
          if (!action?.selectedTargetId) {
            return;
          }

          const targetName = describeTarget(action.selectedTargetId, 'เป้าหมาย');
          const copyMap = {
            'night-kill': `คุณเลือกเหยื่อเป็น ${targetName} แล้ว`,
            'seer-check': `คุณเลือกตรวจ ${targetName} แล้ว`,
            'doctor-save': `คุณเลือกช่วย ${targetName} แล้ว`,
            'bodyguard-protect': `คุณเลือกคุ้มกัน ${targetName} แล้ว`,
            'witch-heal': action.selectedTargetId === '__skip__' ? 'คุณเลือกเก็บยาช่วยชีวิตไว้คืนนี้แล้ว' : `คุณเลือกใช้ยาช่วยชีวิตกัน ${targetName} คืนนี้แล้ว`,
            'witch-poison': action.selectedTargetId === '__skip__' ? 'คุณเลือกเก็บยาพิษไว้คืนนี้แล้ว' : `คุณเลือกใช้ยาพิษกับ ${targetName} แล้ว`
          };
          items.push({
            icon: actionEmoji(action.type),
            title: copyMap[action.type] || `คุณเลือก ${targetName} แล้ว`,
            caption: action.locked ? 'ระบบรับการตัดสินใจแล้ว และจะค้างไว้จนจบเฟสนี้' : 'ระบบรับอินพุตแล้ว ถ้ากติกาอนุญาตคุณยังเปลี่ยนเป้าได้',
            tone: decisionReceiptTone(action.type, action.locked)
          });
        });
        if (nightStatus.hasSkipped) {
          items.push({
            icon: '⏭️',
            title: 'คุณกดพร้อมข้ามกลางคืนแล้ว',
            caption: `ระบบนับคุณในฝั่งคนที่พร้อมจบกลางคืนทันที (${Number(nightStatus.skipCount || 0)}/${Number(nightStatus.skipNeeded || 0)})`,
            tone: decisionReceiptTone('discussion-skip', true)
          });
        }
      }

      if (phase === 'day-discussion') {
        if (discussion.hasSkipped) {
          items.push({
            icon: '⏭️',
            title: 'คุณกดพร้อมข้ามช่วงคุยแล้ว',
            caption: 'ระบบนับคุณในฝั่งคนที่พร้อมเปิดโหวตทันที',
            tone: decisionReceiptTone('discussion-skip', true)
          });
        }
        if (state?.playerRole?.id === 'mayor' && discussion.mayorRevealed) {
          items.push({
            icon: '🎖️',
            title: 'คุณเปิดตัวเป็นนายกแล้ว',
            caption: `เสียงโหวตของคุณตอนนี้หนัก ${discussion.currentVoteWeight || 2} เสียง`,
            tone: 'tone-lock'
          });
        }
      }

      if (phase === 'day-vote') {
        if (dayActions.selectedVoteTargetId) {
          const targetName = describeTarget(dayActions.selectedVoteTargetId, 'เป้าหมาย');
          items.push({
            icon: '🗳️',
            title: dayActions.selectedVoteTargetId === '__skip__'
              ? 'คุณเลือกข้ามโหวตรอบนี้แล้ว'
              : `คุณเลือกโหวต ${targetName} แล้ว`,
            caption: 'ระบบรับคะแนนของคุณแล้ว และทุกคนเห็นผลสดบนการ์ด',
            tone: decisionReceiptTone('day-vote', false)
          });
        }
        if (state?.playerRole?.id === 'mayor' && dayActions.mayorRevealed) {
          items.push({
            icon: '🎖️',
            title: 'คุณเปิดตัวเป็นนายกแล้ว',
            caption: `เสียงโหวตของคุณตอนนี้หนัก ${dayActions.currentVoteWeight || 2} เสียง`,
            tone: 'tone-lock'
          });
        }
        if (state?.playerRole?.id === 'revealer' && dayActions.revealUsed) {
          items.push({
            icon: '💥',
            title: 'คุณใช้สกิลเปิดโปงแล้ว',
            caption: 'สกิลนี้ถูกใช้ไปแล้วในรอบนี้',
            tone: 'tone-heavy'
          });
        }
        if (state?.playerRole?.id === 'revealer' && dayActions.pendingRevealTargetId) {
          const targetName = describeTarget(dayActions.pendingRevealTargetId, dayActions.pendingRevealTargetName || 'เป้าหมาย');
          items.push({
            icon: '🎯',
            title: `คุณล็อกเป้าเปิดโปง ${targetName} แล้ว`,
            caption: 'ระบบจะเก็บเป้านี้ไว้และเฉลยผลตอนหมดเวลาช่วงกลางวัน',
            tone: 'tone-lock'
          });
        }
      }

      if (phase === 'day-discussion' && state?.playerRole?.id === 'revealer' && discussion.pendingRevealTargetId) {
        const targetName = describeTarget(discussion.pendingRevealTargetId, discussion.pendingRevealTargetName || 'เป้าหมาย');
        items.push({
          icon: '🎯',
          title: `คุณล็อกเป้าเปิดโปง ${targetName} แล้ว`,
          caption: 'ระบบจะรอหมดเวลาหรือเข้าสรุปช่วงกลางวันก่อนเฉลยผล',
          tone: 'tone-lock'
        });
      }

      return items;
    }

    function buildDecisionReceiptHtml(state) {
      const items = buildDecisionReceiptItems(state);
      if (!items.length) {
        return '';
      }

      return `
        <div class="decision-receipt" aria-live="polite">
          <div class="decision-receipt-head">
            <div class="decision-receipt-title">สถานะของคุณ</div>
            <div class="decision-receipt-subtitle">ระบบรับคำสั่งแล้ว</div>
          </div>
          <div class="decision-receipt-list">
            ${items.map(function(item) {
              return `
                <div class="receipt-item ${escapeHtml(item.tone || 'tone-soft')}">
                  <div class="receipt-item-icon">${escapeHtml(item.icon || '✅')}</div>
                  <div class="receipt-item-body">
                    <div class="receipt-item-title">${escapeHtml(item.title || '-')}</div>
                    <div class="receipt-item-caption">${escapeHtml(item.caption || '')}</div>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    function buildSpectatorModeHtml(state) {
      const selfPlayer = (state?.players || []).find(function(player) {
        return player.isSelf;
      });
      if (!selfPlayer || selfPlayer.alive !== false || state?.winner) {
        return '';
      }

      const items = [
        { title: 'ดูอะไรได้บ้าง', body: 'ดูประกาศ แชทที่ระบบเปิดให้เห็น และตามจังหวะของแต่ละเฟสได้ต่อ' },
        { title: 'เห็นผลโหวตสด', body: 'ช่วงโหวตกลางวันคุณยังเห็นว่าใครลงให้ใคร และใครยังไม่ตัดสินใจ' },
        { title: 'ทำอะไรไม่ได้แล้ว', body: 'คุณใช้สกิล ส่งข้อความ และลงคะแนนไม่ได้ จังหวะนี้คือโหมดสังเกตการณ์เต็มตัว' }
      ];

      return `
        <div class="spectator-card">
          <div class="spectator-head">
            <div class="spectator-title">โหมดหลังตาย</div>
            <div class="spectator-pill">💀 Spectator</div>
          </div>
          <div class="spectator-grid">
            ${items.map(function(item) {
              return `
                <div class="spectator-item">
                  <div class="phase-recap-label">${escapeHtml(item.title)}</div>
                  <div class="phase-recap-body">${escapeHtml(item.body)}</div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    function getActionTheme(actionType) {
      const themeMap = {
        'night-kill': 'kill',
        'seer-check': 'seer',
        'doctor-save': 'protect',
        'bodyguard-protect': 'protect',
        'witch-heal': 'heal',
        'witch-poison': 'poison',
        'witch-rest': 'skip',
        'day-vote': 'vote',
        'reveal-action': 'reveal',
        'discussion-skip': 'skip'
      };

      return themeMap[actionType] || 'vote';
    }

    function getActionSelectionIcon(actionType, isSelected) {
      if (actionType === 'night-kill') return isSelected ? '🩸' : '🐾';
      if (actionType === 'seer-check') return isSelected ? '👁️' : '🔮';
      if (actionType === 'doctor-save') return isSelected ? '💚' : '💉';
      if (actionType === 'bodyguard-protect') return isSelected ? '🛡️' : '🪖';
      if (actionType === 'witch-heal') return isSelected ? '✨' : '🧪';
      if (actionType === 'witch-poison') return isSelected ? '☠️' : '🧪';
      if (actionType === 'reveal-action') return isSelected ? '💥' : '🎯';
      if (actionType === 'day-vote') return isSelected ? '🗳️' : '☀️';
      return isSelected ? '✅' : '👉';
    }

    function getActionSelectionLabel(actionType, isSelected, locked) {
      if (locked && !isSelected) {
        return 'ล็อกแล้ว';
      }

      if (isSelected) {
        if (actionType === 'night-kill') return 'ขย้ำเป้าหมายนี้';
        if (actionType === 'seer-check') return 'คืนนี้จะตรวจคนนี้';
        if (actionType === 'doctor-save') return 'คืนนี้จะช่วยคนนี้';
        if (actionType === 'bodyguard-protect') return 'คืนนี้จะคุ้มกันคนนี้';
        if (actionType === 'witch-heal') return 'ใช้ยาช่วยชีวิตกับคนนี้';
        if (actionType === 'witch-poison') return 'ใช้ยาพิษใส่คนนี้';
        if (actionType === 'reveal-action') return 'ล็อกเป้าเปิดโปงคนนี้';
        if (actionType === 'day-vote') return 'คุณโหวตคนนี้อยู่';
        return 'เลือกคนนี้แล้ว';
      }

      if (actionType === 'night-kill') return 'แตะเพื่อเลือกเป็นเหยื่อ';
      if (actionType === 'seer-check') return 'แตะเพื่อตรวจออร่า';
      if (actionType === 'doctor-save') return 'แตะเพื่อช่วยชีวิต';
      if (actionType === 'bodyguard-protect') return 'แตะเพื่อคุ้มกัน';
      if (actionType === 'witch-heal') return 'แตะเพื่อกันตายคนนี้คืนนี้';
      if (actionType === 'witch-poison') return 'แตะเพื่อวางยาคนนี้';
      if (actionType === 'reveal-action') return 'แตะเพื่อล็อกเป้าเปิดโปง';
      if (actionType === 'day-vote') return 'แตะเพื่อเทคะแนนให้คนนี้';
      return 'แตะเพื่อเลือก';
    }

    function getActionSoundType(actionType, targetPlayerId) {
      if (targetPlayerId === '__skip__') {
        return 'action-skip';
      }

      const soundMap = {
        'night-kill': 'action-kill',
        'seer-check': 'action-seer',
        'doctor-save': 'action-protect',
        'bodyguard-protect': 'action-protect',
        'witch-heal': 'action-heal',
        'witch-poison': 'action-poison',
        'day-vote': 'action-vote',
        'reveal-action': 'action-reveal',
        'discussion-skip': 'action-skip',
        'mayor-reveal': 'action-mayor'
      };

      return soundMap[actionType] || 'action-confirm';
    }

    function getActionAccentColor(actionType) {
      const accentMap = {
        'night-kill': 'rgba(248, 113, 113, 0.72)',
        'seer-check': 'rgba(165, 180, 252, 0.72)',
        'doctor-save': 'rgba(52, 211, 153, 0.72)',
        'bodyguard-protect': 'rgba(253, 224, 71, 0.72)',
        'witch-heal': 'rgba(110, 231, 183, 0.72)',
        'witch-poison': 'rgba(251, 191, 36, 0.72)',
        'day-vote': 'rgba(96, 165, 250, 0.72)',
        'reveal-action': 'rgba(244, 114, 182, 0.72)',
        'discussion-skip': 'rgba(148, 163, 184, 0.68)',
        'action-skip': 'rgba(148, 163, 184, 0.68)',
        'mayor-reveal': 'rgba(251, 191, 36, 0.72)'
      };

      return accentMap[actionType] || 'rgba(250, 204, 21, 0.72)';
    }

    function triggerActionCardHaptic(actionType) {
      if (!navigator.vibrate) {
        return;
      }

      const vibrationMap = {
        'night-kill': [18, 24, 36],
        'seer-check': [16],
        'doctor-save': [14, 18, 14],
        'bodyguard-protect': [20, 14, 20],
        'witch-heal': [12, 20, 12],
        'witch-poison': [14, 28],
        'day-vote': [18],
        'reveal-action': [26, 20, 30],
        'discussion-skip': [10],
        'action-skip': [10],
        'mayor-reveal': [18, 22]
      };

      navigator.vibrate(vibrationMap[actionType] || [16]);
    }

    function spawnActionParticles(cardElement, actionType) {
      const layer = cardElement ? cardElement.querySelector('.target-card-particle-layer') : null;
      if (!layer) {
        return;
      }

      const accent = getActionAccentColor(actionType);
      const shape = actionType === 'night-kill' ? 'shape-drop' : (actionType === 'seer-check' ? 'shape-ring' : '');
      layer.innerHTML = '';

      for (let index = 0; index < 7; index += 1) {
        const particle = document.createElement('span');
        const angle = (-58 + (index * 19)) * (Math.PI / 180);
        const radius = 22 + (index * 5);
        particle.className = `target-card-particle ${shape}`.trim();
        particle.style.setProperty('--particle-color', accent);
        particle.style.setProperty('--particle-left', `${24 + ((index % 4) * 18)}%`);
        particle.style.setProperty('--particle-top', `${28 + ((index % 3) * 17)}%`);
        particle.style.setProperty('--particle-size', `${index % 3 === 0 ? 14 : 10}px`);
        particle.style.setProperty('--particle-x', `${Math.cos(angle) * radius}px`);
        particle.style.setProperty('--particle-y', `${Math.sin(angle) * radius}px`);
        particle.style.animationDelay = `${index * 24}ms`;
        layer.appendChild(particle);
      }

      window.setTimeout(function() {
        layer.innerHTML = '';
      }, 760);
    }

    function triggerActionCardFeedback(cardElement, actionType) {
      if (!cardElement) {
        return;
      }

      cardElement.style.setProperty('--target-accent', getActionAccentColor(actionType));
      cardElement.classList.remove('feedback-burst');
      void cardElement.offsetWidth;
      cardElement.classList.add('feedback-burst');
      spawnActionParticles(cardElement, actionType);
      triggerActionCardHaptic(actionType);
      window.setTimeout(function() {
        cardElement.classList.remove('feedback-burst');
      }, 580);
    }

    function playActionSelectionSound(actionType, targetPlayerId) {
      playSound(getActionSoundType(actionType, targetPlayerId));
    }

    function isMobileLayout() {
      return window.matchMedia('(max-width: 960px)').matches;
    }

    function syncViewportHeight() {
      const viewport = window.visualViewport;
      const height = viewport ? Math.round(viewport.height) : window.innerHeight;
      const keyboardOffset = viewport ? Math.max(0, Math.round(window.innerHeight - viewport.height - viewport.offsetTop)) : 0;
      document.documentElement.style.setProperty('--ww-app-height', height + 'px');
      document.documentElement.style.setProperty('--ww-keyboard-offset', keyboardOffset + 'px');

      const isKeyboardOpen = keyboardOffset > 120 || (viewport ? (window.innerHeight - viewport.height) > 140 : false);
      $('#werewolfShell').toggleClass('keyboard-open', isKeyboardOpen);

      if (isKeyboardOpen && !$('#mobileGamePanel').hasClass('active')) {
        window.requestAnimationFrame(function() {
          scrollChatToBottom();
        });
      }
    }

    function buildPhaseHudModel(state) {
      const recap = buildPhaseRecapModel(state);
      const sections = recap?.sections || [];
      const phase = state?.phase || 'lobby';
      const dayNumber = Number(state?.dayNumber || 0);
      const dayActions = state?.actionState?.dayActions || {};
      const daySummary = dayActions.dayVoteSummary || null;
      const discussion = state?.actionState?.discussionActions || {};
      const nightStatus = state?.actionState?.nightStatus || {};
      const canAct = hasLiveTurnFocus(state);
      let metaText = dayNumber > 0 ? `วันที่ ${dayNumber}` : 'ก่อนเริ่มเกม';

      if (phase === 'night' && Number(nightStatus.totalAlive || 0) > 0) {
        metaText += ` • พร้อมข้าม ${nightStatus.skipCount || 0}/${nightStatus.skipNeeded || 0}`;
      } else if (phase === 'day-vote' && daySummary) {
        metaText += ` • คะแนนนำ ${daySummary.leadingVoteWeight || 0}/${dayActions.voteThreshold || 0}`;
      } else if (phase === 'day-discussion' && Number(discussion.totalAlive || 0) > 0) {
        metaText += ` • พร้อมข้าม ${discussion.skipCount || 0}/${discussion.totalAlive || 0}`;
      } else if (canAct) {
        metaText += ' • ถึงตาคุณ';
      }

      return {
        title: `${phaseIcon(phase)} ${phaseLabel(phase)}`,
        current: sections[1]?.body || 'รอระบบอัปเดตสถานะของเกม',
        past: sections[0]?.body || 'รอข้อมูล',
        now: sections[1]?.body || 'รอข้อมูล',
        goal: sections[2]?.body || 'รอข้อมูล',
        timer: formatCountdown(state?.phaseEndsAt || null),
        meta: metaText,
        kicker: canAct ? '🎯 ถึงตา!' : (state?.winner ? '🏁 จบ!' : '📍 สถานะ')
      };
    }

    function buildPhaseStatusStripModel(state) {
      const phase = state?.phase || 'lobby';
      const players = Array.isArray(state?.players) ? state.players : [];
      const selfPlayer = players.find(function(player) {
        return player.isSelf;
      });
      const isAlive = !selfPlayer || selfPlayer.alive !== false;
      const aliveCount = players.filter(function(player) {
        return player.alive !== false;
      }).length;
      const totalPlayers = players.length;
      const canAct = hasLiveTurnFocus(state);
      const discussion = state?.actionState?.discussionActions || {};
      const dayActions = state?.actionState?.dayActions || {};
      const daySummary = dayActions.dayVoteSummary || null;
      const nightStatus = state?.actionState?.nightStatus || {};
      const nightActions = getActiveNightActions(state);
      const actionableNightActions = nightActions.filter(function(action) {
        return Array.isArray(action.targets) && (action.targets.length > 0 || action.allowSkip);
      });

      let tone = canAct ? 'tone-turn' : 'tone-watch';
      let kicker = canAct ? 'ถึงตาคุณ!' : 'จับตาดู';
      let headline = 'ดูที่นั่งผู้เล่น ตามจังหวะโต๊ะ';
      let detail = 'ยังไม่มีปุ่มให้กด ดูที่นั่งแล้วตามข่าวจากระบบ';
      let primaryLabel = '🎯 เปิดสกิล';
      let primaryTarget = 'actions';
      let secondaryLabel = '👥 ดูที่นั่ง';
      let secondaryTarget = 'players';

      if (state?.winner) {
        tone = 'tone-lock';
        kicker = 'จบรอบ!';
        headline = 'ดูผลรอบนี้';
        detail = isRoomAdmin ? 'กดเริ่มรอบใหม่ได้เลย' : 'รอหัวหน้าห้องเริ่มรอบใหม่';
        primaryLabel = '🎯 ดูสรุป';
        primaryTarget = 'actions';
      } else if (!isAlive) {
        kicker = 'คุณตายแล้ว';
        headline = 'นั่งดูเกม ดูที่นั่งประกอบ';
        detail = phase === 'day-vote'
          ? 'ดูว่าเสียงโหวตไหลไปทางไหน'
          : 'ตามข่าวแล้วอ่านเกมจากที่นั่ง';
        primaryLabel = '👥 ดูที่นั่ง';
        primaryTarget = 'players';
        secondaryLabel = '🎯 ดูสรุป';
        secondaryTarget = 'actions';
      } else if (phase === 'night') {
        if (actionableNightActions.length > 0) {
          const firstNightAction = actionableNightActions[0];
          headline = 'เลือกเป้าหมายกลางคืน!';
          detail = `ล็อก ${firstNightAction.label} ก่อนหมดเวลา`;
          primaryLabel = `🎯 ${firstNightAction.label}`;
        } else if (nightStatus.canSkip || nightStatus.hasSkipped) {
          headline = 'คืนนี้ไม่มีสกิล กดพร้อมข้ามได้';
          detail = `พร้อมข้าม ${Number(nightStatus.skipCount || 0)}/${Number(nightStatus.skipNeeded || 0)} คน`;
          primaryLabel = nightStatus.hasSkipped ? '✅ พร้อมแล้ว' : '⏭️ พร้อมข้าม';
        } else {
          kicker = 'ไม่มีสกิลคืนนี้';
          headline = 'ดูที่นั่ง เตรียมข้อมูลไว้สำหรับเช้า';
          detail = 'คืนนี้ไม่มีปุ่มให้กด ดูว่าใครยังอยู่แล้วเตรียมคุย';
          primaryLabel = '👥 ดูที่นั่ง';
          primaryTarget = 'players';
          secondaryLabel = '🎯 ดูสรุปคืน';
          secondaryTarget = 'actions';
        }
      } else if (phase === 'day-discussion') {
        if (discussion.canReveal) {
          headline = 'ประชุมอยู่ แต่เปิดโปงได้แล้ว';
          detail = 'เลือกเป้าหมายได้ตั้งแต่ช่วงประชุม ล็อกไว้ก่อน แล้วระบบจะเฉลยผลตอนหมดเวลา';
          primaryLabel = '💥 เปิดโปง';
        } else if (discussion.pendingRevealTargetId) {
          headline = 'ล็อกเป้าเปิดโปงไว้แล้ว';
          detail = 'รอหมดเวลาแล้วระบบจะเฉลยผลให้อัตโนมัติ';
          primaryLabel = '🎯 ดูเป้า';
        } else if (discussion.canSkip || discussion.canRevealMayor) {
          headline = 'คุย จับพิรุธ กดข้ามเมื่อพร้อม';
          detail = discussion.canRevealMayor
            ? 'เปิดบทนายกหรือกดข้ามไปโหวตเมื่อทุกคนพร้อม'
            : 'หาเป้าหมาย แล้วกดข้ามไปโหวตได้';
          primaryLabel = discussion.canRevealMayor ? '🎯 เปิดปุ่ม' : '🎯 กดข้าม / สกิล';
        } else {
          headline = 'ช่วงประชุม ดูที่นั่งจับพิรุธ';
          detail = 'ปุ่มถูกกดแล้วหรือยังไม่เปิด ดูที่นั่งตามคนน่าสงสัย';
          primaryLabel = '👥 ดูที่นั่ง';
          primaryTarget = 'players';
          secondaryLabel = '🎯 ดูสถานะ';
          secondaryTarget = 'actions';
        }
      } else if (phase === 'day-vote') {
        const completedVotes = Number(daySummary?.totalCompletedDecisions || dayActions.completedVotes || 0);
        const totalVoters = Number(daySummary?.totalAlive || dayActions.totalVoters || 0);
        const leadingVoteWeight = Number(daySummary?.leadingVoteWeight || 0);
        const voteThreshold = Number(dayActions.voteThreshold || 0);
        if (dayActions.canVote) {
          headline = 'เลือกคนจากที่นั่ง แล้วลงคะแนน!';
          detail = dayActions.selectedVoteTargetId
            ? `กำลังเล็ง ${describeTarget(dayActions.selectedVoteTargetId, 'เป้าหมาย')} อยู่ เปลี่ยนใจได้`
            : 'ดูที่นั่งแล้วแตะคนที่สงสัย';
          primaryLabel = '🗳️ โหวต';
        } else if (dayActions.canReveal) {
          headline = 'ยังเปิดโปงได้ แม้อยู่ช่วงโหวต';
          detail = 'สลับเป็นโหมดเปิดโปงแล้วแตะที่นั่งเป้าหมายเพื่อ ล็อกเป้า รอเฉลยตอนหมดเวลา';
          primaryLabel = '💥 เปิดโปง';
        } else if (dayActions.pendingRevealTargetId) {
          headline = 'ล็อกเป้าเปิดโปงไว้แล้ว';
          detail = 'ตอนนี้รอเพียงหมดเวลาเพื่อเฉลยผลว่าคุณเลือกถูกหรือผิด';
          primaryLabel = '🎯 ดูเป้า';
        } else {
          tone = 'tone-lock';
          kicker = 'ล็อกแล้ว';
          headline = `คะแนนนำ ${leadingVoteWeight}/${voteThreshold}`;
          detail = totalVoters > 0 ? `ตัดสินใจแล้ว ${completedVotes}/${totalVoters} คน และยังเปลี่ยนใจได้` : 'เปลี่ยนใจได้จนกว่าหมดเวลา';
          primaryLabel = '👥 ดูที่นั่ง';
          primaryTarget = 'players';
          secondaryLabel = '🎯 ดูสถานะ';
          secondaryTarget = 'actions';
        }
      }

      const chips = [
        `<div class="phase-status-chip">👤 <strong>${isAlive ? (canAct ? 'ถึงตา' : 'มีชีวิต') : 'ตาย'}</strong></div>`,
        `<div class="phase-status-chip">👥 <strong>${aliveCount}/${totalPlayers || 0}</strong> รอด</div>`
      ];

      if (phase === 'night') {
        chips.push(`<div class="phase-status-chip">🌙 <strong>${actionableNightActions.length > 0 ? `${actionableNightActions.length} สกิล` : 'รอเช้า'}</strong></div>`);
        if (Number(nightStatus.skipNeeded || 0) > 0) {
          chips.push(`<div class="phase-status-chip">⏭️ พร้อม <strong>${Number(nightStatus.skipCount || 0)}/${Number(nightStatus.skipNeeded || 0)}</strong></div>`);
        }
      } else if (phase === 'day-discussion') {
        chips.push(`<div class="phase-status-chip">💬 ข้าม <strong>${Number(discussion.skipCount || 0)}/${Number(discussion.totalAlive || 0)}</strong></div>`);
      } else if (phase === 'day-vote') {
        chips.push(`<div class="phase-status-chip">🗳️ คะแนนนำ <strong>${Number(daySummary?.leadingVoteWeight || 0)}/${Number(dayActions.voteThreshold || 0)}</strong></div>`);
      } else if (state?.winner) {
        chips.push(`<div class="phase-status-chip">🏁 <strong>จบ</strong></div>`);
      }

      return {
        tone: tone,
        kicker: kicker,
        headline: headline,
        detail: detail,
        primaryLabel: primaryLabel,
        primaryTarget: primaryTarget,
        secondaryLabel: secondaryLabel,
        secondaryTarget: secondaryTarget,
        chipsHtml: chips.join('')
      };
    }


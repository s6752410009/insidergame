    window.addEventListener('pagehide', function() {
      if (allowNavigation) {
        return;
      }

      sessionStorage.setItem('werewolfHiddenTime', Date.now().toString());
    });

    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'hidden') {
        wasHidden = true;
        sessionStorage.setItem('werewolfHiddenTime', Date.now().toString());
        return;
      }

      if (!wasHidden) {
        return;
      }

      wasHidden = false;
      // Full rebind on return from background to re-establish socket room membership
      if (socket.connected) {
        bindRoom();
      }
    });

    socket.on('werewolfState', function(state) {
      setActionButtonsPending(false);
      renderState(state);
    });

    socket.on('roomUpdate', function(payload) {
      if (!payload || !payload.players) {
        return;
      }

      $('#onlineCount').text(payload.playerCount || payload.onlineCount || payload.players.filter(function(player) { return player.online; }).length);

      const mergedPlayers = (currentState.players || []).map(function(player) {
        const roomPlayer = payload.players.find(function(candidate) {
          return candidate.playerId === player.playerId;
        });
        return roomPlayer ? { ...player, name: roomPlayer.displayName || roomPlayer.playerName } : player;
      });

      const selfRoomPlayer = payload.players.find(function(player) {
        return player.playerId === playerId;
      });
      canUseAdminReveal = Boolean((payload.admin && payload.admin === playerId) || (selfRoomPlayer && selfRoomPlayer.isSiteAdmin));

      renderState({ ...currentState, players: mergedPlayers });
    });

    socket.on('newMessage', function(data) {
      appendChatMessage(data);

  .target-card.target-theme-skip { background: linear-gradient(145deg, rgba(71,85,105,0.35), rgba(15,23,42,0.84)); }
  .target-card-head { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }

  .chat-message-bubble.message-wolf-team { background: linear-gradient(135deg, rgba(127,29,29,0.42), rgba(69,10,10,0.58)); border-color: rgba(248,113,113,0.26); box-shadow: 0 0 0 1px rgba(248,113,113,0.08) inset; }

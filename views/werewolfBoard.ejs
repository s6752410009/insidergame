    .target-card.target-card-actionable:hover { transform: none; border-color: rgba(255,255,255,0.08); box-shadow: none; }
  }
  .target-card.target-selected { border-color: rgba(250,204,21,0.55); box-shadow: 0 0 0 1px rgba(250,204,21,0.22), 0 18px 36px rgba(0,0,0,0.28); animation: targetCardSelectedPulse 1.6s ease-in-out infinite; }
  .target-card.target-disabled { opacity: 0.56; filter: grayscale(0.12); }

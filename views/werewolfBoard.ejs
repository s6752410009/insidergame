  .note-row.note-alert { background: linear-gradient(135deg, rgba(239,68,68,0.18), rgba(220,38,38,0.08)); border-color: rgba(252,165,165,0.2); }
  .note-head { display: flex; align-items: center; gap: 8px; min-width: 0; }

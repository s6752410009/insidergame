    function appendChatMessage(data, options) {
      const settings = options || {};
      const shouldStickToBottom = settings.forceScroll || isChatNearBottom();
      if (data.messageId && renderedMessageIds.has(data.messageId)) {
        return;
      }

      if (data.messageId) {
        renderedMessageIds.add(data.messageId);
      }

      const $area = $('#werewolfChatMessages');
      const safeName = escapeHtml(data.displayName || data.playerName);
      const safeMsg = escapeHtml(data.message);
      const timestamp = data.timestamp || '';
      const avatar = data.avatar || '👤';
      const isSystem = data.playerName === 'System';
      const isSelf = (data.playerId && data.playerId === playerId) || data.playerName === myPlayerName;
      const messageType = classifyMessageType(data);
      const chatGroup = classifyChatGroup(data);
      const channelBadge = getChatChannelBadge(messageType);
      const wrapperClass = isSystem ? 'system' : (isSelf ? 'self' : 'other');
      const decoratedName = safeName;
      const replyBlock = data.replyTo
        ? `<div class="chat-reply-quote"><div class="reply-name">${escapeHtml(data.replyTo.name || 'ข้อความก่อนหน้า')}</div><div>${escapeHtml(data.replyTo.content || '')}</div></div>`
        : '';
      const canReply = !isSystem;
      const replyButton = canReply ? `<button class="chat-reply-btn" type="button" title="ตอบกลับ">↩</button>` : '';
      const swipeIndicator = canReply ? '<div class="swipe-reply-indicator">↪ ตอบกลับ</div>' : '';
      const avatarMarkup = isSystem ? '' : `<div class="chat-avatar">${avatar}</div>`;
      const nameColor = !isSystem && data.color ? data.color : '#f4f6fb';

      $area.append(`
        <div class="chat-message-wrapper ${wrapperClass} chat-group-${chatGroup}" data-message-id="${escapeHtml(data.messageId || '')}" data-player-name="${safeName}" data-message-text="${safeMsg}" data-chat-group="${chatGroup}">
          ${swipeIndicator}
          <div class="chat-message-row">
            ${avatarMarkup}
            <div class="chat-message-bubble message-${escapeHtml(messageType)}">
              ${replyBlock}
              <div class="chat-channel-badge ${escapeHtml(channelBadge.className)}">${escapeHtml(channelBadge.label)}</div>
              ${isSystem ? '' : `<div class="chat-message-name" style="color:${escapeHtml(nameColor)};">${decoratedName}</div>`}
              <div class="chat-message-body">${safeMsg}</div>
            </div>
            ${replyButton}
          </div>
          <div class="chat-message-meta">${escapeHtml(timestamp)}</div>
        </div>
      `);

      // Mirror to overlay chat
      var $overlayArea = $('#overlayChatMessages');
      if ($overlayArea.length) {
        $overlayArea.append($area.children().last().clone());
        applyChatFilterTo($overlayArea);
      }

      // Increment unread badge if overlay is closed
      if (!settings.silent && !isSelf && !$('#chatOverlay').hasClass('open')) {
        var badge = $('#chatFabBadge');
        var count = parseInt(badge.text()) || 0;
        badge.text(count + 1).addClass('active');
      }

      applyChatFilter();

      if (shouldStickToBottom) {
        scrollChatToBottom();
      }

      if (!settings.silent && !isSelf) {
        playSound('chat');
      }
    }

    function renderInitialChatHistory() {
      $('#werewolfChatMessages').empty();
      $('#overlayChatMessages').empty();
      renderedMessageIds.clear();
      (initialChatHistory || []).forEach(function(entry) {
        const entryType = classifyMessageType(entry);
        if (currentState.phase !== 'lobby' && entry.playerName === 'System' && entryType === 'presence') {
          return;
        }

        appendChatMessage(entry, { silent: true });
      });

      syncWolfChatFilterVisibility(currentState);
      applyChatFilter();
    }

    function submitNightAction(actionType, targetPlayerId) {
      if (currentState.phase !== 'night') {
        socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
        return;
      }
      if (pendingActionSubmission) {
        return;
      }
      setActionButtonsPending(true);
      socket.emit('werewolf_submitNightAction', { roomId: roomId, targetPlayerId: targetPlayerId, actionType: actionType }, function(response) {
        if (!response || !response.success) {
          setActionButtonsPending(false);
          Swal.fire({ icon: 'error', title: 'สั่ง action ไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
          return;
        }
        if (actionType === 'seer-check' && targetPlayerId !== '__skip__' && response.seerResult) {
          showSeerVisionResult(response.seerResult);
        }
        playActionSelectionSound(actionType, targetPlayerId);
      });
    }

    function submitDayVote(targetPlayerId) {
      if (currentState.phase !== 'day-vote') {
        socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
        return;
      }
      if (pendingActionSubmission) {
        return;
      }
      setActionButtonsPending(true);
      socket.emit('werewolf_submitDayVote', { roomId: roomId, targetPlayerId: targetPlayerId }, function(response) {
        if (!response || !response.success) {
          setActionButtonsPending(false);
          Swal.fire({ icon: 'error', title: 'โหวตไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
          return;
        }
        playActionSelectionSound('day-vote', targetPlayerId);
      });
    }

    function submitDiscussionSkip() {
      if (currentState.phase !== 'day-discussion') {
        socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
        return;
      }
      if (pendingActionSubmission) {
        return;
      }
      setActionButtonsPending(true);
      socket.emit('werewolf_skipDiscussion', { roomId: roomId, playerId: playerId }, function(response) {
        if (!response || !response.success) {
          setActionButtonsPending(false);
          Swal.fire({ icon: 'error', title: 'กดข้ามไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
          return;
        }
        playActionSelectionSound('discussion-skip', '__skip__');
      });
    }

    function submitNightSkip() {
      if (currentState.phase !== 'night') {
        socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
        return;
      }
      if (pendingActionSubmission) {
        return;
      }
      setActionButtonsPending(true);
      socket.emit('werewolf_skipNight', { roomId: roomId, playerId: playerId }, function(response) {
        if (!response || !response.success) {
          setActionButtonsPending(false);
          Swal.fire({ icon: 'error', title: 'กดข้ามไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
          return;
        }
        playActionSelectionSound('discussion-skip', '__skip__');
      });
    }

    function submitRevealAction(targetPlayerId) {
      if (currentState.phase !== 'day-discussion' && currentState.phase !== 'day-vote') {
        socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
        return;
      }
      if (pendingActionSubmission) {
        return;
      }
      setActionButtonsPending(true);
      preferredDayTargetMode = null;
      socket.emit('werewolf_useRevealAction', { roomId: roomId, targetPlayerId: targetPlayerId }, function(response) {
        if (!response || !response.success) {
          preferredDayTargetMode = 'reveal';
          setActionButtonsPending(false);
          Swal.fire({ icon: 'error', title: 'เปิดโปงไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
          return;
        }
        playActionSelectionSound('reveal-action', targetPlayerId);
      });
    }

    function submitMayorReveal() {
      if (currentState.phase !== 'day-discussion' && currentState.phase !== 'day-vote') {
        socket.emit('werewolf_requestState', { roomId: roomId, playerId: playerId });
        return;
      }
      if (pendingActionSubmission) {
        return;
      }
      setActionButtonsPending(true);
      socket.emit('werewolf_revealMayor', { roomId: roomId }, function(response) {
        if (!response || !response.success) {
          setActionButtonsPending(false);
          Swal.fire({ icon: 'error', title: 'เปิดเผยตัวไม่สำเร็จ', text: response?.error || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
          return;
        }
        playActionSelectionSound('mayor-reveal', playerId);
      });
    }

    function buildTargetCards(action, handlerName, buttonClass, handlerArg) {
      const targets = Array.isArray(action.targets) ? action.targets : [];
      if (targets.length === 0 && !action.allowSkip) {
        return '<div class="target-card subtle">ไม่มีเป้าหมายให้เลือก</div>';
      }

      const actionType = handlerArg || action.type || 'day-vote';
      const theme = getActionTheme(actionType);
      const voteTallies = action.voteTallies || {};
      const voteSummary = action.dayVoteSummary || null;
      const voteSummaryMap = new Map(((voteSummary && voteSummary.targets) || []).map(function(target) {
        return [target.playerId, target];
      }));

      const cards = targets.map(function(target) {
        const roomPlayer = getPlayerById(target.playerId) || {};
        const isSelected = action.selectedTargetId && action.selectedTargetId === target.playerId;
        const isDisabled = Boolean(action.locked && !isSelected);
        const targetSummary = voteSummaryMap.get(target.playerId) || null;
        const voteCount = Number(targetSummary?.count || voteTallies[target.playerId] || roomPlayer.voteCount || 0);
        const voterEntries = Array.isArray(targetSummary?.voters) ? targetSummary.voters : [];
        const selectionIcon = getActionSelectionIcon(actionType, isSelected);
        const selectionLabel = getActionSelectionLabel(actionType, isSelected, action.locked);
        const badges = [];

        if (roomPlayer.isSelf) {
          badges.push('<span class="target-card-badge badge-self">🫵 คุณ</span>');
        }
        if (roomPlayer.voteWeight > 1) {
          badges.push(`<span class="target-card-badge badge-weight">🎖️ เสียง ${roomPlayer.voteWeight}</span>`);
        }
        if (roomPlayer.revealedRole) {
          badges.push(`<span class="target-card-badge badge-revealed">🎭 ${escapeHtml(roomPlayer.revealedRole)}</span>`);
        }
        if (roomPlayer.alive === false) {
          badges.push('<span class="target-card-badge badge-dead">💀 ออกแล้ว</span>');
        }

        const statusClass = isSelected ? 'status-selected' : (action.locked ? 'status-locked' : 'status-ready');
        const statusIcon = isSelected ? selectionIcon : (action.locked ? '🔒' : actionEmoji(actionType));
        const votersHtml = voterEntries.length
          ? voterEntries.map(function(voter) {
              const weightedClass = voter.weight > 1 ? 'weighted' : '';
              const suffix = voter.weight > 1 ? ` x${voter.weight}` : '';
              return `<span class="target-card-voter-pill ${weightedClass}">${escapeHtml(voter.name)}${escapeHtml(suffix)}</span>`;
            }).join('')
          : '<span class="target-card-voter-pill empty">ยังไม่มีคนลงให้</span>';
        return `
          <div class="target-card target-theme-${theme} ${isSelected ? 'target-selected' : ''} ${isDisabled ? 'target-disabled' : ''} ${isDisabled ? '' : 'target-card-actionable'}" data-action-type="${escapeHtml(actionType)}" data-target-player-id="${escapeHtml(target.playerId)}" ${isDisabled ? '' : `onclick="${handlerName}(${handlerName === 'selectNightTarget' ? `'${actionType}', '${target.playerId}'` : `'${target.playerId}'`})"`}>
            <div class="target-card-particle-layer" aria-hidden="true"></div>
            <div class="target-card-head">
              <div class="target-card-title">
                <div class="target-card-avatar" style="background:${escapeHtml(roomPlayer.color || 'rgba(255,255,255,0.08)')};">${escapeHtml(roomPlayer.avatar || '👤')}</div>
                <div class="target-card-text">
                  <div class="target-card-name"><strong>${escapeHtml(target.name)}</strong></div>
                  <div class="target-card-meta">
                    <span class="target-card-tag">${roomPlayer.alive === false ? '💀 ออกจากเกมแล้ว' : '✨ ยังอยู่ในเกม'}</span>
                    ${voteCount > 0 ? `<span class="target-card-votes">🗳️ ${voteCount} โหวต</span>` : ''}
                  </div>
                </div>
              </div>
              <div class="target-card-status ${statusClass}">${statusIcon} ${escapeHtml(isSelected ? 'เลือกแล้ว' : (action.locked ? 'ล็อกแล้ว' : 'พร้อมเลือก'))}</div>
            </div>
            <div class="target-card-body">
              ${badges.length ? `<div class="target-card-meta">${badges.join('')}</div>` : ''}
              ${actionType === 'day-vote' ? `<div class="target-card-voters">${votersHtml}</div>` : ''}
              <div class="target-card-foot">
                <div class="target-card-tap">${selectionIcon} ${escapeHtml(selectionLabel)}</div>
                ${action.locked && !isSelected ? '<span class="target-card-tag">รอรอบถัดไป</span>' : ''}
              </div>
            </div>
          </div>
        `;
      });

      if (action.allowSkip) {
        const isSkipSelected = action.selectedTargetId === '__skip__';
        const isSkipDisabled = Boolean(action.locked && !isSkipSelected);
        const skipCount = Number(action.skipVoteWeight || 0);
        const skipVoters = (voteSummary && Array.isArray(voteSummary.skipVoters)) ? voteSummary.skipVoters : [];
        const skipVotersHtml = skipVoters.length
          ? skipVoters.map(function(voter) {
              const suffix = voter.weight > 1 ? ` x${voter.weight}` : '';
              return `<span class="target-card-voter-pill ${voter.weight > 1 ? 'weighted' : ''}">${escapeHtml(voter.name)}${escapeHtml(suffix)}</span>`;
            }).join('')
          : '<span class="target-card-voter-pill empty">ยังไม่มีคนข้าม</span>';
        cards.push(`
          <div class="target-card target-theme-skip ${isSkipSelected ? 'target-selected' : ''} ${isSkipDisabled ? 'target-disabled' : ''} ${isSkipDisabled ? '' : 'target-card-actionable'}" data-action-type="action-skip" data-target-player-id="__skip__" ${isSkipDisabled ? '' : `onclick="${handlerName}(${handlerName === 'selectNightTarget' ? `'${actionType}', '__skip__'` : `'__skip__'`})"`}>
            <div class="target-card-particle-layer" aria-hidden="true"></div>
            <div class="target-card-head">
              <div class="target-card-title">
                <div class="target-card-avatar" style="background:linear-gradient(145deg, rgba(148,163,184,0.35), rgba(71,85,105,0.6));">🫥</div>
                <div class="target-card-text">
                  <div class="target-card-name"><strong>ข้ามรอบนี้</strong></div>
                  <div class="target-card-meta">
                    <span class="target-card-tag">ไม่ลงเป้าที่ผู้เล่นคนไหน</span>
                    ${skipCount > 0 ? `<span class="target-card-votes">⏭️ ${skipCount} เสียง</span>` : ''}
                  </div>
                </div>
              </div>
              <div class="target-card-status ${isSkipSelected ? 'status-selected' : (action.locked ? 'status-locked' : 'status-ready')}">${isSkipSelected ? '😌' : (action.locked ? '🔒' : '⏭️')} ${isSkipSelected ? 'เลือกข้ามแล้ว' : (action.locked ? 'ล็อกแล้ว' : 'พร้อมข้าม')}</div>
            </div>
            <div class="target-card-body">
              ${actionType === 'day-vote' ? `<div class="target-card-voters">${skipVotersHtml}</div>` : ''}
              <div class="target-card-hint">เหมาะตอนยังข้อมูลไม่พอ หรืออยากดันเกมไปเฟสถัดไปโดยไม่เทคะแนนให้ใคร</div>
            </div>
          </div>
        `);
      }

      return cards.join('');
    }

    window.selectNightTarget = function(actionType, targetPlayerId) {
      submitNightAction(actionType, targetPlayerId);
    };

    window.selectWitchPotion = function(actionType) {
      selectedWitchNightActionType = actionType;
      updateMobileTargetAction();
      renderActionPanels(currentState.actionState || {}, currentState.phase, currentState.winner);
      syncMobileGamePanel();
    };

    window.selectVoteTarget = function(targetPlayerId) {
      if (targetPlayerId === '__show__') {
        preferredDayTargetMode = 'vote';
        updateMobileTargetAction();
        renderActionPanels(currentState.actionState || {}, currentState.phase, currentState.winner);
        syncMobileGamePanel();
        return;
      }
      submitDayVote(targetPlayerId);
    };

    window.skipDiscussionPhase = function() {
      submitDiscussionSkip();
    };

    window.skipNightPhase = function() {
      submitNightSkip();
    };

    window.revealMayorRole = function() {
      submitMayorReveal();
    };

    window.selectRevealTarget = function(targetPlayerId) {
      if (targetPlayerId === '__show__') {
        preferredDayTargetMode = 'reveal';
        updateMobileTargetAction();
        renderActionPanels(currentState.actionState || {}, currentState.phase, currentState.winner);
        syncMobileGamePanel();
        var el = isMobileLayout() ? document.getElementById('mobileInlinePlayerGrid') : document.getElementById('actionPanels');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      Swal.fire({
        icon: 'warning',
        title: 'ยืนยันใช้สกิลเปิดโปง',
        text: 'เมื่อยืนยันแล้ว ระบบจะล็อกเป้านี้ไว้ก่อน และเฉลยตอนหมดเวลาว่าคุณเปิดโปงถูกหรือผิด',
        showCancelButton: true,
        confirmButtonText: 'ล็อกเป้า',
        cancelButtonText: 'ยกเลิก',
        background: '#1e1e1e',
        color: '#fff'
      }).then(function(result) {
        if (result.isConfirmed) {
          submitRevealAction(targetPlayerId);
        }
      });
    };

    function renderActionPanels(actionState, phase, winner) {
      const $root = $('#actionPanels');
      $root.empty();

      const recapHtml = buildPhaseRecapHtml(currentState);
      const receiptHtml = buildDecisionReceiptHtml(currentState);
      const spectatorHtml = buildSpectatorModeHtml(currentState);

      if (recapHtml) {
        $root.append(recapHtml);
      }

      if (receiptHtml) {
        $root.append(receiptHtml);
      }

      if (spectatorHtml) {
        $root.append(spectatorHtml);
      }

      if (winner) {
        if (isRoomAdmin) {
          $root.append('<div class="history-row">จบรอบ! กดเริ่มรอบใหม่ได้เลย</div>');
        } else {
          $root.append('<div class="history-row">จบรอบ! รอหัวหน้าห้องเริ่มใหม่</div>');
        }
        syncMobileGamePanel();
        return;
      }

      if (phase === 'night') {
        const actions = actionState?.nightActions || [];
        const nightStatus = actionState?.nightStatus || {};
        if (actions.length === 0) {
          $root.append('<div class="history-row">😴 คืนนี้ไม่มีสกิล แต่ยังช่วยกดพร้อมข้ามได้</div>');
        } else {
          if (isWitchChoiceNight(actions)) {
            const selectedAction = getPreferredNightAction(actions);
            const potionSelectorHtml = buildWitchPotionSelector(actions);
            const targetCards = selectedAction ? buildTargetCards(selectedAction, 'selectNightTarget', '', selectedAction.type) : '';
            const extraState = selectedAction
              ? (targetCards ? `<div class="target-grid">${targetCards}</div>` : `<div class="subtle" style="margin-top:10px;">${escapeHtml(selectedAction.emptyStateText || 'รอคืนดำเนินต่อ')}</div>`)
              : '<div class="subtle" style="margin-top:12px;">แตะเลือกยาก่อน แล้วรายชื่อเป้าหมายของยานั้นจะขึ้นให้เลือก</div>';
            $root.append(`
              <div class="history-row turn-focus" style="display:block;">
                <div class="action-title"><span>🧙‍♀️</span><strong>แม่มดเลือกยา</strong></div>
                <div class="subtle">เลือกก่อนว่าจะใช้ยาไหน แล้วค่อยเลือกเป้าหมาย</div>
                ${potionSelectorHtml}
                ${selectedAction ? `<div class="action-title" style="margin-top:14px;"><span>${actionEmoji(selectedAction.type)}</span><strong>${escapeHtml(selectedAction.label)}</strong></div>` : ''}
                ${selectedAction ? `<div class="subtle">${escapeHtml(selectedAction.description)}</div>` : ''}
                ${extraState}
              </div>
            `);
          } else {
            actions.forEach(function(action) {
              const targetCards = buildTargetCards(action, 'selectNightTarget', '', action.type);
              const extraState = targetCards ? `<div class="target-grid">${targetCards}</div>` : `<div class="subtle" style="margin-top:10px;">${escapeHtml(action.emptyStateText || 'รอคืนดำเนินต่อ')}</div>`;
              const focusClass = targetCards ? 'turn-focus' : '';
              $root.append(`
                <div class="history-row ${focusClass}" style="display:block;">
                  <div class="action-title"><span>${actionEmoji(action.type)}</span><strong>${escapeHtml(action.label)}</strong></div>
                  <div class="subtle">${escapeHtml(action.description)}</div>
                  ${extraState}
                </div>
              `);
            });
          }
        }
        const nightSkipCount = Number(nightStatus.skipCount || 0);
        const nightSkipNeeded = Number(nightStatus.skipNeeded || nightStatus.totalAlive || 0);
        const nightStatusText = nightSkipNeeded > 0
          ? `พร้อมข้าม ${nightSkipCount}/${nightSkipNeeded} คน ครบ = ตัดเข้าตอนเช้าทันที`
          : 'รอสถานะผู้เล่น';
        const nightButtonHtml = nightStatus.canSkip
          ? '<button class="action-btn" onclick="skipNightPhase()">⏭️ พร้อม ข้ามกลางคืน!</button>'
          : (nightStatus.hasSkipped
            ? '<button class="action-btn selected" disabled>✅ กดพร้อมแล้ว</button>'
            : '<button class="action-btn" disabled>⏳ รอสถานะกลางคืน</button>');
        $root.append(`
          <div class="history-row ${nightStatus.canSkip ? 'turn-focus' : ''}" style="display:block;">
            <div class="action-title"><span>🌙</span><strong>ข้ามกลางคืน</strong></div>
            <div class="subtle">ใช้เมื่อคุณไม่มีอะไรทำแล้ว หรืออยากยืนยันว่าพร้อมตัดเข้าตอนเช้า</div>
            <div class="highlight" style="margin-top:8px;">${escapeHtml(nightStatusText)}</div>
            <div style="margin-top:12px;">${nightButtonHtml}</div>
          </div>
        `);
        syncMobileGamePanel();
        return;
      }

      if (phase === 'day-discussion') {
        const discussion = actionState?.discussionActions || {};
        const skipCount = Number(discussion.skipCount || 0);
        const totalAlive = Number(discussion.totalAlive || 0);
        const mayorHtml = discussion.canRevealMayor
          ? '<button class="action-btn" onclick="revealMayorRole()">🎖️ เปิดบทนายก (โหวต ×2)</button>'
          : (discussion.mayorRevealed
            ? `<div class="highlight" style="margin-top:12px;">🎖️ เปิดตัวแล้ว! โหวตคุณ = ${discussion.currentVoteWeight || 2} เสียง</div>`
            : '');
        const statusText = totalAlive > 0
          ? `พร้อมข้าม ${skipCount}/${totalAlive} คน ครบ = เปิดโหวตเลย`
          : 'รอข้อมูลจำนวนผู้เล่น';
        const buttonHtml = discussion.canSkip
          ? '<button class="action-btn" onclick="skipDiscussionPhase()">⏭️ พร้อม ข้ามไปโหวต!</button>'
          : (discussion.hasSkipped
            ? '<button class="action-btn selected" disabled>✅ กดพร้อมแล้ว</button>'
            : '<button class="action-btn" disabled>⏳ รอช่วงประชุม</button>');
        const revealerHtml = discussion.canReveal
          ? `<div style="margin-top:12px;"><div class="action-title"><span>💥</span><strong>สกิลเปิดโปง</strong></div><div class="subtle">เลือกเป้าหมายเพื่อล็อกไว้ก่อน จากนั้นระบบจะรอจนหมดเวลาแล้วค่อยเฉลยว่าคุณเปิดโปงถูกหรือผิด</div><div class="target-grid">${buildTargetCards({ targets: discussion.revealTargets, selectedTargetId: discussion.pendingRevealTargetId }, 'selectRevealTarget', 'reveal', 'reveal-action')}</div></div>`
          : (discussion.pendingRevealTargetId
            ? `<div class="history-row">🎯 ล็อกเป้าเปิดโปง ${escapeHtml(discussion.pendingRevealTargetName || 'ไว้แล้ว')} รอหมดเวลาเฉลย</div>`
            : (discussion.revealUsed ? '<div class="history-row">💥 ใช้สกิลเปิดโปงไปแล้ว</div>' : ''));

        $root.append(`
          <div class="history-row ${discussion.canSkip || discussion.canRevealMayor || discussion.canReveal ? 'turn-focus' : ''}" style="display:block;">
            <div class="action-title"><span>💬</span><strong>ประชุม</strong></div>
            <div class="subtle">คุย จับพิรุธ กดข้ามได้ถ้าพร้อม</div>
            <div class="highlight" style="margin-top:8px;">${escapeHtml(statusText)}</div>
            <div style="margin-top:12px;">${buttonHtml}</div>
            ${mayorHtml ? `<div style="margin-top:12px;">${mayorHtml}</div>` : ''}
            ${revealerHtml}
          </div>
        `);
        syncMobileGamePanel();
        return;
      }

      if (phase === 'day-vote') {
        const dayActions = actionState?.dayActions || {};
        const voteBoardHtml = buildVoteProgressBoardHtml(dayActions.dayVoteSummary);
        const skipVoteText = Number(dayActions.skipVoteWeight || 0) > 0
          ? ` | ข้าม ${dayActions.skipVoteWeight}/${dayActions.totalVoteWeight || 0} เสียง`
          : '';
        const mayorVoteHtml = dayActions.canRevealMayor
          ? '<div style="margin-top:12px;"><button class="action-btn" onclick="revealMayorRole()">🎖️ เปิดบทนายก (โหวต ×2)</button></div>'
          : (dayActions.mayorRevealed
            ? `<div class="highlight" style="margin-top:10px;">🎖️ เปิดตัวแล้ว! โหวตคุณ = ${dayActions.currentVoteWeight || 2} เสียง</div>`
            : '');
        $root.append(`<div class="history-row" style="display:block;">☀️ โหวตแบบเปิด! ผลสดขึ้นบนที่นั่งทันที${skipVoteText}${mayorVoteHtml}</div>`);
        if (dayActions.canVote) {
          $root.append(`
            <div class="history-row turn-focus" style="display:block;">
              <div class="action-title"><span>🗳️</span><strong>โหวตขับออก</strong></div>
              <div class="subtle">เลือก 1 คน คะแนนนำ ${dayActions.dayVoteSummary?.leadingVoteWeight || 0}/${dayActions.voteThreshold || 0} • ลงแล้ว ${dayActions.dayVoteSummary?.totalSubmittedVoteWeight || 0}/${dayActions.totalVoteWeight || 0} เสียง</div>
              ${voteBoardHtml}
              <div class="target-grid">${buildTargetCards({ targets: dayActions.voteTargets, selectedTargetId: dayActions.selectedVoteTargetId, allowSkip: dayActions.allowSkipVote, voteTallies: dayActions.voteTallies, dayVoteSummary: dayActions.dayVoteSummary, skipVoteWeight: dayActions.skipVoteWeight }, 'selectVoteTarget', '', 'day-vote')}</div>
            </div>
          `);
        } else {
          $root.append('<div class="history-row">✅ โหวตแล้ว เปลี่ยนใจได้จนหมดเวลา</div>');
        }

        if (dayActions.canReveal) {
          $root.append(`
            <div class="history-row turn-focus" style="display:block;">
              <div class="action-title"><span>💥</span><strong>สกิลเปิดโปง</strong></div>
              <div class="subtle">ใช้ได้แม้อยู่ช่วงโหวต เลือกแล้วจะเป็นการล็อกเป้าไว้ และเฉลยผลตอนหมดเวลา</div>
              <div class="target-grid">${buildTargetCards({ targets: dayActions.revealTargets, selectedTargetId: dayActions.pendingRevealTargetId }, 'selectRevealTarget', 'reveal', 'reveal-action')}</div>
            </div>
          `);
        } else if (dayActions.pendingRevealTargetId) {
          $root.append('<div class="history-row">🎯 ล็อกเป้าเปิดโปง ' + escapeHtml(dayActions.pendingRevealTargetName || 'ไว้แล้ว') + ' รอหมดเวลาเฉลย</div>');
        } else if (dayActions.revealUsed) {
          $root.append('<div class="history-row">💥 ใช้สกิลเปิดโปงไปแล้ว</div>');
        }
        syncMobileGamePanel();
        return;
      }

      $root.append('<div class="history-row">🎬 รอเริ่มเกม...</div>');
      syncMobileGamePanel();
    }

    function renderWinner(winner) {
      const $banner = $('#winnerBanner');
      if (!winner) {
        $banner.hide();
        winScreenShown = false;
        hideWinScreen();
        return;
      }

      const winnerText = winner === 'village' ? '🏡 ชาวบ้านชนะ!' : (winner === 'werewolf' ? '🐺 หมาป่าชนะ!' : '🤪 คนบ้าชนะ!');
      const actionHtml = isRoomAdmin
        ? '<div class="winner-actions"><button id="restartWerewolfGame" class="werewolf-btn">🎲 เล่นอีก!</button><button id="backToRoomLobby" class="ghost-btn">🏠 กลับห้อง</button></div>'
        : '<div class="winner-actions"><button id="backToRoomLobby" class="ghost-btn">🏠 กลับห้อง</button></div>';
      $banner.html('<div>' + (winner === 'village' ? '🏡 ' : (winner === 'werewolf' ? '🐺 ' : '🤪 ')) + winnerText + '</div>' + actionHtml);
      $banner.show();

      // Show rich win screen overlay
      showWinScreen(currentState);
    }

    function buildPhaseTransitionCopy(state) {
      if (!state || !state.phase) {
        return null;
      }

      if (state.phase === 'night') {
        return {
          title: `🌙 คืนที่ ${state.dayNumber || 1}`,
          subtitle: state.dayNumber === 1
            ? 'คืนแรก! หมาป่ายังฆ่าใครไม่ได้'
            : 'เข้ากลางคืน คนมีสกิลใช้ได้เลย ระวังตัวดี ๆ นะ'
        };
      }

      if (state.phase === 'day-discussion') {
        return {
          title: `☀️ เช้าวันที่ ${state.dayNumber || 1}`,
          subtitle: 'เริ่มประชุมวันใหม่แล้ว! คุยกันว่าคนไหนน่าสงสัยที่สุด แล้วเตรียมตัวโหวตได้เลย'
        };
      }

      if (state.phase === 'day-vote') {
        return {
          title: `🗳️ โหวตวันที่ ${state.dayNumber || 1}`,
          subtitle: 'โหวตขับคนที่สงสัยออกไปจากเกมกันเลย!'
        };
      }

      if (state.phase === 'finished' && state.winner) {
        return {
          title: state.winner === 'village' ? '🏡 ชาวบ้านชนะ!' : (state.winner === 'werewolf' ? '🐺 หมาป่าชนะ!' : '🤪 คนบ้าชนะ!'),
          subtitle: 'จบรอบแล้ว! ' + (isRoomAdmin ? 'กดเริ่มรอบใหม่ได้เลย' : 'รอหัวหน้าห้องเริ่มใหม่')
        };
      }

      return null;
    }

    function clearPhaseTransitionSequence() {
      phaseTransitionTimeouts.forEach(function(timeoutId) {
        clearTimeout(timeoutId);
      });
      phaseTransitionTimeouts = [];
    }

    function buildPhaseTransitionSteps(state) {
      const phaseCopy = buildPhaseTransitionCopy(state);
      if (!phaseCopy) {
        return [];
      }

      if (state.phase === 'day-discussion' && state.morningAnnouncement) {
        const morningSound = state.morningAnnouncement.outcomeType === 'death'
          ? 'morning-death'
          : (state.morningAnnouncement.outcomeType === 'saved' ? 'morning-saved' : 'morning-peaceful');
        const personalAftermath = state.personalNotes?.lastNightResult;

        const steps = [
          {
            title: '🌘 ความมืดถอยออกไปแล้ว',
            subtitle: 'ทั้งหมู่บ้านกำลังรอฟังข่าวแรกจากคืนที่ผ่านมา',
            duration: 2200,
            sound: morningSound
          },
          {
            title: state.morningAnnouncement.lead,
            subtitle: state.morningAnnouncement.outcomeType === 'death'
              ? 'ข่าวนี้ถูกประกาศให้ทั้งโต๊ะรับรู้พร้อมกันในเช้าวันนี้'
              : 'เช้านี้ยังไม่มีศพตรงหน้า ทุกคนจึงต้องคุยและไล่เก็บพิรุธต่อเอง',
            duration: 2800
          }
        ];

        if (state.morningAnnouncement.detail && state.morningAnnouncement.detail !== state.morningAnnouncement.lead) {
          steps.push({
            title: '📜 รายละเอียดเพิ่มเติม',
            subtitle: state.morningAnnouncement.detail,
            duration: 3000
          });
        }

        if (personalAftermath) {
          steps.push({
            title: '🧠 สิ่งที่คุณรับรู้',
            subtitle: personalAftermath,
            duration: 2600
          });
        }

        steps.push({
          title: phaseCopy.title,
          subtitle: 'วงประชุมเปิดแล้ว ใช้ recap ด้านบนจับทางโต๊ะต่อได้ทันที',
          duration: 2600
        });

        return steps;
      }

      if (state.phase === 'night' && state.dayResolutionAnnouncement) {
        const voteSummarySound = state.dayResolutionAnnouncement.outcomeType === 'eliminated'
          ? 'vote-summary-eliminated'
          : 'vote-summary-tie';

        return [
          {
            title: '📢 สรุปผลโหวต',
            subtitle: 'เวลากลางวันกำลังปิดฉาก และผลตัดสินกำลังถูกเปิดเผย',
            duration: 2200,
            sound: voteSummarySound
          },
          {
            title: state.dayResolutionAnnouncement.lead,
            subtitle: state.dayResolutionAnnouncement.detail,
            duration: 3400
          },
          {
            title: phaseCopy.title,
            subtitle: phaseCopy.subtitle,
            duration: 2600,
            sound: 'nightfall'
          }
        ];
      }

      if (state.phase === 'finished' && state.winner) {
        if (state.morningAnnouncement) {
          const finishMorningSound = state.morningAnnouncement.outcomeType === 'death'
            ? 'morning-death'
            : (state.morningAnnouncement.outcomeType === 'saved' ? 'morning-saved' : 'morning-peaceful');
          const finishedSteps = [
            {
              title: '🌘 ข่าวสุดท้ายจากกลางคืนมาถึงแล้ว',
              subtitle: 'ก่อนประกาศผู้ชนะ เกมจะเฉลยก่อนว่าคืนล่าสุดเกิดอะไรขึ้น',
              duration: 2200,
              sound: finishMorningSound
            },
            {
              title: state.morningAnnouncement.lead,
              subtitle: state.morningAnnouncement.detail || 'นี่คือเหตุการณ์สุดท้ายก่อนเกมจบ',
              duration: 3400
            }
          ];

          finishedSteps.push({
            title: phaseCopy.title,
            subtitle: phaseCopy.subtitle,
            duration: 3200
          });

          return finishedSteps;
        }

        if (state.dayResolutionAnnouncement) {
          const finishDaySound = state.dayResolutionAnnouncement.outcomeType === 'eliminated' || state.dayResolutionAnnouncement.outcomeType === 'reveal-hit'
            ? 'vote-summary-eliminated'
            : 'vote-summary-tie';

          return [
            {
              title: '📢 สรุปเหตุการณ์ช่วงกลางวัน',
              subtitle: 'ก่อนประกาศผู้ชนะ มาดูกันว่าช่วงกลางวันช็อตไหนเป็นตัวตัดสิน',
              duration: 2200,
              sound: finishDaySound
            },
            {
              title: state.dayResolutionAnnouncement.lead,
              subtitle: state.dayResolutionAnnouncement.detail,
              duration: 3400
            },
            {
              title: phaseCopy.title,
              subtitle: phaseCopy.subtitle,
              duration: 3200
            }
          ];
        }
      }

      return [{
        title: phaseCopy.title,
        subtitle: phaseCopy.subtitle,
        duration: 3200,
        sound: state.phase === 'night' ? 'nightfall' : null
      }];
    }

    function showPhaseTransition(state) {
      const steps = buildPhaseTransitionSteps(state);
      if (steps.length === 0) {
        return;
      }

      clearPhaseTransitionSequence();

      $('#werewolfShell').addClass('phase-lock');
      $('#phaseTransitionBanner').addClass('visible');

      function applyStep(index) {
        const step = steps[index];
        if (!step) {
          $('#phaseTransitionBanner').removeClass('visible');
          $('#werewolfShell').removeClass('phase-lock');
          return;
        }

        $('#phaseTransitionTitle').text(step.title);
        $('#phaseTransitionSubtitle').text(step.subtitle);
        if (step.sound) {
          playSound(step.sound);
        }

        const timeoutId = setTimeout(function() {
          applyStep(index + 1);
        }, step.duration || 2000);

        phaseTransitionTimeouts.push(timeoutId);
      }

      applyStep(0);
    }

    function setMobileView(view) {
      // No-op: merged layout shows players + chat together, no tab switching needed
      if (view === 'game') {
        syncMobileGamePanel();
      }
    }

    function scrollToGameSection(target) {
      const nextTarget = target === 'players' ? 'players' : (target === 'chat' ? 'chat' : 'actions');

      if (nextTarget === 'chat') {
        if (isMobileLayout()) {
          setMobileView('chat');
        }
        scrollChatToBottom();
        return;
      }

      if (isMobileLayout()) {
        setMobileView('game');
        window.setTimeout(function() {
          const mobileSelector = nextTarget === 'players' ? '#mobilePlayerSection' : '#mobileActionSection';
          const mobileElement = document.querySelector(mobileSelector);
          if (mobileElement) {
            mobileElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 40);
        return;
      }

      const desktopSelector = nextTarget === 'players' ? '#playerBoardSection' : '#actionSection';
      const desktopElement = document.querySelector(desktopSelector);
      if (desktopElement) {
        desktopElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function renderState(state) {
      const previousPhase = currentState.phase;
      currentState = state || {};
      syncSelectedWitchNightAction(currentState);
      setActionButtonsPending(false);
      $('#phaseLabel').text(phaseLabel(currentState.phase));
      $('#phaseLabelSide').text(phaseLabel(currentState.phase));
      $('#mobilePhaseLabel').text(phaseLabel(currentState.phase));
      $('#dayNumber').text(currentState.dayNumber || 0);
      $('#myRoleName').text((currentState.playerRole ? roleEmoji(currentState.playerRole.id) + ' ' : '') + (currentState.playerRole?.thaiName || 'ยังไม่เปิดเผยบทบาท'));
      $('#myRoleTeam').text((currentState.playerRole ? teamEmoji(currentState.playerRole.team) + ' ' : '') + (currentState.playerRole?.team || '-'));
      $('#myRoleDescription').text(currentState.playerRole?.description || 'เมื่อเริ่มเกมแล้ว บทบาทของคุณจะปรากฏที่นี่');
      startPhaseCountdown(currentState.phaseEndsAt || null);
      renderWinner(currentState.winner);
      // Set up targeting BEFORE renderPlayers so target overlays work
      updateMobileTargetAction();
      renderPlayers(currentState.players || []);
      syncHistoryToChat(currentState.history || []);
      renderNotes(currentState.personalNotes || {});
      renderRoomRoleSummary();
      renderActionPanels(currentState.actionState || {}, currentState.phase, currentState.winner);
      syncChatComposerState(currentState);
      syncWolfChatFilterVisibility(currentState);
      syncAmbientForState(currentState);
      syncPhaseTheme(currentState.phase);
      syncMobileHeaderState();
      syncMobileGamePanel();

      const isPhaseChanged = Boolean(previousPhase && previousPhase !== currentState.phase);

      // GM toast: show guidance on phase change or first load
      if (isPhaseChanged || !previousPhase) {
        var gmMsg = getGmMessage(currentState);
        if (gmMsg) showGmToast(gmMsg);
      }
      const shouldShowRoleAnnouncement = currentState.phase === 'night'
        && Number(currentState.dayNumber || 1) === 1
        && currentState.playerRole?.id;
      const announcementKey = shouldShowRoleAnnouncement
        ? [roomId, currentState.dayNumber || 1, currentState.playerRole?.id || 'unknown'].join('|')
        : null;

      if (shouldShowRoleAnnouncement && announcementKey !== lastRoleAnnouncementKey) {
        lastRoleAnnouncementKey = announcementKey;
        showRoleAnnouncement(currentState, function() {
          if (isMobileLayout()) {
            setMobileView('game');
          }
          if (isPhaseChanged) {
            showPhaseTransition(currentState);
          }
          syncTurnSpotlight();
        });
      } else if (isPhaseChanged) {
        showPhaseTransition(currentState);
      }

      if (isMobileLayout() && hasLiveTurnFocus(currentState) && (!previousPhase || isPhaseChanged)) {
        setMobileView('game');
      }

      syncTurnSpotlight();

      lastRenderedPhase = currentState.phase || null;
    }


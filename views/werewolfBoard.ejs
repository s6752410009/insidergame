        return;
      }

      players.forEach(function(player) {
        const aliveText = player.alive ? 'ยังอยู่ในเกม' : 'ออกจากเกมแล้ว';
        const selfText = player.isSelf ? ' (คุณ)' : '';
        const revealText = player.revealedRole ? `<div class="subtle">บทบาท: ${escapeHtml(player.revealedRole)}</div>` : '';
        const mayorText = player.voteWeight > 1 ? `<div class="highlight">🎖️ โหวตหนัก ${player.voteWeight} เสียง</div>` : '';
        const playerEmoji = player.revealedRole ? '🎭' : (player.isSelf ? '🫵' : '👤');
        $root.append(`
          <div class="player-row ${player.alive ? '' : 'dead'}">

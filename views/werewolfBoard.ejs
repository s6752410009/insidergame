<%- contentFor('script') %>
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  $(function() {
    const socket = io();
    const roomId = '<%= room.roomId %>';
    const playerId = '<%= player.playerId %>';
    const myPlayerName = '<%= player.name %>';
    const isRoomAdmin = <%= room.admin ? 'true' : 'false' %>;
    const initialChatHistory = <%- JSON.stringify(typeof chatHistory !== 'undefined' ? chatHistory : []) %>;
    let currentState = <%- JSON.stringify(typeof werewolfState !== 'undefined' ? werewolfState : {}) %>;
    let allowNavigation = false;
    let phaseCountdownInterval = null;
    let lastRenderedPhase = currentState.phase || null;
    let lastWarningKey = null;
    let activePhaseDeadline = currentState.phaseEndsAt || null;
    let wasHidden = false;
    let phaseTransitionTimeouts = [];
    let roleAnnouncementTimeout = null;
    let lastRoleAnnouncementKey = null;
    let audioContext = null;
    let ambientController = null;
    let audioUnlockBound = false;
    let pendingActionSubmission = false;
    let replyingTo = null;
    let currentChatFilter = 'all';
    let touchStartX = 0;
    let touchStartY = 0;
    let swipingWrapper = null;
    const seenHistoryKeys = new Set();
    const renderedMessageIds = new Set();

    function escapeHtml(value) {
      return $('<div>').text(value || '').html();
    }

    function roleEmoji(roleId) {
      const icons = {
        villager: '🙂',
        werewolf: '🐺',
        alphaWolf: '👑',
        mayor: '🎖️',
        bodyguard: '🛡️',
        seer: '🔮',
        doctor: '💉',
        revealer: '💥'
      };

      return icons[roleId] || '🎭';
    }

    function phaseIcon(phase) {
      const icons = {
        lobby: '🏕️',
        night: '🌙',
        'day-vote': '☀️',
        finished: '🏁'
      };

      return icons[phase] || '🎯';
    }

    function teamEmoji(team) {
      const icons = {
        village: '🏡',
        werewolf: '🐺'
      };

      return icons[team] || '🎭';
    }

    function roleActionHint(role) {
      if (!role || !role.id) {
        return 'อ่านบทของคุณให้ครบ แล้วรอระบบเริ่มเกม';
      }

      const hints = {
        villager: 'คุณไม่มีสกิลกดใช้ ให้โฟกัสการฟังแชท จับพิรุธ และโหวตคนที่น่าสงสัยที่สุดตอนกลางวัน',
        werewolf: 'คุณอยู่ฝั่งหมาป่า กลางคืนให้คุยกับทีมและเลือกเป้าหมายเมื่อระบบเปิดให้ลงมือ',
        alphaWolf: 'คุณเป็นหมาป่าฝั่งนำ ช่วยชี้เป้าและพาทีมหมาป่าตัดสินใจตอนกลางคืน',
        mayor: 'คะแนนโหวตของคุณมีน้ำหนักมากกว่าปกติ ใช้ตอนกลางวันให้คุ้มเพื่อพลิกเกม',
        bodyguard: 'กลางคืนคุณเลือกคุ้มกันผู้เล่นได้ 1 คน เลือกคนสำคัญที่ไม่อยากให้ถูกเก็บ',
        seer: 'กลางคืนคุณเลือกตรวจผู้เล่นได้ 1 คน เพื่อดูว่าเขาอยู่ฝั่งไหน',
        doctor: 'กลางคืนคุณเลือกช่วยผู้เล่นได้ 1 คน เพื่อกันการถูกกำจัด',
        revealer: 'ตอนกลางวันคุณมีสกิลเปิดโปง หากเลือกหมาป่าถูกมันจะตายทันที แต่ถ้าพลาดคุณจะตายเอง'
      };

      return hints[role.id] || 'ดูคำอธิบายบทของคุณ แล้วลงมือเมื่อถึงช่วงที่ระบบเปิดให้ใช้ความสามารถ';
    }

    function clearRoleAnnouncement() {
      if (roleAnnouncementTimeout) {
        clearTimeout(roleAnnouncementTimeout);
        roleAnnouncementTimeout = null;
      }
      $('#roleAnnouncementBanner').removeClass('visible');
    }

    function showRoleAnnouncement(state, onDone) {
      const role = state?.playerRole || {};

      if (!role.id) {
        if (typeof onDone === 'function') {
          onDone();
        }
        return;
      }

      clearRoleAnnouncement();
      $('#werewolfShell').addClass('phase-lock');
      $('#roleAnnouncementName').text(roleEmoji(role.id) + ' ' + (role.thaiName || 'ยังไม่เปิดเผยบทบาท'));
      $('#roleAnnouncementTeam').text(teamEmoji(role.team) + ' ' + (role.team || '-'));
      $('#roleAnnouncementDescription').text(role.description || 'บทของคุณถูกเปิดเผยแล้ว');
      $('#roleAnnouncementHint').text(roleActionHint(role));
      $('#roleAnnouncementBanner').addClass('visible');

      roleAnnouncementTimeout = setTimeout(function() {
        $('#roleAnnouncementBanner').removeClass('visible');
        roleAnnouncementTimeout = null;
        if (!$('#phaseTransitionBanner').hasClass('visible')) {
          $('#werewolfShell').removeClass('phase-lock');
        }
        if (typeof onDone === 'function') {
          onDone();
        }
      }, 4000);
    }

    function actionEmoji(actionType) {
      const icons = {
        'night-kill': '🐾',
        'seer-check': '🔮',
        'doctor-save': '💉',
        'bodyguard-protect': '🛡️'
      };

      return icons[actionType] || '🎯';
    }

    function statusEmoji(alive) {
      return alive ? '✨' : '💀';
    }

    function isMobileLayout() {
      return window.matchMedia('(max-width: 960px)').matches;
    }

    function syncMobileHeaderState() {
      $('#mobilePhaseLabel').text(phaseLabel(currentState.phase));
      $('#mobilePhaseCountdown').text(formatCountdown(currentState.phaseEndsAt || null));
    }

    function setActionButtonsPending(isPending) {
      pendingActionSubmission = Boolean(isPending);
      $('.action-btn').prop('disabled', pendingActionSubmission).toggleClass('pending-action', pendingActionSubmission);
    }

    function hasOpenMobileActions() {
      const $source = $('#actionPanels');
      return $source.find('.action-btn').length > 0;
    }

    function syncMobileGamePanel() {
      // Mirror action panels
      $('#mobileActionPanels').html($('#actionPanels').html() || '<div class="history-row">🎬 กำลังรอให้รอบเริ่ม</div>');
      // Mirror role info
      $('#mobileRoleName').text($('#myRoleName').text());
      $('#mobileRoleTeam').text($('#myRoleTeam').text());
      $('#mobileRoleDesc').text($('#myRoleDescription').text());
      $('#mobilePersonalNotes').html($('#personalNotes').html() || '<div class="note-row">ยังไม่มีข้อมูลลับเพิ่มเติม</div>');
      // Mirror winner banner in game panel
      var winHtml = $('#winnerBanner').html();
      if (winHtml && $('#winnerBanner').is(':visible')) {
        $('#mobileWinnerBanner').html(winHtml).show();
      } else {
        $('#mobileWinnerBanner').hide();
      }
      // Mirror player list
      $('#mobilePlayerGrid').html($('#werewolfPlayers').html());
      // Show badge on game tab if there are actions
      var hasActions = hasOpenMobileActions();
      $('#actionBadge').toggle(hasActions);

      // Mobile winner bar (always visible above tabs)
      if (currentState.winner && isMobileLayout()) {
        var winnerEmoji = currentState.winner === 'village' ? '🏡' : '🐺';
        var winnerLabel = currentState.winner === 'village' ? 'ชาวบ้านชนะแล้ว!' : 'ฝั่งหมาป่าชนะแล้ว!';
        $('#mobileWinnerText').text(winnerEmoji + ' ' + winnerLabel);
        var btns = '';
        if (isRoomAdmin) {
          btns += '<button class="werewolf-btn">🎲 เล่นรอบใหม่</button>';
        }
        btns += '<button class="ghost-btn">🏠 กลับไปที่ห้อง</button>';
        $('#mobileWinnerBtns').html(btns);
        $('#mobileWinnerBar').addClass('active');
      } else {
        $('#mobileWinnerBar').removeClass('active');
      }
    }

    function phaseLabel(phase) {
      const labels = {
        lobby: '🏕️ รวมตัวก่อนเกม',
        night: '🌙 กลางคืน',
        'day-vote': '☀️ เวลากลางวัน',
        finished: '🏁 จบเกม'
      };

      return labels[phase] || phase || 'lobby';
    }

    function formatCountdown(phaseEndsAt) {
      if (!phaseEndsAt) {
        return '-';
      }

      const secondsLeft = Math.max(0, Math.ceil((phaseEndsAt - Date.now()) / 1000));
      const minutes = Math.floor(secondsLeft / 60);
      const seconds = secondsLeft % 60;
      return minutes + ':' + String(seconds).padStart(2, '0');
    }

    function startPhaseCountdown(phaseEndsAt) {
      if (phaseCountdownInterval) {
        clearInterval(phaseCountdownInterval);
      }

      if (activePhaseDeadline !== phaseEndsAt) {
        lastWarningKey = null;
        activePhaseDeadline = phaseEndsAt || null;
      }
      $('#phaseCountdown').text(formatCountdown(phaseEndsAt));
      $('#mobilePhaseCountdown').text(formatCountdown(phaseEndsAt));
      if (!phaseEndsAt) {
        return;
      }

      phaseCountdownInterval = setInterval(function() {
        const secondsLeft = Math.max(0, Math.ceil((phaseEndsAt - Date.now()) / 1000));
        $('#phaseCountdown').text(formatCountdown(phaseEndsAt));
        $('#mobilePhaseCountdown').text(formatCountdown(phaseEndsAt));
        if (secondsLeft <= 10 && secondsLeft > 0 && lastWarningKey !== String(phaseEndsAt)) {
          lastWarningKey = String(phaseEndsAt);
          playSound('warning');
          appendChatMessage({
            playerName: 'System',
            message: 'ใกล้หมดเวลาแล้ว ระบบจะสรุปช่วงนี้ให้อัตโนมัติ',
            timestamp: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Bangkok' }),
            avatar: '⏳'
          }, { silent: true });
        }
        if (Date.now() >= phaseEndsAt) {
          clearInterval(phaseCountdownInterval);
          phaseCountdownInterval = null;
        }
      }, 1000);
    }

    function getAudioContext() {
      if (audioContext) {
        return audioContext;
      }

      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) {
        return null;
      }

      audioContext = new AudioContextClass();
      return audioContext;
    }

    function bindAudioUnlock() {
      if (audioUnlockBound) {
        return;
      }

      audioUnlockBound = true;
      const unlockAudio = function() {
        const context = getAudioContext();
        if (!context) {
          return;
        }

        context.resume().catch(function() {}).finally(function() {
          syncAmbientForState(currentState);
        });

        document.removeEventListener('pointerdown', unlockAudio);
        document.removeEventListener('keydown', unlockAudio);
      };

      document.addEventListener('pointerdown', unlockAudio, { once: true });
      document.addEventListener('keydown', unlockAudio, { once: true });
    }

    function stopAmbient(fadeSeconds) {
      if (!ambientController) {
        return;
      }

      const context = getAudioContext();
      if (!context) {
        ambientController = null;
        return;
      }

      const fade = typeof fadeSeconds === 'number' ? fadeSeconds : 0.8;
      const now = context.currentTime;

      if (ambientController.masterGain) {
        ambientController.masterGain.gain.cancelScheduledValues(now);
        ambientController.masterGain.gain.setValueAtTime(Math.max(0.0001, ambientController.masterGain.gain.value || 0.0001), now);
        ambientController.masterGain.gain.exponentialRampToValueAtTime(0.0001, now + fade);
      }

      const nodes = ambientController;
      setTimeout(function() {
        (nodes.oscillators || []).forEach(function(oscillator) {
          try {
            oscillator.stop();
          } catch (error) {}
          try {
            oscillator.disconnect();
          } catch (error) {}
        });

        if (nodes.lfo) {
          try {
            nodes.lfo.stop();
          } catch (error) {}
          try {
            nodes.lfo.disconnect();
          } catch (error) {}
        }

        if (nodes.lfoGain) {
          try {
            nodes.lfoGain.disconnect();
          } catch (error) {}
        }

        if (nodes.masterGain) {
          try {
            nodes.masterGain.disconnect();
          } catch (error) {}
        }
      }, Math.max(50, fade * 1000 + 120));

      ambientController = null;
    }

    function startAmbient(phase) {
      const context = getAudioContext();
      if (!context) {
        return;
      }

      if (context.state === 'suspended') {
        bindAudioUnlock();
        return;
      }

      stopAmbient(0.45);

      if (phase !== 'night' && phase !== 'day-vote') {
        return;
      }

      const now = context.currentTime;
      const masterGain = context.createGain();
      masterGain.gain.setValueAtTime(0.0001, now);
      masterGain.connect(context.destination);

      const primary = context.createOscillator();
      const secondary = context.createOscillator();
      const primaryGain = context.createGain();
      const secondaryGain = context.createGain();
      const lfo = context.createOscillator();
      const lfoGain = context.createGain();

      if (phase === 'night') {
        primary.type = 'sine';
        secondary.type = 'triangle';
        primary.frequency.setValueAtTime(110.0, now);
        secondary.frequency.setValueAtTime(164.81, now);
        primaryGain.gain.setValueAtTime(0.0048, now);
        secondaryGain.gain.setValueAtTime(0.0022, now);
        lfo.frequency.setValueAtTime(0.08, now);
        lfoGain.gain.setValueAtTime(0.0009, now);
      } else {
        primary.type = 'sine';
        secondary.type = 'sine';
        primary.frequency.setValueAtTime(196.0, now);
        secondary.frequency.setValueAtTime(246.94, now);
        primaryGain.gain.setValueAtTime(0.0022, now);
        secondaryGain.gain.setValueAtTime(0.0012, now);
        lfo.frequency.setValueAtTime(0.09, now);
        lfoGain.gain.setValueAtTime(0.00045, now);
      }

      primary.connect(primaryGain);
      secondary.connect(secondaryGain);
      primaryGain.connect(masterGain);
      secondaryGain.connect(masterGain);
      lfo.connect(lfoGain);
      lfoGain.connect(masterGain.gain);

      primary.start(now);
      secondary.start(now);
      lfo.start(now);

      const targetGain = phase === 'night' ? 0.13 : 0.08;
      masterGain.gain.exponentialRampToValueAtTime(targetGain, now + 1.6);

      ambientController = {
        phase: phase,
        masterGain: masterGain,
        oscillators: [primary, secondary],
        lfo: lfo,
        lfoGain: lfoGain
      };
    }

    function syncAmbientForState(state) {
      const phase = state?.phase;
      const winner = state?.winner;

      if (winner || (phase !== 'night' && phase !== 'day-vote')) {
        stopAmbient(0.8);
        return;
      }

      if (ambientController && ambientController.phase === phase) {
        return;
      }

      startAmbient(phase);
    }

    function playToneSequence(notes, options) {
      const context = getAudioContext();
      if (!context || !Array.isArray(notes) || notes.length === 0) {
        return;
      }

      const settings = options || {};
      if (context.state === 'suspended') {
        context.resume().catch(function() {});
      }

      let currentTime = context.currentTime + 0.02;
      notes.forEach(function(note) {
        const oscillator = context.createOscillator();
        const gainNode = context.createGain();
        const duration = note.duration || 0.18;
        const volume = note.volume || settings.volume || 0.05;

        oscillator.type = note.wave || settings.wave || 'sine';
        oscillator.frequency.setValueAtTime(note.frequency, currentTime);

        gainNode.gain.setValueAtTime(0.0001, currentTime);
        gainNode.gain.exponentialRampToValueAtTime(volume, currentTime + 0.02);
        gainNode.gain.exponentialRampToValueAtTime(0.0001, currentTime + duration);

        oscillator.connect(gainNode);
        gainNode.connect(context.destination);

        oscillator.start(currentTime);
        oscillator.stop(currentTime + duration + 0.02);

        currentTime += duration + (note.gap || settings.gap || 0.04);
      });
    }

    function playMorningSound(outcomeType) {
      if (outcomeType === 'death') {
        playToneSequence([
          { frequency: 392.0, duration: 0.2, wave: 'triangle', volume: 0.04 },
          { frequency: 349.23, duration: 0.2, wave: 'triangle', volume: 0.042 },
          { frequency: 293.66, duration: 0.34, wave: 'sine', volume: 0.046, gap: 0.06 }
        ]);
        return;
      }

      if (outcomeType === 'saved') {
        playToneSequence([
          { frequency: 523.25, duration: 0.14, wave: 'triangle', volume: 0.04 },
          { frequency: 659.25, duration: 0.16, wave: 'triangle', volume: 0.044 },
          { frequency: 587.33, duration: 0.24, wave: 'sine', volume: 0.042 }
        ]);
        return;
      }

      playToneSequence([
        { frequency: 523.25, duration: 0.16, wave: 'triangle', volume: 0.042 },
        { frequency: 659.25, duration: 0.18, wave: 'triangle', volume: 0.048 },
        { frequency: 783.99, duration: 0.28, wave: 'triangle', volume: 0.054 },
        { frequency: 880.0, duration: 0.18, wave: 'sine', volume: 0.038, gap: 0.05 }
      ]);
    }

    function playNightSound() {
      playToneSequence([
        { frequency: 220.0, duration: 0.2, wave: 'sawtooth', volume: 0.032 },
        { frequency: 196.0, duration: 0.22, wave: 'triangle', volume: 0.034 },
        { frequency: 174.61, duration: 0.34, wave: 'sine', volume: 0.038, gap: 0.06 }
      ]);
    }

    function playSound(type) {
      if (type === 'morning-peaceful') {
        playMorningSound('peaceful');
        return;
      }

      if (type === 'morning-death') {
        playMorningSound('death');
        return;
      }

      if (type === 'morning-saved') {
        playMorningSound('saved');
        return;
      }

      if (type === 'nightfall') {
        playNightSound();
        return;
      }

      if (type === 'vote-summary-eliminated') {
        playToneSequence([
          { frequency: 369.99, duration: 0.18, wave: 'sawtooth', volume: 0.04 },
          { frequency: 311.13, duration: 0.2, wave: 'triangle', volume: 0.042 },
          { frequency: 261.63, duration: 0.3, wave: 'sine', volume: 0.046 }
        ]);
        return;
      }

      if (type === 'vote-summary-tie') {
        playToneSequence([
          { frequency: 415.3, duration: 0.12, wave: 'triangle', volume: 0.03 },
          { frequency: 415.3, duration: 0.12, wave: 'triangle', volume: 0.028, gap: 0.03 },
          { frequency: 369.99, duration: 0.24, wave: 'sine', volume: 0.032 }
        ]);
        return;
      }

      let source = '/static/sound/ding.mp3';
      if (type === 'phase') {
        source = '/static/sound/go.mp3';
      } else if (type === 'warning') {
        source = '/static/sound/dong.mp3';
      } else if (type === 'chat') {
        source = '/static/sound/message.mp3';
      }

      const audio = new Audio(source);
      audio.play().catch(function() {});
    }

    function renderPlayers(players) {

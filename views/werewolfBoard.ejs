<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }

  /* ===== VIEWPORT LOCK: prevent dual-scroll on mobile ===== */
  @media (max-width: 960px) {
    html.ww-active,
    html.ww-active body.content {
      overflow: hidden !important;
      height: var(--ww-app-height, 100dvh) !important;
      min-height: var(--ww-app-height, 100dvh) !important;
      margin: 0 !important;
      padding: 0 !important;
      background: #0b1220 !important;
      overscroll-behavior: none !important;
    }
    html.ww-active header,
    html.ww-active .footer {
      display: none !important;
    }
    html.ww-active .container-fluid {
      padding: 0 !important;
      margin: 0 !important;
      height: 100% !important;
    }
    html.ww-active .container-fluid > .row {
      margin: 0 !important;
      height: 100% !important;
    }
    html.ww-active .col-lg-12 {
      padding: 0 !important;
      height: 100% !important;
    }
  }

  /* ===== PHASE TRANSITION OVERLAY ===== */
  .phase-transition-banner { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(7,10,18,0.85); opacity: 0; pointer-events: none; transition: opacity 0.45s ease; z-index: 1200; }
  .phase-transition-banner.visible { opacity: 1; pointer-events: auto; }
  .phase-transition-card { min-width: min(88vw, 420px); max-width: 92vw; padding: 32px 28px; border-radius: 24px; border: 1px solid rgba(255,255,255,0.18); background: linear-gradient(135deg, rgba(30,40,70,0.97), rgba(20,28,50,0.98)); box-shadow: 0 24px 60px rgba(0,0,0,0.6), 0 0 80px rgba(139,92,246,0.12); text-align: center; transform: translateY(18px) scale(0.96); transition: transform 0.55s ease, opacity 0.55s ease; }
  .phase-transition-banner.visible .phase-transition-card { transform: translateY(0) scale(1); }
  .phase-transition-title { font-family: 'Orbitron', sans-serif; font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 700; margin-bottom: 12px; color: #fff; text-shadow: 0 2px 12px rgba(139,92,246,0.4); }
  .phase-transition-subtitle { color: #e2e8f0; font-size: 1.1rem; line-height: 1.5; text-shadow: 0 1px 4px rgba(0,0,0,0.3); }

  .role-announce-banner { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(6, 10, 18, 0.88); opacity: 0; pointer-events: none; transition: opacity 0.35s ease; z-index: 1300; }
  .role-announce-banner.visible { opacity: 1; pointer-events: auto; }
  .role-announce-card { width: min(92vw, 520px); padding: 28px 24px; border-radius: 28px; border: 1px solid rgba(255,255,255,0.16); background: linear-gradient(160deg, rgba(18,24,44,0.98), rgba(28,37,68,0.98)); box-shadow: 0 28px 80px rgba(0,0,0,0.6), 0 0 90px rgba(96,165,250,0.15); text-align: center; transform: translateY(22px) scale(0.96); transition: transform 0.45s ease, opacity 0.45s ease; }
  .role-announce-banner.visible .role-announce-card { transform: translateY(0) scale(1); }
  .role-announce-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,0.08); color: #dbeafe; font-weight: 700; font-size: 0.86rem; margin-bottom: 14px; }
  .role-announce-name { font-family: 'Orbitron', sans-serif; font-size: clamp(1.5rem, 5vw, 2.15rem); font-weight: 700; color: #ffffff; margin-bottom: 10px; text-shadow: 0 6px 30px rgba(96,165,250,0.3); }
  .role-announce-team { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.08); color: #fde68a; font-weight: 700; margin-bottom: 14px; }
  .role-announce-desc { color: #e2e8f0; font-size: 1rem; line-height: 1.55; margin-bottom: 12px; }
  .role-announce-hint { padding: 12px 14px; border-radius: 16px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); color: #f8fafc; font-size: 0.96rem; line-height: 1.5; }

  /* ===== MOBILE-FIRST: full-viewport flex column ===== */
  .ww-page {
    font-family: 'Rajdhani', sans-serif;
    color: #f4f6fb;
    display: flex;
    flex-direction: column;
    height: var(--ww-app-height, 100dvh);
    min-height: var(--ww-app-height, 100dvh);
    overflow: hidden;
    background: #0b1220;
  }
  @media (max-width: 960px) {
    .ww-page { position: fixed; inset: 0; width: 100%; max-height: var(--ww-app-height, 100dvh); }
  }

  /* -- top bar (mobile) -- */
  .ww-topbar { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 10px; background: linear-gradient(135deg, #0e121c, #171c2a); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .ww-topbar-info { min-width: 0; }
  .ww-topbar-title { font-family: 'Orbitron', sans-serif; font-size: 0.88rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ww-topbar-meta { font-size: 0.82rem; color: #cfd8eb; }
  .ww-topbar-actions { display: flex; gap: 6px; flex-shrink: 0; }
  .ww-topbar-btn { border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: rgba(255,255,255,0.05); color: #f4f6fb; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.78rem; padding: 6px 10px; cursor: pointer; white-space: nowrap; }
  .ww-topbar-btn.danger { background: linear-gradient(135deg, #c0392b, #7f1d1d); border: 0; }
  /* -- compact phase bar (Wolvesville-style) -- */
  .phase-hud { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 14px; background: linear-gradient(180deg, rgba(11,18,32,0.98), rgba(14,24,40,0.94)); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .phase-hud-main { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
  .phase-hud-copy { min-width: 0; display: flex; align-items: center; gap: 8px; }
  .phase-hud-kicker { display: none; }
  .phase-hud-title { font-family: 'Orbitron', sans-serif; font-size: 1rem; line-height: 1; color: #fff; white-space: nowrap; }
  .phase-hud-current { display: none; }
  .phase-hud-timer-box { display: flex; align-items: center; gap: 8px; padding: 0; border-radius: 0; background: none; border: 0; min-width: auto; text-align: right; }
  .phase-hud-timer-label { display: none; }
  .phase-hud-timer { font-family: 'Orbitron', sans-serif; font-size: 1.1rem; color: #fff4c2; line-height: 1; margin: 0; }
  .phase-hud-meta { color: #cbd5e1; font-size: 0.78rem; margin: 0; white-space: nowrap; }
  .phase-hud-rail { display: none; }
  .phase-hud-step, .phase-hud-step-label, .phase-hud-step-body { display: none; }
  /* -- status strip: hidden in compact mode -- */
  .phase-status-strip { display: none !important; }
  .phase-status-main, .phase-status-copy, .phase-status-kicker, .phase-status-headline, .phase-status-detail, .phase-status-actions, .phase-status-cta, .phase-status-chips, .phase-status-chip { display: none !important; }

  /* -- GM toast: hidden on mobile (replaced by hint bar) -- */
  .gm-toast { display: none; }

  /* -- Day/Night atmosphere -- */
  .ww-page.phase-night { background: linear-gradient(180deg, #04060c 0%, #08101e 40%, #0c1628 100%); }
  .ww-page.phase-day-discussion, .ww-page.phase-day-vote { background: linear-gradient(180deg, #10182a 0%, #182240 50%, #1e2a48 100%); }

  /* -- view switcher: hidden in compact mode -- */
  .ww-view-switcher { display: none !important; }
  .ww-view-tab, .ww-tab-badge { display: none !important; }

  /* -- mobile game panel: hidden (players shown inline) -- */
  .ww-game-panel { display: none !important; }
  .ww-game-section, .ww-game-section-title, .ww-game-links, .ww-game-link { display: none !important; }

  /* -- mobile winner bar (shows above chat/game when game ends) -- */
  .ww-mobile-winner { display: none; flex-shrink: 0; padding: 10px; background: linear-gradient(135deg, rgba(34,197,94,0.2), rgba(21,128,61,0.25)); border-bottom: 1px solid rgba(134,239,172,0.2); }
  .ww-mobile-winner.active { display: block; }
  .ww-mobile-winner-text { font-weight: 700; font-size: 1rem; text-align: center; margin-bottom: 8px; }
  .ww-mobile-winner-btns { display: flex; gap: 8px; justify-content: center; }
  .ww-mobile-winner-btns .werewolf-btn, .ww-mobile-winner-btns .ghost-btn { font-size: 0.88rem; padding: 8px 14px; }

  /* -- chat head (hidden on mobile, shows h3+pill on desktop) -- */
  .ww-chat-head { display: none; }

  /* -- chat/composer hidden when game tab is active -- */
  .ww-chat-view { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; }
  .ww-chat-view.hidden { display: flex; }

  /* -- filter tabs -- */
  .ww-filters { flex-shrink: 0; display: flex; gap: 6px; padding: 6px 10px; }
  .chat-tab { border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); color: #cfd8eb; border-radius: 999px; padding: 5px 12px; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.82rem; cursor: pointer; }
  .chat-tab.active { background: linear-gradient(135deg, rgba(37,99,235,0.26), rgba(29,78,216,0.18)); border-color: rgba(96,165,250,0.24); color: #fff; }
  .chat-tab[data-chat-filter="wolf"] { border-color: rgba(248,113,113,0.16); }
  .chat-tab[data-chat-filter="wolf"].active { background: linear-gradient(135deg, rgba(127,29,29,0.42), rgba(185,28,28,0.22)); border-color: rgba(248,113,113,0.32); }

  /* -- chat messages -- */
  .ww-chat-scroll { flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 8px 10px calc(12px + env(safe-area-inset-bottom, 0px)); display: flex; flex-direction: column; gap: 6px; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }

  /* -- composer -- */
  .ww-composer { flex-shrink: 0; padding: 8px 10px; padding-bottom: calc(8px + env(safe-area-inset-bottom, 0px)); background: #0b1220; border-top: 1px solid rgba(255,255,255,0.06); }
  .ww-reply-bar { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 10px; margin-bottom: 6px; border-radius: 10px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); }
  .ww-reply-bar-main { min-width: 0; }
  .ww-reply-bar-title { color: #f8d189; font-weight: 700; font-size: 0.86rem; }
  .ww-reply-bar-text { color: #c8d2e6; font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ww-reply-cancel { border: 0; background: transparent; color: #cdd5e5; font-size: 1.2rem; cursor: pointer; }
  .ww-input-row { display: flex; gap: 8px; align-items: flex-end; }
  .ww-input-row textarea { flex: 1; min-height: 38px; max-height: 80px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.12); background: rgba(10,15,25,0.9); color: #fff; padding: 8px 12px; font-family: 'Rajdhani', sans-serif; font-size: 0.92rem; resize: none; }
  .ww-input-row textarea:focus { outline: none; border-color: rgba(231,76,60,0.65); }
  .ww-send-btn { border: 0; border-radius: 10px; padding: 8px 16px; background: linear-gradient(135deg, #c0392b, #7f1d1d); color: #fff; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.92rem; cursor: pointer; white-space: nowrap; align-self: stretch; }

  /* -- desktop-only blocks: hidden on mobile -- */
  .ww-desktop-hero { display: none !important; }
  .ww-action-section { display: none; }

  /* -- mobile inline sections (above chat) -- */
  .ww-mobile-players { flex-shrink: 0; padding: 6px 10px 2px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .ww-mobile-notes { display: none; }
  .ww-mobile-actions { display: none; }

  /* -- HINT BAR: single unified action/info section -- */
  .ww-mobile-hint { flex-shrink: 0; padding: 4px 10px 6px; }
  .hint-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); }
  .hint-bar.hint-night { border-color: rgba(96,165,250,0.2); background: linear-gradient(135deg, rgba(30,58,138,0.15), rgba(15,23,42,0.2)); }
  .hint-bar.hint-discussion { border-color: rgba(250,204,21,0.15); background: linear-gradient(135deg, rgba(120,90,10,0.08), rgba(15,23,42,0.2)); }
  .hint-bar.hint-vote { border-color: rgba(250,204,21,0.2); background: linear-gradient(135deg, rgba(120,90,10,0.12), rgba(15,23,42,0.2)); }
  .hint-bar.hint-focus { border-color: rgba(250,204,21,0.3); box-shadow: 0 0 8px rgba(250,204,21,0.1); }
  .hint-role { font-size: 0.82rem; font-weight: 700; color: #fde68a; white-space: nowrap; }
  .hint-text { font-size: 0.82rem; font-weight: 600; color: #e2e8f0; }
  .hint-sep { color: rgba(255,255,255,0.2); font-size: 0.7rem; }
  .hint-seer-tag { display: inline-flex; align-items: center; gap: 8px; padding: 5px 10px; border-radius: 12px; font-size: 0.76rem; font-weight: 700; margin-left: 6px; border: 1px solid rgba(148,163,184,0.22); color: #f8fafc; max-width: min(100%, 280px); overflow: hidden; }
  .hint-seer-tag strong { color: inherit; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .seer-result-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.01em; border: 1px solid transparent; white-space: nowrap; }
  .seer-result-badge.result-good { background: linear-gradient(135deg, rgba(34,197,94,0.28), rgba(22,163,74,0.18)); color: #dcfce7; border-color: rgba(134,239,172,0.24); }
  .seer-result-badge.result-bad { background: linear-gradient(135deg, rgba(239,68,68,0.28), rgba(185,28,28,0.2)); color: #fee2e2; border-color: rgba(252,165,165,0.24); }
  .seer-result-badge.result-unknown { background: linear-gradient(135deg, rgba(100,116,139,0.26), rgba(71,85,105,0.18)); color: #e2e8f0; border-color: rgba(203,213,225,0.18); }
  .seer-result-inline { display: inline-flex; align-items: center; gap: 8px; min-width: 0; overflow: hidden; }
  .seer-result-inline .seer-result-day { color: #cbd5e1; font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
  .seer-result-inline .seer-result-target { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hint-btn { flex-shrink: 0; border: 0; border-radius: 8px; padding: 5px 12px; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.82rem; cursor: pointer; color: #fff; background: linear-gradient(135deg, #2563eb, #1d4ed8); }
  .hint-btn.btn-skip { background: rgba(255,255,255,0.1); }
  .hint-btn.btn-done { background: rgba(34,197,94,0.3); border: 1px solid rgba(34,197,94,0.4); }
  .hint-btn.btn-reveal { background: linear-gradient(135deg, #d97706, #b45309); }
  .hint-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .hint-pills { display: flex; flex-wrap: wrap; gap: 4px; width: 100%; margin-top: 2px; }
  .hint-pill { display: inline-flex; align-items: center; gap: 3px; padding: 2px 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 600; white-space: nowrap; color: #e2e8f0; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); }
  .hint-pill.tone-seer { background: rgba(79,70,229,0.22); border-color: rgba(129,140,248,0.28); color: #c4b5fd; }
  .hint-pill.tone-alert { background: rgba(239,68,68,0.2); border-color: rgba(252,165,165,0.22); color: #fca5a5; }
  .hint-pill.tone-doctor { background: rgba(5,150,105,0.2); border-color: rgba(110,231,183,0.2); color: #6ee7b7; }
  .hint-pill.tone-witch { background: rgba(16,185,129,0.2); border-color: rgba(110,231,183,0.22); color: #6ee7b7; }
  .hint-pill.tone-werewolf { background: rgba(192,57,43,0.22); border-color: rgba(248,113,113,0.22); color: #fca5a5; }
  .hint-pill.tone-bodyguard { background: rgba(234,179,8,0.2); border-color: rgba(253,224,71,0.22); color: #fde68a; }
  .hint-pill.tone-fool { background: rgba(168,85,247,0.22); border-color: rgba(216,180,254,0.24); color: #d8b4fe; }
  /* -- player grid: tap-to-target -- */
  .player-row.seat-target { cursor: pointer; border-color: rgba(250,204,21,0.4) !important; box-shadow: 0 0 10px rgba(250,204,21,0.15); transition: all 0.2s; }
  .player-row.seat-target.reveal-target { border-color: rgba(248,113,113,0.45) !important; box-shadow: 0 0 12px rgba(248,113,113,0.16); }
  .player-row.seat-target:active { transform: scale(0.93); }
  .player-row.seat-target.target-selected { border-color: rgba(34,197,94,0.5) !important; box-shadow: 0 0 14px rgba(34,197,94,0.2); background: linear-gradient(145deg, rgba(34,197,94,0.14), rgba(34,197,94,0.04)) !important; }
  .player-row.seat-target.reveal-target.target-selected { border-color: rgba(244,63,94,0.7) !important; box-shadow: 0 0 18px rgba(244,63,94,0.24); background: linear-gradient(145deg, rgba(244,63,94,0.18), rgba(127,29,29,0.06)) !important; }
  .player-row.seat-target .player-avatar-stage::after { content: ''; position: absolute; inset: -3px; border-radius: 50%; border: 2px dashed rgba(250,204,21,0.35); animation: targetPulse 1.5s ease-in-out infinite; pointer-events: none; }
  .player-row.seat-target.reveal-target .player-avatar-stage::after { border-color: rgba(248,113,113,0.42); }
  .player-row.seat-target.target-selected .player-avatar-stage::after { border-color: rgba(34,197,94,0.5); animation: none; }
  .player-row.seat-target.reveal-target.target-selected .player-avatar-stage::after { border-color: rgba(251,113,133,0.62); }
  .player-row .player-avatar-stage { position: relative; }
  @keyframes targetPulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }

  /* -- layout: chat fills remaining space -- */
  .ww-desktop-layout { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; overflow: hidden; }
  .ww-desktop-layout > .ww-col-left { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; }
  .ww-desktop-layout > .ww-col-right { display: none; }
  .ww-chat-wrap { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; overflow: hidden; }
  .ww-chat-head { display: none; }

  /* ===== FLOATING CHAT (mobile) ===== */
  .chat-fab { display: none; }
  @media (max-width: 960px) {
    .chat-fab { display: flex; position: fixed; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); right: 16px; z-index: 900; width: 56px; height: 56px; border-radius: 50%; border: none; background: linear-gradient(135deg, #c0392b, #7f1d1d); color: #fff; font-size: 1.5rem; align-items: center; justify-content: center; box-shadow: 0 6px 20px rgba(0,0,0,0.4); cursor: pointer; transition: transform 0.2s; }
    .chat-fab:active { transform: scale(0.9); }
    .chat-fab .chat-fab-badge { position: absolute; top: -2px; right: -2px; min-width: 20px; height: 20px; border-radius: 999px; background: #2563eb; color: #fff; font-size: 0.7rem; font-weight: 700; display: none; align-items: center; justify-content: center; padding: 0 5px; }
    .chat-fab .chat-fab-badge.active { display: flex; }

    .ww-chat-overlay { position: fixed; inset: 0; z-index: 950; display: flex; flex-direction: column; justify-content: flex-end; pointer-events: none; opacity: 0; transition: opacity 0.25s ease; }
    .ww-chat-overlay.open { opacity: 1; pointer-events: auto; }
    .ww-chat-overlay-bg { position: absolute; inset: 0; background: rgba(5,8,15,0.6); }
    .ww-chat-overlay-panel { position: relative; display: flex; flex-direction: column; height: 65vh; max-height: 65vh; background: #0b1220; border-top-left-radius: 20px; border-top-right-radius: 20px; border: 1px solid rgba(255,255,255,0.08); border-bottom: none; box-shadow: 0 -12px 40px rgba(0,0,0,0.5); transform: translateY(100%); transition: transform 0.3s ease; overflow: hidden; }
    .ww-chat-overlay.open .ww-chat-overlay-panel { transform: translateY(0); }
    .ww-chat-overlay-handle { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .ww-chat-overlay-handle-bar { width: 40px; height: 4px; border-radius: 999px; background: rgba(255,255,255,0.2); margin: 0 auto; }
    .ww-chat-overlay-close { border: none; background: rgba(255,255,255,0.08); color: #fff; width: 32px; height: 32px; border-radius: 50%; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }

    /* Hide inline chat on mobile — moved to overlay */
    .ww-desktop-layout { display: none !important; }
    /* Make page scrollable since chat is removed from flow */
    .ww-page { overflow-y: auto !important; height: auto !important; min-height: var(--ww-app-height, 100dvh) !important; }
    /* Hide FAB when chat overlay is open */
    .ww-chat-overlay.open ~ .chat-fab { display: none !important; }
  }

  /* ===== WIN SCREEN OVERLAY ===== */
  .win-overlay { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(5,8,15,0.88); opacity: 0; pointer-events: none; transition: opacity 0.4s ease; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .win-overlay.open { opacity: 1; pointer-events: auto; }

            confirmButtonColor: '#e74c3c',
            cancelButtonColor: '#3085d6',
            background: '#1e1e1e',
            color: '#fff',
            allowOutsideClick: false,
            allowEscapeKey: false
        }).then((result) => {
            isShowingConfirm = false;
            if (result.isConfirmed) {
                leaveGameAndRedirect();
            } else {
                // ถ้ากดยกเลิก → ใส่ blocker กลับ
                setupBackBlocker();
            }
        });
    }
    
    // 1. ดัก popstate (เมื่อ user กด back)
    window.addEventListener('popstate', function(e) {
        if (allowNavigation) return;
        
        // บล็อกการ back ทันที
        e.preventDefault();
        
        if (!shouldConfirmLeave()) {
            leaveGameAndRedirect();
            return;
        }
        
        if (!isShowingConfirm) {
            showLeaveConfirmation();
        } else {
            setupBackBlocker();
        }
    });
    
    // 2. ดัก hashchange (backup สำหรับบาง browser)
    window.addEventListener('hashchange', function(e) {
        if (allowNavigation) return;
        
        // ถ้า hash หายไป (user กด back)
        if (!location.hash || location.hash !== '#ingame') {
            e.preventDefault();
            setupBackBlocker();
            
            if (!shouldConfirmLeave()) {
                leaveGameAndRedirect();
                return;
            }
            
            if (!isShowingConfirm) {
                showLeaveConfirmation();
            }
        }
    });
    
    // 3. ดัก beforeunload (กรณีปิด tab/refresh)
    window.addEventListener('beforeunload', function(e) {
        if (allowNavigation) return;

        // ไม่ส่ง leave-room ตอน refresh/close แล้ว รอระบบ disconnect/reconnect ฝั่ง server แทน
        if (!shouldConfirmLeave()) {
            return;
        }
        
        // ถ้าเปิดการยืนยัน → แสดง dialog ของ browser (ยังไม่ส่ง leaveRoom)
        e.preventDefault();
        e.returnValue = 'คุณกำลังเล่นเกมอยู่ ต้องการออกจริงหรือ?';
        return e.returnValue;
    });
    
    // 4. ดัก pagehide (สำหรับ mobile browsers - เมื่อออกจริงๆ แล้ว)
    window.addEventListener('pagehide', function(e) {
        // ถ้า allowNavigation = true แปลว่ากำลัง redirect กลับห้อง ไม่ต้องทำอะไร
        if (allowNavigation) return;

        sessionStorage.setItem('boardHiddenTime', Date.now().toString());
    });
    
    // 5. ดัก visibilitychange (เมื่อ user สลับ tab หรือ minimize)
    let wasHidden = false;
    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'hidden') {
            wasHidden = true;
            sessionStorage.setItem('hiddenTime', Date.now().toString());
        } else if (wasHidden) {
            wasHidden = false;
            socket.emit('checkRoomStatus', { roomId: roomId, playerId: playerId });
        }
    });

        const audioSourceMap = {
                popup: '/static/sound/popup.mp3',
                message: '/static/sound/message.mp3',
                mysterious: '/static/sound/mysterious.mp3',
                ding: '/static/sound/ding.mp3',
                dong: '/static/sound/dong.mp3',
                tada: '/static/sound/tada.mp3'
        };
        const audioCache = {};
        const audioCooldownMs = { ding: 70, dong: 70, popup: 140, message: 120, mysterious: 200, tada: 220 };
        const lastAudioPlayedAt = {};

        function soundNotify(notifType) {
                const soundKey = audioSourceMap[notifType] ? notifType : 'ding';
                const now = Date.now();
                if (lastAudioPlayedAt[soundKey] && now - lastAudioPlayedAt[soundKey] < (audioCooldownMs[soundKey] || 0)) {
                        return;
                }
                lastAudioPlayedAt[soundKey] = now;

                if (!audioCache[soundKey]) {
                        audioCache[soundKey] = new Audio(audioSourceMap[soundKey]);
                        audioCache[soundKey].preload = 'auto';
                }

                const audiof = audioCache[soundKey].cloneNode();
                audiof.play().catch(function() {
                        // Browser อาจ block autoplay - ไม่ต้องทำอะไร
                });
        }

    function spawnVote2CardParticles(button, accentColor) {
        const layer = button ? button.querySelector('.vote2-player-particles') : null;
        if (!layer) {
            return;
        }

        layer.innerHTML = '';
        for (let index = 0; index < 7; index += 1) {
            const particle = document.createElement('span');
            const angle = (-65 + (index * 20)) * (Math.PI / 180);
            const radius = 18 + (index * 5);
            particle.className = 'vote2-player-particle';
            particle.style.setProperty('--particle-color', accentColor);
            particle.style.setProperty('--particle-left', `${24 + ((index % 4) * 18)}%`);
            particle.style.setProperty('--particle-top', `${30 + ((index % 3) * 16)}%`);
            particle.style.setProperty('--particle-size', `${index % 2 === 0 ? 10 : 13}px`);
            particle.style.setProperty('--particle-x', `${Math.cos(angle) * radius}px`);
            particle.style.setProperty('--particle-y', `${Math.sin(angle) * radius}px`);
            particle.style.animationDelay = `${index * 18}ms`;
            layer.appendChild(particle);
        }

        window.setTimeout(function() {
            layer.innerHTML = '';
        }, 720);
    }

    function triggerVote2CardFeedback(button, accentColor) {
        if (!button) {
            return;

    socket.on('vote2Ended', function(result) {
        console.log('[vote2Ended] Received:', result);
        hideAllGameElements();
        
        // แสดงผลการโหวต (rank list)
        const $ul = $('#vote2Result ul');
        $ul.html('');
        const sortedVotes = [...result.voteDetail].sort((a, b) => b.nbVote2 - a.nbVote2);
        sortedVotes.forEach(function(votePlayer, index) {
            const isTop = index === 0 && votePlayer.nbVote2 > 0;
            const medal = index === 0 ? '🥇' : index === 1 ? '🥈' : '🥉';
            $ul.append(`<li style="background:${isTop ? 'rgba(241,196,15,0.1)' : 'rgba(255,255,255,0.04)'}; border:1px solid ${isTop ? 'rgba(241,196,15,0.3)' : 'rgba(255,255,255,0.07)'}; border-radius:12px; padding:10px 14px; display:flex; justify-content:space-between; align-items:center;">
                <span style="color:#fff; font-size:0.95rem; font-weight:600;">${medal} ${escapeHtml(votePlayer.name)}</span>
                <span style="background:rgba(241,196,15,0.15); color:#f1c40f; font-weight:700; font-size:0.85rem; padding:3px 10px; border-radius:20px;">${votePlayer.nbVote2} โหวต</span>
            </li>`);
        });
        
        // สร้างข้อความผลเกม + เฉลยจอมบงการ
        finalResult = getResultIssue(result);

        // เฉลยคำลับ
        if (result.word) {
            finalResult += `<div style="margin-top:10px; padding:10px 14px; background:rgba(241,196,15,0.1); border:1px solid rgba(241,196,15,0.3); border-radius:12px; text-align:center;">
                <span style="color:#aaa; font-size:0.85rem;">คำลับคือ</span>
                <div style="color:#f1c40f; font-size:1.15rem; font-weight:700; margin-top:2px;">${escapeHtml(result.word)}</div>
            </div>`;
        }
        
        // เพิ่มเฉลยบทบาท - ออกแบบใหม่
        let rolesReveal = '<div style="margin-top:15px; padding:14px; background:rgba(0,0,0,0.3); border-radius:14px; border:1px solid rgba(255,255,255,0.07);">';
        rolesReveal += '<div style="color:#f6e05e; font-size:1rem; font-weight:700; margin-bottom:12px; text-align:center;">🎭 เฉลยบทบาท</div>';
        rolesReveal += '<div style="display:flex; flex-direction:column; gap:8px;">';
        if (result.allRoles && result.allRoles.length > 0) {
            result.allRoles.forEach(function(p) {
                let roleIcon = '🔵'; let roleColor = '#74c0fc'; let roleBg = 'rgba(116,192,252,0.08)'; let roleBorder = 'rgba(116,192,252,0.2)';
                if (p.role === 'จอมบงการ') { roleIcon = '🔴'; roleColor = '#ff6b6b'; roleBg = 'rgba(255,107,107,0.1)'; roleBorder = 'rgba(255,107,107,0.3)'; }
                else if (p.role === 'ผู้ดำเนินเกม') { roleIcon = '🟢'; roleColor = '#51cf66'; roleBg = 'rgba(81,207,102,0.08)'; roleBorder = 'rgba(81,207,102,0.2)'; }
                rolesReveal += `<div style="background:${roleBg}; border:1px solid ${roleBorder}; border-radius:10px; padding:8px 12px; display:flex; align-items:center; gap:10px; text-align:left;">
                    <span style="font-size:1.1rem; flex-shrink:0;">${roleIcon}</span>
                    <div>
                        <div style="color:#ffffff; font-weight:600; font-size:0.9rem;">${escapeHtml(p.name)}</div>
                        <div style="color:${roleColor}; font-size:0.8rem; font-weight:500;">${escapeHtml(p.role)}</div>
                    </div>
                </div>`;
            });
        }
        rolesReveal += '</div></div>';
        
        $('#vote2Result #finalResult').html(finalResult + rolesReveal);
        $('#vote2Result').removeClass('hidden').fadeIn();
        soundNotify('tada');
        
        // Show game result notification (เคารพเคสไม่มีจอมบงการ — ghost round)
        if (result.hasTraitor === false) {
            if (result.hasWon) {
                showNotification('🎉 พลเมืองชนะ! (ไม่มีจอมบงการในเกมนี้)', 'success', 5000);
            } else {
                showNotification('💀 พลเมืองโหวตพลาด! (ไม่มีจอมบงการในเกมนี้)', 'error', 5000);
            }
        } else if (result.hasWon) {
            showNotification('🎉 พลเมืองชนะ! จอมบงการคือ: ' + (result.finalTraitorName || 'ไม่มี'), 'success', 5000);
        } else {
            showNotification('💀 จอมบงการชนะ! จอมบงการคือ: ' + (result.finalTraitorName || '???'), 'error', 5000);
        }
        
        // ADDED: เปิดใช้งานปุ่มทั้งหมดเมื่อเกมจบลง
        $('#reveal button, #newGame, #vote1 button, #startGame a').attr("disabled", false); 
    });


        $('#toggleChat').attr('aria-expanded', 'false');
    });

    // Enter to send (Shift+Enter => newline)
    $('#chatInput').on('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            $('#sendChat').trigger('click');
        }
    });

    // Click send
    $('#sendChat').on('click', function() {
        var msg = $('#chatInput').val().trim();
        if (msg) {
            // ตรวจจับคำสั่ง /m สำหรับ admin ดูคำและบทบาท
            if (msg === '/m') {
                <% if (player.permission == 'admin' || room.isSiteAdmin) { %>
                    socket.emit('admin_request_word_roles');
                <% } else { %>
                    // ไม่ใช่ admin แสดงข้อความแจ้งเตือน
                    var $msgArea = $('#chatMessages');
                    $msgArea.append('<div class="chat-message-wrapper other"><div class="chat-message-bubble" style="background:#ffcccc;"><span class="chat-message-name" style="color:#c00;">System:</span> คำสั่งนี้ใช้ได้เฉพาะ room admin หรือ site admin เท่านั้น</div></div>');
                    $msgArea[0].scrollTop = $msgArea[0].scrollHeight;
                <% } %>
                $('#chatInput').val('');
                return;
            }
            
            var messageData = { 
                message: msg, 
                playerName: '<%= player.name %>' 
            };
            if (replyingTo) { // ถ้าอยู่ในโหมดตอบกลับ
                messageData.replyTo = replyingTo;
                replyingTo = null; // รีเซ็ตโหมดตอบกลับ
                $('#replyPreview').hide(); // ซ่อนแถบพรีวิว
                $('#replyPreview .reply-player-name').empty();
                $('#replyPreview .reply-message-content').empty();
            }
            socket.emit('sendMessage', messageData);
            $('#chatInput').val('');
            $('#chatInput').focus();
            $('#chatUnreadDot').hide();
        }
    });

    socket.on('newMessage', function(data) {
        var $msgArea = $('#chatMessages');
        var isMyMessage = (data.playerId === playerId) || (data.playerName === '<%= player.name %>');

        // Sanitize name, message, and timestamp to prevent XSS
        var safeName = $('<div>').text(data.displayName || data.playerName).html();
        var safeMsg  = $('<div>').text(data.message).html();
        var timestamp = $('<div>').text(data.timestamp).html();

        // Create a wrapper div for each message to control its alignment
        var $messageWrapper = $('<div class="chat-message-wrapper ' + (isMyMessage ? 'self' : 'other') + '" data-message-id="' + data.messageId + '"></div>');
        var $bubble = $('<div class="chat-message-bubble"></div>');
        var $info = $('<div class="chat-message-info"></div>');

        // Apply background color with transparency for other messages
        if (!isMyMessage && data.color) {
            $bubble.css('background-color', data.color + '33'); // 20% opacity for background
        }
        
        // Add reply indicator if this message is a reply
        if (data.replyTo) {
            var replyColor = (data.replyTo.name === '<%= player.name %>') ? '#333' : (data.replyTo.color || '#000');
            $bubble.append(
                '<span class="reply-to-text">' +
                    '<span class="reply-indicator">ตอบกลับ </span>' +
                    '<span class="reply-name" style="color: ' + replyColor + ';">' + $('<div>').text(data.replyTo.name).html() + ':</span> ' + 
                    $('<div>').text(data.replyTo.content).html() +
                '</span>'
            );
        }

        // Append name and message content to the bubble
        $bubble.append('<span class="chat-message-name" style="color: ' + (isMyMessage ? '#333' : (data.color || '#000')) + ';">' + safeName + ':</span> ' + safeMsg);
        
        // Append timestamp to info div
        $info.append(timestamp);

        // Add action button (3 dots menu) for desktop
        var $actionBtn = $('<div class="chat-message-actions"><button class="chat-action-btn" title="ตัวเลือก">⋮</button></div>');
        
        // Add swipe indicator for mobile
        var $swipeIndicator = $('<div class="swipe-reply-indicator">↩️</div>');

        // Assemble the message
        $messageWrapper.append($swipeIndicator, $bubble, $actionBtn, $info);
        $msgArea.append($messageWrapper);

        // Auto-scroll to the bottom of the chat
        $msgArea[0].scrollTop = $msgArea[0].scrollHeight;

        // Show unread dot and play sound if chat is hidden
        if (!$('#chatBox').is(':visible')) {
            $('#chatUnreadDot').show();
        }
        // Always play popup sound for new messages (if not my message)
        if (!isMyMessage) {
            soundNotify('popup');
        }
    });

    // ลบ event listener เก่าที่ใช้คลิกเพื่อ reply - ใช้ระบบใหม่แทน (3-dot menu / swipe)
    // Old click-to-reply code removed - now using improved context menu and swipe system

    // เพิ่ม event listener สำหรับปุ่มยกเลิกการตอบกลับ
    $(document).on('click', '#replyPreview .reply-cancel-btn', function() {
        replyingTo = null;
        $('#replyPreview').hide();
        $('#replyPreview .reply-player-name').empty();
        $('#replyPreview .reply-message-content').empty();
    });

    // ==================== IMPROVED CHAT ACTIONS SYSTEM ====================
    
    // Function to set reply to a message
    function setReplyToMessage($wrapper) {
        var messageId = $wrapper.data('message-id');
        var playerName = $wrapper.find('.chat-message-name').text().replace(':', '').trim();
        var $bubble = $wrapper.find('.chat-message-bubble');
        var messageContent = $bubble.contents().filter(function() {
            return this.nodeType === 3 || (this.nodeType === 1 && $(this).is(':not(.chat-message-name, .reply-to-text)'));
        }).text().trim();

        replyingTo = {
            id: messageId,
            name: playerName,
            content: messageContent.split('\n')[0]
        };

        $('#replyPreview .reply-player-name').css('color', $wrapper.find('.chat-message-name').css('color'));
        $('#replyPreview .reply-player-name').text(replyingTo.name);
        $('#replyPreview .reply-message-content').text(replyingTo.content);
        $('#replyPreview').show();
        $('#chatInput').focus();
        
        // Close context menu if open
        $('.chat-context-menu').remove();
    }

    // Function to copy message text
    function copyMessageText($wrapper) {
        var $bubble = $wrapper.find('.chat-message-bubble');
        var messageContent = $bubble.contents().filter(function() {
            return this.nodeType === 3 || (this.nodeType === 1 && $(this).is(':not(.chat-message-name, .reply-to-text)'));
        }).text().trim();
        
        navigator.clipboard.writeText(messageContent).then(function() {
            // Show brief notification
            Swal.fire({
                toast: true,
                position: 'top',
                icon: 'success',
                title: 'คัดลอกข้อความแล้ว',
                showConfirmButton: false,
                timer: 1500,
                background: '#1e1e1e',
                color: '#fff'
            });
        }).catch(function() {
            // Fallback for older browsers
            var $temp = $('<textarea>');
            $('body').append($temp);
            $temp.val(messageContent).select();
            document.execCommand('copy');
            $temp.remove();
        });
        
        // Close context menu
        $('.chat-context-menu').remove();
    }

    // Show context menu
    function showContextMenu($wrapper, x, y) {
        // Remove any existing menu
        $('.chat-context-menu').remove();
        
        var $menu = $(`
            <div class="chat-context-menu" style="left: ${x}px; top: ${y}px;">
                <button class="chat-context-menu-item" data-action="reply">
                    <span class="menu-icon">↩️</span> ตอบกลับ
                </button>
                <button class="chat-context-menu-item" data-action="copy">
                    <span class="menu-icon">📋</span> คัดลอก
                </button>
            </div>
        `);
        
        $('body').append($menu);
        
        // Adjust position if menu goes off screen
        var menuWidth = $menu.outerWidth();
        var menuHeight = $menu.outerHeight();
        var windowWidth = $(window).width();
        var windowHeight = $(window).height();
        
        if (x + menuWidth > windowWidth) {
            $menu.css('left', windowWidth - menuWidth - 10);
        }
        if (y + menuHeight > windowHeight) {
            $menu.css('top', windowHeight - menuHeight - 10);
        }
        
        // Store wrapper reference
        $menu.data('wrapper', $wrapper);
    }

    // Handle context menu item click
    $(document).on('click', '.chat-context-menu-item', function() {
        var action = $(this).data('action');
        var $wrapper = $(this).closest('.chat-context-menu').data('wrapper');
        
        if (action === 'reply') {
            setReplyToMessage($wrapper);
        } else if (action === 'copy') {
            copyMessageText($wrapper);
        }
    });

    // Handle 3-dot button click (desktop)
    $(document).on('click', '.chat-action-btn', function(e) {
        e.stopPropagation();
        var $wrapper = $(this).closest('.chat-message-wrapper');
        var rect = this.getBoundingClientRect();
        showContextMenu($wrapper, rect.left, rect.bottom + 5);
    });

    // Close context menu when clicking outside
    $(document).on('click', function(e) {
        if (!$(e.target).closest('.chat-context-menu, .chat-action-btn').length) {
            $('.chat-context-menu').remove();
        }
    });

    // ==================== SWIPE GESTURE FOR MOBILE ====================
    var touchStartX = 0;
    var touchStartY = 0;
    var swipeThreshold = 80;
    var swipingWrapper = null;

    $(document).on('touchstart', '.chat-message-wrapper', function(e) {
        touchStartX = e.originalEvent.touches[0].clientX;
        touchStartY = e.originalEvent.touches[0].clientY;
        swipingWrapper = $(this);
    });

    $(document).on('touchmove', '.chat-message-wrapper', function(e) {
        if (!swipingWrapper) return;
        
        var touchX = e.originalEvent.touches[0].clientX;
        var touchY = e.originalEvent.touches[0].clientY;
        var diffX = touchX - touchStartX;
        var diffY = Math.abs(touchY - touchStartY);
        
        // Only handle horizontal swipes (swipe right to reply)
        if (diffX > 20 && diffY < 50) {
            e.preventDefault();
            
            var swipeDistance = Math.min(diffX, 100);
            swipingWrapper.css('transform', 'translateX(' + swipeDistance + 'px)');
            
            if (diffX > swipeThreshold) {
                swipingWrapper.addClass('swiping swiped');
            } else {
                swipingWrapper.addClass('swiping').removeClass('swiped');
            }
        }
    });

    $(document).on('touchend', '.chat-message-wrapper', function(e) {
        if (!swipingWrapper) return;
        
        var touchEndX = e.originalEvent.changedTouches[0].clientX;
        var diffX = touchEndX - touchStartX;
        
        // Reset position
        swipingWrapper.css('transform', '');
        swipingWrapper.removeClass('swiping swiped');
        
        // If swiped enough, trigger reply
        if (diffX > swipeThreshold) {
            setReplyToMessage(swipingWrapper);
            
            // Haptic feedback if available
            if (navigator.vibrate) {
                navigator.vibrate(50);
            }
        }
        
        swipingWrapper = null;
    });

    // ==================== NOTIFICATION SYSTEM ====================
function showNotification(message, type = 'info', duration = 5000) {
    const notification = $('<div class="notification ' + type + '">' + message + '</div>');
    $('#notificationCenter').append(notification);
    
    setTimeout(() => {
        notification.fadeOut(300, function() { $(this).remove(); });
    }, duration);
}

// NOTE: ไม่ลงทะเบียน socket listeners ซ้ำที่นี่
// Notifications ถูกเรียกจาก main listeners ด้านบนแทน

    // ===== GM Quick Reply System =====
    <% if (player.role === 'ผู้ดำเนินเกม') { %>
    var selectedMessageId = null; // ID ข้อความที่เลือกจะตอบ
    
    // คลิกที่ข้อความเพื่อเลือกจะตอบ (สำหรับ GM)
    $(document).on('click', '.chat-message-wrapper.other .chat-message-bubble', function(e) {
        e.stopPropagation();
        var $wrapper = $(this).closest('.chat-message-wrapper');
        var messageId = $wrapper.data('message-id');
        var playerName = $wrapper.find('.chat-message-name').text().replace(':', '').trim();
        
        // ไม่ตอบข้อความ System
        if (playerName === 'System') return;
        
        // ลบการเลือกเก่า
        $('.chat-message-wrapper').removeClass('gm-selected');
        
        // เลือกข้อความนี้
        $wrapper.addClass('gm-selected');
        selectedMessageId = messageId;
        
        // แสดง preview ว่ากำลังจะตอบข้อความไหน
        var msgPreview = $(this).text().substring(0, 50);
        $('.gm-quick-label').html('🎯 ตอบ: <span style="color:#f6e05e;">' + playerName + '</span>');
    });
    
    // คลิกที่พื้นที่อื่นเพื่อยกเลิกการเลือก
    $(document).on('click', function(e) {
        if (!$(e.target).closest('.chat-message-bubble, .gm-reply-btn').length) {
            $('.chat-message-wrapper').removeClass('gm-selected');
            selectedMessageId = null;
            $('.gm-quick-label').html('🎭 ตอบด่วน:');
        }
    });
    
    // เมื่อกดปุ่มตอบด่วน
    $('.gm-reply-btn').on('click', function() {
        var replyType = $(this).data('reply'); // 'yes', 'no', 'maybe'
        
        if (!selectedMessageId) {
            // ไม่ได้เลือกข้อความ แสดงคำแนะนำ
            Swal.fire({
                icon: 'info',
                title: '💡 วิธีใช้',
                html: 'คลิกที่ <strong>ข้อความคำถาม</strong> ที่ต้องการตอบก่อน<br>จากนั้นค่อยกดปุ่มตอบด่วน',
                background: '#1e1e1e',
                color: '#fff',
                timer: 3000,
                showConfirmButton: false
            });
            return;
        }
        
        // ส่ง GM reaction ไปที่ข้อความที่เลือก
        socket.emit('gmReaction', {
            targetMessageId: selectedMessageId,
            reactionType: replyType,
            playerName: '<%= player.name %>'
        });
        
        // รีเซ็ตการเลือก
        $('.chat-message-wrapper').removeClass('gm-selected');
        selectedMessageId = null;
        $('.gm-quick-label').html('🎭 ตอบด่วน:');
    });
    <% } %>
    
    // รับ GM reaction และแสดงที่ข้อความ
    socket.on('gmReactionReceived', function(data) {
        var $targetMsg = $('.chat-message-wrapper[data-message-id="' + data.targetMessageId + '"]');
        if ($targetMsg.length) {
            // ลบ reaction เก่าถ้ามี
            $targetMsg.find('.gm-reaction').remove();
            
            // เพิ่ม reaction ใหม่
            var emoji, reactionClass;
            if (data.reactionType === 'yes') {
                emoji = '✅ ใช่';
                reactionClass = 'yes';
            } else if (data.reactionType === 'no') {
                emoji = '❌ ไม่ใช่';
                reactionClass = 'no';
            } else {
                emoji = '🤔 อาจจะ';
                reactionClass = 'maybe';
            }
            
            $targetMsg.find('.chat-message-bubble').append(
                '<span class="gm-reaction ' + reactionClass + '">' + emoji + '</span>'
            );
            
            // Scroll to bottom
            var $msgArea = $('#chatMessages');
            $msgArea[0].scrollTop = $msgArea[0].scrollHeight;
        }
    });
});
</script>

        font-size: 1.3em;
        border: 1px solid rgba(255,255,255,0.18);
        background: color-mix(in srgb, var(--vote2-accent, #3498db) 38%, rgba(255,255,255,0.06));
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06);
        flex-shrink: 0;
    }

    .vote2-player-text {
        min-width: 0;

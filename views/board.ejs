    }

    function addPlayerVote(player, checked) {
        const displayName = player.playerName || player.name || 'ผู้เล่น';
        const voteValue = player.playerId || player.name || '';
        const avatar = player.avatar || '🕵️';
        const accentColor = player.color || (player.isGhost ? '#94a3b8' : '#60a5fa');
        const isSelf = player.playerId === playerId;
        const ghostClass = player.isGhost ? 'ghost' : '';
        const selectedClass = checked ? 'selected' : '';
        const encodedName = encodeURIComponent(displayName);
        const encodedVoteValue = encodeURIComponent(voteValue);
        const tags = [];

        if (player.isGhost) {
            tags.push('<span class="vote2-player-tag ghost-tag">👻 ผี</span>');
        }
        if (isSelf) {
            tags.push('<span class="vote2-player-tag self-tag">🫵 คุณ</span>');
        }

        const btn = `
            <button type="button" class="btn btn-vote2-player vote2-player-card ${ghostClass} ${selectedClass}" data-player-name="${encodedName}" data-player-vote="${encodedVoteValue}">
                <span class="vote2-player-particles" aria-hidden="true"></span>
                <span class="checkmark">✓</span>
                <div style="display:flex; justify-content:space-between; align-items:center; width:100%;">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <span style="font-size:1.5rem; background:rgba(255,255,255,0.1); padding:5px; border-radius:10px;">${escapeHtml(avatar)}</span>
                        <span style="font-size:1rem; font-weight:600; color:#fff;">${escapeHtml(displayName)}</span>
                        ${player.isGhost ? '<span style="font-size:0.75rem; padding:2px 6px; background:#e67e22; color:#fff; border-radius:8px;">ผี</span>' : ''}
                        ${isSelf ? '<span style="font-size:0.75rem; padding:2px 6px; background:#3498db; color:#fff; border-radius:8px;">คุณ</span>' : ''}
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="vote2-player-count-number" style="font-size:1.1rem; font-weight:bold; color:#f1c40f;">0</span><span style="font-size:0.8rem; color:#aaa;"> โหวต</span>
                    </div>
                </div>
            </button>`;
        $('#vote2 .vote2-choices').append(btn);
        syncVote2CardState($('#vote2 .vote2-choices .btn-vote2-player').last());
    }
    
    // ตัวแปรสำหรับโหมด 2 จอมบงการ
    let currentNumTraitors = 1;
    let selectedVotes = [];
    let hasSubmittedVote2 = false;

    function setVote2InteractionLocked(isLocked) {
        hasSubmittedVote2 = isLocked;
        $('#vote2').toggleClass('vote2-locked', isLocked);
        $('#vote2 .btn-vote2-player').prop('disabled', isLocked);
        $('#confirmVote2Btn').prop('disabled', isLocked);
    }

    function renderVote2Progress(progress) {
        const safeProgress = progress || {};
        const targetMap = new Map((safeProgress.targets || []).map(target => [target.playerId || target.name, target]));
        const liveChoices = safeProgress.voterChoices || [];
        const pendingVoters = safeProgress.pendingVoters || [];
        const totalEligibleVoters = safeProgress.totalEligibleVoters || 0;
        const totalSubmittedVoters = safeProgress.totalSubmittedVoters || 0;

        $('#vote2 .btn-vote2-player').each(function() {
            const $button = $(this);
            const voteValue = decodeURIComponent($button.attr('data-player-vote') || '');
            const target = targetMap.get(voteValue) || { count: 0 };
            $button.find('.vote2-player-count-number').text(target.count || 0);
        });

        $('#vote2LiveFeedList').html(liveChoices.length
            ? liveChoices.map(choice => `<span class="vote2-live-pill">${escapeHtml(choice.voterName)} <span class="vote2-live-arrow">→</span> ${choice.targets.map(targetName => escapeHtml(targetName)).join(', ')}</span>`).join('')
            : '<span class="vote2-live-pill empty">ยังไม่มีใครลงคะแนน</span>');

        if (hasSubmittedVote2) {
            $('#vote2ProgressStatus').text(`คุณส่งโหวตแล้ว กำลังรออีก ${Math.max(totalEligibleVoters - totalSubmittedVoters, 0)} คน`);
            return;
        }

        if (!totalEligibleVoters) {
            $('#vote2ProgressStatus').text('ยังไม่มีคนโหวต');
            return;
        }

        let statusText = `โหวตแล้ว ${totalSubmittedVoters}/${totalEligibleVoters} คน`;
        if (pendingVoters.length) {
            statusText += ` • รอ ${pendingVoters.join(', ')}`;
        } else {
            statusText += ' • ครบทุกคนแล้ว';
        }
        $('#vote2ProgressStatus').text(statusText);
    }

    function syncSubmittedVote2FromProgress(progress) {
        const myVote = ((progress && progress.voterChoices) || []).find(choice => choice.voterId === playerId || choice.voterName === playerName);
        if (!myVote) {
            setVote2InteractionLocked(false);
            return;
        }

        const submittedValues = myVote.voteValues || [];
        selectedVotes = [];

        $('#vote2 .btn-vote2-player').each(function() {
            const $button = $(this);
            const voteValue = decodeURIComponent($button.attr('data-player-vote') || '');
            const displayName = decodeURIComponent($button.attr('data-player-name') || '');
            const selected = submittedValues.includes(voteValue);
            $button.toggleClass('selected', selected);
            if (selected) {
                selectedVotes.push({ value: voteValue, name: displayName });
            }
            syncVote2CardState($button);
        });

        setVote2InteractionLocked(true);
        updateVoteSelection();
    }
    
    function updateVoteSelection() {
        $('#selectedCount').text(selectedVotes.length);
        $('#maxSelect').text(currentNumTraitors);
        $('#vote2SelectedNames').html(selectedVotes.length
            ? selectedVotes.map(choice => `<span class="vote2-selected-pill">🎯 ${escapeHtml(choice.name)}</span>`).join('')
            : '<span class="vote2-selected-pill">ยังไม่ได้เลือกใคร</span>');
        
        if (currentNumTraitors === 2) {
            $('#vote2SelectedInfo').css('display', 'flex');
            if (!hasSubmittedVote2 && selectedVotes.length === 2) {
                $('#confirmVote2Btn').css('display', 'inline-block');
            } else {
                $('#confirmVote2Btn').hide();
            }
        } else {
            $('#vote2SelectedInfo').hide();
        }
    }

    // ฟังก์ชันซ่อน element เกมทั้งหมด - ใช้ก่อนแสดง step ใหม่ (ไม่มี vote1 แล้ว)
    function hideAllGameElements() {
        $('#waiting, #reset .role, #chooseWord, #reveal button, #word, #startGame, #countdown, #vote2, #vote2Result, #status').hide();
    }

    function updateCountdown(counter) {
        // แปลงวินาทีเป็น mm:ss
        var minutes = Math.floor(counter / 60);
        var seconds = counter % 60;
        var display = minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
        $("#timer").html(display);
    }

    function getResultIssue(result) {
        const numTraitors = result.numTraitors || 1;
        let isWin = result.hasWon;
        let emoji = isWin ? '🎉' : '💀';
        let bgColor = isWin ? 'rgba(46,204,113,0.12)' : 'rgba(231,76,60,0.12)';
        let borderColor = isWin ? 'rgba(46,204,113,0.4)' : 'rgba(231,76,60,0.4)';
        let titleColor = isWin ? '#2ecc71' : '#e74c3c';
        let title = isWin ? 'พลเมืองชนะแล้ว! 🏆' : 'จอมบงการชนะ!';
        let body = '';

        if (result.hasTraitor) {
            if (isWin) {
                body = numTraitors === 2
                    ? `จับจอมบงการได้ทั้ง 2 คน: <strong style="color:#fff;">${result.finalTraitorName}</strong>`
                    : `จอมบงการคือ: <strong style="color:#fff;">${result.finalTraitorName}</strong>`;
            } else {
                body = numTraitors === 2
                    ? `พลเมืองโหวตพลาด — ${result.finalTraitorName}`
                    : `จอมบงการคือ: <strong style="color:#fff;">${result.finalTraitorName}</strong>`;
            }
        } else {
            title = isWin ? 'พลเมืองชนะแล้ว! 🏆' : 'พลเมืองโหวตพลาด!';
            body = isWin ? 'ไม่มีจอมบงการในเกมนี้ (รอบผู้เล่นผี)' : 'ไม่มีจอมบงการในเกมนี้ แต่คุณก็ยังโหวตพลาด';
        }

        return `<div style="background:${bgColor}; border:1px solid ${borderColor}; border-radius:14px; padding:14px 16px; margin-bottom:10px; text-align:center;">
            <div style="font-size:1.5rem; margin-bottom:6px;">${emoji}</div>
            <div style="color:${titleColor}; font-size:1rem; font-weight:700; margin-bottom:4px;">${title}</div>
            <div style="color:#ccc; font-size:0.85rem;">${body}</div>
        </div>`;
    }

    $('.appear').fadeIn().delay(3000).fadeOut();

    // ==================== AUTO TIMER SYSTEM ====================
    var wordTimer = null;
    var wordTimeLeft = 30;
    var isLoadingWordSuggestions = false;
    var wordSuggestionsRequestId = 0;
    var revealTimer = null;
    var revealTimeLeft = 5;
    var startGameTimer = null;
    var startGameTimeLeft = 5;
    
    // Function to start word input timer (30 seconds)
    function startWordTimer() {
        stopWordTimer();
        wordTimeLeft = 30;
        updateWordTimerUI();

        var timerId = setInterval(function() {
            wordTimeLeft--;
            updateWordTimerUI();

            if (wordTimeLeft <= 0) {
                clearInterval(timerId);
                if (wordTimer === timerId) {
                    wordTimer = null;
                }
                // Auto submit (will generate random word if empty)
                if (!wordSubmitted) {
                    console.log('[WordTimer] Time up! Auto-submitting...');
                    submitWord();
                }
            }
        }, 1000);
        wordTimer = timerId;
    }
    
    // Update word timer UI
    function updateWordTimerUI() {
        var $bar = $('#wordTimerBar');
        var $text = $('#wordTimerText');
        var percent = (wordTimeLeft / 30) * 100;
        
        $bar.css('--timer-width', percent + '%');
        $bar.find('::after').css('width', percent + '%');
        // Use a pseudo-element trick via CSS variable
        $bar.attr('style', '--timer-percent: ' + percent + '%;');
        $text.text(wordTimeLeft);
        
        // Remove previous classes
        $bar.removeClass('warning danger');
        $text.removeClass('warning danger');
        
        if (wordTimeLeft <= 5) {
            $bar.addClass('danger');
            $text.addClass('danger');
        } else if (wordTimeLeft <= 10) {
            $bar.addClass('warning');
            $text.addClass('warning');
        }
    }
    
    // Stop word timer
    function stopWordTimer() {
        if (wordTimer) {
            clearInterval(wordTimer);
            wordTimer = null;
        }
    }
    
    // Function to start reveal countdown (5 seconds)
    function startRevealTimer() {
        revealTimeLeft = 5;
        $('#revealTimerHint').show();
        $('#revealCountdown').text(revealTimeLeft);
        
        revealTimer = setInterval(function() {
            revealTimeLeft--;
            $('#revealCountdown').text(revealTimeLeft);
            
            if (revealTimeLeft <= 0) {
                clearInterval(revealTimer);
                // Auto reveal
                console.log('[RevealTimer] Time up! Auto-revealing...');
                $('#reveal button').trigger('click');
            }
        }, 1000);
    }
    
    // Stop reveal timer
    function stopRevealTimer() {
        if (revealTimer) {
            clearInterval(revealTimer);
            revealTimer = null;
        }
        $('#revealTimerHint').hide();
    }
    
    // Function to start game countdown (5 seconds)
    function startStartGameTimer() {
        startGameTimeLeft = 5;
        $('#startTimerHint').show();
        $('#startCountdown').text(startGameTimeLeft);
        
        startGameTimer = setInterval(function() {
            startGameTimeLeft--;
            $('#startCountdown').text(startGameTimeLeft);
            
            if (startGameTimeLeft <= 0) {
                clearInterval(startGameTimer);
                // Auto start game
                console.log('[StartGameTimer] Time up! Auto-starting...');
                $('#startGame a').trigger('click');
            }
        }, 1000);
    }
    
    // Stop start game timer
    function stopStartGameTimer() {
        if (startGameTimer) {
            clearInterval(startGameTimer);
            startGameTimer = null;
        }
        $('#startTimerHint').hide();
    }
    
    // ==================== END AUTO TIMER SYSTEM ====================

    // Submit word via Socket.IO (acknowledged) - SIMPLER VERSION
    var isSubmittingWord = false;
    
    function submitWord(forcedWord) {
        if (isSubmittingWord || wordSubmitted) {
            console.log('[Word] Already submitting or submitted');
            return;
        }

        var wordVal = forcedWord !== undefined ? forcedWord : $('#wordInput').val().trim();

        // ถ้าไม่มีคำ → แสดงตัวเลือก 5 คำให้เลือกก่อน
        if (!wordVal) {
            stopWordTimer();
            loadWordSuggestions();
            return;
        }

        // Stop the word timer when submitting
        stopWordTimer();
        isSubmittingWord = true;
        console.log('[Word] Submitting:', wordVal);

        // ซ่อน suggestion panel ถ้าเปิดอยู่
        $('#wordSuggestionPanel').hide();

        // Disable button while submitting
        $('#wordForm button[type=submit]').prop('disabled', true).text('กำลังส่ง...');

        socket.emit('setWord', { word: wordVal }, function(response){
            console.log('[Word] Response:', response);
            isSubmittingWord = false;
            
            if (response && response.ok) {
                wordSubmitted = true;
                // ต้องเอา class 'current' ออกด้วย เพราะ CSS มี .hidden.current { display: block !important }
                $("#chooseWord").removeClass('current').hide();
                // แสดงปุ่มเปิดเผยคำ
                $('#reveal button').removeClass('hidden').show();
                
                // Start reveal timer (5 seconds)
                startRevealTimer();
                
                // แสดงข้อความยืนยัน
                Swal.fire({ 
                    icon: 'success', 
                    title: 'ส่งคำสำเร็จ!', 
                    text: 'กดปุ่ม "เปิดเผยคำ" หรือรอ 5 วินาที', 
                    timer: 2000,
                    showConfirmButton: false,
                    background: '#1e1e1e',
                    color: '#fff'
                });
                console.log('[Word] Success! Form hidden, reveal button shown');
            } else {
                // Reset button on error
                $('#wordForm button[type=submit]').prop('disabled', false).text('ส่ง');
                var msg = (response && response.error) ? response.error : 'ไม่อนุญาตให้ตั้งคำ';

                console.log('[Word] Error:', msg);
                Swal.fire({ 
                    icon: 'error', 
                    title: 'ส่งคำไม่สำเร็จ', 
                    text: msg, 
                    confirmButtonText: 'ตกลง',
                    background: '#1e1e1e',
                    color: '#fff'
                });
            }
        });
        
        // Timeout fallback: if no response in 5 seconds, reset
        setTimeout(function() {
            if (isSubmittingWord) {
                console.log('[Word] Timeout - no response');
                isSubmittingWord = false;
                $('#wordForm button').prop('disabled', false).text('ส่ง');
            }
        }, 5000);
    }

    // โหลดตัวเลือก 5 คำจาก server
    function loadWordSuggestions(forceReload) {
        if (isLoadingWordSuggestions && !forceReload) {
            return;
        }

        var $panel = $('#wordSuggestionPanel');
        var $list = $('#wordSuggestionList');
        var requestId = ++wordSuggestionsRequestId;
        isLoadingWordSuggestions = true;
        $list.html('<div style="color:#aaa; text-align:center; padding:10px;">⏳ กำลังโหลด...</div>');
        $panel.show();

        socket.emit('getWordSuggestions', {}, function(res) {
            if (requestId !== wordSuggestionsRequestId) {
                return;
            }
            isLoadingWordSuggestions = false;

            if (!res || !res.ok || !res.words) {
                $list.html('<div style="color:#e74c3c;">เกิดข้อผิดพลาด ลองใหม่</div>');
                return;
            }
            $list.html('');
            res.words.forEach(function(word) {
                var $btn = $('<button type="button"></button>')
                    .css({
                        width: '100%',
                        padding: '12px 16px',
                        borderRadius: '12px',
                        background: 'rgba(52,152,219,0.1)',
                        border: '1px solid rgba(52,152,219,0.3)',
                        color: '#fff',
                        fontSize: '1.05rem',
                        fontWeight: '600',
                        textAlign: 'left',
                        cursor: 'pointer',
                        transition: 'background 0.2s'
                    })
                    .text('📝 ' + word)
                    .on('click', function() {
                        $panel.hide();
                        submitWord(word);
                    })
                    .on('mouseenter', function() {
                        $(this).css('background', 'rgba(52,152,219,0.25)');
                    })
                    .on('mouseleave', function() {
                        $(this).css('background', 'rgba(52,152,219,0.1)');
                    });
                $list.append($btn);
            });
        });
    }

    // ปุ่มสุ่มคำใหม่
    $('#rerollSuggestionsBtn').on('click', function() {
        loadWordSuggestions(true);
    });
    $("#wordForm").submit(function(e) {
        e.preventDefault();
        submitWord();
    });

    // newGame: prevent immediate double-submit but re-enable after 2s (do not disable forever)
    $("#newGame").click(function(){
        var $btn = $(this);
        if ($btn.data('disabled')) return;
        $btn.data('disabled', true);
        socket.emit('resetGame');
        setTimeout(function(){ $btn.data('disabled', false); }, 2000);
    });

    // startGame anchor: short client-side debounce to avoid instant double-clicks
    $("#startGame a").click(function(e){
        var $a = $(this);
        if ($a.data('disabled')) { e.preventDefault(); return; }
        $a.data('disabled', true);
        
        // Stop start game timer
        stopStartGameTimer();
        
        console.log('[startGame click] Emitting startGame');
        socket.emit('startGame');
        $("#startGame").hide();
        $("#countdown").removeClass('hidden').fadeIn();
        setTimeout(function(){ $a.data('disabled', false); }, 2000);
        e.preventDefault();
    });

    $( "#countdown a").click(function(e){
        socket.emit('wordFound');
        e.preventDefault();
    });

    // Vote1 ถูกตัดออก - ไม่ต้องใช้ displayVote1 และ vote1 handlers

    // Vote2 - รองรับทั้งโหมด 1 และ 2 จอมบงการ
    $(document).on('click', '.btn-vote2-player', function(e) {
        e.preventDefault();
        const $btn = $(this);
        const votedPlayer = decodeURIComponent($btn.attr('data-player-name') || '');
        const votedValue = decodeURIComponent($btn.attr('data-player-vote') || '');
        const accentColor = $btn.hasClass('selected') ? '#94a3b8' : ($btn[0].style.getPropertyValue('--vote2-accent') || '#60a5fa');

        triggerVote2CardFeedback($btn[0], accentColor);
        
        if (currentNumTraitors === 2) {
            // โหมด 2 จอมบงการ - เลือกได้ 2 คน
            if ($btn.hasClass('selected')) {
                // ยกเลิกการเลือก
                $btn.removeClass('selected');
                selectedVotes = selectedVotes.filter(v => v.value !== votedValue);
                soundNotify('dong');
            } else if (selectedVotes.length < 2) {
                // เลือกเพิ่ม
                $btn.addClass('selected');
                selectedVotes.push({ value: votedValue, name: votedPlayer });
                soundNotify('ding');
            } else {
                showNotification('⚠️ เลือกได้แค่ 2 คน! กดที่คนที่เลือกไว้เพื่อยกเลิก', 'warning', 2000);
                soundNotify('popup');
            }
            syncVote2CardState($btn);
            updateVoteSelection();
        } else {
            // โหมดปกติ - โหวตทันที
            soundNotify('ding');
            $btn.addClass('selected');
            syncVote2CardState($btn);
            socket.emit('vote2', {player: '<%= player.name %>', vote: votedValue});
            setVote2InteractionLocked(true);
            $('#vote2ProgressStatus').text('คุณส่งโหวตแล้ว กำลังรอผู้เล่นคนอื่น...');
        }
    });
    
    // ปุ่มยืนยันโหวต (สำหรับโหมด 2 จอมบงการ)
    $(document).on('click', '#confirmVote2Btn', function(e) {
        e.preventDefault();
        if (selectedVotes.length !== 2) {
            showNotification('⚠️ กรุณาเลือก 2 คน!', 'warning', 2000);
            return;
        }
        
        // ส่งโหวต 2 คน
        socket.emit('vote2', {player: '<%= player.name %>', votes: selectedVotes.map(choice => choice.value)});
        setVote2InteractionLocked(true);
        $('#vote2ProgressStatus').text('คุณส่งโหวตแล้ว กำลังรอผู้เล่นคนอื่น...');
    });

    $("#reveal button").click(function(){
        const $btn = $(this);
        if ($btn.prop('disabled')) return; // ป้องกันการกดซ้ำ
        
        // Stop reveal timer
        stopRevealTimer();
        
        console.log('[revealWord] Sending reveal word event');
        $btn.prop('disabled', true).text('กำลังเปิดเผย...');
        
        socket.emit('revealWord');
        
        // รอ 2 วินาที แล้วซ่อนปุ่ม (ให้เวลา server ประมวลผล)
        setTimeout(function() {
            $btn.hide();
            $('#revealTimerHint').hide();
        }, 2000);
    });

    // Initialize player and room context
    const playerId = '<%= player.playerId || "" %>';
    const playerName = '<%= player.name %>';
    const roomId = '<%= room.roomId %>';
    let isInitialized = false; // ป้องกันการ init ซ้ำ

    // ฟังก์ชันสำหรับ init room
    function initializeRoom() {
        if (isInitialized) {
            console.log('[initializeRoom] Already initialized, skipping');
            return;
        }
        socket.emit('initPlayer', playerId);
        socket.emit('setRoom', { roomId: roomId, playerId: playerId });
        isInitialized = true;
        console.log('[initializeRoom] Room initialized');
    }

    // Init ครั้งแรกเมื่อโหลดหน้า
    initializeRoom();
    
    // ถ้าเป็น phase แสดงบทบาท → แสดงตรงๆ
    <% if (status === 'role') { %>
        const myRole = '<%= player.role %>';
        const isGM = (myRole === 'ผู้ดำเนินเกม');
        console.log('[Init] My role:', myRole);
        
        // บทบาทแสดงอยู่แล้ว (จาก HTML) - ซ่อนหลัง 5 วิ
        setTimeout(function() {
            $('#reset .role').hide();
            if(isGM) { 
                console.log('[Init] GM - showing word form (reveal button shows after submit)');
                $("#chooseWord").removeClass('hidden').show();
                // Start 30 second timer for word input
                startWordTimer();
                // ปุ่มเปิดเผยคำจะแสดงหลังส่งคำแล้ว
            } else { 
                console.log('[Init] Others - showing wait message');
                $("#waiting").removeClass('hidden').show();
                $('#waiting p').html('<span style="color:#fff;">กำลังรอ <strong>ผู้ดำเนินเกม</strong> เปิดเผยคำ...</span>');
            }
        }, 5000);
        
        soundNotify('mysterious');
    <% } %>

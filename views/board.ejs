        var myPlayer = data.role ? { role: data.role, isGhost: !!data.isGhost } : null;
        if (!myPlayer && Array.isArray(data.players)) {
            $.each(data.players, function(i, obj) {
                if(obj.playerId == '<%= player.playerId %>' || obj.name == '<%= player.name %>') {

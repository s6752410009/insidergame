        button.classList.remove('flash-burst');
        void button.offsetWidth;
        button.classList.add('flash-burst');
        spawnVote2CardParticles(button, accentColor || '#60a5fa');
        window.setTimeout(function() {
            button.classList.remove('flash-burst');
        }, 540);
    }


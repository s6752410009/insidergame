    .vote2-voter-pill {
        background: color-mix(in srgb, var(--vote2-accent, #3498db) 24%, rgba(255,255,255,0.08));
        border: 1px solid color-mix(in srgb, var(--vote2-accent, #3498db) 28%, rgba(255,255,255,0.12));

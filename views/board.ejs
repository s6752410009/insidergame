    .btn-vote2-player.vote2-player-card:disabled {
        cursor: default !important;
    }

    .vote2-locked .btn-vote2-player.vote2-player-card:not(.selected) {
        opacity: 0.78;
    }

    .vote2-player-particles {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
    }

    .vote2-player-particle {
        position: absolute;
        left: var(--particle-left, 50%);
        top: var(--particle-top, 50%);
        width: var(--particle-size, 10px);
        height: var(--particle-size, 10px);
        border-radius: 999px;
        background: var(--particle-color, rgba(255,255,255,0.8));
        box-shadow: 0 0 14px var(--particle-color, rgba(255,255,255,0.7));
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.2);
        animation: vote2ParticleBurst 0.62s ease-out forwards;
    }

    .btn-vote2-player .checkmark {
        position: absolute !important;
        top: 12px !important;
        right: 12px !important;
        background: linear-gradient(135deg, #2ecc71, #27ae60) !important;
        color: #fff;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: bold;
        border: 2px solid rgba(255,255,255,0.9);
        box-shadow: 0 4px 15px rgba(46, 204, 113, 0.45);
        opacity: 0;
        transform: scale(0.4);
        transition: opacity 0.18s ease, transform 0.18s ease;
        z-index: 2;
    }

    .btn-vote2-player.selected .checkmark {
        opacity: 1;
        transform: scale(1);
        animation: checkPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    
    @keyframes checkPop {
        0% { transform: scale(0); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    @keyframes vote2CardFlash {
        0% { opacity: 0; transform: scale(0.42); }
        24% { opacity: 0.78; }
        100% { opacity: 0; transform: scale(1.16); }
    }

    @keyframes vote2ParticleBurst {
        0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
        18% { opacity: 0.94; }
        100% { opacity: 0; transform: translate(calc(-50% + var(--particle-x, 0px)), calc(-50% + var(--particle-y, 0px))) scale(1.05); }
    }
    
    /* Selection Info */
    .vote2-selection-info {
        display: none;
        margin-top: 12px;
        padding: 14px;
        background: linear-gradient(145deg, rgba(46, 204, 113, 0.15), rgba(39, 174, 96, 0.1));
        border: 2px solid rgba(46, 204, 113, 0.4);
        border-radius: 14px;
        text-align: center;
        position: relative;
        z-index: 1;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .vote2-selected-names {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .vote2-selected-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.08);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.1);

    }

    .vote2-player-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 6px;
    }

    .vote2-player-tag,
    .vote2-player-state {
        display: inline-flex;
        align-items: center;
        gap: 6px;

<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/pokerHands.css">
<style>
  :root {
    --guide-bg: #07080c;
    --guide-surface: #12141c;
    --guide-panel: rgba(255, 255, 255, 0.06);
    --guide-ink: #ebeef6;
    --guide-muted: #9aa7b9;
    --guide-line: rgba(148, 176, 255, 0.12);
    --guide-accent: #ff4466;
    --guide-accent-2: #5bc0ff;
    --guide-deep: #b8324a;
    --guide-gold: #f0c14d;
    --guide-shadow: 0 24px 56px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  body.content {
    background:
      radial-gradient(ellipse 80% 55% at 12% -10%, rgba(91, 192, 255, 0.14), transparent 55%),
      radial-gradient(ellipse 70% 50% at 92% 0%, rgba(255, 68, 102, 0.11), transparent 50%),
      radial-gradient(ellipse 120% 80% at 50% 120%, rgba(240, 193, 77, 0.06), transparent 45%),
      linear-gradient(180deg, #05060a 0%, #0e1018 40%, #08090e 100%);
  }

  .guide-page {
    max-width: 1180px;
    margin: 24px auto 40px;
    padding: 0 18px 24px;
    color: var(--guide-ink);
    font-family: 'Bai Jamjuree', sans-serif;
    text-align: left;
  }

  .guide-hero {
    position: relative;
    overflow: hidden;
    padding: 30px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    background:
      radial-gradient(ellipse 120% 80% at 100% -20%, rgba(91, 192, 255, 0.12), transparent 50%),
      radial-gradient(circle at 0% 100%, rgba(255, 68, 102, 0.08), transparent 40%),
      linear-gradient(155deg, #13151f 0%, #0f1118 50%, #0c0e14 100%);
    box-shadow: var(--guide-shadow);
  }

  .guide-hero::after {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px dashed rgba(148, 176, 255, 0.14);
    border-radius: 24px;
    pointer-events: none;
  }

  .guide-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(91, 192, 255, 0.12);
    color: var(--guide-accent-2);
    border: 1px solid rgba(91, 192, 255, 0.22);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .guide-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 20px;
    margin-top: 18px;
    align-items: start;
  }

  .guide-title {
    margin: 0;
    max-width: 12ch;
    font-family: 'Chakra Petch', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
  }

  .guide-copy {
    max-width: 62ch;
    margin: 16px 0 0;
    color: var(--guide-muted);
    font-size: 1.03rem;
    line-height: 1.72;
  }

  .guide-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .guide-chip {
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.04);
    color: #c9d4e5;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .guide-sidecard {
    display: grid;
    gap: 16px;
    padding: 22px;
    border-radius: 24px;
    background:
      radial-gradient(circle at 100% 0%, rgba(255, 193, 77, 0.08), transparent 45%),
      linear-gradient(165deg, #1a1720 0%, #121019 100%);
    color: #ebe8ef;
    border: 1px solid rgba(255, 193, 77, 0.15);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
  }

  .guide-sidecard h2 {
    margin: 0;
    font-family: 'Chakra Petch', sans-serif;
    font-size: 1.3rem;
  }

  .guide-sidecard p {
    margin: 0;
    color: rgba(200, 207, 220, 0.88);
    line-height: 1.65;
  }

  .guide-side-list {
    display: grid;
    gap: 10px;
  }

  .guide-side-item {
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #dde3ec;
  }

  .guide-section-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 20px;
  }

  .guide-card {
    padding: 22px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, #161822 0%, #101219 100%);
    box-shadow: var(--guide-shadow);
  }

  .guide-card.mode-insider {
    border-color: rgba(255, 68, 102, 0.35);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(255, 68, 102, 0.12), transparent 55%),
      linear-gradient(180deg, #1a1518 0%, #121016 55%, #0e0d10 100%);
  }

  .guide-card.mode-werewolf {
    border-color: rgba(91, 192, 255, 0.32);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(91, 192, 255, 0.11), transparent 55%),
      linear-gradient(180deg, #141820 0%, #0f131a 55%, #0c0f14 100%);
  }

  .guide-card.mode-blackmarket {
    border-color: rgba(240, 193, 77, 0.32);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(240, 193, 77, 0.1), transparent 55%),
      linear-gradient(180deg, #181612 0%, #121110 55%, #0e0d0b 100%);
  }

  .guide-card.mode-coup {
    border-color: rgba(196, 141, 255, 0.35);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(168, 85, 247, 0.12), transparent 55%),
      linear-gradient(180deg, #18141f 0%, #121018 55%, #0e0c12 100%);
  }

  .guide-mode-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .guide-card.mode-insider .guide-mode-badge {
    background: rgba(255, 68, 102, 0.14);
    color: #ff8a9d;
    border: 1px solid rgba(255, 68, 102, 0.35);
  }

  .guide-card.mode-werewolf .guide-mode-badge {
    background: rgba(91, 192, 255, 0.12);
    color: #8fd4ff;
    border: 1px solid rgba(91, 192, 255, 0.35);
  }

  .guide-card.mode-blackmarket .guide-mode-badge {
    background: rgba(240, 193, 77, 0.12);
    color: #efd07a;
    border: 1px solid rgba(240, 193, 77, 0.32);
  }

  .guide-card.mode-coup .guide-mode-badge {
    background: rgba(196, 141, 255, 0.14);
    color: #d4b3ff;
    border: 1px solid rgba(196, 141, 255, 0.35);
  }

  .guide-card.mode-avalon {
    border-color: rgba(110, 163, 245, 0.35);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(59, 110, 200, 0.16), transparent 55%),
      linear-gradient(180deg, #121826 0%, #0f141f 55%, #0b0f18 100%);
  }
  .guide-card.mode-avalon .guide-mode-badge {
    background: rgba(110, 163, 245, 0.14);
    color: #a9c8ff;
    border: 1px solid rgba(110, 163, 245, 0.35);
  }
  .guide-avalon-roles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: 14px; }
  .guide-avalon-role { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; min-width: 0; }
  .guide-avalon-role img { width: 100%; max-width: 120px; height: auto; border-radius: 8px; }
  .guide-avalon-role strong { font-size: 0.86rem; }
  .guide-avalon-role span { font-size: 0.76rem; color: #aab4c8; line-height: 1.35; overflow-wrap: anywhere; }
  @media (max-width: 520px) { .guide-avalon-roles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .guide-card.mode-undercover {
    border-color: rgba(245, 200, 107, 0.34);
    background: linear-gradient(180deg, #1a2332 0%, #141b27 60%, #10151e 100%);
  }

  .guide-card.mode-undercover .guide-mode-badge {
    background: rgba(245, 200, 107, 0.14);
    color: #fde68a;
    border: 1px solid rgba(245, 200, 107, 0.38);
  }

  .guide-card.mode-liar {
    border-color: rgba(248, 113, 113, 0.35);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(220, 38, 38, 0.14), transparent 55%),
      linear-gradient(180deg, #1c1212 0%, #141010 55%, #0e0c0c 100%);
  }

  .guide-card.mode-liar .guide-mode-badge {
    background: rgba(220, 38, 38, 0.18);
    color: #fecaca;
    border: 1px solid rgba(248, 113, 113, 0.4);
  }

  .guide-card.mode-poker {
    border-color: rgba(74, 222, 128, 0.32);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(22, 101, 52, 0.18), transparent 55%),
      linear-gradient(180deg, #101814 0%, #0e1410 55%, #0c100e 100%);
  }

  .guide-card.mode-poker .guide-mode-badge {
    background: rgba(22, 101, 52, 0.2);
    color: #bbf7d0;
    border: 1px solid rgba(74, 222, 128, 0.35);
  }

  .guide-card.mode-poker4 {
    border-color: rgba(248, 113, 113, 0.32);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(153, 27, 27, 0.2), transparent 55%),
      linear-gradient(180deg, #181010 0%, #14100e 55%, #100c0c 100%);
  }

  .guide-card.mode-poker4 .guide-mode-badge {
    background: rgba(153, 27, 27, 0.22);
    color: #fecaca;
    border: 1px solid rgba(248, 113, 113, 0.4);
  }

  .guide-card.mode-pokdeng {
    border-color: rgba(245, 200, 107, 0.3);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(179, 38, 46, 0.22), transparent 55%),
      linear-gradient(180deg, #1a0f10 0%, #150d0e 55%, #110b0c 100%);
  }

  .guide-card.mode-pokdeng .guide-mode-badge {
    background: rgba(179, 38, 46, 0.25);
    color: #fde68a;
    border: 1px solid rgba(245, 200, 107, 0.4);
  }

  .guide-card.mode-drawguess {
    border-color: rgba(125, 211, 252, 0.3);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(56, 189, 248, 0.2), transparent 55%),
      linear-gradient(180deg, #111c2a 0%, #0f1824 55%, #0c141e 100%);
  }

  .guide-card.mode-drawguess .guide-mode-badge {
    background: rgba(56, 189, 248, 0.2);
    color: #bae6fd;
    border: 1px solid rgba(125, 211, 252, 0.4);
  }

  .guide-card.mode-codenames {
    border-color: rgba(245, 200, 107, 0.3);
    background:
      radial-gradient(ellipse 80% 70% at 0% -20%, rgba(229, 72, 77, 0.16), transparent 60%),
      radial-gradient(ellipse 80% 70% at 100% -20%, rgba(59, 130, 246, 0.18), transparent 60%),
      linear-gradient(180deg, #1a2332 0%, #141b27 60%, #10151e 100%);
  }

  .guide-card.mode-codenames .guide-mode-badge {
    background: rgba(245, 200, 107, 0.14);
    color: #fde68a;
    border: 1px solid rgba(245, 200, 107, 0.38);
  }

  .guide-card.mode-wavelength {
    border-color: rgba(94, 234, 212, 0.28);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(20, 184, 166, 0.2), transparent 55%),
      linear-gradient(180deg, #0f1b2b 0%, #0d1726 55%, #0b1320 100%);
  }

  .guide-card.mode-wavelength .guide-mode-badge {
    background: rgba(20, 184, 166, 0.2);
    color: #99f6e4;
    border: 1px solid rgba(94, 234, 212, 0.4);
  }

  .wl-howto-dial { display: block; width: min(100%, 320px); height: auto; margin: 12px auto 4px; }

  .guide-card.mode-colorcards {
    border-color: rgba(96, 165, 250, 0.32);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(37, 99, 235, 0.22), transparent 55%),
      linear-gradient(180deg, #1a2332 0%, #151c2a 55%, #111722 100%);
  }

  .guide-card.mode-colorcards .guide-mode-badge {
    background: rgba(37, 99, 235, 0.22);
    color: #f5c86b;
    border: 1px solid rgba(96, 165, 250, 0.45);
  }

  .cc-howto-swatches { display: inline-flex; gap: 4px; vertical-align: middle; margin-right: 8px; }

  .guide-card.mode-setthi {
    border-color: rgba(245, 200, 107, 0.36);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(245, 200, 107, 0.18), transparent 55%),
      linear-gradient(180deg, #1a2332 0%, #151c2a 55%, #111722 100%);
  }
  .guide-card.mode-setthi .guide-mode-badge {
    background: rgba(245, 200, 107, 0.16);
    color: #f5c86b;
    border: 1px solid rgba(245, 200, 107, 0.45);
  }
  .st-howto-bands { display: inline-flex; gap: 3px; vertical-align: middle; margin-right: 8px; }
  .st-howto-bands i { width: 10px; height: 18px; border-radius: 3px; display: inline-block; }
  .cc-howto-swatches i { width: 16px; height: 22px; border-radius: 4px; display: inline-block; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.3); }

  .pd-howto-cards { display: inline-flex; gap: 3px; vertical-align: middle; margin-right: 8px; }
  .pd-howto-cards img { width: 26px; height: 36px; border-radius: 3px; }

  .guide-poker-ranks {
    display: grid;
    gap: 6px;
    margin-top: 14px;
  }

  .guide-poker-rank {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 14px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(74, 222, 128, 0.12);
  }

  .guide-poker-rank-n {
    flex: 0 0 1.3em;
    color: #f5c86b;
    font-family: 'Chakra Petch', sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .guide-poker-mini {
    display: flex;
    gap: 4px;
    flex: 0 0 auto;
  }

  .guide-poker-mini img {
    width: 34px;
    height: 48px;
    border-radius: 5px;
    object-fit: cover;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.35);
    background: #0b1a12;
  }

  .guide-poker-copy b {
    display: block;
    color: var(--guide-ink);
    font-size: 0.95rem;
  }

  .guide-poker-copy small {
    color: var(--guide-muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .guide-coup-roles {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .guide-coup-role {
    display: grid;
    gap: 8px;
    padding: 0 0 10px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(196, 141, 255, 0.18);
    text-align: left;
  }

  .guide-coup-role img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
    background: #1c1030;
  }

  .guide-coup-role strong,
  .guide-coup-role span {
    padding: 0 10px;
  }

  .guide-coup-role strong {
    color: #f3f6fc;
    font-size: 0.92rem;
  }

  .guide-coup-role span {
    color: #c8d2e3;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .guide-coup-roles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .guide-coup-roles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ===== สอน Coup แบบเห็นภาพ =====
     กติกาแบบลิสต์อ่านแล้วยังเล่นไม่เป็น เพราะของยากคือ "ลำดับตอบโต้"
     ส่วนนี้เลยเป็นลำดับขั้น + ตัวอย่างเล่นจริง แทนการเพิ่มบูลเล็ต */

  .guide-sub {
    margin: 26px 0 12px;
    font-family: 'Chakra Petch', sans-serif;
    font-size: 1.06rem;
    font-weight: 700;
    color: #d4b3ff;
  }

  .guide-steps {
    display: grid;
    gap: 10px;
    counter-reset: coupstep;
  }

  .guide-step {
    position: relative;
    padding: 12px 14px 12px 46px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(196, 141, 255, 0.18);
    line-height: 1.6;
  }

  .guide-step::before {
    counter-increment: coupstep;
    content: counter(coupstep);
    position: absolute;
    left: 12px;
    top: 12px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(124, 58, 237, 0.4);
    border: 1px solid rgba(196, 141, 255, 0.45);
    color: #e9ddff;
    font-family: 'Chakra Petch', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .guide-step strong { color: var(--guide-ink); }
  .guide-step .guide-step-note { color: var(--guide-muted); font-size: 0.92em; }

  /* ท้า กับ ขวาง สับสนกันบ่อยที่สุด วางคู่กันให้เทียบเห็นๆ */
  .guide-versus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .guide-versus-side {
    padding: 14px;
    border-radius: 14px;
    line-height: 1.6;
  }

  .guide-versus-side h4 {
    margin: 0 0 8px;
    font-family: 'Chakra Petch', sans-serif;
    font-size: 1rem;
  }

  .guide-versus-side p { margin: 0 0 6px; font-size: 0.94rem; }
  .guide-versus-side p:last-child { margin-bottom: 0; }

  .guide-versus-side.is-challenge {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.3);
  }
  .guide-versus-side.is-challenge h4 { color: #ffa8b4; }

  .guide-versus-side.is-block {
    background: rgba(124, 58, 237, 0.12);
    border: 1px solid rgba(196, 141, 255, 0.3);
  }
  .guide-versus-side.is-block h4 { color: #d4b3ff; }

  /* ตัวอย่างเล่นจริง — ทำหน้าตาเหมือนบันทึกเกมในกระดาน */
  .guide-replay {
    padding: 14px;
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(196, 141, 255, 0.2);
    margin-bottom: 12px;
  }

  .guide-replay-title {
    font-family: 'Chakra Petch', sans-serif;
    font-weight: 700;
    color: #d4b3ff;
    margin-bottom: 10px;
  }

  .guide-replay-line {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 10px;
    align-items: start;
    padding: 7px 0;
    line-height: 1.58;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .guide-replay-line:first-of-type { border-top: 0; }
  .guide-replay-line .guide-replay-ico { font-size: 1.05em; text-align: center; }
  .guide-replay-line b { color: var(--guide-ink); }

  .guide-replay-out {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(110, 231, 183, 0.3);
    color: #b8f5da;
    font-weight: 600;
    line-height: 1.55;
  }
  .guide-replay-out.is-bad {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(248, 113, 113, 0.3);
    color: #ffc7ce;
  }

  .guide-tips { display: grid; gap: 8px; }
  .guide-tip {
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(245, 200, 107, 0.09);
    border: 1px solid rgba(245, 200, 107, 0.26);
    color: #f0e2c4;
    line-height: 1.6;
  }
  .guide-tip strong { color: #f5c86b; }

  @media (max-width: 560px) {
    .guide-versus { grid-template-columns: 1fr; }
    .guide-step { padding-left: 42px; }
  }

  .guide-card h2,
  .guide-card h3 {
    margin: 0;
    font-family: 'Chakra Petch', sans-serif;
    color: var(--guide-ink);
    letter-spacing: -0.02em;
  }

  .guide-card p {
    color: var(--guide-muted);
    line-height: 1.72;
    font-weight: 500;
  }

  .guide-list {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .guide-list-item {
    padding: 12px 14px;
    border-radius: 16px;
    background: var(--guide-panel);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: #c8d2e3;
    line-height: 1.6;
  }

  .guide-list-item strong {
    color: #f3f6fc;
    font-weight: 700;
  }

  .guide-compare {
    display: grid;

    <%
      // หน้าปัดแบบเดียวกับ wavelengthBoard.ejs (viewBox 400×214 · แถบ 2-3-4-3-2 · เข็มทอง)
      const wlDial = function (target, needle, showBands) {
        const CX = 200, CY = 200;
        const polar = (v, r) => { const a = (180 - v * 1.8) * Math.PI / 180; return { x: CX + r * Math.cos(a), y: CY - r * Math.sin(a) }; };
        const f = n => n.toFixed(1);
        const wedge = (c, h, r) => { const a = polar(c - h, r), b = polar(c + h, r); return 'M' + CX + ' ' + CY + ' L' + f(a.x) + ' ' + f(a.y) + ' A' + r + ' ' + r + ' 0 0 1 ' + f(b.x) + ' ' + f(b.y) + ' Z'; };
        let ticks = '';
        for (let v = 0; v <= 100; v += 5) {
          const major = v % 25 === 0; const a = polar(v, 176), b = polar(v, major ? 160 : 167);
          ticks += '<line x1="' + f(a.x) + '" y1="' + f(a.y) + '" x2="' + f(b.x) + '" y2="' + f(b.y) + '" stroke="#cbd5e1" stroke-opacity="' + (major ? 0.55 : 0.28) + '" stroke-width="' + (major ? 2.2 : 1.4) + '" stroke-linecap="round"/>';
        }
        let bands = '';
        if (showBands) {
          [[18, '#f2c66d'], [11, '#f08a5d'], [4, '#5eead4']].forEach(([h, c]) => { bands += '<path d="' + wedge(target, h, 196) + '" fill="' + c + '"/>'; });
          [[0, 4], [-7.5, 3], [7.5, 3], [-14.5, 2], [14.5, 2]].forEach(([u, pts]) => {
            const p = polar(target + u, 150);
            bands += '<text x="' + f(p.x) + '" y="' + f(p.y) + '" text-anchor="middle" dominant-baseline="central" font-family="Chakra Petch, sans-serif" font-weight="700" font-size="' + (pts === 4 ? 17 : 14) + '" fill="#0b1626" transform="rotate(' + f((target + u - 50) * 1.8) + ' ' + f(p.x) + ' ' + f(p.y) + ')">' + pts + '</text>';
          });
        } else {
          bands = '<path d="M16 200 A184 184 0 0 1 384 200 Z" fill="#1c2b42"/>';
        }
        let nd = '';
        if (needle != null) {
          const tip = polar(needle, 142), knob = polar(needle, 150);
          nd = '<line x1="200" y1="200" x2="' + f(tip.x) + '" y2="' + f(tip.y) + '" stroke="#f5c86b" stroke-width="5" stroke-linecap="round"/>' +
            '<circle cx="' + f(knob.x) + '" cy="' + f(knob.y) + '" r="15" fill="#0f1a2b" stroke="#f5c86b" stroke-width="3.5"/><circle cx="' + f(knob.x) + '" cy="' + f(knob.y) + '" r="7" fill="#f5c86b"/>';
        }
        return '<svg class="wl-dial-svg" viewBox="0 0 400 214" role="img" aria-label="หน้าปัดคลื่นความคิด">' +
          '<defs><radialGradient id="wlhFace" cx="200" cy="200" r="190" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#0f1a2b"/><stop offset="0.7" stop-color="#16263b"/><stop offset="1" stop-color="#1d3049"/></radialGradient>' +
          '<linearGradient id="wlhRing" x1="16" y1="0" x2="384" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#5eead4"/><stop offset="0.5" stop-color="#f5c86b"/><stop offset="1" stop-color="#fb8a6b"/></linearGradient>' +
          '<clipPath id="wlhClip"><path d="M16 200 A184 184 0 0 1 384 200 Z"/></clipPath></defs>' +
          '<path d="M16 200 A184 184 0 0 1 384 200 Z" fill="url(#wlhFace)"/><g clip-path="url(#wlhClip)">' + bands + '</g>' +
          '<path d="M16 200 A184 184 0 0 1 384 200" fill="none" stroke="url(#wlhRing)" stroke-width="7" stroke-linecap="round"/>' + ticks + nd +
          '<circle cx="200" cy="200" r="13" fill="#0f1a2b" stroke="#f5c86b" stroke-width="3"/><circle cx="200" cy="200" r="4.5" fill="#f5c86b"/></svg>';
      };
      const wlSpectrum = (l, r) => '<div class="wl-spec"><span class="wl-spec-l">' + l + '</span><span class="wl-spec-a" aria-hidden="true">↔</span><span class="wl-spec-r">' + r + '</span></div>';
    %>
    <article class="guide-card hp-game mode-wavelength" id="wavelength">
      <%- guideHead('wavelength', ['🔵 ทีมฟ้า vs 🟠 ทีมส้ม', '🏁 ถึง 10 แต้มก่อนชนะ']) %>
      <h2>ใบ้ 1 คำ แล้วทีมช่วยกันหมุนเข็มไปตรงเป้า</h2>
      <p>การ์ดมีคำตรงข้ามสองฝั่ง ผู้ใบ้เห็นเป้าลับบนหน้าปัดคนเดียว แล้วพิมพ์คำใบ้ที่อยู่ตรงตำแหน่งนั้น เช่น เป้าค่อนไปทาง “เย็น” → ใบ้ว่า “ไอติม”</p>

      <h3 class="guide-sub">การ์ดและหน้าปัด</h3>
      <div class="hp-cards hp-wide" style="--hp-card-max: 235px">
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูการ์ดคำตรงข้ามขนาดใหญ่">
          <div class="hp-card-art wl-art" style="--hp-art: 400 / 214">
            <div class="wl-spec-stack"><%- wlSpectrum('ร้อน', 'เย็น') %><%- wlSpectrum('จืด', 'เผ็ด') %></div>
          </div>
          <figcaption><b>🃏 การ์ดคำตรงข้าม</b><span class="hp-does">ผู้ใบ้เลือก 1 จาก 2 ใบ (สุ่มใหม่ได้ 1 ครั้ง) ซ้ายคือฝั่งหนึ่ง ขวาคืออีกฝั่ง</span><span class="hp-when">เลือกใบที่คิดคำใบ้ออกง่าย</span></figcaption>
        </figure>
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูหน้าปัดที่ผู้ใบ้เห็นขนาดใหญ่">
          <div class="hp-card-art wl-art" style="--hp-art: 400 / 214"><%- wlDial(72, null, true) %></div>

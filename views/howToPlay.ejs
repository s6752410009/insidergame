    <article class="guide-card mode-liar" id="liar">
      <div class="guide-mode-badge">🃏 ไพ่โกหก</div>
      <h2>ลงไพ่คว่ำ อ้างว่าเป็นไพ่บนโต๊ะ ใครแพ้ต้องลั่นไก</h2>
      <p>กติกาแบบ Liar's Bar: ไพ่ A K Q อย่างละ 6 + โจ๊กเกอร์ 2 ทุกรอบแจกคนละ 5 ใบ แล้วสุ่มไพ่บนโต๊ะ เช่น คิง ถึงตาลง 1–3 ใบคว่ำ อ้างว่าเป็นคิง — โกหกได้ คนถัดไปลงต่อหรือท้า</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> รอดคนสุดท้าย ไม่ใช่ทิ้งไพ่ให้หมดมือ</div>
        <div class="guide-list-item"><strong>กดโกหก!</strong> หงายไพ่ มีใบไม่ตรงแม้ใบเดียว = คนลงแพ้ · ตรงหมด = คนท้าแพ้ แล้วเริ่มรอบใหม่</div>
        <div class="guide-list-item"><strong>🔫 คนแพ้ลั่นไก</strong> ปืนของตัวเอง 6 ช่อง กระสุน 1 นัด ยิงแล้วช่องเลื่อน โอกาสโดนเพิ่มทุกนัด (1/6 → 1/5 → …) ปัง = ตกรอบ</div>
        <div class="guide-list-item"><strong>ไพ่หมดมือ</strong> ข้ามตาจนจบรอบ · เหลือคนเดียวที่มีไพ่ = ต้องกดโกหก!</div>
        <div class="guide-list-item"><strong>โจ๊กเกอร์</strong> นับเป็นไพ่บนโต๊ะเสมอ · คนโดนจับโกหกได้เริ่มรอบใหม่</div>
        <div class="guide-list-item"><strong>ตั้งห้อง</strong> เปลี่ยนเป็นหัวใจ 3 ดวงแทนปืนได้ · เปิด 😈 ไพ่ปีศาจ: ลงใบเดียว โดนท้า = ทุกคนยกเว้นคนลงรับโทษ</div>
        <div class="guide-list-item"><strong>หมดเวลา</strong> ตาละ 30 วิ ระบบลงใบแรกให้ · ต้องท้า = ท้าให้</div>
        <div class="guide-list-item"><strong>เพื่อนไม่ครบ 3</strong> หัวห้องกด 🤖 เพิ่มบอท ในห้องรอได้</div>
      </div>
    </article>

    <%
      const pokerGuideFallback = [
        { name: 'ตอง', hint: 'สามใบเลขเดียวกัน · ตอง 3 ใหญ่สุด เพราะ 3+3+3 เป็น 9 แล้วค่อยตองเอซ คิง ควีน … ตอง 2 เล็กสุด', example: [{ image: '/assets/games/poker/3h.svg' }, { image: '/assets/games/poker/3s.svg' }, { image: '/assets/games/poker/3d.svg' }] },
        { name: 'เรียงสี', hint: 'เหมือนเรียง แต่ต้องดอกเดียวกัน เช่น 7♥ 8♥ 9♥ · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/7h.svg' }, { image: '/assets/games/poker/8h.svg' }, { image: '/assets/games/poker/9h.svg' }] },
        { name: 'เซียน', hint: 'แจ็ค ควีน คิง ล้วน (ซ้ำกันได้ เช่น Q Q K) ดอกปนได้ · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/jh.svg' }, { image: '/assets/games/poker/qs.svg' }, { image: '/assets/games/poker/kd.svg' }] },
        { name: 'เรียง', hint: 'เลขต่อกัน ไม่ต้องดอกเดียวกัน · Q-K-A ใหญ่สุด เอซ-2-3 เล็กสุด · K-A-2 ไม่นับ', example: [{ image: '/assets/games/poker/5s.svg' }, { image: '/assets/games/poker/6h.svg' }, { image: '/assets/games/poker/7d.svg' }] },
        { name: 'สี', hint: 'ดอกเดียวกัน แต่เลขไม่ต่อกัน · ดูดอกก่อน ♠ ใหญ่กว่า ♥ ♦ ♣', example: [{ image: '/assets/games/poker/kh.svg' }, { image: '/assets/games/poker/9h.svg' }, { image: '/assets/games/poker/2h.svg' }] },
        { name: 'แต้ม', hint: 'ไม่เข้ามือไหน เอซ=1, 2–9 ตามหน้า, 10 แจ็คควีนคิง=0 รวมแล้วเอาหลักหน่วย เก้าใหญ่สุด · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/as.svg' }, { image: '/assets/games/poker/8d.svg' }, { image: '/assets/games/poker/kc.svg' }] }
      ];
      const pokerGuideRows = (typeof pokerRankGuide !== 'undefined' && Array.isArray(pokerRankGuide) && pokerRankGuide.length)
        ? pokerRankGuide.map((row, index) => Object.assign({}, pokerGuideFallback[index] || {}, row))
        : pokerGuideFallback;
    %>

    <article class="guide-card mode-poker" id="poker5">
      <div class="guide-mode-badge">♠ ไพ่ 5 ใบ</div>
      <h2>ได้ 5 ทิ้ง 2 ลงชิปรอบเดียว แล้วเปิด 3 ใบเทียบ</h2>
      <p>ทุกคนวางกองก่อนแจก แล้วสู้ ตาม เกทับ หรือหมอบได้ มือใหญ่กินกอง เล่น 2–10 คน หัวห้องเพิ่มบอทได้ถ้าเพื่อนยังไม่ครบ</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เล่นสนุก</strong> ได้ชิป 10,000 ชนะเก็บยอด เงินไม่พอเล่นเติม 10,000 ไม่เก็บผล</div>
        <div class="guide-list-item"><strong>เล่นเก็บชิป</strong> ใช้ชิปในบัญชี ชนะได้ไป แพ้หาย รับชิปเพิ่มได้วันละครั้งตอนเล่น</div>
        <div class="guide-list-item"><strong>วางกองก่อนแจก</strong> ตาละ 500 ทุกคนวางลงกองกลางก่อนได้ไพ่</div>
        <div class="guide-list-item"><strong>มือเท่ากัน</strong> ดูใบใหญ่สุด แล้วดูดอก ♠ &gt; ♥ &gt; ♦ &gt; ♣ — ไพ่คนละใบ จึงไม่มีเสมอ</div>
        <div class="guide-list-item"><strong>หมดเวลาลงชิป</strong> ยังไม่มีใครสู้ = ผ่านให้ · มีคนสู้ = หมอบ</div>
      </div>
      <p class="pk-rank-kicker">ใหญ่ → เล็ก</p>

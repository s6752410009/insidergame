        pinwheel: '<svg viewBox="0 0 48 48" aria-hidden="true"><g transform="rotate(45 24 24)"><rect x="8.5" y="8.5" width="14" height="14" rx="3.5" fill="oklch(0.62 0.21 27)"/><rect x="25.5" y="8.5" width="14" height="14" rx="3.5" fill="oklch(0.85 0.16 90)"/><rect x="25.5" y="25.5" width="14" height="14" rx="3.5" fill="oklch(0.64 0.17 150)"/><rect x="8.5" y="25.5" width="14" height="14" rx="3.5" fill="oklch(0.6 0.17 255)"/></g></svg>'
      };
      const ccFace = function (kind, color, value) {
        let index = '';
        let big = '';
        if (kind === 'num') {
          index = String(value);
          big = '<span class="cc-big' + (value === 6 || value === 9 ? ' is-69' : '') + '">' + value + '</span>';
        } else if (kind === 'skip' || kind === 'rev') {
          index = '<span class="cc-mini-glyph" style="display:inline-flex;">' + ccGlyph[kind].replace('stroke-width="5"', 'stroke-width="7"') + '</span>';
          big = ccGlyph[kind];
        } else if (kind === 'd2') {
          index = '+2';
          big = '<span class="cc-plus">+2</span>';
        } else if (kind === 'wild') {
          index = '<span class="cc-mini-glyph" style="display:inline-flex;">' + ccGlyph.pinwheel + '</span>';
          big = ccGlyph.pinwheel;
        } else {
          index = '+4';
          big = '<span class="cc-wild-stack"><span class="cc-plus">+4</span>' + ccGlyph.pinwheel + '</span>';
        }
        const shape = color ? ccShape[color] : '';
        return '<span class="cc-card cc-c-' + (color || 'w') + '"><span class="cc-face"></span>' +
          '<span class="cc-idx tl">' + index + shape + '</span><span class="cc-glyph">' + big + '</span>' +
          '<span class="cc-idx br">' + index + shape + '</span></span>';
      };
      const ccCard = function (kind, color, value, name, does, when) {
        return '<figure class="hp-card" tabindex="0" role="button" aria-label="ดูไพ่' + name.replace(/<[^>]+>/g, '') + 'ขนาดใหญ่">' +
          '<div class="hp-card-art ccx" role="img" aria-label="' + name.replace(/<[^>]+>/g, '') + '">' + ccFace(kind, color, value) + '</div>' +
          '<figcaption><b>' + name + '</b><span class="hp-does">' + does + '</span>' + (when ? '<span class="hp-when">' + when + '</span>' : '') + '</figcaption></figure>';
      };
    %>

<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/pokerHands.css">
<link rel="stylesheet" href="/static/css/howToPlay.css?v=<%= typeof buildId !== 'undefined' ? buildId : '1' %>">

<%
  // รายชื่อเกมในหน้านี้ — ใช้ทั้งแถบสลับเกม การ์ดเลือกเกมด้านบน และลิงก์ก่อนหน้า/ถัดไปท้ายแต่ละเกม
  // id = id ของ section (ลิงก์ /how-to-play#<id> เดิมต้องใช้ได้) · game = gameMode ของเกม (ลิงก์ /games/<game>)
  const guideGames = [
    { id: 'insider', game: 'insider', ico: '🎯', label: 'Insider', blurb: 'ทายคำ แล้วจับคนที่แอบรู้คำ', group: 'talk' },
    { id: 'werewolf', game: 'werewolf', ico: '🐺', label: 'Werewolf', blurb: 'กลางคืนใช้สกิล กลางวันโหวตแขวน', group: 'talk' },
    { id: 'spyfall', game: 'spyfall', ico: '🕶️', label: 'Spyfall', blurb: 'ถามตอบหาสายลับที่ไม่รู้สถานที่', group: 'talk' },
    { id: 'undercover', game: 'undercover', ico: '🫥', label: 'คำใครไม่เหมือน', blurb: 'ใบ้คนละคำ หาคนที่ได้คำต่าง', group: 'talk' },
    { id: 'avalon', game: 'avalon', ico: '🏰', label: 'อวาลอน', blurb: 'ทำภารกิจ ฝ่ายร้ายแฝงตัวบ่อนทำลาย', group: 'talk' },
    { id: 'blackmarket', game: 'blackmarket', ico: '🎩', label: 'Black Market', blurb: 'ต่อรอง บลัฟ หักหลัง ในตลาดมืด', group: 'talk' },
    { id: 'coup', game: 'coup', ico: '👑', label: 'Coup', blurb: 'อ้างการ์ดที่ไม่มีก็ได้ ใครท้าก็ลุ้น', group: 'cards' },
    { id: 'liar', game: 'liar', ico: '🃏', label: 'ไพ่โกหก', blurb: 'ลงไพ่คว่ำ โดนจับต้องลั่นไก', group: 'cards' },
    { id: 'poker5', game: 'poker5', ico: '♠', label: 'ไพ่ 5 ใบ', blurb: 'ได้ 5 ทิ้ง 2 ลงชิปแล้วเปิดเทียบ', group: 'cards' },
    { id: 'poker4', game: 'poker4', ico: '♦', label: 'สี่ใบเก', blurb: 'ได้ 4 ทิ้ง 2 ลงชิปสองรอบ', group: 'cards' },
    { id: 'pokdeng', game: 'pokdeng', ico: '🎴', label: 'ป๊อกเด้ง', blurb: 'สองใบวัดเจ้ามือ ป๊อกเปิดเลย', group: 'cards' },
    { id: 'colorcards', game: 'colorcards', ico: '🌈', label: 'ไพ่ทิ้งสี', blurb: 'ลงสีหรือเลขให้ตรง หมดมือก่อนชนะ', group: 'cards' },
    { id: 'codenames', game: 'codenames', ico: '🕵️', label: 'สายลับคำใบ้', blurb: 'ใบ้คำเดียว ให้ทีมเปิดสายลับให้ครบ', group: 'team' },
    { id: 'wavelength', game: 'wavelength', ico: '📡', label: 'คลื่นความคิด', blurb: 'ใบ้ 1 คำ ทีมหมุนเข็มให้ตรงเป้า', group: 'team' },
    { id: 'drawguess', game: 'drawguess', ico: '🎨', label: 'วาดแล้วทาย', blurb: 'ผลัดกันวาด ที่เหลือแข่งกันทาย', group: 'team' },
    { id: 'setthi', game: 'setthi', ico: '💰', label: 'เศรษฐี', blurb: 'ทอยเต๋า ซื้อเมือง ผูกขาดชนะ', group: 'board' }
  ];
  const guideGroups = [
    { id: 'talk', label: 'คุย จับโกหก หาตัวการ' },
    { id: 'cards', label: 'ไพ่ บลัฟ วัดดวง' },
    { id: 'team', label: 'แข่งทีม ใบ้คำ วาดรูป' },
    { id: 'board', label: 'เกมกระดาน' }
  ];
  const guideLimits = (typeof gameLimits !== 'undefined' && gameLimits) ? gameLimits : {};
  const guidePlayers = function (game) {
    const lim = guideLimits[game];
    return lim && lim.min ? (lim.min === lim.max ? lim.min + ' คน' : lim.min + '–' + lim.max + ' คน') : '';
  };
  // หัวของแต่ละเกม: ป้าย ชื่อ ข้อมูลสั้น และลิงก์ไปหน้าของเกมนั้น
  const guideHead = function (id, facts) {
    const g = guideGames.find(x => x.id === id) || { id: id, game: id, ico: '', label: id };
    const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const players = guidePlayers(g.game);
    const all = (players ? ['👥 ' + players] : []).concat(facts || []);
    return '<div class="hp-game-top"><div class="guide-mode-badge">' + esc(g.ico + ' ' + g.label) + '</div>' +
      '<a class="hp-more" href="/games/' + esc(g.game) + '">หน้าเกมนี้ →</a></div>' +
      (all.length ? '<ul class="hp-facts">' + all.map(f => '<li>' + esc(f) + '</li>').join('') + '</ul>' : '');
  };
  // ท้ายแต่ละเกม: ไปเกมก่อนหน้า / ถัดไป
  const guideNav = function (id) {
    const i = guideGames.findIndex(x => x.id === id);
    const prev = guideGames[i - 1];
    const next = guideGames[i + 1];
    return '<nav class="hp-pager" aria-label="เกมอื่น">' +
      (prev ? '<a class="hp-pager-prev" href="#' + prev.id + '"><small>← ก่อนหน้า</small>' + prev.ico + ' ' + prev.label + '</a>' : '<span></span>') +
      '<a class="hp-pager-all" href="#top">ทุกเกม</a>' +
      (next ? '<a class="hp-pager-next" href="#' + next.id + '"><small>ถัดไป →</small>' + next.ico + ' ' + next.label + '</a>' : '<a class="hp-pager-next" href="#faq"><small>ถัดไป →</small>❓ คำถามบ่อย</a>') +
      '</nav>';
  };
  const guideChips = [{ id: 'top', ico: '🏠', label: 'ทุกเกม' }].concat(guideGames, [{ id: 'faq', ico: '❓', label: 'คำถามบ่อย' }]);
%>

<script>
  // ลิงก์ตรงแบบ /how-to-play#werewolf — playerIdentity.js reload หน้านี้ครั้งหนึ่งเพื่อผูก playerId
  // แล้ว #hash หลุดไป จึงจำไว้ก่อน reload แล้วคืนให้หลังโหลดใหม่ (มีอายุ 15 วิ กันค้างไปรอบหน้า)
  (function () {
    var KEY = 'guideJumpHash';
    try {
      if (/^#[a-z0-9-]+$/i.test(location.hash)) {
        sessionStorage.setItem(KEY, JSON.stringify({ hash: location.hash, at: Date.now() }));
        return;
      }
      var saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      sessionStorage.removeItem(KEY);
      if (saved && /^#[a-z0-9-]+$/i.test(saved.hash) && Date.now() - saved.at < 15000 && history.replaceState) {
        history.replaceState(history.state, '', location.pathname + location.search + saved.hash);
      }
    } catch (e) { /* storage ใช้ไม่ได้ก็แค่ไม่ข้ามให้ */ }
  })();
</script>

<div class="guide-page" id="guide-page">
  <nav class="hp-switch" id="hp-switch" aria-label="เลือกเกม">
    <ul class="hp-switch-scroll" id="hp-switch-scroll">
      <% guideChips.forEach((link) => { %>
        <li><a class="guide-jump-chip" href="#<%= link.id %>" data-jump="<%= link.id %>"><span class="guide-jump-ico" aria-hidden="true"><%= link.ico %></span><%= link.label %></a></li>
      <% }) %>
    </ul>
  </nav>

  <section class="guide-hero hp-home" id="top">
    <span class="guide-kicker">How To Play</span>
    <h1 class="guide-title">วิธีเล่นทุกเกม เข้าใจได้ในหน้าเดียว</h1>
    <p class="guide-copy">เลือกเกมที่จะเล่น แล้วดูกติกาพร้อมการ์ดจริงในเกม แตะการ์ดเพื่อดูภาพใหญ่ อ่านจบเริ่มวงได้เลย</p>
    <nav class="hp-picker" id="guide-toc" aria-label="เลือกเกมที่จะอ่าน">
      <% guideGroups.forEach((group) => { %>
        <h2 class="hp-picker-label"><%= group.label %></h2>
        <ul class="hp-picker-grid">
          <% guideGames.filter(g => g.group === group.id).forEach((g) => { %>
            <li><a class="hp-tile" href="#<%= g.id %>">
              <span class="hp-tile-ico" aria-hidden="true"><%= g.ico %></span>
              <span class="hp-tile-copy"><b><%= g.label %></b><small><%= g.blurb %></small><% if (guidePlayers(g.game)) { %><em><%= guidePlayers(g.game) %></em><% } %></span>
            </a></li>
          <% }) %>
        </ul>
      <% }) %>
    </nav>
  </section>

  <div class="hp-games">
    <%
      const pokerGuideFallback = [
        { name: 'ตอง', hint: 'สามใบเลขเดียวกัน · ตอง 3 ใหญ่สุด เพราะ 3+3+3 เป็น 9 แล้วค่อยตองเอซ คิง ควีน … ตอง 2 เล็กสุด', example: [{ image: '/assets/games/poker/3h.svg' }, { image: '/assets/games/poker/3s.svg' }, { image: '/assets/games/poker/3d.svg' }] },
        { name: 'เรียงสี', hint: 'เหมือนเรียง แต่ต้องดอกเดียวกัน เช่น 7♥ 8♥ 9♥ · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/7h.svg' }, { image: '/assets/games/poker/8h.svg' }, { image: '/assets/games/poker/9h.svg' }] },
        { name: 'เซียน', hint: 'แจ็ค ควีน คิง ล้วน (ซ้ำกันได้ เช่น Q Q K) ดอกปนได้ · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/jh.svg' }, { image: '/assets/games/poker/qs.svg' }, { image: '/assets/games/poker/kd.svg' }] },
        { name: 'เรียง', hint: 'เลขต่อกัน ไม่ต้องดอกเดียวกัน · Q-K-A ใหญ่สุด เอซ-2-3 เล็กสุด · K-A-2 ไม่นับ', example: [{ image: '/assets/games/poker/5s.svg' }, { image: '/assets/games/poker/6h.svg' }, { image: '/assets/games/poker/7d.svg' }] },
        { name: 'สี', hint: 'ดอกเดียวกัน แต่เลขไม่ต่อกัน · ดูดอกก่อน ♠ ใหญ่กว่า ♥ ♦ ♣', example: [{ image: '/assets/games/poker/kh.svg' }, { image: '/assets/games/poker/9h.svg' }, { image: '/assets/games/poker/2h.svg' }] },
        { name: 'แต้ม', hint: 'ไม่เข้ามือไหน เอซ=1, 2–9 ตามหน้า, 10 แจ็คควีนคิง=0 รวมแล้วเอาหลักหน่วย เก้าใหญ่สุด · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/as.svg' }, { image: '/assets/games/poker/8d.svg' }, { image: '/assets/games/poker/kc.svg' }] }
      ];
      const pokerGuideRows = (typeof pokerRankGuide !== 'undefined' && Array.isArray(pokerRankGuide) && pokerRankGuide.length)
        ? pokerRankGuide.map((row, index) => Object.assign({}, pokerGuideFallback[index] || {}, row))
        : pokerGuideFallback;
    %>

    <article class="guide-card hp-game mode-insider" id="insider">
      <%- guideHead('insider') %>
      <h2>ทายคำ แล้วจับคนที่รู้คำ</h2>
      <p>ผู้ดำเนินเกม (ทุกคนรู้ว่าใคร) รู้คำลับ · จอมบงการก็แอบรู้ ต้องนำทางให้ทายถูกโดยไม่โดนจับ</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>บท</strong> 🟢 ผู้ดำเนินเกม 1 · 🔴 จอมบงการ 1 (ลับ) · 🔵 ที่เหลือพลเมือง</div>
        <div class="guide-list-item"><strong>1. ถาม–ตอบ 5 นาที</strong> ถามผู้ดำเนินเกม ตอบได้แค่ ✅ ใช่ / ❌ ไม่ใช่ / 🤷 ไม่รู้</div>
        <div class="guide-list-item"><strong>หมดเวลา</strong> ยังไม่มีใครทายถูก = <strong>ทุกคนแพ้</strong> (จอมบงการด้วย)</div>
        <div class="guide-list-item"><strong>2. ทายถูก</strong> ผู้ดำเนินเกมกดเลือกคนทายถูก · คุยหาจอมบงการ <strong>นานเท่าเวลาที่ใช้ถาม</strong></div>
        <div class="guide-list-item"><strong>3. โหวตรอบ 1</strong> “คนทายถูกคือจอมบงการไหม?” ใช่เกินครึ่ง = เปิดบทเลย · เสมอ = ไม่ผ่าน</div>
        <div class="guide-list-item"><strong>4. ชี้ตัว</strong> ทุกคนโหวต 1 คน (ผู้ดำเนินเกมด้วย) · เสมอ = คนทายถูกตัดสิน</div>
        <div class="guide-list-item"><strong>ใครชนะ</strong> จับจอมบงการได้ = ผู้ดำเนินเกม + พลเมืองชนะ · ไม่ได้ = จอมบงการชนะ</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 4–8 คน (เว็บให้ถึง 10) · หัวห้องเปิดโหมด 2 จอมบงการได้ตอน 5 คนขึ้นไป</div>
      </div>
      <%- guideNav('insider') %>
    </article>

    <article class="guide-card hp-game mode-werewolf" id="werewolf">
      <%- guideHead('werewolf') %>
      <h2>กลางคืนใช้สกิล กลางวันตัดสิน</h2>
      <p>โหมดนี้เน้นบทบาทและข้อมูลที่ไม่เท่ากัน หมาป่าพยายามลดจำนวนชาวบ้าน ขณะที่ฝ่ายหมู่บ้านต้องใช้ข้อมูลสะสมและการคุยกันเพื่อหาตัวจริง</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> ชาวบ้านต้องกำจัดหมาป่า (และฆาตกรต่อเนื่องถ้ามี) ให้หมด · หมาป่าชนะเมื่อจำนวนไม่น้อยกว่าคนที่เหลือ และไม่มีฆาตกรต่อเนื่องรอด · บทเดี่ยวมีเงื่อนไขชนะของตัวเอง</div>
        <div class="guide-list-item"><strong>บทบาท</strong> ผู้หยั่งรู้·ศิษย์ผู้หยั่งรู้·นักพยากรณ์ (ตรวจตัวตน), หมอ·บอดี้การ์ด·แม่มด·นักบวช (ป้องกัน), ศาลเตี้ย·พราน (ยิง), นักสอดแนม, นายก (เสียงโหวต x2), เจ้าชาย (รอดโหวตครั้งแรก), จอมเปิดโปง, ไลแคน, ผู้ติดเชื้อ · บทเดี่ยว: คนบ้า, ฆาตกรต่อเนื่อง</div>
        <div class="guide-list-item"><strong>บทใหม่</strong> 🔪 ฆาตกรต่อเนื่อง ฆ่าได้คืนละ 1 คนตั้งแต่คืนที่ 2 หมาป่าฆ่าไม่ได้ ชนะเมื่อเหลือรอดไม่เกิน 2 คน · 🤴 เจ้าชาย ถูกโหวตออกครั้งแรกจะเปิดตัวและไม่ตาย · 🌕 ไลแคน ชาวบ้านที่ผู้หยั่งรู้เห็นเป็น “ไม่ดี” · 🤒 ผู้ติดเชื้อ ถ้าหมาป่ากัดตาย คืนถัดไปหมาป่าล่าไม่ได้ · 🧿 ศิษย์ผู้หยั่งรู้ ได้พลังตรวจออร่าเมื่อไม่มีผู้หยั่งรู้เหลือรอด</div>
        <div class="guide-list-item"><strong>คืนแรก</strong> หมาป่าและฆาตกรยังฆ่าใครไม่ได้ ใช้สำรวจข้อมูลก่อน · แชตกลางคืนคุยได้เฉพาะหมาป่า · แม่มดเห็นว่าหมาป่ากำลังเล็งใคร และใช้ยาช่วย+ยาพิษคืนเดียวกันได้</div>
        <div class="guide-list-item"><strong>โหวตกลางวัน</strong> แขวนได้เมื่อเสียงเกินครึ่งของน้ำหนักเสียงทั้งหมด เสมอ = ไม่แขวน · ถ้าเสียง “ข้ามโหวต” เกินครึ่งจะข้ามวันเข้ากลางคืนทันที</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 5–20 คน · ไม่ตั้งเองระบบจัดบทตามตารางแนะนำ (หมาป่าราว 1 ตัวต่อ 4–5 คน, 11 คนขึ้นไปมีบทเดี่ยวและชาวบ้านธรรมดา) · หัวห้องเลือกจำนวนหมาป่า 1–5 ตัวเองได้ · วง 15–20 คนแนะนำตั้งคืน 90 วิ และประชุม 4–5 นาที</div>
        <div class="guide-list-item"><strong>จุดเด่น</strong> มี phase กลางคืนและกลางวัน ทำให้เกมพลิกได้จากสกิลกับการโหวต</div>
      </div>
      <% if (typeof werewolfRoleGallery !== 'undefined' && werewolfRoleGallery.length) { %>
      <div class="ww-howto-roles">
        <% werewolfRoleGallery.forEach(function(role) { %>
        <figure class="ww-howto-role team-<%= role.team %>">
          <img src="<%= role.image %>" alt="<%= role.thaiName %>" width="96" height="96" loading="lazy" decoding="async">
          <figcaption><%= role.thaiName %></figcaption>
        </figure>
        <% }) %>
      </div>
      <p class="ww-howto-credit">ภาพตัวละครโดย Justin Nichol (CC BY 4.0) · <a href="/assets/games/werewolf/CREDITS.md" target="_blank" rel="noopener">เครดิตภาพ</a></p>
      <% } %>
      <%- guideNav('werewolf') %>
    </article>

    <article class="guide-card hp-game mode-spyfall" id="spyfall">
      <%- guideHead('spyfall') %>
      <h2>รู้สถานที่ จับสายลับ</h2>
      <p>ทุกคนได้สถานที่เดียวกัน (และบทในที่นั้นคนละบท) ยกเว้นสายลับ 1 คนที่ต้องเดาจากคำถาม–คำตอบโดยไม่เปิดเผยตัว</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> พลเมืองจับสายลับ · สายลับหลบรอด หรือทายสถานที่ให้ถูก</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 3-8 คน รอบละ 8 นาที เล่นหลายรอบสะสมแต้ม</div>
        <div class="guide-list-item"><strong>🎤 ถาม–ตอบ</strong> เจ้ามือถามก่อน · คนที่ถูกถามตอบ แล้วถามคนอื่นต่อ · ห้ามถามกลับคนที่เพิ่งถามเรา</div>
        <div class="guide-list-item"><strong>🛑 กล่าวหา</strong> ใครก็หยุดเวลาได้คนละ 1 ครั้งต่อรอบ · ทุกคนยกเว้นคนถูกกล่าวหาต้องเห็นด้วย ถึงเปิดการ์ด · มีคนไม่เห็นด้วย = เวลาเดินต่อ</div>
        <div class="guide-list-item"><strong>🎯 สายลับทาย</strong> หยุดเวลาทายสถานที่ได้ 1 ครั้ง ตอนเวลายังเดิน · ถูกชนะ ผิดแพ้</div>
        <div class="guide-list-item"><strong>⏰ หมดเวลา</strong> ไล่กล่าวหาทีละคน เริ่มจากเจ้ามือ · ไม่มีใครถูกจับ = สายลับรอด</div>
        <div class="guide-list-item"><strong>🏆 คะแนน</strong> สายลับรอด 2 · จับผิดคนหรือทายถูก 4 · จับสายลับได้ พลเมืองคนละ 1 คนเริ่มกล่าวหา +1 · สายลับรอบก่อนเป็นเจ้ามือรอบใหม่</div>
        <div class="guide-list-item"><strong>ตั้งได้ในห้อง</strong> จำนวนรอบ 1/3/5 · โหวตเสียงข้างมาก (หมดเวลาแล้วโหวตลับครั้งเดียว)</div>
      </div>
      <%- guideNav('spyfall') %>
    </article>

    <article class="guide-card hp-game mode-undercover" id="undercover">
      <%- guideHead('undercover') %>
      <h2>ใบ้คนละคำ หาคนที่คำไม่เหมือน</h2>
      <p>ทุกคนได้คำเดียวกัน ยกเว้น<strong>สายแฝง</strong>ที่ได้คำคล้าย ๆ แต่ไม่ใช่ (เช่น กาแฟ / ชา) — ไม่มีใครรู้ว่าตัวเองอยู่ฝั่งไหน ต้องฟังคำใบ้ของคนอื่นแล้วเดาเอง</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> พลเมืองโหวตฝ่ายแฝงออกให้หมด · ฝ่ายแฝงรอดจนเหลือพลเมืองแค่ 1 คน</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 3-10 คนที่นั่งด้วยกัน รอบละ 3-5 นาที</div>
        <div class="guide-list-item"><strong>กี่คนเป็นอะไร</strong> 3–6 คน สายแฝง 1 · 7–9 คน สายแฝง 2 · 10 คน สายแฝง 3 · Mr. White 1 คนตั้งแต่ 5 คน (หัวห้องปรับได้)</div>
        <div class="guide-list-item"><strong>หนึ่งรอบ</strong> แตะการ์ดดูคำ → ใบ้คนละ 1 คำตามคิว (พูดปากเปล่า ห้ามพูดคำตรง ๆ) → โหวตออก 1 คน → เปิดบทคนที่ออก</div>
        <div class="guide-list-item"><strong>เสมอ</strong> คนที่เสมอใบ้เพิ่มคนละ 1 คำ แล้วคนที่เหลือโหวตใหม่เฉพาะคนที่เสมอ · เสมออีก = รอบนั้นไม่มีใครออก</div>
        <div class="guide-list-item"><strong>Mr. White</strong> ไม่ได้คำเลย ต้องเนียนตามวง ไม่ได้พูดคนแรก · ถ้าถูกโหวตออกได้ทายคำพลเมือง 1 ครั้ง ทายถูก = ชนะคนเดียวทันที</div>
        <div class="guide-list-item"><strong>แต้ม</strong> ฝั่งที่ชนะได้แต้มสะสมในห้อง: พลเมือง +2 · Mr. White +6 · สายแฝง +10</div>
      </div>
      <div class="guide-coup-roles">
        <article class="guide-coup-role">
          <img src="/assets/games/undercover/civilian.svg" alt="พลเมือง" width="160" height="224" loading="lazy">
          <strong>🙂 พลเมือง</strong>
          <span>ได้คำเดียวกับคนส่วนใหญ่</span>
        </article>
        <article class="guide-coup-role">
          <img src="/assets/games/undercover/undercover.svg" alt="สายแฝง" width="160" height="224" loading="lazy">
          <strong>🕶️ สายแฝง</strong>
          <span>ได้คำคล้ายแต่ไม่ใช่</span>
        </article>
        <article class="guide-coup-role">
          <img src="/assets/games/undercover/mrwhite.svg" alt="Mr. White" width="160" height="224" loading="lazy">
          <strong>❔ Mr. White</strong>
          <span>ไม่มีคำ ทายถูกชนะ</span>
        </article>
      </div>
      <%- guideNav('undercover') %>
    </article>

    <article class="guide-card hp-game mode-avalon" id="avalon">
      <%- guideHead('avalon') %>
      <h2>ฝ่ายดีทำภารกิจ ฝ่ายร้ายแฝงตัวบ่อนทำลาย</h2>
      <p>เล่น 5–10 คน ทุกคนได้บทลับ ฝ่ายดีต้องทำ <strong>ภารกิจสำเร็จ 3 ใน 5</strong> ฝ่ายร้ายต้องทำให้ <strong>ล้ม 3 ครั้ง</strong> — ไม่มีใครตกรอบ ทุกคนเล่นจนจบ</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>กลางคืน</strong> แตะการ์ดดูบทของตัวเองเงียบ ๆ เมอร์ลินเห็นฝ่ายร้าย ฝ่ายร้ายเห็นกันเอง แล้วกดพร้อม</div>
        <div class="guide-list-item"><strong>เลือกทีม</strong> หัวหน้า (มงกุฎ เวียนตามที่นั่ง) เลือกคนตามจำนวนบนเหรียญภารกิจ</div>
        <div class="guide-list-item"><strong>โหวต</strong> ทุกคนกดเห็นด้วย/คัดค้านพร้อมกัน เปิดผลพร้อมกัน เห็นด้วยเกินครึ่งถึงผ่าน · ไม่ผ่านติดกัน 5 ครั้ง ฝ่ายร้ายชนะทันที</div>
        <div class="guide-list-item"><strong>ภารกิจ</strong> ทีมลงการ์ดลับ ฝ่ายดีลงได้แค่ “สำเร็จ” ฝ่ายร้ายเลือกได้ · มีการ์ดล้ม 1 ใบก็ล้ม (ยกเว้นภารกิจ 4 ตอนเล่น 7+ คน ต้องล้ม 2 ใบ)</div>
        <div class="guide-list-item"><strong>ลอบสังหาร</strong> ฝ่ายดีสำเร็จครบ 3 แล้ว ฝ่ายร้ายเปิดตัวคุยกัน (รวมโอเบรอน) แล้วมือสังหารแทงฝ่ายดีได้ 1 คน ถ้าโดนเมอร์ลิน ฝ่ายร้ายชนะ</div>
        <div class="guide-list-item"><strong>ฝ่ายดี:ฝ่ายร้าย</strong> 5 คน 3:2 · 6 คน 4:2 · 7 คน 4:3 · 8 คน 5:3 · 9 คน 6:3 · 10 คน 6:4</div>
        <div class="guide-list-item"><strong>บทเสริม</strong> หัวห้องเปิดได้ในห้องรอ: เพอร์ซิวัล · มอร์กานา · มอร์เดรด · โอเบรอน</div>
        <div class="guide-list-item"><strong>🌊 นางแห่งทะเลสาบ</strong> (หัวห้องเปิดในห้องรอ · แนะนำ 7+ คน) เริ่มที่คนก่อนหัวหน้าคนแรก หลังภารกิจ 2, 3, 4 คนถือส่องฝ่ายของ 1 คน (เห็นแค่ดี/ร้าย คนเดียว จะบอกจริงหรือโกหกก็ได้) แล้วส่งต่อให้คนที่ถูกส่อง · ส่องคนที่เคยถือไม่ได้</div>
      </div>
      <div class="guide-avalon-roles">

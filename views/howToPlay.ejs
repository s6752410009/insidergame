<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/pokerHands.css">
<link rel="stylesheet" href="/static/css/howToPlay.css?v=<%= typeof buildId !== 'undefined' ? buildId : '1' %>">

<%
  // รายชื่อเกมในหน้านี้ — ใช้ทั้งแถบสลับเกม การ์ดเลือกเกมด้านบน และลิงก์ก่อนหน้า/ถัดไปท้ายแต่ละเกม
  // id = id ของ section (ลิงก์ /how-to-play#<id> เดิมต้องใช้ได้) · game = gameMode ของเกม (ลิงก์ /games/<game>)
  const guideGames = [
    { id: 'insider', game: 'insider', ico: '🎯', label: 'Insider', blurb: 'ทายคำ แล้วจับคนที่แอบรู้คำ', group: 'talk' },
    { id: 'werewolf', game: 'werewolf', ico: '🐺', label: 'Werewolf', blurb: 'กลางคืนใช้สกิล กลางวันโหวตแขวน', group: 'talk' },
    { id: 'spyfall', game: 'spyfall', ico: '🕶️', label: 'Spyfall', blurb: 'ถามตอบหาสายลับที่ไม่รู้สถานที่', group: 'talk' },
    { id: 'undercover', game: 'undercover', ico: '🫥', label: 'คำใครไม่เหมือน', blurb: 'ใบ้คนละคำ หาคนที่ได้คำต่าง', group: 'talk' },
    { id: 'avalon', game: 'avalon', ico: '🏰', label: 'อวาลอน', blurb: 'ทำภารกิจ ฝ่ายร้ายแฝงตัวบ่อนทำลาย', group: 'talk' },
    { id: 'blackmarket', game: 'blackmarket', ico: '🎩', label: 'Black Market', blurb: 'ต่อรอง บลัฟ หักหลัง ในตลาดมืด', group: 'talk' },
    { id: 'coup', game: 'coup', ico: '👑', label: 'Coup', blurb: 'อ้างการ์ดที่ไม่มีก็ได้ ใครท้าก็ลุ้น', group: 'cards' },
    { id: 'liar', game: 'liar', ico: '🃏', label: 'ไพ่โกหก', blurb: 'ลงไพ่คว่ำ โดนจับต้องลั่นไก', group: 'cards' },
    { id: 'poker5', game: 'poker5', ico: '♠', label: 'ไพ่ 5 ใบ', blurb: 'ได้ 5 ทิ้ง 2 ลงชิปแล้วเปิดเทียบ', group: 'cards' },
    { id: 'poker4', game: 'poker4', ico: '♦', label: 'สี่ใบเก', blurb: 'ได้ 4 ทิ้ง 2 ลงชิปสองรอบ', group: 'cards' },
    { id: 'pokdeng', game: 'pokdeng', ico: '🎴', label: 'ป๊อกเด้ง', blurb: 'สองใบวัดเจ้ามือ ป๊อกเปิดเลย', group: 'cards' },
    { id: 'colorcards', game: 'colorcards', ico: '🌈', label: 'ไพ่ทิ้งสี', blurb: 'ลงสีหรือเลขให้ตรง หมดมือก่อนชนะ', group: 'cards' },
    { id: 'codenames', game: 'codenames', ico: '🕵️', label: 'สายลับคำใบ้', blurb: 'ใบ้คำเดียว ให้ทีมเปิดสายลับให้ครบ', group: 'team' },
    { id: 'wavelength', game: 'wavelength', ico: '📡', label: 'คลื่นความคิด', blurb: 'ใบ้ 1 คำ ทีมหมุนเข็มให้ตรงเป้า', group: 'team' },
    { id: 'drawguess', game: 'drawguess', ico: '🎨', label: 'วาดแล้วทาย', blurb: 'ผลัดกันวาด ที่เหลือแข่งกันทาย', group: 'team' },
    { id: 'setthi', game: 'setthi', ico: '💰', label: 'เศรษฐี', blurb: 'ทอยเต๋า ซื้อเมือง ผูกขาดชนะ', group: 'board' }
  ];
  const guideGroups = [
    { id: 'talk', label: 'คุย จับโกหก หาตัวการ' },
    { id: 'cards', label: 'ไพ่ บลัฟ วัดดวง' },
    { id: 'team', label: 'แข่งทีม ใบ้คำ วาดรูป' },
    { id: 'board', label: 'เกมกระดาน' }
  ];
  const guideLimits = (typeof gameLimits !== 'undefined' && gameLimits) ? gameLimits : {};
  const guidePlayers = function (game) {
    const lim = guideLimits[game];
    return lim && lim.min ? (lim.min === lim.max ? lim.min + ' คน' : lim.min + '–' + lim.max + ' คน') : '';
  };
  // หัวของแต่ละเกม: ป้าย ชื่อ ข้อมูลสั้น และลิงก์ไปหน้าของเกมนั้น
  const guideHead = function (id, facts) {
    const g = guideGames.find(x => x.id === id) || { id: id, game: id, ico: '', label: id };
    const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const players = guidePlayers(g.game);
    const all = (players ? ['👥 ' + players] : []).concat(facts || []);
    return '<div class="hp-game-top"><div class="guide-mode-badge">' + esc(g.ico + ' ' + g.label) + '</div>' +
      '<a class="hp-more" href="/games/' + esc(g.game) + '">หน้าเกมนี้ →</a></div>' +
      (all.length ? '<ul class="hp-facts">' + all.map(f => '<li>' + esc(f) + '</li>').join('') + '</ul>' : '');
  };
  // ท้ายแต่ละเกม: ไปเกมก่อนหน้า / ถัดไป
  const guideNav = function (id) {
    const i = guideGames.findIndex(x => x.id === id);
    const prev = guideGames[i - 1];
    const next = guideGames[i + 1];
    return '<nav class="hp-pager" aria-label="เกมอื่น">' +
      (prev ? '<a class="hp-pager-prev" href="#' + prev.id + '"><small>← ก่อนหน้า</small>' + prev.ico + ' ' + prev.label + '</a>' : '<span></span>') +
      '<a class="hp-pager-all" href="#top">ทุกเกม</a>' +
      (next ? '<a class="hp-pager-next" href="#' + next.id + '"><small>ถัดไป →</small>' + next.ico + ' ' + next.label + '</a>' : '<a class="hp-pager-next" href="#faq"><small>ถัดไป →</small>❓ คำถามบ่อย</a>') +
      '</nav>';
  };
  const guideChips = [{ id: 'top', ico: '🏠', label: 'ทุกเกม' }].concat(guideGames, [{ id: 'faq', ico: '❓', label: 'คำถามบ่อย' }]);
%>

<script>
  // ลิงก์ตรงแบบ /how-to-play#werewolf — playerIdentity.js reload หน้านี้ครั้งหนึ่งเพื่อผูก playerId
  // แล้ว #hash หลุดไป จึงจำไว้ก่อน reload แล้วคืนให้หลังโหลดใหม่ (มีอายุ 15 วิ กันค้างไปรอบหน้า)
  (function () {
    var KEY = 'guideJumpHash';
    try {
      if (/^#[a-z0-9-]+$/i.test(location.hash)) {
        sessionStorage.setItem(KEY, JSON.stringify({ hash: location.hash, at: Date.now() }));
        return;
      }
      var saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      sessionStorage.removeItem(KEY);
      if (saved && /^#[a-z0-9-]+$/i.test(saved.hash) && Date.now() - saved.at < 15000 && history.replaceState) {
        history.replaceState(history.state, '', location.pathname + location.search + saved.hash);
      }
    } catch (e) { /* storage ใช้ไม่ได้ก็แค่ไม่ข้ามให้ */ }
  })();
</script>

<div class="guide-page" id="guide-page">
  <nav class="hp-switch" id="hp-switch" aria-label="เลือกเกม">
    <ul class="hp-switch-scroll" id="hp-switch-scroll">
      <% guideChips.forEach((link) => { %>
        <li><a class="guide-jump-chip" href="#<%= link.id %>" data-jump="<%= link.id %>"><span class="guide-jump-ico" aria-hidden="true"><%= link.ico %></span><%= link.label %></a></li>
      <% }) %>
    </ul>
  </nav>

  <section class="guide-hero hp-home" id="top">
    <span class="guide-kicker">How To Play</span>
    <h1 class="guide-title">วิธีเล่นทุกเกม เข้าใจได้ในหน้าเดียว</h1>
    <p class="guide-copy">เลือกเกมที่จะเล่น แล้วดูกติกาพร้อมการ์ดจริงในเกม แตะการ์ดเพื่อดูภาพใหญ่ อ่านจบเริ่มวงได้เลย</p>
    <nav class="hp-picker" id="guide-toc" aria-label="เลือกเกมที่จะอ่าน">
      <% guideGroups.forEach((group) => { %>
        <h2 class="hp-picker-label"><%= group.label %></h2>
        <ul class="hp-picker-grid">
          <% guideGames.filter(g => g.group === group.id).forEach((g) => { %>
            <li><a class="hp-tile" href="#<%= g.id %>">
              <span class="hp-tile-ico" aria-hidden="true"><%= g.ico %></span>
              <span class="hp-tile-copy"><b><%= g.label %></b><small><%= g.blurb %></small><% if (guidePlayers(g.game)) { %><em><%= guidePlayers(g.game) %></em><% } %></span>
            </a></li>
          <% }) %>
        </ul>
      <% }) %>
    </nav>
  </section>

  <div class="hp-games">
    <%
      const pokerGuideFallback = [
        { name: 'ตอง', hint: 'สามใบเลขเดียวกัน · ตอง 3 ใหญ่สุด เพราะ 3+3+3 เป็น 9 แล้วค่อยตองเอซ คิง ควีน … ตอง 2 เล็กสุด', example: [{ image: '/assets/games/poker/3h.svg' }, { image: '/assets/games/poker/3s.svg' }, { image: '/assets/games/poker/3d.svg' }] },
        { name: 'เรียงสี', hint: 'เหมือนเรียง แต่ต้องดอกเดียวกัน เช่น 7♥ 8♥ 9♥ · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/7h.svg' }, { image: '/assets/games/poker/8h.svg' }, { image: '/assets/games/poker/9h.svg' }] },
        { name: 'เซียน', hint: 'แจ็ค ควีน คิง ล้วน (ซ้ำกันได้ เช่น Q Q K) ดอกปนได้ · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/jh.svg' }, { image: '/assets/games/poker/qs.svg' }, { image: '/assets/games/poker/kd.svg' }] },
        { name: 'เรียง', hint: 'เลขต่อกัน ไม่ต้องดอกเดียวกัน · Q-K-A ใหญ่สุด เอซ-2-3 เล็กสุด · K-A-2 ไม่นับ', example: [{ image: '/assets/games/poker/5s.svg' }, { image: '/assets/games/poker/6h.svg' }, { image: '/assets/games/poker/7d.svg' }] },
        { name: 'สี', hint: 'ดอกเดียวกัน แต่เลขไม่ต่อกัน · ดูดอกก่อน ♠ ใหญ่กว่า ♥ ♦ ♣', example: [{ image: '/assets/games/poker/kh.svg' }, { image: '/assets/games/poker/9h.svg' }, { image: '/assets/games/poker/2h.svg' }] },
        { name: 'แต้ม', hint: 'ไม่เข้ามือไหน เอซ=1, 2–9 ตามหน้า, 10 แจ็คควีนคิง=0 รวมแล้วเอาหลักหน่วย เก้าใหญ่สุด · เท่ากันดูใบใหญ่สุด แล้วดูดอก', example: [{ image: '/assets/games/poker/as.svg' }, { image: '/assets/games/poker/8d.svg' }, { image: '/assets/games/poker/kc.svg' }] }
      ];
      const pokerGuideRows = (typeof pokerRankGuide !== 'undefined' && Array.isArray(pokerRankGuide) && pokerRankGuide.length)
        ? pokerRankGuide.map((row, index) => Object.assign({}, pokerGuideFallback[index] || {}, row))
        : pokerGuideFallback;
      // มือไพ่ตัวอย่างจากรูปไพ่จริงของเกม (public/assets/games/poker/<rank><suit>.svg)
      const pkHand = function (cards, name, does, when) {
        const imgs = cards.map(c => {
          const src = /^\//.test(c) ? c : '/assets/games/poker/' + c + '.svg';
          return '<img src="' + src + '" alt="" width="250" height="350" loading="lazy" decoding="async">';
        }).join('');
        return '<figure class="hp-card" tabindex="0" role="button" aria-label="ดูมือ' + name.replace(/<[^>]+>/g, '') + 'ขนาดใหญ่">' +
          '<div class="hp-card-art hp-hand">' + imgs + '</div>' +
          '<figcaption><b>' + name + '</b><span class="hp-does">' + does + '</span>' + (when ? '<span class="hp-when">' + when + '</span>' : '') + '</figcaption></figure>';
      };
    %>

    <article class="guide-card hp-game mode-insider" id="insider">
      <%- guideHead('insider') %>
      <h2>ทายคำ แล้วจับคนที่รู้คำ</h2>
      <p>ผู้ดำเนินเกม (ทุกคนรู้ว่าใคร) รู้คำลับ · จอมบงการก็แอบรู้ ต้องนำทางให้ทายถูกโดยไม่โดนจับ</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>บท</strong> 🟢 ผู้ดำเนินเกม 1 · 🔴 จอมบงการ 1 (ลับ) · 🔵 ที่เหลือพลเมือง</div>
        <div class="guide-list-item"><strong>1. ถาม–ตอบ 5 นาที</strong> ถามผู้ดำเนินเกม ตอบได้แค่ ✅ ใช่ / ❌ ไม่ใช่ / 🤷 ไม่รู้</div>
        <div class="guide-list-item"><strong>หมดเวลา</strong> ยังไม่มีใครทายถูก = <strong>ทุกคนแพ้</strong> (จอมบงการด้วย)</div>
        <div class="guide-list-item"><strong>2. ทายถูก</strong> ผู้ดำเนินเกมกดเลือกคนทายถูก · คุยหาจอมบงการ <strong>นานเท่าเวลาที่ใช้ถาม</strong></div>
        <div class="guide-list-item"><strong>3. โหวตรอบ 1</strong> “คนทายถูกคือจอมบงการไหม?” ใช่เกินครึ่ง = เปิดบทเลย · เสมอ = ไม่ผ่าน</div>
        <div class="guide-list-item"><strong>4. ชี้ตัว</strong> ทุกคนโหวต 1 คน (ผู้ดำเนินเกมด้วย) · เสมอ = คนทายถูกตัดสิน</div>
        <div class="guide-list-item"><strong>ใครชนะ</strong> จับจอมบงการได้ = ผู้ดำเนินเกม + พลเมืองชนะ · ไม่ได้ = จอมบงการชนะ</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 4–8 คน (เว็บให้ถึง 10) · หัวห้องเปิดโหมด 2 จอมบงการได้ตอน 5 คนขึ้นไป</div>
      </div>
      <%- guideNav('insider') %>
    </article>

    <article class="guide-card hp-game mode-werewolf" id="werewolf">
      <%- guideHead('werewolf', ['⏱ 20–40 นาที', '🤖 มีบอท']) %>
      <h2>กลางคืนใช้สกิล กลางวันโหวตแขวน</h2>
      <p>หมาป่าแอบล่าชาวบ้านทีละคนตอนกลางคืน ฝ่ายหมู่บ้านใช้สกิลกับการคุยตอนกลางวันหาตัวหมาป่าแล้วโหวตแขวน</p>

      <h3 class="guide-sub">หนึ่งวันในหมู่บ้าน</h3>
      <ol class="hp-steps">
        <li><strong>🌙 กลางคืน</strong> ทุกบทกดใช้สกิลพร้อมกัน · แชตกลางคืนคุยได้เฉพาะหมาป่า · <strong>คืนแรกยังไม่มีใครฆ่าได้</strong> ใช้สำรวจข้อมูลก่อน</li>
        <li><strong>☀️ เช้า</strong> ประกาศว่าใครตาย · นายกเปิดตัวได้ · นักบวชให้พรได้ · จอมเปิดโปงชี้ตัวได้</li>
        <li><strong>🗣️ ประชุม</strong> คุยหาหมาป่า · ถ้าเสียง “ข้ามประชุม” เกินครึ่ง ไปโหวตเลย</li>
        <li><strong>🗳️ โหวตแขวน</strong> แขวนได้เมื่อเสียงเกินครึ่งของน้ำหนักเสียงทั้งหมด · เสมอ = ไม่แขวน · “ข้ามโหวต” เกินครึ่ง = เข้ากลางคืนทันที</li>
      </ol>
      <ul class="hp-points">
        <li><i>🏡</i><span><strong>หมู่บ้านชนะ</strong> กำจัดหมาป่าหมด (และฆาตกรต่อเนื่องถ้ามี)</span></li>
        <li><i>🐺</i><span><strong>หมาป่าชนะ</strong> จำนวนหมาป่าไม่น้อยกว่าคนที่เหลือ และไม่มีฆาตกรต่อเนื่องรอด</span></li>
        <li><i>🎭</i><span><strong>บทเดี่ยว</strong> คนบ้า ชนะเมื่อถูกโหวตออก · ฆาตกรต่อเนื่อง ชนะเมื่อรอดจนเหลือไม่เกิน 2 คน</span></li>
      </ul>

      <% if (typeof werewolfRoleGallery !== 'undefined' && werewolfRoleGallery.length) { %>
      <%
        const wwAbility = {
          villager: ['ไม่มีสกิล ใช้การคุยและโหวต', 'ฟังให้ดีว่าใครพูดขัดกัน'],
          werewolf: ['คืนละ 1 เหยื่อ (เริ่มคืนที่ 2) · คุยแชตหมาป่าได้', 'กลางวันเนียนเป็นชาวบ้าน'],
          alphaWolf: ['โหวตล่านับ 2 เสียง · ผู้หยั่งรู้ตรวจเห็น “ไม่ทราบ”', 'ชี้เป้าล่าให้ฝูง'],
          mayor: ['กลางวันกดเปิดตัวแล้วเสียงโหวตนับเป็น 2', 'เปิดตัวตอนโหวตสูสี'],
          bodyguard: ['กันการโจมตี 1 คนต่อคืน ห้ามคนเดิมสองคืนติด · กันสำเร็จเกราะแตก', 'คุ้มกันคนที่น่าจะโดนล่า'],
          seer: ['ตรวจคืนละ 1 คน ผล ดี / ไม่ดี / ไม่ทราบ', 'บอกผลตอนที่มีน้ำหนักที่สุด'],
          oracle: ['ตรวจคืนละ 1 คน เห็นบทจริงของเป้า', 'ยืนยันคนที่ถูกสงสัย'],
          doctor: ['ช่วยชีวิตคืนละ 1 คน รวม 2 ครั้งต่อเกม', 'เก็บไว้ช่วยคนสำคัญ'],
          witch: ['ยาช่วย 1 + ยาพิษ 1 · เห็นว่าหมาป่าเล็งใคร ใช้สองขวดคืนเดียวได้', 'ช่วยคนดีหรือวางยาตัวที่มั่นใจ'],
          tracker: ['ดูว่าเป้าใช้สกิลในคืนนั้นหรือไม่', 'จับคนอ้างบทปลอม'],
          hunter: ['ยิงตอนกลางคืนได้ 1 ครั้งต่อเกม', 'มั่นใจแล้วค่อยยิง'],
          cleric: ['ให้พรกันตาย 1 คน ใช้ตอนประชุมเช้า ครั้งเดียว ให้ตัวเองไม่ได้', 'คนที่ยืนยันแล้วว่าดี'],
          vigilante: ['ยิงตอนกลางคืนได้ 1 ครั้งต่อเกม', 'ยิงพลาดเสียคนดีไปด้วย'],
          fool: ['หมาป่าฆ่าไม่ได้ · ถูกโหวตออก = ชนะคนเดียว', 'ทำตัวน่าสงสัยพอดี ๆ'],
          revealer: ['กลางวันชี้ 1 คน เป็นหมาป่า = มันตาย · ผิด = เราตายแทน', 'มั่นใจจริงเท่านั้น'],
          serialKiller: ['ฆ่าคืนละ 1 (เริ่มคืนที่ 2) · หมาป่าฆ่าไม่ได้', 'รอดให้เหลือไม่เกิน 2 คน'],
          prince: ['ถูกโหวตออกครั้งแรก เปิดตัวแล้วไม่ตาย', 'กล้าเป็นเป้าแทนคนอื่น'],
          lycan: ['ชาวบ้าน แต่ผู้หยั่งรู้ตรวจเห็นเป็น “ไม่ดี”', 'อธิบายตัวเองให้ทันก่อนโดนแขวน'],
          diseased: ['ถ้าหมาป่ากัดตาย คืนถัดไปหมาป่าล่าไม่ได้', 'เป็นเหยื่อล่อให้หมาป่า'],
          apprenticeSeer: ['ได้พลังตรวจคืนละ 1 คนเมื่อผู้หยั่งรู้ตาย', 'เก็บตัวเงียบจนถึงเวลา']
        };
        const wwTeams = [
          { id: 'werewolf', label: '🐺 ฝ่ายหมาป่า', color: '#ff9aa8' },
          { id: 'village', label: '🏡 ฝ่ายหมู่บ้าน', color: '#a9c8ff' },
          { id: 'solo', label: '🎭 บทเดี่ยว', color: '#d4b3ff' }
        ];
      %>
      <h3 class="guide-sub">บทบาททั้ง <%= werewolfRoleGallery.length %> บท</h3>
      <% wwTeams.forEach(function (team) { const roles = werewolfRoleGallery.filter(r => r.team === team.id); if (!roles.length) return; %>
      <p class="hp-group-label" style="color:<%= team.color %>"><%= team.label %> · <%= roles.length %> บท</p>
      <div class="hp-cards hp-wide is-small ww-cards" style="--hp-art: 1 / 1">
        <% roles.forEach(function (role) { const ab = wwAbility[role.id] || ['', '']; %>
        <figure class="hp-card team-<%= role.team %>" tabindex="0" role="button" aria-label="ดูบท<%= role.thaiName %>ขนาดใหญ่">
          <div class="hp-card-art is-contain"><img src="<%= role.image %>" alt="<%= role.thaiName %>" width="512" height="512" loading="lazy" decoding="async"></div>
          <figcaption><b><%= role.thaiName %></b><% if (ab[0]) { %><span class="hp-does"><%= ab[0] %></span><% } %><% if (ab[1]) { %><span class="hp-when"><%= ab[1] %></span><% } %></figcaption>
        </figure>
        <% }) %>
      </div>
      <% }) %>
      <p class="ww-howto-credit">ภาพตัวละครโดย Justin Nichol (CC BY 4.0) · <a href="/assets/games/werewolf/CREDITS.md" target="_blank" rel="noopener">เครดิตภาพ</a></p>
      <% } %>

      <h3 class="guide-sub">ข้อมูลที่ผู้หยั่งรู้เห็น</h3>
      <ul class="hp-points">
        <li><i>🔮</i><span>อัลฟ่าหมาป่ากับคนบ้า = <strong>ไม่ทราบ</strong> · ไลแคนกับฆาตกรต่อเนื่อง = <strong>ไม่ดี</strong></span></li>
      </ul>

      <h3 class="guide-sub">ตั้งค่าห้อง</h3>
      <ul class="hp-points">
        <li><i>🐺</i><span><strong>จำนวนหมาป่า</strong> ไม่ตั้ง = ระบบจัดให้ (≤6 คน 1 ตัว · 7–11 คน 2 · 12–15 คน 3 · 16–20 คน 4) · ตั้งเองได้ 1–5 แต่ไม่เกิน 1 ใน 3 ของวง</span></li>
        <li><i>🎭</i><span><strong>บทบาท</strong> หัวห้องติ๊กเลือกบทเองได้ · ไม่เลือก คนบ้ามาตอน 11 คน ฆาตกรต่อเนื่องตอน 13 คน</span></li>
        <li><i>⏱</i><span>กลางคืน 45/60/90 วิ · ประชุม 2–5 นาที · โหวต 45/60/90 วิ (ค่าเริ่ม 60 · 3 นาที · 60) · วง 15–20 คนแนะนำคืน 90 วิ ประชุม 4–5 นาที</span></li>
        <li><i>👻</i><span>คนตายเห็นบททุกคน (ค่าเริ่มเปิด) · เปิดบทเมื่อตาย (ค่าเริ่มปิด)</span></li>
        <li><i>🤖</i><span>เพื่อนไม่ครบ หัวห้องกด 🤖 เพิ่มบอทได้ บอทเล่นได้ทุกบท</span></li>
      </ul>
      <%- guideNav('werewolf') %>
    </article>

    <article class="guide-card hp-game mode-spyfall" id="spyfall">
      <%- guideHead('spyfall', ['⏱ รอบละ 8 นาที', '🔁 1/3/5 รอบ']) %>
      <h2>รู้สถานที่ จับสายลับ</h2>
      <p>ทุกคนได้สถานที่เดียวกันและบทในที่นั้นคนละบท ยกเว้น<strong>สายลับ 1 คน</strong>ที่ไม่รู้ว่าอยู่ที่ไหน ต้องฟังคำถาม–คำตอบแล้วเนียนให้รอด</p>

      <h3 class="guide-sub">การ์ดที่แต่ละคนเห็น</h3>
      <div class="hp-cards hp-wide is-large" style="--hp-art: 1 / 1">
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูการ์ดพลเมืองขนาดใหญ่">
          <div class="hp-card-art sf-card"><img src="/assets/games/spyfall/beach.webp" alt="การ์ดสถานที่ชายหาด" width="512" height="512" loading="lazy" decoding="async"><span class="sf-card-copy"><small>พลเมือง · บทของคุณ</small><b>ไลฟ์การ์ด</b><em>🏖️ ชายหาด</em></span></div>
          <figcaption><b>🙂 พลเมือง</b><span class="hp-does">เห็นสถานที่กับบทของตัวเอง ทุกคนอยู่ที่เดียวกัน</span><span class="hp-when">ถามตอบให้พวกเดียวกันรู้ แต่อย่าชัดจนสายลับเดาออก</span></figcaption>
        </figure>
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูการ์ดสายลับขนาดใหญ่">
          <div class="hp-card-art sf-card is-spy"><img src="/assets/games/spyfall/spy.webp" alt="การ์ดสายลับ" width="1024" height="1024" loading="lazy" decoding="async"><span class="sf-card-copy"><small>คุณคือ</small><b>🕶️ สายลับ</b><em>ไม่รู้สถานที่</em></span></div>
          <figcaption><b>🕶️ สายลับ</b><span class="hp-does">ไม่รู้สถานที่ แต่เห็นรายชื่อสถานที่ทั้งหมด ขีดฆ่าตัวที่ไม่ใช่ได้</span><span class="hp-when">ฟังคำตอบ แล้วหยุดเวลาทายสถานที่ตอนมั่นใจ</span></figcaption>
        </figure>
      </div>

      <h3 class="guide-sub">ตัวอย่างการ์ดสถานที่</h3>
      <div class="hp-cards hp-wide is-small" style="--hp-art: 1 / 1">
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูสถานที่โรงพยาบาลขนาดใหญ่"><div class="hp-card-art"><img src="/assets/games/spyfall/hospital.webp" alt="โรงพยาบาล" width="512" height="512" loading="lazy" decoding="async"></div><figcaption><b>🏥 โรงพยาบาล</b><span class="hp-does">แพทย์ · พยาบาล · เภสัชกร · ญาติผู้ป่วย</span></figcaption></figure>
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูสถานที่สถานีอวกาศขนาดใหญ่"><div class="hp-card-art"><img src="/assets/games/spyfall/space.webp" alt="สถานีอวกาศ" width="512" height="512" loading="lazy" decoding="async"></div><figcaption><b>🚀 สถานีอวกาศ</b><span class="hp-does">ผู้บัญชาการ · นักบินอวกาศ · วิศวกรระบบ</span></figcaption></figure>
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูสถานที่วัดขนาดใหญ่"><div class="hp-card-art"><img src="/assets/games/spyfall/temple.webp" alt="วัด" width="512" height="512" loading="lazy" decoding="async"></div><figcaption><b>🛕 วัด</b><span class="hp-does">พระ · เณร · ผู้มาทำบุญ · พ่อค้าเครื่องบูชา</span></figcaption></figure>
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูสถานที่คาสิโนขนาดใหญ่"><div class="hp-card-art"><img src="/assets/games/spyfall/casino.webp" alt="คาสิโน" width="512" height="512" loading="lazy" decoding="async"></div><figcaption><b>🎰 คาสิโน</b><span class="hp-does">เจ้ามือ · นักพนัน · รปภ. · ผู้จัดการพื้น</span></figcaption></figure>
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูสถานที่สนามบินขนาดใหญ่"><div class="hp-card-art"><img src="/assets/games/spyfall/airport.webp" alt="สนามบิน" width="512" height="512" loading="lazy" decoding="async"></div><figcaption><b>✈️ สนามบิน</b><span class="hp-does">พนักงานเช็กอิน · นักเดินทาง · ไกด์ทัวร์</span></figcaption></figure>
        <figure class="hp-card" tabindex="0" role="button" aria-label="ดูสถานที่โรงเรียนขนาดใหญ่"><div class="hp-card-art"><img src="/assets/games/spyfall/school.webp" alt="โรงเรียน" width="512" height="512" loading="lazy" decoding="async"></div><figcaption><b>🏫 โรงเรียน</b><span class="hp-does">ครู · นักเรียน · ภารโรง · บรรณารักษ์</span></figcaption></figure>
      </div>
      <p class="hp-note">มีทั้งหมด 20 สถานที่ สถานที่ละ 8 บท (แอดมินเพิ่มสถานที่ได้)</p>

      <h3 class="guide-sub">หนึ่งรอบเล่นยังไง</h3>
      <ol class="hp-steps">
        <li><strong>🎤 ถาม–ตอบ</strong> เจ้ามือถามก่อน · คนที่ถูกถามตอบ แล้วถามคนอื่นต่อ · ห้ามถามกลับคนที่เพิ่งถามเรา</li>
        <li><strong>🛑 กล่าวหา</strong> ใครก็หยุดเวลาได้คนละ 1 ครั้งต่อรอบ · <strong>ทุกคนยกเว้นคนถูกกล่าวหาต้องเห็นด้วย</strong>ถึงเปิดการ์ด · ไม่โหวตใน 60 วิ = ไม่เห็นด้วย · มีคนไม่เห็นด้วย = เวลาเดินต่อ</li>
        <li><strong>🎯 สายลับทาย</strong> หยุดเวลาทายสถานที่ได้ 1 ครั้งตอนเวลายังเดิน (ไม่ใช่ระหว่างกล่าวหา) · ถูกชนะ ผิดแพ้</li>
        <li><strong>⏰ หมดเวลา</strong> ไล่ชี้ตัวทีละคน เริ่มจากเจ้ามือ คนละ 30 วิ · ไม่มีใครถูกจับ = สายลับรอด · กด “พร้อมโหวต” เกินครึ่ง = ข้ามเวลาที่เหลือ</li>
      </ol>

      <h3 class="guide-sub">คะแนน (เล่นหลายรอบ)</h3>
      <ul class="hp-points">
        <li><i>🕶️</i><span>สายลับรอด <strong>+2</strong> · จับผิดคน หรือทายสถานที่ถูก <strong>+4</strong></span></li>
        <li><i>🙂</i><span>จับสายลับได้ พลเมืองคนละ <strong>+1</strong> คนเริ่มกล่าวหา +1 · สายลับทายผิด พลเมืองคนละ +1</span></li>
        <li><i>🔁</i><span>สายลับรอบก่อนเป็นเจ้ามือรอบใหม่ · ค่าเริ่ม 5 รอบ (ตั้ง 1/3/5) แต้มรวมสูงสุดชนะ</span></li>
        <li><i>🗳️</i><span>ตั้งเป็น <strong>โหวตเสียงข้างมาก</strong>ได้: ไม่มีการหยุดเวลากล่าวหา หมดเวลาแล้วโหวตลับครั้งเดียว (90 วิ) เสมอ = สายลับรอด</span></li>
      </ul>
      <%- guideNav('spyfall') %>
    </article>

    <article class="guide-card hp-game mode-undercover" id="undercover">
      <%- guideHead('undercover') %>
      <h2>ใบ้คนละคำ หาคนที่คำไม่เหมือน</h2>
      <p>ทุกคนได้คำเดียวกัน ยกเว้น<strong>สายแฝง</strong>ที่ได้คำคล้าย ๆ แต่ไม่ใช่ (เช่น กาแฟ / ชา) — ไม่มีใครรู้ว่าตัวเองอยู่ฝั่งไหน ต้องฟังคำใบ้ของคนอื่นแล้วเดาเอง</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> พลเมืองโหวตฝ่ายแฝงออกให้หมด · ฝ่ายแฝงรอดจนเหลือพลเมืองแค่ 1 คน</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 3-10 คนที่นั่งด้วยกัน รอบละ 3-5 นาที</div>
        <div class="guide-list-item"><strong>กี่คนเป็นอะไร</strong> 3–6 คน สายแฝง 1 · 7–9 คน สายแฝง 2 · 10 คน สายแฝง 3 · Mr. White 1 คนตั้งแต่ 5 คน (หัวห้องปรับได้)</div>
        <div class="guide-list-item"><strong>หนึ่งรอบ</strong> แตะการ์ดดูคำ → ใบ้คนละ 1 คำตามคิว (พูดปากเปล่า ห้ามพูดคำตรง ๆ) → โหวตออก 1 คน → เปิดบทคนที่ออก</div>
        <div class="guide-list-item"><strong>เสมอ</strong> คนที่เสมอใบ้เพิ่มคนละ 1 คำ แล้วคนที่เหลือโหวตใหม่เฉพาะคนที่เสมอ · เสมออีก = รอบนั้นไม่มีใครออก</div>
        <div class="guide-list-item"><strong>Mr. White</strong> ไม่ได้คำเลย ต้องเนียนตามวง ไม่ได้พูดคนแรก · ถ้าถูกโหวตออกได้ทายคำพลเมือง 1 ครั้ง ทายถูก = ชนะคนเดียวทันที</div>
        <div class="guide-list-item"><strong>แต้ม</strong> ฝั่งที่ชนะได้แต้มสะสมในห้อง: พลเมือง +2 · Mr. White +6 · สายแฝง +10</div>
      </div>
      <div class="guide-coup-roles">
        <article class="guide-coup-role">
          <img src="/assets/games/undercover/civilian.svg" alt="พลเมือง" width="160" height="224" loading="lazy">
          <strong>🙂 พลเมือง</strong>
          <span>ได้คำเดียวกับคนส่วนใหญ่</span>
        </article>
        <article class="guide-coup-role">
          <img src="/assets/games/undercover/undercover.svg" alt="สายแฝง" width="160" height="224" loading="lazy">
          <strong>🕶️ สายแฝง</strong>
          <span>ได้คำคล้ายแต่ไม่ใช่</span>
        </article>
        <article class="guide-coup-role">
          <img src="/assets/games/undercover/mrwhite.svg" alt="Mr. White" width="160" height="224" loading="lazy">
          <strong>❔ Mr. White</strong>
          <span>ไม่มีคำ ทายถูกชนะ</span>
        </article>
      </div>
      <%- guideNav('undercover') %>
    </article>

    <article class="guide-card hp-game mode-avalon" id="avalon">
      <%- guideHead('avalon', ['⏱ ~30 นาที', '🏰 อัศวินโต๊ะกลม']) %>
      <h2>ฝ่ายดีทำภารกิจ ฝ่ายร้ายแฝงตัวบ่อนทำลาย</h2>
      <p>ทุกคนได้บทลับ ฝ่ายดีต้องทำ <strong>ภารกิจสำเร็จ 3 ใน 5</strong> ฝ่ายร้ายต้องทำให้ <strong>ล้ม 3 ครั้ง</strong> ไม่มีใครตกรอบ ทุกคนเล่นจนจบ</p>

      <h3 class="guide-sub">หนึ่งภารกิจเล่นยังไง</h3>
      <ol class="hp-steps">
        <li><strong>🌙 กลางคืน</strong> แตะการ์ดดูบทเงียบ ๆ · เมอร์ลินเห็นฝ่ายร้าย ฝ่ายร้ายเห็นกันเอง แล้วกดพร้อม</li>
        <li><strong>👑 หัวหน้าเลือกทีม</strong> ตามจำนวนบนช่องภารกิจ · หัวหน้าคนแรกสุ่ม แล้วมงกุฎเวียนไปคนถัดไป<strong>หลังโหวตทุกครั้ง</strong> ผ่านหรือไม่ผ่านก็ตาม</li>
        <li><strong>🗳️ ทุกคนโหวตทีม</strong> พร้อมกัน เห็นด้วยเกินครึ่งถึงผ่าน (เสมอ = ไม่ผ่าน) · ไม่ผ่าน 5 ครั้งในภารกิจเดียว = ฝ่ายร้ายชนะทันที</li>
        <li><strong>🃏 ทีมลงการ์ดภารกิจลับ</strong> ฝ่ายดีลงได้แค่ “สำเร็จ” ฝ่ายร้ายเลือกได้ · มีการ์ดล้ม 1 ใบก็ล้ม (ภารกิจ 4 ตอนเล่น 7+ คน ต้องล้ม 2 ใบ)</li>
        <li><strong>🗡️ ลอบสังหาร</strong> ฝ่ายดีสำเร็จครบ 3 แล้ว ฝ่ายร้ายเปิดตัวคุยกัน (รวมโอเบรอน) แล้วมือสังหารแทงฝ่ายดี 1 คน · โดนเมอร์ลิน = ฝ่ายร้ายพลิกชนะ</li>
      </ol>

      <h3 class="guide-sub">เหรียญและการ์ดบนโต๊ะ</h3>
      <div class="hp-cards hp-wide is-small" style="--hp-art: 1 / 1">

    <%
      const lrCard = function (img, name, does, when, label) {
        return '<figure class="hp-card" tabindex="0" role="button" aria-label="ดูไพ่' + label + 'ขนาดใหญ่">' +
          '<div class="hp-card-art is-contain lr-art"><img src="/assets/games/liar/' + img + '.svg" alt="ไพ่' + label + '" width="240" height="336" loading="lazy" decoding="async"></div>' +
          '<figcaption><b>' + name + '</b><span class="hp-does">' + does + '</span>' + (when ? '<span class="hp-when">' + when + '</span>' : '') + '</figcaption></figure>';
      };
      const lrGun = function (used, label) {
        let pips = '';
        for (let i = 0; i < 6; i++) pips += '<span class="lr-gun-pip' + (i < used ? ' is-used' : '') + '"></span>';
        const left = 6 - used;
        return '<div class="lr-gun-row"><span class="lr-gun">🔫<span class="lr-gun-pips">' + pips + '</span><span class="lr-gun-odds' + (left <= 2 ? ' is-hot' : '') + '">1/' + left + '</span></span><small>' + label + '</small></div>';
      };
    %>
    <article class="guide-card hp-game mode-liar" id="liar">
      <%- guideHead('liar', ['⏱ ~10 นาที', '🤖 มีบอท']) %>
      <h2>ลงไพ่คว่ำ อ้างว่าเป็นไพ่บนโต๊ะ ใครแพ้ต้องลั่นไก</h2>
      <p>กติกาแบบ Liar's Bar ทุกรอบแจกคนละ 5 ใบ แล้วสุ่ม<strong>ไพ่บนโต๊ะ</strong> (A, K หรือ Q) ถึงตาลง 1–3 ใบคว่ำ แล้วอ้างว่าเป็นไพ่บนโต๊ะ โกหกได้ คนถัดไปจะลงต่อหรือกด “โกหก!” ก็ได้</p>

      <h3 class="guide-sub">ไพ่ในสำรับ</h3>
      <div class="hp-cards hp-wide is-small" style="--hp-art: 240 / 336">
        <%- lrCard('ace', 'A ♠ เอซ', 'ไพ่ปกติ ตรงกับโต๊ะเมื่อโต๊ะเป็น A', 'โต๊ะ A ลงจริงได้เลย', 'เอซ') %>
        <%- lrCard('king', 'K ♥ คิง', 'ไพ่ปกติ ตรงกับโต๊ะเมื่อโต๊ะเป็น K', 'ไม่ตรงโต๊ะ = ใช้บลัฟ', 'คิง') %>
        <%- lrCard('queen', 'Q ♦ ควีน', 'ไพ่ปกติ ตรงกับโต๊ะเมื่อโต๊ะเป็น Q', 'ไม่ตรงโต๊ะ = ใช้บลัฟ', 'ควีน') %>
        <%- lrCard('joker', '🃏 โจ๊กเกอร์', 'นับเป็นไพ่บนโต๊ะเสมอ', 'ลงปนกับไพ่ปลอมให้ดูน่าเชื่อ', 'โจ๊กเกอร์') %>
        <%- lrCard('devil', '😈 ไพ่ปีศาจ', 'ต้องลงใบเดียว นับว่าจริง · ถ้าโดนท้า ทุกคนยกเว้นคนลงรับโทษ เริ่มจากคนท้า', 'หัวห้องเปิดเท่านั้น · ใช้ได้ตอนเหลือ 3 คนขึ้นไป', 'ปีศาจ') %>
      </div>
      <p class="hp-note">3–4 คน: A K Q อย่างละ 6 + โจ๊กเกอร์ 2 · 5–8 คน ใช้ 2 สำรับ (อย่างละ 12 + โจ๊กเกอร์ 4) · ไพ่ปีศาจแทนไพ่บนโต๊ะ 1 ใบต่อรอบ และอาจไม่ถูกแจกเลย</p>

      <h3 class="guide-sub">กด “โกหก!” แล้วเกิดอะไร</h3>
      <ol class="hp-steps">
        <li><strong>หงายไพ่ที่เพิ่งลง</strong> มีใบไม่ตรงแม้ใบเดียว = คนลงแพ้ · ตรงหมด (รวมโจ๊กเกอร์) = คนท้าแพ้</li>
        <li><strong>คนแพ้ลั่นไกปืนของตัวเอง</strong> ปัง = ตกรอบ · แชะ = รอด</li>
        <li><strong>เริ่มรอบใหม่</strong> แจกใหม่ สุ่มไพ่บนโต๊ะใหม่ · คนโดนจับโกหกเริ่มก่อน (ถ้ายังรอด) ไม่งั้นคนถัดจากคนท้าเริ่ม</li>
      </ol>

      <h3 class="guide-sub">🔫 ปืนลูกโม่ 6 ช่อง</h3>
      <div class="lr-guns">
        <%- lrGun(0, 'เริ่มเกม โอกาสโดน 1/6') %>
        <%- lrGun(2, 'รอดมาแล้ว 2 นัด โอกาส 1/4') %>
        <%- lrGun(4, 'รอด 4 นัด เหลือ 1/2 — ตัวแดง = อันตราย') %>
      </div>
      <ul class="hp-points">
        <li><i>🎯</i><span>ทุกคนมีปืนของตัวเอง กระสุน 1 นัด ตำแหน่งสุ่มครั้งเดียวตอนเริ่มเกม <strong>ไม่หมุนใหม่</strong> นัดที่ยิงไปแล้วนับต่อข้ามรอบ</span></li>
        <li><i>❤️</i><span>หัวห้องเปลี่ยนเป็น <strong>หัวใจ 3 ดวง</strong> แทนปืนได้ แพ้เสีย 1 ดวง หมด = ตกรอบ</span></li>
      </ul>

      <h3 class="guide-sub">ข้อควรรู้</h3>
      <ul class="hp-points">
        <li><i>🏆</i><span><strong>ชนะ</strong> รอดคนสุดท้าย ไม่ใช่ทิ้งไพ่ให้หมดมือ</span></li>
        <li><i>✋</i><span>ไพ่หมดมือ ข้ามตาจนจบรอบ · เหลือคนเดียวที่มีไพ่ = ต้องกด “โกหก!”</span></li>
        <li><i>⏱</i><span>ตาละ 30 วิ หมดเวลาระบบลงใบแรกให้ (ต้องท้า = ท้าให้) · ตาที่แล้วหมดเวลา ตานี้เหลือ 12 วิ</span></li>
        <li><i>🤖</i><span>หัวห้องกด 🤖 เพิ่มบอทในห้องรอได้จนครบ 8 ที่</span></li>
      </ul>
      <%- guideNav('liar') %>
    </article>

    <article class="guide-card hp-game mode-poker" id="poker5">
      <%- guideHead('poker5', ['🤖 บอทเฉพาะโต๊ะเล่นสนุก']) %>
      <h2>ได้ 5 ทิ้ง 2 ลงชิปรอบเดียว แล้วเปิด 3 ใบเทียบ</h2>
      <p>ทุกคนวางกองก่อนแจก ได้ไพ่ 5 ใบ เลือกเก็บ 3 ใบที่ดีที่สุด แล้วสู้ ตาม เกทับ หรือหมอบ มือใหญ่สุดกินกอง</p>
      <ol class="hp-steps">
        <li><strong>💰 วางกอง</strong> ทุกคนวางเท่ากันก่อนแจก (หัวห้องตั้ง 100–2,000 ค่าเริ่ม 500) · ลงขั้นต่ำและเกทับขั้นต่ำเท่ากับกองนี้</li>
        <li><strong>🃏 ได้ 5 ทิ้ง 2</strong> ใน 30 วิ · หมดเวลาระบบเลือก 3 ใบที่ดีที่สุดให้</li>
        <li><strong>🪙 ลงชิปรอบเดียว</strong> ตาละ 20 วิ · หมดเวลา: ยังไม่มีใครสู้ = ผ่าน · มีคนสู้แล้ว = หมอบ</li>
        <li><strong>👀 เปิดเทียบ</strong> ไพ่ 3 ใบใหญ่สุดกินกอง · ไพ่ที่ทิ้ง 2 ใบหงายให้ดูด้วย</li>
      </ol>

      <h3 class="guide-sub">ลำดับมือ ใหญ่ → เล็ก</h3>
      <div class="hp-cards hp-wide is-large">
        <% pokerGuideRows.forEach((row, index) => { %>
          <%- pkHand((row.example || []).map(c => c.image), (index + 1) + '. ' + row.name, row.hint) %>
        <% }) %>
      </div>
      <ul class="hp-points">
        <li><i>⚖️</i><span><strong>มือเท่ากัน</strong> ดูใบใหญ่สุด (เอซใหญ่สุดเวลาเทียบ แม้นับแต้มเป็น 1) แล้วดูดอก ♠ &gt; ♥ &gt; ♦ &gt; ♣ — ไพ่ไม่ซ้ำกัน จึงไม่มีเสมอ</span></li>
        <li><i>👑</i><span>J-Q-K คนละดอก = <strong>เซียน</strong> · ดอกเดียวกัน = <strong>เรียงสี</strong></span></li>
      </ul>

      <h3 class="guide-sub">สองแบบโต๊ะ</h3>
      <ul class="hp-points">
        <li><i>🎉</i><span><strong>เล่นสนุก</strong> ได้ชิป 10,000 ชนะเก็บยอด · ชิปเหลือน้อยกว่ากองตอนเริ่มมือ ระบบรีเซ็ตเป็น 10,000 · ไม่เก็บผล · ใส่บอทได้</span></li>
        <li><i>💎</i><span><strong>เล่นเก็บชิป</strong> ใช้ชิปในบัญชี ชนะได้ไป แพ้หาย · รับชิปเพิ่มได้วันละครั้ง · ชิปไม่พอวางกอง = นั่งดูมือนั้น · ใส่บอทไม่ได้</span></li>
      </ul>
      <%- guideNav('poker5') %>
    </article>

    <article class="guide-card hp-game mode-poker4" id="poker4">
      <%- guideHead('poker4', ['🤖 บอทเฉพาะโต๊ะเล่นสนุก']) %>
      <h2>ได้ 4 ทิ้ง 2 ลงชิปรอบแรก ได้ใบที่ 3 แล้วลงชิปอีกรอบ</h2>
      <p>แบบ “2 ใบเก” ของวงไทย ลงชิปสองรอบ: รอบแรกตอนถือ 2 ใบ รอบสองหลังได้ใบที่ 3 แล้วค่อยเปิดเทียบ ไม่มีใบที่ 4</p>
      <ol class="hp-steps">
        <li><strong>💰 วางกอง</strong> ทุกคนวางเท่ากันก่อนแจก (หัวห้องตั้ง 100–2,000 ค่าเริ่ม 500)</li>
        <li><strong>🃏 ได้ 4 ทิ้ง 2</strong> ใน 30 วิ · หมดเวลาระบบเลือก 2 ใบที่ดีที่สุดให้</li>
        <li><strong>🪙 ลงชิปรอบแรก</strong> สู้ ตาม เกทับ หรือหมอบ (ตาละ 20 วิ) · หมอบ = ไม่ได้ใบที่ 3 กินกองไม่ได้</li>
        <li><strong>🂠 ได้ใบที่ 3</strong> คว่ำ เห็นเองคนเดียว (หัวห้องตั้งให้หงายให้ทั้งโต๊ะเห็นได้)</li>
        <li><strong>🪙 ลงชิปรอบสอง</strong> แล้วเปิดเทียบ มือใหญ่สุดกินกอง</li>
      </ol>
      <div class="hp-cards hp-wide is-large">
        <%- pkHand(['8h', '9h', 'back'], 'ถือ 2 ใบ รอใบที่ 3', '8♥ 9♥ ลุ้นเรียงสี (7♥ หรือ 10♥) หรือสี (♥ ใบไหนก็ได้)', 'มือแบบนี้น่าสู้ในรอบแรก') %>
        <%- pkHand(['8h', '9h', '10h'], 'ได้ใบที่ 3 = เรียงสี', '8♥ 9♥ 10♥ มือใหญ่อันดับ 2 รองจากตอง', 'เกทับเต็มที่ในรอบสอง') %>
      </div>
      <p class="hp-note">ลำดับมือเหมือนไพ่ 5 ใบทุกอย่าง: ตอง &gt; เรียงสี &gt; เซียน &gt; เรียง &gt; สี &gt; แต้ม — <a href="#poker5">ดูตัวอย่างครบที่ไพ่ 5 ใบ</a></p>
      <ul class="hp-points">
        <li><i>🎉</i><span><strong>เล่นสนุก</strong> ชิป 10,000 ไม่เก็บผล ใส่บอทได้ · <strong>เล่นเก็บชิป</strong> ใช้ชิปในบัญชี ใส่บอทไม่ได้</span></li>
      </ul>
      <%- guideNav('poker4') %>
    </article>

    <article class="guide-card hp-game mode-pokdeng" id="pokdeng">
      <%- guideHead('pokdeng', ['🤖 มีบอท', '🪙 ชิปในโต๊ะไม่มีมูลค่าจริง']) %>
      <h2>แจก 2 ใบ ป๊อกเปิดเลย จั่วเพิ่มได้ 1 ใบ แล้ววัดกับเจ้ามือ</h2>
      <p>แต้ม = หลักหน่วยของผลรวม (A = 1 · 10 J Q K = 0) ได้ 8 หรือ 9 จาก 2 ใบแรก = <strong>ป๊อก</strong> เปิดทันที ไม่ต้องจั่ว</p>
      <ol class="hp-steps">
        <li><strong>🪙 ลงเดิมพัน</strong> 10 ถึงอั้นของห้อง (100/200/500 ค่าเริ่ม 500) แล้วได้ไพ่คนละ 2 ใบ</li>
        <li><strong>⚡ ป๊อก</strong> ใครป๊อกเปิดเลย · เจ้ามือป๊อก = เปิดวัดทุกคนทันที</li>
        <li><strong>🃏 จั่วหรืออยู่</strong> ขาไพ่ไล่ตัดสินใจจั่วเพิ่มได้ 1 ใบ · หมดเวลา = อยู่</li>
        <li><strong>🎯 ตาเจ้ามือ</strong> 2 ใบได้ 4 แต้มขึ้นไป <strong>จับ</strong>ขาที่ถือ 3 ใบ หรือ 2 ใบ วัดก่อนได้ แล้วจั่ว/อยู่สู้ขาที่เหลือ · หมดเวลา เจ้ามือ 3 แต้มลงมาจั่วให้</li>
        <li><strong>💸 จ่าย</strong> ชนะได้ เดิมพัน × เด้งของมือตัวเอง · แพ้เสีย เดิมพัน × เด้งของเจ้ามือ</li>
      </ol>

      <h3 class="guide-sub">อันดับไพ่ ใหญ่ → เล็ก</h3>
      <div class="hp-cards hp-wide is-large">
        <%- pkHand(['9s', 'kh'], 'ป๊อก 9', 'ชนะทุกอย่าง ยกเว้นป๊อก 9 อีกมือ (เท่ากัน = เสมอ) · 1 เด้ง', '2 ใบแรกเท่านั้น ชนะแม้เจอตอง') %>
        <%- pkHand(['4h', '5h'], 'ป๊อก 9 สองเด้ง', 'ป๊อกที่ดอกเดียวกันหรือเป็นคู่ = 2 เด้ง', '') %>
        <%- pkHand(['3s', '5d'], 'ป๊อก 8', 'แพ้ป๊อก 9 อย่างเดียว · 1 เด้ง (คู่/ดอกเดียว 2 เด้ง)', '') %>
        <%- pkHand(['7s', '7h', '7d'], 'ตอง', 'สามใบหน้าเดียวกัน · 5 เด้ง · ตองเทียบกัน A ใหญ่สุด 2 เล็กสุด', '') %>
        <%- pkHand(['4h', '5h', '6h'], 'สเตรทฟลัช', 'เรียงและดอกเดียวกัน · 5 เด้ง', '') %>
        <%- pkHand(['4c', '5h', '6s'], 'เรียง', '2-3-4 ถึง Q-K-A (A-2-3 กับ K-A-2 ไม่นับ) · J-Q-K ก็เป็นเรียง · 3 เด้ง', '') %>
        <%- pkHand(['js', 'qd', 'jh'], 'เซียน', 'J Q K ล้วน และมีใบซ้ำ (เช่น J Q J) · 3 เด้ง · เซียนเจอเซียน = เสมอ', '') %>
        <%- pkHand(['2c', '5c', 'kc'], '7 แต้ม สามเด้ง', '3 ใบดอกเดียวกัน (ไม่เรียง) = 3 เด้ง', '') %>
        <%- pkHand(['2h', '5h'], '7 แต้ม สองเด้ง', '2 ใบดอกเดียวกัน หรือเป็นคู่ = 2 เด้ง', '') %>
        <%- pkHand(['3c', '4d'], '7 แต้ม', 'แต้มธรรมดา 1 เด้ง · แต้มเท่ากัน = เสมอ คืนเดิมพัน (2 ใบเจอ 3 ใบก็เสมอ)', '') %>
        <%- pkHand(['10s', 'kh'], 'บอด (0 แต้ม)', 'เล็กสุด · ควรจั่วเพิ่ม', '') %>
      </div>
      <p class="hp-note">3 ใบที่มีคู่ไม่ได้เด้ง · โต๊ะที่ปิด “นับไพ่เรียง” ไพ่เรียงนับเป็นแต้มธรรมดา (ดอกเดียวกันยังได้สามเด้ง) และ J-Q-K นับเป็นเซียน</p>

      <h3 class="guide-sub">ตั้งค่าห้อง · กติกาโต๊ะ</h3>
      <ul class="hp-points">
        <li><i>🏦</i><span><strong>เจ้ามือ</strong> หัวห้องเป็นเจ้ามือ (ถือ 5,000) หรือหมุนเจ้ามือทุกตา (ทุกคนเริ่ม 1,000) · เปลี่ยนได้ก่อนแจกมือแรกเท่านั้น · เจ้ามือชิปไม่พอจ่าย = แบ่งจ่ายตามสัดส่วน</span></li>
        <li><i>⚙️</i><span>อั้น 100/200/500 · นับไพ่เรียง (ค่าเริ่ม นับ) · ต่ำกว่า 4 ต้องจั่ว ทั้งขาไพ่และเจ้ามือ (ค่าเริ่ม ปิด) · ล็อกเมื่อเริ่มโต๊ะ</span></li>
        <li><i>💤</i><span>หมดเวลาลงเดิมพันครั้งแรก ลงขั้นต่ำให้ · 2 มือติด = พักโต๊ะ กด “กลับมาเล่น” เมื่อพร้อม · ไม่มีใครลงเดิมพัน 3 มือติด = จบโต๊ะ</span></li>
        <li><i>🪙</i><span>ทุกคนเริ่ม 1,000 ไม่เกี่ยวกับกระเป๋าชิป หมดตัวขอใหม่ได้ 1 ครั้ง · จบโต๊ะแล้วชิปมากกว่าทุน (รวมที่ขอใหม่) = ชนะ นับเจ้ามือด้วย</span></li>
        <li><i>🤖</i><span>หัวห้องเพิ่มบอทได้ บอทขอชิปใหม่เอง · อยากเล่นคนเดียว ลอง <a href="/solo/pokdengsolo">ป๊อกเด้งท้าเจ้ามือ</a></span></li>
      </ul>
      <%- guideNav('pokdeng') %>
    </article>

    <%
      // หน้าไพ่แบบเดียวกับ faceHtml() ใน colorcardsBoard.ejs (HTML + SVG ไม่ใช้รูป)

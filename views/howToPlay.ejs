<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --guide-bg: #07080c;
    --guide-surface: #12141c;
    --guide-panel: rgba(255, 255, 255, 0.06);
    --guide-ink: #ebeef6;
    --guide-muted: #9aa7b9;
    --guide-line: rgba(148, 176, 255, 0.12);
    --guide-accent: #ff4466;
    --guide-accent-2: #5bc0ff;
    --guide-deep: #b8324a;
    --guide-gold: #f0c14d;
    --guide-shadow: 0 24px 56px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  body.content {
    background:
      radial-gradient(ellipse 80% 55% at 12% -10%, rgba(91, 192, 255, 0.14), transparent 55%),
      radial-gradient(ellipse 70% 50% at 92% 0%, rgba(255, 68, 102, 0.11), transparent 50%),
      radial-gradient(ellipse 120% 80% at 50% 120%, rgba(240, 193, 77, 0.06), transparent 45%),
      linear-gradient(180deg, #05060a 0%, #0e1018 40%, #08090e 100%);
  }

  .guide-page {
    max-width: 1180px;
    margin: 24px auto 40px;
    padding: 0 18px 24px;
    color: var(--guide-ink);
    font-family: 'Bai Jamjuree', sans-serif;
    text-align: left;
  }

  .guide-hero {
    position: relative;
    overflow: hidden;
    padding: 30px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    background:
      radial-gradient(ellipse 120% 80% at 100% -20%, rgba(91, 192, 255, 0.12), transparent 50%),
      radial-gradient(circle at 0% 100%, rgba(255, 68, 102, 0.08), transparent 40%),
      linear-gradient(155deg, #13151f 0%, #0f1118 50%, #0c0e14 100%);
    box-shadow: var(--guide-shadow);
  }

  .guide-hero::after {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px dashed rgba(148, 176, 255, 0.14);
    border-radius: 24px;
    pointer-events: none;
  }

  .guide-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(91, 192, 255, 0.12);
    color: var(--guide-accent-2);
    border: 1px solid rgba(91, 192, 255, 0.22);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .guide-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 20px;
    margin-top: 18px;
    align-items: start;
  }

  .guide-title {
    margin: 0;
    max-width: 12ch;
    font-family: 'Chakra Petch', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
  }

  .guide-copy {
    max-width: 62ch;
    margin: 16px 0 0;
    color: var(--guide-muted);
    font-size: 1.03rem;
    line-height: 1.72;
  }

  .guide-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .guide-chip {
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.04);
    color: #c9d4e5;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .guide-sidecard {
    display: grid;
    gap: 16px;
    padding: 22px;
    border-radius: 24px;
    background:
      radial-gradient(circle at 100% 0%, rgba(255, 193, 77, 0.08), transparent 45%),
      linear-gradient(165deg, #1a1720 0%, #121019 100%);
    color: #ebe8ef;
    border: 1px solid rgba(255, 193, 77, 0.15);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
  }

  .guide-sidecard h2 {
    margin: 0;
    font-family: 'Chakra Petch', sans-serif;
    font-size: 1.3rem;
  }

  .guide-sidecard p {
    margin: 0;
    color: rgba(200, 207, 220, 0.88);
    line-height: 1.65;
  }

  .guide-side-list {
    display: grid;
    gap: 10px;
  }

  .guide-side-item {
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #dde3ec;
  }

  .guide-section-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 20px;
  }

  .guide-card {
    padding: 22px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, #161822 0%, #101219 100%);
    box-shadow: var(--guide-shadow);
  }

  .guide-card.mode-insider {
    border-color: rgba(255, 68, 102, 0.35);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(255, 68, 102, 0.12), transparent 55%),
      linear-gradient(180deg, #1a1518 0%, #121016 55%, #0e0d10 100%);
  }

  .guide-card.mode-werewolf {
    border-color: rgba(91, 192, 255, 0.32);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(91, 192, 255, 0.11), transparent 55%),
      linear-gradient(180deg, #141820 0%, #0f131a 55%, #0c0f14 100%);
  }

  .guide-card.mode-blackmarket {
    border-color: rgba(240, 193, 77, 0.32);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(240, 193, 77, 0.1), transparent 55%),
      linear-gradient(180deg, #181612 0%, #121110 55%, #0e0d0b 100%);
  }

  .guide-card.mode-coup {
    border-color: rgba(196, 141, 255, 0.35);
    background:
      radial-gradient(ellipse 100% 80% at 50% -30%, rgba(168, 85, 247, 0.12), transparent 55%),
      linear-gradient(180deg, #18141f 0%, #121018 55%, #0e0c12 100%);
  }

  .guide-mode-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .guide-card.mode-insider .guide-mode-badge {
    background: rgba(255, 68, 102, 0.14);
    color: #ff8a9d;
    border: 1px solid rgba(255, 68, 102, 0.35);
  }

  .guide-card.mode-werewolf .guide-mode-badge {
    background: rgba(91, 192, 255, 0.12);
    color: #8fd4ff;
    border: 1px solid rgba(91, 192, 255, 0.35);
  }

  .guide-card.mode-blackmarket .guide-mode-badge {
    background: rgba(240, 193, 77, 0.12);
    color: #efd07a;
    border: 1px solid rgba(240, 193, 77, 0.32);
  }

  .guide-card.mode-coup .guide-mode-badge {
    background: rgba(196, 141, 255, 0.14);
    color: #d4b3ff;
    border: 1px solid rgba(196, 141, 255, 0.35);
  }

  .guide-coup-roles {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .guide-coup-role {
    display: grid;
    gap: 8px;
    padding: 0 0 10px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(196, 141, 255, 0.18);
    text-align: left;
  }

  .guide-coup-role img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
    background: #1c1030;
  }

  .guide-coup-role strong,
  .guide-coup-role span {
    padding: 0 10px;
  }

  .guide-coup-role strong {
    color: #f3f6fc;
    font-size: 0.92rem;
  }

  .guide-coup-role span {
    color: #c8d2e3;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .guide-coup-roles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .guide-coup-roles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .guide-card h2,
  .guide-card h3 {
    margin: 0;
    font-family: 'Chakra Petch', sans-serif;
    color: var(--guide-ink);
    letter-spacing: -0.02em;
  }

  .guide-card p {
    color: var(--guide-muted);
    line-height: 1.72;
    font-weight: 500;
  }

  .guide-list {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .guide-list-item {
    padding: 12px 14px;
    border-radius: 16px;
    background: var(--guide-panel);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: #c8d2e3;
    line-height: 1.6;
  }

  .guide-list-item strong {
    color: #f3f6fc;
    font-weight: 700;
  }

  .guide-compare {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 18px;
    margin-top: 20px;
  }

  .guide-faq {
    display: grid;
    gap: 12px;
  }

  .guide-faq-item {
    padding: 16px 18px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--guide-muted);
  }

  .guide-faq-item strong {
    display: block;
    margin-bottom: 6px;
    color: var(--guide-ink);
  }

  .guide-cta {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .guide-footer {
    display: flex;
    justify-content: center;
    padding: 8px 16px 24px;
  }

  .guide-footer .guide-cta-button {
    width: min(420px, 100%);
  }

  .guide-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 22px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--guide-accent), #8b2f5c);
    color: #fff;
    text-decoration: none;
    font-family: 'Chakra Petch', sans-serif;
    font-size: 1.02rem;
    font-weight: 700;
    border: 1px solid rgba(255, 68, 102, 0.45);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.35) inset,
      0 20px 40px rgba(255, 68, 102, 0.18);
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .guide-cta-button:hover {
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
    filter: brightness(1.08);
  }

  @media (max-width: 980px) {
    .guide-hero-grid,
    .guide-section-grid,
    .guide-compare {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .guide-page {
      padding: 0 12px 20px;
    }

    .guide-hero,
    .guide-card {
      padding: 18px;
      border-radius: 24px;
    }

    .guide-title {
      max-width: none;
      font-size: 2.4rem;
    }
  }
</style>

<div class="guide-page">
  <section class="guide-hero">
    <span class="guide-kicker">How To Play</span>
    <div class="guide-hero-grid">
      <div>
        <h1 class="guide-title">วิธีเล่นทุกโหมด เข้าใจได้ในหน้าเดียว</h1>
        <p class="guide-copy">หน้านี้สรุปวิธีเล่นทั้ง 5 โหมด — Insider, Werewolf, Black Market, Spyfall และ Coup — แบบอ่านเร็วแล้วเริ่มวงได้เลย เหมาะทั้งคนที่เพิ่งเคยเล่นครั้งแรกและคนที่ต้องอธิบายกติกาให้เพื่อนก่อนกดสร้างห้อง</p>
        <div class="guide-chip-row">
          <span class="guide-chip">อธิบายสั้นแต่ครบ</span>
          <span class="guide-chip">มีจุดชนะของแต่ละโหมด</span>
          <span class="guide-chip">ใช้ก่อนสร้างห้องได้ทันที</span>
        </div>
      </div>
      <aside class="guide-sidecard">
        <div>
          <h2>เลือกโหมดไหนดี?</h2>
          <p>คนน้อย (2-6) และอยากได้เกมสั้นๆ ลุ้นจับโกหก เลือก Coup · เปิดวงไวสุด เลือก Insider · อยากได้บทบาทเยอะและคุยยาว เลือก Werewolf · อยากได้เกมต่อรองผลประโยชน์ เลือก Black Market · อยากถามตอบจับสายลับ เลือก Spyfall</p>
        </div>
        <div class="guide-side-list">
          <div class="guide-side-item">🎯 Insider: เร็วที่สุด เหมาะกับคนเริ่มวง</div>
          <div class="guide-side-item">🐺 Werewolf: มีบทบาทเยอะ คุยลึกกว่า</div>
          <div class="guide-side-item">🎩 Black Market: เจรจา บลัฟ ต่อรอง</div>
          <div class="guide-side-item">🕶️ Spyfall: สถานที่ + จับสายลับ</div>
          <div class="guide-side-item">👑 Coup: โกหกแล้วลุ้นว่าใครจับได้</div>
        </div>
      </aside>
    </div>
  </section>

  <section class="guide-section-grid">
    <article class="guide-card mode-insider">
      <div class="guide-mode-badge">🎯 Insider</div>
      <h2>ทายคำ แล้วจับคนที่รู้คำ</h2>
      <p>โหมดนี้เล่นง่ายที่สุด ผู้ดำเนินเกมรู้คำตอบ จอมบงการรู้คำเหมือนกัน แต่ต้องเนียนไปกับวงโดยไม่ให้คนอื่นจับได้</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> ทายคำให้ถูก แล้วโหวตจับจอมบงการให้เจอ</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 4-8 คนที่อยากเริ่มเกมเร็วและอธิบายกติกาง่าย</div>
        <div class="guide-list-item"><strong>จุดเด่น</strong> จบไว อ่านคนชัด และใช้การถามคำถามเป็นแกนหลัก</div>
      </div>
    </article>

    <article class="guide-card mode-werewolf">
      <div class="guide-mode-badge">🐺 Werewolf</div>
      <h2>กลางคืนใช้สกิล กลางวันตัดสิน</h2>
      <p>โหมดนี้เน้นบทบาทและข้อมูลที่ไม่เท่ากัน หมาป่าพยายามลดจำนวนชาวบ้าน ขณะที่ฝ่ายหมู่บ้านต้องใช้ข้อมูลสะสมและการคุยกันเพื่อหาตัวจริง</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> ชาวบ้านต้องกำจัดหมาป่าหมด หมาป่าต้องอยู่รอดจนจำนวนไม่น้อยกว่าฝ่ายตรงข้าม</div>
        <div class="guide-list-item"><strong>บทบาท</strong> เปิดได้หลายแบบในล็อบบี้ เช่น ผู้หยั่งรู้·นักพยากรณ์ (ตรวจตัวตน), หมอ·บอดี้การ์ด·แม่มด·นักบวช (ป้องกัน), ศาลเตี้ย·พราน (ยิง), นักสอดแนม, นายก (เสียงโหวต x2), จอมเปิดโปง, คนบ้า</div>
        <div class="guide-list-item"><strong>คืนแรก</strong> หมาป่ายังกินใครไม่ได้ ใช้สำรวจข้อมูลก่อน · แชตกลางคืนคุยได้เฉพาะหมาป่า</div>
        <div class="guide-list-item"><strong>โหวตกลางวัน</strong> แขวนได้เมื่อเสียงเกินครึ่งของน้ำหนักเสียงทั้งหมด เสมอ = ไม่แขวน · ถ้าเสียง “ข้ามโหวต” เกินครึ่งจะข้ามวันเข้ากลางคืนทันที</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 5-10 คนที่อยากเล่นหลายรอบและชอบบทบาทพิเศษ</div>
        <div class="guide-list-item"><strong>จุดเด่น</strong> มี phase กลางคืนและกลางวัน ทำให้เกมพลิกได้จากสกิลกับการโหวต</div>
      </div>
    </article>

    <article class="guide-card mode-blackmarket">
      <div class="guide-mode-badge">🎩 Black Market</div>
      <h2>ต่อรอง บลัฟ และหักเหลี่ยม</h2>
      <p>Black Market เน้นความสัมพันธ์บนโต๊ะและการอ่านเจตนา ผู้เล่นแต่ละบทมองหาผลประโยชน์ของตัวเองผ่านการแลกข้อมูล การต่อรอง และการวางจังหวะ</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> สะสม 👑 อิทธิพลให้มากที่สุดเมื่อจบ 5 ยก (หรือเป็นคนสุดท้ายที่เหลือบนโต๊ะ)</div>
        <div class="guide-list-item"><strong>แต่ละยกมี 2 ช่วง</strong> ① ตลาด — ซื้อของเถื่อน 1 ชิ้นหรือผ่าน · ② ลงมือ — เลือก 1 แอ็กชัน ทุกคนเฉลยพร้อมกัน</div>
        <div class="guide-list-item"><strong>ทางได้ 👑</strong> หลัก ๆ คือ <strong>ส่งของ</strong> (แปลงของเถื่อนเป็นอิทธิพล) และ <strong>ดีล</strong></div>
        <div class="guide-list-item"><strong>กติกาดีล</strong> ดีลจะปิดต่อเมื่อ <strong>ทั้งสองฝ่ายกดเข้าดีลใส่กันในยกเดียวกัน</strong> — เปิดดีลฝ่ายเดียวจะยังไม่เกิดอะไร · ระวังโดน <strong>หักหลัง</strong></div>
        <div class="guide-list-item"><strong>🔥 ความร้อน</strong> สูงถึง 5 ขึ้นไปจะโดนปรับ −💵 และ −👑 · ใช้ 🫥 หมอบต่ำเพื่อลดความร้อน</div>
        <div class="guide-list-item"><strong>แอ็กชันอื่น</strong> สืบข่าว, ปล้นเงิน/ของ, สั่งเก็บ (ใช้ปืน), คุ้มกัน · ทุกบทบาทมีสกิลพิเศษของตัวเอง</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วงที่อยากได้เกมเจรจามากขึ้นกว่าการโกหกตรง ๆ</div>
        <div class="guide-list-item"><strong>จุดเด่น</strong> ทุกคำพูดมีราคา และ alliance เปลี่ยนได้ตลอดทั้งเกม</div>
      </div>
    </article>

    <article class="guide-card mode-spyfall">
      <div class="guide-mode-badge">🕶️ Spyfall</div>
      <h2>รู้สถานที่ จับสายลับ</h2>
      <p>ทุกคนได้สถานที่เดียวกัน ยกเว้นสายลับ 1 คนที่ต้องเดาจากคำถาม–คำตอบโดยไม่เปิดเผยตัว</p>
      <div class="guide-list">
        <div class="guide-list-item"><strong>เป้าหมาย</strong> พลเมืองโหวตจับสายลับ · สายลับหลบรอด</div>
        <div class="guide-list-item"><strong>เหมาะกับ</strong> วง 4-8 คนที่อยากเล่นรอบเดียวจบใน 10-15 นาที</div>

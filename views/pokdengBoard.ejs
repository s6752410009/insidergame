  แชท <span id="chatUnreadDot" class="unread-dot" style="display:none;"></span>
</button>

<%- contentFor('script') %>
<script src="/js/chatPanel.js"></script>
<script>
$(function() {
  document.documentElement.classList.add('pd-active');

  const socket = io({ reconnection: true, reconnectionAttempts: Infinity, transports: ['websocket', 'polling'] });
  const roomId = '<%= room.roomId %>';
  const playerId = '<%= player.playerId %>';
  const playerName = '<%= player.name %>';
  const isRoomAdmin = <%= room.admin === true ? 'true' : 'false' %>;
  if (window.partyPlay) window.partyPlay.startSession('pokdeng', socket);

  let S = <%- JSON.stringify(typeof pokdengState !== 'undefined' && pokdengState ? pokdengState : {}) %>;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CARD_BACK = '/assets/games/poker/back.svg';
  const CHIP = v => '/assets/games/pokdeng/chip-' + v + '.svg';
  const CHIP_VALUES = [10, 50, 100, 500];
  const PHASE_LABEL = { bet: 'ลงเดิมพัน', deal: 'แจกไพ่', draw: 'จั่วไพ่', dealer: 'ตาเจ้ามือ', result: 'สรุปผล', finished: 'จบโต๊ะ', lobby: 'รอเริ่ม' };

  let allowNavigation = false;
  let firstRender = true;
  let seenFx = 0;
  let betAmount = null;
  let betHand = -1;
  let betTouched = false;
  let pending = false;
  let timerHandle = null;
  const cardMemo = new Map(); // key → 'back' | 'face'
  let dealPlan = null; // { handNumber, order: [...ids] }

  // ---------- helpers ----------
  function esc(text) {
    return String(text == null ? '' : text).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c]);
  }
  function fmt(n) { return Number(n || 0).toLocaleString('en-US'); }
  function signed(n) { n = Number(n) || 0; return (n > 0 ? '+' : (n < 0 ? '−' : '')) + fmt(Math.abs(n)); }
  function avatarHtml(p, size) {
    if (typeof window.renderPlayerAvatar === 'function') {
      return window.renderPlayerAvatar({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: p.color, playerName: p.name }, { size: size || 26 });
    }
    return '<span aria-hidden="true">' + esc(p.avatar || '👤') + '</span>';
  }
  function dengWord(d) { return d >= 5 ? 'ห้าเด้ง' : (d === 3 ? 'สามเด้ง' : (d === 2 ? 'สองเด้ง' : '')); }
  function selfSeat() { return (S.players || []).find(p => p.playerId === playerId) || null; }
  function seatById(id) { return (S.players || []).find(p => p.playerId === id) || null; }
  function resultRow(id) {
    if (!S.lastResult) return null;
    if (S.lastResult.dealer && S.lastResult.dealer.playerId === id) return Object.assign({ isDealer: true }, S.lastResult.dealer);
    return (S.lastResult.rows || []).find(r => r.playerId === id) || null;
  }

  /**
   * การ์ด 1 ใบ: key ใช้จำว่าเคยแจก/เคยหงายแล้วหรือยัง
   * mode: 'new' (บินจากกอง) · 'flip' (คว่ำ → หงาย) · 'static'
   */
  function cardHtml(key, card, opts) {
    opts = opts || {};
    const face = !!(card && card.image);
    const prev = cardMemo.get(key);
    let mode = 'static';
    if (!firstRender && !reduceMotion) {
      if (!prev) mode = 'new';
      else if (prev === 'back' && face) mode = 'flip';
    }
    cardMemo.set(key, face ? 'face' : 'back');
    const startFace = face && mode === 'static';
    const cls = ['pd-card'];
    if (startFace) cls.push('is-face', 'no-anim');
    if (opts.drawn) cls.push('is-drawn');
    const data = ' data-key="' + esc(key) + '" data-mode="' + mode + '" data-face="' + (face ? '1' : '0') + '"' +
      (opts.dealIndex != null ? ' data-deal="' + opts.dealIndex + '"' : '');
    const alt = face ? esc(card.thaiName || '') : 'ไพ่คว่ำ';
    return '<div class="' + cls.join(' ') + '"' + data + ' role="img" aria-label="' + alt + '">' +
      '<div class="pd-card-inner">' +
        '<img class="pd-card-back" src="' + CARD_BACK + '" alt="" draggable="false">' +
        (face ? '<img class="pd-card-face" src="' + esc(card.image) + '" alt="" draggable="false">' : '') +
      '</div></div>';
  }

  function seatCards(p, prefix) {
    const n = Number(p.cardCount || 0);
    if (!n) return '';
    const cards = p.cards || [];
    const order = dealPlan && dealPlan.handNumber === S.handNumber ? dealPlan.order : [];
    const at = order.indexOf(p.playerId);
    let html = '';
    for (let i = 0; i < n; i += 1) {
      const dealIndex = i < 2 && at >= 0 ? i * order.length + at : null;
      html += cardHtml(prefix + S.handNumber + ':' + p.playerId + ':' + i, cards[i] || null, { dealIndex, drawn: i === 2 });
    }
    return html;
  }

  // ---------- render ----------
  function describeNow() {
    const self = S.self;
    const phase = S.phase;
    const dealerName = S.dealerName || 'เจ้ามือ';
    const acts = S.availableActions || {};
    if (phase === 'finished') return { text: 'จบโต๊ะแล้ว — ดูสรุปชิปด้านล่าง', mine: false };
    if (!self) return { text: 'กำลังดูโต๊ะ', mine: false };
    if (phase === 'bet') {
      if (self.isDealer) return { text: 'คุณเป็นเจ้ามือ — รอขาไพ่ลงเดิมพัน', mine: false };
      if (acts.canBet) return { text: 'เลือกยอดแล้วกดลงเดิมพัน', mine: true };
      if (acts.canRebuy) return { text: 'ชิปหมด — กดขอชิปใหม่เพื่อเล่นต่อ', mine: true };
      if (self.skipped) return { text: 'คุณข้ามมือนี้ — รอมือหน้า', mine: false };
      if (self.decided) return { text: 'ลงแล้ว ' + fmt(self.bet) + ' — รอคนอื่น', mine: false };
      return { text: 'ชิปไม่พอเล่นต่อ — ดูเพื่อนเล่นได้', mine: false };
    }
    if (phase === 'deal') return { text: 'แจกไพ่คนละ 2 ใบ — ใครป๊อกเปิดเลย', mine: false };
    if (phase === 'draw') {
      if (acts.canDraw) return { text: 'ตาคุณ — จั่วเพิ่ม 1 ใบ หรืออยู่', mine: true };
      return { text: 'รอ ' + (S.toActName || 'คนถัดไป') + ' จั่วหรืออยู่', mine: false };
    }
    if (phase === 'dealer') {
      if (acts.canDealerDecide) return { text: 'ตาคุณ (เจ้ามือ) — จั่วหรืออยู่ แล้วเปิดวัดทุกคน', mine: true };
      return { text: 'รอเจ้ามือ ' + dealerName + ' จั่วหรืออยู่', mine: false };
    }
    if (phase === 'result') {
      const mine = resultRow(playerId);
      if (mine && !mine.isDealer) {
        if (mine.outcome === 'win') return { text: 'คุณชนะ ' + signed(mine.delta) + ' ชิป', mine: true };
        if (mine.outcome === 'lose') return { text: 'คุณแพ้ ' + signed(mine.delta) + ' ชิป', mine: false };
        return { text: 'เสมอ — ได้เดิมพันคืน', mine: false };
      }
      if (mine && mine.isDealer) return { text: 'เจ้ามือมือนี้ ' + signed(mine.delta) + ' ชิป', mine: mine.delta > 0 };
      return { text: 'สรุปผลมือนี้', mine: false };
    }
    return { text: 'รอเริ่มโต๊ะ', mine: false };
  }

  function timerHint() {
    switch (S.phase) {
      case 'bet': return 'หมดเวลา = ลงขั้นต่ำ ' + ((S.limits && S.limits.minBet) || 10);
      case 'deal': return 'กำลังเปิดไพ่';
      case 'draw': return 'หมดเวลา = อยู่';
      case 'dealer': return 'หมดเวลา = จั่วถ้า 0–3 แต้ม';
      case 'result': return 'มือต่อไปอัตโนมัติ';
      default: return '';
    }
  }

  function renderTop() {
    $('#pdHandNo').text(S.handNumber ? 'มือที่ ' + S.handNumber : 'เตรียมโต๊ะ');
    const rotate = !!S.rotateDealer;
    $('#pdRotateBtn').text(rotate ? 'หมุนเจ้ามือทุกตา' : 'เจ้ามือคงที่').attr('aria-pressed', rotate ? 'true' : 'false');
    const now = describeNow();
    $('#pdNowPhase').text((PHASE_LABEL[S.phase] || '') + (S.handNumber ? ' · มือที่ ' + S.handNumber : ''));
    $('#pdNowCopy').text(now.text);
    $('#pdNow').toggleClass('is-mine', !!now.mine);
    $('#pdNowHint').text(timerHint());
  }

  function renderDealer() {
    const d = seatById(S.dealerId);
    if (!d) { $('#pdDealer').html('<div class="pd-dealer-self">รอเลือกเจ้ามือ</div>'); return; }
    const res = S.phase === 'result' || S.phase === 'finished' ? resultRow(d.playerId) : null;
    let body = '';
    if (d.isSelf) {
      body = '<div class="pd-dealer-self">คุณคือเจ้ามือ · ไพ่ของคุณอยู่ด้านล่าง</div>';
    } else {
      body = '<div class="pd-dealer-cards">' + seatCards(d, 'd') + '</div>';
    }
    let label = '';
    if (!d.isSelf && d.eval && d.revealed) {
      label = '<span class="pd-handlabel' + (d.eval.special || d.eval.pok ? ' is-special' : '') + '">' + esc(d.eval.label) + '</span>';
    }
    const outcome = res ? '<span class="pd-outcome is-pop ' + (res.delta > 0 ? 'is-win' : (res.delta < 0 ? 'is-lose' : 'is-push')) + '" style="--pop-delay:700ms">เจ้ามือ ' + signed(res.delta) + '</span>' : '';
    const turn = S.phase === 'dealer' ? ' <span class="pd-badge pd-badge--soft">กำลังตัดสินใจ</span>' : '';
    $('#pdDealer').html(
      '<div class="pd-dealer-head" data-seat-id="' + esc(d.playerId) + '">' + avatarHtml(d, 30) +
        '<span class="pd-dealer-name" style="color:' + esc(d.color || '#fff') + '">' + esc(d.isSelf ? 'คุณ' : d.name) + '</span>' +
        '<span class="pd-badge">เจ้ามือ</span>' + turn +
      '</div>' +
      '<div class="pd-dealer-chips">กองเจ้ามือ ' + fmt(d.chips) + ' ชิป</div>' +
      body + label + outcome
    );
  }

  function seatStatus(p) {
    if (p.left) return { text: 'ออกแล้ว', hot: false };
    if (!p.online && !p.isBot) return { text: 'หลุด', hot: false };
    if (S.phase === 'bet') {
      if (p.skipped) return { text: 'ข้ามมือนี้', hot: false };
      if (p.decided) return { text: 'ลงแล้ว', hot: false };
      if (p.chips < 10) return { text: p.rebuyUsed ? 'ชิปหมด' : 'ชิปหมด · ขอใหม่ได้', hot: false };
      return { text: 'กำลังเลือกยอด…', hot: true };
    }
    if (!p.inHand) return { text: p.skipped ? 'ข้ามมือนี้' : 'ไม่ได้ลง', hot: false };
    if (p.revealed && p.eval && p.eval.pok && S.phase !== 'result') return { text: 'ป๊อก ' + p.eval.points + '!', hot: true };
    if (p.isTurn) return { text: 'กำลังคิด…', hot: true };
    if (S.phase === 'draw' || S.phase === 'dealer' || S.phase === 'deal') {
      if (p.done) return { text: p.drew ? 'จั่วแล้ว' : 'อยู่', hot: false };
      return { text: 'รอตา', hot: false };
    }
    return { text: '', hot: false };
  }

  function renderSeats() {
    const others = (S.players || []).filter(p => !p.isSelf && !p.isDealer && !(p.left && !p.inHand));
    if (!others.length) {
      $('#pdSeats').html('<div class="pd-empty-seats">ยังไม่มีขาไพ่คนอื่น</div>');
      return;
    }
    const showdown = S.phase === 'result' || S.phase === 'finished';
    $('#pdSeats').html(others.map(function(p, index) {
      const st = seatStatus(p);
      const res = showdown ? resultRow(p.playerId) : null;
      const out = !p.inHand && S.phase !== 'bet';
      let bottom = '';
      if (res) {
        const cls = res.outcome === 'win' ? 'is-win' : (res.outcome === 'lose' ? 'is-lose' : 'is-push');
        const txt = res.outcome === 'push' ? 'เสมอ' : signed(res.delta);
        bottom = '<span class="pd-handlabel' + (res.special || res.pok ? ' is-special' : '') + '">' + esc(res.label) + '</span>' +
          '<span class="pd-outcome is-pop ' + cls + '" style="--pop-delay:' + (700 + index * 90) + 'ms">' + txt + '</span>';
      } else {
        bottom = '<div class="pd-seat-status' + (st.hot ? ' is-hot' : '') + '">' + esc(st.text) + '</div>' +
          (p.bet > 0 ? '<span class="pd-bet"><img src="' + CHIP(100) + '" alt="">' + fmt(p.bet) + '</span>' : '');
      }
      return '<div class="pd-seat' + (p.isTurn ? ' is-turn' : '') + (out || p.left ? ' is-out' : '') + '" data-seat-id="' + esc(p.playerId) + '">' +
        '<div class="pd-seat-head">' + avatarHtml(p, 22) +
          '<span class="pd-seat-name" style="color:' + esc(p.color || '#fff') + '">' + esc(p.name) + '</span></div>' +
        '<div class="pd-seat-chips">' + fmt(p.chips) + ' ชิป</div>' +
        '<div class="pd-seat-cards">' + seatCards(p, 's') + '</div>' +
        bottom + '</div>';
    }).join(''));
  }

  function renderPot() {
    const total = (S.players || []).reduce((sum, p) => sum + (Number(p.bet) || 0), 0);
    $('#pdPotAmount').text(fmt(total));
  }

  function renderMe() {
    const self = S.self;
    const seat = selfSeat();
    if (!self || !seat) {
      $('#pdMeCards').html('');
      $('#pdMeInfo').html('<div class="pd-me-sub">คุณกำลังดูโต๊ะนี้</div>');
      return;
    }
    const meSeat = Object.assign({}, seat, { cards: self.cards, cardCount: (self.cards || []).length });
    $('#pdMeCards').html(seatCards(meSeat, 'm'));
    const ev = self.eval;
    const res = (S.phase === 'result') ? resultRow(playerId) : null;
    let label = '';
    if (ev) label = '<div class="pd-me-label' + (ev.special || ev.pok ? ' is-special' : '') + '">' + esc(ev.label) + '</div>';
    else if (self.isDealer) label = '<div class="pd-me-label">เจ้ามือ</div>';
    else if (S.phase === 'bet' && self.decided && !self.skipped) label = '<div class="pd-me-label">ลง ' + fmt(self.bet) + '</div>';
    const netNow = (self.chips + (self.bet || 0)) - self.buyIn;
    let sub = '<div class="pd-me-sub">ชิป <strong>' + fmt(self.chips) + '</strong>' +
      (self.bet > 0 ? ' · เดิมพัน <strong>' + fmt(self.bet) + '</strong>' : '') +
      ' · ' + (netNow >= 0 ? 'กำไร ' : 'ขาดทุน ') + signed(netNow) + '</div>';
    let out = '';
    if (res) {
      const cls = res.isDealer ? (res.delta > 0 ? 'is-win' : (res.delta < 0 ? 'is-lose' : 'is-push'))
        : (res.outcome === 'win' ? 'is-win' : (res.outcome === 'lose' ? 'is-lose' : 'is-push'));
      const txt = res.isDealer ? 'เจ้ามือ ' + signed(res.delta)
        : (res.outcome === 'win' ? 'ชนะ ' + signed(res.delta) + (res.multiplier > 1 ? ' (' + res.multiplier + ' เด้ง)' : '')
          : (res.outcome === 'lose' ? 'แพ้ ' + signed(res.delta) + (res.multiplier > 1 ? ' (' + res.multiplier + ' เด้ง)' : '') : 'เสมอ คืนเดิมพัน'));
      out = '<span class="pd-outcome is-pop ' + cls + '" style="--pop-delay:650ms">' + txt + '</span>';
    }
    $('#pdMeInfo').html(label + sub + out);
  }

  function clampBet(v) {
    const a = S.availableActions || {};
    const min = a.minBet || 10;
    const max = Math.max(min, a.maxBet || min);
    v = Math.round(Number(v) || min);
    return Math.max(min, Math.min(max, v));
  }

  function renderActions() {
    const a = S.availableActions || {};
    const self = S.self;
    let html = '';
    if (S.phase === 'finished') {
      html = renderFinished();
    } else if (a.canBet) {
      if (betHand !== S.handNumber || betAmount == null) {
        betHand = S.handNumber;
        betTouched = false;
        betAmount = clampBet(a.defaultBet || a.minBet);
      }
      betAmount = clampBet(betAmount);
      html = '<div class="pd-bet-panel">' +
        '<div class="pd-bet-top"><div class="pd-bet-amount"><strong id="pdBetValue">' + fmt(betAmount) + '</strong><span>ลงได้ ' + fmt(a.minBet) + '–' + fmt(a.maxBet) + '</span></div>' +
        '<div class="pd-chips">' + CHIP_VALUES.map(v =>
          '<button type="button" class="pd-chipbtn" data-chip="' + v + '"' + (v > a.maxBet ? ' disabled' : '') + ' aria-label="เพิ่ม ' + v + '">' +
          '<img src="' + CHIP(v) + '" alt=""></button>').join('') + '</div></div>' +
        '<input type="range" class="pd-range" id="pdBetRange" min="' + a.minBet + '" max="' + a.maxBet + '" step="10" value="' + betAmount + '" aria-label="ยอดเดิมพัน">' +
        '<div class="pd-actions-row">' +
          '<button type="button" id="pdSkipBtn" class="pd-btn pd-btn--ghost" style="flex:0 0 auto;">ข้ามมือ</button>' +
          '<button type="button" id="pdBetBtn" class="pd-btn pd-btn--primary pd-btn--big">ลงเดิมพัน ' + fmt(betAmount) + '</button>' +
        '</div></div>';
    } else if (a.canDraw || a.canDealerDecide) {
      const ev = self && self.eval;
      const tip = ev ? (ev.points <= 3 ? 'แต้มน้อย ส่วนใหญ่จั่ว' : (ev.points >= 6 ? 'แต้มดี ส่วนใหญ่อยู่' : 'ครึ่งๆ ลองเสี่ยงดู')) : '';
      html = '<div class="pd-actions-row">' +
        '<button type="button" id="pdStayBtn" class="pd-btn pd-btn--big">อยู่</button>' +
        '<button type="button" id="pdDrawBtn" class="pd-btn pd-btn--primary pd-btn--big">จั่วไพ่</button>' +
        '</div>' + (tip ? '<div class="pd-hint">' + esc(tip) + (a.canDealerDecide ? ' · แล้วเปิดวัดทุกขาพร้อมกัน' : '') + '</div>' : '');
    } else if (S.phase === 'result') {
      html = a.canNext
        ? '<button type="button" id="pdNextBtn" class="pd-btn pd-btn--primary pd-btn--big">มือต่อไป</button>'
        : '<div class="pd-wait">รอมือต่อไป…</div>';
    } else if (self && self.isDealer && S.phase === 'bet') {
      html = '<div class="pd-wait">รอขาไพ่ลงเดิมพัน แล้วแจกอัตโนมัติ</div>';
    } else if (S.phase === 'draw' || S.phase === 'dealer' || S.phase === 'deal') {
      html = '<div class="pd-wait">' + (self && self.inHand && self.done && S.phase === 'draw' ? 'ตัดสินใจแล้ว — รอคนอื่น' : 'รอตาคนอื่น…') + '</div>';
    } else if (self && self.decided && S.phase === 'bet') {
      html = '<div class="pd-wait">' + (self.skipped ? 'ข้ามมือนี้แล้ว' : 'ลงแล้ว ' + fmt(self.bet) + ' — รอแจกไพ่') + '</div>';
    }
    if (a.canRebuy && S.phase !== 'finished') {
      html += '<button type="button" id="pdRebuyBtn" class="pd-btn">ขอชิปใหม่ +' + fmt((S.limits && S.limits.rebuy) || 1000) + ' (ได้ครั้งเดียว)</button>';
    }
    $('#pdActions').html(html);
    const finished = S.phase === 'finished';
    $('#pdDock').toggleClass('is-static', finished);
    $('#pdRoot').toggleClass('is-finished', finished);
    if (finished && !$('#pdNow').next().is('#pdDock')) $('#pdDock').insertAfter('#pdNow');
    syncDockHeight();
  }

  function renderFinished() {
    const rows = S.standings || [];
    const title = S.winner && S.winner.playerId ? esc(S.winner.name) + ' กำไรสูงสุด' : 'จบโต๊ะ — ไม่มีใครได้กำไร';
    return '<p class="pd-final-title">' + title + '</p>' +
      '<div class="pd-standings">' + rows.map(function(r, i) {
        const cls = r.net > 0 ? 'is-win' : (r.net < 0 ? 'is-lose' : 'is-push');
        return '<div class="pd-row"><span class="pd-rank">' + (i + 1) + '</span>' +
          '<span class="pd-row-name">' + esc(r.name) + (r.playerId === playerId ? ' (คุณ)' : '') + (r.left ? ' · ออกแล้ว' : '') + '</span>' +
          '<span class="pd-outcome ' + cls + '">' + signed(r.net) + '</span>' +
          '<span class="pd-row-hand">เหลือ ' + fmt(r.chips) + ' จากทุน ' + fmt(r.buyIn) + '</span></div>';
      }).join('') + '</div>' +
      '<div class="pd-actions-row">' +
        '<button type="button" id="pdShareBtn" class="pd-btn">แชร์ผล</button>' +
        '<button type="button" id="pdBackBtn" class="pd-btn pd-btn--primary">กลับห้องรอ</button>' +
      '</div><div class="pd-hint" id="pdBackRemain">ทุกคนกลับห้องรอพร้อมกัน</div>';
  }

  function renderResults() {
    const r = S.lastResult;
    if (S.phase !== 'result' || !r || r.empty) {
      $('#pdResults').prop('hidden', true).empty();
      return;
    }
    const mini = cards => '<span class="pd-row-cards">' + (cards || []).map(c => '<img src="' + esc(c.image) + '" alt="' + esc(c.thaiName) + '">').join('') + '</span>';
    const rows = (r.rows || []).map(function(row) {
      const cls = row.outcome === 'win' ? 'is-win' : (row.outcome === 'lose' ? 'is-lose' : 'is-push');
      const txt = row.outcome === 'push' ? 'เสมอ' : signed(row.delta);
      const how = row.outcome === 'push' ? 'คืนเดิมพัน ' + fmt(row.bet)
        : ('เดิมพัน ' + fmt(row.bet) + ' × ' + row.multiplier + (row.short ? ' (จ่ายได้ไม่ครบ)' : ''));
      return '<div class="pd-row"><span class="pd-row-name">' + esc(row.name) + (row.playerId === playerId ? ' (คุณ)' : '') + '</span>' +
        '<span class="pd-outcome ' + cls + '">' + txt + '</span>' +
        '<span class="pd-row-hand">' + mini(row.cards) + esc(row.label) + ' · ' + esc(how) + '</span></div>';
    }).join('');
    const d = r.dealer;
    $('#pdResults').prop('hidden', false).html(
      '<h2>ผลมือที่ ' + r.handNumber + '</h2>' +
      (d ? '<p class="pd-results-note">เจ้ามือ ' + esc(d.name) + ': ' + mini(d.cards) + esc(d.label) + ' · ' + signed(d.delta) + ' ชิป</p>' : '') +
      (r.shortfall ? '<p class="pd-results-note">เจ้ามือชิปไม่พอจ่าย — แบ่งจ่ายตามสัดส่วน</p>' : '') +
      rows
    );
  }

  function renderFeed() {
    $('#pdFeed').html((S.history || []).slice(0, 12).map(item =>
      '<div class="pd-feed-item">' + esc((item.icon || '') + ' ' + (item.text || '')) + '</div>').join(''));
  }

  function syncDockHeight() {
    const dock = document.getElementById('pdDock');
    const h = dock && !dock.classList.contains('is-static') ? Math.round(dock.getBoundingClientRect().height) : 0;
    document.documentElement.style.setProperty('--pd-dock-h', h + 'px');
  }
  if (window.ResizeObserver) new ResizeObserver(syncDockHeight).observe(document.getElementById('pdDock'));

  // ---------- motion ----------
  function applyCardMotion() {
    const deck = document.getElementById('pdDeck');
    const deckRect = deck ? deck.getBoundingClientRect() : null;
    let flipIndex = 0;
    document.querySelectorAll('.pd-card[data-mode="new"]').forEach(function(el) {
      if (!deckRect) return;
      const r = el.getBoundingClientRect();
      const dx = (deckRect.left + deckRect.width / 2) - (r.left + r.width / 2);
      const dy = (deckRect.top + deckRect.height / 2) - (r.top + r.height / 2);
      const idx = el.dataset.deal != null ? Number(el.dataset.deal) : 0;
      const delay = idx * 85;
      el.style.setProperty('--dx', dx.toFixed(0) + 'px');
      el.style.setProperty('--dy', dy.toFixed(0) + 'px');
      el.style.setProperty('--deal-delay', delay + 'ms');
      el.classList.add('is-dealing');
      if (el.dataset.face === '1') {
        setTimeout(function() { el.classList.add('is-face'); }, delay + 480);
      }
    });
    document.querySelectorAll('.pd-card[data-mode="flip"]').forEach(function(el) {
      el.style.setProperty('--flip-delay', (flipIndex * 110) + 'ms');
      flipIndex += 1;
      requestAnimationFrame(function() { requestAnimationFrame(function() { el.classList.add('is-face'); }); });
    });
  }

  function banner(text, tone) {
    const node = document.getElementById('pdBanner');
    node.textContent = text;
    node.className = 'pd-banner' + (tone ? ' is-' + tone : '');
    void node.offsetWidth;
    node.classList.add('is-on');
  }

  function flyChip(fromEl, toEl, value) {
    if (reduceMotion || !fromEl || !toEl) return;
    const a = fromEl.getBoundingClientRect();
    const b = toEl.getBoundingClientRect();
    const img = document.createElement('img');
    img.className = 'pd-fly';
    img.src = CHIP(value >= 500 ? 500 : (value >= 100 ? 100 : (value >= 50 ? 50 : 10)));
    img.alt = '';
    img.style.transform = 'translate(' + (a.left + a.width / 2 - 13) + 'px,' + (a.top + a.height / 2 - 13) + 'px)';
    document.getElementById('pdFx').appendChild(img);
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        img.style.transform = 'translate(' + (b.left + b.width / 2 - 13) + 'px,' + (b.top + b.height / 2 - 13) + 'px) rotate(200deg)';
        img.style.opacity = '0.2';
      });
    });
    setTimeout(function() { img.remove(); }, 620);
  }

  function seatEl(id) {
    if (id === playerId) return document.getElementById('pdMeInfo');
    return document.querySelector('[data-seat-id="' + id + '"]');
  }

  function pokBurst(id, text) {
    const target = id === playerId ? document.getElementById('pdMeCards') : document.querySelector('.pd-seat[data-seat-id="' + id + '"]') || document.getElementById('pdDealer');
    if (!target) return;
    const host = target.classList.contains('pd-seat') ? target : target.parentElement;
    if (!host) return;
    if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
    const node = document.createElement('span');
    node.className = 'pd-pokburst';
    node.textContent = text;
    host.appendChild(node);
    setTimeout(function() { node.remove(); }, 1700);
  }

  function consumeFx(initial) {
    const events = (S.fx || []).filter(e => e && e.seq > seenFx);
    if (!events.length) return;
    seenFx = events[events.length - 1].seq;
    if (initial) return;
    events.forEach(function(e) {
      if (e.kind === 'chips') {
        flyChip(seatEl(e.playerId), document.getElementById('pdPot'), e.amount);
      } else if (e.kind === 'pok') {
        const who = seatById(e.playerId);
        const text = 'ป๊อก ' + e.points + '!';
        setTimeout(function() { pokBurst(e.playerId, text); }, e.dealer ? 900 : 1000);
        if (e.dealer) banner('เจ้ามือป๊อก ' + e.points + '! เปิดวัดทันที', 'lose');
        else if (e.playerId === playerId) banner('คุณป๊อก ' + e.points + '!', 'win');
        void who;
      } else if (e.kind === 'dealer') {
        const who = seatById(e.playerId);
        banner((e.playerId === playerId ? 'คุณ' : (who ? who.name : '')) + ' เป็นเจ้ามือ');
      } else if (e.kind === 'reveal') {
        const mine = resultRow(playerId);
        if (mine && !mine.isDealer) {
          setTimeout(function() {
            if (mine.outcome === 'win') banner('ชนะ ' + signed(mine.delta) + (mine.multiplier > 1 ? ' · ' + dengWord(mine.multiplier) : ''), 'win');
            else if (mine.outcome === 'lose') banner('แพ้ ' + signed(mine.delta), 'lose');
            else banner('เสมอ');
          }, 700);
        }
        if (window.gameHaptic) window.gameHaptic([16, 30, 16]);
      } else if (e.kind === 'finished') {
        banner('จบโต๊ะ');
      }
    });
  }

  function pingNeed() {
    if (!window.partyPlay) return;
    const a = S.availableActions || {};
    if (a.canDraw) window.partyPlay.pingTurn({ key: 'pd-draw-' + S.handNumber + '-' + S.step, title: 'ตาคุณ', subtitle: 'จั่วเพิ่ม 1 ใบ หรืออยู่' });
    else if (a.canDealerDecide) window.partyPlay.pingTurn({ key: 'pd-dealer-' + S.handNumber, title: 'ตาเจ้ามือ', subtitle: 'จั่วหรืออยู่ แล้วเปิดวัด' });
  }

  function tickTimer() {
    if (timerHandle) clearInterval(timerHandle);
    const total = S.timers ? ({ bet: S.timers.bet, draw: S.timers.draw, dealer: S.timers.dealer, result: S.timers.result })[S.phase] : 0;
    function paint() {
      if (S.phase === 'finished') {
        const endsAt = Number(S.returnLobbyEndsAt) || 0;
        const remain = endsAt ? Math.max(0, Math.ceil((endsAt - Date.now()) / 1000)) : 0;
        $('#pdNowSec').text(remain > 0 ? remain : '--');
        $('#pdNowHint').text(remain > 0 ? 'วิ แล้วกลับห้องรอ' : '');
        $('#pdBackRemain').text(remain > 0 ? 'กลับห้องรอพร้อมกันใน ' + remain + ' วิ' : 'ทุกคนกลับห้องรอพร้อมกัน');
        $('#pdNowBar').css('transform', 'scaleX(0)');
        return;
      }
      if (!S.phaseEndsAt) {
        $('#pdNowSec').text('--');
        $('#pdNowBar').css('transform', 'scaleX(0)');
        return;
      }
      const ms = Math.max(0, S.phaseEndsAt - Date.now());
      const remain = Math.ceil(ms / 1000);
      $('#pdNowSec').text(remain);
      $('#pdNow').toggleClass('is-urgent', remain <= 5 && ['bet', 'draw', 'dealer'].includes(S.phase) && !!(describeNow().mine));
      const frac = total ? Math.max(0, Math.min(1, ms / total)) : 0;
      $('#pdNowBar').css('transform', 'scaleX(' + frac.toFixed(3) + ')');
    }
    paint();
    timerHandle = setInterval(paint, 250);
  }

  function pruneMemo() {
    const keep = ':' + S.handNumber + ':';
    Array.from(cardMemo.keys()).forEach(k => { if (k.indexOf(keep) < 0) cardMemo.delete(k); });
  }

  function render(state) {
    if (!state || !state.mode) return;
    const prevHand = S && S.handNumber;
    S = state;
    if (S.handNumber !== prevHand) pruneMemo();
    // แผนแจก: เอาลำดับจาก fx deal ล่าสุดของมือนี้
    const dealFx = (S.fx || []).filter(e => e.kind === 'deal' && e.handNumber === S.handNumber).pop();
    if (dealFx) dealPlan = { handNumber: S.handNumber, order: dealFx.order || [] };
    renderTop();
    renderDealer();
    renderPot();
    renderSeats();
    renderMe();
    renderActions();
    renderResults();
    renderFeed();
    applyCardMotion();
    consumeFx(firstRender);
    tickTimer();
    pingNeed();
    firstRender = false;
  }

  // ---------- commands ----------
  function toastError(msg) {
    Swal.fire({ toast: true, position: 'top', icon: 'error', title: msg || 'ทำรายการไม่สำเร็จ', showConfirmButton: false, timer: 2200, background: '#2a1416', color: '#fff' });
  }
  function send(eventName, payload) {
    if (pending) return;
    pending = true;
    $('#pdActions button').prop('disabled', true);
    const ctx = { roomId: roomId, step: S.step, phase: S.phase, handNumber: S.handNumber };
    socket.emit(eventName, Object.assign(ctx, payload || {}), function(res) {
      pending = false;
      if (res && !res.success) {
        toastError(res.error);
        socket.emit('pokdeng_requestState', { roomId: roomId, playerId: playerId });
      }
      $('#pdActions button').prop('disabled', false);
      renderActions();
    });
    setTimeout(function() { pending = false; }, 6000);
  }

  function setBet(v) {
    betAmount = clampBet(v);
    $('#pdBetValue').text(fmt(betAmount));
    $('#pdBetRange').val(betAmount);
    $('#pdBetBtn').text('ลงเดิมพัน ' + fmt(betAmount));
  }
  $(document).on('click', '.pd-chipbtn', function() {
    const add = Number($(this).data('chip')) || 0;
    setBet((betTouched ? betAmount : 0) + add);
    betTouched = true;
    if (window.gameHaptic) window.gameHaptic(8);
  });
  $(document).on('input', '#pdBetRange', function() { setBet(Number(this.value)); });
  $(document).on('click', '[data-set]', function() {
    const a = S.availableActions || {};
    const kind = $(this).data('set');
    betTouched = true;
    if (kind === 'min') setBet(a.minBet);
    else if (kind === 'max') setBet(a.maxBet);
    else if (kind === 'last' && S.self) setBet(S.self.lastBet);
  });
  $(document).on('click', '#pdBetBtn', function() { send('pokdeng_bet', { amount: clampBet(betAmount) }); });
  $(document).on('click', '#pdSkipBtn', function() { send('pokdeng_skip'); });
  $(document).on('click', '#pdDrawBtn', function() { send(S.availableActions.canDealerDecide ? 'pokdeng_dealer' : 'pokdeng_draw', { draw: true }); });
  $(document).on('click', '#pdStayBtn', function() { send(S.availableActions.canDealerDecide ? 'pokdeng_dealer' : 'pokdeng_draw', { draw: false }); });
  $(document).on('click', '#pdNextBtn', function() { send('pokdeng_next'); });
  $(document).on('click', '#pdRebuyBtn', function() { send('pokdeng_rebuy'); });
  // ไม่ใช่หัวห้อง = server ไม่พาทั้งวงกลับ (canReturnSelf) → กลับห้องเฉพาะตัวเอง
  $(document).on('click', '#pdBackBtn', function() { socket.emit('returnFinishedToLobby', { roomId: roomId }, function(res) { if (res && res.canReturnSelf) { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; } }); });
  $(document).on('click', '#pdShareBtn', function() {
    if (!window.partyPlay || !S.standings) return;
    window.partyPlay.shareResult({
      mode: 'ป๊อกเด้ง',
      headline: S.winner && S.winner.playerId ? S.winner.name + ' กำไรสูงสุด' : 'จบโต๊ะป๊อกเด้ง',
      sub: S.handNumber + ' มือ · ชิปในโต๊ะ ไม่มีมูลค่าจริง',
      lines: S.standings.slice(0, 6).map((r, i) => (i + 1) + '. ' + r.name + ' ' + signed(r.net)),
      accent: '#f5c86b',
      fileName: 'pokdeng-result'
    });
  });
  $('#pdRotateBtn').on('click', function() {
    if (!isRoomAdmin || S.phase === 'finished') return;
    send('pokdeng_rotate', { enabled: !S.rotateDealer });
  });
  $('#pdEndBtn').on('click', function() {
    Swal.fire({
      icon: 'warning', title: 'จบโต๊ะเลยไหม?', text: 'สรุปชิปทุกคนแล้วกลับห้องรอ (มือที่ค้างอยู่คืนเดิมพัน)',
      showCancelButton: true, confirmButtonText: 'จบโต๊ะ', cancelButtonText: 'เล่นต่อ', background: '#1f1214', color: '#fff', confirmButtonColor: '#b3262e'
    }).then(r => { if (r.isConfirmed) send('pokdeng_end'); });
  });

  // ---------- guides ----------
  function miniCards(ids) {
    return '<span class="pd-rankcards">' + ids.map(id => '<img src="/assets/games/poker/' + id + '.svg" alt="">').join('') + '</span>';
  }
  function rankGuideHtml() {
    const rows = [
      ['ป๊อก 9', 'ไพ่ 2 ใบรวมได้ 9 — เปิดทันที ไม่ต้องจั่ว', ['9s', 'kh'], 'ชนะทุกอย่าง'],
      ['ป๊อก 8', 'ไพ่ 2 ใบรวมได้ 8 · แพ้ป๊อก 9 อย่างเดียว', ['5d', '3c'], ''],
      ['ตอง', 'สามใบหน้าเดียวกัน', ['7s', '7h', '7d'], '5 เด้ง'],
      ['เรียง', 'สามใบเรียงกัน A-2-3 ถึง Q-K-A (ไม่วน)', ['4c', '5h', '6s'], '3 เด้ง'],
      ['เซียน', 'J Q K ล้วน (สามเหลือง)', ['js', 'qd', 'jh'], '3 เด้ง'],
      ['แต้ม 9 → 0', 'แต้มมากชนะ · 0 แต้ม = บอด · เท่ากัน = เสมอ', ['2d', '6d', 'as'], '']
    ];
    return '<div class="pd-guide">' +
      rows.map((r, i) => '<div class="pd-rankrow"><span class="pd-rankno">' + (i + 1) + '</span>' +
        '<span><span class="pd-rankname">' + r[0] + '</span> ' + (r[3] ? '<span class="pd-deng">' + r[3] + '</span>' : '') +
        '<span class="pd-rankdesc">' + r[1] + '</span></span>' + miniCards(r[2]) + '</div>').join('') +
      '<h4>เด้ง = ตัวคูณของคนชนะ</h4>' +
      '<div class="pd-rankrow"><span class="pd-rankno">×2</span><span><span class="pd-rankname">สองเด้ง</span><span class="pd-rankdesc">2 ใบดอกเดียวกัน หรือคู่</span></span>' + miniCards(['8h', 'kh']) + '</div>' +
      '<div class="pd-rankrow"><span class="pd-rankno">×3</span><span><span class="pd-rankname">สามเด้ง</span><span class="pd-rankdesc">3 ใบดอกเดียวกัน</span></span>' + miniCards(['2c', '5c', 'qc']) + '</div>' +
      '<p style="margin-top:8px; color:oklch(0.78 0.03 50); font-size:0.84rem;">แต้ม = หลักหน่วยของผลรวม · A = 1 · 10/J/Q/K = 0 · ชนะได้ เดิมพัน × เด้งของมือที่ชนะ</p>' +
      '</div>';
  }
  function howToHtml() {
    return '<div class="pd-guide">' +
      '<h4>1. ลงเดิมพัน</h4><p>ทุกขา (ยกเว้นเจ้ามือ) ลง 10–500 ภายใน 20 วิ · ไม่เลือก = ลงขั้นต่ำให้</p>' +
      '<h4>2. แจก 2 ใบ</h4><p>ได้ 8 หรือ 9 = <b>ป๊อก</b> เปิดเลย ไม่ต้องจั่ว · ถ้าเจ้ามือป๊อก เปิดวัดทุกคนทันที</p>' +
      '<h4>3. จั่วหรืออยู่</h4><p>ไล่ทีละคน จั่วเพิ่มได้ 1 ใบ (15 วิ ไม่เลือก = อยู่) แล้วเจ้ามือจั่ว/อยู่</p>' +
      '<h4>4. วัดกับเจ้ามือ</h4><p>ชนะได้ เดิมพัน × เด้ง · แพ้เสีย เดิมพัน × เด้งของเจ้ามือ · แต้มเท่ากัน = เสมอ</p>' +
      '<h4>ชิป</h4><p>ชิปในโต๊ะนี้ ไม่มีมูลค่าจริง · เริ่มคนละ 1,000 · หมดตัวขอชิปใหม่ได้ 1 ครั้ง · จบโต๊ะแล้วชิปเกินทุน = ชนะ</p>' +
      '<h4>เจ้ามือ</h4><p>หัวห้องเป็นเจ้ามือ (ถือ 5,000) หรือเลือก <b>หมุนเจ้ามือทุกตา</b> · เจ้ามือชิปไม่พอจ่าย = แบ่งจ่ายตามสัดส่วน</p>' +
      '</div>';
  }
  function guidePopup(title, html) {
    Swal.fire({ title: title, html: html, background: '#1f1214', color: '#fff', confirmButtonText: 'เข้าใจแล้ว', confirmButtonColor: '#b3262e', width: 'min(520px, 94vw)' });
  }
  $('#pdRankBtn').on('click', function() { guidePopup('อันดับไพ่ป๊อกเด้ง', rankGuideHtml()); });
  $('#pdHowBtn').on('click', function() { guidePopup('ป๊อกเด้ง เล่นยังไง', howToHtml()); });

  // ---------- sidebar ----------
  function setSidebarOpen(open) {
    if (open && $('#chatBox').is(':visible')) $('#closeChat').trigger('click');
    $('#playerSidebar').toggleClass('open', open).attr('aria-hidden', open ? 'false' : 'true');
    $('#sidebarOverlay').toggle(open);
    $('#pdSidebarBtn').attr('aria-expanded', open ? 'true' : 'false');
    if (open) document.getElementById('closeSidebarBtn').focus();
  }
  $('#pdSidebarBtn').on('click', function() { setSidebarOpen(!$('#playerSidebar').hasClass('open')); });
  $('#closeSidebarBtn, #sidebarOverlay').on('click', function() { setSidebarOpen(false); });
  $(document).on('keydown', function(e) { if (e.key === 'Escape' && $('#playerSidebar').hasClass('open')) setSidebarOpen(false); });
  $('#leaveRoomBtn').on('click', function() {
    Swal.fire({ icon: 'question', title: 'ออกจากโต๊ะ?', text: 'ชิปในโต๊ะนี้จะหายไปพร้อมกับคุณ', showCancelButton: true, confirmButtonText: 'ออก', cancelButtonText: 'อยู่ต่อ', background: '#1f1214', color: '#fff' })
      .then(r => {
        if (!r.isConfirmed) return;
        allowNavigation = true;
        socket.emit('leaveRoom', {}, function() { window.location.href = '/rooms?playerId=' + playerId; });
      });
  });
  window.addEventListener('beforeunload', function(e) { if (!allowNavigation) e.preventDefault(); });

  // ---------- socket ----------
  socket.on('connect', function() {
    $('#connectionStatus').hide();
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId: roomId, playerId: playerId });
    socket.emit('pokdeng_requestState', { roomId: roomId, playerId: playerId });
  });
  socket.on('disconnect', function() { $('#connectionStatus').show(); });
  socket.on('pokdengState', render);
  socket.on('roomUpdate', function(data) {
    if (!data || !data.players) return;
    $('#onlinePlayerList').html(data.players.map(p =>
      '<li style="display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid oklch(1 0 0 / 0.08);">' +
        avatarHtml({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: p.color, name: p.displayName || p.playerName }, 26) +
        '<span style="color:' + esc(p.color || '#fff') + '">' + esc(p.displayName || p.playerName) + '</span>' +
        (p.online === false ? '<span style="margin-left:auto; font-size:0.78rem; color:oklch(0.74 0.03 50);">หลุด</span>' : '') +
      '</li>').join(''));
  });
  socket.on('redirectToLobby', function() { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; });
  socket.on('returnToLobby', function(data) {
    S.returnLobbyEndsAt = Number(data && data.endsAt) || (Date.now() + (Number(data && data.countdown) || 10) * 1000);
    tickTimer();
  });
  socket.on('restartGame', function() { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; });
  socket.on('gameStarting', function() { allowNavigation = true; window.location.href = '/game/' + roomId + '?playerId=' + playerId; });
  socket.on('kickedFromRoom', function(data) {
    allowNavigation = true;
    Swal.fire({ icon: 'error', title: 'ถูกเตะออกจากห้อง', text: (data && data.reason) || '', background: '#1f1214', color: '#fff' })
      .then(() => { window.location.href = '/rooms?playerId=' + playerId; });
  });

  window.initChatPanel({
    socket: socket, playerId: playerId, playerName: playerName,
    onCommand: function(text) {
      if (text.trim().toLowerCase() !== '/m') return false;
      socket.emit('pokdeng_admin_reveal');
      return true;
    }
  });
  socket.on('pokdeng_admin_reveal', function(data) {
    const rows = (data.players || []).map(p => '<div style="margin:6px 0; text-align:left;"><strong>' + esc(p.name) + '</strong>' +
      (p.isDealer ? ' (เจ้ามือ)' : '') + ' · ' + fmt(p.chips) + ' ชิป' + (p.bet ? ' · ลง ' + fmt(p.bet) : '') +
      '<br>' + esc((p.cards || []).join(' ') || '—') + (p.label ? ' · ' + esc(p.label) : '') + '</div>').join('');
    Swal.fire({ title: '/m ไพ่ทั้งโต๊ะ', html: rows, background: '#1f1214', color: '#fff' });
  });
  socket.on('pokdeng_admin_reveal_denied', function() {
    Swal.fire({ icon: 'error', title: 'ดูไพ่ไม่ได้', text: 'คำสั่ง /m ใช้ได้เฉพาะแอดมินเว็บ', background: '#1f1214', color: '#fff' });
  });

  if (S && S.mode) render(S);
});
</script>

<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/chatPanel.css">
<style>
  html.pd-active,
  html.pd-active body.content {
    overflow-x: hidden;
    margin: 0 !important;
    padding: 0 !important;
    background: oklch(0.15 0.03 20) !important;
  }
  html.pd-active .container-fluid > header,
  html.pd-active .footer,
  html.pd-active #music-controls { display: none !important; }
  html.pd-active, html.pd-active .container-fluid, html.pd-active .container-fluid > .row { background: oklch(0.15 0.03 20) !important; background-image: none !important; }
  html.pd-active .container-fluid { padding: 0 !important; margin: 0 !important; max-width: none !important; }
  html.pd-active .container-fluid > .row { margin: 0 !important; }
  html.pd-active .col-lg-12 { padding: 0 !important; }

  .pd {
    --pd-bg: oklch(0.15 0.03 20);
    --pd-surface: oklch(0.2 0.035 22);
    --pd-surface-2: oklch(0.25 0.04 22);
    --pd-line: oklch(0.84 0.13 85 / 0.2);
    --pd-line-soft: oklch(1 0 0 / 0.1);
    --pd-felt: oklch(0.36 0.12 22);
    --pd-felt-deep: oklch(0.22 0.08 20);
    --pd-rail: oklch(0.17 0.035 35);
    --pd-gold: oklch(0.84 0.13 85);
    --pd-gold-deep: oklch(0.7 0.13 75);
    --pd-ink: oklch(0.97 0.012 80);
    --pd-soft: oklch(0.86 0.025 70);
    --pd-muted: oklch(0.74 0.03 50);
    --pd-win: oklch(0.82 0.16 150);
    --pd-win-bg: oklch(0.42 0.1 150 / 0.55);
    --pd-lose: oklch(0.74 0.16 25);
    --pd-lose-bg: oklch(0.36 0.12 25 / 0.6);
    --pd-push-bg: oklch(0.4 0.02 60 / 0.6);
    --pd-accent: oklch(0.84 0.13 85);
    --pd-accent-ink: oklch(0.2 0.05 60);
    --pd-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --pd-display: 'Chakra Petch', 'Bai Jamjuree', sans-serif;
    --card-w: 84px;
    --card-h: 118px;
    --seat-card-w: 34px;
    --seat-card-h: 48px;
    --dealer-card-w: 52px;
    --dealer-card-h: 73px;

    max-width: 980px;
    margin: 0 auto;
    padding: 8px 16px calc(var(--pd-dock-h, 200px) + 20px);
    color: var(--pd-ink);
    font-family: 'Bai Jamjuree', sans-serif;
    font-size: 1rem;
    line-height: 1.45;
    text-align: left;
  }
  body.content { background: var(--pd-bg, oklch(0.15 0.03 20)); }
  .pd *, .pd *::before, .pd *::after { box-sizing: border-box; }
  .pd button { font-family: inherit; }
  .pd h1, .pd h2, .pd h3 { overflow-wrap: anywhere; }

  /* ---------- top ---------- */
  .pd-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px 12px; padding: 6px 0 10px; }
  .pd-top > :first-child { padding-right: 104px; } /* เว้นที่ให้ปุ่มแชทมุมขวาบน */
  .pd-kicker { color: var(--pd-gold); font-family: var(--pd-display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; }
  .pd-title { margin: 0; font-family: var(--pd-display); font-weight: 700; font-size: clamp(1.1rem, 4.4vw, 1.5rem); line-height: 1.2; }
  .pd-fun { display: inline-block; margin-top: 2px; font-size: 0.74rem; color: var(--pd-muted); }
  .pd-tools { display: flex; flex-wrap: wrap; gap: 6px; }
  .pd-pill {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px;
    border-radius: 999px; border: 1px solid var(--pd-line); background: var(--pd-surface);
    color: var(--pd-ink); font-size: 0.86rem; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .pd-pill:hover { background: var(--pd-surface-2); }
  .pd-pill[aria-pressed="true"] { border-color: var(--pd-gold); color: var(--pd-gold); }
  .pd-pill.is-static { cursor: default; }
  .pd-pill--danger { color: oklch(0.85 0.08 25); border-color: oklch(0.7 0.14 25 / 0.45); }
  .pd-pill:focus-visible, .pd-btn:focus-visible, .pd-chipbtn:focus-visible { outline: 2px solid var(--pd-gold); outline-offset: 2px; }

  /* ---------- now bar ---------- */
  .pd-now {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 12px;
    padding: 10px 14px 12px; border-radius: 16px; background: var(--pd-surface); border: 1px solid var(--pd-line-soft);
  }
  .pd-now.is-mine { background: oklch(0.32 0.07 80 / 0.55); border-color: var(--pd-gold); }
  .pd-now-phase { font-family: var(--pd-display); font-size: 0.76rem; font-weight: 600; letter-spacing: 0.1em; color: var(--pd-gold); }
  .pd-now-copy { grid-column: 1; font-size: 1.04rem; font-weight: 700; line-height: 1.3; }
  .pd-now-timer { grid-column: 2; grid-row: 1 / span 2; text-align: right; }
  .pd-now-sec { font-family: var(--pd-display); font-size: 1.5rem; font-weight: 700; color: var(--pd-gold); font-variant-numeric: tabular-nums; line-height: 1; }
  .pd-now-hint { display: block; font-size: 0.7rem; color: var(--pd-muted); margin-top: 3px; max-width: 132px; }
  .pd-now-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--pd-gold); transform-origin: left center; transform: scaleX(0); }
  .pd-now.is-urgent .pd-now-bar { background: var(--pd-lose); }
  .pd-now.is-urgent .pd-now-sec { color: var(--pd-lose); }

  /* ---------- table ---------- */
  .pd-table {
    position: relative; margin-top: 10px; padding: 14px 10px 16px; border-radius: 34px;
    background:
      url('/assets/games/pokdeng/emblem.svg') center 52% / 210px no-repeat,
      url('/assets/games/pokdeng/felt.svg') 0 0 / 64px repeat,
      radial-gradient(ellipse at 50% 42%, var(--pd-felt), var(--pd-felt-deep) 78%);
    box-shadow: inset 0 0 0 9px var(--pd-rail), inset 0 0 0 11px oklch(0.84 0.13 85 / 0.45), inset 0 18px 40px oklch(0 0 0 / 0.35), 0 20px 50px oklch(0 0 0 / 0.45);
    min-height: 330px;
  }
  .pd-dealer { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 8px 8px 4px; }
  .pd-dealer-head { display: flex; align-items: center; gap: 8px; max-width: 100%; }
  .pd-dealer-name { font-weight: 700; max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pd-dealer-chips { font-size: 0.82rem; color: var(--pd-soft); font-variant-numeric: tabular-nums; }
  .pd-badge {
    display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px;
    background: var(--pd-gold); color: var(--pd-accent-ink); font-family: var(--pd-display); font-weight: 700; font-size: 0.72rem; white-space: nowrap;
  }
  .pd-badge--soft { background: oklch(0 0 0 / 0.35); color: var(--pd-gold); border: 1px solid var(--pd-line); }
  .pd-dealer-cards { display: flex; gap: 6px; min-height: var(--dealer-card-h); align-items: center; justify-content: center; }
  .pd-dealer-cards .pd-card { width: var(--dealer-card-w); height: var(--dealer-card-h); }
  .pd-dealer-self { font-size: 0.86rem; color: var(--pd-soft); }

  .pd-center { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 6px 0 10px; }
  .pd-deck { position: relative; width: 40px; height: 56px; }
  .pd-deck img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 5px; box-shadow: 0 2px 4px oklch(0 0 0 / 0.4); }
  .pd-deck img:nth-child(2) { transform: translate(-2px, -2px); }
  .pd-deck img:nth-child(3) { transform: translate(-4px, -4px); }
  .pd-pot { display: flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border-radius: 999px; background: oklch(0 0 0 / 0.32); border: 1px solid var(--pd-line); }
  .pd-pot img { width: 30px; height: 30px; }
  .pd-pot-label { font-size: 0.7rem; color: var(--pd-muted); line-height: 1.1; }
  .pd-pot-amount { font-family: var(--pd-display); font-weight: 700; font-size: 1.05rem; color: var(--pd-gold); font-variant-numeric: tabular-nums; line-height: 1.1; }

  .pd-seats { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
  .pd-seat {
    position: relative; min-width: 0; padding: 8px 6px 8px; border-radius: 16px; text-align: center;
    background: oklch(0 0 0 / 0.26); border: 1px solid oklch(1 0 0 / 0.06);
    transition: box-shadow 0.2s var(--pd-ease), background-color 0.2s var(--pd-ease);
  }
  .pd-seat.is-turn { box-shadow: 0 0 0 2px var(--pd-gold), 0 0 22px oklch(0.84 0.13 85 / 0.35); background: oklch(0.3 0.06 70 / 0.45); }
  .pd-seat.is-out { opacity: 0.45; }
  .pd-seat-head { display: flex; align-items: center; justify-content: center; gap: 5px; min-width: 0; }
  .pd-seat-name { font-size: 0.8rem; font-weight: 700; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pd-seat-chips { font-size: 0.74rem; color: var(--pd-soft); font-variant-numeric: tabular-nums; }
  .pd-seat-cards { display: flex; justify-content: center; gap: 3px; min-height: var(--seat-card-h); margin: 5px 0 4px; }
  .pd-seat-cards:empty { min-height: 0; margin: 2px 0; }
  .pd-dealer-cards:empty { min-height: 0; }
  .pd-seat-cards .pd-card { width: var(--seat-card-w); height: var(--seat-card-h); border-radius: 4px; }
  .pd-seat-cards .pd-card img { border-radius: 4px; }
  .pd-seat-status { font-size: 0.72rem; color: var(--pd-muted); min-height: 1.1em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pd-seat-status.is-hot { color: var(--pd-gold); font-weight: 700; }
  .pd-bet { display: inline-flex; align-items: center; gap: 3px; margin-top: 2px; font-size: 0.74rem; font-weight: 700; color: var(--pd-gold); font-variant-numeric: tabular-nums; }
  .pd-bet img { width: 16px; height: 16px; }
  .pd-empty-seats { grid-column: 1 / -1; text-align: center; color: var(--pd-muted); font-size: 0.86rem; padding: 12px 0; }

  .pd-outcome {
    display: inline-flex; align-items: center; gap: 4px; margin-top: 3px; padding: 2px 8px; border-radius: 999px;
    font-size: 0.74rem; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .pd-outcome.is-win { background: var(--pd-win-bg); color: var(--pd-win); }
  .pd-outcome.is-lose { background: var(--pd-lose-bg); color: var(--pd-lose); }
  .pd-outcome.is-push { background: var(--pd-push-bg); color: var(--pd-soft); }
  .pd-outcome.is-pop { animation: pdPop 0.42s var(--pd-ease) both; animation-delay: var(--pop-delay, 0ms); }
  .pd-handlabel { display: block; font-size: 0.74rem; font-weight: 700; color: var(--pd-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pd-handlabel.is-special { color: var(--pd-gold); }

  .pd-pokburst {
    position: absolute; left: 50%; top: 38%; z-index: 4; pointer-events: none;
    padding: 4px 10px; border-radius: 999px; background: var(--pd-gold); color: var(--pd-accent-ink);
    font-family: var(--pd-display); font-weight: 700; font-size: 0.9rem; white-space: nowrap;
    transform: translate(-50%, -50%); animation: pdBurst 1.6s var(--pd-ease) both;
  }

  /* ---------- cards ---------- */
  .pd-card { position: relative; flex: 0 0 auto; width: var(--card-w); height: var(--card-h); perspective: 800px; }
  .pd-card-inner {
    position: absolute; inset: 0; transform-style: preserve-3d;
    transition: transform 0.5s var(--pd-ease); transition-delay: var(--flip-delay, 0ms);
  }
  .pd-card.is-face .pd-card-inner { transform: rotateY(180deg); }
  .pd-card-back, .pd-card-face {
    position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 8px;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    box-shadow: 0 4px 10px oklch(0 0 0 / 0.38);
  }
  .pd-card-face { transform: rotateY(180deg); }
  .pd-card.no-anim .pd-card-inner { transition: none; }
  .pd-card.is-dealing { animation: pdDeal 0.46s var(--pd-ease) both; animation-delay: var(--deal-delay, 0ms); }
  .pd-card.is-drawn .pd-card-face, .pd-card.is-drawn .pd-card-back { box-shadow: 0 0 0 2px var(--pd-gold), 0 4px 10px oklch(0 0 0 / 0.38); }

  /* ---------- result list ---------- */
  .pd-results { margin-top: 12px; padding: 12px; border-radius: 18px; background: var(--pd-surface); border: 1px solid var(--pd-line-soft); }
  .pd-results h2 { margin: 0 0 8px; font-family: var(--pd-display); font-size: 1rem; color: var(--pd-gold); }
  .pd-results-note { font-size: 0.78rem; color: var(--pd-muted); margin: 0 0 8px; }
  .pd-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2px 10px; padding: 8px 0; border-top: 1px solid var(--pd-line-soft); }
  .pd-row:first-of-type { border-top: 0; }
  .pd-row-name { font-weight: 700; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pd-row-hand { grid-column: 1; font-size: 0.8rem; color: var(--pd-soft); min-width: 0; }
  .pd-row-cards { display: inline-flex; gap: 2px; vertical-align: middle; margin-right: 6px; }
  .pd-row-cards img { width: 22px; height: 31px; border-radius: 3px; }
  .pd-row .pd-outcome { grid-column: 2; grid-row: 1 / span 2; font-size: 0.86rem; padding: 4px 10px; }

  /* ---------- dock ---------- */
  .pd-dock {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    padding: 10px max(16px, calc((100vw - 948px) / 2)) calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--pd-bg); border-top: 1px solid var(--pd-line);
    box-shadow: 0 -12px 30px oklch(0 0 0 / 0.45);
    max-height: 72vh; overflow-y: auto;
  }
  .pd-dock.is-static { position: static; max-height: none; margin: 12px 0 0; padding: 14px; border: 1px solid var(--pd-line); border-radius: 18px; box-shadow: none; }
  .pd.is-finished { padding-bottom: 24px; }
  .pd-me { display: flex; align-items: center; gap: 12px; min-height: 44px; }
  .pd-me-cards { display: flex; gap: 6px; flex: 0 0 auto; min-height: var(--card-h); align-items: center; }
  .pd-me-cards:empty { display: none; }
  .pd-me-info { min-width: 0; flex: 1 1 auto; }
  .pd-me-label { font-family: var(--pd-display); font-weight: 700; font-size: 1.3rem; line-height: 1.15; }
  .pd-me-label.is-special { color: var(--pd-gold); }
  .pd-me-sub { font-size: 0.84rem; color: var(--pd-soft); margin-top: 2px; font-variant-numeric: tabular-nums; }
  .pd-me-sub strong { color: var(--pd-ink); }
  .pd-me .pd-outcome { font-size: 0.95rem; padding: 4px 12px; margin-top: 6px; }
  .pd-actions { margin-top: 10px; display: grid; gap: 8px; }
  .pd-actions-row { display: flex; gap: 8px; }
  .pd-actions-row > * { flex: 1 1 0; min-width: 0; }
  .pd-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 0 16px;
    border-radius: 14px; border: 1px solid var(--pd-line); background: var(--pd-surface-2); color: var(--pd-ink);
    font-weight: 700; font-size: 1.02rem; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: transform 0.08s ease-out, background-color 0.18s ease-out;
  }
  .pd-btn:active { transform: scale(0.97); }
  .pd-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .pd-btn--primary { background: var(--pd-accent); color: var(--pd-accent-ink); border-color: transparent; font-family: var(--pd-display); font-size: 1.1rem; }
  .pd-btn--primary:hover { background: oklch(0.88 0.12 85); }
  .pd-btn--ghost { background: transparent; color: var(--pd-soft); }
  .pd-btn--big { min-height: 60px; font-size: 1.2rem; }
  .pd-hint { font-size: 0.8rem; color: var(--pd-muted); text-align: center; }
  .pd-wait { text-align: center; color: var(--pd-soft); padding: 6px 0; font-weight: 600; }

  .pd-bet-panel { display: grid; gap: 10px; }
  .pd-bet-panel { gap: 6px; }
  .pd-bet-top { display: flex; align-items: center; gap: 8px; }
  .pd-bet-amount { flex: 0 0 auto; min-width: 76px; display: grid; }
  .pd-bet-amount strong { font-family: var(--pd-display); font-size: 1.8rem; color: var(--pd-gold); font-variant-numeric: tabular-nums; line-height: 1; }
  .pd-bet-amount span { font-size: 0.72rem; color: var(--pd-muted); white-space: nowrap; }
  .pd-chips { flex: 1 1 auto; display: flex; justify-content: flex-end; gap: 2px; min-width: 0; }
  .pd-chipbtn {
    flex: 0 1 56px; min-width: 44px; display: flex; align-items: center; justify-content: center; min-height: 52px; padding: 0;
    border: 0; background: transparent; cursor: pointer; border-radius: 50%;
  }
  .pd-chipbtn img { width: 46px; height: 46px; transition: transform 0.12s var(--pd-ease); }
  .pd-chipbtn:active img { transform: translateY(-4px) scale(1.06); }
  .pd-chipbtn:disabled { opacity: 0.35; cursor: not-allowed; }
  .pd-range { width: 100%; accent-color: oklch(0.84 0.13 85); height: 44px; margin: 0; }
  .pd-quick { display: flex; gap: 6px; }
  .pd-quick .pd-btn { min-height: 44px; font-size: 0.86rem; padding: 0 8px; flex: 1 1 0; }

  .pd-standings { display: grid; gap: 0; margin: 4px 0 8px; }
  .pd-standings .pd-row { grid-template-columns: 28px minmax(0, 1fr) auto; }
  .pd-rank { font-family: var(--pd-display); font-weight: 700; color: var(--pd-gold); text-align: center; }
  .pd-standings .pd-row-hand { grid-column: 2; }
  .pd-standings .pd-outcome { grid-column: 3; }
  .pd-final-title { font-family: var(--pd-display); font-size: 1.3rem; font-weight: 700; margin: 0 0 4px; text-align: center; }

  /* ---------- history ---------- */
  .pd-history { margin-top: 12px; }
  .pd-history summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--pd-soft); font-weight: 600; font-size: 0.88rem; }
  .pd-feed { display: grid; gap: 4px; }
  .pd-feed-item { font-size: 0.82rem; color: var(--pd-soft); padding: 5px 10px; background: var(--pd-surface); border-radius: 10px; }

  /* ---------- fx ---------- */
  .pd-fx { position: fixed; inset: 0; pointer-events: none; z-index: 11000; }
  .pd-fly { position: absolute; left: 0; top: 0; width: 26px; height: 26px; transition: transform 0.55s var(--pd-ease), opacity 0.55s ease-in; will-change: transform; }
  .pd-banner {
    position: fixed; left: 50%; top: 42%; z-index: 11001; pointer-events: none; max-width: calc(100vw - 32px);
    padding: 12px 22px; border-radius: 999px; background: oklch(0.16 0.03 20 / 0.94); border: 1px solid var(--pd-gold);
    font-family: var(--pd-display); font-weight: 700; font-size: 1.2rem; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    opacity: 0; transform: translate(-50%, -50%);
  }
  .pd-banner.is-on { animation: pdBanner 1.7s var(--pd-ease) both; }
  .pd-banner.is-win { color: var(--pd-win); border-color: var(--pd-win); }
  .pd-banner.is-lose { color: var(--pd-lose); border-color: var(--pd-lose); }

  /* ---------- sidebar / guide ---------- */
  .pd-sidebar { position: fixed; top: 0; right: -320px; width: 300px; max-width: 86vw; height: 100%; background: var(--pd-surface); border-left: 1px solid var(--pd-line); padding: 18px; z-index: 9000; transition: right 0.25s ease; overflow-y: auto; color: var(--pd-ink); font-family: 'Bai Jamjuree', sans-serif; }
  .pd-sidebar.open { right: 0; }
  .pd-sidebar h4 { margin: 0 0 10px; font-family: var(--pd-display); }
  .pd-sidebar-overlay { display: none; position: fixed; inset: 0; background: oklch(0 0 0 / 0.55); z-index: 8999; }
  .pd-guide { text-align: left; font-family: 'Bai Jamjuree', sans-serif; line-height: 1.5; font-size: 0.94rem; }
  .pd-guide h4 { margin: 12px 0 6px; font-family: 'Chakra Petch', sans-serif; color: oklch(0.84 0.13 85); font-size: 0.98rem; }
  .pd-guide p { margin: 0 0 6px; }
  .pd-rankrow { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: 8px; padding: 7px 0; border-top: 1px solid oklch(1 0 0 / 0.08); }
  .pd-rankrow:first-child { border-top: 0; }
  .pd-rankno { font-family: 'Chakra Petch', sans-serif; font-weight: 700; color: oklch(0.84 0.13 85); text-align: center; }
  .pd-rankname { font-weight: 700; }
  .pd-rankdesc { display: block; font-size: 0.78rem; color: oklch(0.78 0.03 50); font-weight: 500; }
  .pd-rankcards { display: flex; gap: 2px; }
  .pd-rankcards img { width: 24px; height: 34px; border-radius: 3px; }
  .pd-deng { font-family: 'Chakra Petch', sans-serif; font-weight: 700; color: oklch(0.2 0.05 60); background: oklch(0.84 0.13 85); border-radius: 999px; padding: 1px 7px; font-size: 0.74rem; white-space: nowrap; }

  .chat-box {
    --chat-accent: oklch(0.7 0.16 30); --chat-accent-dark: oklch(0.45 0.13 25);
    --chat-surface: oklch(0.19 0.035 22); --chat-border: oklch(0.84 0.13 85 / 0.24); --chat-bubble: oklch(0.26 0.05 22);
    font-family: 'Bai Jamjuree', sans-serif;
  }
  /* มุมขวาบนข้างชื่อโต๊ะว่างอยู่ — ถ้าไว้เหนือแถบไพ่ จะบังผลของที่นั่งขวาสุด */
  .chat-toggle { --chat-toggle-bg: oklch(0.45 0.13 25); border-radius: 999px; padding: 10px 16px; min-height: 44px; top: calc(12px + env(safe-area-inset-top, 0px)) !important; bottom: auto !important; }
  .btn-chat-send { --chat-send-bg: oklch(0.84 0.13 85); --chat-send-color: oklch(0.2 0.05 60); }

  @keyframes pdDeal {
    0% { opacity: 0; transform: translate(var(--dx, 0px), var(--dy, -80px)) rotate(-24deg) scale(0.5); }
    18% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }
  @keyframes pdPop {
    0% { opacity: 0; transform: scale(0.6); }
    60% { opacity: 1; transform: scale(1.12); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes pdBurst {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
    18% { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
    30% { transform: translate(-50%, -50%) scale(1); }
    80% { opacity: 1; transform: translate(-50%, -60%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -80%) scale(0.96); }
  }
  @keyframes pdBanner {
    0% { opacity: 0; transform: translate(-50%, -38%) scale(0.92); }
    16% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    78% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -62%) scale(0.98); }
  }

  @media (min-width: 720px) {
    .pd { --card-w: 100px; --card-h: 140px; --seat-card-w: 44px; --seat-card-h: 62px; --dealer-card-w: 64px; --dealer-card-h: 90px; }
    .pd-seats { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
    .pd-table { padding: 18px 18px 20px; min-height: 380px; }
  }
  @media (max-width: 360px) {
    .pd { --card-w: 72px; --card-h: 101px; --seat-card-w: 30px; --seat-card-h: 42px; }
    .pd-chipbtn img { width: 40px; height: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pd-card.is-dealing, .pd-outcome.is-pop, .pd-pokburst, .pd-banner.is-on { animation-duration: 0.01ms !important; animation-delay: 0ms !important; }
    .pd-card-inner, .pd-fly, .pd-seat, .pd-btn, .pd-chipbtn img { transition: none !important; }
    .pd-banner.is-on { animation: none !important; opacity: 1; }
  }
</style>

<div id="connectionStatus" class="pd-pill pd-pill--danger" style="display:none; position:fixed; top:10px; left:50%; transform:translateX(-50%); z-index:10001;">กำลังเชื่อมต่อใหม่...</div>
<div id="pdFx" class="pd-fx" aria-hidden="true"></div>
<div id="pdBanner" class="pd-banner" aria-hidden="true"></div>

<div class="pd" id="pdRoot">
  <div class="pd-top">
    <div style="min-width:0;">
      <div class="pd-kicker">ป๊อกเด้ง · <span id="pdHandNo">มือที่ -</span></div>
      <h1 class="pd-title"><%= room.name %></h1>
      <span class="pd-fun">ชิปในโต๊ะนี้ ไม่มีมูลค่าจริง</span>
    </div>
    <div class="pd-tools">
      <button type="button" id="pdRankBtn" class="pd-pill">อันดับไพ่</button>
      <button type="button" id="pdHowBtn" class="pd-pill">วิธีเล่น</button>
      <button type="button" id="pdRotateBtn" class="pd-pill <%= room.admin ? '' : 'is-static' %>" aria-pressed="false">เจ้ามือคงที่</button>
      <button type="button" id="pdSidebarBtn" class="pd-pill" aria-expanded="false" aria-controls="playerSidebar">ผู้เล่น</button>
      <% if (room.admin) { %>
      <button type="button" id="pdEndBtn" class="pd-pill pd-pill--danger">จบโต๊ะ</button>
      <% } %>

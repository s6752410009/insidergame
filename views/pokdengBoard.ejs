      </div>
      <div class="pd-pot" id="pdPot">
        <img src="/assets/games/pokdeng/chip-100.svg" alt="">
        <div><div class="pd-pot-label">เดิมพันบนโต๊ะ</div><div class="pd-pot-amount" id="pdPotAmount">0</div></div>
      </div>

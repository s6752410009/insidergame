      Swal.fire({
        title: '🎩 วิธีเล่น Black Market',
        html: buildBlackMarketLobbyGuideHtml(),
        background: '#111',
        color: '#fff',
        confirmButtonText: 'เข้าใจแล้ว',
        confirmButtonColor: '#b45309',
        customClass: {
          popup: 'bm-guide-popup',
          htmlContainer: 'bm-guide-popup-body'
        }
      });

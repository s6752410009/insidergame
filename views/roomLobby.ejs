<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/coupGuide.css">
<link rel="stylesheet" href="/static/css/pokerHands.css">
<style>
  :root {
    --lobby-bg: #09090b;
    --lobby-panel: rgba(18, 18, 20, 0.86);
    --lobby-line: rgba(255, 255, 255, 0.1);
    --lobby-gold: #f5c86b;
    --lobby-text: #f5efe3;
    --lobby-muted: #b8ada0;
    --lobby-shadow: 0 32px 100px rgba(0, 0, 0, 0.52);
  }

  body.content {
    background:
      radial-gradient(circle at 10% 5%, rgba(127, 29, 29, 0.45), transparent 22%),
      radial-gradient(circle at 92% 0%, rgba(180, 83, 9, 0.22), transparent 18%),
      linear-gradient(180deg, #09090b 0%, #110d0c 45%, #17110f 100%);
  }

  /* Popup แก้ไขห้อง - Modern Style */
  .room-popup {
      max-width: 480px !important;
      border-radius: 20px !important;
      border: 3px solid #333 !important;
      background: linear-gradient(145deg, #1a1a2e 0%, #16213e 100%) !important;
      box-shadow: 0 20px 60px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.05) inset !important;
      padding: 0 !important;
      overflow: hidden !important;
  }
  
  .room-popup .swal2-title {
      background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
      margin: 0 !important;
      padding: 20px 24px !important;
      font-family: 'Orbitron', sans-serif !important;
      font-size: 1.4em !important;
      font-weight: 700 !important;
      color: #fff !important;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  }

  .room-popup .swal2-html-container {
      margin: 0 !important;
      padding: 24px !important;
      overflow: visible !important;
  }
  
  .room-popup .swal2-actions {
      padding: 0 24px 24px !important;
      gap: 12px !important;
  }
  
  .room-form-group {
      margin-bottom: 20px;
  }
  
  .room-form-label {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
      font-weight: 600;
      color: #aaa;
      font-size: 0.95em;
      font-family: 'Rajdhani', sans-serif;
  }
  

  .is-hidden {
    display: none !important;
  }

  .room-form-label .icon {
      font-size: 1.1em;
  }

  .room-form-input {
      width: 100%;
      padding: 14px 16px;
      border: 2px solid #333;
      border-radius: 12px;
      background: #0d0d1a;
      color: #fff;
      font-family: 'Rajdhani', sans-serif;
      font-size: 1.1em;
      font-weight: 600;
      transition: all 0.3s ease;
      box-sizing: border-box;
  }
  
  .room-form-input:focus {
      outline: none;
      border-color: #e74c3c;
      box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.2);
  }
  
  .room-form-input::placeholder {
      color: #555;
      font-weight: 400;
  }
  
  /* Slider Style */
  .room-slider-container {
      position: relative;
      padding: 10px 0;
  }
  
  .room-slider {
      appearance: none;
      -webkit-appearance: none;
      width: 100%;
      height: 8px;
      border-radius: 4px;
      background: linear-gradient(90deg, #333 0%, #333 100%);
      outline: none;
      transition: all 0.3s;
  }
  
  .room-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
      cursor: pointer;
      border: 3px solid #fff;
      box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
      transition: all 0.2s;
  }
  
  .room-slider::-webkit-slider-thumb:hover {
      transform: scale(1.1);
      box-shadow: 0 6px 20px rgba(231, 76, 60, 0.6);
  }
  
  .room-slider::-moz-range-thumb {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
      cursor: pointer;
      border: 3px solid #fff;
      box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
  }
  
  .room-slider-value {
      position: absolute;
      right: 0;
      top: -5px;
      background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
      color: #fff;
      padding: 6px 14px;
      border-radius: 20px;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 1em;
      box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
  }
  
  /* Button Styles */
  .room-btn-confirm {
      padding: 14px 28px !important;
      background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%) !important;
      border: none !important;
      border-radius: 12px !important;
      color: #fff !important;
      font-family: 'Rajdhani', sans-serif !important;
      font-weight: 700 !important;
      font-size: 1.1em !important;
      cursor: pointer;
      transition: all 0.3s !important;
      box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
  }
  
  .room-btn-confirm:hover {
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 25px rgba(231, 76, 60, 0.4) !important;
  }
  
  .room-btn-cancel {
      padding: 14px 28px !important;
      background: transparent !important;
      border: 2px solid #555 !important;
      border-radius: 12px !important;
      color: #aaa !important;
      font-family: 'Rajdhani', sans-serif !important;
      font-weight: 700 !important;
      font-size: 1.1em !important;
      cursor: pointer;
      transition: all 0.3s !important;
  }
  
  .room-btn-cancel:hover {
      border-color: #888 !important;
      color: #fff !important;
      background: rgba(255,255,255,0.05) !important;
  }

  /* Checkbox container for locked room */
  .room-checkbox-container {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      background: #0d0d1a;
      border: 2px solid #333;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s;
  }
  
  .room-checkbox-container:hover {
      border-color: #555;
  }
  
  .room-checkbox-container.checked {
      border-color: #e74c3c;
      background: rgba(231, 76, 60, 0.1);
  }
  
  .room-checkbox {
      display: none;
  }
  
  .room-checkbox-custom {
      width: 24px;
      height: 24px;
      border: 2px solid #555;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: transparent;
      font-size: 14px;
      transition: all 0.3s;
  }
  
  .room-checkbox-container.checked .room-checkbox-custom {
      background: #e74c3c;
      border-color: #e74c3c;
      color: #fff;
  }
  
  .room-checkbox-container.disabled {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
  }
  
  .room-checkbox-text {
      flex: 1;
      font-weight: 600;
      color: #fff;
      font-family: 'Rajdhani', sans-serif;
      font-size: 1.05em;
  }

  .room-lobby-container {
    position: relative;
    max-width: 1440px;
    margin: 20px auto 36px;
    padding: 20px;
    font-family: 'Rajdhani', sans-serif;
    color: var(--lobby-text);
    overflow-x: hidden;
  }

  .room-lobby-shell {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(245, 200, 107, 0.16);
    border-radius: 34px;
    background:
      linear-gradient(145deg, rgba(12, 12, 14, 0.98), rgba(26, 17, 15, 0.94)),
      var(--lobby-bg);
    box-shadow: var(--lobby-shadow);
  }

  .room-lobby-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.05) 0.7px, transparent 0.7px);
    background-size: 16px 16px;
    opacity: 0.18;
    pointer-events: none;
  }

  .room-lobby-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, rgba(245, 200, 107, 0.06), transparent 18%, transparent 70%, rgba(116, 185, 255, 0.04)),
      radial-gradient(circle at top center, rgba(245, 200, 107, 0.08), transparent 32%);
    pointer-events: none;
    z-index: 0;
  }

  .room-lobby-header {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    padding: 24px 26px 22px;
    margin-bottom: 0;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--lobby-line);
    background:
      radial-gradient(circle at top left, rgba(127, 29, 29, 0.32), transparent 34%),
      linear-gradient(135deg, rgba(127, 29, 29, 0.22), rgba(17, 17, 17, 0.72));
  }

  .room-lobby-header::after {
    content: '';
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(245, 200, 107, 0.24), transparent 32%, transparent 68%, rgba(245, 200, 107, 0.2));
  }

  .room-lobby-hero {
    display: grid;
    gap: 8px;
    max-width: 760px;
  }

  .room-kicker {
    color: var(--lobby-gold);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .room-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 0 20px rgba(245, 200, 107, 0.12);
    letter-spacing: 0.06em;
  }

  .room-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.95em;
    color: var(--lobby-text);
  }

  .room-meta span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    font-weight: 700;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .room-subtitle {
    color: var(--lobby-muted);
    font-size: 1rem;
    max-width: 64ch;
  }

  .room-header-actions {
    position: relative;
    z-index: 1;
  }

  .room-header-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.08);
    color: var(--lobby-text);
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .room-main-panel {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: 20px;
    padding: 22px;
  }

  .page-footer-actionbar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
  }

  .page-footer-actionbar .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    min-width: min(320px, calc(100vw - 32px));
    padding: 8px 20px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    color: var(--lobby-text);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    text-decoration: none;
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .page-footer-actionbar .btn:hover {
    border-color: rgba(245, 200, 107, 0.26);
    background: rgba(255, 255, 255, 0.11);
  }

  .room-chat-area {
    min-width: 0;
  }

  .lobby-player-list {
    max-width: none;
  }

  .room-card-dark {
    background:
      linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02)),
      var(--lobby-panel);
    border-radius: 28px;
    border: 1px solid var(--lobby-line);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 18px 42px rgba(0,0,0,0.24);
    padding: 18px 20px 16px;
  }

  .room-card-dark:hover {
    border-color: rgba(245, 200, 107, 0.16);
  }

  .room-chat-area.room-card-dark {
    min-height: 460px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Mobile responsive for room lobby */
  @media (max-width: 768px) {
    .room-main-panel {
      grid-template-columns: 1fr;
    }
    
    .room-chat-area {
      min-width: 100%;
      height: 280px !important;
      max-height: 280px;
    }
    
    .lobby-player-list {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }

  .room-chat-messages {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 4px;
    margin-bottom: 10px;
    font-size: 0.95em;
    min-height: 0;
    max-height: calc(100% - 60px);
    word-wrap: break-word;
    word-break: break-word;
  }

  .room-chat-input-row {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  #lobbyChatInput {
    flex: 1;
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.06);
    color: var(--lobby-text);
    resize: none;
    min-height: 34px;
    max-height: 90px;
  }

  #lobbyChatInput:focus {
    outline: none;
    border-color: rgba(245, 200, 107, 0.34);
  }

  .btn-send-chat {
    padding: 10px 16px;
    border-radius: 14px;
    border: none;
    background: linear-gradient(135deg, #9a3412, #7f1d1d);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    font-size: 0.9em;
  }

  .btn-send-chat:active {
    transform: translateY(1px);
  }

  .lobby-player-list h3 {
    font-size: 1.1em;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .lobby-player-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px dashed rgba(255,255,255,0.12);
    font-size: 0.95em;
  }

  .lobby-player-main {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lobby-player-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2ecc71;
  }

  .lobby-player-name {
    font-weight: 600;
  }

  .lobby-player-role {
    font-size: 0.8em;
    color: #ffdd59;
  }

  .lobby-player-admin-badge {
    font-size: 0.8em;
    color: #f39c12;
  }

  .player-action-icons {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }

  .player-action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1em;
    padding: 4px 6px;
    border-radius: 6px;
    transition: all 0.2s;
    opacity: 0.7;
  }

  .player-action-btn:hover {
    opacity: 1;
    transform: scale(1.2);
  }

  .player-action-btn.kick-btn:hover {
    background: rgba(231, 76, 60, 0.3);
  }

  .player-action-btn.crown-btn:hover {
    background: rgba(243, 156, 18, 0.3);
  }

  .lobby-admin-controls {
    margin-top: 12px;
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 12px;
  }

  .lobby-admin-controls h4 {
    font-size: 1em;
    margin-bottom: 6px;
  }

  .lobby-admin-controls .btn-admin-small {
    margin-top: 8px;
  }

  .btn-admin-small {
    width: 100%;
    margin-bottom: 6px;
    padding: 10px 12px;
    border-radius: 14px;
    border: none;
    font-size: 0.9em;
    cursor: pointer;
    font-weight: 700;
  }

  .btn-kick {
    background: #e74c3c;
    color: #fff;
  }

  .btn-transfer {
    background: #3498db;
    color: #fff;
  }

  .btn-edit-room {
    background: #f39c12;
    color: #111;
  }

  .start-game-bar {
    margin-top: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-shrink: 0; /* ป้องกันไม่ให้ถูกบีบ */
    min-height: 50px;
    flex-wrap: wrap;
  }

  .start-game-bar span {
    font-size: 0.95em;
    color: #ddd;
    flex: 1 1 220px;
    min-width: 0;
  }

  #btnStartGameLobby {
    padding: 12px 18px;
    border-radius: 14px;
    border: none;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 1em;
    cursor: pointer;
    background: #2ecc71;
    color: #111;
    flex: 0 0 auto;
    width: auto;
    min-width: 156px;
    white-space: nowrap;
  }

  #btnStartGameLobby:disabled {
    background: #555;
    color: #aaa;
    cursor: not-allowed;
  }

  #btnBlackMarketHowTo {
    padding: 10px 14px;
    border-radius: 14px;
    border: 1px solid rgba(245, 200, 107, 0.35);
    background: rgba(245, 200, 107, 0.12);
    color: #fde68a;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.95em;
    cursor: pointer;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  #btnBlackMarketHowTo:hover {
    background: rgba(245, 200, 107, 0.2);
    border-color: rgba(245, 200, 107, 0.55);
  }

  #btnBlackMarketAddBots {
    padding: 10px 14px;
    border-radius: 14px;
    border: 1px solid rgba(16, 185, 129, 0.35);
    background: rgba(16, 185, 129, 0.12);
    color: #a7f3d0;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.95em;
    cursor: pointer;
    flex: 0 0 auto;
    white-space: nowrap;
    margin-right: 8px;
  }

  #btnBlackMarketAddBots:hover {
    background: rgba(16, 185, 129, 0.2);
    border-color: rgba(16, 185, 129, 0.55);
  }

  #btnSpyfallHowTo {
    padding: 10px 14px;
    border-radius: 14px;
    border: 1px solid rgba(94, 234, 212, 0.35);
    background: rgba(20, 184, 166, 0.12);
    color: #99f6e4;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.95em;
    cursor: pointer;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  #btnSpyfallHowTo:hover {
    background: rgba(20, 184, 166, 0.2);
    border-color: rgba(94, 234, 212, 0.55);
  }

  #btnUndercoverHowTo {
    padding: 10px 14px; min-height: 44px; border-radius: 14px;
    border: 1px solid rgba(245, 200, 107, 0.4); background: rgba(245, 200, 107, 0.12); color: #fde68a;
    font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.95em;
    cursor: pointer; flex: 0 0 auto; white-space: nowrap;
  }
  #btnUndercoverHowTo:hover { background: rgba(245, 200, 107, 0.22); }
  .uc-mw-toggle {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: 10px; padding: 0 14px;
    border-radius: 12px; border: 1px solid rgba(245, 200, 107, 0.35); background: #1a2332; color: #f1f0fa;
    font-weight: 700; cursor: pointer;
  }
  .uc-mw-toggle[aria-pressed="true"] { background: #f5c86b; color: #1a2332; border-color: transparent; }
  .uc-mw-toggle:disabled { cursor: default; opacity: 0.8; }
  #btnColorCardsHowTo {
    padding: 10px 14px; min-height: 44px; border-radius: 14px;
    border: 1px solid rgba(96, 165, 250, 0.5); background: rgba(37, 99, 235, 0.2); color: #f5c86b;
    font-weight: 700; font-size: 0.95em; cursor: pointer; flex: 0 0 auto; white-space: nowrap;
  }
  .cc-lobby-opts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .cc-lobby-opts select { min-height: 44px; padding: 0 10px; border-radius: 12px; border: 1px solid rgba(245, 200, 107, 0.35); background: #1a2332; color: #f1f0fa; font-weight: 700; max-width: 100%; }
  .cc-lobby-opts select:disabled { opacity: 0.85; }
  .cc-lobby-opts .uc-mw-toggle { margin-top: 0; }
  /* เศรษฐี 🎒 สกิลที่ติดตัว (ห้องรอ) */
  .st-lo { margin-top: 12px; padding: 10px; border-radius: 14px; background: rgba(0,0,0,0.22); border: 1px solid rgba(245, 200, 107, 0.25); }
  .st-lo-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-weight: 700; color: #f5c86b; font-size: 0.92em; }
  .st-lo-head a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 12px; border-radius: 10px; background: rgba(245, 200, 107, 0.16); color: #f5c86b; text-decoration: none; font-weight: 700; white-space: nowrap; }
  .st-lo-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .st-lo-chip { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; padding: 0 10px; border-radius: 12px; border: 1.5px solid rgba(255,255,255,0.18); background: #1a2332; color: #e8e6f4; font-weight: 600; font-size: 0.88em; cursor: pointer; }

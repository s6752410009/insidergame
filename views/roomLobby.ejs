    function buildAvalonLobbyHtml(payload) {
      const picked = getAvalonRoles(payload);
      const lady = !!(payload && payload.settings && payload.settings.avalonLady === true);
      const count = Number((payload && (payload.playerCount || payload.onlineCount)) || 0);
      const teams = AVALON_TEAM_COUNTS[count];
      const evilPicked = picked.filter(id => id !== 'percival').length;
      let plan;
      let bad = false;
      if (!teams) {
        plan = 'ต้องมี 5–10 คนออนไลน์ (ตอนนี้ ' + count + ' คน) · ฝ่ายดี:ร้าย 5→3:2 · 7→4:3 · 10→6:4';
      } else if (evilPicked > teams[1] - 1) {
        bad = true;
        plan = count + ' คน มีฝ่ายร้าย ' + teams[1] + ' คน (รวมมือสังหาร) — เลือกบทฝ่ายร้ายเสริมได้ไม่เกิน ' + (teams[1] - 1) + ' บท';
      } else {
        const good = ['เมอร์ลิน'].concat(picked.indexOf('percival') >= 0 ? ['เพอร์ซิวัล'] : []);
        const evil = ['มือสังหาร'].concat(AVALON_OPTIONAL.filter(r => r.team === 'evil' && picked.indexOf(r.id) >= 0).map(r => r.name));
        const loyal = teams[0] - good.length;
        const minion = teams[1] - evil.length;
        plan = count + ' คน · ฝ่ายดี ' + teams[0] + ': ' + good.join(', ') + (loyal ? ' + อัศวินผู้ภักดี ' + loyal : '') +
          ' · ฝ่ายร้าย ' + teams[1] + ': ' + evil.join(', ') + (minion ? ' + สมุน ' + minion : '');
      }
      const chips = AVALON_OPTIONAL.map(function(r) {
        const on = picked.indexOf(r.id) >= 0;
        return '<button type="button" class="avl-role' + (on ? ' is-on' : '') + (r.team === 'evil' ? ' is-evil' : '') + '" data-avalon-role="' + r.id + '" aria-pressed="' + on + '"' + (isAdmin ? '' : ' disabled') + '>' +
          '<img src="/assets/games/avalon/' + r.id + '.svg" alt=""><span>' + r.name + '<br><small style="color:#94a3b8;font-weight:500;">' + r.hint + '</small></span></button>';
      }).join('');
      return [
        '<div class="lobby-spotlight-pill" style="background:rgba(29,78,216,0.3); color:#dbeafe;">🏰 อวาลอน · 5–10 คน</div>',
        '<p style="margin:8px 0 0; color:#cbd5e1; font-size:0.88em; line-height:1.45;">ฝ่ายดีทำภารกิจสำเร็จ 3 ใน 5 · ฝ่ายร้ายทำให้ล้ม 3 · เมอร์ลินกับมือสังหารมีเสมอ</p>',
        '<div style="margin-top:10px; font-size:0.85em; color:#f5c86b; font-weight:700;">บทเสริม' + (isAdmin ? ' (แตะเพื่อเปิด/ปิด)' : '') + '</div>',
        '<div class="avl-roles">' + chips + '</div>',
        '<p class="avl-plan' + (bad ? ' is-bad' : '') + '">' + plan + '</p>',
        // นางแห่งทะเลสาบ — ตัวเสริมในกล่องหลัก ค่าเริ่มต้นปิด (กติกาแนะนำ 7 คนขึ้นไป)
        '<div style="margin-top:10px; font-size:0.85em; color:#f5c86b; font-weight:700;">ตัวเสริม</div>',
        '<div class="avl-roles"><button type="button" class="avl-role' + (lady ? ' is-on' : '') + '" style="grid-column:1 / -1;" data-avalon-lady aria-pressed="' + lady + '"' + (isAdmin ? '' : ' disabled') + '>' +
          '<span style="font-size:1.6em; line-height:1;" aria-hidden="true">🌊</span><span>นางแห่งทะเลสาบ ' + (lady ? 'เปิด' : 'ปิด') + '<br><small style="color:#94a3b8;font-weight:500;">หลังภารกิจ 2–4 ส่องฝ่าย 1 คน · แนะนำ 7+ คน</small></span></button></div>'
      ].join('');
    }

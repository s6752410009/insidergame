<script>
  // 🎒 สกิลติดตัวเศรษฐี (โหลดครั้งเดียว · วาดใหม่ทุกครั้งที่ห้องอัปเดต)
  var setthiLoadout = (function() {
    var data = null;
    var loading = false;
    var busy = false;
    var skillsOn = true;
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function shopHref() {
      var m = location.pathname.match(/^\/room\/([^/?#]+)/);
      return '/setthi/shop' + (m ? '?room=' + encodeURIComponent(m[1]) : '');
    }
    function paint() {
      var box = document.getElementById('stLobbyLoadout');
      if (!box) return;
      var head = '<div class="st-lo-head"><span>🎒 สกิลติดตัว ' + (data ? (data.profile.loadout.length + '/3') : '') + '</span><a href="' + shopHref() + '" id="stLobbyShop">🏪 ร้าน' + (data ? ' · 🪙 ' + Number(data.profile.gold).toLocaleString('en-US') : '') + '</a></div>';
      if (!data) { box.innerHTML = head + '<p class="st-lo-note">กำลังโหลด...</p>'; return; }
      var owned = data.skills.filter(function(s) { return (data.profile.skills[s.id] || 0) > 0; });
      var load = data.profile.loadout;
      var chips = owned.map(function(s) {
        var on = load.indexOf(s.id) >= 0;
        return '<button type="button" class="st-lo-chip" data-lo="' + esc(s.id) + '" aria-pressed="' + on + '"' + (!on && load.length >= 3 ? ' disabled' : '') + '>' + s.icon + ' ' + esc(s.name) + ' <small>Lv' + data.profile.skills[s.id] + '</small></button>';
      }).join('');
      box.innerHTML = head + (owned.length ? '<div class="st-lo-chips">' + chips + '</div>' : '<p class="st-lo-note">ยังไม่มีสกิล — ชนะเกมเก็บ 🪙 แล้วไปอัปที่ร้าน</p>') +
        (skillsOn ? '' : '<p class="st-lo-note">🚫 ห้องนี้ปิดสกิล — เกมนี้ทุกคนไม่มีสกิล</p>');
    }
    function load() {
      if (loading) return;
      loading = true;
      fetch('/api/setthi/gold', { credentials: 'same-origin', cache: 'no-store' }).then(function(r) { return r.json(); }).then(function(res) {
        loading = false;
        if (res && res.success) { data = res; paint(); }
      }).catch(function() { loading = false; });
    }
    return {
      render: function(on) { skillsOn = on; paint(); if (!data) load(); },
      reload: load,
      toggle: function(id) {
        if (!data || busy) return;
        var load2 = data.profile.loadout.slice();
        var at = load2.indexOf(id);
        var next = at >= 0 ? load2.filter(function(x) { return x !== id; }) : load2.concat([id]);
        if (next.length > 3) return;
        busy = true;
        fetch('/api/setthi/shop/loadout', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ loadout: next }) })
          .then(function(r) { return r.json(); }).then(function(res) {
            busy = false;
            if (res && res.profile) data.profile = res.profile;
            paint();
          }).catch(function() { busy = false; });
      }
    };
  })();
  document.addEventListener('visibilitychange', function() { if (!document.hidden && document.getElementById('stLobbyLoadout')) setthiLoadout.reload(); });

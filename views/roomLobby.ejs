    function setElementHidden(target, hidden) {
      const element = typeof target === 'string' ? document.querySelector(target) : target;
      if (!element) {
        return;
      }

      element.classList.toggle('is-hidden', !!hidden);
    }

    function applyLobbySelfNameColor() {
      const selfName = document.getElementById('lobbySelfName');
      if (!selfName) {
        return;
      }

      selfName.style.color = selfName.dataset.playerColor || '#fff';
    }

    currentGameMode = normalizeLobbyGameMode(currentGameMode);
    applyLobbySelfNameColor();
    updateLobbyModeUI({
      gameMode: currentGameMode,
      gameModeLabel: '<%= room.gameModeLabel %>',
      roomName: '<%= room.name %>',
      settings: { gameMode: currentGameMode }
    });
    
    // ===== โหลดการตั้งค่าจาก localStorage =====
    function getGameSettings() {
        return JSON.parse(localStorage.getItem('gameSettings') || '{}');
    }
    
    function shouldConfirmLeave() {
        const settings = getGameSettings();
        return settings.confirmLeave !== false; // default เป็น true
    }
    
    // ===== ป้องกันกดย้อนกลับ / ปิดหน้า =====
    let allowNavigation = false; // flag สำหรับการ navigate ที่ตั้งใจ
    let isShowingConfirm = false; // กำลังแสดง popup อยู่
    
    // ===== วิธี Hash-based + Multiple History Entries (ป้องกัน back ได้ดีที่สุด) =====
    // ใส่ history entries หลายๆ อัน เพื่อป้องกันการกด back หลายครั้ง
    function setupBackBlocker() {
        // ลบ hash เดิมก่อน แล้วใส่ใหม่
        history.replaceState({ page: 'room', index: 0 }, '', location.pathname + location.search);
        // ใส่ blocker entries หลายอัน
        for (let i = 1; i <= 3; i++) {
            history.pushState({ page: 'room', index: i }, '', location.pathname + location.search + '#inroom');
        }
    }
    setupBackBlocker();
    
    // ฟังก์ชันออกจากห้อง
    function leaveRoomAndRedirect() {
        allowNavigation = true;
        socket.emit('leaveRoom', { roomId: roomId, playerId: playerId });
        setTimeout(() => {
            window.location.href = '/rooms?playerId=' + playerId;
        }, 150);
    }
    
    // ฟังก์ชันแสดง confirm dialog
    function showLeaveConfirmation() {
        if (isShowingConfirm) return;
        isShowingConfirm = true;
        
        // ใส่ hash กลับทันทีก่อนแสดง popup
        history.pushState(null, '', location.pathname + location.search + '#inroom');
        
        Swal.fire({
            icon: 'warning',
            title: 'ต้องการออกจากห้องหรือ?',
            text: 'ถ้าออกจากห้อง คุณจะถูกนำออกจากห้องนี้',
            showCancelButton: true,
            confirmButtonText: 'ออกจากห้อง',
            cancelButtonText: 'อยู่ต่อ',
            confirmButtonColor: '#e74c3c',
            cancelButtonColor: '#3085d6',
            background: '#1e1e1e',
            color: '#fff',
            allowOutsideClick: false,
            allowEscapeKey: false
        }).then((result) => {
            isShowingConfirm = false;
            if (result.isConfirmed) {
                leaveRoomAndRedirect();
            } else {
                // ถ้ากดยกเลิก → ใส่ blocker กลับ
                setupBackBlocker();
            }
        });
    }
    
    // 1. ดัก popstate (เมื่อ user กด back)
    window.addEventListener('popstate', function(e) {
        if (allowNavigation) return;
        
        // บล็อกการ back ทันที โดยใส่ history กลับ
        e.preventDefault();
        
        if (!shouldConfirmLeave()) {
            leaveRoomAndRedirect();
            return;
        }
        
        if (!isShowingConfirm) {
            showLeaveConfirmation();
        } else {
            // ถ้ากำลังแสดง popup อยู่ → ใส่ blocker กลับ
            setupBackBlocker();
        }
    });
    
    // 2. ดัก hashchange (backup สำหรับบาง browser)
    window.addEventListener('hashchange', function(e) {
        if (allowNavigation) return;
        
        // ถ้า hash หายไป (user กด back)
        if (!location.hash || location.hash !== '#inroom') {
            e.preventDefault();
            setupBackBlocker(); // ใส่ blocker กลับ
            
            if (!shouldConfirmLeave()) {
                leaveRoomAndRedirect();
                return;
            }
            
            if (!isShowingConfirm) {
                showLeaveConfirmation();
            }
        }
    });
    
    // 3. ดัก beforeunload (กรณีปิด tab/refresh)
    // ไม่ส่ง leave-room ที่นี่ เพราะ reload/refresh จะถูกตีความว่าออกจากห้องและทำให้สิทธิ์ admin เด้งผิดคน
    sessionStorage.setItem('roomLobby_' + roomId, 'active');
    
    window.addEventListener('beforeunload', function(e) {
        if (allowNavigation) return;
        
        // ตั้ง flag ว่ากำลังจะ unload - ถ้า reload กลับมา flag นี้จะยังอยู่
        sessionStorage.setItem('roomLobby_unloading_' + roomId, Date.now().toString());
        
        if (!shouldConfirmLeave()) return;
        
        // ถ้าเปิดการยืนยัน → แสดง dialog ของ browser (ยังไม่ส่ง leaveRoom)
        e.preventDefault();
        e.returnValue = 'คุณกำลังอยู่ในห้อง ต้องการออกจริงหรือ?';
        return e.returnValue;
    });
    
    // 4. ดัก pagehide (สำหรับ mobile browsers)
    // ไม่ส่ง beacon ออกจากห้องที่นี่เช่นกัน เพราะ refresh / soft navigation ทำให้ state ห้องพังได้
    window.addEventListener('pagehide', function(e) {
        // ถ้า allowNavigation = true แปลว่ากำลัง redirect ไปหน้าเกม ไม่ต้องส่ง leave
        if (allowNavigation) return;
        
        // e.persisted = true หมายความว่าหน้าถูก cache ไว้ใน bfcache (back/forward)
        // ไม่ควรส่ง leaveRoom ในกรณีนี้
        if (e.persisted) return;
    });
    
    // 5. ดัก visibilitychange (เมื่อ user สลับ tab หรือ minimize)
    let wasHidden = false;
    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'hidden') {
            wasHidden = true;
            // เก็บเวลาที่ซ่อน
            sessionStorage.setItem('hiddenTime', Date.now().toString());
        } else if (wasHidden) {
            // กลับมาแล้ว - ตรวจสอบว่าห้องยังอยู่ไหม
            wasHidden = false;
            socket.emit('checkRoomStatus', { roomId: roomId, playerId: playerId });
        }
    });
    
    // Function to show/hide admin controls
    function updateAdminUI() {
      setElementHidden('#btnStartGameLobby', !isAdmin);
      setElementHidden('#adminControlsSection', !isAdmin);
      refreshAddBotsButton();
      // Re-render player list เพื่อแสดง/ซ่อน action icons ให้ถูกต้อง
      socket.emit('requestRoomUpdate', { roomId: roomId });
    }

    function updateStartButtonState(players) {
      const btn = $('#btnStartGameLobby');
      if (!btn.length) return;
      const modeMeta = getModeMeta(currentGameMode);
      btn.text(modeMeta.startLabel);
      const count = (players || []).filter(function(player) {
        return player.online !== false;
      }).length;
      if (count >= modeMeta.minPlayers) {
        btn.prop('disabled', false);
        $('#lobbyStatusText').text(modeMeta.readyText);
      } else {
        btn.prop('disabled', true);
        $('#lobbyStatusText').text(modeMeta.waitingText);
      }
    }
    
    // ฟังก์ชันแสดง/ซ่อน dual traitor toggle
    function updateDualTraitorToggleVisibility(playerCount) {
      const toggle = document.getElementById('dualTraitorQuickToggle');
      if (normalizeLobbyGameMode(currentGameMode) !== 'insider') {
        setElementHidden(toggle, true);
        return;
      }

      if (!toggle) return;
      
      if (isAdmin && playerCount >= 5) {
        setElementHidden(toggle, false);
      } else {
        setElementHidden(toggle, true);
        // ถ้าผู้เล่นน้อยกว่า 5 และโหมดเปิดอยู่ ให้ปิดอัตโนมัติ
        const checkbox = document.getElementById('quickDualTraitorToggle');
        if (checkbox && checkbox.checked && playerCount < 5) {
          checkbox.checked = false;
          // ส่ง socket เพื่อปิด
          socket.emit('toggleDualTraitorMode', { roomId: roomId, enabled: false });
        }
      }
    }
    
    // Event handler สำหรับ quick toggle
    $(document).on('change', '#quickDualTraitorToggle', function() {
      if (normalizeLobbyGameMode(currentGameMode) !== 'insider') {
        this.checked = false;
        return;
      }

      const enabled = this.checked;
      const playerCount = parseInt($('#lobbyPlayerCount').text()) || 0;
      
      if (enabled && playerCount < 5) {
        this.checked = false;
        Swal.fire({
          icon: 'warning',
          title: 'ไม่สามารถเปิดได้',
          text: 'ต้องมีผู้เล่นอย่างน้อย 5 คนจึงจะเปิดโหมด 2 จอมบงการได้',
          background: '#1e1e1e',
          color: '#fff'
        });
        return;
      }
      
      socket.emit('toggleDualTraitorMode', { roomId: roomId, enabled: enabled });
      
      // อัปเดต badge ทันที
      const badge = document.getElementById('dualTraitorBadge');
      if (badge) {
        setElementHidden(badge, !enabled);
      }
      
      // แจ้งเตือน
      if (enabled) {
        Swal.fire({
          icon: 'success',
          title: '🔴🔴 เปิดโหมด 2 จอมบงการ!',
          text: 'เกมนี้จะมีจอมบงการ 2 คน',
          background: '#1e1e1e',
          color: '#fff',
          timer: 2000,
          showConfirmButton: false
        });
      }
    });

    function renderPlayers(payload) {
      const players = payload.players || [];
      const adminId = payload.admin;
      $('#lobbyPlayerCount').text(payload.playerCount || payload.onlineCount || players.filter(p => p.online).length);
      $('#lobbyRoomLock').text(payload.locked ? '🔒 ล็อค' : '🔓 เปิด');

      const $list = $('#lobbyPlayers');
      $list.empty();

      players.forEach(p => {
        const isAdminPlayer = p.playerId === adminId;
        const isSelf = p.playerId === playerId;
        const color = p.color || '#fff';
        const safeName = $('<div>').text(p.displayName || p.playerName).html();
        const onlineBadge = p.online === false
          ? '<span style="margin-left:6px; color:#e67e22; font-size:0.8em;">offline</span>'
          : '<span style="margin-left:6px; color:#2ecc71; font-size:0.8em;">online</span>';

        // สร้าง action icons สำหรับ admin (ไม่แสดงสำหรับตัวเอง)
        let actionIcons = '';
        if (isAdmin && !isSelf) {
          actionIcons = `
            <div class="player-action-icons">
              ${!isAdminPlayer ? `<button class="player-action-btn crown-btn" data-player-id="${p.playerId}" data-player-name="${safeName}" title="โอนสิทธิ์ Admin">👑</button>` : ''}
              <button class="player-action-btn kick-btn" data-player-id="${p.playerId}" data-player-name="${safeName}" title="เตะผู้เล่น">🚫</button>
            </div>
          `;
        }

        const $row = $(`
          <div class="lobby-player-item">
            <div class="lobby-player-main">
              <span class="lobby-player-avatar clickable-avatar" data-player-id="${p.playerId}" style="cursor:pointer; margin-right:6px;" title="ดูโปรไฟล์">${window.renderPlayerAvatar({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: color, playerName: p.playerName }, { size: 30 })}</span>
              <span class="lobby-player-name" style="color:${color};">${safeName}</span>
              ${onlineBadge}
              ${isAdminPlayer ? '<span class="lobby-player-admin-badge" style="margin-left:6px;">👑</span>' : ''}
              ${p.isSiteAdmin ? '<span class="status-badge status-banned" style="margin-left:6px;">[Admin]</span>' : ''}
            </div>
            ${actionIcons}
          </div>
        `);
        $list.append($row);
      });

      updateStartButtonState(players);
    }

    socket.on('roomUpdate', function (payload) {
      // รับทุก roomUpdate ที่มาจากห้องนี้ (ไม่ต้องเช็ค roomId เพราะ socket.io จัดการให้แล้ว)
      if (!payload) return;
      console.log('[roomUpdate]', payload);
      latestRoomPayload = payload;
      updateLobbyModeUI(payload);
      
      // อัปเดตสถานะ admin ถ้า payload มีข้อมูล admin
      if (payload.admin) {
        const wasAdmin = isAdmin;
        isAdmin = payload.admin === playerId;
        // ถ้าสถานะ admin เปลี่ยน ให้อัปเดต UI
        if (wasAdmin !== isAdmin) {
          updateAdminUI();
        }
      }
      
      // อัปเดต dual traitor badge
      if (payload.settings) {
        const badge = document.getElementById('dualTraitorBadge');
        if (badge) {
          setElementHidden(badge, !(currentGameMode === 'insider' && payload.settings.dualTraitorMode));
        }
        // อัปเดต quick toggle ถ้ามี
        const quickToggle = document.getElementById('quickDualTraitorToggle');
        if (quickToggle) {
          quickToggle.checked = payload.settings.dualTraitorMode;
        }
      }
      
      // แสดง/ซ่อน dual traitor quick toggle ตามจำนวนผู้เล่น
      const playerCount = (payload.players || []).length;
      updateDualTraitorToggleVisibility(playerCount);
      
      renderPlayers(payload);
      const addBotsBtn = document.getElementById('btnBlackMarketAddBots');
      if (addBotsBtn && $(addBotsBtn).data('loading') && (payload.players || []).length > 1) {
        $(addBotsBtn).data('loading', false);
        refreshAddBotsButton(resolveGameModeFromPayload(payload));
      }
    });

    if (initialRoomPayload) {
      latestRoomPayload = initialRoomPayload;
      updateLobbyModeUI(initialRoomPayload);
      renderPlayers(initialRoomPayload);
    }

    // ===== Socket init =====
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId: roomId, playerId: playerId });
    socket.emit('requestRoomUpdate', { roomId: roomId });

    // หมายเหตุ: socket.io v4 ไม่ยิง 'reconnect' บนตัว socket — ใช้ 'connect' ซึ่งยิงทุกครั้งแทน
    socket.on('connect', function() {
      console.log('[roomLobby] Socket connected');
      socket.emit('initPlayer', playerId);
      socket.emit('setRoom', { roomId: roomId, playerId: playerId });
      socket.emit('requestRoomUpdate', { roomId: roomId });
    });

    socket.on('connect_error', function(err) {
      console.error('[roomLobby] Socket connect error:', err.message);
    });

    // ถูกเตะออกจากห้อง
    socket.on('kickedFromRoom', function(data) {
      allowNavigation = true; // ไม่ต้องถามยืนยัน
      Swal.fire({
        icon: 'error',
        title: 'ถูกเตะออกจากห้อง',
        text: data.message || 'คุณถูกเตะออกจากห้องนี้',
        background: '#1e1e1e',
        color: '#fff',
        confirmButtonText: 'ตกลง',
        allowOutsideClick: false,
        allowEscapeKey: false
      }).then(() => {
        window.location.href = '/rooms?playerId=' + playerId;
      });
    });

    // ห้องถูกปิด
    socket.on('roomClosed', function(data) {
      allowNavigation = true;
      Swal.fire({
        icon: 'warning',
        title: 'ห้องถูกปิด',
        text: data.message || 'ห้องนี้ถูกปิดไปแล้ว',
        background: '#1e1e1e',
        color: '#fff',
        confirmButtonText: 'ตกลง',
        allowOutsideClick: false,
        allowEscapeKey: false
      }).then(() => {
        window.location.href = '/rooms?playerId=' + playerId;
      });
    });

    // ได้รับ/โอน admin
    socket.on('adminTransferred', function(data) {
      console.log('[adminTransferred]', data, 'myPlayerId:', playerId);
      
      // ถ้าผมได้รับ admin ใหม่
      if (data.newAdminId === playerId) {
        Swal.fire({
          icon: 'success',
          title: '👑 คุณได้รับสิทธิ์ Admin แล้ว!',
          text: 'คุณเป็น Admin ของห้องนี้แล้ว',
          background: '#1e1e1e',
          color: '#fff',
          timer: 3000,
          timerProgressBar: true,
          showConfirmButton: false
        });
        // Update local admin status
        isAdmin = true;
        console.log('[adminTransferred] Set isAdmin = true');
        // Show admin controls without reload
        setElementHidden('#btnStartGameLobby', false);
        setElementHidden('#adminControlsSection', false);
        if (latestRoomPayload) {
          latestRoomPayload.admin = data.newAdminId;
          renderPlayers(latestRoomPayload);
        }
        // Re-request room update to re-render player list with admin icons
        // ใช้ setTimeout เล็กน้อยเพื่อให้แน่ใจว่า roomUpdate ได้ถูกประมวลผลก่อน
        setTimeout(function() {
          socket.emit('requestRoomUpdate', { roomId: roomId });
        }, 100);
      } else if (data.oldAdminId === playerId) {
        // ถ้าผมเคยเป็น admin แล้วถูกโอน
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'info',
          title: 'สิทธิ์ Admin ถูกโอนไปแล้ว',
          background: '#1e1e1e',
          color: '#fff',
          timer: 2500,
          showConfirmButton: false
        });
        isAdmin = false;
        console.log('[adminTransferred] Set isAdmin = false');
        setElementHidden('#btnStartGameLobby', true);
        setElementHidden('#adminControlsSection', true);
        if (latestRoomPayload) {
          latestRoomPayload.admin = data.newAdminId;
          renderPlayers(latestRoomPayload);
        }
        setTimeout(function() {
          socket.emit('requestRoomUpdate', { roomId: roomId });
        }, 100);
      } else {
        // คนอื่นๆ รับรู้ว่า admin เปลี่ยนแล้ว (ไม่ต้อง reload)
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'info',
          title: data.message || 'สิทธิ์ Admin เปลี่ยนแปลงแล้ว',
          background: '#1e1e1e',
          color: '#fff',
          timer: 2500,
          showConfirmButton: false
        });
        if (latestRoomPayload) {
          latestRoomPayload.admin = data.newAdminId;
          renderPlayers(latestRoomPayload);
        }
      }
    });

    // ===== Chat =====
    const myPlayerName = '<%= player.name %>';
    const myPlayerColor = '<%= playerInfo.color %>';
    
    // Sound notification function
    function soundNotify(type) {
      let audio;
      switch(type) {
        case 'popup':
          audio = new Audio('/static/sound/popup.mp3');
          break;
        default:
          audio = new Audio('/static/sound/popup.mp3');
      }
      audio.play().catch(e => { /* Browser may block autoplay */ });
    }
    
    function appendChatMessage(data) {
      const $area = $('#lobbyChatMessages');
      const safeName = $('<div>').text(data.displayName || data.playerName).html();
      const safeMsg = $('<div>').text(data.message).html();
      const timestamp = data.timestamp || '';
      const playerColor = data.color || '#fff';
      const avatar = data.avatar || '👤';
      const targetPlayerId = data.playerId || '';
      
      // Determine message type
      let msgClass = 'other-msg';
      if (data.playerName === 'System') {
        msgClass = 'system-msg';
      } else if ((data.playerId && data.playerId === playerId) || data.playerName === myPlayerName) {
        msgClass = 'my-msg';
      }
      
      let $msg;
      if (msgClass === 'system-msg') {
        // System message - centered
        $msg = $(`
          <div class="chat-msg ${msgClass}">
            <div class="chat-msg-bubble">
              <div class="chat-msg-text">🔔 ${safeMsg}</div>
            </div>
            <div class="chat-msg-meta">${timestamp}</div>
          </div>
        `);
      } else {
        // Player message - with avatar
        $msg = $(`
          <div class="chat-msg ${msgClass}">
            <div class="chat-avatar clickable-avatar" data-player-id="${targetPlayerId}" title="ดูโปรไฟล์ ${safeName}">${window.renderPlayerAvatar({ avatar: avatar, avatarFrame: data.avatarFrame, color: playerColor, playerName: safeName }, { size: 34 })}</div>
            <div class="chat-content">
              <div class="chat-msg-bubble" style="border-left: 3px solid ${playerColor};">
                <div class="chat-msg-name clickable-avatar" data-player-id="${targetPlayerId}" style="color:${playerColor};">${safeName}</div>
                <div class="chat-msg-text">${safeMsg}</div>
              </div>
              <div class="chat-msg-meta">${timestamp}</div>
            </div>
          </div>
        `);
      }
      
      $area.append($msg);
      trimLobbyChat($area[0]);
      $area[0].scrollTop = $area[0].scrollHeight;
    }

    // แชทยาวๆ เคยสะสมใน DOM ไม่จำกัด (วัดได้ 1,000 ข้อความ = 9,000 element, scroll 90,000px)
    // server เก็บย้อนหลังแค่ 100 ข้อความ เก็บบนจอ 200 จึงเกินพอ — ตรงกับ chatPanel.js ของกระดาน
    const MAX_LOBBY_CHAT = 200;
    function trimLobbyChat(area) {
      if (!area || area.children.length <= MAX_LOBBY_CHAT) return;
      const before = area.scrollHeight;
      while (area.children.length > MAX_LOBBY_CHAT) {
        area.removeChild(area.firstElementChild);
      }
      // ตัดจากด้านบนทำให้ความสูงหาย ถ้ามีคนกำลังอ่านย้อนอยู่ต้องเลื่อนชดเชยไม่ให้ข้อความกระโดด
      const shrank = before - area.scrollHeight;
      if (shrank > 0) area.scrollTop = Math.max(0, area.scrollTop - shrank);
    }

    $('#btnSendLobbyChat').on('click', function () {
      const $input = $('#lobbyChatInput');
      const msg = $input.val().trim();
      if (!msg) return;
      socket.emit('sendMessage', {
        message: msg,
        playerName: '<%= player.name %>'
      });
      $input.val('');
    });

    $('#lobbyChatInput').on('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        $('#btnSendLobbyChat').click();
      }
    });

    socket.on('newMessage', function (data) {
      appendChatMessage(data);
      // Play notification sound if message is not from me
      if ((!data.playerId || data.playerId !== playerId) && data.playerName !== myPlayerName) {
        soundNotify('popup');
      }
    });

    socket.on('chatHistory', function (entries) {
      const $area = $('#lobbyChatMessages');
      $area.empty();
      (entries || []).forEach(function (entry) {
        appendChatMessage(entry);
      });
    });
    socket.emit('requestChatHistory', { roomId: roomId });

    // รับ broadcast จากระบบ (Admin)
    socket.on('systemBroadcast', function(data) {
      Swal.fire({
        icon: 'info',
        title: '📢 ประกาศจากระบบ',
        text: data.message,
        background: '#1e1e1e',
        color: '#fff',
        confirmButtonColor: '#e74c3c'
      });
      // Also show in chat
      appendChatMessage({
        playerName: 'System',
        message: '📢 ' + data.message,
        timestamp: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })
      });
    });

    // ถูกแบน
    socket.on('banned', function(data) {
      allowNavigation = true; // ไม่ต้องถามยืนยัน
      Swal.fire({
        icon: 'error',
        title: '🚫 คุณถูกแบน!',
        html: `<p><strong>เหตุผล:</strong> ${data.reason}</p><p><strong>ระยะเวลา:</strong> ${data.durationHours === null ? 'ถาวร' : data.durationHours + ' ชั่วโมง'}</p>`,
        confirmButtonText: 'ตกลง',
        background: '#1e1e1e',
        color: '#fff',
        allowOutsideClick: false
      }).then(() => {
        window.location.href = '/banned?playerId=' + playerId;
      });
    });

    // วิธีเล่น — ทุกคนในห้องกดได้ (ไม่จำกัดแค่ admin)
    $('#btnBlackMarketHowTo').on('click', function() {
      showBlackMarketLobbyGuide();
    });

    $('#btnSpyfallHowTo').on('click', function() {
      showSpyfallLobbyGuide();
    });

    $('#btnCoupHowTo').on('click', function() {
      showCoupLobbyGuide();
    });

    $('#btnLiarHowTo').on('click', function() {
      showLiarLobbyGuide();
    });

    $(document).on('click', '#btnPokerHowTo', function(event) {
      event.preventDefault();
      event.stopPropagation();
      const mode = resolveGameModeFromPayload(latestRoomPayload) || normalizeLobbyGameMode(currentGameMode);
      showPokerLobbyGuide(mode);
    });

    $(document).on('click', '#btnBlackMarketAddBots', function() {
      const btn = $(this);
      if (btn.data('loading')) return;
      const mode = resolveGameModeFromPayload(latestRoomPayload) || normalizeLobbyGameMode(currentGameMode);
      const isPoker = mode === 'poker5' || mode === 'poker4'
        || !!(document.getElementById('btnPokerHowTo') && !document.getElementById('btnPokerHowTo').classList.contains('is-hidden'));
      const eventName = isPoker ? 'poker_addBots' : 'blackmarket_addBots';
      const idleLabel = isPoker ? '🤖 เพิ่มบอท' : '🤖 เติมบอทเพื่อทดสอบ';
      let settled = false;
      function finish(res) {
        if (settled) return;
        settled = true;
        btn.data('loading', false);
        btn.text(idleLabel);
        if (res && res.success) return;
        Swal.fire({
          icon: 'error',
          title: 'เพิ่มบอทไม่สำเร็จ',
          text: res && res.error ? res.error : 'เกิดข้อผิดพลาด',
          background: '#1e1e1e',
          color: '#fff'
        });
      }
      btn.data('loading', true);
      btn.text('🤖 กำลังเพิ่มบอท...');
      const timer = setTimeout(function() {
        finish({ success: false, error: 'เซิร์ฟเวอร์ไม่ตอบ ลองรีเฟรชหน้าแล้วกดใหม่' });
      }, 8000);
      socket.emit(eventName, { roomId: roomId, count: 1 }, function(res) {
        clearTimeout(timer);
        finish(res);
      });
    });

    $(document).on('click', '.bm-lobby-tab-btn', function() {
      const tab = $(this).data('tab');
      $('.bm-lobby-tab-btn').removeClass('active').css({ 'background': 'transparent', 'color': '#aaa' });
      $(this).addClass('active').css({ 'background': 'rgba(255,255,255,0.1)', 'color': '#fff' });
      if (tab === 'rules') {
        $('#bm-lobby-tab-rules-content').show();
        $('#bm-lobby-tab-example-content').hide();
      } else {
        $('#bm-lobby-tab-rules-content').hide();
        $('#bm-lobby-tab-example-content').show();
      }
    });

    // ===== Admin actions =====
    if (isAdmin) {
      // Kick player via icon
      $(document).on('click', '.kick-btn', function () {
        const target = $(this).data('player-id');
        const playerName = $(this).data('player-name');
        
        Swal.fire({
          icon: 'warning',
          title: 'เตะผู้เล่น',
          text: `ต้องการเตะ ${playerName} ออกจากห้องหรือไม่?`,
          background: '#1e1e1e',
          color: '#fff',
          showCancelButton: true,
          confirmButtonColor: '#e74c3c',
          cancelButtonColor: '#555',
          confirmButtonText: 'เตะ',
          cancelButtonText: 'ยกเลิก'
        }).then((result) => {
          if (result.isConfirmed) {
            socket.emit('kickPlayer', { targetPlayerId: target }, function (res) {
              if (!res || !res.success) {
                Swal.fire({
                  icon: 'error',
                  title: 'เตะผู้เล่นไม่สำเร็จ',
                  text: res && res.error ? res.error : '',
                  background: '#1e1e1e',
                  color: '#fff'
                });
              }
            });
          }
        });
      });

      // Transfer admin via icon
      $(document).on('click', '.crown-btn', function () {
        const target = $(this).data('player-id');
        const playerName = $(this).data('player-name');
        
        Swal.fire({
          icon: 'question',
          title: 'โอนสิทธิ์ Admin',
          text: `ต้องการให้ ${playerName} เป็น Admin หรือไม่?`,
          background: '#1e1e1e',
          color: '#fff',
          showCancelButton: true,
          confirmButtonColor: '#f39c12',
          cancelButtonColor: '#555',
          confirmButtonText: 'โอนสิทธิ์',
          cancelButtonText: 'ยกเลิก'
        }).then((result) => {
          if (result.isConfirmed) {
            socket.emit('transferAdmin', { newAdminPlayerId: target }, function (res) {
              if (!res || !res.success) {
                Swal.fire({
                  icon: 'error',
                  title: 'โอนสิทธิไม่สำเร็จ',
                  text: res && res.error ? res.error : '',
                  background: '#1e1e1e',
                  color: '#fff'
                });
              }
              // Success handled by adminTransferred event
            });
          }
        });
      });

      $('#btnEditRoom').on('click', function () {
        const roomSettings = latestRoomPayload && latestRoomPayload.settings ? latestRoomPayload.settings : {
          maxPlayers: <%= room.maxPlayers %>,
          roundTime: <%= room.roundTime %>,
          locked: <%= room.locked ? 'true' : 'false' %>,
          password: '<%= room.password %>',
          dualTraitorMode: <%= room.dualTraitorMode ? 'true' : 'false' %>,
          werewolfRoles: currentWerewolfRoles,
          wolfCount: 2,
          gameMode: currentGameMode
        };
        const activeMode = resolveGameModeFromPayload({
          settings: roomSettings,
          gameMode: roomSettings.gameMode || currentGameMode,
          roomName: (document.getElementById('roomTitleText') || {}).textContent || '<%= room.name %>'
        });
        const activeModeMeta = getModeMeta(activeMode);
        const currentMaxPlayers = Number(roomSettings.maxPlayers || <%= room.maxPlayers %>);
        const currentLocked = !!roomSettings.locked;
        const currentPassword = String(roomSettings.password || '');
        const currentWolfCount = Number(roomSettings.wolfCount) || 2;
        const isPokerLobby = activeMode === 'poker5' || activeMode === 'poker4';
        const isPoker4LobbyEdit = activeMode === 'poker4';
        const currentPokerTableType = roomSettings.pokerTableType === 'cash' ? 'cash' : 'fun';
        const currentPokerAnte = Math.max(100, Number(roomSettings.pokerAnte) || 500);
        
        Swal.fire({
          title: '⚙️ แก้ไขห้อง',
          customClass: {
            popup: 'room-popup',
            confirmButton: 'room-btn-confirm',
            cancelButton: 'room-btn-cancel'
          },
          html: `
            <div style="font-family: 'Rajdhani', sans-serif;">
              <div class="room-form-group">
                <label class="room-form-label">
                  <span class="icon">📝</span> ชื่อห้อง:
                </label>
                <input id="editRoomName" class="room-form-input" value="<%= room.name %>" placeholder="ไม่กรอกก็ใช้ชื่อเดิม" maxlength="20">
                <div style="margin-top:8px; color:#aaa; font-size:0.9em;">ถ้าไม่เปลี่ยนชื่อ ปล่อยไว้ได้เลย</div>
              </div>
              
              <div class="room-form-group">
                <label class="room-form-label">
                  <span class="icon">👥</span> จำนวนผู้เล่นสูงสุด:
                </label>
                <div class="room-slider-container">
                  <span class="room-slider-value" id="editMaxPlayersValue">${currentMaxPlayers}</span>
                  <input type="range" id="editMaxPlayers" class="room-slider" min="${activeModeMeta.minPlayers}" max="${activeModeMeta.maxPlayers || 10}" value="${Math.min(Number(activeModeMeta.maxPlayers || 10), Number(currentMaxPlayers))}">
                </div>
              </div>
              
              <div class="room-form-group" id="editWerewolfRolesGroup" style="display: ${activeMode === 'werewolf' ? 'block' : 'none'};">
                <label class="room-form-label">
                  <span class="icon">🐺</span> จำนวนหมาป่า:
                </label>
                <div id="editWolfCountSelector" style="display:flex; gap:8px; margin-top:4px;">
                  ${[1,2,3].map(n => {
                    const isActive = (currentWolfCount || 2) === n;
                    return `<button type="button" data-wolf-count="${n}" class="wolf-count-btn${isActive ? ' active' : ''}" style="flex:1; padding:10px 0; border-radius:10px; border:2px solid ${isActive ? '#e74c3c' : 'rgba(255,255,255,0.12)'}; background:${isActive ? 'rgba(231,76,60,0.2)' : 'rgba(255,255,255,0.04)'}; color:#fff; font-size:1.1em; cursor:pointer; font-family:Rajdhani,sans-serif; font-weight:700;">🐺 ${n} ตัว</button>`;
                  }).join('')}
                </div>
                <div style="margin-top:8px; color:#aaa; font-size:0.82em;">บทบาทอื่นสุ่มให้อัตโนมัติทั้งหมด และเวลาในเกมถูกล็อกเป็น กลางคืน 1 นาที / ประชุม 3 นาที / โหวต 1 นาที</div>
              </div>
              
              <div class="room-form-group" id="editPokerTableGroup" style="display: ${isPokerLobby ? 'block' : 'none'};">
                <label class="room-form-label">
                  <span class="icon">${isPoker4LobbyEdit ? '♦' : '♠'}</span> แบบเล่น:
                </label>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                  <label style="flex:1; min-width:140px; display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:10px; border:2px solid ${currentPokerTableType === 'fun' ? 'rgba(34,197,94,0.45)' : 'rgba(255,255,255,0.12)'}; background:${currentPokerTableType === 'fun' ? 'rgba(34,197,94,0.08)' : 'rgba(255,255,255,0.04)'}; cursor:pointer; color:#fff;">
                    <input type="radio" name="editPokerTableType" value="fun" ${currentPokerTableType === 'fun' ? 'checked' : ''} style="accent-color:#22c55e;">
                    <span>เล่นสนุก — ตาใหม่ชิปกลับมาเต็ม</span>
                  </label>
                  <label style="flex:1; min-width:140px; display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:10px; border:2px solid ${currentPokerTableType === 'cash' ? 'rgba(245,200,107,0.45)' : 'rgba(255,255,255,0.12)'}; background:${currentPokerTableType === 'cash' ? 'rgba(245,200,107,0.08)' : 'rgba(255,255,255,0.04)'}; cursor:pointer; color:#ddd;">
                    <input type="radio" name="editPokerTableType" value="cash" ${currentPokerTableType === 'cash' ? 'checked' : ''} style="accent-color:#f5c86b;">
                    <span>เล่นเก็บชิป — ใช้ชิปในบัญชี</span>
                  </label>
                </div>
                <div style="margin-top:10px;">
                  <label class="room-form-label"><span class="icon">🪙</span> วางกองก่อนแจก:</label>
                  <div class="room-slider-container">
                    <span class="room-slider-value" id="editPokerAnteValue">${currentPokerAnte}</span>
                    <input type="range" id="editPokerAnte" class="room-slider" min="100" max="2000" step="100" value="${currentPokerAnte}">
                  </div>
                </div>
                <div style="margin-top:10px; color:#9ca89a; font-size:0.85em; line-height:1.4;">${isPoker4LobbyEdit ? 'ทิ้ง 2 ลงชิปรอบนึง แล้วได้ใบที่ 3 หงายให้ดู · หมอบไม่ได้ใบที่ 3 · ' : 'ทิ้ง 2 ลงชิปรอบนึง แล้วเปิด 3 ใบเทียบ · '}อยากมีคนเล่นเพิ่ม กด <strong style="color:#a7f3d0;">🤖 เพิ่มบอท</strong> ข้างปุ่มแก้ไขห้อง</div>
              </div>
              
              <div class="room-form-group">
                <label class="room-form-label">
                  <span class="icon">🔐</span> ความปลอดภัย:
                </label>
                <div class="room-checkbox-container ${currentLocked ? 'checked' : ''}" id="editLockedContainer">
                  <input type="checkbox" id="editLocked" class="room-checkbox" ${currentLocked ? 'checked' : ''}>
                  <div class="room-checkbox-custom">✓</div>
                  <span class="room-checkbox-text">🔒 ล็อคห้อง (ต้องใช้รหัสผ่าน)</span>
                </div>
              </div>
              
              <div class="room-form-group" id="editPasswordGroup" style="display: ${currentLocked ? 'block' : 'none'};">
                <label class="room-form-label">
                  <span class="icon">🔑</span> รหัสผ่าน:
                </label>
                <input id="editPassword" class="room-form-input" placeholder="รหัสผ่าน 4 หลัก" maxlength="4" pattern="[0-9]*" inputmode="numeric" value="${currentPassword}">
              </div>
            </div>
          `,
          background: 'transparent',
          showCancelButton: true,
          confirmButtonText: '✅ บันทึก',
          cancelButtonText: '❌ ยกเลิก',
          focusConfirm: false,
          didOpen: () => {
            // Slider handlers
            const maxPlayersSlider = document.getElementById('editMaxPlayers');
            const maxPlayersValue = document.getElementById('editMaxPlayersValue');
            const wolfCountSelector = document.getElementById('editWolfCountSelector');
            const editPokerAnte = document.getElementById('editPokerAnte');
            const editPokerAnteValue = document.getElementById('editPokerAnteValue');
            
            maxPlayersSlider.addEventListener('input', function() {
              maxPlayersValue.textContent = this.value;
              updateSliderBackground(this);
            });
            
            function updateSliderBackground(slider) {
              const percent = ((slider.value - slider.min) / (slider.max - slider.min)) * 100;
              slider.style.background = `linear-gradient(90deg, #e74c3c 0%, #e74c3c ${percent}%, #333 ${percent}%, #333 100%)`;
            }

            const modeMeta = getModeMeta(activeMode);
            const modeMaxPlayers = Number(modeMeta.maxPlayers || 10);
            maxPlayersSlider.min = String(modeMeta.minPlayers);
            maxPlayersSlider.max = String(modeMaxPlayers);
            if (Number(maxPlayersSlider.value) < modeMeta.minPlayers) {
              maxPlayersSlider.value = String(modeMeta.minPlayers);
            }
            if (Number(maxPlayersSlider.value) > modeMaxPlayers) {
              maxPlayersSlider.value = String(modeMaxPlayers);
            }
            maxPlayersValue.textContent = maxPlayersSlider.value;
            
            updateSliderBackground(maxPlayersSlider);
            if (editPokerAnte && editPokerAnteValue) {
              editPokerAnte.addEventListener('input', function() {
                editPokerAnteValue.textContent = this.value;
                updateSliderBackground(this);
              });
              updateSliderBackground(editPokerAnte);
            }

            // Wolf count selector handler
            if (wolfCountSelector) {
              wolfCountSelector.addEventListener('click', function(event) {
                const btn = event.target.closest('.wolf-count-btn');
                if (!btn) return;
                wolfCountSelector.querySelectorAll('.wolf-count-btn').forEach(b => {
                  const active = b === btn;
                  b.classList.toggle('active', active);
                  b.style.borderColor = active ? '#e74c3c' : 'rgba(255,255,255,0.12)';
                  b.style.background = active ? 'rgba(231,76,60,0.2)' : 'rgba(255,255,255,0.04)';
                });
              });
            }
            
            // Dual Traitor checkbox handler
            const dualTraitorContainer = document.getElementById('editDualTraitorContainer');
            const dualTraitorCheckbox = document.getElementById('editDualTraitor');
            
            if (dualTraitorContainer && !dualTraitorContainer.classList.contains('disabled')) {
              dualTraitorContainer.addEventListener('click', function() {
                dualTraitorCheckbox.checked = !dualTraitorCheckbox.checked;
                this.classList.toggle('checked', dualTraitorCheckbox.checked);
              });
            }
            
            // Lock checkbox handler
            const lockedContainer = document.getElementById('editLockedContainer');
            const lockedCheckbox = document.getElementById('editLocked');
            const passwordGroup = document.getElementById('editPasswordGroup');
            
            lockedContainer.addEventListener('click', function() {
              lockedCheckbox.checked = !lockedCheckbox.checked;
              this.classList.toggle('checked', lockedCheckbox.checked);
              passwordGroup.style.display = lockedCheckbox.checked ? 'block' : 'none';
              if (!lockedCheckbox.checked) {
                document.getElementById('editPassword').value = '';
              }
            });
          },
          preConfirm: () => {
            const name = document.getElementById('editRoomName').value.trim() || '<%= room.name %>';
            const maxPlayers = parseInt(document.getElementById('editMaxPlayers').value, 10);
            const locked = document.getElementById('editLocked').checked;
            const password = document.getElementById('editPassword').value.trim();
            const activeWolfBtn = document.querySelector('#editWolfCountSelector .wolf-count-btn.active');
            const wolfCount = activeWolfBtn ? parseInt(activeWolfBtn.dataset.wolfCount, 10) : null;
            const pokerTableType = (document.querySelector('input[name="editPokerTableType"]:checked') || {}).value || 'fun';
            const pokerAnte = parseInt((document.getElementById('editPokerAnte') || {}).value, 10) || 500;
            
            if (locked && (!password || !/^\d{4}$/.test(password))) {
              Swal.showValidationMessage('กรุณากรอกรหัสผ่าน 4 หลัก (ตัวเลขเท่านั้น)');
              return false;
            }
            
            return {
              name,
              maxPlayers,
              wolfCount,
              locked,
              password: locked ? password : '',
              pokerTableType: isPokerLobby ? pokerTableType : undefined,
              pokerAnte: isPokerLobby ? pokerAnte : undefined
            };
          }
        }).then(result => {
          if (result.isConfirmed && result.value) {
            socket.emit('updateRoom', result.value, function (res) {
              if (!res || !res.success) {
                Swal.fire({
                  icon: 'error',
                  title: 'แก้ไขห้องไม่สำเร็จ',
                  text: res && res.error ? res.error : '',
                  background: '#1e1e1e',
                  color: '#fff'
                });
              } else {
                Swal.fire({
                  icon: 'success',
                  title: 'บันทึกสำเร็จ',
                  background: '#1e1e1e',
                  color: '#fff',
                  timer: 1500,
                  showConfirmButton: false
                }).then(() => {
                  window.location.reload();
                });
              }
            });
          }
        });
      });

      $('#btnStartGameLobby').on('click', function () {
        const btn = $(this);
        if (btn.data('loading')) return;
        btn.data('loading', true);
        btn.text('กำลังเริ่มเกม...');
        socket.emit('startGameFromLobby', { roomId: roomId }, function(res) {
          btn.data('loading', false);
          if (!res || !res.success) {
            btn.text(getModeMeta(currentGameMode).startLabel);
            Swal.fire({
              icon: 'error',
              title: 'เริ่มเกมไม่สำเร็จ',
              text: res && res.error ? res.error : 'เกิดข้อผิดพลาด',
              background: '#1e1e1e',
              color: '#fff'
            });
          }
          // ไม่ต้อง redirect ที่นี่ รอให้ server ส่ง event 'gameStarting' แทน
        });
      });
    }

    // รับ event countdown ก่อนเริ่มเกม (รอผู้เล่นทุกคน sync)
    socket.on('gameStartingCountdown', function(data) {
      console.log('[gameStartingCountdown] Game starting in', data.countdown, 'seconds');
      let countdown = data.countdown;
      
      Swal.fire({
        icon: 'info',
        title: '🎮 เกมกำลังจะเริ่ม!',
        html: '<div style="font-size: 3em; font-weight: bold;" id="startCountdown">' + countdown + '</div>',
        showConfirmButton: false,
        allowOutsideClick: false,
        background: '#1e1e1e',
        color: '#fff'
      });
      
      const countdownInterval = setInterval(() => {
        countdown--;
        const el = document.getElementById('startCountdown');
        if (el) el.textContent = countdown;
        if (countdown <= 0) {
          clearInterval(countdownInterval);
        }
      }, 1000);
    });
    
    // ถ้าเริ่มเกมไม่ได้ (ผู้เล่นไม่ครบ)
    socket.on('gameStartCancelled', function(data) {
      console.log('[gameStartCancelled]', data.error);
      Swal.fire({
        icon: 'error',
        title: 'เริ่มเกมไม่สำเร็จ',
        text: data.error || 'เกิดข้อผิดพลาด',
        background: '#1e1e1e',
        color: '#fff'
      });
    });

    // รับ event จาก server ว่าเกมเริ่มแล้ว → redirect ทุกคนพร้อมกัน
    socket.on('gameStarting', function(data) {
      console.log('[gameStarting] Redirecting to game...');
      Swal.fire({
        icon: 'success',
        title: 'เกมเริ่มแล้ว!',
        text: 'กำลังเข้าสู่เกม...',
        timer: 1000,
        showConfirmButton: false,
        background: '#1e1e1e',
        color: '#fff'
      }).then(() => {
        allowNavigation = true; // อนุญาต navigate โดยไม่ถาม
        window.location.href = `/game/${data.roomId}?playerId=${playerId}`;
      });
      // Fallback redirect
      setTimeout(() => {
        allowNavigation = true;
        window.location.href = `/game/${data.roomId}?playerId=${playerId}`;
      }, 1100);
    });

    // ปุ่มดูบทบาท Werewolf
    $('#btnViewRolesLobby').on('click', function() {
      const teamOrder = { werewolf: 0, village: 1, solo: 2 };
      const teamHeader = { werewolf: '🐺 ฝั่งหมาป่า', village: '🏡 ฝั่งชาวบ้าน', solo: '🎭 บทเดี่ยว' };
      const sorted = [...werewolfRoleOptions].sort((a, b) => {
        const oa = teamOrder[a.team] ?? 9;
        const ob = teamOrder[b.team] ?? 9;
        if (oa !== ob) return oa - ob;
        return String(a.thaiName || '').localeCompare(String(b.thaiName || ''), 'th');
      });
      let html = '<div style="text-align:left; max-height:65vh; overflow-y:auto; padding-right:8px; display:grid; gap:12px;">';
      let lastTeam = null;
      sorted.forEach(role => {
        if (role.team !== lastTeam) {
          lastTeam = role.team;
          html += `<div style="font-weight:800; margin:4px 0 0; color:#fde68a; font-size:0.95em;">${teamHeader[role.team] || role.team}</div>`;
        }
        const visual = werewolfRoleVisuals[role.id] || { emoji: '🎭', teamLabel: 'พิเศษ' };
        let teamColor = '#f39c12';
        if (role.team === 'werewolf') teamColor = '#e74c3c';
        else if (role.team === 'village') teamColor = '#3498db';
        else if (role.team === 'solo') teamColor = '#9b59b6';
        const winHtml = role.winCondition
          ? `<div style="font-size:0.82em; color:#a5b4fc; line-height:1.35; margin-top:6px;">🏁 ${role.winCondition}</div>`
          : '';
        html += `
          <div style="background:rgba(255,255,255,0.05); border-left: 4px solid ${teamColor}; border-radius:8px; padding:12px;">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
              <span style="font-size:1.5em;">${visual.emoji}</span>
              <strong style="font-size:1.1em; color:#fff;">${role.thaiName}</strong>
              <span style="font-size:0.8em; color:#aaa; margin-left:auto;">${visual.teamLabel}</span>
            </div>
            <div style="font-size:0.9em; color:#ddd; line-height:1.4;">${role.description}</div>
            ${winHtml}
          </div>
        `;
      });
      html += '</div>';

      Swal.fire({
        title: '🎭 บทบาทในเกม',
        html: html,
        background: '#1a1a1a',
        color: '#fff',
        confirmButtonText: 'ปิด',
        confirmButtonColor: '#333',
        width: '500px',
        customClass: {
          popup: 'swal-dark-theme'
        }
      });
    });

    // ปุ่มออกห้อง - emit leaveRoom แล้วรอ callback ก่อน redirect
    $('#btnLeaveRoom').on('click', function() {
      Swal.fire({
        icon: 'question',
        title: 'ออกจากห้อง?',
        text: 'คุณต้องการออกจากห้องนี้หรือไม่?',
        background: '#1e1e1e',
        color: '#fff',
        showCancelButton: true,
        confirmButtonColor: '#e74c3c',
        cancelButtonColor: '#555',
        confirmButtonText: 'ออกจากห้อง',
        cancelButtonText: 'ยกเลิก'
      }).then((result) => {
        if (result.isConfirmed) {
          // แสดง loading
          Swal.fire({
            title: 'กำลังออกจากห้อง...',
            allowOutsideClick: false,
            showConfirmButton: false,
            background: '#1e1e1e',
            color: '#fff',
            didOpen: () => { Swal.showLoading(); }
          });
          
          // emit leaveRoom พร้อม callback
          socket.emit('leaveRoom', {}, function(response) {
            allowNavigation = true;
            window.location.href = '/rooms?playerId=' + playerId;
          });
          
          // Fallback: ถ้าไม่ได้รับ callback ใน 2 วินาที ให้ redirect เลย
          setTimeout(function() {
            allowNavigation = true;
            window.location.href = '/rooms?playerId=' + playerId;
          }, 2000);
        }
      });
    });

    // ทุกคนใน room รับ event นี้เมื่อเกมเริ่ม
    socket.on('gameStarted', function (data) {
      // เปลี่ยนไปหน้า board.ejs
      allowNavigation = true;
      window.location.href = '/game/' + roomId + '?playerId=' + playerId;
    });
    
    // กรอบมาจาก /static/js/playerAvatar.js แหล่งเดียว จะได้ไม่หลุดกันระหว่างหน้า
    const frameStyles = window.PlayerAvatar.FRAME_STYLES;
    
    // Click on avatar to view profile
    $(document).on('click', '.clickable-avatar', function() {
      const targetPlayerId = $(this).data('player-id');
      showPlayerProfile(targetPlayerId);
    });
    
    // Show player profile modal
    function showPlayerProfile(targetPlayerId) {
      $.get('/api/player/' + targetPlayerId + '/profile', function(data) {
        const frameStyle = frameStyles[data.avatarFrame] || 'none';
        const joinedDate = new Date(data.createdAt).toLocaleDateString('th-TH');
        const lastPlayed = data.stats?.lastPlayedAt ? new Date(data.stats.lastPlayedAt).toLocaleDateString('th-TH') : 'ยังไม่เคยเล่น';
        
        const stats = data.stats || { totalGames: 0, wins: 0, losses: 0, winRate: 0, roleStats: { gameMasterCount: 0, traitorCount: 0, citizenCount: 0 }, winByRole: { winAsTraitor: 0, winAsCitizen: 0 } };
        
        const html = `
          <div class="profile-modal-content">
            <div class="profile-modal-header">
              <div class="profile-modal-avatar">
                <div class="profile-modal-avatar-inner" style="background: ${data.color}20; border-color: ${data.color};">
                  ${data.avatar}
                </div>
                ${frameStyle !== 'none' ? '<div class="profile-modal-avatar-frame" style="background: ' + frameStyle + ';"></div>' : ''}
              </div>
              <div>
                <h2 class="profile-modal-name" style="color: ${data.color};">${$('<div>').text(data.playerName).html()}</h2>
                <p class="profile-modal-joined">เข้าร่วมเมื่อ: ${joinedDate}</p>
              </div>
            </div>
            
            <div class="profile-modal-stats">
              <div class="profile-stat-box">
                <div class="profile-stat-value" style="color: #3498db;">${stats.totalGames}</div>
                <div class="profile-stat-label">เกมที่เล่น</div>
              </div>
              <div class="profile-stat-box">
                <div class="profile-stat-value" style="color: #2ecc71;">${stats.wins}</div>
                <div class="profile-stat-label">ชนะ</div>
              </div>
              <div class="profile-stat-box">
                <div class="profile-stat-value" style="color: #f39c12;">${stats.winRate}%</div>
                <div class="profile-stat-label">Win Rate</div>
              </div>
            </div>
            
            <div class="profile-roles">
              <h4>🎭 สถิติบทบาท</h4>
              <div class="profile-role-row">
                <span>🟢 ผู้ดำเนินเกม</span>
                <span>${stats.roleStats.gameMasterCount} ครั้ง</span>
              </div>
              <div class="profile-role-row">
                <span>🔴 จอมบงการ</span>
                <span>${stats.roleStats.traitorCount} ครั้ง (ชนะ ${stats.winByRole.winAsTraitor})</span>
              </div>
              <div class="profile-role-row">
                <span>🔵 พลเมือง</span>
                <span>${stats.roleStats.citizenCount} ครั้ง (ชนะ ${stats.winByRole.winAsCitizen})</span>
              </div>
              <div class="profile-role-row">
                <span>🕐 เล่นล่าสุด</span>
                <span>${lastPlayed}</span>
              </div>
            </div>
          </div>
        `;
        
        Swal.fire({
          title: '',
          html: html,
          background: '#1a1a2e',
          color: '#fff',
          showConfirmButton: true,
          confirmButtonText: 'ปิด',
          confirmButtonColor: '#e74c3c',
          width: 400
        });
      }).fail(function() {
        Swal.fire({
          icon: 'error',
          title: 'ไม่พบข้อมูล',
          text: 'ไม่สามารถโหลดโปรไฟล์ได้',
          background: '#1e1e1e',
          color: '#fff',
          confirmButtonColor: '#e74c3c'
        });
      });
    }
  });

  // ปุ่ม ? สอนติดตั้ง PWA
  function showInstallGuide() {
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
    const isAndroid = /Android/.test(navigator.userAgent);
    
    let html = `
      <div style="text-align: left; font-family: 'Rajdhani', sans-serif;">
        <p style="color: #aaa; margin-bottom: 20px; text-align: center;">
          📱 ติดตั้งเกมนี้บนหน้าจอหลักเพื่อเล่นได้เร็วขึ้น!
        </p>
        
        <div style="margin-bottom: 24px;">
          <h3 style="color: #4CAF50; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 1.5em;">🤖</span> Android (Chrome)
          </h3>
          <ol style="color: #ddd; padding-left: 20px; line-height: 1.8;">
            <li>เปิดเว็บนี้ใน <b style="color: #fff;">Google Chrome</b></li>
            <li>กดปุ่ม <b style="color: #fff;">⋮</b> (เมนู 3 จุด) มุมขวาบน</li>
            <li>เลือก <b style="color: #4CAF50;">"เพิ่มไปหน้าจอหลัก"</b> หรือ <b style="color: #4CAF50;">"Install app"</b></li>
            <li>กด <b style="color: #fff;">"เพิ่ม"</b> เพื่อยืนยัน</li>
          </ol>
        </div>
        
        <div style="margin-bottom: 24px;">
          <h3 style="color: #007AFF; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 1.5em;">🍎</span> iPhone / iPad (Safari)
          </h3>
          <ol style="color: #ddd; padding-left: 20px; line-height: 1.8;">
            <li>เปิดเว็บนี้ใน <b style="color: #fff;">Safari</b> เท่านั้น</li>
            <li>กดปุ่ม <b style="color: #fff;">แชร์</b> <span style="background: #333; padding: 2px 8px; border-radius: 4px;">⬆️</span> ด้านล่าง</li>
            <li>เลื่อนหา <b style="color: #007AFF;">"เพิ่มไปยังหน้าจอโฮม"</b></li>
            <li>กด <b style="color: #fff;">"เพิ่ม"</b> มุมขวาบน</li>
          </ol>
        </div>
        
        <div style="background: #2a2a3e; padding: 12px 16px; border-radius: 10px; border-left: 4px solid #f39c12;">
          <p style="color: #f39c12; margin: 0; font-size: 0.9em;">
            💡 <b>แนะนำ:</b> ใช้ Chrome สำหรับ Android และ Safari สำหรับ iOS เพื่อประสบการณ์ที่ดีที่สุด
          </p>
        </div>
      </div>
    `;
    
    Swal.fire({
      title: '📲 วิธีติดตั้งแอป',
      html: html,
      background: '#1a1a2e',
      color: '#fff',
      showConfirmButton: true,
      confirmButtonText: 'เข้าใจแล้ว!',
      confirmButtonColor: '#e74c3c',
      width: 480,
      customClass: {
        popup: 'install-guide-popup'
      }
    });
  }
</script>


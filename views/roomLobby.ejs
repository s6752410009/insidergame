    const AVALON_TEAM_COUNTS = { 5: [3, 2], 6: [4, 2], 7: [4, 3], 8: [5, 3], 9: [6, 3], 10: [6, 4] };
    const AVALON_OPTIONAL = [
      { id: 'percival', name: 'เพอร์ซิวัล', team: 'good', hint: 'เห็นเมอร์ลิน+มอร์กานา' },
      { id: 'morgana', name: 'มอร์กานา', team: 'evil', hint: 'ปลอมเป็นเมอร์ลิน' },
      { id: 'mordred', name: 'มอร์เดรด', team: 'evil', hint: 'เมอร์ลินมองไม่เห็น' },

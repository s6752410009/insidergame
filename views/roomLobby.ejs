        const visual = werewolfRoleVisuals[role.id] || { emoji: '🎭', teamLabel: 'พิเศษ' };
        return `<span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; background:rgba(255,255,255,0.08); color:#fff; font-size:0.85em;">${visual.emoji} ${role.thaiName}</span>`;
      }).join('');

      if (!selectedRoles.length) {
        return '<div style="color:#f8d189; font-size:0.9em;">ยังไม่ได้ติ๊กบทพิเศษเพิ่ม ระบบจะเติมหมาป่าปกติให้เองถ้าจำเป็น</div>';

<%
  const lobbyNameCompact = String(room.name || '').replace(/[\s_-]+/g, '');
  const isPoker4Lobby = room.gameMode === 'poker4' || lobbyNameCompact === 'สี่ใบเก' || lobbyNameCompact === '4ใบเก';
  const isPoker5Lobby = room.gameMode === 'poker5' || lobbyNameCompact === 'ห้าใบเลือกสาม' || lobbyNameCompact === 'ไพ่5ใบ' || lobbyNameCompact === 'โป๊กเกอร์5ใบ';
  const isPokerLobbyRoom = isPoker4Lobby || isPoker5Lobby;
%>

<div class="room-lobby-container">
  <div class="room-lobby-shell">
    <div class="room-lobby-header">
      <div class="room-lobby-hero">
        <div id="roomModeKicker" class="room-kicker">🎩 ห้องเตรียมเกม</div>
        <div class="room-title">🎮 ห้อง: <span id="roomTitleText"><%= room.name %></span></div>
        <div id="lobbySpotlight" class="lobby-spotlight" style="display:none;"></div>
        <div id="pokerRankPanel" class="is-hidden" hidden></div>
        <div class="room-meta">
          <span>🆔 ID: <strong><%= room.roomId %></strong></span>
          <span>👥 ผู้เล่น: <strong id="lobbyPlayerCount"><%= room.playerCount %></strong>/<span id="lobbyMaxPlayers"><%= room.maxPlayers %></span></span>
          <span id="roomGameModeBadge" data-game-mode="<%= room.gameMode %>"><%= room.gameModeLabel %></span>
          <span>🚪 สถานะ: <strong id="lobbyRoomLock"><%= room.locked ? '🔒 ล็อค' : '🔓 เปิด' %></strong></span>
          <span id="dualTraitorBadge" class="<%= room.gameMode === 'insider' && room.dualTraitorMode ? '' : 'is-hidden' %>" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">🔴🔴 2 จอมบงการ</span>
        </div>
        <p style="margin:10px 0 0; font-size:0.82em; color:#9aa3b2; line-height:1.45;">
          ปิดจอชั่วคราวได้ — กลับมาเปิดแอปภายใน ~2 นาที (โหมดเจอหน้า) ยังอยู่ห้องและบทบาทเดิม
          <% if (room.isAdmin) { %> · หัวหน้าห้องกดจบเกมได้จากหน้าเล่น<% } %>
        </p>
      </div>
    </div>

    <div class="room-main-panel">
    <!-- Chat / status -->
    <div class="room-card-dark room-chat-area">
      <div style="margin-bottom: 8px; display:flex; justify-content:space-between; align-items:center;">
        <div>💬 แชทในห้อง</div>
        <div style="font-size:0.85em; color:#aaa;">คุณ: <span id="lobbySelfName" data-player-color="<%= playerInfo.color %>"><%= player.name %></span></div>
      </div>
      <div id="lobbyChatMessages" class="room-chat-messages"></div>
      <div class="room-chat-input-row">
        <textarea id="lobbyChatInput" rows="1" placeholder="พิมพ์ข้อความ..."></textarea>
        <button id="btnSendLobbyChat" class="btn-send-chat">ส่ง</button>
      </div>
      <div class="start-game-bar">
        <span id="lobbyStatusText">
          รอผู้เล่นครบก่อนเปิดเกม
        </span>
        <button type="button" id="btnBlackMarketHowTo" class="<%= room.gameMode === 'blackmarket' ? '' : 'is-hidden' %>">📖 วิธีเล่น</button>
        <button type="button" id="btnSpyfallHowTo" class="<%= room.gameMode === 'spyfall' ? '' : 'is-hidden' %>">📖 วิธีเล่น</button>
        <button type="button" id="btnCoupHowTo" class="<%= room.gameMode === 'coup' ? '' : 'is-hidden' %>">📖 วิธีเล่น</button>
        <button type="button" id="btnLiarHowTo" class="<%= room.gameMode === 'liar' ? '' : 'is-hidden' %>">📖 วิธีเล่น</button>
        <button type="button" id="btnPokerHowTo" class="<%= isPoker4Lobby ? 'is-four' : '' %> <%= isPokerLobbyRoom ? '' : 'is-hidden' %>">📖 แรงก์ไพ่</button>
        <button id="btnStartGameLobby" disabled class="<%= room.isAdmin ? '' : 'is-hidden' %>">เปิดเกม</button>
      </div>
    </div>

    <!-- Players / admin controls -->
    <div class="room-card-dark lobby-player-list">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <h3 style="margin:0;">👥 ผู้เล่นในห้อง</h3>
        <button id="btnViewRolesLobby" class="is-hidden" style="background:rgba(255,255,255,0.1); color:#fff; border:none; border-radius:12px; padding:6px 12px; font-size:0.85em; cursor:pointer;">🎭 บทบาท</button>
      </div>
      <div id="lobbyPlayers"></div>

      <div id="adminControlsSection" class="lobby-admin-controls <%= room.isAdmin ? '' : 'is-hidden' %>">
        <h4>👑 คำสั่งหัวหน้าห้อง</h4>
        
        <!-- Quick Toggle: Dual Traitor Mode -->
        <div id="dualTraitorQuickToggle" class="is-hidden" style="margin-bottom: 15px; padding: 12px 15px; background: linear-gradient(135deg, rgba(231,76,60,0.15), rgba(192,57,43,0.1)); border: 2px solid rgba(231,76,60,0.4); border-radius: 12px;">
          <div style="display: flex; flex-direction: column; gap: 10px; align-items: center;">
            <div style="font-weight: 700; color: #e74c3c; font-size: 1em;">🔴🔴 โหมด 2 จอมบงการ <span style="font-size: 0.8em; color: #aaa; font-weight: 400;">(5+ คน)</span></div>
            <label class="toggle-switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
              <input type="checkbox" id="quickDualTraitorToggle" <%= room.dualTraitorMode ? 'checked' : '' %> style="opacity: 0; width: 0; height: 0;">
              <span class="toggle-slider" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #333; transition: .3s; border-radius: 30px;"></span>
            </label>
          </div>
        </div>
        
        <button id="btnEditRoom" class="btn-admin-small btn-edit-room">⚙️ แก้ไขห้อง</button>
        <button type="button" id="btnBlackMarketAddBots" class="btn-admin-small btn-add-bots <%= ((room.gameMode === 'blackmarket' || isPokerLobbyRoom) && room.isAdmin) ? '' : 'is-hidden' %>"><%= isPokerLobbyRoom ? '🤖 เพิ่มบอท' : '🤖 เติมบอทเพื่อทดสอบ' %></button>
      </div>
    </div>
    </div>
  </div>
</div>
<%- contentFor('footer') %>
<div class="page-footer-actionbar">
  <button id="btnLeaveRoom" class="btn btn-dark">← กลับรายชื่อห้อง</button>
</div>


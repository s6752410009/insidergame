        '</p>',
        '<div class="cc-lobby-opts">',
        '<select id="ucLobbyCount" aria-label="จำนวนสายแฝง"' + dis + '>',
        opt('auto', '🕶️ สายแฝง: ตามจำนวนคน', wanted), opt('1', '🕶️ สายแฝง 1 คน', wanted), opt('2', '🕶️ สายแฝง 2 คน', wanted), opt('3', '🕶️ สายแฝง 3 คน', wanted),
        '</select>',
        '<button type="button" class="uc-mw-toggle" id="ucMrWhiteToggle" aria-pressed="' + (mrWhiteOn ? 'true' : 'false') + '"' + dis + '>',
        (mrWhiteOn ? '✓ ' : '') + '❔ Mr. White: ' + (mrWhiteOn ? 'เปิด' : 'ปิด'),
        '</button>',
        '<select id="ucLobbyTie" aria-label="โหวตเสมอ"' + dis + '>',
        opt('speak', '⚖️ เสมอ: ใบ้เพิ่มแล้วโหวตใหม่', tieRule), opt('revote', '⚖️ เสมอ: โหวตใหม่เลย', tieRule), opt('none', '⚖️ เสมอ: ไม่มีใครออก', tieRule),
        '</select>',
        '</div>',
        preview
          ? '<p class="uc-mw-note" style="margin:8px 0 0; color:#fde68a; font-size:0.85em;">ตอนนี้ ' + count + ' คน → พลเมือง ' + preview.civilian + ' · สายแฝง ' + preview.undercover + (preview.mrWhite ? ' · Mr. White 1' : '') +
            (mrWhiteOn && !preview.mrWhite ? ' (Mr. White มีเมื่อครบ 5 คน)' : '') + '</p>'
          : '<p class="uc-mw-note" style="margin:8px 0 0; color:#9fb3c8; font-size:0.85em;">แนะนำ: 3–6 คน สายแฝง 1 · 7–9 คน สายแฝง 2 · 10 คน สายแฝง 3 · Mr. White ตั้งแต่ 5 คน</p>'
      ].join('');

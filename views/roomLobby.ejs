    function showSpyfallLobbyGuide() {
      Swal.fire({
        title: '🕶️ วิธีเล่น Spyfall',
        html: buildSpyfallLobbyGuideHtml(),
        background: '#0f172a',
        color: '#fff',
        confirmButtonText: 'เข้าใจแล้ว',

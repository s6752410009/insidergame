        readyText: 'พร้อมแล้ว แจกไพ่ได้เลย',
        waitingText: 'รอผู้เล่นอย่างน้อย 2 คนก่อนเริ่ม',
        roundLabel: 'เวลาเลือกไพ่:'
      }
    };
    const werewolfRoleVisuals = {
      werewolf: { emoji: '🐺', teamLabel: 'ฝั่งหมาป่า' },
      alphaWolf: { emoji: '👑', teamLabel: 'หมาป่านำทีม' },
      seer: { emoji: '🔮', teamLabel: 'สายอ่านเกม' },
      doctor: { emoji: '💉', teamLabel: 'สายช่วยทีม' },
      witch: { emoji: '🧪', teamLabel: 'สายพลิกเกม' },
      fool: { emoji: '🤪', teamLabel: 'บทเดี่ยว' },
      bodyguard: { emoji: '🛡️', teamLabel: 'สายกันตาย' },
      mayor: { emoji: '🎖️', teamLabel: 'สายคุมโหวต' },
      revealer: { emoji: '💥', teamLabel: 'สายเสี่ยงแตก' }
    };
    const werewolfRolePresets = [
      {
        id: 'classic-pack',
        name: 'คลาสสิก',
        tagline: 'อ่านง่าย เล่นลื่น',
        minPlayers: 6,
        roles: ['werewolf', 'seer', 'doctor', 'witch', 'bodyguard']
      },
      {
        id: 'mindgame-pack',
        name: 'อ่านใจ',
        tagline: 'โกหกกันมันขึ้น',
        minPlayers: 7,
        roles: ['werewolf', 'alphaWolf', 'seer', 'doctor', 'mayor', 'bodyguard', 'fool']
      },
      {
        id: 'chaos-pack',
        name: 'ปั่นจัด',
        tagline: 'เช้าละเรื่อง',
        minPlayers: 8,
        roles: ['werewolf', 'alphaWolf', 'seer', 'witch', 'fool', 'mayor', 'revealer', 'bodyguard']
      }
    ];

    function matchesWerewolfPreset(selectedRoleIds, preset) {
      const selected = [...(Array.isArray(selectedRoleIds) ? selectedRoleIds : [])].sort();
      const presetRoles = [...preset.roles].sort();
      return selected.length === presetRoles.length && presetRoles.every((roleId, index) => roleId === selected[index]);
    }

    function renderSelectedWerewolfRoleSummary(selectedRoleIds) {
      const selected = Array.isArray(selectedRoleIds) ? selectedRoleIds : [];
      const selectedRoles = werewolfRoleOptions.filter(role => selected.includes(role.id));
      const chips = selectedRoles.map(role => {
        const visual = werewolfRoleVisuals[role.id] || { emoji: '🎭', teamLabel: 'พิเศษ' };
        return `<span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; background:rgba(255,255,255,0.08); color:#fff; font-size:0.85em;">${visual.emoji} ${role.thaiName}</span>`;
      }).join('');

      if (!selectedRoles.length) {
        return '<div style="color:#f8d189; font-size:0.9em;">ยังไม่ได้ติ๊กบทพิเศษเพิ่ม ระบบจะเติมหมาป่าปกติให้เองถ้าจำเป็น</div>';
      }

      return `
        <div style="display:grid; gap:8px;">
          <div style="color:#8fd3ff; font-size:0.88em;">ตอนนี้เปิดอยู่ ${selectedRoles.length} บท ระบบจะเติมชาวบ้านให้ครบจำนวนคนอัตโนมัติ</div>
          <div style="display:flex; gap:6px; flex-wrap:wrap;">${chips}</div>
        </div>
      `;
    }

    function syncWerewolfRolePicker(container) {
      if (!container) {
        return;
      }

      const selected = collectWerewolfRoleSelection(container);
      const summary = container.querySelector('.werewolf-role-summary');
      if (summary) {
        summary.innerHTML = renderSelectedWerewolfRoleSummary(selected);
      }

      container.querySelectorAll('.werewolf-role-preset').forEach(button => {
        const preset = werewolfRolePresets.find(item => item.id === button.dataset.presetId);
        button.classList.toggle('active', !!preset && matchesWerewolfPreset(selected, preset));
        button.style.borderColor = button.classList.contains('active') ? '#f39c12' : 'rgba(255,255,255,0.08)';
        button.style.background = button.classList.contains('active') ? 'linear-gradient(135deg, rgba(243,156,18,0.24), rgba(192,57,43,0.18))' : 'rgba(255,255,255,0.04)';
      });
    }

    function applyWerewolfRolePreset(container, presetId) {
      const preset = werewolfRolePresets.find(item => item.id === presetId);
      if (!container || !preset) {
        return;
      }

      container.querySelectorAll('.werewolf-role-option').forEach(option => {
        const checkbox = option.querySelector('input');
        const enabled = preset.roles.includes(option.dataset.roleId);
        if (checkbox) {
          checkbox.checked = enabled;
        }
        option.classList.toggle('checked', enabled);
      });
    }

    function buildWerewolfRoleSelectionHtml(selectedRoleIds) {
      const selected = Array.isArray(selectedRoleIds) ? selectedRoleIds : [];
      return `
        <div style="display:grid; gap:12px;">
          <div style="display:grid; gap:8px;">
            <div style="color:#fff; font-weight:700;">เลือกแนวห้องเร็ว ๆ</div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:8px;">
              ${werewolfRolePresets.map(preset => `
                <button type="button" class="werewolf-role-preset ${matchesWerewolfPreset(selected, preset) ? 'active' : ''}" data-preset-id="${preset.id}" data-min-players="${preset.minPlayers}" style="border:1px solid ${matchesWerewolfPreset(selected, preset) ? '#f39c12' : 'rgba(255,255,255,0.08)'}; border-radius:12px; background:${matchesWerewolfPreset(selected, preset) ? 'linear-gradient(135deg, rgba(243,156,18,0.24), rgba(192,57,43,0.18))' : 'rgba(255,255,255,0.04)'}; color:#fff; padding:10px 12px; text-align:left; cursor:pointer; font-family:Rajdhani, sans-serif;">
                  <div style="font-weight:700; font-size:1em;">${preset.name}</div>
                  <div style="color:#f8d189; font-size:0.82em;">${preset.tagline}</div>
                  <div style="color:#97a4bf; font-size:0.78em; margin-top:4px;">แนะนำ ${preset.minPlayers}+ คน</div>
                </button>
              `).join('')}
            </div>
          </div>
          <div class="werewolf-role-summary" style="padding:12px; border-radius:12px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08);">
            ${renderSelectedWerewolfRoleSummary(selected)}
          </div>
          <details style="padding:12px; border-radius:12px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
            <summary style="cursor:pointer; color:#8fd3ff; font-weight:700;">ปรับบทเองทีละบท</summary>
            <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:8px; margin-top:12px;">
              ${werewolfRoleOptions.map(role => {
                const visual = werewolfRoleVisuals[role.id] || { emoji: '🎭', teamLabel: 'พิเศษ' };
                return `
                  <div class="room-checkbox-container werewolf-role-option ${selected.includes(role.id) ? 'checked' : ''}" data-role-id="${role.id}" style="margin-bottom:0; align-items:flex-start; gap:10px; padding:12px; border:1px solid rgba(255,255,255,0.08); border-radius:12px; background:rgba(255,255,255,0.03); justify-content:flex-start;">
                    <input type="checkbox" class="room-checkbox" ${selected.includes(role.id) ? 'checked' : ''}>
                    <div class="room-checkbox-custom">✓</div>
                    <span class="room-checkbox-text" style="display:grid; gap:4px;">
                      <strong>${visual.emoji} ${role.thaiName}</strong>
                      <span style="color:#8fd3ff; font-size:0.8em;">${visual.teamLabel}</span>
                      <span style="color:#aaa; font-size:0.85em; line-height:1.35;">${role.description}</span>
                      ${role.winCondition ? `<span style="color:#a5b4fc; font-size:0.78em; line-height:1.35;">🏁 ${role.winCondition}</span>` : ''}
                    </span>
                  </div>
                `;
              }).join('')}
            </div>
          </details>
        </div>
      `;
    }

    function collectWerewolfRoleSelection(container) {
      return Array.from(container.querySelectorAll('.werewolf-role-option'))
        .filter(option => option.querySelector('input')?.checked)
        .map(option => option.dataset.roleId);
    }

    function normalizeLobbyGameMode(mode) {
      const compactMode = String(mode || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
      if (compactMode === 'blackmarket' || compactMode === 'blackmkt' || compactMode === 'blackmarketmode') {
        return 'blackmarket';
      }
      if (compactMode === 'werewolf') {
        return 'werewolf';
      }
      if (compactMode === 'spyfall' || compactMode === 'spy' || compactMode === 'secretplace') {
        return 'spyfall';
      }
      if (compactMode === 'coup' || compactMode === 'coupgame') {
        return 'coup';
      }
      if (compactMode === 'liar' || compactMode === 'liarsbar' || compactMode === 'liarbar' || compactMode === 'cheat' || compactMode === 'โกหก' || compactMode === 'ไพ่โกหก') {
        return 'liar';
      }
      if (compactMode === 'poker5' || compactMode === 'ห้าใบเลือกสาม' || compactMode === 'โป๊กเกอร์5ใบ' || compactMode === 'ไพ่5ใบ') {
        return 'poker5';
      }
      if (compactMode === 'poker4' || compactMode === 'สี่ใบเก' || compactMode === '4ใบเก' || compactMode === 'fourcard') {
        return 'poker4';
      }
      return 'insider';
    }

    function inferLobbyModeFromName(name) {
      const compact = String(name || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
      if (compact === 'ห้าใบเลือกสาม' || compact === 'ไพ่5ใบ' || compact === 'โป๊กเกอร์5ใบ' || compact === 'poker5') {
        return 'poker5';
      }
      if (compact === 'สี่ใบเก' || compact === '4ใบเก' || compact === 'poker4' || compact === 'fourcard') {
        return 'poker4';
      }
      return null;
    }

    function getModeMeta(mode) {
      return currentModeMeta[normalizeLobbyGameMode(mode)] || currentModeMeta.insider;
    }

    function getModeBadgeStyle(mode) {
      const normalizedMode = normalizeLobbyGameMode(mode);
      if (normalizedMode === 'werewolf') {
        return {
          background: 'linear-gradient(135deg, #34495e, #111827)',
          color: '#fff'
        };
      }
      if (normalizedMode === 'blackmarket') {
        return {
          background: 'linear-gradient(135deg, #7f1d1d, #111111)',
          color: '#fde68a'
        };
      }
      if (normalizedMode === 'spyfall') {
        return {
          background: 'linear-gradient(135deg, #0f766e, #134e4a)',
          color: '#ccfbf1'
        };
      }
      if (normalizedMode === 'coup') {
        return {
          background: 'linear-gradient(135deg, #6d28d9, #3b0764)',
          color: '#f4ecff'
        };
      }
      if (normalizedMode === 'liar') {
        return {
          background: 'linear-gradient(135deg, #991b1b, #450a0a)',
          color: '#fecaca'
        };
      }
      if (normalizedMode === 'poker5') {
        return { background: 'linear-gradient(135deg, #166534, #052e16)', color: '#bbf7d0' };
      }
      if (normalizedMode === 'poker4') {
        return { background: 'linear-gradient(135deg, #991b1b, #1c1917)', color: '#fecaca' };
      }
      return {
        background: 'linear-gradient(135deg, #e67e22, #d35400)',
        color: '#fff'
      };
    }

    function getLobbyHeroCopy(mode) {
      const normalizedMode = normalizeLobbyGameMode(mode);
      if (normalizedMode === 'werewolf') {
        return {
          kicker: '🐺 ห้องเตรียมล่าหมาป่า',
          pills: []
        };
      }
      if (normalizedMode === 'blackmarket') {
        return {
          kicker: '🎩 ห้องเตรียมเปิดตลาด',
          pills: []
        };
      }
      if (normalizedMode === 'spyfall') {
        return {
          kicker: '🕶️ ห้องเตรียมสายลับ',
          pills: []
        };
      }
      if (normalizedMode === 'coup') {
        return {
          kicker: '👑 ห้องเตรียมโค่นอำนาจ',
          pills: []
        };
      }
      if (normalizedMode === 'liar') {
        return {
          kicker: '🃏 ห้องเตรียมไพ่โกหก',
          pills: []
        };
      }
      if (normalizedMode === 'poker5') {
        return { kicker: '♠ ห้องไพ่ 5 ใบ', pills: [] };
      }
      if (normalizedMode === 'poker4') {
        return { kicker: '♦ ห้องสี่ใบเก', pills: [] };
      }

      return {
        kicker: '🎯 ห้องเตรียมเกม',
        pills: []
      };
    }

    function resolveGameModeFromPayload(payload) {
      const fromData = normalizeLobbyGameMode(
        (payload && payload.settings && payload.settings.gameMode)
        || (payload && payload.gameMode)
        || currentGameMode
      );
      if (fromData !== 'insider') return fromData;
      const title = (payload && (payload.roomName || payload.name))
        || (document.getElementById('roomTitleText') && document.getElementById('roomTitleText').textContent)
        || '';
      return inferLobbyModeFromName(title) || fromData;
    }

    function refreshAddBotsButton(mode) {
      const resolvedMode = mode || normalizeLobbyGameMode(currentGameMode);
      const isPoker = resolvedMode === 'poker5' || resolvedMode === 'poker4';
      const show = isAdmin && (resolvedMode === 'blackmarket' || isPoker);
      setElementHidden('#btnBlackMarketAddBots', !show);
      const btn = document.getElementById('btnBlackMarketAddBots');
      if (btn && !$(btn).data('loading')) {
        btn.textContent = isPoker ? '🤖 เพิ่มบอท' : '🤖 เติมบอทเพื่อทดสอบ';
      }
    }

    function updateLobbyModeUI(payload) {
      const resolvedMode = resolveGameModeFromPayload(payload);
      const settings = payload && payload.settings ? payload.settings : null;
      const badge = document.getElementById('roomGameModeBadge');
      const maxPlayersLabel = document.getElementById('lobbyMaxPlayers');
      const roomTitle = document.getElementById('roomTitleText');
      const roomModeKicker = document.getElementById('roomModeKicker');
      const roomSubtitle = document.getElementById('roomSubtitle');
      const lobbySpotlight = document.getElementById('lobbySpotlight');
      const badgeStyle = getModeBadgeStyle(resolvedMode);
      const heroCopy = getLobbyHeroCopy(resolvedMode);

      currentGameMode = resolvedMode;

      if (settings && Array.isArray(settings.werewolfRoles)) {
        currentWerewolfRoles = settings.werewolfRoles;
      }

      if (badge) {
        badge.textContent = getModeMeta(resolvedMode).label;
        badge.dataset.gameMode = resolvedMode;
        badge.style.background = badgeStyle.background;
        badge.style.color = badgeStyle.color;
      }

      if (maxPlayersLabel && settings && settings.maxPlayers) {
        maxPlayersLabel.textContent = String(settings.maxPlayers);
      }

      if (roomTitle && payload && payload.roomName) {
        roomTitle.textContent = payload.roomName;
      }

      if (roomModeKicker) {
        roomModeKicker.textContent = heroCopy.kicker;
      }

      const btnViewRoles = document.getElementById('btnViewRolesLobby');
      if (btnViewRoles) {
        if (resolvedMode === 'werewolf') {
          btnViewRoles.classList.remove('is-hidden');
        } else {
          btnViewRoles.classList.add('is-hidden');
        }
      }

      setElementHidden('#btnBlackMarketHowTo', resolvedMode !== 'blackmarket');
      setElementHidden('#btnSpyfallHowTo', resolvedMode !== 'spyfall');
      setElementHidden('#btnCoupHowTo', resolvedMode !== 'coup');
      setElementHidden('#btnLiarHowTo', resolvedMode !== 'liar');
      setElementHidden('#btnPokerHowTo', resolvedMode !== 'poker5' && resolvedMode !== 'poker4');
      const pokerHowToBtn = document.getElementById('btnPokerHowTo');
      if (pokerHowToBtn) pokerHowToBtn.classList.toggle('is-four', resolvedMode === 'poker4');
      fillPokerRankPanel(resolvedMode);
      refreshAddBotsButton(resolvedMode);

      if (lobbySpotlight) {
        if (resolvedMode === 'spyfall') {
          lobbySpotlight.style.display = 'block';
          lobbySpotlight.innerHTML = [
            '<div class="lobby-spotlight-pill" style="background:rgba(15,118,110,0.25); color:#99f6e4;">🕶️ Spyfall · 4–8 คน</div>',
            '<p style="margin:8px 0 0; color:#cbd5e1; font-size:0.88em; line-height:1.45;">',
            'ทุกคนรู้<strong>สถานที่</strong>ยกเว้นสายลับ 1 คน — ถาม–ตอบให้เนียนแล้วโหวตจับ',
            ' · กด <strong>📖 วิธีเล่น</strong> ด้านล่างเพื่อดูกติกาเต็ม',
            '</p>'
          ].join('');
        } else if (resolvedMode === 'coup') {
          lobbySpotlight.style.display = 'block';
          lobbySpotlight.innerHTML = [
            '<div class="lobby-spotlight-pill" style="background:rgba(109,40,217,0.3); color:#e9d5ff;">👑 Coup · 2–6 คน</div>',
            '<p style="margin:8px 0 0; color:#cbd5e1; font-size:0.88em; line-height:1.45;">',
            'ทุกคนได้การ์ดคว่ำ 2 ใบ <strong>ประกาศพลังของการ์ดที่ไม่มีก็ได้</strong> ใครไม่เชื่อก็ท้าเปิดได้',
            ' · กด <strong>📖 วิธีเล่น</strong> ด้านล่างเพื่อดูกติกาเต็ม',
            '</p>'
          ].join('');
        } else if (resolvedMode === 'liar') {
          lobbySpotlight.style.display = 'block';
          lobbySpotlight.innerHTML = [
            '<div class="lobby-spotlight-pill" style="background:rgba(185,28,28,0.3); color:#fecaca;">🃏 ไพ่โกหก · 3–8 คน</div>',
            '<p style="margin:8px 0 0; color:#cbd5e1; font-size:0.88em; line-height:1.45;">',
            'เหลือหัวใจคนสุดท้ายชนะ · ลงไพ่คว่ำแล้วบอกว่าเป็นไพ่รอบนี้ คนถัดไปท้าหรือลงต่อ',
            ' · กด <strong>📖 วิธีเล่น</strong> ด้านล่างเพื่อดูกติกา',
            '</p>'
          ].join('');
        } else if (resolvedMode === 'poker5' || resolvedMode === 'poker4') {
          const isFour = resolvedMode === 'poker4';
          lobbySpotlight.style.display = 'block';
          lobbySpotlight.innerHTML = [
            '<div class="lobby-spotlight-pill" style="background:' + (isFour ? 'rgba(153,27,27,0.35); color:#fecaca;">♦ สี่ใบเก' : 'rgba(22,101,52,0.3); color:#bbf7d0;">♠ ไพ่ 5 ใบ') + ' · 2–10 คน</div>',
            '<p style="margin:8px 0 0; color:#cbd5e1; font-size:0.88em; line-height:1.45;">',
            isFour
              ? 'ได้ 4 ใบ ทิ้ง 2 ลงชิปรอบนึง คนที่ยังไม่หมอบได้ใบที่ 3 หงายให้ดู แล้วเปิดเทียบเลย'
              : 'ได้ 5 ใบ ทิ้ง 2 ลงชิปรอบนึง แล้วเปิด 3 ใบเทียบเลย',
            '</p>'
          ].join('');
        } else if (resolvedMode === 'blackmarket') {
          lobbySpotlight.style.display = 'block';
          lobbySpotlight.innerHTML = [
            '<div class="lobby-spotlight-pill" style="background:rgba(127,29,29,0.35); color:#fde68a;">🎩 Black Market · 4–7 คน</div>',
            '<p style="margin:8px 0 0; color:#cbd5e1; font-size:0.88em; line-height:1.45;">',
            'กวาดของเถื่อน เปิดดีล หักหลัง — กด <strong>📖 วิธีเล่น</strong> ด้านล่าง',
            '</p>'
          ].join('');
        } else {
          lobbySpotlight.style.display = 'none';
          lobbySpotlight.innerHTML = '';
        }
      }

      const startBtn = document.getElementById('btnStartGameLobby');
      if (startBtn) {
        startBtn.textContent = getModeMeta(resolvedMode).startLabel;
      }
    }

    function buildSpyfallLobbyGuideHtml() {
      return [
        '<div class="bm-guide-inner">',
        '<p class="bm-guide-lead">🕶️ ทุกคนรู้สถานที่ยกเว้น <strong>สายลับ 1 คน</strong> · เล่น 4–8 คน</p>',

    // ต้องตรงกับ getRoleCounts ใน games/undercoverEngine.js
    function undercoverRoleCounts(count, mrWhiteOn, wanted) {
      let undercover = wanted === 'auto' ? (count >= 10 ? 3 : (count >= 7 ? 2 : 1)) : Number(wanted);
      let mrWhite = mrWhiteOn && count >= 5 ? 1 : 0;
      const tooMany = function() { return count - undercover - mrWhite <= undercover + mrWhite; };
      while (undercover > 1 && tooMany()) undercover -= 1;
      if (mrWhite && tooMany()) mrWhite = 0;
      return { undercover: undercover, mrWhite: mrWhite, civilian: Math.max(0, count - undercover - mrWhite) };
    }

    function buildUndercoverLobbyHtml(settings, payload) {
      const mrWhiteOn = !settings || settings.undercoverMrWhite !== false;
      const wanted = [1, 2, 3].indexOf(Number(settings && settings.undercoverCount)) >= 0 ? String(Number(settings.undercoverCount)) : 'auto';
      const tieRule = ['speak', 'revote', 'none'].indexOf(settings && settings.undercoverTieRule) >= 0 ? settings.undercoverTieRule : 'speak';
      const count = Array.isArray(payload && payload.players) ? payload.players.length : 0;
      const dis = isAdmin ? '' : ' disabled';
      const opt = function(value, label, current) { return '<option value="' + value + '"' + (value === current ? ' selected' : '') + '>' + label + '</option>'; };
      const preview = count >= 3 ? undercoverRoleCounts(count, mrWhiteOn, wanted) : null;
      return [
        '<div class="lobby-spotlight-pill" style="background:rgba(245,200,107,0.16); color:#fde68a;">🫥 คำใครไม่เหมือน · 3–10 คน</div>',

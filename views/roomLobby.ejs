    function normalizeLobbyGameMode(mode) {
      const compactMode = String(mode || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
      if (compactMode === 'blackmarket' || compactMode === 'blackmkt' || compactMode === 'blackmarketmode') {
        return 'blackmarket';
      }
      if (compactMode === 'werewolf') {
        return 'werewolf';
      }
      if (compactMode === 'spyfall' || compactMode === 'spy' || compactMode === 'secretplace') {
        return 'spyfall';
      }
      if (compactMode === 'undercover' || compactMode === 'whoisundercover' || compactMode === 'คำใครไม่เหมือน') {
        return 'undercover';
      }
      if (compactMode === 'coup' || compactMode === 'coupgame') {
        return 'coup';
      }
      if (compactMode === 'avalon' || compactMode === 'avalongame' || compactMode === 'resistance' || compactMode === 'อวาลอน' || compactMode === 'อัศวินโต๊ะกลม') {
        return 'avalon';
      }
      if (compactMode === 'liar' || compactMode === 'liarsbar' || compactMode === 'liarbar' || compactMode === 'cheat' || compactMode === 'โกหก' || compactMode === 'ไพ่โกหก') {
        return 'liar';
      }
      if (compactMode === 'poker5' || compactMode === 'ห้าใบเลือกสาม' || compactMode === 'โป๊กเกอร์5ใบ' || compactMode === 'ไพ่5ใบ') {
        return 'poker5';
      }
      if (compactMode === 'poker4' || compactMode === 'สี่ใบเก' || compactMode === '4ใบเก' || compactMode === 'fourcard') {
        return 'poker4';
      }
      if (compactMode === 'pokdeng' || compactMode === 'ป๊อกเด้ง' || compactMode === 'ป็อกเด้ง') {
        return 'pokdeng';
      }
      if (compactMode === 'codenames' || compactMode === 'สายลับคำใบ้') {
        return 'codenames';
      }
      if (compactMode === 'wavelength' || compactMode === 'คลื่นความคิด') {
        return 'wavelength';
      }
      if (compactMode === 'drawguess' || compactMode === 'วาดแล้วทาย') {
        return 'drawguess';
      }
      if (compactMode === 'colorcards' || compactMode === 'ไพ่ทิ้งสี' || compactMode === 'ทิ้งสี') {
        return 'colorcards';
      }
      if (compactMode === 'setthi' || compactMode === 'เศรษฐี') {
        return 'setthi';
      }
      return 'insider';
    }

    function inferLobbyModeFromName(name) {
      const compact = String(name || '').trim().toLowerCase().replace(/[\s_-]+/g, '');
      if (compact === 'ห้าใบเลือกสาม' || compact === 'ไพ่5ใบ' || compact === 'โป๊กเกอร์5ใบ' || compact === 'poker5') {
        return 'poker5';
      }
      if (compact === 'สี่ใบเก' || compact === '4ใบเก' || compact === 'poker4' || compact === 'fourcard') {
        return 'poker4';
      }
      if (compact === 'ป๊อกเด้ง' || compact === 'pokdeng') {
        return 'pokdeng';
      }
      if (compact === 'สายลับคำใบ้' || compact === 'วงสายลับคำใบ้') {
        return 'codenames';
      }
      if (compact === 'คลื่นความคิด' || compact === 'วงคลื่นความคิด' || compact === 'wavelength') {
        return 'wavelength';
      }
      if (compact === 'วาดแล้วทาย' || compact === 'drawguess') {
        return 'drawguess';
      }
      if (compact === 'ไพ่ทิ้งสี' || compact === 'colorcards') {
        return 'colorcards';
      }
      if (compact === 'เศรษฐี' || compact === 'วงเศรษฐี' || compact === 'setthi') {
        return 'setthi';
      }
      return null;
    }

    function getModeMeta(mode) {
      return currentModeMeta[normalizeLobbyGameMode(mode)] || currentModeMeta.insider;
    }


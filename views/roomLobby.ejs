<%
  const lobbyNameCompact = String(room.name || '').replace(/[\s_-]+/g, '');
  const isPoker4Lobby = room.gameMode === 'poker4' || lobbyNameCompact === 'สี่ใบเก' || lobbyNameCompact === '4ใบเก';
  const isPoker5Lobby = room.gameMode === 'poker5' || lobbyNameCompact === 'ห้าใบเลือกสาม' || lobbyNameCompact === 'ไพ่5ใบ' || lobbyNameCompact === 'โป๊กเกอร์5ใบ';
  const isPokerLobbyRoom = isPoker4Lobby || isPoker5Lobby;
%>

<div class="room-lobby-container">
  <div class="room-lobby-shell">
    <div class="room-lobby-header">
      <div class="room-lobby-hero">
        <div id="roomModeKicker" class="room-kicker">🎩 ห้องเตรียมเกม</div>
        <div class="room-title">🎮 ห้อง: <span id="roomTitleText"><%= room.name %></span></div>
        <div id="lobbySpotlight" class="lobby-spotlight" style="display:none;"></div>
        <div id="pokerRankPanel" class="is-hidden" hidden></div>
        <div class="room-meta">
          <span>🆔 ID: <strong><%= room.roomId %></strong></span>
          <span>👥 ผู้เล่น: <strong id="lobbyPlayerCount"><%= room.playerCount %></strong>/<span id="lobbyMaxPlayers"><%= room.maxPlayers %></span></span>
          <span id="roomGameModeBadge" data-game-mode="<%= room.gameMode %>"><%= room.gameModeLabel %></span>
          <span>🚪 สถานะ: <strong id="lobbyRoomLock"><%= room.locked ? '🔒 ล็อค' : '🔓 เปิด' %></strong></span>
          <span id="dualTraitorBadge" class="<%= room.gameMode === 'insider' && room.dualTraitorMode ? '' : 'is-hidden' %>" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">🔴🔴 2 จอมบงการ</span>
        </div>
        <p style="margin:10px 0 0; font-size:0.82em; color:#9aa3b2; line-height:1.45;">
          ปิดจอชั่วคราวได้ — กลับมาเปิดแอปภายใน ~2 นาที (โหมดเจอหน้า) ยังอยู่ห้องและบทบาทเดิม
          <% if (room.isAdmin) { %> · หัวหน้าห้องกดจบเกมได้จากหน้าเล่น<% } %>
        </p>
      </div>
    </div>

    <div class="room-main-panel">
    <!-- Chat / status -->
    <div class="room-card-dark room-chat-area">

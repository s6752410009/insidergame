  .pk-rank-mini { display:flex; gap:3px; flex:0 0 auto; }
  .pk-rank-mini img { width:28px; height:40px; border-radius:4px; object-fit:cover; box-shadow:0 4px 8px rgba(0,0,0,0.35); }
</style>


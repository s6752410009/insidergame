  <div class="chat-header"><div class="chat-title">💬 แชท</div><button type="button" id="closeChat" class="chat-close">✕</button></div>
  <div id="replyPreview" class="chat-reply-preview-bar" style="display:none;"></div>
  <div id="chatMessages" class="chat-messages" role="log"></div>
  <div class="chat-input-wrap">
    <textarea id="chatInput" rows="1" placeholder="พิมพ์ข้อความ..."></textarea>
    <button type="button" id="sendChat" class="btn-chat-send">ส่ง</button>
  </div>
</div>
<button type="button" id="toggleChat" class="chat-toggle">💬 แชท <span id="chatUnreadDot" class="unread-dot" style="display:none;"></span></button>
<div id="pkDebug" class="pk-debug" hidden>
  <div class="pk-debug-head" id="pkDebugHead">
    <span class="pk-debug-title">/m DEBUG</span>
    <button type="button" id="pkDebugToggle" class="pk-debug-toggle" aria-label="ย่อ">✕</button>
  </div>
  <div class="pk-debug-body">
    <label class="pk-debug-row"><input type="checkbox" id="pkPeekAll"> แสดงไพ่ทุกคน</label>
    <div class="pk-debug-row">
      <input type="number" id="pkCheatAmt" value="1000" min="1" max="100000" step="100">
      <button type="button" id="pkCheatBtn">เติมชิป</button>
    </div>
  </div>
</div>
<button type="button" id="pkRankTab" class="pk-rank-tab" aria-expanded="false" aria-controls="pkRankDrawer">แรงก์ไพ่</button>

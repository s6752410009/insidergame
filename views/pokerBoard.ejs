  <div class="pk-rank-head">
    <h3>มือไพ่</h3>
    <button type="button" id="pkRankClose" class="pk-rank-close" aria-label="ปิด">✕</button>
  </div>
  <div id="pkRankYou" class="pk-rank-you">กำลังดูมือ...</div>
  <div id="pkRankList"></div>
</aside>

<%- contentFor('script') %>
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/pokerRankChart.js?v=20260814b"></script>
<script src="/js/partyPlay.js"></script>
<script src="/js/gameIcon.js"></script>
<script src="/js/chatPanel.js"></script>
<script>
$(function() {
  document.documentElement.classList.add('pk-active');
  const socket = io({ reconnection: true, reconnectionAttempts: Infinity, transports: ['websocket', 'polling'] });
  const roomId = '<%= room.roomId %>';
  const playerId = '<%= player.playerId %>';
  const playerName = '<%= player.name %>';
  const isRoomAdmin = <%= room.admin === true ? 'true' : 'false' %>;
  let currentState = <%- JSON.stringify(typeof pokerState !== 'undefined' ? pokerState : {}) %>;
  if (window.partyPlay) window.partyPlay.startSession(currentState.mode || 'poker5', socket);
  let allowNavigation = false;
  let selectedIds = [];
  let selectAutoKey = '';
  let timerHandle = null;
  let chipAmount = 0;
  let chipPhaseKey = '';
  let seenFxSeq = 0;
  let skipSelfDiscardFx = false;
  let lastTurnId = '';
  let seenSaySeq = {};
  let seenPeekLabel = {};
  let lastTurnSoundKey = '';
  let seatLayoutKey = '';
  let lastRingId = '';
  let lastActionSig = '';
  let lastHandSig = '';
  let pkAudioCtx = null;
  let pkNoiseBuf = null;

  function escapeHtml(text) {
    return String(text == null ? '' : text).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;' }[c]));
  }
  function pkAudio() {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return null;
    if (!pkAudioCtx) pkAudioCtx = new Ctx();
    if (pkAudioCtx.state === 'suspended') pkAudioCtx.resume().catch(function() {});
    return pkAudioCtx;
  }
  function pkNoiseBuffer(ctx) {
    if (pkNoiseBuf && pkNoiseBuf.sampleRate === ctx.sampleRate) return pkNoiseBuf;
    const len = Math.floor(ctx.sampleRate * 0.22);
    const buf = ctx.createBuffer(1, len, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < len; i += 1) data[i] = Math.random() * 2 - 1;
    pkNoiseBuf = buf;
    return buf;
  }
  function pkTone(ctx, freq, at, dur, vol, wave) {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = wave || 'triangle';
    osc.frequency.setValueAtTime(freq, at);
    gain.gain.setValueAtTime(0.0001, at);
    gain.gain.exponentialRampToValueAtTime(vol || 0.06, at + 0.012);
    gain.gain.exponentialRampToValueAtTime(0.0001, at + dur);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(at);
    osc.stop(at + dur + 0.02);
  }
  function pkNoise(ctx, at, dur, vol, freq) {
    const src = ctx.createBufferSource();
    src.buffer = pkNoiseBuffer(ctx);
    const filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(freq || 1800, at);
    filter.Q.value = 1.2;
    const gain = ctx.createGain();
    gain.gain.setValueAtTime(0.0001, at);
    gain.gain.exponentialRampToValueAtTime(vol || 0.08, at + 0.008);
    gain.gain.exponentialRampToValueAtTime(0.0001, at + dur);
    src.connect(filter);
    filter.connect(gain);
    gain.connect(ctx.destination);
    src.start(at);
    src.stop(at + dur + 0.02);
  }
  function pkSfx(kind, delayMs) {
    if (delayMs) {
      setTimeout(function() { pkSfx(kind); }, delayMs);
      return;
    }
    const ctx = pkAudio();
    if (!ctx) return;
    const t = ctx.currentTime + 0.01;
    if (kind === 'dealTick') {
      pkNoise(ctx, t, 0.045, 0.05, 2200);
      pkTone(ctx, 1640, t, 0.05, 0.03, 'square');
      return;
    }
    if (kind === 'discard') {
      pkNoise(ctx, t, 0.12, 0.07, 900);
      pkTone(ctx, 420, t, 0.1, 0.03, 'sine');
      return;
    }
    if (kind === 'turn') {
      pkTone(ctx, 523.25, t, 0.12, 0.07, 'triangle');
      pkTone(ctx, 783.99, t + 0.12, 0.18, 0.08, 'triangle');
      return;
    }
    if (kind === 'fold') {
      pkTone(ctx, 196, t, 0.16, 0.06, 'sine');
      pkTone(ctx, 130.81, t + 0.12, 0.22, 0.05, 'sine');
      return;
    }
    if (kind === 'check') {
      pkTone(ctx, 494, t, 0.08, 0.05, 'sine');
      return;
    }
    if (kind === 'call' || kind === 'chips') {
      pkNoise(ctx, t, 0.07, 0.09, 1400);
      pkTone(ctx, 620, t, 0.06, 0.04, 'square');
      pkNoise(ctx, t + 0.05, 0.05, 0.05, 900);
      return;
    }
    if (kind === 'bet') {
      pkNoise(ctx, t, 0.08, 0.1, 1500);
      pkTone(ctx, 392, t, 0.08, 0.05, 'triangle');
      pkTone(ctx, 523, t + 0.07, 0.1, 0.05, 'triangle');
      return;
    }
    if (kind === 'raise') {
      pkNoise(ctx, t, 0.08, 0.1, 1600);
      pkTone(ctx, 523.25, t, 0.08, 0.055, 'triangle');
      pkTone(ctx, 659.25, t + 0.08, 0.1, 0.06, 'triangle');
      pkTone(ctx, 783.99, t + 0.16, 0.14, 0.07, 'triangle');
      return;
    }
    if (kind === 'allin') {
      pkNoise(ctx, t, 0.14, 0.11, 800);
      pkTone(ctx, 196, t, 0.1, 0.055, 'sawtooth');
      pkTone(ctx, 392, t + 0.1, 0.12, 0.07, 'triangle');
      pkTone(ctx, 784, t + 0.22, 0.2, 0.08, 'triangle');
      return;
    }
    if (kind === 'reveal') {
      pkTone(ctx, 392, t, 0.1, 0.05, 'triangle');
      pkTone(ctx, 523, t + 0.1, 0.1, 0.06, 'triangle');
      pkTone(ctx, 659, t + 0.2, 0.16, 0.07, 'triangle');
      return;
    }
    if (kind === 'win') {
      pkTone(ctx, 523.25, t, 0.12, 0.06, 'triangle');
      pkTone(ctx, 659.25, t + 0.1, 0.12, 0.07, 'triangle');
      pkTone(ctx, 783.99, t + 0.2, 0.22, 0.08, 'triangle');
      pkTone(ctx, 1046.5, t + 0.36, 0.18, 0.05, 'sine');
    }
  }
  function pkSayKind(text) {
    const s = String(text || '');
    if (s.indexOf('หมอบ') === 0) return 'fold';
    if (s.indexOf('ผ่าน') === 0) return 'check';
    if (s.indexOf('หมดหน้าตัก') === 0) return 'allin';
    if (s.indexOf('เกทับ') === 0) return 'raise';
    if (s.indexOf('สู้') === 0) return 'bet';
    if (s.indexOf('ตาม') === 0) return 'call';
    return 'chips';
  }
  (function bindPkAudio() {
    const unlock = function() { pkAudio(); };
    document.addEventListener('pointerdown', unlock, { once: true });
    document.addEventListener('keydown', unlock, { once: true });
  })();
  function avatarHtml(player, size) {
    if (typeof window.renderPlayerAvatar === 'function') {
      return window.renderPlayerAvatar({ avatar: player.avatar, avatarFrame: player.avatarFrame, color: player.color, playerName: player.name }, { size: size || 26 });
    }
    return '<span>' + escapeHtml(player.avatar || '👤') + '</span>';
  }
  function cardHtml(card, extra) {
    const src = card && card.image ? card.image : (currentState.cardBack || '/assets/games/poker/back.svg');
    const key = extra && extra.handKey ? ' data-hand-key="' + escapeHtml(extra.handKey) + '" data-card-id="' + escapeHtml(card.id) + '"' : '';
    const cls = 'pk-playing' + (extra && extra.pick ? ' is-pick' : '') + (extra && extra.selected ? ' is-selected' : '') + (extra && extra.best ? ' is-best' : '');
    return '<div class="' + cls + '"' + key + '><img src="' + escapeHtml(src) + '" alt="' + escapeHtml((card && card.thaiName) || 'ไพ่') + '"></div>';
  }
  function backHtml() {
    return '<div class="pk-playing"><img src="' + escapeHtml((currentState && currentState.cardBack) || '/assets/games/poker/back.svg') + '" alt="ไพ่คว่ำ"></div>';
  }
  function seatDeg(index, total) {
    if (index === 0) return 270;
    const others = Math.max(total - 1, 1);
    let start = 205;
    let end = -25;
    if (others === 1) {
      start = 90;
      end = 90;
    } else if (others === 2) {
      start = 155;
      end = 25;
    } else if (others === 3) {
      start = 162;
      end = 18;
    } else if (others <= 5) {
      start = 188;
      end = -8;
    } else if (others <= 7) {
      start = 198;
      end = -18;
    }
    const t = others === 1 ? 0 : (index - 1) / (others - 1);
    return start - t * (start - end);
  }
  function seatPos(index, total) {
    const deg = seatDeg(index, total);
    const rad = deg * Math.PI / 180;
    const rx = total <= 4 ? 46 : (total >= 9 ? 48 : (total >= 7 ? 44 : 42));
    const ry = total <= 4 ? 36 : (total >= 9 ? 38 : (total >= 7 ? 32 : 28));
    if (index === 0) {
      return { left: '50%', top: total >= 8 ? '84%' : '80%' };
    }
    let left = 50 + rx * Math.cos(rad);
    let top = 50 - ry * Math.sin(rad);
    if (total > 2 && top < 24 && Math.abs(left - 50) < 14) {
      left = left < 50 ? 34 : 66;
      top = Math.min(top, 16);
    } else if (top < 22) {
      top = Math.min(top, 15);
    }
    return {
      left: left.toFixed(2) + '%',
      top: top.toFixed(2) + '%'
    };
  }
  function seatBand(index, total) {
    if (index === 0) return 'south';
    const deg = ((seatDeg(index, total) % 360) + 360) % 360;
    if (deg >= 48 && deg <= 132) return 'north';
    if (deg > 132 && deg < 228) return 'west';
    if (deg >= 228 && deg <= 312) return 'south';
    return 'east';
  }
  function peekCardsOf(p, state) {
    if (!state || !state.debugPeek) return null;
    const max = holeSize(p, state) || 3;
    if (p.peekCards && p.peekCards.length) return p.peekCards.slice(0, max);
    if (p.ready && p.peekKept && p.peekKept.length) return p.peekKept.slice(0, max);
    if (p.peekHand && p.peekHand.length && !p.ready && state.phase === 'select') {
      return p.peekHand.slice(0, state.dealCount || p.peekHand.length);
    }
    return null;
  }
  function holeSize(p, state) {
    if (p.folded) return 0;
    const afterPick = !!(p.ready || ['bet', 'deal3', 'reveal', 'between'].indexOf(state.phase) >= 0);
    if (!afterPick) return Math.min(p.handCount || state.dealCount || 5, state.dealCount || 5);
    if (state.phase === 'bet' && state.mode === 'poker4') return Math.min(p.handCount || 2, 2);
    return Math.min(p.handCount || 3, 3);
  }
  function peekCardMeta(card) {
    if (typeof card === 'string') {
      return { rank: card.slice(0, -1), suit: card.slice(-1) };
    }
    if (card && card.rank && card.suit) return { rank: card.rank, suit: card.suit };
    const id = String((card && card.id) || '');
    if (id.length >= 2) return { rank: id.slice(0, -1), suit: id.slice(-1) };
    return null;
  }
  function peekCardPoint(rank) {
    if (rank === 'A') return 1;
    if (rank === '10' || rank === 'J' || rank === 'Q' || rank === 'K') return 0;
    const n = Number(rank);
    return n >= 2 && n <= 9 ? n : 0;
  }
  function peekCardStraight(rank) {
    const map = { A: 13, K: 12, Q: 11, J: 10, '10': 9, '9': 8, '8': 7, '7': 6, '6': 5, '5': 4, '4': 3, '3': 2, '2': 1 };
    return map[rank] || 0;
  }
  function evalThreePeek(cards) {
    const ranks = cards.map(function(c) { return c.rank; });
    const suits = cards.map(function(c) { return c.suit; });
    const trips = ranks[0] === ranks[1] && ranks[1] === ranks[2];
    const flush = suits[0] === suits[1] && suits[1] === suits[2];
    const vals = cards.map(function(c) { return peekCardStraight(c.rank); }).sort(function(a, b) { return a - b; });
    const straight = new Set(vals).size === 3 && vals[1] === vals[0] + 1 && vals[2] === vals[1] + 1;
    const sean = ranks.every(function(r) { return r === 'J' || r === 'Q' || r === 'K'; });
    if (trips) return 'ตอง';
    if (straight && flush) return 'เรียงสี';
    if (sean) return 'เซียน';
    if (straight) return 'เรียง';
    if (flush) return 'สี';
    const pts = cards.reduce(function(sum, c) { return sum + peekCardPoint(c.rank); }, 0) % 10;
    return pts + ' แต้ม';
  }
  function peekThreeScore(label) {
    if (label === 'ตอง') return 600;
    if (label === 'เรียงสี') return 500;
    if (label === 'เซียน') return 400;
    if (label === 'เรียง') return 300;
    if (label === 'สี') return 200;
    const m = String(label).match(/(\d+)/);
    return 100 + (m ? Number(m[1]) : 0);
  }
  function rankFromPeekCards(cards) {
    if (!cards || !cards.length) return '';
    const parsed = cards.map(peekCardMeta).filter(Boolean);
    if (parsed.length < 2) return '';
    if (parsed.length === 2) {
      const pts = parsed.reduce(function(sum, c) { return sum + peekCardPoint(c.rank); }, 0) % 10;
      return pts + ' แต้ม';
    }
    if (parsed.length === 3) return evalThreePeek(parsed);
    let best = '';
    let bestScore = -1;
    for (let i = 0; i < parsed.length; i += 1) {
      for (let j = i + 1; j < parsed.length; j += 1) {
        for (let k = j + 1; k < parsed.length; k += 1) {
          const label = evalThreePeek([parsed[i], parsed[j], parsed[k]]);
          const score = peekThreeScore(label);
          if (score > bestScore) {
            bestScore = score;
            best = label;
          }
        }
      }
    }
    return best;
  }
  function peekOnlyRank(p) {
    if (p.folded) return 'หมอบ';
    const cat = p.peekCategory || '';
    if (cat === 'ตอง' || cat === 'เรียงสี' || cat === 'เซียน' || cat === 'เรียง' || cat === 'สี') return cat;
    const title = String(p.peekTitle || '');
    if (title.indexOf('เรียงสี') === 0) return 'เรียงสี';
    if (title.indexOf('เซียน') === 0) return 'เซียน';
    if (title.indexOf('ตอง') === 0) return 'ตอง';
    if (title.indexOf('เรียง') === 0) return 'เรียง';
    if (/^สี/.test(title) && title.indexOf('เรียงสี') !== 0) return 'สี';
    if (p.peekTitle || p.peekCategory) {
      const text = formatHandLabel(p.peekTitle, p.peekCategory);
      if (/แต้ม/.test(text)) {
        const m = String(text).match(/(\d+)/);
        return m ? m[1] + ' แต้ม' : 'แต้ม';
      }
      return text;
    }
    return '';
  }
  function isShowdown(state) {
    return state.phase === 'reveal' || state.phase === 'between';
  }
  function formatHandLabel(title, categoryName) {
    const cat = categoryName || '';
    const text = String(title || '');
    if (cat === 'ไม่มีไพ่') return '';
    if (cat === 'รอใบที่ 3' || /รอใบที่ 3/.test(text)) {
      const m = text.match(/(\d+)/);
      return m ? m[1] + ' แต้ม · รอใบ 3' : 'รอใบที่ 3';
    }
    if (cat === 'แต้ม' || /^แต้ม/.test(text)) {
      const m = text.match(/(\d+)/);
      return m ? m[1] + ' แต้ม' : (text || 'แต้ม');
    }
    if (cat === 'สี' || (/^สี/.test(text) && text.indexOf('เรียงสี') !== 0)) return 'ไพ่สี';
    if (cat === 'เรียงสี' || text.indexOf('เรียงสี') === 0) return text.indexOf('เรียงสี') === 0 ? text : 'เรียงสี';
    if (cat === 'เซียน' || text.indexOf('เซียน') === 0) return text.indexOf('เซียน') === 0 ? text : 'เซียน';
    if (cat === 'ตอง' || text.indexOf('ตอง') === 0) return text.indexOf('ตอง') === 0 ? text : 'ตอง';
    if (cat === 'เรียง' || text.indexOf('เรียง') === 0) return text.indexOf('เรียง') === 0 ? text : 'เรียง';
    return text;
  }
  function peekRankText(p, state) {
    if (p.folded) return 'หมอบ';
    const cat = p.peekCategory || p.showCategory || '';
    if (cat === 'ตอง' || cat === 'เรียงสี' || cat === 'เซียน' || cat === 'เรียง' || cat === 'สี') return cat;
    const title = p.peekTitle || p.showTitle || (p.isSelf && state.liveHand && state.liveHand.title) || '';
    if (String(title).indexOf('เรียงสี') === 0) return 'เรียงสี';
    if (String(title).indexOf('เซียน') === 0) return 'เซียน';
    if (String(title).indexOf('ตอง') === 0) return 'ตอง';
    if (String(title).indexOf('เรียง') === 0) return 'เรียง';
    if (/^สี/.test(title) && String(title).indexOf('เรียงสี') !== 0) return 'สี';
    if (p.peekTitle || p.peekCategory) return formatHandLabel(p.peekTitle, p.peekCategory);
    if (p.showTitle || p.showCategory) return formatHandLabel(p.showTitle, p.showCategory);
    if (p.isSelf && state.liveHand) {
      const liveCat = state.liveHand.categoryName || '';
      if (liveCat === 'ตอง' || liveCat === 'เรียงสี' || liveCat === 'เซียน' || liveCat === 'เรียง' || liveCat === 'สี') return liveCat;
      return formatHandLabel(state.liveHand.title, liveCat);
    }
    return '';
  }
  function pillText(p, state) {
    if (p.folded) return 'หมอบ';
    if (state.debugPeek) return peekRankText(p, state);
    if (p.showTitle || p.showCategory) return formatHandLabel(p.showTitle, p.showCategory);
    if (p.bestName) return formatHandLabel(p.bestName, p.showCategory);
    if (p.isSelf && state.liveHand) {
      return formatHandLabel(state.liveHand.title, state.liveHand.categoryName);
    }
    return '';
  }
  function wrapCard(html, extra) {
    const up = extra && (extra.selected || extra.best) ? ' is-up' : '';
    return '<div class="pk-fan-slot' + up + '">' + html + '</div>';
  }
  function autoSelectDiscard(state, actions) {
    if (!actions.canSelect || state.phase !== 'select') {
      selectAutoKey = '';
      return;
    }
    const hand = (state.self && state.self.hand) || [];
    const key = String(state.handNumber || 0) + ':' + hand.map(function(card) { return card.id; }).join(',');
    if (key === selectAutoKey) return;
    selectAutoKey = key;
    const maxPick = actions.selectCount || 2;
    const keepLeft = {};
    ((state.liveHand && state.liveHand.cards) || []).forEach(function(card) {
      keepLeft[card.id] = (keepLeft[card.id] || 0) + 1;
    });
    selectedIds = [];
    hand.forEach(function(card, index) {
      if (keepLeft[card.id] > 0) {
        keepLeft[card.id] -= 1;
        return;
      }
      if (selectedIds.length < maxPick) selectedIds.push(card.id + ':' + index);
    });
  }
  function seatCardsHtml(p, state) {
    if (p.isSelf) return '';
    if (p.revealed && p.revealed.length) {
      return p.revealed.slice(0, 3).map(function(c) { return wrapCard(cardHtml(c)); }).join('');
    }
    const peekCards = peekCardsOf(p, state);
    if (peekCards && peekCards.length) {
      const shown = peekCards.slice(0, holeSize(p, state) || peekCards.length);
      return shown.map(function(c) { return wrapCard(cardHtml(c)); }).join('');
    }
    if (p.upCard && state.phase === 'deal3') {
      return wrapCard(backHtml()) + wrapCard(backHtml()) + wrapCard(cardHtml(p.upCard));
    }
    if (p.folded) return '';
    const n = holeSize(p, state);
    const cap = (state.players || []).length >= 7 ? 2 : n;
    return Array.from({ length: Math.min(n, cap) }, function() { return wrapCard(backHtml()); }).join('');
  }
  function seatView(p, index, state, seated) {
    const showdown = isShowdown(state);
    const peekCards = peekCardsOf(p, state);
    const cards = seatCardsHtml(p, state);
    const acting = state.phase === 'bet' && p.isTurn;
    const showing = !!(p.revealed && p.revealed.length);
    const peeking = !!(state.debugPeek && peekCards && peekCards.length);

    const packed = seated.length >= 7;
    $('.pk-table').toggleClass('is-packed', packed).toggleClass('is-full', seated.length >= 9);
    renderSeats(seated, state);
    seated.forEach(function(p) {
      if (p.lastSay) seenSaySeq[p.playerId] = Number(p.lastSaySeq) || 0;
      else delete seenSaySeq[p.playerId];
    });
    if (!showdown) {
      $('#pkBetChips').html(seated.map(function(p, index) {
        const amt = Number(p.committed) || Number(p.streetBet) || 0;
        if (!amt) return '';
        const pos = chipPos(index, seated.length);
        return chipStackHtml(amt, 'is-drop', 'left:' + pos.left + ';top:' + pos.top);
      }).join(''));
    } else {
      $('#pkBetChips').empty();
    }
    const winName = state.winner && state.winner.name;
    const selfWon = showdown && (state.players || []).some(function(p) { return p.isSelf && p.isWinner; });
    const me = (state.players || []).find(function(p) { return p.isSelf; }) || { isSelf: true, folded: !!(state.self && state.self.folded) };
    const selfPill = pillText(me, state);
    if (showdown && winName) {
      $('#pkWinBanner').text(selfWon ? 'คุณชนะ' : winName + ' ชนะ').prop('hidden', false);
    } else {
      $('#pkWinBanner').prop('hidden', true).text('');
    }
    $('#pkShow').empty();
    const hand = visibleHand(state, showdown);
    const maxPick = actions.selectCount || 2;
    const liveIds = (state.liveHand && state.liveHand.cards || []).map(function(card) { return card.id; });
    const liveTitle = state.liveHand && (state.liveHand.title || state.liveHand.categoryName);
    const rankLabel = selfPill || formatHandLabel(liveTitle, state.liveHand && state.liveHand.categoryName);
    if (showdown && state.self && state.self.folded) {
      $('#pkHint').text('คุณหมอบแล้ว');
    } else if (showdown) {
      $('#pkHint').text(selfWon ? 'ชนะมือนี้' : (selfPill || liveTitle || 'เปิดไพ่แล้ว'));
    } else if (state.self && state.self.folded) {
      $('#pkHint').text('คุณหมอบแล้ว รอเปิดเทียบ');
    } else if (state.self && state.self.ready) {
      $('#pkHint').text(rankLabel ? ('เลือกแล้ว · ' + rankLabel) : 'เลือกแล้ว รอคนอื่น');
    } else if (rankLabel) {
      $('#pkHint').text('มือคุณ: ' + rankLabel + (actions.canSelect ? ' — เลือกทิ้งใบอ่อนสุดให้แล้ว' : ''));
    } else {
      $('#pkHint').text('');
    }
    $('#myHand').toggleClass('is-showdown', !!(showdown || (state.self && state.self.ready && !actions.canSelect)));
    $('#myHand').toggleClass('is-picking', !!(actions.canSelect && !showdown));
    const handSig = hand.map(function(card) { return card.id; }).join(',') + '|' + selectedIds.join(',') + '|' + (!!actions.canSelect) + '|' + (!!showdown) + '|' + (rankLabel || '') + '|' + (!!selfWon);
    if (handSig !== lastHandSig) {
      lastHandSig = handSig;
      if (!hand.length) {
        $('#myHand').html('<div class="pk-empty">ไม่มีไพ่ในมือ</div>');
      } else {
        const showRibbon = rankLabel && (showdown || (state.self && state.self.ready));
        $('#myHand').html(hand.map(function(card, index) {
          const key = card.id + ':' + index;
          const extra = {
            pick: actions.canSelect && !showdown,
            selected: !showdown && selectedIds.indexOf(key) >= 0,
            best: !!(actions.canSelect && liveIds.indexOf(card.id) >= 0 && selectedIds.indexOf(key) < 0),
            handKey: key
          };
          return wrapCard(cardHtml(card, extra), extra);
        }).join('') + (showRibbon ? '<div class="pk-win-ribbon' + (selfWon ? '' : ' is-rank') + '">' + escapeHtml(selfWon ? (rankLabel || 'ชนะ') : rankLabel) + '</div>' : ''));
      }
    }
    let buttons = '';
    if (actions.canSelect) {
      buttons += '<button type="button" id="pkSelectBtn" class="pk-btn pk-btn-play"' + (selectedIds.length === maxPick ? '' : ' disabled') + '>' +
        (actions.selectMode === 'discard' ? 'ทิ้งคืนกลาง' : 'ลงมือนี้') + (selectedIds.length ? ' ×' + selectedIds.length : '') + '</button>';
    }
    if (actions.canFold) buttons += '<button type="button" class="pk-btn pk-btn-fold" data-pk-bet="fold">หมอบ</button>';
    if (actions.canCheck) buttons += '<button type="button" class="pk-btn pk-btn-pass" data-pk-bet="check">ผ่าน</button>';
    if (actions.canCall) buttons += '<button type="button" class="pk-btn pk-btn-call" data-pk-bet="call">ตาม ' + (actions.callAmount || 0) + '</button>';
    if (actions.canBet || actions.canRaise) {
      const isRaise = !!actions.canRaise;
      const minAmt = isRaise ? (actions.minRaiseTo || 0) : (actions.minBet || 500);
      const maxAmt = isRaise ? (actions.maxRaiseTo || minAmt) : (actions.maxBet || minAmt);
      const key = (state.handNumber || 0) + '-' + state.phase + '-' + (isRaise ? 'raise' : 'bet');
      if (key !== chipPhaseKey) {
        chipPhaseKey = key;
        chipAmount = minAmt;
      }
      chipAmount = Math.max(minAmt, Math.min(maxAmt, chipAmount || minAmt));
      buttons += '<div class="pk-chip-row">' +
        '<button type="button" class="pk-chip-step" id="pkChipMinus"' + (chipAmount <= minAmt ? ' disabled' : '') + '>−</button>' +
        '<span class="pk-chip-amt" id="pkChipAmt">' + chipAmount + '</span>' +
        '<button type="button" class="pk-chip-step" id="pkChipPlus"' + (chipAmount >= maxAmt ? ' disabled' : '') + '>+</button>' +
        '<button type="button" class="pk-btn ' + (isRaise ? 'pk-btn-raise' : 'pk-btn-call') + '" data-pk-bet="' + (isRaise ? 'raise' : 'bet') + '" data-pk-amt="' + chipAmount + '">' +
        (isRaise ? 'เกทับ' : 'สู้') + '</button></div>';
    }
    if (actions.canAllIn) buttons += '<button type="button" class="pk-btn pk-btn-allin" data-pk-bet="allin">หมดหน้าตัก</button>';
    if (actions.canNext && isRoomAdmin) buttons += '<button type="button" id="pkNextBtn" class="pk-btn pk-btn-play">มือถัดไป</button>';
    const actionSig = [state.phase, !!actions.toAct, !!actions.canSelect, selectedIds.length, maxPick, !!actions.canFold, !!actions.canCheck, !!actions.canCall, actions.callAmount || 0, !!actions.canBet, !!actions.canRaise, !!actions.canAllIn, chipAmount, actions.minRaiseTo || 0, actions.minBet || 0].join('|');
    if (actionSig !== lastActionSig) {
      lastActionSig = actionSig;
      $('#actionArea').html('<div class="pk-actions">' + buttons + '</div>');
    }
    $('#historyFeed').html((state.history || []).slice(0, 1).map(function(item) {
      return escapeHtml((item.icon || '') + ' ' + (item.text || ''));
    }).join(''));
    tickTimer(state);
    if (window.partyPlay && (actions.toAct || actions.canSelect)) {
      window.partyPlay.pingTurn({
        key: (state.handNumber || 0) + '-' + state.phase + '-' + (state.toActPlayerId || playerId),
        title: actions.toAct ? 'ตาคุณลงชิป' : 'เลือกไพ่ที่จะทิ้ง',
        sub: actions.toAct ? 'สู้ ตาม เกทับ หมอบได้' : 'ทิ้ง 2 ใบคืนกลาง'
      });
    }
    if (state.phase === 'reveal' && state.lastResult) flash((state.lastResult.handTitle || state.lastResult.handName || 'เปิดไพ่') + ' · ' + ((state.winner && state.winner.name) || ''));
    const peekBox = document.getElementById('pkPeekAll');
    if (peekBox && peekBox.checked !== !!state.debugPeek) peekBox.checked = !!state.debugPeek;
    if (!state.canDebug) document.getElementById('pkDebug').hidden = true;
    renderRankGuide(state);
    moveTurnToken(state.phase === 'bet' ? state.toActPlayerId : '');
    paintTurnRing(state);
    playFx(state);
    const mineTurn = !!(actions.toAct && state.phase === 'bet');
    const turnKey = mineTurn ? ((state.handNumber || 0) + '-' + (state.toActPlayerId || '') + '-' + state.phase) : '';
    if (mineTurn && turnKey && turnKey !== lastTurnSoundKey) pkSfx('turn');
    lastTurnSoundKey = turnKey;
  }

  function renderRankGuide(state) {
    const live = state.liveHand || {};
    const liveTitle = live.title || live.categoryName;
    $('#pkRankYou').html(liveTitle
      ? '<span>มือคุณตอนนี้</span>' + escapeHtml(liveTitle)
      : '<span>มือคุณตอนนี้</span>ยังไม่มีไพ่');
    $('#pkRankList').html(window.pokerRankChart
      ? window.pokerRankChart.chartHtml(state.rankGuide, true)
      : '');
  }

  function setRankOpen(open) {
    $('#pkRankDrawer').toggleClass('open', open).attr('aria-hidden', open ? 'false' : 'true');
    $('#pkRankOverlay').toggleClass('open', open);
    $('#pkRankTab').attr('aria-expanded', open ? 'true' : 'false');
  }

  function send(eventName, payload) {
    socket.emit(eventName, Object.assign({ roomId: roomId, playerId: playerId }, payload || {}), function(res) {
      if (res && !res.success) Swal.fire({ icon: 'error', title: res.error || 'ไม่สำเร็จ', background: '#102016', color: '#fff' });
    });
  }

  $(document).on('click', '#myHand .pk-playing.is-pick', function() {
    const key = this.getAttribute('data-hand-key');
    const maxPick = (currentState.availableActions && currentState.availableActions.selectCount) || 2;
    const at = selectedIds.indexOf(key);
    if (at >= 0) selectedIds.splice(at, 1);
    else if (selectedIds.length < maxPick) selectedIds.push(key);
    renderState(currentState);
  });
  $(document).on('click', '#pkSelectBtn', function() {
    const pile = document.getElementById('pkBoard') || document.getElementById('pkPot');
    const to = pile ? pile.getBoundingClientRect() : null;
    skipSelfDiscardFx = true;
    pkSfx('discard');
    selectedIds.forEach(function(key, i) {
      const node = document.querySelector('#myHand [data-hand-key="' + key + '"]');
      if (node && to) {
        setTimeout(function() { flyTo(node.getBoundingClientRect(), to, node.outerHTML); }, i * 60);
      }
    });
    send('poker_select', { cardIds: selectedIds.map(function(key) { return key.split(':')[0]; }) });
  });
  $(document).on('click', '[data-pk-bet]', function() {
    const action = this.getAttribute('data-pk-bet');
    const sayMap = { fold: 'หมอบ', check: 'ผ่าน', call: 'ตาม', bet: 'สู้', raise: 'เกทับ', allin: 'หมดหน้าตัก' };
    pkSfx(pkSayKind(sayMap[action] || ''));
    send('poker_bet', { action: action, amount: Number(this.getAttribute('data-pk-amt')) || 0 });
  });
  $(document).on('click', '#pkChipMinus, #pkChipPlus', function() {
    const actions = (currentState && currentState.availableActions) || {};
    const isRaise = !!actions.canRaise;
    const minAmt = isRaise ? (actions.minRaiseTo || 0) : (actions.minBet || 500);
    const maxAmt = isRaise ? (actions.maxRaiseTo || minAmt) : (actions.maxBet || minAmt);
    const step = actions.minBet || 500;
    if (this.id === 'pkChipMinus') chipAmount = Math.max(minAmt, (chipAmount || minAmt) - step);
    else chipAmount = Math.min(maxAmt, (chipAmount || minAmt) + step);
    renderState(currentState);
  });
  $(document).on('click', '#pkNextBtn', function() { send('poker_nextHand'); });
  $('#pkClaimBtn').on('click', function() {
    socket.emit('wallet_claimDaily', {}, function(res) {
      if (!res || !res.success) {
        Swal.fire({ icon: 'error', title: (res && res.error) || 'รับไม่ได้', background: '#102016', color: '#fff' });
        return;
      }
      $('#pkWallet').text('ชิป ' + res.wallet.balance);
      $('#pkClaimBtn').hide();
    });
  });
  $('#pkHowToOpen').on('click', function() {
    const poker4 = currentState.mode === 'poker4';
    const html = window.pokerRankChart
      ? window.pokerRankChart.guideHtml(currentState.mode, currentState.rankGuide)
      : '';
    Swal.fire({
      title: poker4 ? '♦ สี่ใบเก' : '♠ ไพ่ 5 ใบ',
      html: html,
      background: '#102016',
      color: '#fff',
      confirmButtonColor: '#d4a017',
      confirmButtonText: 'เข้าใจแล้ว',
      width: 'min(640px, 96vw)',
      customClass: { popup: 'pk-rank-popup' }
    });
  });
  $(document).on('click', '#pkRankTab', function(event) {
    event.preventDefault();
    event.stopPropagation();
    setRankOpen(!$('#pkRankDrawer').hasClass('open'));
  });
  $(document).on('click', '#pkRankClose, #pkRankOverlay', function() { setRankOpen(false); });
  function goToWaitingRoom() {
    allowNavigation = true;
    window.location.href = '/room/' + roomId + '?playerId=' + playerId;
  }
  function goToRoomList() {
    allowNavigation = true;
    window.location.href = '/rooms?playerId=' + playerId;
  }
  $('#pkEndGameBtn').on('click', function() {
    Swal.fire({ icon: 'warning', title: 'จบเกมและกลับห้องรอ?', text: 'ทุกคนจะถูกส่งกลับห้องรอ', showCancelButton: true, confirmButtonText: 'กลับห้องรอ', cancelButtonText: 'ยกเลิก', background: '#102016', color: '#fff' })
      .then(function(result) {
        if (!result.isConfirmed) return;
        socket.emit('endTableSession', { roomId: roomId, playerId: playerId }, function(res) {
          if (res && res.success === false) {
            Swal.fire({ icon: 'error', title: res.error || 'จบเกมไม่สำเร็จ', background: '#102016', color: '#fff' });
            return;
          }
          goToWaitingRoom();
        });
      });
  });
  function toggleSidebar() { $('#playerSidebar').toggleClass('open'); $('#sidebarOverlay').toggle(); }
  $('#pkSidebarBtn, #closeSidebarBtn, #sidebarOverlay').on('click', toggleSidebar);
  $('#pkLeaveRoomBtn, #leaveRoomBtn').on('click', function() {
    Swal.fire({ icon: 'question', title: 'ออกจากห้อง?', text: 'ออกจากห้องนี้ ไม่ใช่แค่กลับห้องรอ', showCancelButton: true, confirmButtonText: 'ออก', cancelButtonText: 'ยกเลิก', background: '#102016', color: '#fff' })
      .then(function(result) {
        if (result.isConfirmed) { allowNavigation = true; socket.emit('leaveRoom', { roomId: roomId, playerId: playerId }, function() { goToRoomList(); }); }
      });
  });
  window.addEventListener('beforeunload', function(event) { if (!allowNavigation) event.preventDefault(); });
  socket.on('connect', function() {
    $('#connectionStatus').hide();
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId: roomId, playerId: playerId });
    socket.emit('poker_requestState', { roomId: roomId, playerId: playerId });
  });
  socket.on('disconnect', function() { $('#connectionStatus').show(); });
  socket.on('pokerState', renderState);
  socket.on('roomUpdate', function(data) {
    if (!data || !data.players) return;
    $('#onlinePlayerList').html(data.players.map(function(p) {
      return '<li style="display:flex;align-items:center;gap:8px;padding:6px 0;">' + avatarHtml({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: p.color, name: p.displayName || p.playerName }, 26) +
        '<span style="color:' + escapeHtml(p.color || '#fff') + '">' + escapeHtml(p.displayName || p.playerName) + '</span></li>';
    }).join(''));
  });
  socket.on('redirectToLobby', goToWaitingRoom);
  socket.on('restartGame', goToWaitingRoom);
  socket.on('gameStarting', function() { allowNavigation = true; window.location.href = '/game/' + roomId + '?playerId=' + playerId; });
  socket.on('kickedFromRoom', function(data) {
    allowNavigation = true;
    Swal.fire({ icon: 'error', title: 'ถูกเตะออกจากห้อง', text: data && data.reason || '', background: '#102016', color: '#fff' })
      .then(function() { goToRoomList(); });
  });
  window.initChatPanel({
    socket: socket,
    playerId: playerId,
    playerName: playerName,
    onCommand: function(text) {
      if (text.trim().toLowerCase() !== '/m') return false;
      if (!currentState || !currentState.canDebug) {
        Swal.fire({ icon: 'error', title: '/m ใช้ได้เฉพาะแอดมินหรือหัวห้อง', background: '#102016', color: '#fff' });
        return true;
      }
      const panel = document.getElementById('pkDebug');
      const toggle = document.getElementById('pkDebugToggle');
      if (panel) {
        panel.hidden = false;
        panel.classList.remove('is-min');
      }
      if (toggle) {
        toggle.textContent = '✕';
        toggle.setAttribute('aria-label', 'ย่อ');
      }
      return true;
    }
  });
  (function bindDebugPanel() {
    const panel = document.getElementById('pkDebug');
    const head = document.getElementById('pkDebugHead');
    const toggle = document.getElementById('pkDebugToggle');
    if (!panel || !head || !toggle) return;
    let drag = null;
    function setMin(min) {
      panel.classList.toggle('is-min', min);
      toggle.textContent = min ? '+' : '✕';
      toggle.setAttribute('aria-label', min ? 'ขยาย' : 'ย่อ');
    }
    head.addEventListener('pointerdown', function(ev) {
      if (ev.target.closest('button')) return;
      const rect = panel.getBoundingClientRect();
      drag = { x: ev.clientX, y: ev.clientY, left: rect.left, top: rect.top, moved: false };
      head.setPointerCapture(ev.pointerId);
    });
    head.addEventListener('pointermove', function(ev) {
      if (!drag) return;
      const dx = ev.clientX - drag.x;
      const dy = ev.clientY - drag.y;
      if (!drag.moved && (dx * dx + dy * dy) < 36) return;
      drag.moved = true;
      const left = Math.max(0, Math.min(window.innerWidth - panel.offsetWidth, drag.left + dx));
      const top = Math.max(0, Math.min(window.innerHeight - panel.offsetHeight, drag.top + dy));
      panel.style.left = left + 'px';
      panel.style.top = top + 'px';
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
    });
    head.addEventListener('pointerup', function() {
      if (drag && !drag.moved && panel.classList.contains('is-min')) setMin(false);
      drag = null;
    });
    toggle.addEventListener('click', function(ev) {
      ev.preventDefault();
      ev.stopPropagation();
      setMin(!panel.classList.contains('is-min'));
    });
  })();
  $('#pkPeekAll').on('change', function() {
    send('poker_debug_peek', { enabled: this.checked });
  });
  $('#pkCheatBtn').on('click', function() {
    send('poker_debug_credit', { amount: Number(document.getElementById('pkCheatAmt').value) || 1000 });
  });
  if (currentState && currentState.phase) renderState(currentState);
});
</script>

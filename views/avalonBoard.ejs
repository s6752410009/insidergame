</div>
<button type="button" id="toggleChat" class="chat-toggle" aria-expanded="false" aria-controls="chatBox">
  💬 แชท <span id="chatUnreadDot" class="unread-dot" style="display:none;"></span>
</button>

<%- contentFor('script') %>
<script src="/js/chatPanel.js"></script>
<script src="/js/roomExit.js"></script>
<script>
$(function() {
  document.documentElement.classList.add('av-active');

  const socket = io({ reconnection: true, reconnectionAttempts: Infinity, transports: ['websocket', 'polling'] });
  const roomId = '<%= room.roomId %>';
  const playerId = '<%= player.playerId %>';
  const playerName = <%- JSON.stringify(player.name || '') %>;
  const isRoomAdmin = <%= room.admin === true ? 'true' : 'false' %>;
  if (window.partyPlay) window.partyPlay.startSession('avalon', socket);
  // ป้าย "ถึงตาคุณ" แบบเล็กบนสุดจอ — แบบเต็มจอเคยบังปุ่มท้า/ขวาง/โหวตกลางจอพอดี
  if (window.partyPlay && window.partyPlay.setCompactPing) window.partyPlay.setCompactPing(true);

  let S = <%- JSON.stringify(typeof avalonState !== 'undefined' && avalonState ? avalonState : {}).replace(/</g, '\\u003c') %>;
  let allowNavigation = false;
  let picks = [];
  let picksStep = -1;
  let assassinPick = null;
  let ladyPick = null;
  let roleOpen = false;
  let roleSeen = false;
  let sending = false;
  let timerHandle = null;
  let overlayTimer = null;
  let overlayKind = null;
  let seenFx = Math.max(0, ...((S && S.fx) || []).map(function(e) { return e.seq || 0; }));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ART = function(key) { return (S && S.art && S.art[key]) || ''; };

  const PHASE_LABEL = {
    night: '🌙 กลางคืน · ดูบท',
    team: '👑 เลือกทีม',
    vote: '🗳 โหวตทีม',
    quest: '⚔️ ออกภารกิจ',
    assassin: '🗡 ลอบสังหาร',
    lady: '🌊 นางแห่งทะเลสาบ',
    finished: '🏁 จบเกม'
  };

  function esc(text) {
    return String(text == null ? '' : text).replace(/[&<>"']/g, function(c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c];
    });
  }
  function avatarHtml(p, size) {
    if (typeof window.renderPlayerAvatar === 'function') {
      return window.renderPlayerAvatar({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: p.color, playerName: p.name }, { size: size || 34 });
    }
    return '<span>' + esc(p.avatar || '👤') + '</span>';
  }
  function player(id) { return ((S && S.players) || []).find(function(p) { return p.playerId === id; }) || null; }
  function nameOf(id) { const p = player(id); return p ? p.name : '-'; }
  function me() { return S && S.self; }
  function quest() { return S && S.currentQuest; }

  /* ------------------------------------------------------------ status */
  function describeNow() {
    const self = me() || {};
    const q = quest();
    const leader = nameOf(S.leaderId);
    const watching = !self.role || self.left;
    const seated = S.players.filter(function(p) { return !p.left; }).length;
    if (watching && S.phase === 'night') return { text: 'ผู้เล่นกำลังดูบทลับ — พร้อมแล้ว ' + (S.readyCount || 0) + '/' + seated, mine: false };
    if (watching && S.phase === 'vote') return { text: 'กำลังโหวตทีม — โหวตแล้ว ' + (S.votedCount || 0) + '/' + seated + ' คน', mine: false };
    switch (S.phase) {
      case 'night':
        return self.ready
          ? { text: 'พร้อมแล้ว — รอคนอื่น (' + (S.readyCount || 0) + '/' + S.players.filter(function(p) { return !p.left; }).length + ')', mine: false }
          : { text: 'แตะการ์ดดูบทของคุณเงียบ ๆ แล้วกดพร้อม', mine: true };
      case 'team':
        return self.canPickTeam
          ? { text: 'คุณเป็นหัวหน้า — เลือก ' + q.size + ' คนออกภารกิจ ' + q.number, mine: true }
          : { text: leader + ' กำลังเลือกทีม ' + q.size + ' คน — ช่วยกันเสนอได้', mine: false };
      case 'vote':
        return self.canVote
          ? { text: 'โหวตทีมของ ' + nameOf(S.proposal && S.proposal.leaderId) + ' — เห็นด้วยหรือคัดค้าน', mine: true }
          : { text: 'โหวตแล้ว — รออีก ' + Math.max(0, S.players.filter(function(p) { return !p.left; }).length - (S.votedCount || 0)) + ' คน', mine: false };
      case 'quest':
        if (self.canPlayQuest) return { text: 'คุณอยู่ในทีม — ลงการ์ดภารกิจแบบลับ', mine: true };
        return { text: 'ทีมกำลังออกภารกิจ ' + q.number + ' (' + (S.questPlayedCount || 0) + '/' + q.size + ' ลงแล้ว)', mine: false };
      case 'lady':
        if (self.canUseLady) return { text: 'คุณถือนางแห่งทะเลสาบ — เลือกส่องฝ่ายของ 1 คน', mine: true };
        return { text: nameOf(S.lady && S.lady.holderId) + ' กำลังใช้นางแห่งทะเลสาบส่องใครสักคน', mine: false };
      case 'assassin':
        if (self.canAssassinate) return { text: 'คุณคือมือสังหาร — แทงคนที่คิดว่าเป็นเมอร์ลิน', mine: true };
        if (self.team === 'evil') return { text: 'ช่วย ' + nameOf(S.assassinId) + ' เดาว่าใครคือเมอร์ลิน', mine: false };
        return { text: nameOf(S.assassinId) + ' (มือสังหาร) กำลังเล็ง — ทำหน้านิ่งไว้', mine: false };
      case 'finished':
        if (S.winner && S.winner.abandoned) return { text: 'เกมถูกยกเลิก — ผู้เล่นไม่พอ', mine: false };
        return { text: (S.winner && S.winner.team === 'good' ? 'ฝ่ายดีชนะ!' : 'ฝ่ายร้ายชนะ!'), mine: false };
      default:
        return { text: 'กำลังโหลด...', mine: false };
    }
  }

  function renderStatus() {
    const now = describeNow();
    $('#avPhase').text(PHASE_LABEL[S.phase] || '');
    $('#avNow').text(now.text);
    $('#avStatus').toggleClass('is-mine', !!now.mine);
  }

  function tickTimer() {
    if (timerHandle) clearInterval(timerHandle);
    function paint() {
      if (S.phase === 'finished') {
        $('#avStatusBar').prop('hidden', true);
        const endsAt = Number(S.returnLobbyEndsAt) || 0;
        const remain = endsAt ? Math.max(0, Math.ceil((endsAt - Date.now()) / 1000)) : 0;
        $('#avTimer').text(remain > 0 ? remain : '--').removeClass('is-low');
        $('#avTimerHint').text(remain > 0 ? 'วินาทีแล้วกลับห้องรอพร้อมกัน' : '');
        $('#avBackRemain').text(remain > 0 ? 'ระบบพากลับห้องรอใน ' + remain + ' วิ' : 'กำลังพากลับห้องรอ...');
        return;
      }
      if (!S.phaseEndsAt) {
        $('#avStatusBar').prop('hidden', true);
        $('#avTimer').text('--');
        $('#avTimerHint').text('');
        return;
      }
      const remain = Math.max(0, Math.ceil((S.phaseEndsAt - Date.now()) / 1000));
      const total = Number(S.phaseMs) || 0;
      if (total) {
        const ratio = Math.max(0, Math.min(1, (S.phaseEndsAt - Date.now()) / total));
        $('#avStatusBar').prop('hidden', false).toggleClass('is-low', remain <= 10).find('span').css('width', Math.round(ratio * 100) + '%');
      }
      const mm = Math.floor(remain / 60);
      const ss = String(remain % 60).padStart(2, '0');
      $('#avTimer').text(mm + ':' + ss).toggleClass('is-low', remain <= 10);
      // มือถือ: แถบติดขอบบนต้องเตี้ย — โชว์ "หมดเวลาแล้วเกิดอะไร" เฉพาะช่วงใกล้หมด (แถบเวลาบอกอยู่แล้ว)
      $('#avTimerHint').text(S.timeoutHint || '').toggleClass('is-calm', remain > 15);
    }
    paint();
    timerHandle = setInterval(paint, 250);
  }

  /* ------------------------------------------------------------ track */
  function renderTrack() {
    const quests = S.quests || [];
    $('#avTrack').html(quests.map(function(q, i) {
      const current = S.phase !== 'finished' && S.phase !== 'assassin' && i === S.questIndex && !q.result;
      const cls = 'av-quest' + (current ? ' is-current' : '') + (q.result ? ' is-done' : '');
      const img = q.result === 'success' ? '<img src="' + esc(ART('tokenSuccess')) + '" alt="">' : (q.result === 'fail' ? '<img src="' + esc(ART('tokenFail')) + '" alt="">' : '');
      const label = q.result === 'success' ? 'สำเร็จ' : (q.result === 'fail' ? 'ล้มเหลว' : (current ? 'ตอนนี้' : 'ภารกิจ ' + q.number));
      return '<div class="' + cls + '" aria-label="ภารกิจ ' + q.number + ' ใช้ ' + q.size + ' คน ' + (q.result ? label : '') + '">' +
        '<div class="av-quest-token">' + img + '<span class="av-quest-size">' + q.size + '</span><span class="av-quest-unit">คน</span>' +
        (q.failsNeeded > 1 && !q.result ? '<span class="av-two-fail" title="ต้องมีการ์ดล้ม 2 ใบถึงจะล้ม">ล้ม 2</span>' : '') +
        (q.result === 'fail' && q.failCount ? '<span class="av-fail-count" title="การ์ดล้ม">' + q.failCount + '</span>' : '') +
        '</div><span class="av-quest-label">' + label + '</span></div>';
    }).join(''));

    const n = Number(S.rejectCount || 0);
    const max = Number(S.maxRejects || 5);
    $('#avPips').html(Array.from({ length: max }, function(_, i) {
      return '<span class="av-pip' + (i < n ? ' is-on' : '') + (i === max - 1 ? ' is-last' : '') + '"></span>';
    }).join(''));
    $('#avRejectText').text(n + '/' + max + (n >= max - 1 && S.phase !== 'finished' ? ' · ครั้งหน้าไม่ผ่าน = ฝ่ายร้ายชนะ' : ''));

    const tc = S.teamCounts;
    const specials = (S.rolesInPlay || []).filter(function(r) { return r.id !== 'loyal' && r.id !== 'minion'; }).map(function(r) { return r.thaiName; });
    $('#avRolesLine').text(tc ? 'ฝ่ายดี ' + tc.good + ' · ฝ่ายร้าย ' + tc.evil + (specials.length ? ' · บทพิเศษ: ' + specials.join(', ') : '') +
      (S.lady ? ' · 🌊 นางแห่งทะเลสาบ (หลังภารกิจ 2–4)' : '') : '');
    renderRecap();

    const lv = S.lastVote;
    $('#avLastLine').text(lv
      ? 'โหวตล่าสุด (ภารกิจ ' + lv.questNumber + '): ' + (lv.approved ? 'ผ่าน ' : 'ไม่ผ่าน ') + lv.approveCount + ':' + lv.rejectCount
      : '');
  }

  /* ------------------------------------------------------------ quest recap */
  // ทีมของภารกิจที่จบแล้วเป็นข้อมูลสาธารณะ — ใครอยู่ในภารกิจที่ล้มคือหัวใจของการเดา
  function renderRecap() {
    const done = (S.quests || []).filter(function(q) { return q.result; });
    $('#avRecapWrap').prop('hidden', done.length === 0);
    if (S.phase === 'finished') $('#avRecapWrap').prop('open', true);
    $('#avRecapSummary').text('สรุปภารกิจ (' + done.length + ')');
    $('#avRecap').html(done.map(function(q) {
      const ok = q.result === 'success';
      const team = (q.teamIds || []).map(nameOf).join(', ');
      const verdict = ok
        ? 'สำเร็จ' + (q.failCount ? ' (มีการ์ดล้ม ' + q.failCount + ')' : '')
        : 'ล้ม · การ์ดล้ม ' + q.failCount + ' ใบ';
      return '<li class="' + (ok ? 'is-success' : 'is-fail') + '"><b>' + (ok ? '✓' : '✕') + ' ภารกิจ ' + q.number + '</b>' +
        '<span>' + esc(verdict) + (q.leaderId ? ' · หัวหน้า ' + esc(nameOf(q.leaderId)) : '') + '<br>ทีม: ' + esc(team || '-') + '</span></li>';
    }).join(''));
  }

  /* ------------------------------------------------------------ seats */
  function seatMode() {
    const self = me() || {};
    if (S.phase === 'team' && self.canPickTeam) return 'pick';
    if (S.phase === 'assassin' && self.canAssassinate) return 'stab';
    if (S.phase === 'lady' && self.canUseLady) return 'lady';
    return null;
  }

  function renderSeats() {
    const mode = seatMode();
    const finished = S.phase === 'finished';
    const size = quest() ? quest().size : 0;
    const showVotes = S.lastVote && (S.phase === 'team' || S.phase === 'vote' || S.phase === 'quest');
    $('#avSeats').html((S.players || []).map(function(p) {
      let cls = 'av-seat';
      if (p.isSelf) cls += ' is-self';
      if (p.isLeader) cls += ' is-leader';
      if (p.onTeam) cls += ' is-team';
      if (p.left) cls += ' is-left';
      let disabled = false;
      if (mode === 'pick') {
        if (picks.indexOf(p.playerId) >= 0) cls += ' is-picked';
        disabled = p.left || (picks.indexOf(p.playerId) < 0 && picks.length >= size);
        if (!disabled && picks.length < size && picks.indexOf(p.playerId) < 0) cls += ' is-pickable';
      }
      if (mode === 'stab') {
        const allowed = (S.assassinTargets || []).indexOf(p.playerId) >= 0;
        disabled = !allowed;
        if (assassinPick === p.playerId) cls += ' is-target';
      }
      if (mode === 'lady') {
        disabled = (S.ladyTargets || []).indexOf(p.playerId) < 0;
        if (ladyPick === p.playerId) cls += ' is-picked';
      }
      if (disabled) cls += ' is-disabled';
      if (finished && S.assassinTargetId === p.playerId) cls += ' is-target';

      let tag = '';
      if (p.left) tag = 'ออกจากโต๊ะ';
      // ช่วงแทง: บอกว่าทำไมแตะคนนี้ไม่ได้
      else if (mode === 'stab' && disabled && !p.isSelf && p.known === 'evil') tag = 'พวกเดียวกัน';
      else if (mode === 'lady' && disabled && !p.isSelf && p.ladyUsed) tag = 'เคยถือแล้ว';
      else if (!finished && p.ladySeen) tag = 'ส่องแล้ว: ' + (p.ladySeen === 'good' ? 'ฝ่ายดี' : 'ฝ่ายร้าย');
      else if (!finished && p.isLadyHolder && (S.phase === 'lady' || p.isSelf)) tag = 'ถือทะเลสาบ';
      else if (finished && p.role) tag = p.role.thaiName;
      else if (S.phase === 'assassin' && p.isAssassin) tag = '🗡 มือสังหาร';
      else if (p.onTeam) tag = S.phase === 'quest' ? (p.hasPlayed ? 'ลงการ์ดแล้ว' : 'ในทีม') : 'ถูกเสนอ';
      else if (S.phase === 'vote') tag = p.hasVoted ? 'โหวตแล้ว' : 'รอโหวต';
      else if (p.isLeader) tag = 'หัวหน้า';
      else if (p.isSelf) tag = 'คุณ';

      let badge = '';
      if (finished && p.role) {
        badge = '';
      } else if (S.phase === 'night' && p.ready && !p.left) {
        badge = '<span class="av-seat-check" aria-label="พร้อม">✓</span>';
      } else if (showVotes && p.lastVote) {
        badge = '<span class="av-seat-badge"><img src="' + esc(ART(p.lastVote === 'approve' ? 'approve' : 'reject')) + '" alt="' + (p.lastVote === 'approve' ? 'เห็นด้วย' : 'คัดค้าน') + '"></span>';
      }

      const inner =
        (p.isLeader ? '<img class="av-seat-crown" src="' + esc(ART('crown')) + '" alt="หัวหน้า">' : '') +
        '<span class="av-seat-dot' + (p.online ? ' is-on' : '') + '" title="' + (p.online ? 'ออนไลน์' : 'ออฟไลน์') + '"></span>' +
        (p.isLadyHolder ? '<span class="av-seat-lady" title="ถือนางแห่งทะเลสาบ" aria-label="ถือนางแห่งทะเลสาบ">🌊</span>' : '') +
        badge +
        (finished && p.role
          ? '<img class="av-seat-role" src="' + esc(p.role.image) + '" alt="' + esc(p.role.thaiName) + '">'
          : avatarHtml(p, 38)) +
        '<span class="av-seat-name" style="color:' + esc(p.color || 'inherit') + '">' + esc(p.name) + (p.isSelf ? ' (คุณ)' : '') + '</span>' +
        (tag ? '<span class="av-seat-tag">' + esc(tag) + '</span>' : '') +
        (finished && p.team ? '<span class="av-seat-win ' + (p.team === 'good' ? 'is-good' : 'is-evil') + '">' + (p.team === 'good' ? 'ฝ่ายดี' : 'ฝ่ายร้าย') + '</span>' : '');

      if (mode && !disabled) {
        const pressed = mode === 'pick' ? picks.indexOf(p.playerId) >= 0 : (mode === 'lady' ? ladyPick === p.playerId : assassinPick === p.playerId);
        return '<button type="button" class="' + cls + '" data-seat="' + esc(p.playerId) + '" aria-pressed="' + pressed + '">' + inner + '</button>';
      }
      return '<div class="' + cls + '" data-seat="' + esc(p.playerId) + '">' + inner + '</div>';
    }).join(''));
  }

  $(document).on('click', 'button.av-seat, button[data-pick]', function() {
    const id = $(this).attr('data-seat') || $(this).attr('data-pick');
    const mode = seatMode();
    if (mode === 'pick') {
      const at = picks.indexOf(id);
      if (at >= 0) picks.splice(at, 1);
      else if (picks.length < quest().size) picks.push(id);
      if (window.gameHaptic) window.gameHaptic(10);
    } else if (mode === 'stab') {
      assassinPick = assassinPick === id ? null : id;
    } else if (mode === 'lady') {
      ladyPick = ladyPick === id ? null : id;
    }
    renderSeats();
    renderAction();
  });

  /* ------------------------------------------------------------ role card */
  function knowledgeHtml(self) {
    if (!self || !self.role) return '';
    const inPlay = (S.rolesInPlay || []).map(function(r) { return r.id; });
    const list = self.knowledge || [];
    let title = 'สิ่งที่คุณรู้';
    let empty = 'คุณไม่รู้ว่าใครเป็นใคร — อ่านเกมจากการโหวตและผลภารกิจ';
    let extra = '';
    if (self.role.id === 'merlin') {
      title = 'ฝ่ายร้ายที่คุณเห็น';
      if (inPlay.indexOf('mordred') >= 0) extra = 'มอร์เดรดซ่อนจากคุณ — มีฝ่ายร้ายที่คุณไม่เห็นอีก 1 คน';
    } else if (self.role.id === 'percival') {
      if (list.length > 1) {
        title = 'หนึ่งในนี้คือเมอร์ลิน';
        extra = 'อีกคนคือมอร์กานาที่ปลอมตัว — ดูให้ดีว่าใครของจริง';
      } else {
        title = 'นี่คือเมอร์ลิน — ปกป้องเขาให้ดี';
      }
    } else if (self.team === 'evil' && self.role.id !== 'oberon') {
      title = 'พวกเดียวกันของคุณ';
      if (inPlay.indexOf('oberon') >= 0) extra = 'มีโอเบรอนซ่อนอยู่ — เขาเป็นฝ่ายร้ายแต่คุณไม่รู้ว่าเป็นใคร';
    } else if (self.role.id === 'oberon') {
      empty = 'คุณไม่รู้จักพวกเดียวกัน และพวกเขาก็ไม่รู้จักคุณ — ลงการ์ดล้มให้ถูกจังหวะ';
    }
    const pills = list.map(function(k) {
      const cls = k.tag === 'merlin' ? 'is-merlin' : 'is-evil';
      return '<span class="av-name-pill ' + cls + '">' + esc(k.name) + '</span>';
    }).join('');
    const lady = (self.ladyResults || []).map(function(r) {
      return '<span class="av-name-pill ' + (r.team === 'good' ? 'is-merlin' : 'is-evil') + '">🌊 ' + esc(r.name) + ' · ' + (r.team === 'good' ? 'ฝ่ายดี' : 'ฝ่ายร้าย') + '</span>';
    }).join('');
    return '<p class="av-know-title">' + esc(title) + '</p>' +
      (pills ? '<div class="av-team-list">' + pills + '</div>' : '<p class="av-muted">' + esc(empty) + '</p>') +
      (extra ? '<p class="av-muted" style="margin-top:6px;">' + esc(extra) + '</p>' : '') +
      (lady ? '<p class="av-know-title" style="margin-top:10px;">นางแห่งทะเลสาบที่คุณส่อง</p><div class="av-team-list">' + lady + '</div>' : '');
  }

  function roleRibbon(self) {
    return '<span class="av-rolecard-name' + (self.team === 'evil' ? ' is-evil' : '') + '">' + esc(self.role.thaiName) + '</span>';
  }

  function roleBlockHtml(options) {
    const self = me();
    if (!self || !self.role) return '<p class="av-muted">คุณไม่ได้อยู่ในเกมนี้</p>';
    const open = options && options.open;
    const teamLabel = self.team === 'good' ? 'ฝ่ายดี' : 'ฝ่ายร้าย';
    return '<div class="av-role">' +
      '<button type="button" class="av-rolecard' + (open ? ' is-open' : '') + (options && options.deal ? ' is-deal' : '') + '" data-rolecard aria-pressed="' + (open ? 'true' : 'false') + '" aria-label="' + (open ? 'ซ่อนการ์ดบทบาท' : 'แตะเพื่อเปิดการ์ดบทบาท') + '">' +
        '<span class="av-rolecard-inner">' +
          '<span class="av-rolecard-back"><img src="' + esc(ART('back')) + '" alt=""></span>' +
          '<span class="av-rolecard-face"><img src="' + esc(self.role.image) + '" alt="' + esc(self.role.thaiName) + '">' + roleRibbon(self) + '</span>' +
        '</span>' +
        (open ? '' : '<span class="av-rolecard-hint">แตะเพื่อเปิด</span>') +
      '</button>' +
      '<div>' + (open
        ? '<p class="av-role-name">' + esc(self.role.icon + ' ' + self.role.thaiName) + '</p>' +
          '<span class="av-role-team ' + (self.team === 'good' ? 'is-good' : 'is-evil') + '">' + teamLabel + '</span>' +
          '<p class="av-role-blurb">' + esc(self.role.blurb) + '</p>' + knowledgeHtml(self)
        : '<p class="av-secret-hidden">บังจอจากเพื่อนข้าง ๆ ก่อน แล้วแตะการ์ดเพื่อดูบทและข้อมูลลับของคุณ</p>') +
      '</div></div>';
  }

  /* ------------------------------------------------------------ action panel */
  // ปุ่มชื่ออยู่แผงเดียวกับปุ่มยืนยัน — บนมือถือไม่ต้องเลื่อนขึ้นไปแตะโต๊ะแล้วเลื่อนลงมากดส่ง
  function pickGridHtml(ids, opts) {
    return '<div class="av-pickgrid" role="group" aria-label="' + esc(opts.label) + '">' + ids.map(function(id) {
      const p = player(id) || { name: '-' };
      const on = opts.isOn(id);
      const off = !on && opts.isOff(id);
      return '<button type="button" class="av-pick' + (opts.stab ? ' is-stab' : '') + '" data-pick="' + esc(id) + '" aria-pressed="' + on + '"' + (off ? ' disabled' : '') + '>' +
        '<span class="av-pick-mark" aria-hidden="true">' + (on ? (opts.stab ? '🗡' : '✓') : '') + '</span>' +
        '<span>' + esc(p.name) + (p.isSelf ? ' (คุณ)' : '') + '</span></button>';
    }).join('') + '</div>';
  }
  function closeLabel() {
    const self = me() || {};
    if (self.canPlayQuest) return 'ไปลงการ์ด';
    if (self.canPickTeam) return 'ไปเลือกทีม';
    if (self.canVote) return 'ไปโหวต';
    if (self.canAssassinate) return 'ไปเลือกเป้า';
    if (self.canUseLady) return 'ไปส่อง';
    return 'ปิด';
  }

  function renderAction() {
    const self = me() || {};
    const q = quest();
    let html = '';

    if (S.phase === 'night' && (!self.role || self.left)) {
      html = '<h2>กลางคืน</h2><p class="av-muted">ผู้เล่นกำลังดูบทลับของตัวเอง — รอให้ทุกคนพร้อม</p>';
    } else if (S.phase === 'night') {
      html = (self.ready ? '<h2>บทของคุณ</h2>' : '<h2 class="av-prompt">ตาคุณ: แตะการ์ดดูบทลับ แล้วกดพร้อม</h2>') + roleBlockHtml({ open: roleOpen, deal: !roleSeen }) +
        '<div class="av-stack" style="margin-top:16px;">' +
        (self.ready
          ? '<p class="av-muted" style="text-align:center;">พร้อมแล้ว · รอคนอื่น ' + (S.readyCount || 0) + '/' + S.players.filter(function(p) { return !p.left; }).length + '</p>'
          : '<button type="button" id="avReadyBtn" class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block"' + (roleSeen ? '' : ' disabled') + '>' + (roleSeen ? 'จำได้แล้ว พร้อม' : 'เปิดการ์ดก่อน แล้วกดพร้อม') + '</button>') +
        '</div>';
    } else if (S.phase === 'team') {
      if (self.canPickTeam) {
        if (picksStep !== S.step) { picks = []; picksStep = S.step; }
        const need = q.size - picks.length;
        html = '<h2 class="av-prompt">ตาคุณ: เลือก ' + q.size + ' คนออกภารกิจ ' + q.number + '</h2>' +
          '<p class="av-rule">ส่งแล้วทุกคนโหวต · <b>เห็นด้วยเกินครึ่ง</b> = ทีมนี้ออกภารกิจ · ไม่ผ่าน = หัวหน้าคนถัดไป' +
            (q.failsNeeded > 1 ? ' · ภารกิจนี้ต้องล้ม 2 ใบถึงจะล้ม' : '') + '<br>เลือกตัวเองได้ · แตะชื่อด้านล่างหรือบนโต๊ะ</p>' +
          pickGridHtml(S.players.filter(function(p) { return !p.left; }).map(function(p) { return p.playerId; }), {
            label: 'เลือกคนเข้าทีม',
            isOn: function(id) { return picks.indexOf(id) >= 0; },
            isOff: function() { return picks.length >= q.size; }
          }) +
          '<p class="av-hint" id="avPickHint">' + (need > 0 ? 'เลือกอีก ' + need + ' คน' : 'ครบ ' + q.size + ' คนแล้ว · แตะชื่อที่เลือกเพื่อเอาออก') + '</p>' +
          '<button type="button" id="avTeamBtn" class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block" style="margin-top:10px;"' + (picks.length === q.size ? '' : ' disabled') + '>' +
          (picks.length === q.size ? 'ส่งทีมให้ทุกคนโหวต' : 'เลือกแล้ว ' + picks.length + '/' + q.size) + '</button>';
      } else {
        html = '<h2>' + esc(nameOf(S.leaderId)) + ' กำลังเลือกทีม</h2>' +
          '<p class="av-muted">ภารกิจ ' + q.number + ' ใช้ ' + q.size + ' คน' + (q.failsNeeded > 1 ? ' · ต้องล้ม 2 ใบถึงจะล้ม' : '') + ' — คุยกันเสนอชื่อได้เลย</p>';
      }
    } else if (S.phase === 'vote') {
      const team = ((S.proposal && S.proposal.teamIds) || []).map(function(id) {
        return '<span class="av-name-pill">' + esc(nameOf(id)) + '</span>';
      }).join('');
      const header = '<h2>ทีมของ ' + esc(nameOf(S.proposal && S.proposal.leaderId)) + '</h2><div class="av-team-list">' + team + '</div>';
      const voters = S.players.filter(function(p) { return !p.left; }).length;
      const bar = '<div class="av-progress" aria-hidden="true"><span style="width:' + Math.round(100 * (S.votedCount || 0) / Math.max(1, voters)) + '%"></span></div>';
      if (self.canVote) {
        const nextRejects = (Number(S.rejectCount) || 0) + 1;
        html = '<h2 class="av-prompt">ตาคุณ: โหวตทีมนี้</h2>' + header.replace('<h2>', '<h2 class="av-muted" style="font-size:0.95rem;">') +
          '<div class="av-choices">' +
            '<button type="button" class="av-choice av-choice--token is-approve" data-vote="approve"><img src="' + esc(ART('approve')) + '" alt="">เห็นด้วย<span class="av-choice-note">ให้ทีมนี้ไป</span></button>' +
            '<button type="button" class="av-choice av-choice--token is-reject" data-vote="reject"><img src="' + esc(ART('reject')) + '" alt="">คัดค้าน<span class="av-choice-note">ขอทีมใหม่</span></button>' +
          '</div>' +
          '<p class="av-rule" style="margin-top:10px;">' + (S.rejectCount >= S.maxRejects - 1
            ? '⚠️ <b>ถ้าไม่ผ่านอีกครั้ง ฝ่ายร้ายชนะทันที</b>'
            : '<b>เห็นด้วยเกินครึ่ง</b> → ออกภารกิจ · ไม่ผ่าน → หัวหน้าคนถัดไป (คัดค้านติดกัน ' + nextRejects + '/' + S.maxRejects + ')') +
            '<br>ไม่โหวต = เห็นด้วย · เปิดผลพร้อมกัน</p>' + bar;
      } else {
        html = header + ((!self.role || self.left)
          ? '<p class="av-muted">กำลังโหวต ' + (S.votedCount || 0) + '/' + voters + ' · เปิดผลพร้อมกันเมื่อครบ</p>' + bar
          : '<p class="av-muted">คุณโหวต <b>' + (self.myVote === 'approve' ? 'เห็นด้วย' : (self.myVote === 'reject' ? 'คัดค้าน' : '-')) + '</b> · เปิดผลพร้อมกันเมื่อครบ ' + (S.votedCount || 0) + '/' + voters + '</p>' + bar);
      }
    } else if (S.phase === 'quest') {
      const team = ((S.proposal && S.proposal.teamIds) || []).map(function(id) {
        return '<span class="av-name-pill">' + esc(nameOf(id)) + '</span>';
      }).join('');
      const bar = '<div class="av-progress" aria-hidden="true"><span style="width:' + Math.round(100 * (S.questPlayedCount || 0) / Math.max(1, q.size)) + '%"></span></div>';
      if (self.canPlayQuest) {
        html = '<h2 class="av-prompt">ตาคุณ: ลงการ์ดลับ 1 ใบ</h2>' +
          '<p class="av-rule">ภารกิจ ' + q.number + ' · <b>สำเร็จทุกใบ</b> = ผ่าน · มี<b>ล้ม ' + (q.failsNeeded > 1 ? '2' : '1') + ' ใบ</b> = ภารกิจล้ม</p>' +
          '<div class="av-choices">' +
            '<button type="button" class="av-choice av-choice--card is-approve" data-card="success"><img src="' + esc(ART('success')) + '" alt="">สำเร็จ</button>' +
            '<button type="button" class="av-choice av-choice--card is-reject" data-card="fail"><img src="' + esc(ART('fail')) + '" alt="">ล้มเหลว' +
              '<span class="av-choice-note" id="avFailNote" aria-live="polite"></span></button>' +
          '</div><p class="av-muted" style="margin-top:10px;">การ์ดคว่ำและสลับก่อนเปิด — ไม่มีใครรู้ว่าใบไหนของคุณ</p>' + bar;
      } else if (self.onTeam) {
        html = '<h2>ลงการ์ดแล้ว</h2><p class="av-muted">การ์ดของคุณคว่ำไว้แล้ว · รอทีม ' + (S.questPlayedCount || 0) + '/' + q.size + '</p>' + bar;
      } else {
        html = '<h2>ทีมกำลังออกภารกิจ ' + q.number + '</h2><div class="av-team-list">' + team + '</div>' +
          '<p class="av-muted">เปิดการ์ดแบบสลับเมื่อครบทีม — เห็นแค่จำนวนการ์ดล้ม</p>' + bar;
      }
    } else if (S.phase === 'lady') {
      const holder = nameOf(S.lady && S.lady.holderId);
      if (self.canUseLady) {
        html = '<h2 class="av-prompt">ตาคุณ: 🌊 ส่องฝ่าย 1 คน</h2><p class="av-rule">เห็นแค่ <b>ดี/ร้าย</b> (ไม่เห็นบท) · เห็นคนเดียว · แล้วนางแห่งทะเลสาบย้ายไปที่คนนั้น</p>' +
          pickGridHtml(S.ladyTargets || [], {
            label: 'เลือกคนที่จะส่อง',
            isOn: function(id) { return ladyPick === id; },
            isOff: function() { return false; }
          }) +
          '<button type="button" id="avLadyBtn" class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block" style="margin-top:4px;"' + (ladyPick ? '' : ' disabled') + '>' +
          (ladyPick ? 'ส่อง ' + esc(nameOf(ladyPick)) : 'เลือกคนก่อน') + '</button>';
      } else {
        html = '<h2>🌊 นางแห่งทะเลสาบ</h2><p class="av-muted">' + esc(holder) + ' กำลังเลือกส่องฝ่ายของ 1 คน — เห็นคนเดียว แล้วนางแห่งทะเลสาบจะย้ายไปอยู่กับคนที่ถูกส่อง</p>';
      }
    } else if (S.phase === 'assassin') {
      if (self.canAssassinate) {
        html = '<h2 class="av-prompt">ตาคุณ: 🗡 แทงคนที่คิดว่าเป็นเมอร์ลิน</h2><p class="av-rule"><b>ถูก</b> = ฝ่ายร้ายชนะ · <b>พลาด</b> = ฝ่ายดีชนะ · แทงได้ครั้งเดียว · ปรึกษาพวกเดียวกันได้ (รวมโอเบรอน)</p>' +
          pickGridHtml(S.assassinTargets || [], {
            label: 'เลือกคนที่คิดว่าเป็นเมอร์ลิน', stab: true,
            isOn: function(id) { return assassinPick === id; },
            isOff: function() { return false; }
          }) +
          '<button type="button" id="avStabBtn" class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block" style="margin-top:4px;"' + (assassinPick ? '' : ' disabled') + '>' +
          (assassinPick ? 'แทง ' + esc(nameOf(assassinPick)) : 'เลือกเป้าก่อน') + '</button>';
      } else {
        html = '<h2>ช่วงลอบสังหาร</h2><p class="av-muted">' + esc(nameOf(S.assassinId)) + ' เปิดตัวเป็นมือสังหาร · ฝ่ายร้ายเปิดตัวคุยกันได้ · ฝ่ายดีห้ามบอกว่าใครคือเมอร์ลิน</p>' +
          (self.team === 'evil' && (self.knowledge || []).length ? '<div class="av-team-list">' + self.knowledge.map(function(k) { return '<span class="av-name-pill is-evil">' + esc(k.name) + '</span>'; }).join('') + '</div>' : '');
      }
    } else if (S.phase === 'finished') {
      const w = S.winner || {};
      if (w.abandoned) {
        html = '<div class="av-result"><p class="av-result-team">ยกเลิกเกม</p><p class="av-result-why">' + esc(w.text || '') + '</p>';
      } else {
        html = '<div class="av-result"><p class="av-result-team ' + (w.team === 'good' ? 'is-good' : 'is-evil') + '">' + (w.team === 'good' ? '🏆 ฝ่ายดีชนะ' : '🏆 ฝ่ายร้ายชนะ') + '</p>' +
          '<p class="av-result-why">' + esc(w.text || '') + '</p>';
      }
      const mine = me();
      if (mine && mine.team && !w.abandoned) {
        html += '<p class="av-muted" style="margin-bottom:12px;">คุณเป็น ' + esc(mine.role.thaiName) + ' — ' + (mine.team === w.team ? 'ชนะ!' : 'แพ้') + ' · บททุกคนเปิดบนโต๊ะด้านบนแล้ว</p>';
      }
      html += '<div class="av-stack">' +
        (isRoomAdmin ? '<button type="button" id="avRestartBtn" class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block">เล่นอีกรอบ</button>' : '') +
        '<div class="av-row av-row--center">' +
          (w.abandoned ? '' : '<button type="button" id="avShareBtn" class="ui-btn">แชร์ผล</button>') +
          // หัวห้อง = พาทุกคนกลับตอนนี้ · คนอื่น = กลับห้องรอก่อนคนเดียว (ที่เหลือดูบทต่อได้)
          (isRoomAdmin
            ? '<button type="button" id="avBackBtn" class="ui-btn">พาทุกคนกลับห้องรอ</button>'
            : '<button type="button" id="avBackSelfBtn" class="ui-btn">🏠 กลับห้องเลย</button>') +
        '</div><p class="av-muted" id="avBackRemain">ระบบพาทุกคนกลับห้องรอพร้อมกัน</p></div></div>';
    } else {
      html = '<p class="av-muted">กำลังโหลด...</p>';
    }
    $('#avAction').html(html);
  }

  $(document).on('click', '[data-rolecard]', function() {
    const inSheet = $(this).closest('#avSheet').length > 0;
    if (inSheet) {
      $(this).toggleClass('is-open');
      const open = $(this).hasClass('is-open');
      $('#avSheet [data-role-detail]').toggle(open);
      $(this).find('.av-rolecard-hint').toggle(!open);
      return;
    }
    roleOpen = !roleOpen;
    if (roleOpen) roleSeen = true;
    renderAction();
    if (roleOpen && window.gameHaptic) window.gameHaptic(12);
  });

  /* ------------------------------------------------------------ commands */
  function send(eventName, payload) {
    if (sending) return;
    sending = true;
    socket.emit(eventName, Object.assign({ roomId: roomId, playerId: playerId, step: S.step }, payload || {}), function(res) {
      sending = false;
      if (res && !res.success) {
        Swal.fire({ icon: 'info', title: res.error || 'ทำรายการไม่สำเร็จ', background: '#1b2336', color: '#fff', timer: 2600, showConfirmButton: false });
      }
    });
    setTimeout(function() { sending = false; }, 4000);
  }

  $(document).on('click', '#avReadyBtn', function() { send('avalon_ready'); });
  $(document).on('click', '#avTeamBtn', function() {
    if (picks.length !== quest().size) return;
    send('avalon_team', { teamIds: picks.slice() });
  });
  $(document).on('click', '[data-vote]', function() {
    const vote = $(this).attr('data-vote');
    $(this).addClass('is-chosen');
    send('avalon_vote', { vote: vote });
  });
  $(document).on('click', '[data-card]', function() {
    if ($(this).prop('disabled')) return;
    if ($(this).attr('data-card') === 'fail' && !(me() || {}).canFail) {
      $('#avFailNote').text('ฝ่ายดีลงได้แค่การ์ดสำเร็จ').addClass('is-warn');
      if (window.gameHaptic) window.gameHaptic([20, 40, 20]);
      return;
    }
    send('avalon_quest', { card: $(this).attr('data-card') });
  });
  $(document).on('click', '#avStabBtn', function() {
    if (!assassinPick) return;
    const target = nameOf(assassinPick);
    Swal.fire({
      title: 'แทง ' + target + ' ?', text: 'ถ้าเป็นเมอร์ลิน ฝ่ายร้ายชนะ — เปลี่ยนใจไม่ได้',
      showCancelButton: true, confirmButtonText: 'แทงเลย', cancelButtonText: 'ยังก่อน',
      background: '#1b2336', color: '#fff', confirmButtonColor: '#b3303f'
    }).then(function(r) { if (r.isConfirmed) send('avalon_assassinate', { targetId: assassinPick }); });
  });
  $(document).on('click', '#avRestartBtn', function() {
    socket.emit('startGameFromLobby', { roomId: roomId }, function(res) {
      if (res && !res.success) Swal.fire({ icon: 'error', title: res.error || 'เริ่มใหม่ไม่สำเร็จ', background: '#1b2336', color: '#fff' });
    });
  });
  // ไม่ใช่หัวห้อง = server ไม่พาทั้งวงกลับ (canReturnSelf) → กลับห้องเฉพาะตัวเอง
  $(document).on('click', '#avBackBtn', function() { socket.emit('returnFinishedToLobby', { roomId: roomId }, function(res) { if (res && res.canReturnSelf) { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; } }); });
  $(document).on('click', '#avBackSelfBtn', function() {
    allowNavigation = true;
    window.location.href = '/room/' + roomId + '?playerId=' + playerId;
  });
  $(document).on('click', '#avLadyBtn', function() {
    if (!ladyPick) return;
    const target = nameOf(ladyPick);
    Swal.fire({
      title: 'ส่อง ' + target + ' ?', text: 'คุณจะเห็นว่าเป็นฝ่ายดีหรือฝ่ายร้าย แล้วนางแห่งทะเลสาบจะย้ายไปที่ ' + target,
      showCancelButton: true, confirmButtonText: 'ส่องเลย', cancelButtonText: 'ยังก่อน',
      background: '#1b2336', color: '#fff', confirmButtonColor: '#c9a24a'
    }).then(function(r) { if (r.isConfirmed) send('avalon_lady', { targetId: ladyPick }); });
  });
  $(document).on('click', '#avShareBtn', function() {
    if (!window.partyPlay || !S.winner) return;
    const good = S.players.filter(function(p) { return p.team === 'good'; }).map(function(p) { return p.name + (p.role ? ' (' + p.role.thaiName + ')' : ''); });
    const evil = S.players.filter(function(p) { return p.team === 'evil'; }).map(function(p) { return p.name + (p.role ? ' (' + p.role.thaiName + ')' : ''); });
    window.partyPlay.shareResult({
      mode: 'อวาลอน',
      headline: S.winner.team === 'good' ? 'ฝ่ายดีชนะ!' : 'ฝ่ายร้ายชนะ!',
      sub: S.winner.text || '',
      lines: ['ฝ่ายดี: ' + good.join(', '), 'ฝ่ายร้าย: ' + evil.join(', ')],
      accent: S.winner.team === 'good' ? '#6ea3f5' : '#e25563',
      fileName: 'avalon-result'
    });
  });

  /* ------------------------------------------------------------ overlays */
  function openOverlay(kind, html, autoCloseMs) {
    overlayKind = kind;
    clearTimeout(overlayTimer);
    $('#avSheet').html(html);
    $('#avOverlay').addClass('is-on');
    if (autoCloseMs) overlayTimer = setTimeout(closeOverlay, autoCloseMs);
  }
  function closeOverlay() {
    clearTimeout(overlayTimer);
    overlayKind = null;
    $('#avOverlay').removeClass('is-on');
    $('#avSheet').empty();
  }
  $('#avOverlay').on('click', function(e) {
    if (e.target === this || $(e.target).is('[data-close]')) closeOverlay();
  });
  $(document).on('keydown', function(e) {
    if (e.key === 'Escape' && $('#avOverlay').hasClass('is-on')) closeOverlay();
  });

  function showRoleSheet() {
    const self = me();
    if (!self || !self.role) return;
    const html = '<h3 id="avOverlayTitle">บทของฉัน</h3><p class="av-sheet-sub">บังจอก่อนเปิด</p>' +
      '<div class="av-row av-row--center">' +
        '<button type="button" class="av-rolecard" data-rolecard aria-label="แตะเพื่อเปิดการ์ด">' +
          '<span class="av-rolecard-inner">' +
            '<span class="av-rolecard-back"><img src="' + esc(ART('back')) + '" alt=""></span>' +
            '<span class="av-rolecard-face"><img src="' + esc(self.role.image) + '" alt="' + esc(self.role.thaiName) + '">' + roleRibbon(self) + '</span>' +
          '</span><span class="av-rolecard-hint">แตะเพื่อเปิด</span></button>' +
      '</div>' +
      '<div data-role-detail style="display:none; text-align:left; margin-top:16px;">' +
        '<p class="av-role-name">' + esc(self.role.icon + ' ' + self.role.thaiName) + '</p>' +
        '<span class="av-role-team ' + (self.team === 'good' ? 'is-good' : 'is-evil') + '">' + (self.team === 'good' ? 'ฝ่ายดี' : 'ฝ่ายร้าย') + '</span>' +
        '<p class="av-role-blurb">' + esc(self.role.blurb) + '</p>' + knowledgeHtml(self) +
      '</div>' +
      '<button type="button" class="ui-btn ui-btn--block" data-close>ปิด</button>';
    openOverlay('role', html);
  }
  $('#avRoleBtn').on('click', showRoleSheet);

  function showVoteReveal(event) {
    const lv = S.lastVote;
    if (!lv) return;
    const html = '<h3 id="avOverlayTitle">ผลโหวตทีม · ภารกิจ ' + lv.questNumber + '</h3>' +
      '<p class="av-sheet-sub">ทีมของ ' + esc(nameOf(lv.leaderId)) + ': ' + esc(lv.teamIds.map(nameOf).join(', ')) + '</p>' +
      '<div class="av-reveal-grid">' + lv.votes.map(function(v) {
        return '<div class="av-reveal-vote"><div class="av-coin"><div class="av-coin-inner">' +
          '<div class="av-coin-back"></div>' +
          '<div class="av-coin-face"><img src="' + esc(ART(v.vote === 'approve' ? 'approve' : 'reject')) + '" alt="' + (v.vote === 'approve' ? 'เห็นด้วย' : 'คัดค้าน') + '"></div>' +
          '</div></div><span>' + (v.playerId === lv.leaderId ? '👑 ' : '') + esc(nameOf(v.playerId)) + '</span>' +
          (lv.teamIds.indexOf(v.playerId) >= 0 ? '<em>ในทีม</em>' : '') + '</div>';
      }).join('') + '</div>' +
      '<p class="av-verdict ' + (lv.approved ? 'is-good' : 'is-evil') + '">' + (lv.approved ? 'ผ่าน ' : 'ไม่ผ่าน ') + lv.approveCount + ' : ' + lv.rejectCount + '</p>' +
      '<p class="av-sheet-sub" style="margin:4px 0 0;">' + (lv.approved ? 'ทีมออกภารกิจได้' : (S.phase === 'finished' ? 'คัดค้านครบ ' + S.maxRejects + ' ครั้ง' : 'หัวหน้าส่งต่อให้ ' + esc(nameOf(S.leaderId)) + ' · คัดค้านติดกัน ' + S.rejectCount + '/' + S.maxRejects)) + '</p>' +
      '<button type="button" class="ui-btn ui-btn--block" data-close>' + esc(closeLabel()) + '</button>';
    openOverlay('vote', html, 7000);
    const coins = $('#avSheet .av-coin');
    if (reduceMotion) {
      coins.addClass('is-flipped');
      $('#avSheet .av-verdict').addClass('is-on');
      return;
    }
    setTimeout(function() {
      coins.addClass('is-flipped');
      setTimeout(function() { $('#avSheet .av-verdict').addClass('is-on'); }, 550);
    }, 450);
  }

  function showQuestReveal(event) {
    const lq = S.lastQuest;
    if (!lq) return;
    const success = lq.result === 'success';
    const html = '<h3 id="avOverlayTitle">ผลภารกิจ ' + lq.questNumber + '</h3>' +
      '<p class="av-sheet-sub">ทีม: ' + esc((lq.teamIds || []).map(nameOf).join(', ')) + '<br>สลับการ์ดแล้ว — ไม่มีใครรู้ว่าใบไหนของใคร' + (lq.failsNeeded > 1 ? ' · ต้องล้ม 2 ใบถึงจะล้ม' : '') + '</p>' +
      '<div class="av-cards-row">' + lq.cards.map(function(card) {
        return '<div class="av-qcard"><div class="av-qcard-inner">' +
          '<img src="' + esc(ART('back')) + '" alt="">' +
          '<img class="is-face" src="' + esc(ART(card === 'fail' ? 'fail' : 'success')) + '" alt="' + (card === 'fail' ? 'ล้มเหลว' : 'สำเร็จ') + '">' +
          '</div></div>';
      }).join('') + '</div>' +
      '<p class="av-verdict ' + (success ? 'is-good' : 'is-evil') + '">' + (success ? 'ภารกิจสำเร็จ' : 'ภารกิจล้มเหลว') + '</p>' +
      '<p class="av-sheet-sub" style="margin:4px 0 0;">การ์ดล้ม ' + lq.failCount + ' ใบ · รวมภารกิจ สำเร็จ ' + S.successCount + ' · ล้ม ' + S.failCount + ' (ใครถึง 3 ก่อนชนะ)</p>' +
      '<button type="button" class="ui-btn ui-btn--block" data-close>' + esc(closeLabel()) + '</button>';
    openOverlay('quest', html, 5000 + lq.cards.length * 500);
    const cards = $('#avSheet .av-qcard');
    if (reduceMotion) {
      cards.addClass('is-flipped');
      $('#avSheet .av-verdict').addClass('is-on');
      return;
    }
    cards.each(function(i, node) {
      setTimeout(function() { $(node).addClass('is-flipped'); }, 500 + i * 550);
    });
    setTimeout(function() { $('#avSheet .av-verdict').addClass('is-on'); }, 700 + cards.length * 550);
  }

  function playFx() {
    const events = (S.fx || []).filter(function(e) { return e && e.seq > seenFx; });
    if (!events.length) return;
    seenFx = events[events.length - 1].seq;
    // โชว์แค่อันสำคัญล่าสุด ไม่ไล่ทีละอัน (กันจอกระพริบตอนหลายเหตุการณ์มาพร้อมกัน)
    const quest = events.filter(function(e) { return e.kind === 'quest'; }).pop();
    const vote = events.filter(function(e) { return e.kind === 'vote'; }).pop();
    if (quest) showQuestReveal(quest);
    else if (vote) showVoteReveal(vote);
    const ladyFx = events.filter(function(e) { return e.kind === 'lady'; }).pop();
    if (ladyFx && !quest && !vote && ladyFx.holderId === playerId) {
      const r = ((me() || {}).ladyResults || []).filter(function(x) { return x.targetId === ladyFx.targetId; }).pop();
      if (r) {
        openOverlay('lady', '<h3 id="avOverlayTitle">🌊 ผลส่อง: ' + esc(r.name) + '</h3>' +
          '<p class="av-verdict is-on ' + (r.team === 'good' ? 'is-good' : 'is-evil') + '">' + (r.team === 'good' ? 'ฝ่ายดี' : 'ฝ่ายร้าย') + '</p>' +
          '<p class="av-sheet-sub">มีแค่คุณที่เห็น — จะบอกจริงหรือโกหกก็ได้ · ดูซ้ำได้ที่ "บทของฉัน"</p>' +
          '<button type="button" class="ui-btn ui-btn--block" data-close>' + esc(closeLabel()) + '</button>');
      }
    }
    const stab = events.filter(function(e) { return e.kind === 'stab'; }).pop();
    if (stab && !quest && !vote) {
      openOverlay('stab', '<h3 id="avOverlayTitle">' + (stab.hit ? '🗡 แทงถูกเมอร์ลิน!' : '🛡 แทงพลาด!') + '</h3>' +
        '<p class="av-sheet-sub">' + esc(nameOf(stab.targetId)) + (stab.hit ? ' คือเมอร์ลินจริง — ฝ่ายร้ายพลิกชนะ' : ' ไม่ใช่เมอร์ลิน — ฝ่ายดีชนะ') + '</p>' +
        '<button type="button" class="ui-btn ui-btn--block" data-close>ดูบททุกคน</button>', 6000);
    }
  }

  /* ------------------------------------------------------------ misc */
  function renderLog() {
    $('#avLog').html((S.history || []).map(function(h) {
      return '<li>' + esc((h.icon || '') + ' ' + (h.text || '')) + '</li>';
    }).join(''));
  }

  function pingNeed() {
    if (!window.partyPlay) return;
    const self = me() || {};
    if (self.canPickTeam) window.partyPlay.pingTurn({ key: 'av-team-' + S.step, title: 'คุณเป็นหัวหน้า', subtitle: 'เลือก ' + quest().size + ' คนออกภารกิจ' });
    else if (self.canVote) window.partyPlay.pingTurn({ key: 'av-vote-' + S.step, title: 'โหวตทีม', subtitle: 'เห็นด้วยหรือคัดค้าน' });
    else if (self.canPlayQuest) window.partyPlay.pingTurn({ key: 'av-quest-' + S.step, title: 'คุณอยู่ในทีม', subtitle: 'ลงการ์ดภารกิจแบบลับ' });
    else if (self.canAssassinate) window.partyPlay.pingTurn({ key: 'av-stab-' + S.step, title: 'คุณคือมือสังหาร', subtitle: 'แทงคนที่คิดว่าเป็นเมอร์ลิน' });
    else if (self.canUseLady) window.partyPlay.pingTurn({ key: 'av-lady-' + S.step, title: 'นางแห่งทะเลสาบ', subtitle: 'เลือกส่องฝ่ายของ 1 คน' });
  }

  function render(state) {
    if (!state || !state.phase) return;
    const prevStep = S && S.step;
    S = state;
    if (S.phase !== 'assassin') assassinPick = null;
    if (S.phase !== 'lady' || prevStep !== S.step) ladyPick = null;
    if (S.phase !== 'night') { roleOpen = false; }
    if (prevStep !== S.step && S.phase === 'team' && picksStep !== S.step) picks = [];
    if (overlayKind === 'role' && S.phase === 'finished') closeOverlay();
    // คนที่ไม่ได้นั่งโต๊ะไม่มีบท — ซ่อนปุ่มที่กดแล้วไม่เกิดอะไร
    $('#avRoleBtn').toggle(!!(S.self && S.self.role));
    renderStatus();
    renderTrack();
    renderSeats();
    renderAction();
    renderLog();
    tickTimer();
    pingNeed();
    playFx();
    // ถึงตาต้องกด (หัวหน้า/โหวต/ลงการ์ด/แทง) — เลื่อนแผงปุ่มขึ้นมาให้เห็นทันทีบนมือถือ
    const self = me() || {};
    const needsMe = self.canPickTeam || self.canVote || self.canPlayQuest || self.canAssassinate || self.canUseLady;
    if (needsMe && prevStep !== S.step) {
      const node = document.getElementById('avAction');
      const rect = node.getBoundingClientRect();
      if (rect.top > window.innerHeight * 0.6) {
        node.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      }
    }
  }

  /* ------------------------------------------------------------ chrome */
  $('#avHowBtn').on('click', function() {
    Swal.fire({
      title: 'อวาลอน เล่นยังไง',
      html: '<div style="text-align:left; line-height:1.6; font-size:0.95rem;">' +
        '<p><b>ฝ่ายดี</b> ทำภารกิจสำเร็จ 3 ใน 5 · <b>ฝ่ายร้าย</b> ทำให้ล้ม 3 ครั้ง</p>' +
        '<p>1. หัวหน้า (มีมงกุฎ) เลือกทีมตามจำนวนบนเหรียญภารกิจ</p>' +
        '<p>2. ทุกคนโหวตพร้อมกัน — เห็นด้วยเกินครึ่งถึงผ่าน ไม่ผ่านหัวหน้าส่งต่อ · ไม่ผ่านติดกัน 5 ครั้ง ฝ่ายร้ายชนะ</p>' +
        '<p>3. ทีมลงการ์ดลับ ฝ่ายดีลงได้แค่สำเร็จ ฝ่ายร้ายเลือกได้ · มีการ์ดล้มใบเดียวก็ล้ม (ยกเว้นเหรียญที่เขียน “ล้ม 2”)</p>' +
        '<p>4. ฝ่ายดีสำเร็จครบ 3 — ฝ่ายร้ายเปิดตัวคุยกัน (รวมโอเบรอน) แล้วมือสังหารแทงฝ่ายดี 1 คน ถ้าเป็นเมอร์ลิน ฝ่ายร้ายชนะ</p>' +
        (S.lady ? '<p>🌊 <b>นางแห่งทะเลสาบ</b> (เปิดในห้องนี้): หลังภารกิจ 2, 3, 4 คนถือส่องฝ่ายของ 1 คน (เห็นแค่ดี/ร้าย คนเดียว) แล้วส่งต่อให้คนที่ถูกส่อง · ส่องคนที่เคยถือไม่ได้</p>' : '') +
        '<p><b>เมอร์ลิน</b> เห็นฝ่ายร้าย (ยกเว้นมอร์เดรด) · <b>เพอร์ซิวัล</b> เห็นเมอร์ลินกับมอร์กานาแต่แยกไม่ออก · <b>โอเบรอน</b> ไม่รู้จักพวกเดียวกัน</p>' +
        '<p style="color:#a8b3c9;">หมดเวลา: ไม่โหวต = เห็นด้วย · ไม่ลงการ์ด = สำเร็จ · หัวหน้าไม่เลือก = ระบบเลือกให้' + (S.lady ? ' · ไม่ส่อง = สุ่มให้' : '') + '</p>' +
        ((S.rolesInPlay || []).length ? '<p><b>บทในเกมนี้:</b> ' + S.rolesInPlay.map(function(r) { return esc(r.thaiName) + (r.count > 1 ? ' ×' + r.count : ''); }).join(', ') + '</p>' : '') +
        '</div>',
      background: '#1b2336', color: '#fff', confirmButtonColor: '#c9a24a', confirmButtonText: 'เข้าใจแล้ว'
    });
  });

  $('#avEndBtn').on('click', function() {
    Swal.fire({
      icon: 'warning', title: 'จบเกมและกลับห้องรอ?', text: 'เกมนี้จะไม่นับสถิติ', showCancelButton: true,
      confirmButtonText: 'จบเกม', cancelButtonText: 'ยกเลิก', background: '#1b2336', color: '#fff'
    }).then(function(r) { if (r.isConfirmed) socket.emit('endTableSession', { roomId: roomId }); });
  });

  function setSidebarOpen(open) {
    if (open && $('#chatBox').is(':visible')) $('#closeChat').trigger('click');
    $('#playerSidebar').toggleClass('open', open).attr('aria-hidden', open ? 'false' : 'true');
    $('#sidebarOverlay').toggle(open);
    $('#avPlayersBtn').attr('aria-expanded', open ? 'true' : 'false');
    if (open) document.getElementById('closeSidebarBtn').focus();
    else if (document.activeElement && document.getElementById('playerSidebar').contains(document.activeElement)) document.getElementById('avPlayersBtn').focus();
  }
  $('#avPlayersBtn').on('click', function() { setSidebarOpen(!$('#playerSidebar').hasClass('open')); });
  $('#closeSidebarBtn, #sidebarOverlay').on('click', function() { setSidebarOpen(false); });
  $(document).on('keydown', function(event) {
    if (event.key === 'Escape' && $('#playerSidebar').hasClass('open')) setSidebarOpen(false);
  });

  // ออกจากห้อง: บอกผลตามจังหวะเกม แล้วไป /rooms — กดแล้วห้ามมีอะไรดึงกลับเข้าเกม
  function exitConsequences() {
    const self = S.self || null;
    if (!S.phase || S.phase === 'lobby' || S.phase === 'finished') return ['เกมจบแล้ว — กลับไปหน้ารวมห้อง'];
    if (!self || self.left) return ['คุณออกจากโต๊ะแล้ว — เกมเล่นต่อตามปกติ'];
    const lines = [];
    const remain = (S.players || []).filter(function(p) { return !p.left && !p.isSelf; }).length;
    if (remain < 5) {
      lines.push('เหลือไม่ถึง 5 คน — เกมนี้ถูกยกเลิก (ไม่นับสถิติ)');
    } else {
      if (S.phase === 'team' && self.isLeader) lines.push('คุณเป็นหัวหน้า — ส่งต่อให้คนถัดไปเลือกทีม');
      else if (S.phase === 'quest' && self.onTeam && !self.myQuestCard) lines.push('การ์ดภารกิจของคุณนับเป็น "สำเร็จ"');
      else if (S.phase === 'vote' && !self.myVote) lines.push('ไม่นับโหวตของคุณ');
      else if (S.phase === 'assassin' && self.isAssassin) lines.push('คุณเป็นมือสังหาร — ฝ่ายร้ายคนอื่นเลือกเป้าแทน');
      else if (S.phase === 'lady' && self.isLadyHolder) lines.push('ข้ามการส่องของคุณ');
      lines.push('โต๊ะเล่นต่อโดยไม่มีคุณ · บทของคุณยังเป็นความลับ');
    }
    if (isRoomAdmin) lines.push('คุณเป็นหัวห้อง — หัวห้องจะย้ายไปคนอื่น');
    return lines;
  }
  const exit = window.roomExit.create({
    socket: socket, roomId: roomId, playerId: playerId,
    consequences: exitConsequences,
    onLeave: function() { allowNavigation = true; },
    theme: { background: '#1b2336', color: '#fff', confirmButtonColor: '#b3262e' }
  });
  $('#avExitBtn').on('click', exit.confirm);
  $('#leaveRoomBtn').on('click', function() { setSidebarOpen(false); exit.confirm(); });

  window.addEventListener('beforeunload', function(event) {
    if (!allowNavigation && S.phase && S.phase !== 'finished') event.preventDefault();
  });

  socket.on('connect', function() {
    if (exit.isLeaving()) return;
    $('#connectionStatus').hide();
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId: roomId, playerId: playerId });
    socket.emit('avalon_requestState', { roomId: roomId, playerId: playerId });
  });
  socket.on('disconnect', function() { $('#connectionStatus').show(); });
  socket.on('avalonState', render);
  socket.on('roomUpdate', function(data) {
    if (!data || !data.players) return;
    $('#onlinePlayerList').html(data.players.map(function(p) {
      return '<li>' + avatarHtml({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: p.color, name: p.displayName || p.playerName }, 28) +
        '<span style="color:' + esc(p.color || '#fff') + '">' + esc(p.displayName || p.playerName) + '</span>' +
        (p.online === false ? '<span style="margin-left:auto; font-size:0.78rem; color:var(--av-muted);">ออฟไลน์</span>' : '') + '</li>';
    }).join(''));
  });
  socket.on('redirectToLobby', function() { if (exit.isLeaving()) return; allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; });
  socket.on('returnToLobby', function(data) {
    S.returnLobbyEndsAt = Number(data && data.endsAt) || (Date.now() + (Number(data && data.countdown) || 30) * 1000);
    tickTimer();
  });
  socket.on('restartGame', function() { if (exit.isLeaving()) return; allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; });
  socket.on('gameStarting', function() { if (exit.isLeaving()) return; allowNavigation = true; window.location.href = '/game/' + roomId + '?playerId=' + playerId; });
  socket.on('kickedFromRoom', function(data) {
    if (exit.isLeaving()) return;
    allowNavigation = true;
    Swal.fire({ icon: 'error', title: 'ถูกเตะออกจากห้อง', text: (data && data.reason) || '', background: '#1b2336', color: '#fff' })
      .then(function() { window.location.href = '/rooms?playerId=' + playerId; });
  });

  window.initChatPanel({
    socket: socket, playerId: playerId, playerName: playerName,
    onCommand: function(text) {
      if (text.trim().toLowerCase() !== '/m') return false;
      socket.emit('avalon_admin_reveal');
      return true;
    }
  });
  socket.on('avalon_admin_reveal', function(data) {
    const rows = (data.players || []).map(function(p) {
      return '<div style="margin:6px 0;"><strong>' + esc(p.name) + '</strong> — ' + esc(p.role ? p.role.icon + ' ' + p.role.name : '-') + (p.left ? ' (ออกแล้ว)' : '') + '</div>';
    }).join('');
    Swal.fire({ title: '/m บททั้งโต๊ะ', html: rows, background: '#1b2336', color: '#fff' });
  });
  socket.on('avalon_admin_reveal_denied', function() {
    Swal.fire({ icon: 'error', title: 'ดูบทไม่ได้', text: 'คำสั่ง /m ใช้ได้เฉพาะแอดมินเว็บเท่านั้น', background: '#1b2336', color: '#fff' });
  });

  if (S && S.phase) render(S);
});
</script>

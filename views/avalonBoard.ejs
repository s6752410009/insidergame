<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/chatPanel.css">
<style>
  html.av-active,
  html.av-active body.content {
    overflow-x: hidden;
    margin: 0 !important;
    padding: 0 !important;
    background: oklch(0.16 0.03 260) !important;
  }
  html.av-active .container-fluid > header,
  html.av-active .footer,
  html.av-active #music-controls { display: none !important; }
  html.av-active .container-fluid { padding: 0 !important; margin: 0 !important; max-width: none !important; background: oklch(0.16 0.03 260) !important; min-height: 100vh; }
  html.av-active body, html.av-active body.content { background: oklch(0.16 0.03 260) !important; }
  html.av-active .container-fluid > .row { margin: 0 !important; }
  html.av-active .col-lg-12 { padding: 0 !important; }
  /* overflow-x:hidden ทำให้ position:sticky ใช้ไม่ได้ — ใช้ clip แทน (กันเลื่อนข้างได้เหมือนเดิม)
     แถบสถานะเลยติดขอบบนจอได้: เลื่อนลงไปกดโหวต/ลงการ์ดก็ยังเห็นว่าเกิดอะไร เหลือกี่วิ */
  html.av-active, html.av-active body.content, html.av-active .container-fluid { overflow-x: clip !important; overflow-y: visible !important; }

  :root {
    --av-bg: oklch(0.16 0.03 260);
    --av-surface: oklch(0.21 0.035 260);
    --av-surface-2: oklch(0.26 0.04 260);
    --av-sunken: oklch(0.13 0.025 260);
    --av-line: oklch(0.45 0.04 260 / 0.5);
    --av-ink: oklch(0.96 0.01 260);
    --av-soft: oklch(0.84 0.02 260);
    --av-muted: oklch(0.7 0.03 260);
    --av-gold: oklch(0.85 0.12 85);
    --av-gold-ink: oklch(0.2 0.04 70);
    --av-good: oklch(0.7 0.13 255);
    --av-good-bg: oklch(0.36 0.1 258);
    --av-evil: oklch(0.68 0.18 25);
    --av-evil-bg: oklch(0.34 0.11 22);
    --av-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --display: 'Chakra Petch', 'Bai Jamjuree', sans-serif;
    --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 24px; --sp-6: 32px;
  }
  .av {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--sp-2) var(--sp-4) calc(96px + env(safe-area-inset-bottom, 0px));
    color: var(--av-ink);
    font-family: 'Bai Jamjuree', sans-serif;
    line-height: 1.5;
    text-align: left;
  }
  body.content { background: var(--av-bg, oklch(0.16 0.03 260)); }
  .av *, .av *::before, .av *::after { box-sizing: border-box; }
  .av button { font-family: inherit; }
  #avOverlay .ui-btn, .av-sidebar .ui-btn { font-family: 'Bai Jamjuree', sans-serif; }
  .av .ui-btn--primary { background: var(--av-gold); color: var(--av-gold-ink); }
  .av .ui-btn--primary:hover { background: oklch(0.89 0.11 85); color: var(--av-gold-ink); }
  .av .ui-btn:focus-visible, .av-seat:focus-visible, .av-chip:focus-visible, .av-choice:focus-visible, .av-rolecard:focus-visible {
    outline: 3px solid var(--av-gold); outline-offset: 2px;
  }

  /* ---------- top bar ---------- */
  .av-top { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); padding: var(--sp-2) 0 var(--sp-3); }
  .av-brand { min-width: 0; }
  .av-kicker { color: var(--av-gold); font-family: var(--display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; }
  .av-title { margin: 0; font-family: var(--display); font-size: 1.15rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .av-top-actions { display: flex; gap: var(--sp-2); flex: 0 0 auto; }
  .av-chip {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    min-width: 44px; height: 44px; padding: 0 12px; border-radius: 12px;
    border: 1px solid var(--av-line); background: var(--av-surface); color: var(--av-ink);
    font-size: 0.88rem; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .av-chip--danger { color: oklch(0.82 0.1 25); border-color: oklch(0.55 0.15 25 / 0.6); }
  .av-chip--exit { color: oklch(0.86 0.08 25); border-color: oklch(0.6 0.16 25 / 0.7); font-weight: 700; padding: 0 10px; }
  .av-chip-label { display: none; }
  @media (min-width: 560px) { .av-chip-label { display: inline; } }

  /* ---------- status ---------- */
  .av-status {
    display: grid; grid-template-columns: 1fr auto; gap: var(--sp-1) var(--sp-3); align-items: center;
    padding: var(--sp-3) var(--sp-4); border-radius: 16px;
    background: var(--av-surface); border: 1px solid var(--av-line);
    position: sticky; top: 6px; z-index: 60; box-shadow: 0 10px 24px rgb(0 0 0 / 0.35);
  }
  .av-status-bar { grid-column: 1 / 3; height: 5px; border-radius: 999px; background: var(--av-sunken); overflow: hidden; }
  .av-status-bar > span { display: block; height: 100%; width: 0; background: var(--av-gold); transition: width 0.25s linear; }
  .av-status-bar.is-low > span { background: oklch(0.7 0.18 30); }
  .av-status-bar[hidden] { display: none; }
  @media (max-width: 480px) {
    .av-status { padding: 8px 12px; gap: 2px var(--sp-2); }
    .av-now { font-size: 0.98rem; }
    .av-timer-num { font-size: 1.25rem; }
    .av-kicker { display: none; }
    .av-timer-hint.is-calm { display: none; }
  }
  /* หัวข้อแผงตอนถึงตาเรา — ใหญ่ สีทอง บอกว่าต้องทำอะไรในประโยคเดียว */
  .av-action h2.av-prompt { color: var(--av-gold); font-size: 1.25rem; }
  .av-rule { margin: 0 0 var(--sp-3); padding: 8px 12px; border-radius: 12px; background: var(--av-sunken); font-size: 0.86rem; color: var(--av-soft); line-height: 1.45; }
  .av-rule b { color: var(--av-ink); }
  .av-quest-unit { position: absolute; bottom: 7px; left: 0; right: 0; text-align: center; font-family: 'Bai Jamjuree', sans-serif; font-size: 0.6rem; font-weight: 600; color: var(--av-muted); line-height: 1; }
  .av-quest.is-done .av-quest-unit { display: none; }
  .av-quest:not(.is-done) .av-quest-size { margin-top: -8px; }
  .av-status.is-mine { background: oklch(0.3 0.06 80); border-color: oklch(0.8 0.12 85 / 0.7); }
  .av-phase {
    display: inline-flex; align-items: center; gap: 6px; font-family: var(--display); font-weight: 700;
    font-size: 0.78rem; letter-spacing: 0.08em; color: var(--av-gold);
  }
  .av-now { grid-column: 1 / 2; font-size: 1.08rem; font-weight: 700; line-height: 1.35; overflow-wrap: anywhere; }
  .av-timer { grid-row: 1 / 3; grid-column: 2; text-align: right; }
  .av-timer-num { font-family: var(--display); font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--av-ink); }
  .av-timer-num.is-low { color: oklch(0.78 0.16 40); }
  .av-timer-hint { grid-column: 1 / 3; font-size: 0.78rem; color: var(--av-muted); }

  /* ---------- quest track ---------- */
  .av-board { margin-top: var(--sp-3); padding: var(--sp-4) var(--sp-3) var(--sp-3); border-radius: 20px; background: var(--av-sunken); border: 1px solid var(--av-line); }
  .av-track { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--sp-2); justify-items: center; }
  .av-quest { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; width: 100%; }
  .av-quest-token {
    position: relative; width: min(58px, 100%); aspect-ratio: 1; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--av-surface-2); border: 2px solid oklch(0.6 0.08 85 / 0.55);
    font-family: var(--display); color: var(--av-ink);
    transition: transform 0.3s var(--av-ease);
  }
  .av-quest-token img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; }
  .av-quest-size { font-size: 1.35rem; font-weight: 700; line-height: 1; }
  .av-quest.is-current .av-quest-token { border-color: var(--av-gold); box-shadow: 0 0 0 3px oklch(0.85 0.12 85 / 0.25); transform: scale(1.06); }
  .av-quest.is-done .av-quest-size { display: none; }
  .av-quest-label { font-size: 0.72rem; color: var(--av-muted); white-space: nowrap; }
  .av-quest.is-current .av-quest-label { color: var(--av-gold); font-weight: 700; }
  .av-two-fail {
    position: absolute; top: -6px; right: -4px; padding: 1px 6px; border-radius: 999px;
    background: var(--av-evil-bg); color: oklch(0.92 0.05 25); font-size: 0.66rem; font-weight: 700;
    border: 1px solid oklch(0.68 0.18 25 / 0.6); white-space: nowrap;
  }
  .av-fail-count { position: absolute; bottom: -4px; right: -4px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--av-evil); color: #fff; font-size: 0.72rem; font-weight: 700; display: grid; place-items: center; }
  .av-rejects { display: flex; align-items: center; justify-content: center; gap: var(--sp-2); margin-top: var(--sp-3); font-size: 0.8rem; color: var(--av-muted); flex-wrap: wrap; }
  .av-pips { display: flex; gap: 6px; }
  .av-pip { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid oklch(0.6 0.05 260); background: transparent; }
  .av-pip.is-on { background: var(--av-evil); border-color: var(--av-evil); }
  .av-pip.is-last { border-style: dashed; border-color: oklch(0.68 0.18 25 / 0.8); }
  .av-lastline { margin-top: var(--sp-2); text-align: center; font-size: 0.8rem; color: var(--av-soft); }
  .av-rolesline { margin-top: 4px; text-align: center; font-size: 0.76rem; color: var(--av-muted); overflow-wrap: anywhere; }
  .av-recap { margin: var(--sp-3) 0 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .av .av-recap li { line-height: 1.45; display: grid; grid-template-columns: auto 1fr; gap: 2px var(--sp-2); align-items: baseline; padding: 6px 10px; border-radius: 10px; background: var(--av-surface); font-size: 0.82rem; color: var(--av-soft); min-width: 0; }
  .av-recap b { font-family: var(--display); color: var(--av-ink); white-space: nowrap; }
  .av-recap .is-success b { color: var(--av-good); }
  .av-recap .is-fail b { color: var(--av-evil); }
  .av-recap span { min-width: 0; overflow-wrap: anywhere; }

  /* ---------- seats ---------- */
  .av-seats { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: var(--sp-2); margin-top: var(--sp-4); }
  .av-seat {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px;
    min-height: 92px; padding: 10px 6px 8px; border-radius: 14px;
    background: var(--av-surface); border: 1.5px solid transparent; color: var(--av-ink);
    text-align: center; cursor: default; min-width: 0;
    transition: transform 0.2s var(--av-ease), border-color 0.2s, background-color 0.2s;
  }
  button.av-seat { cursor: pointer; }
  button.av-seat:active { transform: scale(0.97); }
  .av-seat.is-self { background: var(--av-surface-2); }
  .av-seat.is-leader { border-color: oklch(0.85 0.12 85 / 0.8); }
  .av-seat.is-team { background: oklch(0.3 0.07 255); border-color: var(--av-good); }
  .av-seat.is-picked { background: oklch(0.34 0.08 85); border-color: var(--av-gold); }
  .av-seat.is-target { background: var(--av-evil-bg); border-color: var(--av-evil); }
  .av-seat.is-disabled { opacity: 0.4; }
  .av-seat.is-left { opacity: 0.35; }
  .av-seat-name { max-width: 100%; font-size: 0.86rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .av-seat-tag { font-size: 0.7rem; color: var(--av-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .av-seat-crown { position: absolute; top: -9px; left: 50%; width: 28px; height: 28px; transform: translateX(-50%); filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.5)); }
  .av-seat-badge { position: absolute; top: 6px; right: 6px; width: 22px; height: 22px; }
  .av-seat-badge img { width: 100%; height: 100%; }
  .av-seat-dot { position: absolute; top: 8px; left: 8px; width: 8px; height: 8px; border-radius: 50%; background: oklch(0.6 0.02 260); }
  .av-seat-dot.is-on { background: oklch(0.78 0.15 150); }
  .av-seat-lady { position: absolute; top: 3px; left: 20px; font-size: 0.85rem; line-height: 1; }
  .av-seat-check { position: absolute; top: 5px; right: 6px; font-size: 0.8rem; color: oklch(0.8 0.14 150); font-weight: 700; }
  .av-seat-role { width: 52px; height: 73px; border-radius: 6px; object-fit: cover; border: 2px solid oklch(0.8 0.11 85 / 0.85); box-shadow: 0 4px 10px rgb(0 0 0 / 0.4); }
  .av-seat-win { font-size: 0.7rem; font-weight: 700; }
  .av-seat-win.is-good { color: var(--av-good); }
  .av-seat-win.is-evil { color: var(--av-evil); }

  /* ---------- action panel ---------- */
  .av-action { margin-top: var(--sp-4); padding: var(--sp-4); border-radius: 20px; background: var(--av-surface); border: 1px solid var(--av-line); }
  .av-action h2 { margin: 0 0 var(--sp-2); font-family: var(--display); font-size: 1.1rem; font-weight: 700; }
  .av-muted { color: var(--av-muted); font-size: 0.9rem; margin: 0; }
  .av-row { display: flex; gap: var(--sp-3); flex-wrap: wrap; align-items: center; }
  .av-row--center { justify-content: center; }
  .av-stack { display: grid; gap: var(--sp-3); }
  .av-team-list { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--sp-2) 0 var(--sp-3); }
  .av-name-pill { padding: 4px 10px; border-radius: 999px; background: oklch(0.3 0.07 255); border: 1px solid var(--av-good); font-size: 0.86rem; font-weight: 600; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .av-name-pill.is-evil { background: var(--av-evil-bg); border-color: var(--av-evil); }
  .av-name-pill.is-merlin { background: oklch(0.32 0.06 85); border-color: var(--av-gold); }

  .av-choices { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }
  .av-choice {
    display: flex; flex-direction: column; align-items: center; gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-2); border-radius: 16px; min-height: 44px;
    background: var(--av-surface-2); border: 2px solid transparent; color: var(--av-ink); cursor: pointer;
    font-weight: 700; font-size: 1rem;
    transition: transform 0.15s var(--av-ease), border-color 0.2s;
  }
  .av-choice:active { transform: scale(0.97); }
  .av-choice img { display: block; }
  .av-choice--token img { width: 84px; height: 84px; }
  .av-choice--card img { width: min(128px, 36vw); height: auto; aspect-ratio: 240 / 336; border-radius: 10px; box-shadow: 0 10px 22px rgb(0 0 0 / 0.45); }
  .av-choice.is-approve:hover, .av-choice.is-approve.is-chosen { border-color: var(--av-good); }
  .av-choice.is-reject:hover, .av-choice.is-reject.is-chosen { border-color: var(--av-evil); }
  .av-choice:disabled { cursor: not-allowed; opacity: 0.38; }
  .av-choice-note { font-size: 0.74rem; font-weight: 500; color: var(--av-muted); }

  .av-pickgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-2); margin: var(--sp-3) 0; }
  .av-pick {
    min-height: 48px; padding: 6px 12px; border-radius: 12px; min-width: 0;
    display: flex; align-items: center; gap: 8px; text-align: left;
    background: var(--av-surface-2); border: 2px solid var(--av-line); color: var(--av-ink);
    font-size: 0.92rem; font-weight: 600; cursor: pointer;
  }
  .av-pick span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .av-pick .av-pick-mark { flex: 0 0 auto; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--av-muted); display: grid; place-items: center; font-size: 0.8rem; }
  .av-pick[aria-pressed="true"] { background: oklch(0.34 0.08 85); border-color: var(--av-gold); }
  .av-pick[aria-pressed="true"] .av-pick-mark { background: var(--av-gold); border-color: var(--av-gold); color: var(--av-gold-ink); }
  .av-pick.is-stab[aria-pressed="true"] { background: var(--av-evil-bg); border-color: var(--av-evil); }
  .av-pick.is-stab[aria-pressed="true"] .av-pick-mark { background: var(--av-evil); border-color: var(--av-evil); color: #fff; }
  .av-pick:disabled { opacity: 0.4; cursor: not-allowed; }
  .av-pick:focus-visible { outline: 3px solid var(--av-gold); outline-offset: 2px; }
  .av-hint { margin: 0; font-size: 0.86rem; color: var(--av-gold); font-weight: 600; }
  .av-choice-note.is-warn { color: oklch(0.85 0.1 40); }
  .av-progress { height: 6px; border-radius: 999px; background: var(--av-sunken); overflow: hidden; margin-top: var(--sp-2); }
  .av-progress > span { display: block; height: 100%; background: var(--av-gold); transition: width 0.3s var(--av-ease); }

  /* ---------- role card ---------- */
  .av-role { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-4); align-items: start; }
  @media (max-width: 420px) { .av-role { grid-template-columns: 1fr; justify-items: center; text-align: center; } .av-role .av-team-list { justify-content: center; } }
  .av-rolecard { position: relative; width: 150px; aspect-ratio: 240 / 336; padding: 0; border: 0; background: none; cursor: pointer; perspective: 900px; border-radius: 12px; }
  .av-rolecard-inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.6s var(--av-ease); }
  .av-rolecard.is-open .av-rolecard-inner { transform: rotateY(180deg); }
  .av-rolecard-face, .av-rolecard-back { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 12px; overflow: hidden; box-shadow: 0 14px 28px rgb(0 0 0 / 0.5); }
  .av-rolecard-face { transform: rotateY(180deg); }
  .av-rolecard img { width: 100%; height: 100%; display: block; object-fit: cover; }
  /* ภาพวาดไม่มีชื่อในตัว — กรอบทอง + ป้ายชื่อสีฝ่าย ทำด้วย CSS ให้คมทุกขนาด */
  .av-rolecard-face { border: 3px solid oklch(0.8 0.11 85); }
  .av-rolecard-name {
    position: absolute; left: 6px; right: 6px; bottom: 6px; padding: 4px 6px; border-radius: 8px;
    font-family: var(--display); font-weight: 700; font-size: 0.92rem; text-align: center; color: #fff;
    background: oklch(0.36 0.1 258 / 0.92); border: 1px solid oklch(0.8 0.11 85 / 0.8);
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.45);
  }
  .av-rolecard-name.is-evil { background: oklch(0.34 0.11 22 / 0.92); }
  .av-rolecard-hint { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); padding: 4px 10px; border-radius: 999px; background: oklch(0.16 0.03 260 / 0.9); color: var(--av-gold); font-size: 0.78rem; font-weight: 700; white-space: nowrap; }
  .av-role-name { font-family: var(--display); font-size: 1.3rem; font-weight: 700; margin: 0; }
  .av-role-team { display: inline-block; margin: 4px 0 var(--sp-2); padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 700; }
  .av-role-team.is-good { background: var(--av-good-bg); color: oklch(0.9 0.05 255); }
  .av-role-team.is-evil { background: var(--av-evil-bg); color: oklch(0.9 0.06 25); }
  .av-role-blurb { margin: 0 0 var(--sp-3); color: var(--av-soft); font-size: 0.92rem; }
  .av-know-title { font-size: 0.78rem; letter-spacing: 0.06em; color: var(--av-gold); font-weight: 700; margin: 0 0 6px; }
  .av-secret-hidden { color: var(--av-muted); font-size: 0.9rem; }

  /* ---------- finished ---------- */
  .av-result { text-align: center; }
  .av-result-team { font-family: var(--display); font-size: 1.8rem; font-weight: 700; margin: 0; }
  .av-result-team.is-good { color: var(--av-good); }
  .av-result-team.is-evil { color: var(--av-evil); }
  .av-result-why { margin: 4px 0 var(--sp-4); color: var(--av-soft); }

  /* ---------- log ---------- */
  .av-log { margin-top: var(--sp-4); }
  .av-log summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--av-soft); font-weight: 600; }
  .av-log-list { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; max-height: 240px; overflow-y: auto; }
  .av .av-log-list li { line-height: 1.45; font-size: 0.86rem; padding: 6px 10px; border-radius: 10px; background: var(--av-surface); color: var(--av-soft); overflow-wrap: anywhere; }

  /* ---------- overlays ---------- */
  .av-overlay {
    position: fixed; inset: 0; z-index: 11000; display: none; align-items: center; justify-content: center;
    padding: var(--sp-4); background: oklch(0.1 0.02 260 / 0.88);
  }
  .av-overlay.is-on { display: flex; animation: avFade 0.2s ease-out; }
  .av-sheet {
    font-family: 'Bai Jamjuree', sans-serif; line-height: 1.5;
    width: min(560px, 100%); max-height: calc(100dvh - 32px); overflow-y: auto;
    padding: var(--sp-5) var(--sp-4); border-radius: 22px; background: var(--av-surface); border: 1px solid var(--av-line);
    text-align: center; color: var(--av-ink);
  }
  .av-sheet h3 { margin: 0 0 4px; font-family: var(--display); font-size: 1.35rem; font-weight: 700; }
  .av-sheet-sub { margin: 0 0 var(--sp-4); color: var(--av-muted); font-size: 0.9rem; }
  .av-reveal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(78px, 1fr)); gap: var(--sp-3) var(--sp-2); }
  .av-reveal-vote { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .av-reveal-vote em { font-style: normal; font-size: 0.68rem; color: var(--av-gold); font-weight: 700; }
  .av-reveal-vote span { max-width: 100%; font-size: 0.78rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .av-coin { position: relative; width: 58px; height: 58px; perspective: 500px; }
  .av-coin-inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.5s var(--av-ease); }
  .av-coin.is-flipped .av-coin-inner { transform: rotateY(180deg); }
  .av-coin-back, .av-coin-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 50%; }
  .av-coin-back { background: var(--av-surface-2); border: 3px solid oklch(0.6 0.08 85 / 0.6); }
  .av-coin-face { transform: rotateY(180deg); }
  .av-coin-face img { width: 100%; height: 100%; }
  .av-cards-row { display: flex; justify-content: center; gap: var(--sp-2); flex-wrap: wrap; }
  .av-qcard { position: relative; width: min(96px, 18vw); aspect-ratio: 240 / 336; perspective: 700px; }
  .av-qcard-inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.55s var(--av-ease); }
  .av-qcard.is-flipped .av-qcard-inner { transform: rotateY(180deg); }
  .av-qcard img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 8px; backface-visibility: hidden; -webkit-backface-visibility: hidden; box-shadow: 0 8px 18px rgb(0 0 0 / 0.5); }
  .av-qcard img.is-face { transform: rotateY(180deg); }
  .av-verdict { margin: var(--sp-4) 0 0; font-family: var(--display); font-size: 1.5rem; font-weight: 700; opacity: 0; transform: translateY(6px); transition: opacity 0.3s, transform 0.3s var(--av-ease); }
  .av-verdict.is-on { opacity: 1; transform: none; }
  .av-verdict.is-good { color: var(--av-good); }
  .av-verdict.is-evil { color: var(--av-evil); }
  .av-sheet .ui-btn { margin-top: var(--sp-4); }

  /* ---------- sidebar / chat ---------- */
  .av-sidebar {
    position: fixed; top: 0; right: 0; width: min(320px, 88vw); height: 100%;
    transform: translateX(105%); background: var(--av-surface); border-left: 1px solid var(--av-line);
    padding: var(--sp-5) var(--sp-4); z-index: 9000; transition: transform 0.25s var(--av-ease); overflow-y: auto; color: var(--av-ink);
  }
  .av-sidebar.open { transform: none; }
  .av-sidebar h4 { font-family: var(--display); margin: 0 0 var(--sp-3); }
  .av-sidebar ul { list-style: none; padding: 0; margin: 0 0 var(--sp-4); }
  .av-sidebar li { display: flex; align-items: center; gap: var(--sp-2); padding: 8px 0; border-bottom: 1px solid var(--av-line); min-width: 0; }
  .av-sidebar li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .av-sidebar-overlay { display: none; position: fixed; inset: 0; background: rgb(0 0 0 / 0.55); z-index: 8999; }
  .chat-box {
    --chat-accent: oklch(0.55 0.12 258); --chat-accent-dark: oklch(0.4 0.1 258);
    --chat-surface: oklch(0.2 0.035 260); --chat-border: oklch(0.45 0.04 260 / 0.6); --chat-bubble: oklch(0.28 0.04 260);
    font-family: 'Bai Jamjuree', sans-serif;
  }
  .chat-toggle { --chat-toggle-bg: oklch(0.4 0.1 258); border-radius: 999px; padding: 12px 18px; min-height: 48px; }
  .btn-chat-send { --chat-send-bg: oklch(0.85 0.12 85); --chat-send-color: oklch(0.2 0.04 70); }

  @keyframes avFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes avDeal { from { opacity: 0; transform: translateY(-24px) scale(0.92); } to { opacity: 1; transform: none; } }
  .av-rolecard.is-deal { animation: avDeal 0.5s var(--av-ease) both; }
  @keyframes avPulse { 0%, 100% { box-shadow: 0 0 0 0 oklch(0.85 0.12 85 / 0.5); } 50% { box-shadow: 0 0 0 6px oklch(0.85 0.12 85 / 0); } }
  button.av-seat.is-pickable { animation: avPulse 2s ease-in-out infinite; }

  @media (min-width: 720px) {
    .av { padding-top: var(--sp-4); }
    .av-title { font-size: 1.4rem; }
    .av-seats { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .av-quest-token { width: 70px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .av-rolecard-inner, .av-coin-inner, .av-qcard-inner, .av-quest-token, .av-verdict, .av-progress > span, .av-sidebar { transition: none !important; }
    .av-rolecard.is-deal, button.av-seat.is-pickable, .av-overlay.is-on { animation: none !important; }
    .av-seat, .av-choice { transition: none !important; }
  }
</style>

<div id="connectionStatus" class="av-chip av-chip--danger" style="display:none; position:fixed; top:10px; left:50%; transform:translateX(-50%); z-index:10001;">กำลังเชื่อมต่อใหม่...</div>

<main class="av" id="avRoot">
  <div class="av-top">
    <div class="av-brand">
      <div class="av-kicker">อวาลอน · อัศวินโต๊ะกลม</div>
      <div class="av-title" role="heading" aria-level="1"><%= room.name %></div>
    </div>
    <div class="av-top-actions">
      <button type="button" id="avExitBtn" class="av-chip av-chip--exit">🚪 ออก</button>
      <button type="button" id="avRoleBtn" class="av-chip" aria-label="ดูบทของฉัน">บทของฉัน</button>
      <button type="button" id="avHowBtn" class="av-chip" aria-label="วิธีเล่น">?<span class="av-chip-label">วิธีเล่น</span></button>
      <button type="button" id="avPlayersBtn" class="av-chip" aria-label="ผู้เล่น" aria-expanded="false" aria-controls="playerSidebar">☰</button>
    </div>
  </div>

  <section id="avStatus" class="av-status" aria-live="polite">
    <div id="avPhase" class="av-phase">กำลังโหลด</div>
    <div id="avNow" class="av-now">...</div>
    <div class="av-timer" aria-hidden="true"><div id="avTimer" class="av-timer-num">--</div></div>
    <div id="avTimerHint" class="av-timer-hint"></div>
    <div id="avStatusBar" class="av-status-bar" aria-hidden="true" hidden><span></span></div>
  </section>

  <section class="av-board" aria-label="กระดานภารกิจ">
    <div id="avTrack" class="av-track"></div>
    <div class="av-rejects">
      <span>คัดค้านติดกัน</span>
      <span id="avPips" class="av-pips" aria-hidden="true"></span>
      <span id="avRejectText"></span>
    </div>
    <div id="avLastLine" class="av-lastline"></div>
    <div id="avRolesLine" class="av-rolesline"></div>
    <div id="avSeats" class="av-seats"></div>
  </section>

  <section id="avAction" class="av-action"></section>

  <details class="av-log" id="avRecapWrap" hidden>
    <summary id="avRecapSummary">สรุปภารกิจ</summary>
    <ul id="avRecap" class="av-recap"></ul>
  </details>

  <details class="av-log">
    <summary>บันทึกเกม</summary>
    <ul id="avLog" class="av-log-list"></ul>
  </details>
</main>

<div id="avOverlay" class="av-overlay" role="dialog" aria-modal="true" aria-labelledby="avOverlayTitle">
  <div class="av-sheet" id="avSheet"></div>
</div>

<aside id="playerSidebar" class="av-sidebar" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="avPlayerTitle">
  <h4 id="avPlayerTitle">ผู้เล่นในห้อง</h4>
  <ul id="onlinePlayerList"></ul>
  <div class="av-stack">
    <% if (room.admin) { %>
    <button type="button" id="avEndBtn" class="ui-btn ui-btn--block">⏹ จบเกม กลับห้องรอ</button>
    <% } %>
    <button id="leaveRoomBtn" type="button" class="ui-btn ui-btn--block">ออกจากห้อง</button>
    <button id="closeSidebarBtn" type="button" class="ui-btn ui-btn--ghost ui-btn--block">ปิด</button>
  </div>
</aside>
<div id="sidebarOverlay" class="av-sidebar-overlay"></div>

<div id="chatBox" class="chat-box" role="dialog" aria-modal="true" aria-labelledby="avChatTitle" aria-hidden="true" style="display:none;">
  <div class="chat-header">
    <div class="chat-title" id="avChatTitle">💬 แชท</div>
    <button type="button" id="closeChat" class="chat-close" aria-label="ปิดแชท">✕</button>
  </div>
  <div id="replyPreview" class="chat-reply-preview-bar" style="display:none;">
    <div class="reply-content">
      <span class="reply-indicator">ตอบกลับ</span>
      <span class="reply-player-name"></span>:
      <span class="reply-message-content"></span>

  <div id="chatMessages" class="chat-messages" role="log" aria-live="polite"></div>
  <div class="chat-input-wrap">
    <textarea id="chatInput" rows="1" placeholder="พิมพ์ข้อความ..." aria-label="พิมพ์ข้อความ"></textarea>

<%- contentFor('script') %>
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/gameIcon.js"></script>
<script src="/js/chatPanel.js"></script>
<script src="/js/coupGuide.js"></script>
<script>
$(function() {
  document.documentElement.classList.add('cp-active');

  const socket = io({ reconnection: true, reconnectionAttempts: Infinity, transports: ['websocket', 'polling'] });
  const roomId = '<%= room.roomId %>';
  const playerId = '<%= player.playerId %>';
  const playerName = '<%= player.name %>';
  const isRoomAdmin = <%= room.admin === true ? 'true' : 'false' %>;
  if (window.partyPlay) window.partyPlay.startSession('coup', socket);

  let currentState = <%- JSON.stringify(typeof coupState !== 'undefined' ? coupState : {}) %>;
  let allowNavigation = false;
  let pendingTargetAction = null;   // แอ็กชันที่รอให้เลือกเป้าหมาย
  let pendingTargetId = null;       // เป้าหมายที่แตะแล้ว รอกดยืนยัน (เฉพาะแอ็กชันที่เสียเหรียญ)
  let exchangeSelection = [];
  let commandBusy = false;          // กันกดซ้ำระหว่างรอ server ตอบ
  let commandBusyTimer = null;
  let clockOffset = 0;              // เวลา server - เวลาเครื่อง (นาฬิกามือถือมักเพี้ยน)
  function nowMs() { return Date.now() + clockOffset; }

  function escapeHtml(text) {
    return String(text == null ? '' : text).replace(/[&<>"']/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c]);
  }

  function cardArt(card, height) {
    if (!card) return '';
    if (card.image) {
      return '<img src="' + escapeHtml(card.image) + '" alt="' + escapeHtml(card.thaiName) + '" loading="lazy">';
    }
    return '<div class="cp-emoji">' + escapeHtml(card.icon || '🃏') + '</div>';
  }

  function avatarHtml(player, size) {
    if (typeof window.renderPlayerAvatar === 'function') {
      return window.renderPlayerAvatar({
        avatar: player.avatar, avatarFrame: player.avatarFrame,
        color: player.color, playerName: player.name
      }, { size: size || 26 });
    }
    return '<span>' + escapeHtml(player.avatar || '👤') + '</span>';
  }

  // ---------- แถบ "ตอนนี้ต้องทำอะไร" ----------
  function describeNow(state) {
    const me = state.self;
    if (state.phase === 'finished') {
      return { text: '🏆 ' + (state.winner ? state.winner.name + ' เป็นผู้รอดคนสุดท้าย' : 'จบเกม'), mine: false };
    }
    if (me && !me.alive) return { text: 'คุณตกรอบแล้ว — ดูเกมต่อได้', mine: false };

    if (state.phase === 'lose-influence' && state.pendingLoss) {
      return state.pendingLoss.isMe
        ? { text: '💥 คุณต้องหงายการ์ด 1 ใบ', mine: true }
        : { text: 'รอ ' + state.pendingLoss.playerName + ' เลือกหงายการ์ด', mine: false };
    }
    if (state.phase === 'exchange') {
      return state.pendingExchange && state.pendingExchange.options
        ? { text: '🔄 เลือกการ์ดที่จะเก็บไว้', mine: true }
        : { text: 'รอ ' + (state.pendingExchange?.waitingFor || 'ผู้เล่น') + ' แลกเปลี่ยนการ์ด', mine: false };
    }
    if (state.phase === 'block-respond' && state.pendingAction && state.pendingBlock) {
      // กติกา: ใครก็ท้าการขวางได้ ไม่ใช่แค่คนที่โดนขวาง
      return state.availableResponses
        ? { text: '🛡️ ' + state.pendingBlock.blockerName + ' อ้างว่ามี ' + state.pendingBlock.card.thaiName + ' — เชื่อไหม?', mine: true }
        : { text: state.pendingBlock.blockerName + ' ขวางด้วย ' + state.pendingBlock.card.thaiName +
              ' · รออีก ' + (state.pendingBlock.waitingFor?.length || 0) + ' คนตอบ', mine: false };
    }
    if (state.phase === 'respond' && state.pendingAction) {
      const p = state.pendingAction;
      const desc = p.actorName + ' ประกาศ ' + p.action.thaiLabel + (p.targetName ? ' ใส่ ' + p.targetName : '');
      return state.availableResponses
        ? { text: '⚡ ' + desc + ' — เชื่อหรือไม่?', mine: true }
        : { text: desc + ' · รออีก ' + (p.waitingFor?.length || 0) + ' คนตอบ', mine: false };
    }
    if (state.phase === 'action') {
      return state.isMyTurn
        ? { text: '🎯 ตาคุณแล้ว — เลือก 1 แอ็กชัน', mine: true }
        : { text: 'รอ ' + (state.players.find(p => p.isCurrent)?.name || '...') + ' เลือกแอ็กชัน', mine: false };
    }
    return { text: 'รอเกมเริ่ม...', mine: false };
  }

  // ---------- ตัวช่วยอ่าน state ----------
  function nameOf(state, id) {
    const p = (state.players || []).find(x => x.playerId === id);
    return p ? p.name : '';
  }
  // บอกเจ้าของมือ (เห็นคนเดียว) ว่าที่จะอ้างนี้มีจริงหรือบลัฟ — มือใหม่ชอบกดอ้างโดยไม่รู้ตัวว่ากำลังโกหก
  function holds(state, cardId) {
    return !!(state.self && (state.self.influence || []).some(c => c.id === cardId));
  }
  function namesOf(state, ids) {
    return (ids || []).map(id => nameOf(state, id)).filter(Boolean);
  }

  /** ใครยังต้องตัดสินใจ และใครปล่อยผ่านไปแล้ว ในช่วงตอบโต้ (ใช้ทั้งแผงรอและป้ายในรายชื่อ) */
  function responseStatus(state) {
    const p = state.pendingAction;
    if (!p) return null;
    if (state.phase === 'respond') {
      const waiting = p.waitingFor || [];
      const eligible = (state.players || []).filter(x => x.alive && x.playerId !== p.actorId &&
        (!p.blockOnly || x.playerId === p.targetId)).map(x => x.playerId);
      return { waiting, passed: eligible.filter(id => !waiting.includes(id)), eligible };
    }
    if (state.phase === 'block-respond' && state.pendingBlock) {
      const waiting = state.pendingBlock.waitingFor || [];
      const eligible = (state.players || []).filter(x => x.alive && x.playerId !== state.pendingBlock.blockerId)
        .map(x => x.playerId);
      return { waiting, passed: eligible.filter(id => !waiting.includes(id)), eligible };
    }
    return null;
  }

  // ทำไมต้องหงายการ์ด — เดิมขึ้นแค่ "ต้องหงาย 1 ใบ" คนแพ้ไม่รู้ว่าแพ้เพราะอะไร
  function lossReasonText(state) {
    const loss = state.pendingLoss;
    if (!loss) return '';
    const p = state.pendingAction;
    const who = loss.isMe ? 'คุณ' : loss.playerName;
    switch (loss.reason) {
      case 'coup': return (p ? p.actorName : 'มีคน') + ' ทำรัฐประหารใส่' + who;
      case 'assassinate': return (p ? p.actorName : 'มีคน') + ' ลอบสังหาร' + who + 'สำเร็จ';
      case 'challenge-lost': return who + 'ท้าแล้วแพ้ — อีกฝ่ายมีการ์ดจริง';
      case 'bluff-caught': return who + 'โดนจับได้ว่าไม่มีการ์ดที่อ้าง';
      default: return '';
    }
  }

  function pendingSummaryHtml(state) {
    const p = state.pendingAction;
    if (!p) return '';
    let html = '<b>' + escapeHtml(p.actorName) + '</b> ประกาศ <b>' + escapeHtml(p.action.icon + ' ' + p.action.thaiLabel) + '</b>' +
      (p.targetName ? ' ใส่ <b>' + escapeHtml(p.targetName) + '</b>' : '') +
      (p.claimCard ? '<br><small>อ้างว่ามี ' + escapeHtml(p.claimCard.icon + ' ' + p.claimCard.thaiName) + '</small>' : '');
    if (state.phase === 'block-respond' && state.pendingBlock) {
      html += '<br>🛡️ <b>' + escapeHtml(state.pendingBlock.blockerName) + '</b> ขวางโดยอ้างว่ามี <b>' +
        escapeHtml(state.pendingBlock.card.icon + ' ' + state.pendingBlock.card.thaiName) + '</b>';
    } else if (p.blockOnly) {
      html += '<br><small>มีคนท้าแล้วแพ้ — ' + escapeHtml(p.targetName || 'เป้าหมาย') + ' ยังขวางได้</small>';
    }
    return '<div class="cp-pending">' + html + '</div>';
  }

  // ---------- มือของเรา ----------
  let lossSelection = null;      // การ์ดที่แตะเลือกจะหงาย (ต้องกดยืนยันอีกที)
  let exchangeSeededStep = null; // เลือกการ์ดเดิมไว้ให้ก่อน ครั้งเดียวต่อการแลก

  function renderHand(state) {
    const me = state.self;
    $('#myCoins').text(me ? me.coins : 0);
    if (!me) { $('#myHand').html('<div class="cp-empty">คุณไม่ได้อยู่ในเกมนี้ — ดูอย่างเดียว</div>'); return; }

    const needPick = state.phase === 'lose-influence' && state.pendingLoss?.isMe;
    let html = me.influence.map(card =>
      '<div class="cp-influence' + (needPick ? ' is-pick' : '') + (needPick && lossSelection === card.id ? ' is-selected' : '') +
        '" data-card-id="' + escapeHtml(card.id) + '"' + (needPick ? ' role="button" tabindex="0"' : '') + '>' +
        cardArt(card) +
        '<div class="cp-influence-name">' + escapeHtml(card.icon + ' ' + card.thaiName) + '</div>' +
        '<div class="cp-influence-power">' + escapeHtml(card.power || card.counter || '') + '</div>' +
      '</div>').join('');

    // ระหว่างแลกการ์ด การ์ดในมือย้ายไปอยู่ในตัวเลือกชั่วคราว — ห้ามขึ้นว่า "ตกรอบแล้ว"
    if (!me.influence.length && me.alive && state.phase === 'exchange') {
      html = '<div class="cp-empty">🔄 การ์ดของคุณอยู่ในกองแลกเปลี่ยน — เลือกใบที่จะเก็บด้านล่าง</div>' + html;
    }

    html += me.revealed.map(card =>
      '<div class="cp-influence is-revealed">' + cardArt(card) +
        '<div class="cp-influence-name">' + escapeHtml(card.thaiName) + '</div>' +
        '<div class="cp-influence-power">หงายแล้ว</div>' +
      '</div>').join('');

    $('#myHand').html(html || '<div class="cp-empty">ตกรอบแล้ว</div>');
  }

  // หัวข้อกล่องปุ่ม เปลี่ยนตามสิ่งที่กำลังขอให้ผู้เล่นทำ
  function actionAreaTitle(state) {
    if (state.phase === 'finished') return '🏆 ผลการแข่งขัน';
    if (state.phase === 'lose-influence' && state.pendingLoss?.isMe) return '💥 เลือกการ์ดที่จะหงาย';
    if (state.phase === 'exchange' && state.pendingExchange?.options) return '🔄 เลือกการ์ดที่จะเก็บ';
    if (state.availableResponses) return '⚡ ตอบโต้';
    if (state.phase === 'action' && state.isMyTurn) return '🎯 ตาของคุณ';
    return '⏳ รอผู้เล่นคนอื่น';
  }

  // ปุ่มแต่ละอันทำอะไรกับเรา — ใส่ไว้ใต้ปุ่มตอบโต้ คนเล่นครั้งแรกจะได้ไม่ต้องเดา
  function respondHintHtml(state, respond) {
    const p = state.pendingAction;
    const b = state.pendingBlock;
    const lines = [];
    if (respond.challengingBlock && b) {
      lines.push('🔥 <b>ท้าการขวาง</b>: ถ้า ' + escapeHtml(b.blockerName) + ' ไม่มี ' + escapeHtml(b.card.thaiName) +
        ' จริง เขาเสียการ์ด 1 ใบและแอ็กชันเดินต่อ · ถ้ามีจริง <b>คุณ</b>เสียการ์ด 1 ใบ');
      lines.push('✋ <b>ปล่อยผ่าน</b>: ยอมรับการขวาง แอ็กชันนี้เป็นโมฆะ');
      return lines.join('<br>');
    }
    const iAmTarget = p.targetId === playerId;
    if (respond.canChallenge) {
      lines.push('🔥 <b>ท้า</b>: ถ้า ' + escapeHtml(p.actorName) + ' ไม่มี ' + escapeHtml(p.claimCard ? p.claimCard.thaiName : 'การ์ดนั้น') +
        ' เขาเสียการ์ด 1 ใบ' + (p.coinsPaid ? ' (ได้ ' + p.coinsPaid + ' เหรียญคืน)' : '') + ' · ถ้ามีจริง <b>คุณ</b>เสียการ์ด 1 ใบ');
    }
    if ((respond.blockOptions || []).length) {
      lines.push('🛡️ <b>ขวาง</b>: อ้างว่ามีการ์ดที่ขวางได้ (ไม่มีจริงก็อ้างได้ แต่ถ้าโดนท้าจะเสียการ์ด)');
    }
    if (iAmTarget && p.actionId === 'assassinate') lines.push('✋ <b>ยอมรับ</b>: คุณต้องหงายการ์ด 1 ใบ');
    else if (iAmTarget && p.actionId === 'steal') lines.push('✋ <b>ยอมรับ</b>: โดนขโมยสูงสุด 2 เหรียญ');
    else lines.push('✋ <b>ปล่อยผ่าน</b>: เชื่อ ให้แอ็กชันเกิดขึ้น');
    return lines.join('<br>');
  }

  function waitingPanelHtml(state) {
    const me = state.self;
    const status = responseStatus(state);
    if (status && (state.phase === 'respond' || state.phase === 'block-respond')) {
      const iPassed = me && me.alive && status.passed.includes(playerId);
      const iAmActor = state.pendingAction && state.pendingAction.actorId === playerId;
      const iAmBlocker = state.pendingBlock && state.pendingBlock.blockerId === playerId;
      const waitingNames = namesOf(state, status.waiting);
      return pendingSummaryHtml(state) +
        (iPassed ? '<div class="cp-done">✓ คุณปล่อยผ่านแล้ว</div>' : '') +
        (iAmActor && state.phase === 'respond' ? '<div class="cp-hint">คนอื่นกำลังตัดสินใจว่าจะเชื่อคุณไหม</div>' : '') +
        (iAmBlocker ? '<div class="cp-hint">คนอื่นกำลังตัดสินใจว่าจะเชื่อการขวางของคุณไหม</div>' : '') +
        (waitingNames.length
          ? '<div class="cp-waitlist">⏳ รอ <b>' + escapeHtml(waitingNames.join(', ')) + '</b> ตัดสินใจ' +
            ' <small>(ทุกคนกดครบ = ไปต่อทันที)</small></div>'
          : '');
    }
    if (state.phase === 'lose-influence' && state.pendingLoss) {
      const why = lossReasonText(state);
      return '<div class="cp-pending">💥 รอ <b>' + escapeHtml(state.pendingLoss.playerName) + '</b> เลือกหงายการ์ด 1 ใบ' +
        (why ? '<br><small>' + escapeHtml(why) + '</small>' : '') + '</div>';
    }
    if (state.phase === 'exchange' && state.pendingExchange?.waitingFor) {
      return '<div class="cp-pending">🔄 รอ <b>' + escapeHtml(state.pendingExchange.waitingFor) + '</b> เลือกการ์ดที่จะเก็บ</div>';
    }
    if (state.phase === 'action') {
      const cur = (state.players || []).find(p => p.isCurrent);
      return '<div class="cp-empty">รอ ' + escapeHtml(cur ? cur.name : '...') + ' เลือกแอ็กชัน...</div>';
    }
    return '<div class="cp-empty">รอตาของผู้เล่นคนอื่น...</div>';
  }

  function resultHtml(state) {
    const me = state.self;
    const winnerName = state.winner?.name || '-';
    let meLine = '';
    if (me) {
      meLine = state.winner && state.winner.playerId === playerId
        ? '🎉 คุณชนะ — รอดเป็นคนสุดท้าย!'
        : 'คุณตกรอบ · ผู้ชนะคือ ' + winnerName;
    }
    return '<div class="cp-result"><h3>🏆 ' + escapeHtml(winnerName) + ' ชนะ!</h3>' +
      (meLine ? '<p class="cp-result-me">' + escapeHtml(meLine) + '</p>' : '') +
      '<div class="cp-result-actions">' +
        (isRoomAdmin ? '<button type="button" id="cpRestartBtn" class="cp-btn cp-btn-primary">🎲 เล่นอีกรอบ</button>' : '') +
        '<button type="button" id="cpShareBtn" class="cp-btn cp-btn-outline">📸 เซฟผล</button>' +
        '<button type="button" id="cpBackLobbyBtn" class="cp-btn cp-btn-outline">🏠 กลับห้อง</button>' +
      '</div>' +
      '<p class="cp-hint">การ์ดที่เหลือในมือทุกคนเปิดให้ดูแล้วในรายชื่อผู้เล่น · ย้อนดูได้ในบันทึกเกม</p>' +
      '<p class="cp-empty" id="cpBackRemain" style="margin-top:6px;">' +
        (isRoomAdmin ? 'กดกลับห้องแล้วทุกคนไปด้วย' : 'เดี๋ยวระบบพาทุกคนกลับห้องรอ') + '</p></div>';
  }

  // ---------- พื้นที่ปุ่มหลัก ----------
  function renderActionArea(state) {
    const $area = $('#actionArea');
    const me = state.self;

    if (state.phase === 'finished') { $area.html(resultHtml(state)); return; }

    if (me && !me.alive) {
      $area.html('<div class="cp-empty">คุณตกรอบแล้ว — ดูเกมต่อได้</div>' + waitingPanelHtml(state));
      return;
    }

    // เลือกการ์ดที่จะหงาย — แตะเลือกก่อน แล้วกดยืนยัน (หงายแล้วย้อนไม่ได้)
    if (state.phase === 'lose-influence' && state.pendingLoss?.isMe) {
      const cards = me ? me.influence : [];
      if (lossSelection && !cards.some(c => c.id === lossSelection)) lossSelection = null;
      const picked = cards.find(c => c.id === lossSelection);
      const why = lossReasonText(state);
      $area.html(
        (why ? '<div class="cp-pending">💥 ' + escapeHtml(why) + '</div>' : '') +
        '<div>แตะการ์ดที่จะ<b>หงายทิ้ง</b> แล้วกดยืนยัน — ใบที่เหลือยังใช้ต่อได้</div>' +
        '<div class="cp-respond" style="margin-top:10px;">' +
          cards.map(card => '<button type="button" class="cp-btn ' + (lossSelection === card.id ? 'cp-btn-challenge' : 'cp-btn-pass') +
            '" data-loss-pick="' + escapeHtml(card.id) + '" aria-pressed="' + (lossSelection === card.id) + '">' +
            escapeHtml(card.icon + ' ' + card.thaiName) + '</button>').join('') +
          '<button type="button" id="cpLossConfirm" class="cp-btn cp-btn-primary cp-btn-confirm"' + (picked ? '' : ' disabled') + '>' +
            (picked ? 'ยืนยันหงาย ' + escapeHtml(picked.thaiName) : 'เลือกการ์ดก่อน') + '</button>' +
        '</div>');
      return;
    }

    // Ambassador เลือกการ์ด — ใบเดิมถูกเลือกไว้ก่อน กดยืนยันได้เลยถ้าไม่อยากเปลี่ยน
    if (state.phase === 'exchange' && state.pendingExchange?.options) {
      const keep = state.pendingExchange.keepCount;
      const options = state.pendingExchange.options;
      if (exchangeSeededStep !== state.step) {
        exchangeSeededStep = state.step;
        exchangeSelection = options.slice(0, keep).map((_, i) => i);
      }
      $area.html(
        '<div style="margin-bottom:6px;">เลือกเก็บ <b>' + keep + '</b> ใบ (เลือกแล้ว <span id="exchangeCount">' + exchangeSelection.length + '</span>/' + keep + ')</div>' +
        '<div class="cp-hint" style="margin:0 0 10px;">เลือกใบเดิมไว้ให้แล้ว — แตะใบใหม่เพื่อสลับ · ใบที่ไม่เลือกกลับเข้ากอง</div>' +
        '<div class="cp-hand">' + options.map((card, index) =>
          '<div class="cp-influence is-pick' + (exchangeSelection.includes(index) ? ' is-selected' : '') + '" data-exchange-index="' + index + '" role="button" tabindex="0">' +
            '<span class="cp-card-tag' + (index < keep ? '' : ' is-new') + '">' + (index < keep ? 'ใบเดิม' : 'ใบใหม่') + '</span>' +
            cardArt(card) + '<div class="cp-influence-name">' + (exchangeSelection.includes(index) ? '✓ ' : '') + escapeHtml(card.icon + ' ' + card.thaiName) + '</div>' +
          '</div>').join('') + '</div>' +
        '<button type="button" id="cpExchangeConfirm" class="cp-btn cp-btn-primary" style="margin-top:12px; width:100%;"' +
          (exchangeSelection.length === keep ? '' : ' disabled') + '>' +
          (exchangeSelection.length === keep ? 'ยืนยันเก็บ ' + keep + ' ใบนี้' : 'เลือกอีก ' + (keep - exchangeSelection.length) + ' ใบ') + '</button>');
      return;
    }

    // ตอบโต้ (challenge / block / ผ่าน)
    const respond = state.availableResponses;
    if (respond) {
      const p = state.pendingAction;
      const iAmTarget = p && p.targetId === playerId;
      const passLabel = iAmTarget && (p.actionId === 'assassinate' || p.actionId === 'steal') ? '✋ ยอมรับ' : '✋ ปล่อยผ่าน';
      let html = pendingSummaryHtml(state) +
        // ผูกปุ่มกับ "ขั้น" ที่ render — server ปัดตกคำตอบที่ช้ามาถึงหลังเฟสเปลี่ยนแล้ว
        '<div class="cp-respond" data-step="' + escapeHtml(String(state.step ?? '')) +
        '" data-phase="' + escapeHtml(String(state.phase || '')) +
        '" data-turn="' + escapeHtml(String(state.turnNumber ?? '')) + '">';
      html += '<button type="button" class="cp-btn cp-btn-pass" data-respond="pass">' + passLabel + '</button>';
      if (respond.canChallenge) {
        html += '<button type="button" class="cp-btn cp-btn-challenge" data-respond="challenge">🔥 ' +
          (respond.challengingBlock ? 'ท้าการขวาง' : 'ท้า (ไม่เชื่อ)') + '</button>';
      }
      (respond.blockOptions || []).forEach(option => {
        html += '<button type="button" class="cp-btn cp-btn-block" data-respond="block" data-claim="' +
          escapeHtml(option.id) + '">' + escapeHtml(option.icon + ' ขวางด้วย ' + option.thaiName) +
          '<span class="cp-target-meta">' + (holds(state, option.id) ? '✓ คุณมีจริง' : 'ไม่มีจริง = บลัฟ') + '</span></button>';
      });
      html += '</div><div class="cp-hint">' + respondHintHtml(state, respond) + '</div>';
      const status = responseStatus(state);
      const others = status ? namesOf(state, status.waiting.filter(id => id !== playerId)) : [];
      if (others.length) html += '<div class="cp-waitlist">ยังรอ: ' + escapeHtml(others.join(', ')) + '</div>';
      $area.html(html);
      return;
    }

    // ตาเรา — เลือกแอ็กชัน
    if (state.phase === 'action' && state.isMyTurn) {
      if (pendingTargetAction) {
        const targets = state.players.filter(p => p.alive && p.playerId !== playerId);
        const needsConfirm = pendingTargetAction.cost > 0;   // รัฐประหาร/ลอบสังหาร เสียเหรียญ ย้อนไม่ได้
        const chosen = needsConfirm && pendingTargetId ? targets.find(t => t.playerId === pendingTargetId) : null;
        $area.html('<div style="margin-bottom:10px;">เลือกเป้าหมายสำหรับ <b>' +
            escapeHtml(pendingTargetAction.icon + ' ' + pendingTargetAction.thaiLabel) + '</b>' +
            (pendingTargetAction.cost ? ' · จ่าย ' + pendingTargetAction.cost + ' เหรียญ' : '') + '</div><div class="cp-respond">' +
          targets.map(t => '<button type="button" class="cp-btn ' + (chosen && chosen.playerId === t.playerId ? 'cp-btn-challenge' : 'cp-btn-block') +
            '" data-target="' + escapeHtml(t.playerId) + '">' + escapeHtml(t.name) +
            '<span class="cp-target-meta">💰 ' + t.coins + ' · การ์ด ' + t.influenceCount + ' ใบ' +
            (pendingTargetAction.id === 'steal' && t.coins === 0 ? ' · ไม่มีเหรียญให้ขโมย' : '') + '</span></button>').join('') +
          (chosen ? '<button type="button" class="cp-btn cp-btn-primary cp-btn-confirm" data-confirm-target="1">ยืนยัน ' +
            escapeHtml(pendingTargetAction.thaiLabel + ' ใส่ ' + chosen.name) + '</button>' : '') +
          '<button type="button" class="cp-btn cp-btn-pass" data-cancel-target="1">ยกเลิก</button></div>');
        return;
      }
      const menu = (state.actionMenu && state.actionMenu.length)
        ? state.actionMenu
        : (state.availableActions || []).map(a => Object.assign({ enabled: true, reason: '' }, a));
      // ต้องรัฐประหาร: ยกปุ่มที่กดได้ขึ้นบนสุด ไม่ให้จมอยู่ใต้ปุ่มที่ล็อก
      if (state.self?.mustCoup) menu.sort((x, y) => Number(y.enabled) - Number(x.enabled));
      $area.html(
        (state.self?.mustCoup ? '<div style="color:var(--cp-red); margin-bottom:8px;">⚠️ มี 10 เหรียญขึ้นไป ต้องทำรัฐประหารเท่านั้น</div>' : '') +
        '<div class="cp-actions">' + menu.map(action =>
          '<button type="button" class="cp-action" data-action="' + escapeHtml(action.id) +
            '" data-needs-target="' + (action.needsTarget ? '1' : '') + '"' + (action.enabled ? '' : ' disabled aria-disabled="true"') + '>' +
            '<span class="cp-action-head">' + escapeHtml(action.icon + ' ' + action.thaiLabel) +
              (action.cost ? ' · จ่าย ' + action.cost : '') + '</span>' +
            '<span class="cp-action-detail">' + escapeHtml(action.detail) + '</span>' +
            (action.claimCard ? '<span class="cp-action-claim">อ้างว่ามี ' + escapeHtml(action.claimCard.icon + ' ' + action.claimCard.thaiName) +
              (holds(state, action.claimCard.id) ? ' · ✓ คุณมีจริง' : ' · ไม่มีจริง = บลัฟ') + '</span>' : '') +
            (action.reason ? '<span class="cp-action-why">🔒 ' + escapeHtml(action.reason) + '</span>' : '') +
          '</button>').join('') + '</div>');
      return;
    }

    $area.html(waitingPanelHtml(state));
  }

  function renderPlayers(state) {
    const status = responseStatus(state);
    const targetId = state.phase !== 'action' && state.phase !== 'finished' ? state.pendingAction?.targetId : null;
    $('#playerGrid').html((state.players || []).map(p => {
      let tags = '';
      if (p.alive && status) {
        if (status.waiting.includes(p.playerId)) tags += '<span class="cp-tag cp-tag-wait">⏳ กำลังคิด</span> ';
        else if (status.passed.includes(p.playerId)) tags += '<span class="cp-tag cp-tag-pass">✓ ผ่าน</span> ';
      }
      if (targetId && p.playerId === targetId) tags += '<span class="cp-tag cp-tag-target">🎯 เป้าหมาย</span> ';
      if (state.phase === 'lose-influence' && state.pendingLoss?.playerId === p.playerId) tags += '<span class="cp-tag cp-tag-target">💥 กำลังเลือกหงาย</span> ';
      return '<div class="cp-player' + (p.isCurrent ? ' is-current' : '') + (p.alive ? '' : ' is-out') + '"' +
        ' data-player-id="' + escapeHtml(p.playerId) + '">' +
        '<div class="cp-player-top">' + avatarHtml(p, 26) +
          '<span class="cp-player-name" style="color:' + escapeHtml(p.color || '#fff') + '">' +
          escapeHtml(p.name) + (p.isSelf ? ' (คุณ)' : '') + '</span></div>' +
        '<div class="cp-player-stats">' +
          '<span class="cp-player-coins">💰 ' + p.coins + '</span>' +
          '<span class="cp-backs" aria-label="การ์ดคว่ำ ' + p.influenceCount + ' ใบ">' + Array.from({ length: p.influenceCount }, () => '<span class="cp-back"></span>').join('') + '</span>' +
          (p.alive ? '' : '<span>ตกรอบ</span>') +
        '</div>' +
        (p.revealed.length
          ? '<div class="cp-dead-card">หงาย: ' + p.revealed.map(c => escapeHtml(c.thaiName)).join(', ') + '</div>'
          : '') +
        (p.finalHand && p.finalHand.length
          ? '<div class="cp-final-hand">ในมือ: ' + p.finalHand.map(c => escapeHtml(c.icon + ' ' + c.thaiName)).join(', ') + '</div>'
          : '') +
        (tags ? '<div>' + tags + '</div>' : '') +
      '</div>';
    }).join(''));
  }

  function renderHistory(state) {
    const items = state.history || [];
    $('#historyFeed').html(items.length
      ? items.map(item => '<div class="cp-feed-item" data-at="' + escapeHtml(item.at || '') + '">' +
          escapeHtml(item.icon + ' ' + item.text) + '</div>').join('')
      : '<div class="cp-empty">ยังไม่มีเหตุการณ์</div>');
    // บรรทัดล่าสุดโชว์ในแถบติดขอบบนด้วย — มือถือไม่ต้องเลื่อนลงไปอ่านบันทึก
    const last = items[0];
    if (last && state.phase !== 'lobby') {
      $('#cpNowLast').html('ล่าสุด: <b>' + escapeHtml(last.icon + ' ' + last.text) + '</b>').show();
    } else {
      $('#cpNowLast').text('').hide();
    }
  }

  // หมดเวลาแล้ว server ทำต่อให้เอง (autoResolvePhase) — บอกล่วงหน้าว่าจะทำอะไร
  // ไม่งั้นคนเล่นเห็นเลข 0 แล้วไม่รู้ว่าเกมค้างหรือเดินต่อ
  function timeoutHint(state) {
    switch (state.phase) {
      case 'action':
        return state.self && state.self.coins >= 10
          ? 'หมดเวลา → ทำรัฐประหารให้อัตโนมัติ'
          : 'หมดเวลา → รับรายได้ให้อัตโนมัติ';
      case 'respond': return 'หมดเวลา → ถือว่าทุกคนปล่อยผ่าน';
      case 'block-respond': return 'หมดเวลา → ยอมรับการขวาง';
      case 'lose-influence': return 'หมดเวลา → หงายการ์ดใบซ้ายสุดให้';
      case 'exchange': return 'หมดเวลา → เก็บการ์ดเดิมไว้ให้';
      default: return '';
    }
  }

  function updateTimer() {
    const endsAt = currentState?.phaseEndsAt;
    const $timer = $('#cpTimer');
    const $hint = $('#cpTimeoutHint');

    if (currentState.phase === 'finished') {
      const remain = currentState.returnLobbyEndsAt
        ? Math.max(0, Math.ceil((Number(currentState.returnLobbyEndsAt) - nowMs()) / 1000))
        : 0;
      $timer.text(remain > 0 ? remain + ' วิ' : '--').removeClass('is-urgent');
      $hint.text(remain > 0 ? 'แล้วกลับห้องรอพร้อมกัน' : 'กำลังกลับห้องรอ...').show();
      $('#cpBackRemain').text(remain > 0
        ? (isRoomAdmin ? 'กดกลับห้องแล้วทุกคนไปด้วย · ' : '') + 'ระบบพาทุกคนกลับห้องใน ' + remain + ' วิ'
        : 'กำลังพากลับห้องรอ...');
      return;
    }

    if (!endsAt) {
      $timer.text('--').removeClass('is-urgent');
      $hint.text('').hide();
      return;
    }

    const left = Math.max(0, Math.ceil((endsAt - nowMs()) / 1000));
    $timer.text(left > 0 ? left + ' วิ' : 'หมดเวลา').toggleClass('is-urgent', left <= 5 && left > 0);

    // โผล่ตอนเหลือ 10 วิ — ช่วงที่คนเริ่มลุ้นว่าไม่กดแล้วจะเป็นยังไง
    const hint = left <= 10 ? timeoutHint(currentState) : '';
    if (hint) $hint.text(hint).show();
    else $hint.text('').hide();
  }

  /* ==================== อนิเมชัน ====================
     renderState เขียน DOM ใหม่ทั้งก้อนทุกครั้ง เลยจำค่าที่สนใจไว้ก่อนหน้า
     แล้วเทียบว่าอะไรเปลี่ยน จึงติดคลาสอนิเมชันให้เฉพาะจุดที่เปลี่ยนจริง */

  const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let motionPrev = null;

  function motionSnapshot(state) {
    const byId = {};
    (state.players || []).forEach(p => {
      byId[p.playerId] = { coins: p.coins, influence: p.influenceCount, alive: p.alive };
    });
    return {
      byId,
      selfCoins: state.self ? state.self.coins : null,
      selfRevealed: state.self ? state.self.revealed.length : 0,
      selfInfluence: state.self ? state.self.influence.length : 0,
      currentId: state.currentPlayerId || null,
      phase: state.phase,
      newestAt: (state.history && state.history[0]) ? state.history[0].at : null,
      nowCopy: null
    };
  }

  function floatCoinDelta($holder, delta) {
    if (!$holder.length || !delta) return;
    const text = (delta > 0 ? '+' : '') + delta;
    const $tag = $('<span class="cp-coin-delta ' + (delta > 0 ? 'is-up' : 'is-down') + '"></span>').text(text);
    $holder.append($tag);
    setTimeout(() => $tag.remove(), 1100);
  }

  const FLASH_STYLES = {
    challenge:   { label: '⚔️ ท้า!',        color: '#ff6b81' },
    block:       { label: '🛡️ ขวาง!',       color: '#c48dff' },
    coup:        { label: '💥 รัฐประหาร!',  color: '#ff9f43' },
    assassinate: { label: '🗡️ ลอบสังหาร!',  color: '#ff6b81' },
    eliminated:  { label: '💀 ตกรอบ',       color: '#ff6b81' },
    winner:      { label: '🏆 ชนะ!',        color: '#f5c86b' }
  };

  let flashTimer = null;
  function showFlash(kind, subtitle) {
    const style = FLASH_STYLES[kind];
    if (!style || reduceMotion) return;
    const $flash = $('#cpFlash');
    $flash.removeClass('is-on');
    // บังคับให้เบราว์เซอร์ล้าง animation เดิมก่อน ไม่งั้นสั่งซ้ำติดๆ กันแล้วไม่เล่นรอบใหม่
    void $flash[0].offsetWidth;
    $flash.css('color', style.color).html(
      escapeHtml(style.label) +
      (subtitle ? '<span class="cp-flash-sub">' + escapeHtml(subtitle) + '</span>' : '')
    ).addClass('is-on');

    clearTimeout(flashTimer);
    flashTimer = setTimeout(() => $flash.removeClass('is-on'), 1300);

    if (typeof window.gameHaptic === 'function') {
      // จังหวะหนัก (ตกรอบ/รัฐประหาร) สั่นเป็นจังหวะ ส่วนอย่างอื่นสั่นสั้นครั้งเดียว
      const heavy = kind === 'eliminated' || kind === 'coup';
      window.gameHaptic(heavy ? [35, 60, 35] : 22);
    }
  }

  function applyMotion(state) {
    const next = motionSnapshot(state);
    const prev = motionPrev;
    motionPrev = next;

    if (reduceMotion) return;

    // แจกการ์ดรอบแรกที่เห็นมือตัวเอง
    if (!prev || prev.selfInfluence === 0) {
      if (next.selfInfluence > 0) $('#myHand .cp-influence').addClass('cp-anim-deal');
    }
    if (!prev) return;

    // การ์ดของเราโดนหงายเพิ่ม
    if (next.selfRevealed > prev.selfRevealed) {
      $('#myHand .cp-influence.is-revealed').slice(-1).addClass('cp-anim-reveal');
    }
    // จั่วใบใหม่เข้ามือ (แลกเปลี่ยน / ท้าแล้วชนะได้ใบแทน)
    if (next.selfInfluence > prev.selfInfluence) {
      $('#myHand .cp-influence').not('.is-revealed').addClass('cp-anim-deal');
    }

    // เหรียญของเรา
    if (prev.selfCoins !== null && next.selfCoins !== null && next.selfCoins !== prev.selfCoins) {
      $('#myCoins').addClass('cp-anim-coin');
      setTimeout(() => $('#myCoins').removeClass('cp-anim-coin'), 520);
      floatCoinDelta($('#myCoins').closest('.cp-coins'), next.selfCoins - prev.selfCoins);
    }

    // ผู้เล่นแต่ละคน
    Object.keys(next.byId).forEach(id => {
      const before = prev.byId[id];
      const after = next.byId[id];
      if (!before) return;
      const $row = $('#playerGrid .cp-player[data-player-id="' + id.replace(/"/g, '\\"') + '"]');
      if (!$row.length) return;

      if (after.coins !== before.coins) {
        floatCoinDelta($row.find('.cp-player-coins'), after.coins - before.coins);
      }
      if (before.alive && !after.alive) $row.addClass('cp-anim-out');
    });

    // เปลี่ยนตา
    if (next.currentId && next.currentId !== prev.currentId) {
      $('#playerGrid .cp-player[data-player-id="' + String(next.currentId).replace(/"/g, '\\"') + '"]')
        .addClass('cp-anim-turn');
      if (state.isMyTurn && window.partyPlay) {
        window.partyPlay.pingTurn({
          key: 'coup-turn-' + next.currentId + '-' + (state.turnNumber || 0),
          title: 'ถึงตาคุณแล้ว',
          subtitle: 'เลือก 1 แอ็กชัน'
        });
      }
    }

    // บรรทัดใหม่ในบันทึกเกม + ป้ายประกาศจังหวะสำคัญ
    if (next.newestAt && next.newestAt !== prev.newestAt) {
      const fresh = [];
      for (const item of (state.history || [])) {
        if (item.at === prev.newestAt) break;
        fresh.push(item);
      }
      fresh.forEach(item => {
        $('#historyFeed .cp-feed-item[data-at="' + String(item.at).replace(/"/g, '\\"') + '"]')
          .addClass('cp-anim-new');
      });
      // เหตุการณ์เก่าสุดในชุดใหม่คือจังหวะที่เพิ่งเกิด ประกาศอันที่ดราม่าที่สุดอันเดียวพอ
      const headline = fresh.reverse().find(item => FLASH_STYLES[item.kind]);
      if (headline) showFlash(headline.kind, headline.text);
    }
  }

  function renderState(state) {
    if (!state || !state.players) return;
    // เปลี่ยนเฟสแล้วล้างตัวเลือกค้าง กันกดพลาดข้ามเฟส
    if (state.phase !== currentState.phase) { pendingTargetAction = null; pendingTargetId = null; exchangeSelection = []; }
    if (state.step !== currentState.step) lossSelection = null;
    if (typeof state.serverNow === 'number') clockOffset = state.serverNow - Date.now();
    if (currentState.phase === 'finished' && state.phase !== 'finished' && window.partyPlay) {
      window.partyPlay.resetPing();
    }
    currentState = state;

    const now = describeNow(state);
    $('#actionAreaTitle').text(actionAreaTitle(state));

    const $nowCopy = $('#cpNowCopy');
    if ($nowCopy.text() !== now.text) {
      $nowCopy.removeClass('cp-anim-swap').text(now.text);
      void $nowCopy[0].offsetWidth;
      $nowCopy.addClass('cp-anim-swap');
    }
    $('#cpNowBar').toggleClass('is-mine', now.mine);
    $('#deckCount').text(state.deckCount);

    renderHand(state);
    renderActionArea(state);
    renderPlayers(state);
    renderHistory(state);
    updateTimer();
    applyMotion(state);
    pingCoupNeed(state);
    revealDecision(state);
  }

  // ถึงคราวเราต้องตัดสินใจ (ตาเรา/ตอบโต้/หงาย/แลก) แต่กล่องปุ่มอยู่นอกจอ → เลื่อนให้เห็นครั้งเดียวต่อขั้น
  // ไม่เลื่อนถ้ากำลังพิมพ์แชทอยู่ ไม่งั้นคีย์บอร์ดเด้ง/ข้อความหาย
  let revealedDecisionKey = null;
  let decisionSeenOnce = false;
  function revealDecision(state) {
    const mine = state.phase !== 'finished' && (
      (state.phase === 'action' && state.isMyTurn) || !!state.availableResponses ||
      (state.phase === 'lose-influence' && state.pendingLoss?.isMe) ||
      (state.phase === 'exchange' && !!state.pendingExchange?.options));
    if (!mine) { revealedDecisionKey = null; decisionSeenOnce = true; return; }
    const key = state.phase + ':' + state.step;
    if (key === revealedDecisionKey) return;
    revealedDecisionKey = key;
    // เพิ่งเปิด/รีเฟรชหน้า — ไม่กระชากจอ ให้เห็นหัวห้องก่อน (แถบบนติดจอบอกอยู่แล้วว่าถึงตาเรา)
    if (!decisionSeenOnce) { decisionSeenOnce = true; if (window.scrollY === 0) return; }
    const active = document.activeElement;
    if (active && (active.id === 'chatInput' || active.tagName === 'TEXTAREA' || active.tagName === 'INPUT')) return;
    const box = document.getElementById('actionArea');
    if (!box) return;
    const card = box.closest('.cp-card') || box;
    const rect = card.getBoundingClientRect();
    const barHeight = (document.getElementById('cpNowBar')?.getBoundingClientRect().height) || 0;
    // พอแค่ปุ่มแรกโผล่พ้นแถบบนและปุ่มแชทลอยด้านล่าง (~70px) ก็ไม่ต้องเลื่อน — ไม่กระชากจอโดยไม่จำเป็น
    const firstButton = box.querySelector('button') || card;
    const b = firstButton.getBoundingClientRect();
    if (b.top >= barHeight && b.bottom <= window.innerHeight - 70) return;
    window.scrollTo({ top: Math.max(0, window.scrollY + rect.top - barHeight - 8), behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  function pingCoupNeed(state) {
    if (!window.partyPlay || !state || state.phase === 'finished') return;
    if (state.self && state.self.alive === false) return;
    if (state.phase === 'lose-influence' && state.pendingLoss?.isMe) {
      window.partyPlay.pingTurn({ key: 'coup-loss-' + (state.pendingLoss.playerId || 'me'), title: 'เลือกการ์ดที่จะหงาย', subtitle: 'แตะการ์ดในมือ' });
      return;
    }
    if (state.phase === 'exchange' && state.pendingExchange?.options) {
      window.partyPlay.pingTurn({ key: 'coup-ex-' + (state.turnNumber || 0), title: 'เลือกการ์ดที่จะเก็บ', subtitle: 'แลกไพ่แล้ว' });
      return;
    }
    if (state.availableResponses) {
      window.partyPlay.pingTurn({
        // ใส่ step ด้วย — ไม่งั้นช่วง "ท้าการขวาง" ของแอ็กชันเดียวกันไม่เด้งเตือน
        key: 'coup-respond-' + (state.pendingAction?.actorId || '') + '-' + (state.pendingAction?.actionId || state.phase) + '-' + (state.step || 0),
        title: 'ถึงตาคุณตอบโต้',
        subtitle: state.availableResponses.challengingBlock ? 'ท้าการขวาง หรือปล่อยผ่าน' : 'ท้า ขวาง หรือปล่อยผ่าน'
      });
      return;
    }
    if (state.phase === 'action' && state.isMyTurn) {
      window.partyPlay.pingTurn({
        key: 'coup-turn-' + (state.currentPlayerId || '') + '-' + (state.turnNumber || 0),
        title: 'ถึงตาคุณแล้ว',
        subtitle: 'เลือก 1 แอ็กชัน'
      });
    }
  }

  // แจ้ง error แบบ toast ด้านบน ไม่บังจอ ไม่ต้องกดปิด (เดิมเป็น popup ต้องกด OK ทุกครั้ง)
  function toastError(message) {
    Swal.fire({
      toast: true, position: 'top', icon: 'warning', title: message || 'ทำรายการไม่สำเร็จ',
      showConfirmButton: false, timer: 3200, timerProgressBar: true, background: '#1b0f2b', color: '#fff'
    });
  }

  function releaseCommand() {
    commandBusy = false;
    clearTimeout(commandBusyTimer);
    $('#actionArea, #myHand').removeClass('is-busy');
  }

  // กันกดซ้ำ: ระหว่างรอ server ปุ่มในกล่องแอ็กชันกดไม่ได้ (กดรัวแล้วเด้ง "คุณตอบไปแล้ว")
  function sendCommand(event, payload) {
    if (commandBusy) return false;
    commandBusy = true;
    $('#actionArea button').prop('disabled', true).addClass('is-busy');
    $('#actionArea, #myHand').addClass('is-busy');
    commandBusyTimer = setTimeout(function() { releaseCommand(); renderActionArea(currentState); }, 8000);
    socket.emit(event, payload, function(res) {
      releaseCommand();
      if (res && !res.success) {
        toastError(res.error);
        renderActionArea(currentState);
        socket.emit('coup_requestState', { roomId, playerId });
      }
    });
    return true;
  }

  // ---------- ปุ่มต่างๆ ----------
  $(document).on('click', '.cp-action', function() {
    const actionId = $(this).attr('data-action');
    const needsTarget = $(this).attr('data-needs-target');
    const action = (currentState.availableActions || []).find(a => a.id === actionId);
    if (!action) return;
    if (needsTarget) { pendingTargetAction = action; renderActionArea(currentState); return; }
    sendCommand('coup_submitAction', { actionId });
  });

  $(document).on('click', '[data-target]', function() {
    if (!pendingTargetAction || commandBusy) return;
    const targetPlayerId = $(this).attr('data-target');
    // รัฐประหาร/ลอบสังหารเสียเหรียญและย้อนไม่ได้ — แตะชื่อแล้วต้องกดยืนยันอีกที กันนิ้วโดนชื่อข้างๆ
    if (pendingTargetAction.cost > 0) {
      pendingTargetId = targetPlayerId;
      renderActionArea(currentState);
      return;
    }
    const actionId = pendingTargetAction.id;
    pendingTargetAction = null;
    sendCommand('coup_submitAction', { actionId, targetPlayerId });
  });

  $(document).on('click', '[data-confirm-target]', function() {
    if (!pendingTargetAction || !pendingTargetId || commandBusy) return;
    const payload = { actionId: pendingTargetAction.id, targetPlayerId: pendingTargetId };
    pendingTargetAction = null;
    pendingTargetId = null;
    sendCommand('coup_submitAction', payload);
  });

  $(document).on('click', '[data-cancel-target]', function() {
    pendingTargetAction = null;
    pendingTargetId = null;
    renderActionArea(currentState);
  });

  $(document).on('click', '[data-respond]', function() {
    const $box = $(this).closest('.cp-respond');
    const toNum = raw => (raw === undefined || raw === '' ? NaN : Number(raw));
    const step = toNum($box.attr('data-step'));
    const turnNumber = toNum($box.attr('data-turn'));
    sendCommand('coup_respond', {
      response: $(this).attr('data-respond'),
      claimCard: $(this).attr('data-claim') || null,
      step: Number.isFinite(step) ? step : null,
      phase: $box.attr('data-phase') || null,
      turnNumber: Number.isFinite(turnNumber) ? turnNumber : null
    });
  });

  // เลือกการ์ดหงายตอนเสีย influence — แตะเลือก (จากมือหรือปุ่ม) แล้วค่อยกดยืนยัน
  function pickLossCard(cardId) {
    if (commandBusy || !(currentState.phase === 'lose-influence' && currentState.pendingLoss?.isMe)) return;
    lossSelection = lossSelection === cardId ? null : cardId;
    renderHand(currentState);
    renderActionArea(currentState);
  }
  $(document).on('click', '.cp-influence.is-pick[data-card-id]', function() { pickLossCard($(this).attr('data-card-id')); });
  $(document).on('click', '[data-loss-pick]', function() { pickLossCard($(this).attr('data-loss-pick')); });
  $(document).on('click', '#cpLossConfirm', function() {
    if (!lossSelection) return;
    const cardId = lossSelection;
    if (sendCommand('coup_loseInfluence', { cardId })) lossSelection = null;
  });

  // เลือกการ์ดตอนแลกเปลี่ยน
  $(document).on('click', '.cp-influence[data-exchange-index]', function() {
    const index = Number($(this).attr('data-exchange-index'));
    const keepCount = currentState.pendingExchange?.keepCount || 0;
    if (commandBusy) return;
    const at = exchangeSelection.indexOf(index);
    if (at >= 0) exchangeSelection.splice(at, 1);
    else {
      // เลือกครบแล้วแตะใบใหม่ = สลับกับใบที่เลือกไว้ก่อนสุด (เดิมแตะแล้วเงียบ ไม่รู้ว่าต้องยกเลิกก่อน)
      if (exchangeSelection.length >= keepCount) exchangeSelection.shift();
      if (keepCount > 0) exchangeSelection.push(index);
    }
    renderActionArea(currentState);
  });

  $(document).on('click', '#cpExchangeConfirm', function() {
    const options = currentState.pendingExchange?.options || [];
    sendCommand('coup_exchange', { keepCardIds: exchangeSelection.map(i => options[i].id) });
  });

  $(document).on('click', '#cpShareBtn', function() {
    if (!window.partyPlay || !currentState) return;
    const alive = (currentState.players || []).filter(p => p.alive).map(p => p.name);
    const dead = (currentState.players || []).filter(p => !p.alive).map(p => p.name);
    window.partyPlay.shareResult({
      mode: 'Coup',
      headline: (currentState.winner?.name || '-') + ' ชนะ!',
      sub: 'รอด: ' + (alive.join(', ') || '-'),
      lines: dead.length ? ['ตกรอบ: ' + dead.join(', ')] : ['ไม่มีใครตกรอบก่อนจบ'],
      accent: '#c48dff',
      fileName: 'coup-result'
    });
  });

  $(document).on('click', '#cpRestartBtn', function() {
    socket.emit('startGameFromLobby', { roomId }, function(res) {
      if (res && !res.success) {
        Swal.fire({ icon: 'error', title: res.error || 'เริ่มใหม่ไม่สำเร็จ', background: '#1b0f2b', color: '#fff' });
      }
    });
  });

  $(document).on('click', '#cpBackLobbyBtn', function() {
    socket.emit('returnFinishedToLobby', { roomId: roomId }, function(res) { if (res && res.canReturnSelf) { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; } });
  });

  $('#cpHowToOpen').on('click', function() {
    if (typeof window.showCoupGuide === 'function') {
      window.showCoupGuide({ cards: currentState.cardCatalog || [] });
    }
  });

  $('#cpEndGameBtn').on('click', function() {
    Swal.fire({
      icon: 'warning', title: 'จบเกมและกลับห้องรอ?', showCancelButton: true,
      confirmButtonText: 'จบเกม', cancelButtonText: 'ยกเลิก', background: '#1b0f2b', color: '#fff'
    }).then(result => {
      if (result.isConfirmed) socket.emit('resetGame');
    });
  });

  function toggleSidebar() {
    $('#playerSidebar').toggleClass('open');
    $('#sidebarOverlay').toggle();
  }
  $('#cpSidebarBtn, #closeSidebarBtn, #sidebarOverlay').on('click', toggleSidebar);

  $('#leaveRoomBtn').on('click', function() {
    Swal.fire({
      icon: 'question', title: 'ออกจากห้อง?', showCancelButton: true,
      confirmButtonText: 'ออก', cancelButtonText: 'ยกเลิก', background: '#1b0f2b', color: '#fff'
    }).then(result => {
      if (result.isConfirmed) {
        allowNavigation = true;
        socket.emit('leaveRoom', {}, function() { window.location.href = '/rooms?playerId=' + playerId; });
      }
    });
  });

  // ---------- socket ----------
  socket.on('connect', function() {
    $('#connectionStatus').hide();
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId, playerId });
    socket.emit('coup_requestState', { roomId, playerId });
  });
  socket.on('disconnect', function() { $('#connectionStatus').show(); });
  socket.on('coupState', renderState);

  socket.on('roomUpdate', function(data) {
    if (!data || !data.players) return;
    $('#onlinePlayerList').html(data.players.map(p =>
      '<li style="display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid rgba(255,255,255,0.08);">' +
        avatarHtml({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: p.color, name: p.displayName || p.playerName }, 26) +
        '<span style="color:' + escapeHtml(p.color || '#fff') + '">' + escapeHtml(p.displayName || p.playerName) + '</span>' +
        (p.online === false ? '<span style="margin-left:auto; font-size:0.78rem; color:var(--cp-muted);">ออฟไลน์</span>' : '') +
      '</li>').join(''));
  });

  socket.on('redirectToLobby', function() { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; });
  socket.on('returnToLobby', function(data) {
    if (!currentState) return;
    currentState.returnLobbyEndsAt = Number(data && data.endsAt) || (nowMs() + (Number(data && data.countdown) || 10) * 1000);
    updateTimer();
  });
  socket.on('restartGame', function() { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; });
  socket.on('gameStarting', function() { allowNavigation = true; window.location.href = '/game/' + roomId + '?playerId=' + playerId; });
  socket.on('kickedFromRoom', function(data) {
    allowNavigation = true;
    Swal.fire({ icon: 'error', title: 'ถูกเตะออกจากห้อง', text: data?.reason || '', background: '#1b0f2b', color: '#fff' })
      .then(() => { window.location.href = '/rooms?playerId=' + playerId; });
  });

  // /m — แอดมินเว็บ (เท่านั้น) ขอเฉลยการ์ดทั้งโต๊ะ (สิทธิ์เช็คที่ server ฝั่งนี้แค่ยิงคำสั่ง)
  window.initChatPanel({
    socket, playerId, playerName,
    onCommand: function(text) {
      if (text.trim().toLowerCase() !== '/m') return false;
      socket.emit('coup_admin_reveal');
      return true;
    }
  });

  socket.on('coup_admin_reveal_denied', function() {
    Swal.fire({
      icon: 'info', title: 'ใช้ไม่ได้',
      text: 'คำสั่ง /m ใช้ได้เฉพาะแอดมินเว็บเท่านั้น',
      background: '#1b0f2b', color: '#fff', confirmButtonColor: '#7c3aed'
    });
  });

  socket.on('coup_admin_reveal', function(data) {
    const players = (data && data.players) || [];
    const cardChips = list => (list.length
      ? list.map(c => '<span class="cpr-chip">' + escapeHtml(c.icon + ' ' + c.name) + '</span>').join('')
      : '<span class="cpr-empty">—</span>');

    const rows = players.map(p => {
      const isTurn = p.playerId === data.turnPlayerId;
      return '<div class="cpr-row' + (p.alive ? '' : ' is-out') + '">' +
        '<div class="cpr-head"><b>' + escapeHtml(p.name) + '</b>' +
        (isTurn ? '<span class="cpr-turn">ถึงตา</span>' : '') +
        (p.alive ? '' : '<span class="cpr-out">ตกรอบ</span>') +
        '<span class="cpr-coins">🪙 ' + p.coins + '</span></div>' +
        '<div class="cpr-cards"><span class="cpr-label">ในมือ</span>' + cardChips(p.influence) + '</div>' +
        (p.revealed.length
          ? '<div class="cpr-cards cpr-dim"><span class="cpr-label">หงายแล้ว</span>' + cardChips(p.revealed) + '</div>'
          : '') +
        '</div>';
    }).join('');

    Swal.fire({
      title: '🔍 เฉลยทั้งโต๊ะ (แอดมิน)',
      html: '<div class="cpr">' + (rows || '<p>ยังไม่มีผู้เล่น</p>') +
        '<p class="cpr-foot">🂠 การ์ดในกอง ' + (data.deckCount || 0) + ' ใบ · เห็นคนเดียว ไม่ส่งเข้าแชท</p></div>',
      width: 480, background: '#14091f', color: '#fff',
      confirmButtonText: 'ปิด', confirmButtonColor: '#7c3aed',
      customClass: { popup: 'coup-guide-popup' }
    });
  });

  window.addEventListener('beforeunload', function(e) {
    if (!allowNavigation) { e.preventDefault(); e.returnValue = ''; }
  });

  socket.emit('initPlayer', playerId);
  socket.emit('setRoom', { roomId, playerId });
  renderState(currentState);
  setInterval(updateTimer, 500);
  socket.emit('coup_requestState', { roomId, playerId });
});
</script>

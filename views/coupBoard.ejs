<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/chatPanel.css">
<link rel="stylesheet" href="/static/css/coupGuide.css">
<style>
  * { box-sizing: border-box; }

  html.cp-active,
  html.cp-active body.content {
    overflow-x: hidden;
    margin: 0 !important;
    padding: 0 !important;
    background: #12071a !important;
  }
  /* ซ่อนแบนเนอร์ของ layout เท่านั้น — ต้องเจาะจง .container-fluid > header
     ไม่งั้นโดน <div class="cp-topbar"> ของกระดานเองด้วย (ปุ่มวิธีเล่น/ผู้เล่น/จบเกมหายทั้งแถบ) */
  html.cp-active .container-fluid > header,
  html.cp-active .footer,
  html.cp-active #music-controls { display: none !important; }
  html.cp-active .container-fluid { padding: 0 !important; margin: 0 !important; max-width: none !important; }
  /* overflow-x:hidden ของ body/.container-fluid ทำให้ position:sticky ใช้ไม่ได้ (กลายเป็นกล่องเลื่อนเอง)
     ใช้ clip แทน — ยังกันจอเลื่อนข้างได้เหมือนเดิม แต่แถบ "ตอนนี้" ติดขอบบนจอได้ */
  html.cp-active body.content,
  html.cp-active .container-fluid { overflow-x: clip !important; overflow-y: visible !important; }
  html.cp-active .container-fluid > .row { margin: 0 !important; }
  html.cp-active .col-lg-12 { padding: 0 !important; }

  :root {
    --cp-line: rgba(196, 141, 255, 0.16);
    --cp-purple: #c48dff;
    --cp-gold: #f5c86b;
    --cp-red: #ff6b81;
    --cp-text: #f4ecff;
    --cp-muted: #9a8fb0;
  }

  body.content {
    background:
      radial-gradient(circle at 10% 5%, rgba(168, 85, 247, 0.20), transparent 26%),
      radial-gradient(circle at 90% 0%, rgba(245, 200, 107, 0.10), transparent 22%),
      linear-gradient(180deg, #12071a 0%, #1b0f2b 100%);
    font-family: 'Bai Jamjuree', sans-serif;
  }

  /* padding ล่างเผื่อปุ่มแชทลอย ไม่ให้บังบันทึกเกม/ปุ่มท้ายหน้า */
  .cp-page { max-width: 960px; margin: 14px auto 0; padding: 12px 12px 96px; color: var(--cp-text); }
  .cp-shell {
    border: 1px solid var(--cp-line); border-radius: 26px;
    background: rgba(20, 10, 32, 0.92);
    box-shadow: 0 28px 80px rgba(0,0,0,0.5);
    /* clip (ไม่ใช่ hidden) — hidden ทำให้แถบ "ตอนนี้" ติดขอบบนจอ (sticky) ไม่ได้ */
    overflow: hidden; overflow: clip;
  }

  .cp-topbar {
    display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap;
    padding: 18px 20px; border-bottom: 1px solid var(--cp-line);
    background: linear-gradient(135deg, rgba(168,85,247,0.14), rgba(18,7,26,0.9));
  }
  .cp-kicker { color: var(--cp-purple); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .cp-title { margin: 4px 0 0; font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-size: clamp(1.3rem, 4vw, 1.9rem); }
  .cp-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-start; justify-content: flex-end; }
  .cp-chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px;
    border: 1px solid var(--cp-line); background: rgba(255,255,255,0.04);
    font-size: 0.88rem; font-weight: 600; color: var(--cp-text); cursor: default; font-family: inherit;
  }
  .cp-chip-btn { cursor: pointer; min-height: 40px; }
  .cp-chip-danger { border-color: rgba(255,107,129,0.35); color: #ffc9d1; }

  /* แถบบอกว่าตอนนี้ต้องทำอะไร — จุดสำคัญที่สุดของหน้านี้ */
  /* ติดขอบบนจอตอนเลื่อน — มือถือเลื่อนลงไปดูปุ่ม/บันทึก ก็ยังเห็นว่าตาใคร เหลือกี่วิ */
  .cp-now {
    position: sticky; top: 0; z-index: 60;
    display: flex; align-items: center; gap: 4px 12px; flex-wrap: wrap;
    padding: 12px 20px; border-bottom: 1px solid var(--cp-line);
    background: #180c26;
  }
  .cp-now.is-mine { background: #2a1d24; box-shadow: inset 0 -2px 0 rgba(245,200,107,0.55); }
  .cp-now-last {
    flex: 1 0 100%; min-width: 0; font-size: 0.82rem; color: var(--cp-muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .cp-now-last b { color: #d8ccec; font-weight: 600; }
  .cp-now-label { color: var(--cp-purple); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .cp-now-copy { font-size: 1.02rem; flex: 1 1 0; min-width: 0; line-height: 1.35; }
  .cp-timer-wrap { margin-left: auto; text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  /* Chakra Petch มีตัวไทยในตัว — ตัวเลขกับ "วิ" ใช้ฟอนต์เดียวกัน */
  .cp-timer { font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-size: 1.25rem; color: var(--cp-gold); white-space: nowrap; }
  .cp-timeout-hint { font-size: 0.74rem; color: var(--cp-muted); white-space: nowrap; }

  .cp-grid { padding: 16px 20px 22px; display: grid; gap: 14px; }

  .cp-card {
    border: 1px solid var(--cp-line); border-radius: 18px;
    background: rgba(0,0,0,0.2); padding: 14px;
  }
  .cp-card-title { font-size: 1rem; font-weight: 700; color: var(--cp-purple); margin-bottom: 10px; }

  /* ---- มือของเรา ---- */
  .cp-hand { display: flex; gap: 12px; flex-wrap: wrap; }
  .cp-influence {
    position: relative; width: 124px; border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(245,200,107,0.35); background: #1c1030; text-align: center;
  }
  .cp-influence.is-revealed { opacity: 0.42; filter: grayscale(1); border-color: rgba(255,255,255,0.12); }
  .cp-influence img, .cp-influence .cp-emoji {
    display: block; width: 100%; height: 148px; object-fit: cover; object-position: top center;
  }
  .cp-influence .cp-emoji { display: flex; align-items: center; justify-content: center; font-size: 2.6rem; background: rgba(255,255,255,0.05); }
  .cp-influence-name { padding: 6px 4px; font-weight: 700; font-size: 0.86rem; }
  .cp-influence-power { padding: 0 6px 8px; font-size: 0.72rem; color: var(--cp-muted); line-height: 1.3; }
  .cp-influence.is-pick { cursor: pointer; }
  .cp-influence.is-pick:hover, .cp-influence.is-selected { border-color: var(--cp-gold); box-shadow: 0 0 0 2px rgba(245,200,107,0.5); }

  .cp-coins { font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-size: 1.5rem; color: var(--cp-gold); }

  /* ---- ผู้เล่นคนอื่น ---- */
  .cp-players { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .cp-player {
    border: 1px solid var(--cp-line); border-radius: 14px; padding: 10px;
    background: rgba(255,255,255,0.03);
  }
  .cp-player.is-current { border-color: var(--cp-gold); box-shadow: 0 0 0 1px rgba(245,200,107,0.35); }
  .cp-player.is-out { opacity: 0.4; }
  .cp-player-top { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .cp-player-name { font-weight: 700; font-size: 0.94rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cp-player-stats { display: flex; gap: 10px; font-size: 0.84rem; color: var(--cp-muted); }
  .cp-tag {
    display: inline-block; margin-top: 6px; padding: 2px 8px; border-radius: 999px;
    font-size: 0.74rem; font-weight: 600; border: 1px solid var(--cp-line); color: var(--cp-text);
  }
  .cp-tag-wait { border-color: rgba(245,200,107,0.45); color: var(--cp-gold); }
  .cp-tag-pass { color: #8ee6b8; border-color: rgba(110,231,183,0.35); }
  .cp-tag-target { color: #ffc9d1; border-color: rgba(255,107,129,0.45); }
  .cp-final-hand { margin-top: 4px; font-size: 0.74rem; color: var(--cp-gold); }
  .cp-backs { display: inline-flex; gap: 3px; }
  .cp-back { width: 13px; height: 19px; border-radius: 3px; background: linear-gradient(160deg,#6d28d9,#3b0764); border: 1px solid rgba(255,255,255,0.18); }
  .cp-dead-card { font-size: 0.72rem; color: #ff9aa8; }

  /* ---- ปุ่มแอ็กชัน ---- */
  .cp-actions { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .cp-action {
    min-height: 48px;
    display: flex; flex-direction: column; gap: 3px; align-items: flex-start;
    padding: 12px; border-radius: 14px; cursor: pointer; text-align: left;
    border: 1px solid var(--cp-line); background: rgba(255,255,255,0.04);
    color: var(--cp-text); font-family: inherit; font-size: 0.95rem;
  }
  .cp-action:hover:not(:disabled) { border-color: rgba(196,141,255,0.5); background: rgba(196,141,255,0.1); }
  .cp-action:disabled { opacity: 0.45; cursor: not-allowed; }
  .cp-action-head { font-weight: 700; }
  .cp-action-detail { font-size: 0.76rem; color: var(--cp-muted); line-height: 1.35; }
  .cp-action-claim { font-size: 0.72rem; color: var(--cp-gold); }
  .cp-action-why { font-size: 0.74rem; color: #ffb3bf; font-weight: 600; }
  .cp-action:disabled .cp-action-why { opacity: 1; }

  .cp-pending {
    padding: 10px 12px; margin-bottom: 10px; border-radius: 12px;
    background: rgba(255,255,255,0.04); border: 1px solid var(--cp-line); line-height: 1.45;
  }
  .cp-hint { font-size: 0.8rem; color: var(--cp-muted); margin-top: 8px; line-height: 1.45; text-align: left; }
  .cp-hint b { color: var(--cp-text); }
  .cp-waitlist { margin-top: 8px; font-size: 0.86rem; color: var(--cp-muted); }
  .cp-waitlist b { color: var(--cp-gold); }
  .cp-done { color: #8ee6b8; font-weight: 700; margin-top: 8px; }
  .cp-pick-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 8px 0 4px; }
  .cp-card-tag {
    position: absolute; top: 6px; left: 6px; padding: 2px 8px; border-radius: 999px;
    font-size: 0.72rem; font-weight: 700; background: rgba(10,4,18,0.85); color: var(--cp-text);
  }
  .cp-card-tag.is-new { color: var(--cp-gold); }
  .cp-target-meta { display: block; font-size: 0.76rem; font-weight: 600; opacity: 0.85; }

  .cp-respond { display: flex; gap: 10px; flex-wrap: wrap; }
  .cp-btn {
    min-height: 48px; padding: 11px 18px; border-radius: 12px; border: none; cursor: pointer;
    font-family: inherit; font-weight: 700; font-size: 0.95rem;
  }
  .cp-btn:disabled, .cp-btn.is-busy { opacity: 0.55; cursor: progress; }
  .cp-btn-confirm { flex: 1 1 100%; }
  .cp-btn-pass { background: rgba(255,255,255,0.1); color: var(--cp-text); }
  .cp-btn-challenge { background: linear-gradient(135deg, #ff6b81, #c81e3a); color: #fff; }
  .cp-btn-block { background: linear-gradient(135deg, #a855f7, #6d28d9); color: #fff; }
  .cp-btn-primary { background: linear-gradient(135deg, #f5c86b, #d99a24); color: #2a1a05; }
  .cp-btn-outline { background: transparent; border: 1px solid var(--cp-line); color: var(--cp-text); }

  .cp-feed { display: grid; gap: 6px; max-height: 260px; overflow-y: auto; text-align: left; }
  .cp-feed-item { font-size: 0.9rem; color: #d8ccec; padding: 6px 10px; background: rgba(255,255,255,0.03); border-radius: 8px; line-height: 1.4; }
  .cp-feed-item:first-child { color: var(--cp-text); background: rgba(196,141,255,0.10); }
  .cp-result-me { font-size: 1.05rem; font-weight: 700; margin: 0 0 12px; }
  .cp-result-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }

  .cp-empty { text-align: center; color: var(--cp-muted); padding: 18px 10px; }

  .cp-result { text-align: center; padding: 16px 8px; }
  .cp-result h3 { font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-size: 1.35rem; color: var(--cp-gold); margin: 0 0 8px; }

  /* แชทกลาง แต่งสีให้เข้าธีมม่วง */
  .chat-box {
    --chat-accent: #a855f7; --chat-accent-dark: #6d28d9;
    --chat-surface: linear-gradient(135deg, #1b0f2b 0%, #12071a 100%);
    --chat-border: rgba(196,141,255,0.24); --chat-bubble: #2a1740;
    font-family: 'Bai Jamjuree', sans-serif;
  }
  .chat-toggle { --chat-toggle-bg: linear-gradient(135deg, #a855f7, #6d28d9); border-radius: 999px; padding: 12px 18px; }
  .btn-chat-send { --chat-send-bg: linear-gradient(135deg, #f5c86b, #d99a24); --chat-send-color: #2a1a05; }

  .cp-sidebar {
    position: fixed; top: 0; right: -320px; width: 300px; height: 100%;
    background: #1b0f2b; border-left: 1px solid var(--cp-line);
    padding: 18px; z-index: 9000; transition: right 0.25s ease; overflow-y: auto;
  }
  .cp-sidebar.open { right: 0; }
  .cp-sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 8999; }

  @media (max-width: 640px) {
    .cp-topbar, .cp-grid, .cp-now { padding-left: 14px; padding-right: 14px; }
    /* แถบติดขอบบนต้องเตี้ย — ตัดป้าย "ตอนนี้" ออก ให้ข้อความกับเวลาอยู่บรรทัดเดียวกัน */
    .cp-now { padding-top: 8px; padding-bottom: 8px; }
    .cp-now-label { display: none; }
    .cp-now-copy { font-size: 0.95rem; }
    .cp-timeout-hint { white-space: normal; max-width: 9.5em; text-align: right; }
    .cp-influence { width: calc(50% - 6px); }
    /* การ์ดเตี้ยลงบนมือถือ ให้ปุ่มตอบโต้ขึ้นมาอยู่ในจอแรกโดยไม่ต้องเลื่อน */
    .cp-influence img, .cp-influence .cp-emoji { height: 112px; }
    .cp-respond .cp-btn { flex: 1 1 auto; }
  }

  /* ==================== อนิเมชัน ====================
     ทั้งหมดสั่งจาก renderState โดยเทียบ state เก่ากับใหม่
     กฎ: อนิเมชันห้ามบังการกด — ตัวที่คลุมจอทั้งใบต้องมี pointer-events:none */

  /* ---- การ์ดเข้ามือ ---- */
  @keyframes cpDealIn {
    from { opacity: 0; transform: translateY(26px) rotate(-6deg) scale(0.9); }
    to   { opacity: 1; transform: none; }
  }
  .cp-influence.cp-anim-deal { animation: cpDealIn 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.3) backwards; }
  .cp-influence.cp-anim-deal:nth-child(2) { animation-delay: 0.1s; }
  .cp-influence.cp-anim-deal:nth-child(3) { animation-delay: 0.2s; }

  /* ---- การ์ดโดนหงาย: พลิกครึ่งใบแล้วแดงวาบ ---- */
  @keyframes cpFlipReveal {
    0%   { transform: rotateY(0deg) scale(1); }
    45%  { transform: rotateY(90deg) scale(1.06); }
    55%  { transform: rotateY(90deg) scale(1.06); }
    100% { transform: rotateY(0deg) scale(1); }
  }
  @keyframes cpRedFlash {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 71, 87, 0); }
    40%      { box-shadow: 0 0 26px 6px rgba(255, 71, 87, 0.85); }
  }
  .cp-influence.cp-anim-reveal {
    animation: cpFlipReveal 0.62s ease-in-out, cpRedFlash 0.62s ease-out;
  }

  /* ---- ตกรอบ ---- */
  @keyframes cpKnockOut {
    0%   { transform: none; filter: none; }
    25%  { transform: translateX(-6px) rotate(-2deg); }
    50%  { transform: translateX(6px) rotate(2deg); }
    100% { transform: none; filter: grayscale(1); }
  }
  .cp-player.cp-anim-out { animation: cpKnockOut 0.7s ease-out; }

  /* ---- ถึงตาใหม่ ---- */
  @keyframes cpTurnGlow {
    0%   { box-shadow: 0 0 0 0 rgba(245, 200, 107, 0.7); }
    70%  { box-shadow: 0 0 0 12px rgba(245, 200, 107, 0); }
    100% { box-shadow: 0 0 0 0 rgba(245, 200, 107, 0); }
  }
  .cp-player.cp-anim-turn { animation: cpTurnGlow 0.9s ease-out; }
  /* ไฟวิ่งรอบกล่องคนที่ถึงตา บอกจังหวะแบบไม่ต้องอ่าน */
  .cp-player.is-current { position: relative; overflow: hidden; }
  .cp-player.is-current::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgba(245,200,107,0.18) 50%, transparent 60%);
    background-size: 260% 100%;
    animation: cpSheen 2.6s linear infinite;
  }
  @keyframes cpSheen { from { background-position: 160% 0; } to { background-position: -60% 0; } }

  /* ---- เหรียญ ---- */
  @keyframes cpCoinPop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.32); text-shadow: 0 0 18px rgba(245,200,107,0.9); }
    100% { transform: scale(1); }
  }
  .cp-anim-coin { display: inline-block; animation: cpCoinPop 0.5s ease-out; }

  @keyframes cpFloatUp {
    0%   { opacity: 0; transform: translate(-50%, 4px); }
    18%  { opacity: 1; }
    100% { opacity: 0; transform: translate(-50%, -30px); }
  }
  .cp-coin-delta {
    position: absolute; left: 50%; bottom: 100%;
    font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-weight: 700; font-size: 0.95rem;
    pointer-events: none; white-space: nowrap; z-index: 5;
    animation: cpFloatUp 1s ease-out forwards;
  }
  .cp-coin-delta.is-up { color: #6ee7b7; }
  .cp-coin-delta.is-down { color: #ff6b81; }
  .cp-coins, .cp-player-coins { position: relative; }

  /* ---- ป้ายประกาศจังหวะสำคัญ ---- */
  @keyframes cpSlam {
    0%   { opacity: 0; transform: translate(-50%, -50%) scale(2.4) rotate(-8deg); }
    22%  { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(-3deg); }
    75%  { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(-3deg); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.15) rotate(-3deg); }
  }
  #cpFlash {
    position: fixed; top: 42%; left: 50%; z-index: 9500;
    pointer-events: none;  /* ห้ามบังปุ่มเด็ดขาด */
    font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-weight: 900;
    font-size: clamp(1.8rem, 7vw, 3.4rem); text-align: center;
    padding: 16px 30px; border-radius: 18px;
    background: rgba(10, 4, 18, 0.82); border: 2px solid currentColor;
    text-shadow: 0 4px 24px rgba(0,0,0,0.8);
    display: none;
  }
  #cpFlash.is-on { display: block; animation: cpSlam 1.25s cubic-bezier(0.2, 0.8, 0.3, 1) forwards; }
  #cpFlash .cp-flash-sub {
    display: block; margin-top: 6px;
    font-family: 'Bai Jamjuree', sans-serif; font-weight: 700;
    font-size: 0.95rem; color: var(--cp-text); opacity: 0.85;
  }

  /* ---- บันทึกเกม: เฉพาะบรรทัดใหม่ ---- */
  @keyframes cpFeedIn {
    from { opacity: 0; transform: translateX(-14px); background: rgba(196,141,255,0.22); }
    to   { opacity: 1; transform: none; }
  }
  .cp-feed-item.cp-anim-new { animation: cpFeedIn 0.45s ease-out; }

  /* ---- นาฬิกาใกล้หมดเวลา ---- */
  @keyframes cpTick {
    0%, 100% { transform: scale(1); color: var(--cp-gold); }
    50%      { transform: scale(1.16); color: #ff6b81; }
  }
  .cp-timer.is-urgent { display: inline-block; animation: cpTick 1s ease-in-out infinite; }

  /* ---- ปุ่มกดแล้วรู้สึกว่ากดติด ---- */
  .cp-action, .cp-btn { transition: transform 0.12s ease, box-shadow 0.16s ease, background 0.16s ease; }
  .cp-action:hover:not(:disabled) { transform: translateY(-2px); }
  .cp-action:active:not(:disabled), .cp-btn:active:not(:disabled) { transform: scale(0.96); }
  .cp-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0,0,0,0.35); }
  .cp-influence.is-pick { transition: transform 0.14s ease, box-shadow 0.16s ease, border-color 0.16s ease; }
  .cp-influence.is-pick:hover { transform: translateY(-5px); }

  /* ---- แถบ "ตอนนี้" เปลี่ยนข้อความ ---- */
  @keyframes cpNowSwap {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }
  .cp-now-copy.cp-anim-swap { display: inline-block; animation: cpNowSwap 0.32s ease-out; }

  /* เคารพการตั้งค่าระบบของผู้ใช้ที่ขอให้ลดการเคลื่อนไหว */
  @media (prefers-reduced-motion: reduce) {
    .cp-influence.cp-anim-deal, .cp-influence.cp-anim-reveal, .cp-player.cp-anim-out,
    .cp-player.cp-anim-turn, .cp-anim-coin, .cp-coin-delta, #cpFlash.is-on,
    .cp-feed-item.cp-anim-new, .cp-timer.is-urgent, .cp-now-copy.cp-anim-swap,
    .cp-player.is-current::after {
      animation: none !important;
    }
    .cp-action, .cp-btn, .cp-influence.is-pick { transition: none !important; }
    #cpFlash.is-on { display: none; }
  }
</style>

<div id="connectionStatus" class="cp-chip cp-chip-danger" style="display:none; position:fixed; top:10px; left:50%; transform:translateX(-50%); z-index:10001;">กำลังเชื่อมต่อใหม่...</div>
<div id="cpFlash" aria-hidden="true"></div>

<div class="cp-page">
  <div class="cp-shell">
    <div class="cp-topbar">
      <div>
        <div class="cp-kicker">👑 เกมโค่นอำนาจ</div>
        <h1 class="cp-title"><%= room.name %></h1>
      </div>
      <div class="cp-meta">
        <span class="cp-chip">🆔 <%= room.roomId %></span>
        <span class="cp-chip">🃏 กองกลาง <span id="deckCount">-</span></span>
        <button type="button" id="cpHowToOpen" class="cp-chip cp-chip-btn">📖 วิธีเล่น</button>
        <button type="button" id="cpSidebarBtn" class="cp-chip cp-chip-btn">👥 ผู้เล่น</button>
        <% if (room.admin) { %>
        <button type="button" id="cpEndGameBtn" class="cp-chip cp-chip-btn cp-chip-danger">⏹ จบเกม</button>
        <% } %>
      </div>
    </div>

    <div id="cpNowBar" class="cp-now">
      <span class="cp-now-label">ตอนนี้</span>
      <span id="cpNowCopy" class="cp-now-copy">กำลังโหลด...</span>
      <span class="cp-timer-wrap">
        <span id="cpTimer" class="cp-timer">--</span>
        <span id="cpTimeoutHint" class="cp-timeout-hint" style="display:none;"></span>
      </span>
      <div id="cpNowLast" class="cp-now-last" aria-live="polite" style="display:none;"></div>
    </div>

    <div class="cp-grid">
      <section class="cp-card">
        <div class="cp-card-title">🎴 การ์ดของคุณ · <span class="cp-coins">💰 <span id="myCoins">0</span></span></div>
        <div id="myHand" class="cp-hand"></div>
      </section>

      <section class="cp-card">
        <div class="cp-card-title" id="actionAreaTitle">🎯 ตาของคุณ</div>
        <div id="actionArea"><div class="cp-empty">รอเกมเริ่ม...</div></div>
      </section>

      <section class="cp-card">
        <div class="cp-card-title">👥 ผู้เล่น</div>
        <div id="playerGrid" class="cp-players"></div>

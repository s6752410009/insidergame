<%- contentFor('content') %>
<link rel="stylesheet" href="/static/css/chatPanel.css">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }

  /* Full-bleed game shell — hide site chrome like Spyfall/Werewolf */
  html.bm-active,
  html.bm-active body.content {
    overflow-x: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #09090b !important;
  }

  html.bm-active header,
  html.bm-active .footer,
  html.bm-active #support-fab,
  html.bm-active #music-controls {
    display: none !important;
  }

  html.bm-active .container-fluid {
    padding: 0 !important;
    margin: 0 !important;
    max-width: none !important;
    width: 100% !important;
  }

  html.bm-active .container-fluid > .row {
    margin: 0 !important;
  }

  html.bm-active .col-lg-12 {
    padding: 0 !important;
    width: 100% !important;
    max-width: none !important;
  }

  :root {
    --bm-bg: #09090b;
    --bm-panel: rgba(18, 18, 20, 0.86);
    --bm-panel-soft: rgba(255, 255, 255, 0.05);
    --bm-line: rgba(255, 255, 255, 0.09);
    --bm-line-strong: rgba(245, 200, 107, 0.18);
    --bm-gold: #f5c86b;
    --bm-gold-deep: #b7791f;
    --bm-red: #d94b42;
    --bm-red-deep: #7f1d1d;
    --bm-blue: #74b9ff;
    --bm-violet: #d6bcfa;
    --bm-text: #f5efe3;
    --bm-muted: #b8ada0;
    --bm-green: #6ee7b7;
    --bm-shadow: 0 32px 100px rgba(0, 0, 0, 0.52);
  }

  body.content {
    background:
      radial-gradient(circle at 10% 5%, rgba(127, 29, 29, 0.45), transparent 22%),
      radial-gradient(circle at 92% 0%, rgba(180, 83, 9, 0.22), transparent 18%),
      radial-gradient(circle at 50% 100%, rgba(91, 33, 182, 0.08), transparent 24%),
      linear-gradient(180deg, #09090b 0%, #110d0c 45%, #17110f 100%);
  }

  .bm-page {
    position: relative;
    max-width: 1440px;
    width: 100%;
    margin: 12px auto 36px;
    padding: 12px;
    color: var(--bm-text);
    font-family: 'Rajdhani', sans-serif;
    overflow-x: clip;
  }

  .bm-page::before,
  .bm-page::after {
    content: '';
    position: absolute;
    width: min(40vw, 280px);
    height: min(40vw, 280px);
    border-radius: 999px;
    pointer-events: none;
    filter: blur(90px);
    opacity: 0.16;
    z-index: 0;
  }

  .bm-page::before {
    top: -14vw;
    left: -10vw;
    background: radial-gradient(circle, rgba(127, 29, 29, 0.9), transparent 68%);
  }

  .bm-page::after {
    right: -12vw;
    bottom: -18vw;
    background: radial-gradient(circle, rgba(180, 83, 9, 0.85), transparent 72%);
  }

  .bm-shell {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(245, 200, 107, 0.16);
    border-radius: 34px;
    background:
      linear-gradient(145deg, rgba(12, 12, 14, 0.98), rgba(26, 17, 15, 0.94)),
      var(--bm-bg);
    box-shadow: var(--bm-shadow);
  }

  .bm-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.05) 0.7px, transparent 0.7px);
    background-size: 16px 16px;
    opacity: 0.2;
    pointer-events: none;
  }

  .bm-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, rgba(245, 200, 107, 0.06), transparent 18%, transparent 70%, rgba(116, 185, 255, 0.04)),
      radial-gradient(circle at top center, rgba(245, 200, 107, 0.08), transparent 32%);
    pointer-events: none;
    z-index: 0;
  }

  .bm-topbar {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    padding: 24px 26px 22px;
    border-bottom: 1px solid var(--bm-line);
    background:
      radial-gradient(circle at top left, rgba(127, 29, 29, 0.32), transparent 34%),
      linear-gradient(135deg, rgba(127, 29, 29, 0.22), rgba(17, 17, 17, 0.72));
  }

  .bm-topbar::after {
    content: '';
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(245, 200, 107, 0.24), transparent 32%, transparent 68%, rgba(245, 200, 107, 0.2));
  }

  .bm-brand {
    display: grid;
    gap: 6px;
    max-width: 720px;
  }

  .bm-kicker {
    color: var(--bm-gold);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .bm-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1;
    text-shadow: 0 0 20px rgba(245, 200, 107, 0.12);
  }

  .bm-subtitle {
    color: var(--bm-muted);
    font-size: 1rem;
    max-width: 62ch;
  }

  .bm-top-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    max-width: 420px;
  }

  .bm-announcer {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 14px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--bm-line);
    background:
      linear-gradient(135deg, rgba(180, 83, 9, 0.08), rgba(17, 17, 17, 0.68)),
      radial-gradient(circle at top left, rgba(245, 200, 107, 0.12), transparent 38%);
  }

  .bm-announcer-copy {
    min-width: 0;
    display: grid;
    gap: 6px;
  }

  .bm-announcer-kicker {
    color: var(--bm-gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bm-announcer-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1rem, 2vw, 1.22rem);
    line-height: 1.3;
  }

  .bm-announcer-text {
    color: var(--bm-muted);
    line-height: 1.45;
  }

  .bm-announcer-rails {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    min-width: 0;
  }

  .bm-announcer-note {
    min-width: 0;
    padding: 12px 14px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.08);
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.025));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }

  .bm-announcer-note strong {
    display: block;
    margin-bottom: 4px;
  }

  .bm-announcer-note span {
    color: var(--bm-muted);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .bm-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    font-weight: 700;
    color: var(--bm-text);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .bm-chip.phase-market { border-color: rgba(245, 200, 107, 0.26); color: #fde68a; }
  .bm-chip.phase-action { border-color: rgba(248, 113, 113, 0.26); color: #fecaca; }
  .bm-chip.phase-finished { border-color: rgba(110, 231, 183, 0.24); color: #d1fae5; }

  .bm-timer-chip {
    font-variant-numeric: tabular-nums;
    min-width: 92px;
    text-align: center;
  }

  .bm-round-summary {
    margin: 0;
    padding: 14px 22px;
    border-bottom: 1px solid var(--bm-line-strong);
    background: rgba(17, 17, 17, 0.45);
  }

  .bm-round-summary-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bm-muted);
    margin-bottom: 8px;
  }

  .bm-round-summary-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bm-round-summary-item {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .bm-round-summary-item .bm-rs-icon {
    flex: 0 0 auto;
    width: 1.35rem;
    height: 1.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    line-height: 1;
  }
  .bm-round-summary-item.tone-gold .bm-rs-copy { color: #ffce6b; }
  .bm-round-summary-item.tone-red .bm-rs-copy { color: #ff8a7a; }
  .bm-round-summary-item.tone-amber .bm-rs-copy { color: #f5c86b; }

  .bm-timer-chip.bm-timer-warn {
    color: #ffce6b;
    border-color: rgba(245, 200, 107, 0.7);
    background: rgba(245, 200, 107, 0.12);
  }

  .bm-timer-chip.bm-timer-danger {
    color: #ff8a7a;
    border-color: rgba(231, 76, 60, 0.8);
    background: rgba(231, 76, 60, 0.16);
    animation: bmTimerPulse 1s ease-in-out infinite;
  }

  @keyframes bmTimerPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }

  .bm-now-bar {
    position: relative;
    z-index: 2;
    margin: 0;
    padding: 16px 22px;
    border-bottom: 1px solid var(--bm-line-strong);
    background: linear-gradient(90deg, rgba(245, 200, 107, 0.14), rgba(17, 17, 17, 0.5));
  }

  .bm-now-bar-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bm-gold);
    margin-bottom: 6px;
  }

  .bm-now-bar-text {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    line-height: 1.35;
    color: #fff;
  }

  .bm-now-bar-sub {
    margin-top: 6px;
    color: var(--bm-muted);
    font-size: 0.95rem;
  }

  .bm-now-bar.locked .bm-now-bar-text {
    color: #d1fae5;
  }

  .bm-now-bar-go {
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 20px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, #f5c86b, #e0a52e);
    color: #1a1205;
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.02rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(245, 200, 107, 0.32);
    animation: bmNowPulse 1.8s ease-in-out infinite;
  }

  .bm-now-bar-go:hover { filter: brightness(1.06); }

  @keyframes bmNowPulse {
    0%, 100% { transform: translateY(0); box-shadow: 0 6px 18px rgba(245, 200, 107, 0.32); }
    50% { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(245, 200, 107, 0.5); }
  }

  .bm-stage-flash {
    animation: bmStageFlash 1.2s ease-out;
  }

  @keyframes bmStageFlash {
    0% { box-shadow: 0 0 0 3px rgba(245, 200, 107, 0.9); }
    100% { box-shadow: 0 0 0 0 rgba(245, 200, 107, 0); }
  }

  .bm-announcer.bm-announcer-collapsed {
    grid-template-columns: 1fr;
    padding: 10px 22px;
    gap: 0;
  }

  .bm-announcer-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    color: var(--bm-muted);
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .bm-announcer-toggle:hover {
    border-color: rgba(245, 200, 107, 0.2);
    color: var(--bm-text);
  }

  .bm-announcer-body {
    margin-top: 12px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 14px;
  }

  .bm-hide { display: none !important; }

  /* Mobile Tabs Switcher for Black Market */
  .bm-mobile-tabs {
    display: none;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(13, 17, 28, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--bm-line);
    padding: 10px 14px;
    gap: 8px;
    margin-bottom: 15px;
  }

  .bm-mobile-tab-btn {
    flex: 1;
    padding: 10px 6px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: var(--bm-muted);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }

  .bm-mobile-tab-btn.active {
    background: linear-gradient(135deg, rgba(245, 200, 107, 0.25), rgba(245, 200, 107, 0.1));
    border-color: rgba(245, 200, 107, 0.4);
    color: #fff;
    box-shadow: 0 0 12px rgba(245, 200, 107, 0.15);
  }

  @media (max-width: 980px) {
    .bm-mobile-tabs {
      display: flex;
    }
  }

  .bm-simple-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 12px;
  }

  .bm-simple-btn-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(245, 200, 107, 0.28);
    background: #0f1419;
  }

  .bm-simple-btn-icon .game-icon,
  .bm-simple-btn-icon img.game-icon,
  .bm-simple-btn-icon .game-icon-fallback {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
    font-size: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .bm-action-hint {
    margin: 0 0 12px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid rgba(245, 200, 107, 0.28);
    background: rgba(245, 200, 107, 0.08);
    color: var(--bm-text);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .bm-action-hint b { color: #ffce6b; }

  .bm-simple-btn {
    min-height: 120px;
    padding: 12px 8px;
    border-radius: 18px;
    border: 2px solid rgba(255,255,255,0.12);
    background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
    color: var(--bm-text);
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 6px;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .bm-simple-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: rgba(245, 200, 107, 0.35);
  }

  .bm-simple-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .bm-simple-btn .bm-outcome {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--bm-gold);
  }

  .bm-simple-pick {
    margin-bottom: 12px;
    padding: 12px;
    border-radius: 16px;
    border: 1px dashed rgba(245, 200, 107, 0.28);
    background: rgba(0,0,0,0.2);
  }

  .bm-simple-pick-title {
    margin-bottom: 10px;
    font-weight: 700;
    color: var(--bm-gold);
  }

  .bm-simple-pick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 8px;
  }

  .bm-toggle-advanced {
    width: 100%;
    margin: 4px 0 12px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
    background: transparent;
    color: var(--bm-muted);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    cursor: pointer;
  }

  .bm-toggle-advanced:hover {
    color: var(--bm-text);
    border-color: rgba(255,255,255,0.18);
  }

  .bm-advanced-stage {
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--bm-line);
  }

  .bm-offer-outcome {
    font-size: 0.92rem;
    color: var(--bm-gold);
    text-align: center;
    line-height: 1.35;
    margin: 0;
  }

  .bm-offer-visual {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(245, 200, 107, 0.28);
    background: #0f1419;
    margin-bottom: 10px;
  }

  .bm-offer-visual .game-icon,
  .bm-offer-visual img.game-icon,
  .bm-offer-visual .game-icon-fallback {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
    font-size: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bm-offer-name {
    font-weight: 800;
    font-size: 1.15rem;
    text-align: center;
    letter-spacing: 0.02em;
    margin-bottom: 4px;
  }

  .bm-offer-meta {
    display: flex;
    justify-content: center;
    margin-bottom: 10px;
  }

  .bm-inventory-compact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bm-inventory-compact .bm-item-compact {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 8px;
    width: 76px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    font-weight: 700;
    font-size: 0.78rem;
    text-align: center;
    line-height: 1.2;
  }

  .bm-item-compact-thumb {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(245, 200, 107, 0.28);
    background: #0f1419;
  }

  .bm-item-compact-thumb .game-icon,
  .bm-item-compact-thumb img.game-icon,
  .bm-item-compact-thumb .game-icon-fallback {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .bm-audio-chip {
    border: 1px solid rgba(245, 200, 107, 0.18);
    font-family: 'Rajdhani', sans-serif;
    cursor: pointer;
  }

  .bm-audio-chip.live {
    color: #d1fae5;
    border-color: rgba(110, 231, 183, 0.26);
    background: rgba(4, 120, 87, 0.18);
  }

  .bm-ceremony {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0.72));
    transition: opacity 0.3s ease;
  }

  .bm-ceremony.active {
    opacity: 1;
  }

  .bm-tour-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: none;
    background: rgba(5, 5, 6, 0.72);
  }

  .bm-tour-overlay.active {
    display: block;
  }

  .bm-tour-focus {
    position: relative;
    z-index: 33;
    border-color: rgba(245, 200, 107, 0.58);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 0 0 2px rgba(245, 200, 107, 0.72),
      0 0 0 8px rgba(245, 200, 107, 0.12),
      0 24px 54px rgba(0, 0, 0, 0.34);
    transform: translateY(-2px);
  }

  .bm-tour-card {
    position: fixed;
    z-index: 32;
    width: min(360px, calc(100vw - 24px));
    padding: 18px 18px 16px;
    border-radius: 24px;
    border: 1px solid rgba(245, 200, 107, 0.28);
    background:
      radial-gradient(circle at top left, rgba(127, 29, 29, 0.28), transparent 36%),
      linear-gradient(145deg, rgba(12, 12, 14, 0.96), rgba(26, 17, 15, 0.94));
    box-shadow: 0 22px 64px rgba(0, 0, 0, 0.44);
    outline: none;
  }

  .bm-tour-kicker {
    color: var(--bm-gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bm-tour-title {
    margin-top: 8px;
    font-family: 'Orbitron', sans-serif;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .bm-tour-copy {
    margin-top: 8px;
    color: var(--bm-muted);
    line-height: 1.5;
  }

  .bm-tour-progress {
    margin-top: 12px;
    display: flex;
    gap: 6px;
  }

  .bm-tour-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
  }

  .bm-tour-dot.active {

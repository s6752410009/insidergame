    let phaseTimerInterval = null;
    function updatePhaseTimer() {
      const chip = document.getElementById('bmTimerChip');
      if (!chip) return;
      const phase = currentState && currentState.phase;
      const endsAt = currentState && Number(currentState.phaseEndsAt);
      const active = (phase === 'market' || phase === 'action') && Number.isFinite(endsAt) && endsAt > 0;
      if (!active) {
        chip.style.display = 'none';
        if (phaseTimerInterval) { clearInterval(phaseTimerInterval); phaseTimerInterval = null; }
        return;
      }
      chip.style.display = '';
      const tick = function() {
        const remainingMs = Math.max(0, endsAt - Date.now());
        const totalSeconds = Math.ceil(remainingMs / 1000);
        const mm = Math.floor(totalSeconds / 60);
        const ss = totalSeconds % 60;
        chip.textContent = '⏳ ' + mm + ':' + (ss < 10 ? '0' : '') + ss;
        chip.classList.toggle('bm-timer-warn', totalSeconds <= 30 && totalSeconds > 10);
        chip.classList.toggle('bm-timer-danger', totalSeconds <= 10);
        if (remainingMs <= 0 && phaseTimerInterval) {
          clearInterval(phaseTimerInterval);
          phaseTimerInterval = null;
        }
      };
      if (phaseTimerInterval) { clearInterval(phaseTimerInterval); }
      tick();
      phaseTimerInterval = setInterval(tick, 1000);
    }

    function requestState() {
      socket.emit('blackmarket_requestState', { roomId, playerId });
    }

    // กันกดรัวก่อน state ใหม่จะกลับมา — คลิกที่สองเคยเด้ง error ทั้งที่คลิกแรกล็อกสำเร็จไปแล้ว
    let submitInFlight = false;

    function submitMarketChoice(itemId) {
      if (submitInFlight) return;
      submitInFlight = true;
      socket.emit('blackmarket_buyOffer', { roomId, playerId, itemId }, function(response) {
        submitInFlight = false;
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'โต๊ะไม่ยอม', text: response?.error || 'ของชิ้นนี้ยังไม่ผ่าน', background: '#111', color: '#fff' });
        }
      });
    }

    function submitAction(actionType, targetPlayerId, itemId) {
      if (submitInFlight) return;
      submitInFlight = true;
      socket.emit('blackmarket_submitAction', { roomId, playerId, actionType, targetPlayerId, itemId }, function(response) {
        submitInFlight = false;
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'งานยังไม่ผ่าน', text: response?.error || 'แผนนี้ยังล็อกไม่ได้', background: '#111', color: '#fff' });
        }
      });
    }


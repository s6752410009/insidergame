  .bm-offer-title,
  .bm-player-name {
    font-size: 1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bm-price,
  .bm-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(0,0,0,0.26);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bm-gold);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .bm-offer-copy,
  .bm-player-copy,
  .bm-feed-copy,
  .bm-empty {
    color: var(--bm-muted);
    line-height: 1.45;
  }

  .bm-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .bm-btn {
    border: 0;
    border-radius: 16px;
    padding: 11px 15px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--bm-text);
    background: linear-gradient(135deg, #9a3412, #7f1d1d);
    transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
  }

  .bm-btn.alt { background: rgba(255,255,255,0.1); }
  .bm-btn.gold { background: linear-gradient(135deg, #d97706, #92400e); }
  .bm-btn.green { background: linear-gradient(135deg, #047857, #065f46); }
  .bm-btn:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; }
  .bm-btn:not(:disabled):hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(0,0,0,0.24); }

  .bm-action-block {
    position: relative;
    padding: 15px;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.1);
    background:
      radial-gradient(circle at top left, rgba(245, 200, 107, 0.06), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.028));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .bm-action-block:hover {
    transform: translateY(-2px);
    border-color: rgba(245, 200, 107, 0.18);
  }

  .bm-action-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .bm-action-title-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(245, 200, 107, 0.28);
    background: #0f1419;
    flex-shrink: 0;
  }

  .bm-action-title-icon .game-icon,
  .bm-action-title-icon img.game-icon,
  .bm-action-title-icon .game-icon-fallback {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bm-action-copy {
    color: var(--bm-muted);
    margin-bottom: 12px;
  }

  .bm-target-list,
  .bm-mini-grid,
  .bm-intel-grid,
  .bm-finished-actions {
    display: grid;
    gap: 8px;
  }

  .bm-target-list {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .bm-target-btn {
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    padding: 11px 13px;
    background: linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.03));
    color: var(--bm-text);
    text-align: left;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .bm-target-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(245, 200, 107, 0.18);
    background: linear-gradient(180deg, rgba(245, 200, 107, 0.08), rgba(255,255,255,0.03));
  }

  .bm-target-btn small {
    display: block;
    color: var(--bm-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .bm-player {
    display: grid;
    gap: 10px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .bm-player:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.14);
  }

  .bm-deal-item.win {
    border-color: rgba(245, 200, 107, 0.22);
    background: linear-gradient(145deg, rgba(217, 119, 6, 0.12), rgba(255, 255, 255, 0.04));
  }

  .bm-deal-item.betray {
    border-color: rgba(248, 113, 113, 0.22);
    background: linear-gradient(145deg, rgba(127, 29, 29, 0.2), rgba(255, 255, 255, 0.03));
  }

  .bm-player-self {
    border-color: rgba(245, 200, 107, 0.28);
    box-shadow: 0 0 0 1px rgba(245, 200, 107, 0.08);
  }

  .bm-player-dead {
    opacity: 0.55;
    filter: grayscale(0.18);
  }

  .bm-player-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .bm-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .bm-pill.dead { color: #fecaca; border-color: rgba(248,113,113,0.2); }
  .bm-pill.good { color: #d1fae5; border-color: rgba(110,231,183,0.2); }
  .bm-pill.warn { color: #fde68a; border-color: rgba(245,200,107,0.2); }

  .bm-feed-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }

  .bm-feed-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: rgba(255,255,255,0.08);
    font-size: 1.1rem;
  }

  .bm-feed-tone-red .bm-feed-icon { background: rgba(127,29,29,0.45); }
  .bm-feed-tone-gold .bm-feed-icon { background: rgba(180,83,9,0.34); }
  .bm-feed-tone-blue .bm-feed-icon { background: rgba(30,64,175,0.34); }

  .bm-winner-card {
    background: linear-gradient(145deg, rgba(16, 185, 129, 0.16), rgba(180, 83, 9, 0.14));
    border-color: rgba(110, 231, 183, 0.25);
    box-shadow: 0 26px 44px rgba(0,0,0,0.22);
  }

  .bm-winner-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.18rem;
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }

  .bm-footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }

  @media (max-width: 980px) {
    .bm-grid {
      grid-template-columns: 1fr;
      width: 100%;
      min-width: 0;
    }

    .bm-market-grid {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }

    .bm-simple-actions {
      grid-template-columns: 1fr;
    }

    .bm-topbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .bm-top-meta {
      width: 100%;
      justify-content: flex-start;
    }

    .bm-top-meta .bm-chip {
      flex: 1 1 180px;
      justify-content: center;
    }

    .bm-manual-header {
      flex-direction: column;
    }

    .bm-manual-grid {
      grid-template-columns: 1fr;
    }

    .bm-announcer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .bm-page { padding: 8px; margin-top: 0; margin-bottom: 72px; }
    .bm-shell { border-radius: 18px; }
    .bm-page::before,
    .bm-page::after { display: none; }
    .bm-topbar,
    .bm-grid,
    .bm-card { padding: 14px; }
    .bm-announcer { padding: 14px; }
    .bm-role-wrap { grid-template-columns: 1fr; }
    .bm-role-icon { width: 88px; height: 88px; border-radius: 16px; }
    .bm-topbar::after { left: 14px; right: 14px; }
    .bm-top-meta { gap: 6px; }
    .bm-top-meta .bm-chip { flex: 1 1 calc(50% - 6px); min-width: 0; padding-inline: 10px; }
    .bm-announcer-rails { grid-template-columns: 1fr; }
    .bm-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bm-action-grid { grid-template-columns: 1fr; }
    .bm-simple-actions { grid-template-columns: 1fr; }
    .bm-simple-btn { min-height: 96px; }
    .bm-simple-btn-icon { width: 48px; height: 48px; }
    .bm-market-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .bm-offer-visual {
      max-width: 180px;
      margin-left: auto;
      margin-right: auto;
    }
    .bm-players-grid,
    .bm-inventory,
    .bm-manual-actions-grid,
    .bm-manual-state-grid { grid-template-columns: 1fr; }
    .bm-offer,
    .bm-player,
    .bm-feed-item,
    .bm-intel-item,
    .bm-winner-card,
    .bm-manual-section,
    .bm-manual-action,
    .bm-manual-state-card { border-radius: 18px; }
    .bm-player-head,
    .bm-manual-role-head,
    .bm-manual-state-head { align-items: flex-start; }
    .bm-manual-header { margin-bottom: 14px; }
    .bm-guide-step { padding-left: 14px; }
    .bm-guide-step { padding-left: 14px; }
    .bm-guide-step::before { display: none; }
    .bm-tour-card {
      left: 12px !important;
      right: 12px !important;
      width: auto;
    }
    .bm-manual-overlay { padding: 10px; }
    .bm-manual-card { padding: 16px; border-radius: 24px; }
    .bm-manual-role-icon { width: 56px; height: 56px; font-size: 1.55rem; border-radius: 18px; }
    .bm-manual-role-name { font-size: 1.02rem; }
    .bm-manual-section { padding: 14px; }
    .bm-manual-section h3 {
      font-size: 0.92rem;
      cursor: pointer;
      user-select: none;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .bm-manual-section h3::after {
      content: '▼';
      font-size: 0.72em;
      margin-left: auto;
      opacity: 0.6;
      transition: transform 0.2s ease;
    }
    .bm-manual-section.is-open h3::after { transform: rotate(180deg); }
    .bm-manual-section-body { display: none; overflow: hidden; }
    .bm-manual-section.is-open .bm-manual-section-body { display: block; }
    .bm-manual-copy { max-width: none; }

    /* action accordion on mobile */
    .bm-action-title { display: flex !important; align-items: center; }
    .bm-action-body { display: none; }
    .bm-action-block.is-open .bm-action-body { display: block; }
  }

  @media (max-width: 420px) {
    .bm-page { padding: 6px; }
    .bm-topbar,
    .bm-grid,
    .bm-card,
    .bm-manual-card { padding: 12px; }
    .bm-announcer { padding: 12px; }
    .bm-top-meta .bm-chip,
    .bm-tour-actions .bm-btn,
    .bm-btn-row .bm-btn { flex: 1 1 100%; width: 100%; }
    .bm-stats { grid-template-columns: 1fr; }
    .bm-pill { max-width: 100%; }
  }
</style>

<div class="bm-page">
  <div class="bm-shell">
    <div id="bmCeremonyOverlay" class="bm-ceremony" aria-live="polite">
      <div id="bmCeremonyCard" class="bm-ceremony-card bm-ceremony-gold">
        <div id="bmCeremonyKicker" class="bm-ceremony-kicker">🎩 เปิดโต๊ะ</div>
        <div id="bmCeremonyTitle" class="bm-ceremony-title">ยกใหม่กำลังเริ่ม</div>
        <div id="bmCeremonyCopy" class="bm-ceremony-copy">ล็อตใหม่กำลังขึ้นโต๊ะ</div>
      </div>
    </div>

    <div class="bm-topbar">
      <div class="bm-brand">
        <div class="bm-kicker">🎩 โต๊ะตลาดมืด</div>
        <div class="bm-title"><%= room.name %></div>
        <div class="bm-subtitle">สะสม 👑 ให้มากสุดใน 5 ยก</div>
      </div>
      <div class="bm-top-meta">
        <div class="bm-chip">🆔 <span><%= room.roomId %></span></div>
        <div class="bm-chip">👥 <span><%= room.playerCount %>/<%= room.maxPlayers %></span></div>
        <div id="phaseChip" class="bm-chip phase-market">🛒 เปิดตลาด</div>
        <div id="roundChip" class="bm-chip">🌒 ยก 1 / 5</div>
        <div id="bmTimerChip" class="bm-chip bm-timer-chip" style="display:none;" title="เวลาที่เหลือในเฟสนี้ หมดเวลาแล้วระบบจะปิดยกให้อัตโนมัติ">⏳ --:--</div>
        <button id="bmHowToOpen" type="button" class="bm-chip">📖 วิธีเล่น</button>
        <button id="bmTourReplay" type="button" class="bm-chip">✨ พาทัวร์โต๊ะ</button>
        <% if (room.admin === true) { %>
        <button id="bmEndGameBtn" type="button" class="bm-chip" title="รีเซ็ตเกมและลบผู้เล่นที่หลุด">⏹ จบเกม</button>
        <% } %>
        <button id="bmAudioToggle" type="button" class="bm-chip bm-audio-chip">🔇 เปิดเสียงพิธี</button>
      </div>
    </div>

    <div id="bmNowBar" class="bm-now-bar" aria-live="polite"></div>

    <div id="bmFlowGuide" class="bm-flow-guide" aria-label="ลำดับการเล่นในหนึ่งยก"></div>

    <div id="bmAnnouncerBar" class="bm-announcer bm-announcer-collapsed" aria-live="polite"></div>

    <div id="bmRoundSummary" class="bm-round-summary" style="display:none;" aria-live="polite"></div>

    <div class="bm-mobile-tabs">
      <button class="bm-mobile-tab-btn active" type="button" data-tab="game">🎮 เล่นยกนี้</button>
      <button class="bm-mobile-tab-btn" type="button" data-tab="players">👥 คนบนโต๊ะ</button>
      <button class="bm-mobile-tab-btn" type="button" data-tab="history">📢 ข่าวใต้ดิน</button>
    </div>

    <div class="bm-grid">
      <div class="bm-col">
        <div class="bm-card bm-card-role" data-tour-id="role">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">🎭 บทของคุณ</div>
            </div>
            <div id="selfStateChip" class="bm-tag">🫀 ยังอยู่</div>
          </div>
          <div id="rolePanel"></div>
        </div>

        <div class="bm-card bm-card-stage" data-tour-id="stage">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title" id="stageCardTitle">🎯 ตลาดกับแผนลงมือ</div>
            </div>
          </div>
          <div id="mainStage"></div>
        </div>

        <div class="bm-card bm-card-guide" data-tour-id="guide">
          <div id="guidePanel"></div>
        </div>

        <div class="bm-card bm-card-history">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">📢 ข่าวใต้ดิน</div>
                          </div>
          </div>
          <div id="historyFeed" class="bm-feed"></div>
        </div>
      </div>

      <div class="bm-col">
        <div class="bm-card bm-card-roster" data-tour-id="players">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">👥 คนบนโต๊ะ</div>
                          </div>
          </div>
          <div id="playersPanel" class="bm-players-grid"></div>
        </div>

        <div class="bm-card bm-card-deals" data-tour-id="deals">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">🤝 ดีลบนโต๊ะ</div>
                          </div>
          </div>
          <div id="dealPanel" class="bm-intel-grid"></div>
        </div>

        <div class="bm-card bm-card-intel">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">🕶️ ข่าวที่คีบมาได้</div>
                          </div>
          </div>
          <div id="intelPanel" class="bm-intel-grid"></div>
        </div>

        <div id="winnerPanel" class="bm-card" style="display:none;"></div>
      </div>
    </div>
  </div>

  <div id="chatBox" class="chat-box" aria-hidden="true" style="display:none;">
    <div class="chat-header">
      <div class="chat-title">💬 แชทโต๊ะ</div>
      <button type="button" id="closeChat" class="chat-close" aria-label="ปิดแชท">✕</button>
    </div>
    <div id="replyPreview" class="chat-reply-preview-bar" style="display:none;">
      <div class="reply-content"><span class="reply-indicator">ตอบกลับ</span> <span class="reply-player-name"></span>: <span class="reply-message-content"></span></div>
      <button type="button" class="reply-cancel-btn" aria-label="ยกเลิกการตอบกลับ">✕</button>
    </div>
    <div id="chatMessages" class="chat-messages" role="log" aria-live="polite"></div>
    <div class="chat-input-wrap">
      <textarea id="chatInput" rows="1" placeholder="พิมพ์ข้อความ..." aria-label="พิมพ์ข้อความ"></textarea>
      <button type="button" id="sendChat" class="btn-chat-send" aria-label="ส่งข้อความ">ส่ง</button>
    </div>
  </div>
  <button type="button" id="toggleChat" class="chat-toggle" aria-expanded="false" aria-controls="chatBox">💬 แชท <span id="chatUnreadDot" class="unread-dot" style="display:none;"></span></button>

  <div id="bmTourOverlay" class="bm-tour-overlay" aria-hidden="true">
    <div id="bmTourCard" class="bm-tour-card" role="dialog" aria-modal="true" aria-live="polite" aria-label="Black Market onboarding" tabindex="-1">
      <div id="bmTourKicker" class="bm-tour-kicker">Spotlight</div>
      <div id="bmTourTitle" class="bm-tour-title"></div>
      <div id="bmTourCopy" class="bm-tour-copy"></div>
      <div id="bmTourProgress" class="bm-tour-progress"></div>
      <div class="bm-tour-actions">
        <button id="bmTourPrev" type="button" class="bm-btn bm-tour-ghost">ย้อนกลับ</button>
        <button id="bmTourSkip" type="button" class="bm-btn bm-tour-ghost">ข้าม</button>
        <button id="bmTourNext" type="button" class="bm-btn gold">ถัดไป</button>
      </div>
    </div>
  </div>

  <div id="bmHowToOverlay" class="bm-manual-overlay" aria-hidden="true">
    <div id="bmHowToCard" class="bm-manual-card" role="dialog" aria-modal="true" aria-labelledby="bmHowToTitle" tabindex="-1">
      <div class="bm-manual-header">
        <div>
          <div class="bm-manual-kicker">📖 คู่มือโต๊ะตลาดมืด</div>
          <div id="bmHowToTitle" class="bm-manual-title">วิธีเดินเกมคืนนี้</div>
          <div class="bm-manual-copy">อ่านภาพรวมของโต๊ะก่อน แล้วค่อยดูหัวข้อเฉพาะบทของคุณ จะช่วยให้ตัดสินใจได้ไวขึ้นเวลาโต๊ะเริ่มร้อน</div>
        </div>
        <button id="bmHowToClose" type="button" class="bm-btn alt">ปิดคู่มือ</button>
      </div>
      <!-- Tabs Selector -->
      <div class="bm-manual-tabs" style="display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
        <button type="button" class="bm-manual-tab-btn active" data-tab="guide" style="background: rgba(255,255,255,0.1); border: none; padding: 10px 16px; border-radius: 12px; color: #fff; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 1.05em; cursor: pointer; transition: all 0.2s ease;">📖 กติกา & บทบาทของคุณ</button>
        <button type="button" class="bm-manual-tab-btn" data-tab="example" style="background: transparent; border: none; padding: 10px 16px; border-radius: 12px; color: #aaa; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 1.05em; cursor: pointer; transition: all 0.2s ease;">✨ ตัวอย่างการเล่น (Walkthrough)</button>
      </div>

      <!-- Tab Content 1: Rules & Roles -->
      <div id="bmManualTabGuide">
        <div class="bm-manual-grid">
          <div id="bmHowToOverview" class="bm-manual-column"></div>
          <div id="bmHowToRole" class="bm-manual-column"></div>
        </div>
      </div>

      <!-- Tab Content 2: Simulated Playthrough Walkthrough -->
      <div id="bmManualTabExample" style="display: none; text-align: left;">
        <div style="padding: 10px; display: grid; gap: 20px;">
          <div class="bm-manual-section">
            <h3>✨ ตัวอย่างการจำลองการเล่น 1 ยก (ผู้เล่น 4 คน)</h3>
            <p>เพื่อให้เข้าใจลำดับขั้นตอนเมื่อเฉลยการลงมือ และวิธีการใช้สกิลของแต่ละตำแหน่งในสถานการณ์จริง</p>
          </div>
          
          <div class="bm-manual-section" style="background: rgba(0,0,0,0.25); border-radius: 16px; padding: 16px;">

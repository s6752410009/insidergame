        audioContext = new AudioCtor();
      }
      return audioContext;
    }

    function updateAudioToggle() {
      $('#bmAudioToggle')
        .toggleClass('live', audioEnabled)
        .text(audioEnabled ? '🔊 เสียงพิธีพร้อม' : '🔇 เปิดเสียงพิธี');
    }

    async function unlockAudio() {
      const context = ensureAudioContext();
      if (!context) {
        return false;
      }

      if (context.state === 'suspended') {
        await context.resume();
      }

      audioEnabled = context.state === 'running';
      updateAudioToggle();
      return audioEnabled;
    }

    function playTone(context, frequency, startAt, duration, type, gainValue) {
      const oscillator = context.createOscillator();
      const gain = context.createGain();
      oscillator.type = type;
      oscillator.frequency.setValueAtTime(frequency, startAt);
      gain.gain.setValueAtTime(0.0001, startAt);
      gain.gain.exponentialRampToValueAtTime(gainValue, startAt + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, startAt + duration);
      oscillator.connect(gain);
      gain.connect(context.destination);
      oscillator.start(startAt);
      oscillator.stop(startAt + duration + 0.03);
    }

    function playCeremony(kind) {
      if (!audioEnabled) {
        return;
      }

      const context = ensureAudioContext();
      if (!context) {
        return;
      }

      const baseTime = context.currentTime + 0.02;
      if (kind === 'close') {
        [[392, 0, 0.16], [523.25, 0.12, 0.2], [659.25, 0.24, 0.24], [783.99, 0.38, 0.32]].forEach(function(step) {
          playTone(context, step[0], baseTime + step[1], step[2], 'sawtooth', 0.08);
        });
        return;
      }

      [[523.25, 0, 0.14], [659.25, 0.1, 0.16], [783.99, 0.22, 0.24]].forEach(function(step) {
        playTone(context, step[0], baseTime + step[1], step[2], 'triangle', 0.06);
      });
    }

    function showCeremony(options) {
      clearTimeout(ceremonyTimer);
      const tone = options?.tone === 'red' ? 'red' : 'gold';
      $('#bmCeremonyCard')
        .removeClass('bm-ceremony-gold bm-ceremony-red')
        .addClass(tone === 'red' ? 'bm-ceremony-red' : 'bm-ceremony-gold');
      $('#bmCeremonyKicker').text(options?.kicker || '🎩 เปิดโต๊ะ');
      $('#bmCeremonyTitle').text(options?.title || 'ยกใหม่กำลังเริ่ม');
      $('#bmCeremonyCopy').text(options?.copy || 'ล็อตใหม่กำลังขึ้นโต๊ะ');
      $('#bmCeremonyOverlay').addClass('active');
      playCeremony(options?.sound || 'open');
      ceremonyTimer = window.setTimeout(function() {
        $('#bmCeremonyOverlay').removeClass('active');
      }, Number(options?.duration || 2200));
    }

    function handleCeremony(previousState, nextState) {
      if (!nextState) {
        return;
      }

      const nextRound = Number(nextState.roundNumber || 0);

      if (!hasRenderedOnce) {
        hasRenderedOnce = true;
        if (nextState.phase === 'finished' && nextState.winner) {
          showCeremony({
            kicker: '👑 ปิดโต๊ะ',
            title: `${nextState.winner.avatar || '🎩'} ${nextState.winner.name || 'มีคนคุมเมืองแล้ว'}`,
            copy: nextState.winner.reason || 'คืนนี้มีคนยึดโต๊ะนี้ไปแล้ว',
            tone: 'red',
            sound: 'close',
            duration: 3200
          });
        } else if (nextState.phase === 'market' && nextRound > 0) {
          showCeremony({
            kicker: `🛒 ตลาดมืดเปิดแล้ว (ยก ${nextRound})`,
            title: 'ล็อตใหม่ขึ้นโต๊ะแล้ว',
            copy: 'เลือกซื้อสินค้าหรือไอเทมเถื่อนเพื่อเตรียมทำแผนการต่อไป',
            tone: 'gold',
            sound: 'open'
          });
        } else if (nextState.phase === 'action') {
          showCeremony({
            kicker: `🎯 ช่วงวางแผนลงมือ (ยก ${nextRound})`,
            title: 'ถึงเวลาลงมือลับ',
            copy: 'เลือกการลงมือ: ปล้น สั่งเก็บ ดีล หรือส่งของ เพื่อชิงอิทธิพล',
            tone: 'gold',
            sound: 'open'
          });
        }
        return;
      }

      const previousRound = Number(previousState?.roundNumber || 0);

      // Check for phase transitions first
      if (previousState?.phase !== nextState.phase) {
        if (nextState.phase === 'finished' && nextState.winner) {
          showCeremony({
            kicker: '👑 ปิดโต๊ะ',
            title: `${nextState.winner.avatar || '🎩'} ${nextState.winner.name || 'มีคนคุมเมืองแล้ว'}`,
            copy: nextState.winner.reason || 'คืนนี้มีคนยึดโต๊ะนี้ไปแล้ว',
            tone: 'red',
            sound: 'close',
            duration: 3200
          });
        } else if (nextState.phase === 'market') {
          showCeremony({
            kicker: `🛒 ตลาดมืดเปิดแล้ว (ยก ${nextRound})`,
            title: 'สินค้าล็อตใหม่ขึ้นโต๊ะ',
            copy: 'เลือกลงทุนซื้อสินค้า เกราะป้องกัน หรือพาสปอร์ต ก่อนตลาดวาย',
            tone: 'gold',
            sound: 'open'
          });
        } else if (nextState.phase === 'action') {
          showCeremony({
            kicker: `🎯 ช่วงวางแผนลงมือ (ยก ${nextRound})`,
            title: 'แผนการลับเริ่มทำงาน',
            copy: 'เลือกเป้าหมายและแผนการของคุณ: ปล้น ฆ่า ทำดีล หรือหนีตำรวจ',
            tone: 'gold',
            sound: 'open'
          });
        }
      } else if (nextState.phase === 'market' && nextRound > previousRound) {
        showCeremony({
          kicker: `🛒 ตลาดมืดเปิดแล้ว (ยก ${nextRound})`,
          title: 'ล็อตใหม่ขึ้นโต๊ะแล้ว',
          copy: 'เลือกของให้ไว ก่อนดีลและมีดจะเริ่มเดิน',
          tone: 'gold',
          sound: 'open'
        });
      }
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function plainBmCopy(text) {
      return String(text || '')
        .replace(/[\u{1F300}-\u{1FAFF}\u2600-\u27BF]/gu, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function gameIcon(meta, className) {
      if (typeof window.renderGameIcon === 'function') {
        return window.renderGameIcon(meta || {}, className || 'game-icon');
      }
      return '<span class="' + escapeHtml(className || 'game-icon') + ' game-icon-fallback">' + escapeHtml((meta && meta.icon) || '🎴') + '</span>';
    }

    function feedIconMeta(entry, options) {
      if (!entry) {
        return { icon: '📢', alt: '', inline: true };
      }
      const inlineOnly = !!(options && options.inline);
      return {
        id: entry.iconId || entry.id || null,
        image: inlineOnly ? null : (entry.image || null),
        icon: entry.icon || '📢',
        alt: entry.text || '',
        inline: inlineOnly
      };
    }

    function phaseMeta(phase) {
      if (phase === 'market') {
        return { label: '🛒 เปิดตลาด', className: 'phase-market' };
      }
      if (phase === 'action') {
        return { label: '🎯 ลงมือ', className: 'phase-action' };
      }
      if (phase === 'finished') {
        return { label: '👑 ปิดโต๊ะ', className: 'phase-finished' };
      }
      return { label: '🎩 รอตั้งโต๊ะ', className: 'phase-market' };
    }

    function getSelf() {
      return currentState.self || {};
    }

    function getAliveTargets() {
      return (currentState.players || []).filter(player => player.alive && !player.isSelf);
    }

    function getActionMeta(actionType) {
      return (currentState.actionCatalog || []).find(action => action.id === actionType) || null;
    }

    function hasSeenSpotlight() {
      try {
        return window.localStorage.getItem(spotlightKey) === 'done';
      } catch (error) {
        return false;
      }
    }

    function markSpotlightSeen() {
      try {
        window.localStorage.setItem(spotlightKey, 'done');
      } catch (error) {
        return undefined;
      }
    }

    function renderSpotlightProgress() {
      $('#bmTourProgress').attr('aria-label', `ขั้น ${spotlightStepIndex + 1} จาก ${spotlightSteps.length}`);
      $('#bmTourProgress').html(spotlightSteps.map(function(step, index) {
        return `<div class="bm-tour-dot ${index === spotlightStepIndex ? 'active' : ''}"></div>`;
      }).join(''));
    }

    function buildManualLines(lines) {
      return (lines || []).map(function(line, index) {
        return `
          <div class="bm-manual-line">
            <div class="bm-manual-bullet">${index + 1}</div>
            <div><span>${escapeHtml(line)}</span></div>
          </div>
        `;
      }).join('');
    }

    function getRolePlaybook() {
      const role = currentState.playerRole || {};
      return rolePlaybooks[role.id] || {
        opening: ['อ่านบทของตัวเองก่อนทุกยก แล้วเลือกทางที่ทำให้คุณได้ทั้งแต้มและทางหนี'],
        earlyGame: ['ต้นโต๊ะให้ดูว่าใครสะสมทุน ใครสะสมของ และใครเริ่มเปิดหน้าเร็วเกินไป แล้ววางตัวเองให้ได้เปรียบ'],
        tempo: ['ถ้ายังอ่านโต๊ะไม่ออก ให้เริ่มจากสืบข่าวหรือเก็บทุนก่อน อย่ารีบเปิดหน้า'],
        midGame: ['กลางโต๊ะให้เลือกจังหวะที่อีกฝ่ายเริ่มเปิดไพ่ แล้วเปลี่ยนจุดเด่นของบทคุณเป็นแต้มหรือความได้เปรียบทันที'],
        endGame: ['ปิดโต๊ะให้คิดทั้งแต้ม เงิน ค่าหัว และคนที่ยังยืนอยู่ ไม่ใช่มองแค่ยกตรงหน้า'],
        partnerRoles: ['จับมือกับคนที่ทำให้จุดเด่นของบทคุณทำงานง่ายขึ้น แล้วแตกออกทันทีเมื่อโต๊ะเริ่มจับทางได้'],
        specialThreats: ['ระวังบทที่ตัดจุดเด่นของคุณโดยตรง และคนที่กำลังนำ เพราะทั้งสองแบบจะบังคับจังหวะคุณได้ก่อน'],
        danger: ['อย่ากดแผนเพราะใจร้อน จังหวะผิดยกเดียวอาจทำให้ทั้งเงิน แต้ม และชีวิตบนโต๊ะหายพร้อมกัน']
      };
    }

    function getSelfStatusSnapshot() {
      const self = getSelf();
      const inventory = self.inventory || [];
      const actionHelp = currentState.actionHelp || {};
      const alivePlayers = (currentState.players || []).filter(function(player) {
        return player.alive;
      });
      const aliveOpponents = getAliveTargets();
      const sortedOpponents = aliveOpponents.slice().sort(function(left, right) {
        return Number(right.influence || 0) - Number(left.influence || 0);
      });
      const sortedAlive = alivePlayers.slice().sort(function(left, right) {
        if (Number(right.influence || 0) !== Number(left.influence || 0)) {
          return Number(right.influence || 0) - Number(left.influence || 0);
        }
        return Number(right.cash || 0) - Number(left.cash || 0);
      });
      const hottestPlayer = alivePlayers.slice().sort(function(left, right) {
        if (Number(right.heat || 0) !== Number(left.heat || 0)) {
          return Number(right.heat || 0) - Number(left.heat || 0);
        }
        return Number(left.cash || 0) - Number(right.cash || 0);
      })[0] || null;
      const fragilePlayer = alivePlayers.slice().sort(function(left, right) {
        const leftRisk = (Number(left.heat || 0) * 10) - Number(left.cash || 0);
        const rightRisk = (Number(right.heat || 0) * 10) - Number(right.cash || 0);
        return rightRisk - leftRisk;
      })[0] || null;
      const topThreat = sortedOpponents[0] || null;
      const tableLeader = sortedAlive[0] || null;
      const gunCount = inventory.filter(function(item) {
        const value = `${item.id || ''} ${item.name || ''} ${item.summary || ''}`.toLowerCase();
        return value.includes('gun') || value.includes('ปืน');
      }).length;
      const cargoCount = (actionHelp.cargoItems || []).length;
      const cash = Number(self.cash || 0);
      const heat = Number(self.heat || 0);
      const influence = Number(self.influence || 0);
      const topThreatInfluence = Number(topThreat?.influence || 0);
      return {
        cash,
        heat,
        influence,
        inventory,
        gunCount,
        cargoCount,
        hasPassport: Boolean(actionHelp.hasPassport),
        canHit: Boolean(actionHelp.canHit),
        pendingAction: self.pendingAction || null,
        pendingMarketChoice: self.pendingMarketChoice || null,
        phase: currentState.phase || 'market',
        topThreat,
        tableLeader,
        hottestPlayer,
        fragilePlayer,
        trailingLeader: Boolean(topThreat && topThreatInfluence > influence),
        lowCash: cash <= 2,
        flushCash: cash >= 6,
        highHeat: heat >= 4,
        criticalHeat: heat >= 5,
        holdingGun: gunCount > 0,
        holdingCargo: cargoCount > 0,
        inventoryHeavy: inventory.length >= 3,
        roundNumber: Number(currentState.roundNumber || 0)
      };
    }

    function getLatestTableEvent() {
      const report = currentState.lastRoundReport || [];
      if (report.length) {
        return report[0];
      }

      const history = currentState.history || [];
      return history[0] || null;
    }

    function getSelfDisplayName() {
      const selfPlayer = (currentState.players || []).find(function(player) {
        return player.isSelf;
      });
      return selfPlayer?.name || 'คุณ';
    }

    function buildNarratorState(rolePlaybook) {
      const status = getSelfStatusSnapshot();
      const self = getSelf();
      const latestEvent = getLatestTableEvent();
      const selfName = getSelfDisplayName();
      const notes = [];
      let title = 'ผู้ดำเนินเกมกำลังจัดโต๊ะ';
      let summary = 'โต๊ะนี้จะคอยบอกว่าตอนนี้เกมเดินถึงไหน และแรงกดกำลังไหลไปทางใคร';

      if (status.phase === 'market') {
        title = `ผู้ดำเนินเกมประกาศ: ยก ${Math.max(status.roundNumber, 1)} เปิดตลาดแล้ว`;
        summary = status.pendingMarketChoice
          ? 'คุณล็อกของสำหรับยกนี้แล้ว รอระบบปิดตลาดและเฉลยว่าใครหยิบอะไรเข้ากระเป๋า'
          : 'ตอนนี้เป็นช่วงเลือกของ ระบบจะพาคุณอ่านว่าควรกวาดของหรือผ่านตลาดเพื่อเก็บแรงไว้ยกถัดไป';
      } else if (status.phase === 'action') {
        title = `ผู้ดำเนินเกมประกาศ: ยก ${Math.max(status.roundNumber, 1)} เข้าช่วงลงมือ`;
        summary = status.pendingAction
          ? `คุณล็อก ${status.pendingAction.summaryText || status.pendingAction.label || 'แผนยกนี้'} แล้ว ตอนนี้รอระบบเฉลยผลพร้อมกันทั้งโต๊ะ`
          : 'ตลาดปิดแล้ว ตอนนี้เป็นช่วงเลือกแอ็กชันเดียวของยกนี้ ระบบจะเฉลยพร้อมกันหลังทุกคนปิดมือ';
      } else if (status.phase === 'finished') {
        title = 'ผู้ดำเนินเกมประกาศ: โต๊ะนี้ปิดแล้ว';
        summary = currentState.winner?.reason || 'ระบบสรุปคนคุมเมืองคืนนี้ไว้ให้แล้ว ดูผลแล้วเลือกว่าจะเปิดเมืองใหม่หรือกลับห้อง';
      }

      if (latestEvent?.text) {
        notes.push({
          title: 'เหตุการณ์ล่าสุด',
          copy: latestEvent.text
        });
      }

      if (status.tableLeader && status.tableLeader.playerId !== self.playerId) {
        notes.push({
          title: 'คนที่นำโต๊ะ',
          copy: `${status.tableLeader.avatar || ''} ${status.tableLeader.name || 'คนที่นำอยู่'} ถือ 👑 ${Number(status.tableLeader.influence || 0)} ตอนนี้ ถ้าจะเปิดเกมควรคิดก่อนว่ากดเขาลงได้จริงไหม`
        });
      }

      if (status.hottestPlayer && Number(status.hottestPlayer.heat || 0) > 0) {
        notes.push({
          title: 'คนที่โต๊ะกำลังเพ่ง',
          copy: `${status.hottestPlayer.avatar || ''} ${status.hottestPlayer.name || 'ใครบางคน'} มี 🔥 ${Number(status.hottestPlayer.heat || 0)} สูงสุดบนโต๊ะ ตอนนี้ทุกสายตากำลังมองเขาอยู่`
        });
      }

      if (status.fragilePlayer && (Number(status.fragilePlayer.heat || 0) >= 5 || Number(status.fragilePlayer.cash || 0) <= 1)) {
        notes.push({
          title: 'คนที่เริ่มเสียทรง',
          copy: `${status.fragilePlayer.avatar || ''} ${status.fragilePlayer.name || 'ใครบางคน'} เริ่มเปราะจากเงินหรือค่าหัว ถ้าบทคุณเก็บงานหรือกดโต๊ะเก่ง นี่คือชื่อที่ต้องจับตา`
        });
      }

      if (status.pendingAction && ['deal', 'betray'].includes(status.pendingAction.actionType)) {
        notes.push({
          title: 'ดีลของคุณตอนนี้',
          copy: status.pendingAction.actionType === 'betray'
            ? 'คุณวางมีดรอรับดีลอยู่ ถ้าอีกฝ่ายเปิดเข้ามาจริง ระบบจะตัดสินตอนปิดยกทันที'
            : 'คุณเปิดดีลของยกนี้ไปแล้ว ถ้าอีกฝ่ายรับกลับ ระบบจะปิดดีลให้พร้อมคิดกำไรทันที'
        });
      }

      if (!notes.length) {
        notes.push({
          title: 'จังหวะของบทคุณ',
          copy: rolePlaybook.tempo?.[0] || `${selfName} ยังมีพื้นที่อ่านโต๊ะอยู่ ใช้ยกนี้หาจังหวะที่จุดเด่นของบทคุณทำงานเต็มที่สุด`
        });
      }

      return {
        title,
        summary,
        notes: notes.slice(0, 4)
      };
    }

    function buildLiveAdviceCards(rolePlaybook) {
      const self = getSelf();
      const status = getSelfStatusSnapshot();
      const latestEvent = getLatestTableEvent();
      const cards = [];

      if (status.lowCash) {
        cards.push({
          label: 'เงินดำเริ่มฝืด',
          chip: `💵 ${status.cash}`,
          copy: 'ตอนนี้อย่าเผาเงินเพราะใจร้อน ถ้าตลาดไม่คุ้มให้ผ่านหรือเล่นดีลที่คืนทุนไวก่อน แล้วค่อยกลับมาเร่งบทของคุณ',
          emphasis: 'เอาตัวรอดก่อน'
        });
      } else if (status.flushCash) {
        cards.push({
          label: 'ทุนยังหนา',
          chip: `💵 ${status.cash}`,
          copy: 'คุณมีแรงกดโต๊ะมากกว่าคนอื่น ใช้เงินเปิดของสำคัญหรือบังคับจังหวะดีลให้คนที่เริ่มจนต้องเล่นตาม',
          emphasis: 'ใช้ทุนกดโต๊ะ'
        });
      }

      if (status.criticalHeat) {
        cards.push({
          label: 'ค่าหัวเดือดมาก',
          chip: `🔥 ${status.heat}`,
          copy: 'ตอนนี้ทุกแผนแรงต้องคุ้มจริง ไม่อย่างนั้นแต้มจะรั่วเอง คิดถึงหมอบต่ำ ตั้งการ์ด หรือพักจังหวะหนึ่งยกก่อน',
          emphasis: 'หยุดร้อนก่อน'
        });
      } else if (status.highHeat) {
        cards.push({
          label: 'เริ่มถูกจับตา',
          chip: `🔥 ${status.heat}`,
          copy: 'โต๊ะเริ่มเห็นทรงคุณแล้ว ถ้าจะเปิดหน้า ต้องมั่นใจว่าปิดกำไรได้จริง ไม่เช่นนั้นควรซ่อนมือหนึ่งยก',
          emphasis: 'อย่าเปิดฟรี'
        });
      }

      if (status.holdingGun && status.canHit) {
        cards.push({
          label: 'ถือปืนพร้อมเปิดงาน',
          chip: `🔫 ${status.gunCount}`,
          copy: status.topThreat
            ? `ปืนคุณมีน้ำหนักแล้ว เป้าตรงหน้าที่น่าคิดที่สุดคือ ${status.topThreat.avatar || ''} ${status.topThreat.name || 'คนที่นำอยู่'} ถ้ายิงแล้วอันดับไม่พลิก อย่าเพิ่งลั่นไก`
            : 'ปืนพร้อมใช้ แต่ยังไม่มีเป้าชัดพอจะคุ้มการเปิดงาน เก็บแรงไว้ก่อนถ้าโต๊ะยังไม่เผยตัว',
          emphasis: 'เลือกเหยื่อให้คุ้ม'
        });
      } else if (status.holdingGun) {
        cards.push({
          label: 'มีปืนแต่ยังเปิดงานไม่คุ้ม',
          chip: `🔫 ${status.gunCount}`,
          copy: 'มีอาวุธแล้วแต่เงื่อนไขยังไม่พร้อม ใช้มันเป็นแรงขู่เชิงจิตวิทยาไปก่อน แล้วหาทุนหรือข่าวเพิ่มให้การยิงครั้งถัดไปคุ้มจริง',
          emphasis: 'อย่ารีบยิง'
        });
      }

      if (status.holdingCargo) {
        cards.push({
          label: 'มีของพร้อมเปลี่ยนเป็นแต้ม',
          chip: `📦 ${status.cargoCount}`,
          copy: status.phase === 'action'
            ? 'จังหวะนี้คุณมีของส่งแต้มได้ทันที ชั่งระหว่างกดส่งเลยกับเก็บไว้ยกปิดโต๊ะตามแรงกดของคู่แข่ง'
            : 'ตอนนี้ของในมือคือแต้มล่วงหน้า อย่าซื้อเพิ่มจนแน่นมือถ้ายังไม่มีช่องปล่อยของในยกถัดไป',
          emphasis: 'ดูช่องปล่อยของ'
        });
      }

      if (status.inventoryHeavy && !status.holdingCargo) {
        cards.push({
          label: 'ของแน่นมือ',
          chip: `🎒 ${status.inventory.length}`,
          copy: 'ถือของหลายชิ้นแปลว่าคุณเริ่มเป็นเป้า อย่าปล่อยให้ทั้งโต๊ะอ่านออกว่าของไหนคือของทำแต้มหลักของคุณ',
          emphasis: 'พรางมือไว้'
        });
      }

      if (status.hasPassport) {
        cards.push({
          label: 'มีทางหนีติดตัว',
          chip: '🛂 พร้อมใช้',
          copy: 'หนังสือทางหนีช่วยให้คุณพักเกมได้คุ้มขึ้น ถ้าค่าหัวกำลังสูง นี่คือจังหวะรีเซ็ตภาพลักษณ์ที่ควรจำไว้',
          emphasis: 'ใช้หนีให้มีค่า'
        });
      }

      if (status.phase === 'market') {
        cards.push({
          label: 'ตอนนี้อยู่ช่วงเปิดตลาด',
          chip: `🌒 ยก ${Math.max(status.roundNumber, 1)}`,
          copy: status.lowCash
            ? 'ตลาดยกนี้ต้องซื้อแบบคัดจริง เลือกเฉพาะของที่ต่อยอดเป็นแต้มหรือช่วยหนีตายในยกถัดไป'
            : 'ก่อนกดซื้อให้ถามตัวเองว่าของชิ้นนี้จะทำเงิน ทำแต้ม หรือกันตายให้บทของคุณอย่างไร ถ้าตอบไม่ได้ อย่าหยิบ',
          emphasis: 'ซื้อให้มีแผน'
        });
      } else if (status.phase === 'action') {
        cards.push({
          label: 'ตอนนี้อยู่ช่วงลงมือ',
          chip: status.pendingAction ? '🔒 ล็อกแผนแล้ว' : '🎯 ยังเลือกได้',
          copy: status.pendingAction
            ? `คุณล็อก ${status.pendingAction.summaryText || status.pendingAction.label || 'แผนยกนี้'} ไปแล้ว ใช้เวลานี้ดูว่าใครน่าจะโดนผลแผนมากที่สุดในตอนปิดยก`
            : `ถ้าจะเล่นตามบท ${self.roleTitle || ''} ให้เทียบแผนตรงหน้าเข้ากับ ${rolePlaybook.tempo?.[0] || 'จังหวะทองของบทคุณ'} ก่อนกด`,
          emphasis: 'คิดก่อนล็อกมือ'
        });
      }

      if (status.trailingLeader && status.topThreat) {
        cards.push({
          label: 'คนที่กำลังคุมโต๊ะ',
          chip: `👑 ${Number(status.topThreat.influence || 0)}`,
          copy: `${status.topThreat.avatar || ''} ${status.topThreat.name || 'เป้าหมายหลัก'} นำอยู่ตอนนี้ ถ้ายกนี้คุณจะลงมือ ควรคิดก่อนว่าแผนนั้นกดเขาได้จริงหรือแค่เสียแรงไปฟรี`,
          emphasis: 'เลือกเป้าถูกคน'
        });
      }

      if (status.hottestPlayer && Number(status.hottestPlayer.heat || 0) >= 4) {
        cards.push({
          label: 'คนค่าหัวสูงสุดตอนนี้',
          chip: `🔥 ${Number(status.hottestPlayer.heat || 0)}`,
          copy: `${status.hottestPlayer.avatar || ''} ${status.hottestPlayer.name || 'ใครบางคน'} ร้อนสุดบนโต๊ะ ถ้าคุณไม่ใช่คนนั้น นี่คือม่านควันที่ใช้เดินเกมได้ แต่ถ้าคุณใช่ ต้องรีบลดไฟก่อนโต๊ะหันมาซ้ำ`,
          emphasis: 'อ่านไฟของโต๊ะ'
        });
      }

      if (status.fragilePlayer && (Number(status.fragilePlayer.heat || 0) >= 5 || Number(status.fragilePlayer.cash || 0) <= 1)) {
        cards.push({
          label: 'มีคนใกล้เสียทรง',
          chip: `${status.fragilePlayer.avatar || '🎭'} ${status.fragilePlayer.name || 'เป้าเปราะ'}`,
          copy: `${status.fragilePlayer.name || 'เป้าหมายนี้'} กำลังเปราะจากเงินต่ำหรือค่าหัวสูง ถ้าบทคุณถนัดเก็บกำไรจากคนอ่อนแรง นี่คือชื่อที่ควรเอาเข้ากระจกมอง`,
          emphasis: 'เหยื่อเริ่มชัด'
        });
      }

      if (latestEvent?.text) {
        const eventTone = String(latestEvent.text || '');
        if (/เปิดดีล|ปิดดีล|หักหลัง/.test(eventTone)) {
          cards.push({
            label: 'โต๊ะเพิ่งมีเรื่องบนเส้นดีล',
            chip: gameIcon(feedIconMeta(latestEvent, { inline: true })),
            copy: `${eventTone} เหตุการณ์พวกนี้เปลี่ยนว่าใครน่าไว้ใจและใครกำลังล่อมีด อย่าเดินยกนี้เหมือนไม่มีอะไรเกิดขึ้น`,
            emphasis: 'อ่านดีลก่อนลงมือ'
          });
        } else if (/สั่งเก็บ|เปิดงาน|รอดจากคำสั่งเก็บ/.test(eventTone)) {
          cards.push({
            label: 'โต๊ะเพิ่งมีงานเลือด',
            chip: gameIcon(feedIconMeta(latestEvent, { inline: true })),
            copy: `${eventTone} หลังงานเลือด โต๊ะมักหันไปกันตัวหรือรีบเอาคืน ยกนี้จึงมีค่าเรื่องจังหวะหนีและจังหวะสวนมากกว่าปกติ`,
            emphasis: 'เกมจะร้อนเร็ว'
          });
        }
      }

      if (!cards.length) {
        cards.push({
          label: 'โต๊ะยังไม่บีบคุณมาก',
          chip: rolePlaybook.tempo?.[0] ? '🎯 อ่านจังหวะ' : '🎯 ตั้งหลัก',
          copy: 'สถานะตอนนี้ยังไม่กดให้คุณต้องรีบเสี่ยง เปิดยกนี้ด้วยแผนที่หนุนบทของคุณที่สุด แล้วเก็บแรงไว้ตอนโต๊ะเริ่มเผยหน้า',
          emphasis: 'อย่ารีบเปิดหน้า'
        });
      }

      if (cards.length < 2) {
        cards.push({
          label: 'จังหวะของบทคุณตอนนี้',
          chip: status.phase === 'market' ? '🛒 ช่วงเลือกของ' : '🎯 ช่วงลงมือ',
          copy: status.phase === 'market'
            ? 'ให้เลือกเฉพาะของที่ทำให้บทของคุณเดินต่อได้จริง ถ้าของไม่หนุนเกมคุณ การผ่านยกยังดีกว่าซื้อมั่ว'
            : `ถ้าจะกดแผนในยกนี้ ให้เริ่มจากสิ่งที่บท ${self.roleTitle || 'ของคุณ'} ได้เปรียบที่สุดก่อน แล้วค่อยคิดไม้เสริม`,
          emphasis: 'เดินตามบทก่อน'
        });
      }

      return cards.slice(0, 6);
    }


    function getAnnouncerOneLiner() {
      const status = getSelfStatusSnapshot();
      if (currentState.phase === 'market') {
        return status.pendingMarketChoice ? 'ล็อกตลาดแล้ว รอคนอื่น' : ('ยก ' + (currentState.roundNumber || 1) + ' · เลือกซื้อของหรือผ่าน');
      }
      if (currentState.phase === 'action') {
        return status.pendingAction ? ('ล็อกแล้ว: ' + (status.pendingAction.label || 'รอเฉลย')) : ('ยก ' + (currentState.roundNumber || 1) + ' · เลือกแผนด้านล่าง');
      }
      if (currentState.phase === 'finished') {
        return 'เกมจบแล้ว';
      }
      return 'รอเริ่มเกม';
    }

    function renderNowBar() {
      const self = getSelf();
      const status = getSelfStatusSnapshot();
      const phase = currentState.phase;
      let main = 'รอเริ่มเกม';
      let sub = 'เป้าหมาย: มี 👑 มากสุดใน 5 ยก หรือเหลือรอดคนสุดท้าย';
      let locked = false;
      let cta = '';

      const lp = currentState.lockProgress;
      const lockText = (lp && lp.total) ? ('ล็อกแล้ว ' + lp.locked + '/' + lp.total + ' คน') : '';

      if (!self.alive) {
        main = 'คุณออกจากเกมแล้ว — ดูผลอย่างเดียว';
        sub = '';
      } else if (phase === 'market') {
        if (status.pendingMarketChoice) {
          main = 'รอคนอื่นเลือกตลาด — คุณล็อกแล้ว';
          sub = lockText || 'แก้ไม่ได้จนกว่าจะปิดยก';
          locked = true;
        } else {
          main = 'ขั้นที่ 1: เลือกของจากตลาด';
          sub = 'ซื้อ 1 ชิ้น หรือกด「ผ่าน — ไม่ซื้อ」· ของที่ซื้อไว้ใช้ตอน「ลงมือ」' + (lockText ? ' · ' + lockText : '');
          cta = 'ไปที่ตลาดมืด';
        }
      } else if (phase === 'action') {
        if (status.pendingAction) {
          main = 'รอคนอื่นลงมือ — คุณล็อกแล้ว';
          sub = lockText || plainBmCopy(status.pendingAction.summaryText || status.pendingAction.label || '');
          locked = true;
        } else {
          main = 'ขั้นที่ 2: เลือกแผน 1 อย่าง';
          sub = 'แนะนำ: ส่งของ (ได้อิทธิพล) · สืบข่าว (ดูเป้า) · ผ่าน (ไม่ทำ) · แผนลับกด「ดูแผนหลักทั้งหมด」' + (lockText ? ' · ' + lockText : '');
          cta = 'ไปเลือกแผน';
        }
      } else if (phase === 'finished') {
        main = 'เกมจบแล้ว';
        sub = currentState.winner ? ('ชนะ: ' + (currentState.winner.name || '')) : '';
      }

      $('#bmNowBar')
        .toggleClass('locked', locked)
        .html(
          '<div class="bm-now-bar-label">ทำอะไรตอนนี้</div>' +
          '<div class="bm-now-bar-text">' + escapeHtml(main) + '</div>' +
          (sub ? '<div class="bm-now-bar-sub">' + escapeHtml(sub) + '</div>' : '') +
          (cta ? '<button type="button" id="bmNowBarGo" class="bm-now-bar-go">' + escapeHtml(cta) + '</button>' : '')
        );
    }

    function renderFlowGuide() {
      const phase = currentState.phase;
      const round = Number(currentState.roundNumber || 0);
      const maxRounds = Number(currentState.maxRounds || 5);
      const steps = [
        {
          key: 'market',
          title: '1) ตลาด',
          copy: 'ซื้อของหรือผ่าน'
        },
        {
          key: 'action',
          title: '2) ลงมือ',
          copy: 'ทำ 1 อย่างต่อยก'
        },
        {
          key: 'score',
          title: 'เป้าหมาย',
          copy: 'สะสมอิทธิพลให้สูงสุดใน ' + maxRounds + ' ยก'
        }
      ];

      const html = steps.map(function(step) {
        let cls = 'bm-flow-step';
        if (step.key === 'market') {
          cls += phase === 'market' ? ' is-active' : (phase === 'action' || phase === 'finished' ? ' is-done' : '');
        } else if (step.key === 'action') {
          cls += phase === 'action' ? ' is-active' : (phase === 'finished' ? ' is-done' : '');
        } else if (phase !== 'finished' && round > 0) {
          cls += ' is-active';
        }
        return '<div class="' + cls + '"><strong>' + escapeHtml(step.title) + '</strong>' + escapeHtml(step.copy) + '</div>';
      }).join('');

      $('#bmFlowGuide').html(html);
    }

    function renderAnnouncer(rolePlaybook) {
      const narrator = buildNarratorState(rolePlaybook);
      const oneLine = getAnnouncerOneLiner();
      const expanded = announcerExpanded;
      $('#bmAnnouncerBar').html(
        '<button type="button" id="bmAnnouncerToggle" class="bm-announcer-toggle" aria-expanded="' + expanded + '">' +
          '<span class="bm-announcer-title">📢 ผู้ดำเนินเกมประกาศ: ' + escapeHtml(oneLine) + '</span>' +
          '<span aria-hidden="true">' + (expanded ? '▲' : '▼') + '</span>' +
        '</button>' +
        (expanded
          ? '<div class="bm-announcer-body">' +
              '<div class="bm-announcer-copy">' +
                '<div class="bm-announcer-text">' + escapeHtml(narrator.summary) + '</div>' +
              '</div>' +
              '<div class="bm-announcer-rails">' +
                narrator.notes.slice(0, 2).map(function(note) {
                  return '<div class="bm-announcer-note"><strong>' + escapeHtml(note.title) + '</strong><span>' + escapeHtml(note.copy) + '</span></div>';
                }).join('') +
              '</div>' +
            '</div>'
          : '')
      );
    }


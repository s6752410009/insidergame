<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bm-bg: #09090b;
    --bm-panel: rgba(18, 18, 20, 0.86);
    --bm-panel-soft: rgba(255, 255, 255, 0.05);
    --bm-line: rgba(255, 255, 255, 0.09);
    --bm-line-strong: rgba(245, 200, 107, 0.18);
    --bm-gold: #f5c86b;
    --bm-gold-deep: #b7791f;
    --bm-red: #d94b42;
    --bm-red-deep: #7f1d1d;
    --bm-blue: #74b9ff;
    --bm-violet: #d6bcfa;
    --bm-text: #f5efe3;
    --bm-muted: #b8ada0;
    --bm-green: #6ee7b7;
    --bm-shadow: 0 32px 100px rgba(0, 0, 0, 0.52);
  }

  body.content {
    background:
      radial-gradient(circle at 10% 5%, rgba(127, 29, 29, 0.45), transparent 22%),
      radial-gradient(circle at 92% 0%, rgba(180, 83, 9, 0.22), transparent 18%),
      radial-gradient(circle at 50% 100%, rgba(91, 33, 182, 0.08), transparent 24%),
      linear-gradient(180deg, #09090b 0%, #110d0c 45%, #17110f 100%);
  }

  .bm-page {
    position: relative;
    max-width: 1440px;
    margin: 20px auto 36px;
    padding: 20px;
    color: var(--bm-text);
    font-family: 'Rajdhani', sans-serif;
  }

  .bm-page::before,
  .bm-page::after {
    content: '';
    position: fixed;
    width: 40vw;
    height: 40vw;
    border-radius: 999px;
    pointer-events: none;
    filter: blur(90px);
    opacity: 0.16;
    z-index: 0;
  }

  .bm-page::before {
    top: -14vw;
    left: -10vw;
    background: radial-gradient(circle, rgba(127, 29, 29, 0.9), transparent 68%);
  }

  .bm-page::after {
    right: -12vw;
    bottom: -18vw;
    background: radial-gradient(circle, rgba(180, 83, 9, 0.85), transparent 72%);
  }

  .bm-shell {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(245, 200, 107, 0.16);
    border-radius: 34px;
    background:
      linear-gradient(145deg, rgba(12, 12, 14, 0.98), rgba(26, 17, 15, 0.94)),
      var(--bm-bg);
    box-shadow: var(--bm-shadow);
  }

  .bm-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.05) 0.7px, transparent 0.7px);
    background-size: 16px 16px;
    opacity: 0.2;
    pointer-events: none;
  }

  .bm-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, rgba(245, 200, 107, 0.06), transparent 18%, transparent 70%, rgba(116, 185, 255, 0.04)),
      radial-gradient(circle at top center, rgba(245, 200, 107, 0.08), transparent 32%);
    pointer-events: none;
    z-index: 0;
  }

  .bm-topbar {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    padding: 24px 26px 22px;
    border-bottom: 1px solid var(--bm-line);
    background:
      radial-gradient(circle at top left, rgba(127, 29, 29, 0.32), transparent 34%),
      linear-gradient(135deg, rgba(127, 29, 29, 0.22), rgba(17, 17, 17, 0.72));
  }

  .bm-topbar::after {
    content: '';
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(245, 200, 107, 0.24), transparent 32%, transparent 68%, rgba(245, 200, 107, 0.2));
  }

  .bm-brand {
    display: grid;
    gap: 6px;
    max-width: 720px;
  }

  .bm-kicker {
    color: var(--bm-gold);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .bm-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1;
    text-shadow: 0 0 20px rgba(245, 200, 107, 0.12);
  }

  .bm-subtitle {
    color: var(--bm-muted);
    font-size: 1rem;
    max-width: 62ch;
  }

  .bm-top-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    max-width: 420px;
  }

  .bm-announcer {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 14px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--bm-line);
    background:
      linear-gradient(135deg, rgba(180, 83, 9, 0.08), rgba(17, 17, 17, 0.68)),
      radial-gradient(circle at top left, rgba(245, 200, 107, 0.12), transparent 38%);
  }

  .bm-announcer-copy {
    min-width: 0;
    display: grid;
    gap: 6px;
  }

  .bm-announcer-kicker {
    color: var(--bm-gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bm-announcer-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1rem, 2vw, 1.22rem);
    line-height: 1.3;
  }

  .bm-announcer-text {
    color: var(--bm-muted);
    line-height: 1.45;
  }

  .bm-announcer-rails {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    min-width: 0;
  }

  .bm-announcer-note {
    min-width: 0;
    padding: 12px 14px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.08);
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.025));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }

  .bm-announcer-note strong {
    display: block;
    margin-bottom: 4px;
  }

  .bm-announcer-note span {
    color: var(--bm-muted);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .bm-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    font-weight: 700;
    color: var(--bm-text);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .bm-chip.phase-market { border-color: rgba(245, 200, 107, 0.26); color: #fde68a; }
  .bm-chip.phase-action { border-color: rgba(248, 113, 113, 0.26); color: #fecaca; }
  .bm-chip.phase-finished { border-color: rgba(110, 231, 183, 0.24); color: #d1fae5; }

  .bm-audio-chip {
    border: 1px solid rgba(245, 200, 107, 0.18);
    font-family: 'Rajdhani', sans-serif;
    cursor: pointer;
  }

  .bm-audio-chip.live {
    color: #d1fae5;
    border-color: rgba(110, 231, 183, 0.26);
    background: rgba(4, 120, 87, 0.18);
  }

  .bm-ceremony {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0.72));
    transition: opacity 0.3s ease;
  }

  .bm-ceremony.active {
    opacity: 1;
  }

  .bm-tour-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: none;
    background: rgba(5, 5, 6, 0.72);
  }

  .bm-tour-overlay.active {
    display: block;
  }

  .bm-tour-focus {
    position: relative;
    z-index: 33;
    border-color: rgba(245, 200, 107, 0.58);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 0 0 2px rgba(245, 200, 107, 0.72),
      0 0 0 8px rgba(245, 200, 107, 0.12),
      0 24px 54px rgba(0, 0, 0, 0.34);
    transform: translateY(-2px);
  }

  .bm-tour-card {
    position: fixed;
    z-index: 32;
    width: min(360px, calc(100vw - 24px));
    padding: 18px 18px 16px;
    border-radius: 24px;
    border: 1px solid rgba(245, 200, 107, 0.28);
    background:
      radial-gradient(circle at top left, rgba(127, 29, 29, 0.28), transparent 36%),
      linear-gradient(145deg, rgba(12, 12, 14, 0.96), rgba(26, 17, 15, 0.94));
    box-shadow: 0 22px 64px rgba(0, 0, 0, 0.44);
    outline: none;
  }

  .bm-tour-kicker {
    color: var(--bm-gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bm-tour-title {
    margin-top: 8px;
    font-family: 'Orbitron', sans-serif;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .bm-tour-copy {
    margin-top: 8px;
    color: var(--bm-muted);
    line-height: 1.5;
  }

  .bm-tour-progress {
    margin-top: 12px;
    display: flex;
    gap: 6px;
  }

  .bm-tour-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
  }

  .bm-tour-dot.active {
    background: var(--bm-gold);
    box-shadow: 0 0 12px rgba(245, 200, 107, 0.48);
  }

  .bm-tour-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 14px;
  }

  .bm-tour-actions .bm-btn {
    min-width: 92px;
    flex: 1 1 0;
  }

  .bm-tour-ghost {
    background: rgba(255,255,255,0.08);
  }

  .bm-manual-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: none;
    padding: 18px;
    overflow-y: auto;
    background: rgba(5, 5, 6, 0.82);
  }

  .bm-manual-overlay.active {
    display: block;
  }

  .bm-manual-card {
    position: relative;
    width: min(1160px, 100%);
    margin: 0 auto;
    border-radius: 32px;
    border: 1px solid rgba(245, 200, 107, 0.24);
    background:
      radial-gradient(circle at top left, rgba(127, 29, 29, 0.26), transparent 24%),
      linear-gradient(145deg, rgba(12, 12, 14, 0.98), rgba(26, 17, 15, 0.96));
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.48);
    padding: 24px;
    outline: none;
  }

  .bm-manual-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 18px;
  }

  .bm-manual-kicker {
    color: var(--bm-gold);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bm-manual-title {
    margin-top: 6px;
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.45rem, 3vw, 2.2rem);
    line-height: 1.08;
  }

  .bm-manual-copy {
    margin-top: 8px;
    color: var(--bm-muted);
    max-width: 70ch;
    line-height: 1.5;
  }

  .bm-manual-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
    gap: 18px;
    align-items: start;
  }

  .bm-manual-column {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .bm-manual-section {
    min-width: 0;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.09);
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.028));
    padding: 18px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }

  .bm-manual-section h3 {
    margin: 0;
    font-family: 'Orbitron', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .bm-manual-section p {
    margin: 10px 0 0;
    color: var(--bm-muted);
    line-height: 1.5;
  }

  .bm-manual-list {
    margin: 12px 0 0;
    display: grid;
    gap: 10px;
  }

  .bm-manual-line {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: start;
    color: var(--bm-text);
  }

  .bm-manual-bullet {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgba(245, 200, 107, 0.24);
    background: rgba(245, 200, 107, 0.08);
    color: var(--bm-gold);
    font-weight: 700;
    font-size: 0.8rem;
  }

  .bm-manual-line strong,
  .bm-manual-action strong {
    display: block;
    margin-bottom: 2px;
  }

  .bm-manual-line > div:last-child,
  .bm-manual-action,
  .bm-manual-section p {
    min-width: 0;
  }

  .bm-manual-line span,
  .bm-manual-action span {
    overflow-wrap: anywhere;
    color: var(--bm-muted);
    line-height: 1.45;
  }

  .bm-manual-actions-grid {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
  }

  .bm-manual-action {
    padding: 14px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.08);
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.025));
  }

  .bm-manual-state-grid {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 10px;
  }

  .bm-manual-state-card {
    min-width: 0;
    padding: 14px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.08);
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.025));
    display: grid;
    gap: 8px;
  }

  .bm-manual-state-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .bm-manual-state-label {
    color: var(--bm-text);
    font-weight: 700;
  }

  .bm-manual-state-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(245, 200, 107, 0.08);
    border: 1px solid rgba(245, 200, 107, 0.18);
    color: var(--bm-gold);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .bm-manual-state-copy {
    color: var(--bm-muted);
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .bm-manual-role-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .bm-manual-role-icon {
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
    border-radius: 22px;
    font-size: 2rem;
    border: 1px solid rgba(245, 200, 107, 0.24);
    background: linear-gradient(145deg, rgba(245, 200, 107, 0.14), rgba(127, 29, 29, 0.14));
  }

  .bm-manual-role-name {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .bm-manual-role-chip {
    margin-top: 4px;
    display: inline-flex;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,0.07);
    color: var(--bm-gold);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .bm-ceremony-card {
    width: min(540px, 100%);
    padding: 24px 24px 22px;
    border-radius: 28px;
    border: 1px solid rgba(245, 200, 107, 0.24);
    background: linear-gradient(145deg, rgba(12, 12, 14, 0.94), rgba(68, 33, 12, 0.86));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.44);
    text-align: center;
    transform: translateY(18px) scale(0.96);
    transition: transform 0.35s ease;
  }

  .bm-ceremony.active .bm-ceremony-card {
    transform: translateY(0) scale(1);
  }

  .bm-ceremony-card.bm-ceremony-red {
    border-color: rgba(248, 113, 113, 0.28);
    background: linear-gradient(145deg, rgba(12, 12, 14, 0.94), rgba(90, 20, 20, 0.88));
  }

  .bm-ceremony-kicker {
    color: var(--bm-gold);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bm-ceremony-title {
    margin-top: 10px;
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    line-height: 1.15;
  }

  .bm-ceremony-copy {
    margin-top: 10px;
    color: var(--bm-muted);
    font-size: 0.96rem;
  }

  .bm-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
    gap: 20px;
    padding: 22px;
  }

  .bm-col {
    display: grid;
    gap: 20px;
    min-width: 0;
  }

  .bm-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--bm-line);
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02)),
      var(--bm-panel);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 18px 42px rgba(0, 0, 0, 0.24);
    padding: 20px;
    transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .bm-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245, 200, 107, 0.2), transparent);
    opacity: 0.75;
  }

  .bm-card:hover {
    transform: translateY(-1px);
    border-color: rgba(245, 200, 107, 0.16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 24px 54px rgba(0, 0, 0, 0.28);
  }

  .bm-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 16px;
  }

  .bm-card-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .bm-card-note {
    color: var(--bm-muted);
    font-size: 0.88rem;
  }

  .bm-role-wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
  }

  .bm-role-icon {
    width: 90px;
    height: 90px;
    display: grid;
    place-items: center;
    border-radius: 26px;
    border: 1px solid rgba(245, 200, 107, 0.24);
    background:
      radial-gradient(circle at 30% 30%, rgba(245, 200, 107, 0.16), transparent 58%),
      linear-gradient(145deg, rgba(245, 200, 107, 0.12), rgba(127, 29, 29, 0.16));
    box-shadow: inset 0 0 32px rgba(245, 200, 107, 0.08), 0 18px 32px rgba(0,0,0,0.22);
    font-size: 2.45rem;
  }

  .bm-role-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .bm-role-name {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .bm-role-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    color: var(--bm-gold);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .bm-role-copy {
    color: var(--bm-muted);
    line-height: 1.5;
  }

  .bm-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
  }

  .bm-stat {
    position: relative;
    padding: 13px 14px;
    border-radius: 20px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02)),
      var(--bm-panel-soft);
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .bm-stat-label {
    color: var(--bm-muted);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bm-stat-value {
    margin-top: 4px;
    font-family: 'Orbitron', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .bm-inventory {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }

  .bm-item {
    padding: 13px 14px;
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.025));
    border: 1px solid rgba(255,255,255,0.1);
    display: grid;
    gap: 6px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }

  .bm-item-name {
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bm-item-copy {
    color: var(--bm-muted);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .bm-market-grid,
  .bm-action-grid,
  .bm-players-grid,
  .bm-feed {
    display: grid;
    gap: 12px;
  }

  .bm-action-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .bm-guide-grid {
    display: grid;
    gap: 10px;
    counter-reset: guide-step;
  }

  .bm-guide-step {
    position: relative;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.1);
    background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.03));
    padding: 14px 14px 14px 52px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }

  .bm-guide-step::before {
    counter-increment: guide-step;
    content: counter(guide-step);
    position: absolute;
    left: 14px;
    top: 14px;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(245, 200, 107, 0.2), rgba(127, 29, 29, 0.3));
    border: 1px solid rgba(245, 200, 107, 0.24);
    color: var(--bm-gold);
    font-family: 'Orbitron', sans-serif;
    font-size: 0.72rem;
  }

  .bm-guide-step strong {
    display: block;
    margin-bottom: 4px;
  }

  .bm-market-grid,
  .bm-players-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .bm-offer,
  .bm-player,
  .bm-feed-item,
  .bm-intel-item,
  .bm-winner-card {
    border-radius: 22px;
    border: 1px solid rgba(255,255,255,0.1);
    background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.03));
    padding: 16px;
  }

  .bm-offer {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top right, rgba(245, 200, 107, 0.12), transparent 38%),
      linear-gradient(145deg, rgba(251,191,36,0.08), rgba(127,29,29,0.08));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 18px 32px rgba(0,0,0,0.16);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .bm-offer::after {
    content: '';
    position: absolute;
    inset: -30% auto auto -40%;
    width: 60%;
    height: 180%;
    transform: rotate(18deg);
    background: linear-gradient(180deg, rgba(255,255,255,0.12), transparent);
    opacity: 0.22;
    pointer-events: none;
  }

  .bm-offer:hover {
    transform: translateY(-3px);
    border-color: rgba(245, 200, 107, 0.22);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 22px 36px rgba(0,0,0,0.2);
  }

  .bm-offer-head,
  .bm-player-head,
  .bm-intel-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 10px;
  }

  .bm-offer-title,
  .bm-player-name {
    font-size: 1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bm-price,
  .bm-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(0,0,0,0.26);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bm-gold);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .bm-offer-copy,
  .bm-player-copy,
  .bm-feed-copy,
  .bm-empty {
    color: var(--bm-muted);
    line-height: 1.45;
  }

  .bm-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .bm-btn {
    border: 0;
    border-radius: 16px;
    padding: 11px 15px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--bm-text);
    background: linear-gradient(135deg, #9a3412, #7f1d1d);
    transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
  }

  .bm-btn.alt { background: rgba(255,255,255,0.1); }
  .bm-btn.gold { background: linear-gradient(135deg, #d97706, #92400e); }
  .bm-btn.green { background: linear-gradient(135deg, #047857, #065f46); }
  .bm-btn:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; }
  .bm-btn:not(:disabled):hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(0,0,0,0.24); }

  .bm-action-block {
    position: relative;
    padding: 15px;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.1);
    background:
      radial-gradient(circle at top left, rgba(245, 200, 107, 0.06), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.028));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .bm-action-block:hover {
    transform: translateY(-2px);
    border-color: rgba(245, 200, 107, 0.18);
  }

  .bm-action-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .bm-action-copy {
    color: var(--bm-muted);
    margin-bottom: 12px;
  }

  .bm-target-list,
  .bm-mini-grid,
  .bm-intel-grid,
  .bm-finished-actions {
    display: grid;
    gap: 8px;
  }

  .bm-target-list {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .bm-target-btn {
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    padding: 11px 13px;
    background: linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.03));
    color: var(--bm-text);
    text-align: left;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .bm-target-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(245, 200, 107, 0.18);
    background: linear-gradient(180deg, rgba(245, 200, 107, 0.08), rgba(255,255,255,0.03));
  }

  .bm-target-btn small {
    display: block;
    color: var(--bm-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .bm-player {
    display: grid;
    gap: 10px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .bm-player:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.14);
  }

  .bm-deal-item.win {
    border-color: rgba(245, 200, 107, 0.22);
    background: linear-gradient(145deg, rgba(217, 119, 6, 0.12), rgba(255, 255, 255, 0.04));
  }

  .bm-deal-item.betray {
    border-color: rgba(248, 113, 113, 0.22);
    background: linear-gradient(145deg, rgba(127, 29, 29, 0.2), rgba(255, 255, 255, 0.03));
  }

  .bm-player-self {
    border-color: rgba(245, 200, 107, 0.28);
    box-shadow: 0 0 0 1px rgba(245, 200, 107, 0.08);
  }

  .bm-player-dead {
    opacity: 0.55;
    filter: grayscale(0.18);
  }

  .bm-player-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .bm-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .bm-pill.dead { color: #fecaca; border-color: rgba(248,113,113,0.2); }
  .bm-pill.good { color: #d1fae5; border-color: rgba(110,231,183,0.2); }
  .bm-pill.warn { color: #fde68a; border-color: rgba(245,200,107,0.2); }

  .bm-feed-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  }

  .bm-feed-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: rgba(255,255,255,0.08);
    font-size: 1.1rem;
  }

  .bm-feed-tone-red .bm-feed-icon { background: rgba(127,29,29,0.45); }
  .bm-feed-tone-gold .bm-feed-icon { background: rgba(180,83,9,0.34); }
  .bm-feed-tone-blue .bm-feed-icon { background: rgba(30,64,175,0.34); }

  .bm-winner-card {
    background: linear-gradient(145deg, rgba(16, 185, 129, 0.16), rgba(180, 83, 9, 0.14));
    border-color: rgba(110, 231, 183, 0.25);
    box-shadow: 0 26px 44px rgba(0,0,0,0.22);
  }

  .bm-winner-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.18rem;
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }

  .bm-footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }

  @media (max-width: 980px) {
    .bm-grid {
      grid-template-columns: 1fr;
    }

    .bm-topbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .bm-top-meta {
      width: 100%;
      justify-content: flex-start;
    }

    .bm-top-meta .bm-chip {
      flex: 1 1 180px;
      justify-content: center;
    }

    .bm-manual-header {
      flex-direction: column;
    }

    .bm-manual-grid {
      grid-template-columns: 1fr;
    }

    .bm-announcer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .bm-page { padding: 8px; margin-top: 8px; }
    .bm-shell { border-radius: 24px; }
    .bm-topbar,
    .bm-grid,
    .bm-card { padding: 14px; }
    .bm-announcer { padding: 14px; }
    .bm-role-wrap { grid-template-columns: 1fr; }
    .bm-role-icon { width: 68px; height: 68px; border-radius: 18px; }
    .bm-topbar::after { left: 14px; right: 14px; }
    .bm-top-meta { gap: 6px; }
    .bm-top-meta .bm-chip { flex: 1 1 calc(50% - 6px); min-width: 0; padding-inline: 10px; }
    .bm-announcer-rails { grid-template-columns: 1fr; }
    .bm-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bm-action-grid { grid-template-columns: 1fr; }
    .bm-market-grid,
    .bm-players-grid,
    .bm-inventory,
    .bm-manual-actions-grid,
    .bm-manual-state-grid { grid-template-columns: 1fr; }
    .bm-offer,
    .bm-player,
    .bm-feed-item,
    .bm-intel-item,
    .bm-winner-card,
    .bm-manual-section,
    .bm-manual-action,
    .bm-manual-state-card { border-radius: 18px; }
    .bm-player-head,
    .bm-manual-role-head,
    .bm-manual-state-head { align-items: flex-start; }
    .bm-manual-header { margin-bottom: 14px; }
    .bm-guide-step { padding-left: 14px; }
    .bm-guide-step { padding-left: 14px; }
    .bm-guide-step::before { display: none; }
    .bm-tour-card {
      left: 12px !important;
      right: 12px !important;
      width: auto;
    }
    .bm-manual-overlay { padding: 10px; }
    .bm-manual-card { padding: 16px; border-radius: 24px; }
    .bm-manual-role-icon { width: 56px; height: 56px; font-size: 1.55rem; border-radius: 18px; }
    .bm-manual-role-name { font-size: 1.02rem; }
    .bm-manual-section { padding: 14px; }
    .bm-manual-section h3 { font-size: 0.92rem; }
    .bm-manual-copy { max-width: none; }
  }

  @media (max-width: 420px) {
    .bm-page { padding: 6px; }
    .bm-topbar,
    .bm-grid,
    .bm-card,
    .bm-manual-card { padding: 12px; }
    .bm-announcer { padding: 12px; }
    .bm-top-meta .bm-chip,
    .bm-tour-actions .bm-btn,
    .bm-btn-row .bm-btn { flex: 1 1 100%; width: 100%; }
    .bm-stats { grid-template-columns: 1fr; }
    .bm-pill { max-width: 100%; }
  }
</style>

<div class="bm-page">
  <div class="bm-shell">
    <div id="bmCeremonyOverlay" class="bm-ceremony" aria-live="polite">
      <div id="bmCeremonyCard" class="bm-ceremony-card bm-ceremony-gold">
        <div id="bmCeremonyKicker" class="bm-ceremony-kicker">🎩 เปิดโต๊ะ</div>
        <div id="bmCeremonyTitle" class="bm-ceremony-title">ยกใหม่กำลังเริ่ม</div>
        <div id="bmCeremonyCopy" class="bm-ceremony-copy">ล็อตใหม่กำลังขึ้นโต๊ะ</div>
      </div>
    </div>

    <div class="bm-topbar">
      <div class="bm-brand">
        <div class="bm-kicker">🎩 โต๊ะตลาดมืด</div>
        <div class="bm-title"><%= room.name %></div>
        <div class="bm-subtitle">คืนนี้มีแต่ของเถื่อน ข่าววงใน และคนพร้อมพลิกดีล</div>
      </div>
      <div class="bm-top-meta">
        <div class="bm-chip">🆔 <span><%= room.roomId %></span></div>
        <div class="bm-chip">👥 <span><%= room.playerCount %>/<%= room.maxPlayers %></span></div>
        <div id="phaseChip" class="bm-chip phase-market">🛒 เปิดตลาด</div>
        <div id="roundChip" class="bm-chip">🌒 ยก 1 / 5</div>
        <button id="bmHowToOpen" type="button" class="bm-chip">📖 วิธีเล่น</button>
        <button id="bmTourReplay" type="button" class="bm-chip">✨ พาทัวร์โต๊ะ</button>
        <button id="bmAudioToggle" type="button" class="bm-chip bm-audio-chip">🔇 เปิดเสียงพิธี</button>
      </div>
    </div>

    <div id="bmAnnouncerBar" class="bm-announcer" aria-live="polite"></div>

    <div class="bm-grid">
      <div class="bm-col">
        <div class="bm-card bm-card-role" data-tour-id="role">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">🎭 บทของคุณ</div>
              <div class="bm-card-note">ใช้สายของตัวเองหา 👑 ให้ถึงก่อนทุกคน</div>
            </div>
            <div id="selfStateChip" class="bm-tag">🫀 ยังอยู่</div>
          </div>
          <div id="rolePanel"></div>
        </div>

        <div class="bm-card bm-card-guide" data-tour-id="guide">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">🎓 พาเล่นโต๊ะนี้</div>
              <div class="bm-card-note">สรุปว่ากดยังไง ใช้อะไร แล้วผลของแต่ละแอ็กชันคืออะไร</div>
            </div>
          </div>
          <div id="guidePanel"></div>
        </div>

        <div class="bm-card bm-card-stage" data-tour-id="stage">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">🛒 ตลาดกับแผนลงมือ</div>
              <div class="bm-card-note">ล็อกของก่อน แล้วค่อยตัดสินใจว่าจะส่งของ ปล้น สืบ หรือสั่งเก็บ</div>
            </div>
          </div>
          <div id="mainStage"></div>
        </div>

        <div class="bm-card bm-card-history">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">📢 ข่าวใต้ดิน</div>
              <div class="bm-card-note">โต๊ะนี้จำทุกจังหวะที่เกิดขึ้นในตลาดมืด</div>
            </div>
          </div>
          <div id="historyFeed" class="bm-feed"></div>
        </div>
      </div>

      <div class="bm-col">
        <div class="bm-card bm-card-roster" data-tour-id="players">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">👥 คนบนโต๊ะ</div>
              <div class="bm-card-note">ใครทุนหนา ใครค่าหัวขึ้น ใครเริ่มน่ากลัว</div>
            </div>
          </div>
          <div id="playersPanel" class="bm-players-grid"></div>
        </div>

        <div class="bm-card bm-card-deals" data-tour-id="deals">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">🤝 ดีลบนโต๊ะ</div>
              <div class="bm-card-note">ใครปิดดีลสำเร็จ ใครโดนหักหลัง จะขึ้นตรงนี้</div>
            </div>
          </div>
          <div id="dealPanel" class="bm-intel-grid"></div>
        </div>

        <div class="bm-card bm-card-intel">
          <div class="bm-card-header">
            <div>
              <div class="bm-card-title">🕶️ ข่าวที่คีบมาได้</div>
              <div class="bm-card-note">เฉพาะข่าวลับที่สายของคุณขุดกลับมา</div>
            </div>
          </div>
          <div id="intelPanel" class="bm-intel-grid"></div>
        </div>

        <div id="winnerPanel" class="bm-card" style="display:none;"></div>
      </div>
    </div>
  </div>

  <div id="bmTourOverlay" class="bm-tour-overlay" aria-hidden="true">
    <div id="bmTourCard" class="bm-tour-card" role="dialog" aria-modal="true" aria-live="polite" aria-label="Black Market onboarding" tabindex="-1">
      <div id="bmTourKicker" class="bm-tour-kicker">Spotlight</div>
      <div id="bmTourTitle" class="bm-tour-title"></div>
      <div id="bmTourCopy" class="bm-tour-copy"></div>
      <div id="bmTourProgress" class="bm-tour-progress"></div>
      <div class="bm-tour-actions">
        <button id="bmTourPrev" type="button" class="bm-btn bm-tour-ghost">ย้อนกลับ</button>
        <button id="bmTourSkip" type="button" class="bm-btn bm-tour-ghost">ข้าม</button>
        <button id="bmTourNext" type="button" class="bm-btn gold">ถัดไป</button>
      </div>
    </div>
  </div>

  <div id="bmHowToOverlay" class="bm-manual-overlay" aria-hidden="true">
    <div id="bmHowToCard" class="bm-manual-card" role="dialog" aria-modal="true" aria-labelledby="bmHowToTitle" tabindex="-1">
      <div class="bm-manual-header">
        <div>
          <div class="bm-manual-kicker">📖 คู่มือโต๊ะตลาดมืด</div>
          <div id="bmHowToTitle" class="bm-manual-title">วิธีเดินเกมคืนนี้</div>
          <div class="bm-manual-copy">อ่านภาพรวมของโต๊ะก่อน แล้วค่อยดูหัวข้อเฉพาะบทของคุณ จะช่วยให้ตัดสินใจได้ไวขึ้นเวลาโต๊ะเริ่มร้อน</div>
        </div>
        <button id="bmHowToClose" type="button" class="bm-btn alt">ปิดคู่มือ</button>
      </div>
      <div class="bm-manual-grid">
        <div id="bmHowToOverview" class="bm-manual-column"></div>
        <div id="bmHowToRole" class="bm-manual-column"></div>
      </div>
    </div>
  </div>
</div>

<%- contentFor('script') %>
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  $(function() {
    const socket = io();
    const roomId = '<%= room.roomId %>';
    const playerId = '<%= player.playerId %>';
    const isRoomAdmin = <%= room.admin === true ? 'true' : 'false' %>;
    let currentState = <%- JSON.stringify(typeof blackMarketState !== 'undefined' ? blackMarketState : {}) %>;
    let allowNavigation = false;
    let hasRenderedOnce = false;
    let ceremonyTimer = null;
    let audioContext = null;
    let audioEnabled = false;
    let spotlightActive = false;
    let spotlightStepIndex = 0;
    let spotlightStarted = false;
    let spotlightRestoreFocus = null;
    let howToActive = false;
    let howToRestoreFocus = null;

    const spotlightKey = `blackmarket-tour-v2:${playerId}`;
    const rolePlaybooks = {
      boss: {
        opening: [
          'ถ้าเปิดตลาดแล้วเห็นของแต้มดี รีบกวาดไว้ก่อน เพราะบทนี้กินอิทธิพลจากการส่งของได้แรงกว่าคนอื่น',
          'ต้นเกมยังไม่ต้องเปิดศึกทุกยก เก็บของให้พร้อมก่อนแล้วค่อยเร่งแต้มตอนโต๊ะเริ่มหันไปไล่กันเอง'
        ],

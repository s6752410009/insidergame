    function closeHowTo() {
      howToActive = false;
      $('#bmHowToOverlay').removeClass('active').attr('aria-hidden', 'true');
      if (howToRestoreFocus && typeof howToRestoreFocus.focus === 'function') {
        howToRestoreFocus.focus({ preventScroll: true });
      }
      howToRestoreFocus = null;
    }

    function openHowTo() {
      howToRestoreFocus = document.activeElement;
      howToActive = true;
      renderHowToPlay();
      $('#bmHowToOverlay').addClass('active').attr('aria-hidden', 'false');
      focusHowToCard();
    }

    function focusSpotlightCard() {
      const card = document.getElementById('bmTourCard');
      if (card) {
        card.focus({ preventScroll: true });
      }
    }

    function ensureSpotlightTargetVisible(target) {
      if (!target) {
        return;
      }

      const rect = target.getBoundingClientRect();
      const padding = 24;
      const needsScroll = rect.top < padding || rect.bottom > window.innerHeight - padding;
      if (needsScroll) {
        target.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'smooth' });
      }
    }

    function closeSpotlight(markSeen) {
      spotlightActive = false;
      document.querySelectorAll('.bm-tour-focus').forEach(function(node) {
        node.classList.remove('bm-tour-focus');
      });
      $('#bmTourOverlay').removeClass('active').attr('aria-hidden', 'true');
      if (spotlightRestoreFocus && typeof spotlightRestoreFocus.focus === 'function') {
        spotlightRestoreFocus.focus({ preventScroll: true });
      }
      spotlightRestoreFocus = null;
      if (markSeen) {
        markSpotlightSeen();
      }
    }

    function positionSpotlight() {
      if (!spotlightActive) {
        return;
      }

      const step = spotlightSteps[spotlightStepIndex];
      const target = document.querySelector(step.target);
      if (!target) {
        closeSpotlight(true);
        return;
      }

      document.querySelectorAll('.bm-tour-focus').forEach(function(node) {
        if (node !== target) {
          node.classList.remove('bm-tour-focus');
        }
      });
      target.classList.add('bm-tour-focus');

      const rect = target.getBoundingClientRect();
      const cardWidth = Math.min(360, window.innerWidth - 24);
      const preferBelow = rect.bottom + 18 + 220 < window.innerHeight;
      const cardTop = preferBelow
        ? Math.min(window.innerHeight - 220, rect.bottom + 18)
        : Math.max(12, rect.top - 210);
      const cardLeft = Math.min(
        Math.max(12, rect.left),
        Math.max(12, window.innerWidth - cardWidth - 12)
      );

      $('#bmTourCard').css({
        top: `${cardTop}px`,
        left: `${cardLeft}px`
      });
    }

    function renderSpotlightStep() {
      const step = spotlightSteps[spotlightStepIndex];
      
      // Auto-switch mobile tabs during spotlight tour if visible
      if ($('.bm-mobile-tabs').is(':visible')) {
        if (step.target === '[data-tour-id="role"]' || step.target === '[data-tour-id="guide"]' || step.target === '[data-tour-id="stage"]') {
          $('.bm-mobile-tab-btn[data-tab="game"]').addClass('active');
          $('.bm-mobile-tab-btn[data-tab="players"], .bm-mobile-tab-btn[data-tab="history"]').removeClass('active');
          applyMobileTabs();
        } else if (step.target === '[data-tour-id="players"]' || step.target === '[data-tour-id="deals"]') {
          $('.bm-mobile-tab-btn[data-tab="players"]').addClass('active');
          $('.bm-mobile-tab-btn[data-tab="game"], .bm-mobile-tab-btn[data-tab="history"]').removeClass('active');
          applyMobileTabs();
        }
      }

      // Auto-expand guide panel if targeted during tour
      if (step.target === '[data-tour-id="guide"]') {
        guideExpanded = true;
        renderGuide();
      }

      const target = document.querySelector(step.target);
      ensureSpotlightTargetVisible(target);
      $('#bmTourKicker').text(`${step.kicker} • พาเล่นตลาดมืด`);
      $('#bmTourTitle').text(step.title);
      $('#bmTourCopy').text(step.copy);
      $('#bmTourPrev').prop('disabled', spotlightStepIndex === 0);
      $('#bmTourNext').text(spotlightStepIndex === spotlightSteps.length - 1 ? 'เริ่มเล่น' : 'ถัดไป');
      renderSpotlightProgress();
      window.setTimeout(function() {
        positionSpotlight();
        focusSpotlightCard();
      }, target ? 160 : 0);
    }

    function openSpotlight(forceOpen) {
      if (!forceOpen && hasSeenSpotlight()) {
        return;
      }

      spotlightRestoreFocus = document.activeElement;
      spotlightActive = true;
      spotlightStepIndex = 0;
      $('#bmTourOverlay').addClass('active').attr('aria-hidden', 'false');
      renderSpotlightStep();
    }

    function maybeStartSpotlight() {
      if (spotlightStarted || !currentState || !currentState.playerRole || !currentState.playerRole.id) {
        return;
      }
      spotlightStarted = true;
      window.setTimeout(function() {
        openSpotlight(false);
      }, 500);
    }


    socket.emit('setRoom', { roomId, playerId });
    requestState();

    const blackMarketChat = window.initChatPanel({ socket, playerId, playerName });
    (initialChatHistory || []).forEach(function(entry) {
      blackMarketChat?.appendMessage(entry, { silent: true });
    });

    socket.on('connect', function() {
      socket.emit('initPlayer', playerId);
      socket.emit('setRoom', { roomId, playerId });
      requestState();
    });

    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'visible' && socket.connected) {
        socket.emit('checkRoomStatus', { roomId, playerId });
        requestState();
      }
    });

    socket.on('tableAbandoned', function(payload) {
      allowNavigation = true;
      Swal.fire({
        icon: 'info',
        title: 'เกมถูกรีเซ็ต',
        text: (payload && payload.message) || 'ไม่มีผู้เล่นออนไลน์นานเกินไป',
        background: '#111',
        color: '#fff'
      }).then(function() {
        window.location.href = '/room/' + roomId + '?playerId=' + playerId;
      });
    });

    const bmEndGameBtn = document.getElementById('bmEndGameBtn');
    if (bmEndGameBtn) {
      bmEndGameBtn.addEventListener('click', function() {
        Swal.fire({
          title: '⏹ จบเกม?',
          text: 'รีเซ็ตเกมและลบผู้เล่นที่หลุดออกจากห้อง',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonText: 'จบเกม',
          cancelButtonText: 'ยกเลิก',
          background: '#111',
          color: '#fff'
        }).then(function(result) {
          if (!result.isConfirmed) return;
          socket.emit('endTableSession', { roomId, playerId }, function(response) {
            if (response && response.success) {
              allowNavigation = true;
              window.location.href = response.roomClosed
                ? '/rooms?playerId=' + playerId
                : '/room/' + roomId + '?playerId=' + playerId;
              return;
            }
            Swal.fire({ icon: 'error', title: 'จบเกมไม่สำเร็จ', text: response?.error || 'ลองอีกครั้ง', background: '#111', color: '#fff' });
          });
        });
      });
    }

    socket.on('blackmarketState', function(state) {
      renderState(state);
    });

    socket.on('restartGame', function() {
      allowNavigation = true;
      window.location.href = '/room/' + roomId + '?playerId=' + playerId;
    });

    socket.on('kickedFromRoom', function(data) {
      allowNavigation = true;
      Swal.fire({ icon: 'error', title: 'โดนเคลียร์ออกจากห้อง', text: data?.message || data?.reason || 'คืนนี้โต๊ะนี้ไม่รับคุณแล้ว', background: '#111', color: '#fff' })
        .then(() => { window.location.href = '/rooms?playerId=' + playerId; });
    });

    socket.on('roomClosed', function(data) {
      allowNavigation = true;
      Swal.fire({ icon: 'warning', title: 'โต๊ะถูกปิด', text: data?.message || 'ห้องนี้ถูกพับเก็บไปแล้ว', background: '#111', color: '#fff' })
        .then(() => { window.location.href = '/rooms?playerId=' + playerId; });
    });


    $(document).on('click', '#bmAnnouncerToggle', function() {
      announcerExpanded = !announcerExpanded;
      renderAnnouncer(getRolePlaybook());
    });

    $(document).on('click', '#bmToggleAdvanced', function() {
      showAdvancedActions = !showAdvancedActions;
      renderMainStage();
    });

    $(document).on('click', '#bmNowBarGo', function() {
      // มือถือ: สลับไปแท็บ "เล่นยกนี้" ก่อน แล้วค่อยเลื่อนไปการ์ดลงมือ
      const $gameTab = $('.bm-mobile-tab-btn[data-tab="game"]');
      if ($gameTab.length && !$gameTab.hasClass('active')) {
        $gameTab.trigger('click');
      }
      const stage = document.getElementById('mainStage');
      if (stage) {
        const card = stage.closest('.bm-card') || stage;
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('bm-stage-flash');
        setTimeout(function() { card.classList.remove('bm-stage-flash'); }, 1200);
      }
    });

    $(document).on('click', '.bm-simple-btn[data-simple]', function() {
      const mode = $(this).attr('data-simple');
      const self = getSelf();
      if (self.pendingAction) {
        return;
      }
      const cargoItems = (currentState.actionHelp || {}).cargoItems || [];
      if (mode === 'pass') {
        submitAction('pass', null, null);
        return;
      }
      if (mode === 'deliver') {
        if (!cargoItems.length) {
          return;
        }
        if (cargoItems.length === 1) {
          submitAction('deliver', null, cargoItems[0].id);
          simplePickMode = null;
          return;
        }
        simplePickMode = 'deliver';
        renderMainStage();
        return;
      }
      if (mode === 'intel') {
        if (!getAliveTargets().length) {
          return;
        }
        simplePickMode = 'intel';
        renderMainStage();
      }
    });

    $(document).on('click', '.bm-simple-pick-btn', function() {
      const action = $(this).attr('data-pick-action');
      const targetId = $(this).attr('data-target-player-id') || null;
      const itemId = $(this).attr('data-item-id') || null;
      simplePickMode = null;
      submitAction(action, targetId, itemId);
    });

    $(document).on('click', '[data-simple-cancel]', function() {
      simplePickMode = null;
      renderMainStage();
    });

    $(document).on('click', '.offer-buy', function() {
      submitMarketChoice($(this).attr('data-item-id'));
    });

    $(document).on('click', '.action-submit', function() {
      submitAction(
        $(this).attr('data-action-type'),
        $(this).attr('data-target-player-id') || null,
        $(this).attr('data-item-id') || null
      );
    });

    $(document).on('click', '#restartBlackMarket', function() {
      socket.emit('blackmarket_restartGame', { roomId }, function(response) {
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'ยังเปิดโต๊ะใหม่ไม่ได้', text: response?.error || 'ลองอีกครั้ง', background: '#111', color: '#fff' });
        }
      });
    });

    $(document).on('click', '#bmAudioToggle', function() {
      unlockAudio();
    });

    $(document).on('click', '#bmHowToOpen', function() {
      openHowTo();
    });

    $(document).on('click', '#bmHowToClose', function() {
      closeHowTo();
    });

    $(document).on('click', '#bmHowToOverlay', function(event) {
      if (event.target.id === 'bmHowToOverlay') {
        closeHowTo();
      }
    });

    $(document).on('click', '.bm-manual-tab-btn', function() {
      const tab = $(this).data('tab');
      $('.bm-manual-tab-btn').removeClass('active').css({ 'background': 'transparent', 'color': '#aaa' });
      $(this).addClass('active').css({ 'background': 'rgba(255,255,255,0.1)', 'color': '#fff' });
      if (tab === 'guide') {
        $('#bmManualTabGuide').show();
        $('#bmManualTabExample').hide();
      } else {
        $('#bmManualTabGuide').hide();
        $('#bmManualTabExample').show();
      }
    });

    $(document).on('click', '#bmTourReplay', function() {
      openSpotlight(true);
    });

    $(document).on('click', '#bmTourSkip', function() {
      closeSpotlight(true);
    });

    $(document).on('click', '#bmTourPrev', function() {
      if (spotlightStepIndex <= 0) {
        return;
      }
      spotlightStepIndex -= 1;
      renderSpotlightStep();
    });

    $(document).on('click', '#bmTourNext', function() {
      if (spotlightStepIndex >= spotlightSteps.length - 1) {
        closeSpotlight(true);
        return;
      }
      spotlightStepIndex += 1;
      renderSpotlightStep();
    });

    $(document).on('click', '#backToBlackMarketLobby', function() {
      allowNavigation = true;
      window.location.href = '/room/' + roomId + '?playerId=' + playerId;
    });

    $(window).on('resize', function() {
      positionSpotlight();
      applyMobileTabs();
    });

    $(document).on('click', '.bm-mobile-tab-btn', function() {
      $('.bm-mobile-tab-btn').removeClass('active');
      $(this).addClass('active');
      applyMobileTabs();
    });

    $(document).on('click', '#toggleGuideBtn', function() {
      guideExpanded = !guideExpanded;
      if (guideExpanded) {
        $('#guideContent').slideDown(200);
        $('#guideToggleChevron').text('▲');
      } else {
        $('#guideContent').slideUp(200);
        $('#guideToggleChevron').text('▼');
      }
    });

    // Mobile accordion: manual sections (h3 header)
    $(document).on('click', '#bmHowToCard .bm-manual-section h3', function() {
      if (window.innerWidth > 640) return;
      const section = $(this).closest('.bm-manual-section');
      const body = section.find('.bm-manual-section-body');
      const isOpen = section.hasClass('is-open');
      section.toggleClass('is-open', !isOpen);
      if (isOpen) {
        body.slideUp(200);
      } else {
        body.slideDown(200);
      }
    });

    // Mobile accordion: action blocks
    $(document).on('click', '.bm-action-block .bm-action-title', function() {
      if (window.innerWidth > 640) return;
      const block = $(this).closest('.bm-action-block');
      const body = block.find('.bm-action-body');
      const isOpen = block.hasClass('is-open');
      block.toggleClass('is-open', !isOpen);
      if (isOpen) {
        body.slideUp(200);
      } else {
        body.slideDown(200);
      }
    });

    function applyMobileTabs() {
      if ($('.bm-mobile-tabs').is(':visible')) {
        const activeTab = $('.bm-mobile-tab-btn.active').attr('data-tab') || 'game';
        if (activeTab === 'game') {
          $('.bm-card-role').show();
          $('.bm-card-guide').show();
          $('.bm-card-stage').show();
          $('.bm-card-roster').hide();
          $('.bm-card-deals').hide();
          $('.bm-card-intel').hide();
          $('.bm-card-history').hide();
          $('#winnerPanel').show();
        } else if (activeTab === 'players') {
          $('.bm-card-role').hide();
          $('.bm-card-guide').hide();
          $('.bm-card-stage').hide();
          $('.bm-card-roster').show();
          $('.bm-card-deals').show();
          $('.bm-card-intel').show();
          $('.bm-card-history').hide();
          $('#winnerPanel').hide();
        } else if (activeTab === 'history') {
          $('.bm-card-role').hide();
          $('.bm-card-guide').hide();
          $('.bm-card-stage').hide();
          $('.bm-card-roster').hide();
          $('.bm-card-deals').hide();
          $('.bm-card-intel').hide();
          $('.bm-card-history').show();
          $('#winnerPanel').hide();
        }
      } else {
        $('.bm-card-role').show();
        $('.bm-card-guide').show();
        $('.bm-card-stage').show();
        $('.bm-card-roster').show();
        $('.bm-card-deals').show();
        $('.bm-card-intel').show();
        $('.bm-card-history').show();
        $('#winnerPanel').show();
      }
    }

    $(window).on('scroll', function() {
      positionSpotlight();
    });

    $(document).on('keydown', function(event) {
      if (howToActive && event.key === 'Escape') {
        event.preventDefault();
        closeHowTo();
        return;
      }

      if (!spotlightActive) {
        return;
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        closeSpotlight(true);
        return;
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        if (spotlightStepIndex > 0) {
          spotlightStepIndex -= 1;
          renderSpotlightStep();
        }
        return;
      }

      if (['ArrowRight', 'Enter', ' '].includes(event.key)) {
        event.preventDefault();
        if (spotlightStepIndex >= spotlightSteps.length - 1) {
          closeSpotlight(true);
          return;
        }
        spotlightStepIndex += 1;
        renderSpotlightStep();
      }
    });

    document.addEventListener('pointerdown', function() {
      if (!audioEnabled) {
        unlockAudio().catch(function() {});
      }
    }, { once: true });

    window.addEventListener('beforeunload', function(e) {
      if (allowNavigation) {
        return undefined;
      }
      e.preventDefault();
      e.returnValue = 'จะทิ้งโต๊ะนี้ไว้จริงหรือ?';
      return e.returnValue;
    });

    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'visible') {
        requestState();
      }
    });
  });
</script>

    function ensureAudioContext() {
      const AudioCtor = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtor) {
        return null;
      }
      if (!audioContext) {
        audioContext = new AudioCtor();
      }
      return audioContext;
    }

    function updateAudioToggle() {
      $('#bmAudioToggle')
        .toggleClass('live', audioEnabled)
        .text(audioEnabled ? '🔊 เสียงพิธีพร้อม' : '🔇 เปิดเสียงพิธี');
    }

    async function unlockAudio() {
      const context = ensureAudioContext();
      if (!context) {
        return false;
      }

      if (context.state === 'suspended') {
        await context.resume();
      }

      audioEnabled = context.state === 'running';
      updateAudioToggle();
      return audioEnabled;
    }

    function playTone(context, frequency, startAt, duration, type, gainValue) {
      const oscillator = context.createOscillator();
      const gain = context.createGain();
      oscillator.type = type;
      oscillator.frequency.setValueAtTime(frequency, startAt);
      gain.gain.setValueAtTime(0.0001, startAt);
      gain.gain.exponentialRampToValueAtTime(gainValue, startAt + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, startAt + duration);
      oscillator.connect(gain);
      gain.connect(context.destination);
      oscillator.start(startAt);
      oscillator.stop(startAt + duration + 0.03);
    }

    function playCeremony(kind) {
      if (!audioEnabled) {
        return;
      }

      const context = ensureAudioContext();
      if (!context) {
        return;
      }

      const baseTime = context.currentTime + 0.02;
      if (kind === 'close') {
        [[392, 0, 0.16], [523.25, 0.12, 0.2], [659.25, 0.24, 0.24], [783.99, 0.38, 0.32]].forEach(function(step) {
          playTone(context, step[0], baseTime + step[1], step[2], 'sawtooth', 0.08);
        });
        return;
      }

      [[523.25, 0, 0.14], [659.25, 0.1, 0.16], [783.99, 0.22, 0.24]].forEach(function(step) {
        playTone(context, step[0], baseTime + step[1], step[2], 'triangle', 0.06);
      });
    }

    function showCeremony(options) {
      clearTimeout(ceremonyTimer);
      const tone = options?.tone === 'red' ? 'red' : 'gold';
      $('#bmCeremonyCard')
        .removeClass('bm-ceremony-gold bm-ceremony-red')
        .addClass(tone === 'red' ? 'bm-ceremony-red' : 'bm-ceremony-gold');
      $('#bmCeremonyKicker').text(options?.kicker || '🎩 เปิดโต๊ะ');
      $('#bmCeremonyTitle').text(options?.title || 'ยกใหม่กำลังเริ่ม');
      $('#bmCeremonyCopy').text(options?.copy || 'ล็อตใหม่กำลังขึ้นโต๊ะ');
      $('#bmCeremonyOverlay').addClass('active');
      playCeremony(options?.sound || 'open');
      ceremonyTimer = window.setTimeout(function() {
        $('#bmCeremonyOverlay').removeClass('active');
      }, Number(options?.duration || 2200));
    }

    function handleCeremony(previousState, nextState) {
      if (!nextState) {
        return;
      }

      if (!hasRenderedOnce) {
        hasRenderedOnce = true;
        if (nextState.phase === 'finished' && nextState.winner) {
          showCeremony({
            kicker: '👑 ปิดโต๊ะ',
            title: `${nextState.winner.avatar || '🎩'} ${nextState.winner.name || 'มีคนคุมเมืองแล้ว'}`,
            copy: nextState.winner.reason || 'คืนนี้มีคนยึดโต๊ะนี้ไปแล้ว',
            tone: 'red',
            sound: 'close',
            duration: 3200
          });
        } else if (nextState.phase === 'market' && Number(nextState.roundNumber || 0) > 0) {
          showCeremony({
            kicker: `🌒 เปิดยก ${Number(nextState.roundNumber || 0)}`,
            title: 'ล็อตใหม่ขึ้นโต๊ะแล้ว',
            copy: 'เลือกของให้ไว ก่อนดีลและมีดจะเริ่มเดิน',
            tone: 'gold',
            sound: 'open'
          });
        }
        return;
      }

      const previousRound = Number(previousState?.roundNumber || 0);
      const nextRound = Number(nextState.roundNumber || 0);
      if (nextState.phase === 'market' && nextRound > previousRound) {
        showCeremony({
          kicker: `🌒 เปิดยก ${nextRound}`,
          title: 'ของใหม่ลงโต๊ะแล้ว',
          copy: 'ยกนี้จะเปิดดีลหรือจะชักมีด ก็ล็อกให้ทันก่อนตลาดปิด',
          tone: 'gold',
          sound: 'open'
        });
      }

      if (previousState?.phase !== 'finished' && nextState.phase === 'finished' && nextState.winner) {
        showCeremony({
          kicker: '👑 ปิดโต๊ะ',
          title: `${nextState.winner.avatar || '🎩'} ${nextState.winner.name || 'มีคนคุมเมืองแล้ว'}`,
          copy: nextState.winner.reason || 'คืนนี้มีคนยึดโต๊ะนี้ไปแล้ว',
          tone: 'red',
          sound: 'close',
          duration: 3200
        });
      }
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function phaseMeta(phase) {
      if (phase === 'market') {
        return { label: '🛒 เปิดตลาด', className: 'phase-market' };
      }
      if (phase === 'action') {
        return { label: '🎯 ลงมือ', className: 'phase-action' };
      }
      if (phase === 'finished') {
        return { label: '👑 ปิดโต๊ะ', className: 'phase-finished' };
      }
      return { label: '🎩 รอตั้งโต๊ะ', className: 'phase-market' };
    }


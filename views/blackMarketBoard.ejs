          </div>
          <div class="bm-guide-step">
            <strong>ข้อควรจำ</strong>
            <div class="bm-intel-grid">
              ${(tutorial.reminders || []).map(line => `<div class="bm-card-note">• ${escapeHtml(line)}</div>`).join('')}
            </div>
          </div>
        </div>
      `);
    }

    function renderMainStage() {
      if (currentState.phase === 'market') {
        $('#mainStage').html(buildMarketStage());
        return;
      }

      if (currentState.phase === 'action') {
        $('#mainStage').html(buildActionStage());
        return;
      }

      if (currentState.phase === 'finished') {
        $('#mainStage').html('<div class="bm-empty">👑 โต๊ะปิดแล้ว ดูผลด้านขวาแล้วตัดสินใจว่าจะเปิดเมืองใหม่หรือกลับห้อง</div>');
        return;
      }

      $('#mainStage').html('<div class="bm-empty">รอสัญญาณจากโต๊ะ</div>');
    }

    function renderPlayers() {
      const html = (currentState.players || []).map(player => `
        <div class="bm-player ${player.isSelf ? 'bm-player-self' : ''} ${player.alive ? '' : 'bm-player-dead'}">
          <div class="bm-player-head">
            <div class="bm-player-name">${escapeHtml(player.avatar)} ${escapeHtml(player.name)}</div>
            <div class="bm-tag">${escapeHtml(player.roleIcon)} ${escapeHtml(player.roleTitle)}</div>
          </div>
          <div class="bm-player-copy">${player.alive ? 'ยังอยู่ในเกม' : 'หลุดจากโต๊ะแล้ว'}${player.isSelf ? ' • นี่คือตัวคุณ' : ''}</div>
          <div class="bm-player-stats">
            <div class="bm-pill good">👑 ${Number(player.influence || 0)}</div>
            <div class="bm-pill">💵 ${Number(player.cash || 0)}</div>
            <div class="bm-pill warn">🔥 ${Number(player.heat || 0)}</div>
            <div class="bm-pill ${player.alive ? '' : 'dead'}">🎒 ${Number(player.inventoryCount || 0)}</div>
          </div>
        </div>
      `).join('');
      $('#playersPanel').html(html || '<div class="bm-empty">โต๊ะยังว่าง</div>');
    }

    function renderIntel() {
      const notes = getSelf().intelNotes || [];
      $('#intelPanel').html(notes.length ? notes.map(note => `
        <div class="bm-intel-item">
          <div class="bm-intel-head">
            <div class="bm-player-name">🕶️ ข่าวยก ${Number(note.roundNumber || 0)}</div>
          </div>
          <div class="bm-player-copy">${escapeHtml(note.text || '')}</div>
        </div>
      `).join('') : '<div class="bm-empty">ยังไม่มีข่าวลับเข้ามือ</div>');
    }

    function renderDeals() {
      const pendingAction = getSelf().pendingAction;
      const notes = currentState.dealLedger || [];
      const pendingHtml = pendingAction && ['deal', 'betray'].includes(pendingAction.actionType)
        ? `<div class="bm-intel-item ${pendingAction.actionType === 'betray' ? 'bm-deal-item betray' : 'bm-deal-item win'}">
            <div class="bm-intel-head">
              <div class="bm-player-name">${pendingAction.actionType === 'betray' ? '🗡️ มีดคุณถูกล็อกแล้ว' : '🤝 คุณเปิดดีลไว้แล้ว'}</div>
            </div>
            <div class="bm-player-copy">${pendingAction.actionType === 'betray'
              ? 'ถ้าอีกฝ่ายกดเข้าดีลกลับมา การหักหลังจะทำงานทันทีตอนปิดยก'
              : 'ดีลนี้จะปิดเมื่ออีกฝ่ายกดเข้าดีลกลับมาหาคุณในยกเดียวกัน'}</div>
          </div>`
        : '';

      const ledgerHtml = notes.length ? notes.map(note => `
        <div class="bm-intel-item bm-deal-item ${note.tone === 'red' ? 'betray' : 'win'}">
          <div class="bm-intel-head">
            <div class="bm-player-name">${escapeHtml(note.icon || '🤝')} ดีลยก ${Number(note.roundNumber || 0)}</div>
          </div>
          <div class="bm-player-copy">${escapeHtml(note.text || '')}</div>
        </div>
      `).join('') : '<div class="bm-empty">ยังไม่มีดีลแตกหรือหักหลังสำเร็จ</div>';

      $('#dealPanel').html(pendingHtml + ledgerHtml);
    }

    function renderHistory() {
      const history = currentState.history || [];
      $('#historyFeed').html(history.length ? history.map(entry => `
        <div class="bm-feed-item bm-feed-tone-${escapeHtml(entry.tone || 'neutral')}">
          <div class="bm-feed-icon">${escapeHtml(entry.icon || '📢')}</div>
          <div class="bm-feed-copy">${escapeHtml(entry.text || '')}</div>
        </div>
      `).join('') : '<div class="bm-empty">ข่าวยังไม่เดิน</div>');
    }

    function renderWinner() {
      const winner = currentState.winner;
      if (!winner) {
        $('#winnerPanel').hide().empty();
        return;
      }

      $('#winnerPanel').show().html(`
        <div class="bm-winner-card">
          <div class="bm-winner-title">👑 คนที่คุมเมืองคืนนี้</div>
          <div class="bm-player-name">${escapeHtml(winner.avatar || '🎩')} ${escapeHtml(winner.name || '-')}</div>
          <div class="bm-player-copy" style="margin-top:8px;">${escapeHtml(winner.roleTitle || '-') } • ${escapeHtml(winner.reason || '')}</div>
          <div class="bm-player-stats" style="margin-top:10px;">
            <div class="bm-pill good">👑 ${Number(winner.influence || 0)}</div>
            <div class="bm-pill">💵 ${Number(winner.cash || 0)}</div>
            <div class="bm-pill warn">🔥 ${Number(winner.heat || 0)}</div>
          </div>
          <div class="bm-footer-actions">
            ${isRoomAdmin ? '<button id="restartBlackMarket" class="bm-btn gold">🎩 เปิดเมืองใหม่</button>' : ''}
            <button id="backToBlackMarketLobby" class="bm-btn alt">🚪 กลับห้อง</button>
          </div>
        </div>
      `);
    }

    function renderState(state) {
      const previousState = currentState || {};
      currentState = state || {};
      const meta = phaseMeta(currentState.phase);
      const rolePlaybook = getRolePlaybook();
      $('#phaseChip').attr('class', `bm-chip ${meta.className}`).text(meta.label);
      $('#roundChip').text(`🌒 ยก ${Number(currentState.roundNumber || 0)} / ${Number(currentState.maxRounds || 5)}`);
      renderAnnouncer(rolePlaybook);
      renderRolePanel();
      renderGuide();
      renderMainStage();
      renderPlayers();
      renderDeals();
      renderIntel();
      renderHistory();
      renderWinner();
      if (howToActive) {
        renderHowToPlay();
      }
      handleCeremony(previousState, currentState);
      if (spotlightActive) {
        positionSpotlight();
      }
      maybeStartSpotlight();
    }

    function requestState() {
      socket.emit('blackmarket_requestState', { roomId, playerId });
    }

    function submitMarketChoice(itemId) {
      socket.emit('blackmarket_buyOffer', { roomId, playerId, itemId }, function(response) {
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'โต๊ะไม่ยอม', text: response?.error || 'ของชิ้นนี้ยังไม่ผ่าน', background: '#111', color: '#fff' });
        }
      });
    }

    function submitAction(actionType, targetPlayerId, itemId) {
      socket.emit('blackmarket_submitAction', { roomId, playerId, actionType, targetPlayerId, itemId }, function(response) {
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'งานยังไม่ผ่าน', text: response?.error || 'แผนนี้ยังล็อกไม่ได้', background: '#111', color: '#fff' });
        }
      });
    }

    updateAudioToggle();
    renderState(currentState);
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId, playerId });
    requestState();

    socket.on('reconnect', function() {
      socket.emit('initPlayer', playerId);
      socket.emit('setRoom', { roomId, playerId });
      requestState();
    });

    socket.on('blackmarketState', function(state) {
      renderState(state);
    });

    socket.on('restartGame', function() {
      allowNavigation = true;
      window.location.href = '/room/' + roomId + '?playerId=' + playerId;
    });

    socket.on('kickedFromRoom', function(data) {
      allowNavigation = true;
      Swal.fire({ icon: 'error', title: 'โดนเคลียร์ออกจากห้อง', text: data?.message || data?.reason || 'คืนนี้โต๊ะนี้ไม่รับคุณแล้ว', background: '#111', color: '#fff' })
        .then(() => { window.location.href = '/rooms?playerId=' + playerId; });
    });

    socket.on('roomClosed', function(data) {
      allowNavigation = true;
      Swal.fire({ icon: 'warning', title: 'โต๊ะถูกปิด', text: data?.message || 'ห้องนี้ถูกพับเก็บไปแล้ว', background: '#111', color: '#fff' })
        .then(() => { window.location.href = '/rooms?playerId=' + playerId; });
    });

    $(document).on('click', '.offer-buy', function() {
      submitMarketChoice($(this).attr('data-item-id'));
    });

    $(document).on('click', '.action-submit', function() {
      submitAction(
        $(this).attr('data-action-type'),
        $(this).attr('data-target-player-id') || null,
        $(this).attr('data-item-id') || null
      );
    });

    $(document).on('click', '#restartBlackMarket', function() {
      socket.emit('blackmarket_restartGame', { roomId }, function(response) {
        if (!response || !response.success) {
          Swal.fire({ icon: 'error', title: 'ยังเปิดโต๊ะใหม่ไม่ได้', text: response?.error || 'ลองอีกครั้ง', background: '#111', color: '#fff' });
        }
      });
    });

    $(document).on('click', '#bmAudioToggle', function() {
      unlockAudio();
    });

    $(document).on('click', '#bmHowToOpen', function() {
      openHowTo();
    });

    $(document).on('click', '#bmHowToClose', function() {
      closeHowTo();
    });

    $(document).on('click', '#bmHowToOverlay', function(event) {
      if (event.target.id === 'bmHowToOverlay') {
        closeHowTo();
      }
    });

    $(document).on('click', '#bmTourReplay', function() {
      openSpotlight(true);
    });

    $(document).on('click', '#bmTourSkip', function() {
      closeSpotlight(true);
    });

    $(document).on('click', '#bmTourPrev', function() {
      if (spotlightStepIndex <= 0) {
        return;
      }
      spotlightStepIndex -= 1;
      renderSpotlightStep();
    });

    $(document).on('click', '#bmTourNext', function() {
      if (spotlightStepIndex >= spotlightSteps.length - 1) {
        closeSpotlight(true);
        return;
      }
      spotlightStepIndex += 1;
      renderSpotlightStep();
    });

    $(document).on('click', '#backToBlackMarketLobby', function() {
      allowNavigation = true;
      window.location.href = '/room/' + roomId + '?playerId=' + playerId;
    });

    $(window).on('resize', function() {
      positionSpotlight();
    });

    $(window).on('scroll', function() {
      positionSpotlight();
    });

    $(document).on('keydown', function(event) {
      if (howToActive && event.key === 'Escape') {
        event.preventDefault();
        closeHowTo();
        return;
      }

      if (!spotlightActive) {
        return;
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        closeSpotlight(true);
        return;
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        if (spotlightStepIndex > 0) {
          spotlightStepIndex -= 1;
          renderSpotlightStep();
        }
        return;
      }

      if (['ArrowRight', 'Enter', ' '].includes(event.key)) {
        event.preventDefault();
        if (spotlightStepIndex >= spotlightSteps.length - 1) {
          closeSpotlight(true);
          return;
        }
        spotlightStepIndex += 1;
        renderSpotlightStep();
      }
    });

    document.addEventListener('pointerdown', function() {
      if (!audioEnabled) {
        unlockAudio().catch(function() {});
      }
    }, { once: true });

    window.addEventListener('beforeunload', function(e) {
      if (allowNavigation) {
        return undefined;
      }
      e.preventDefault();
      e.returnValue = 'จะทิ้งโต๊ะนี้ไว้จริงหรือ?';
      return e.returnValue;
    });

    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'visible') {
        requestState();
      }
    });
  });
</script>
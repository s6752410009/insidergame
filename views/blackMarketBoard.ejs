      const catalog = currentState.actionCatalog || [];
      const actionById = function(id) {
        return catalog.find(function(a) { return a.id === id; }) || { id: id, icon: '🎴', label: id };
      };

      if (!self.alive || currentState.winner) {
        return '<div class="bm-empty">คุณออกจากเกมแล้ว</div>';

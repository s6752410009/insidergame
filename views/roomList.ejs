                            ${[1,2,3].map(function(n, index) {
                                const active = n === 2;
                                return `<button type="button" data-wolf-count="${n}" class="wolf-count-btn${active ? ' active' : ''}" style="flex:1; padding:10px 0; border-radius:10px; border:2px solid ${active ? '#e74c3c' : 'rgba(255,255,255,0.12)'}; background:${active ? 'rgba(231,76,60,0.2)' : 'rgba(255,255,255,0.04)'}; color:#fff; font-size:1.1em; cursor:pointer; font-family:Rajdhani,sans-serif; font-weight:700;">🐺 ${n} ตัว</button>`;
                            }).join('')}
                        </div>
                        <div style="margin-top:8px; color:#aaa; font-size:0.9em;">บทบาทอื่นสุ่มให้อัตโนมัติทั้งหมด และระบบจะปรับจำนวนหมาป่าสูงสุดตามจำนวนผู้เล่นให้เองถ้าตั้งเกิน</div>
                        <div class="room-form-label" style="margin-top:14px;"><span class="icon">⏱️</span> เวลาแต่ละช่วง:</div>
                        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:4px;">
                            <select id="werewolfNightSeconds" aria-label="เวลากลางคืน" style="flex:1 1 100%; min-height:48px; padding:8px 10px; border-radius:10px; border:1px solid rgba(231,76,60,0.4); background:#1a2332; color:#fff; font:inherit;">
                                ${[45, 60, 90].map(function(v) { return '<option value="' + v + '"' + (v === 60 ? ' selected' : '') + '>🌙 คืน ' + v + ' วิ</option>'; }).join('')}
                            </select>
                            <select id="werewolfDaySeconds" aria-label="เวลาประชุม" style="flex:1 1 100%; min-height:48px; padding:8px 10px; border-radius:10px; border:1px solid rgba(231,76,60,0.4); background:#1a2332; color:#fff; font:inherit;">
                                ${[120, 180, 240, 300].map(function(v) { return '<option value="' + v + '"' + (v === 180 ? ' selected' : '') + '>☀️ ประชุม ' + (v / 60) + ' นาที</option>'; }).join('')}
                            </select>
                            <select id="werewolfVoteSeconds" aria-label="เวลาโหวต" style="flex:1 1 100%; min-height:48px; padding:8px 10px; border-radius:10px; border:1px solid rgba(231,76,60,0.4); background:#1a2332; color:#fff; font:inherit;">
                                ${[45, 60, 90].map(function(v) { return '<option value="' + v + '"' + (v === 60 ? ' selected' : '') + '>🗳️ โหวต ' + v + ' วิ</option>'; }).join('')}
                            </select>
                        </div>
                        <label style="display:flex; align-items:flex-start; gap:10px; margin-top:12px; min-height:48px; padding:10px 12px; border-radius:10px; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.04); color:#fff; cursor:pointer;">
                            <input type="checkbox" id="werewolfDeadSeeRoles" checked style="margin-top:3px; width:20px; height:20px; accent-color:#e74c3c;">
                            <span style="text-align:left;"><strong>👻 คนตายเห็นบททุกคน</strong><br><span style="color:#aaa; font-size:0.85em;">ถ้าเล่นต่อหน้ากัน คนที่ตายแล้วห้ามบอกใครเด็ดขาด</span></span>
                        </label>
                    </div>

                    <details class="room-advanced-details">
                    <summary>ปรับห้องเพิ่มเติม</summary>
                    <div class="room-advanced-body">
                    <div class="room-form-group">
                        <label class="room-form-label" for="maxPlayers">
                            <span class="icon">👥</span> จำนวนผู้เล่นสูงสุด:
                        </label>
                        <div class="room-slider-container">
                            <span class="room-slider-value" id="maxPlayersValue">5</span>
                            <input type="range" id="maxPlayers" class="room-slider" min="3" max="10" value="5">
                        </div>
                    </div>
                    
                    <div class="room-form-group" id="createRoundTimeGroup">
                        <label class="room-form-label" for="roundTime">
                            <span class="icon" id="roundTimeLabelIcon">⏱️</span> <span id="roundTimeLabelText">เวลาเล่นต่อรอบ:</span>
                        </label>
                        <div class="room-slider-container">
                            <span class="room-slider-value" id="roundTimeValue">5 นาที</span>
                            <input type="range" id="roundTime" class="room-slider" min="1" max="10" value="5">
                        </div>
                    </div>
                    
                    <div class="room-form-group">
                        <label class="room-form-label">
                            <span class="icon">🔐</span> ความปลอดภัย:
                        </label>
                        <div class="room-checkbox-container" id="lockedContainer">
                            <input type="checkbox" id="locked" class="room-checkbox" aria-label="ล็อคห้องและใช้รหัสผ่าน">
                            <div class="room-checkbox-custom">✓</div>
                            <span class="room-checkbox-text">🔒 ล็อคห้อง (ต้องใช้รหัสผ่าน)</span>
                        </div>
                    </div>

                    <div class="room-form-group" role="group" aria-labelledby="tableModeLabel">
                        <div class="room-form-label" id="tableModeLabel">
                            <span class="icon">🎮</span> รูปแบบการเล่น:
                        </div>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            <label style="flex:1; min-width:140px; display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:10px; border:2px solid rgba(245,200,107,0.45); background:rgba(245,200,107,0.08); cursor:pointer; color:#fff;">
                                <input type="radio" name="tableMode" value="inPerson" checked style="accent-color:#f5c86b;">
                                <span>🪑 เจอหน้า (ปิดจอได้)</span>
                            </label>
                            <label style="flex:1; min-width:140px; display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:10px; border:2px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.04); cursor:pointer; color:#ddd;">
                                <input type="radio" name="tableMode" value="remote" style="accent-color:#3498db;">
                                <span>📱 เล่นผ่านมือถือ</span>
                            </label>
                        </div>
                        <div style="margin-top:8px; color:#aaa; font-size:0.85em;">โหมดเจอหน้า: ปิดจอชั่วคราวได้ กลับมาภายใน ~2 นาทียังอยู่ที่เดิม ระบบล้างห้องค้างเร็วขึ้น</div>
                    </div>
                    
                    <div class="room-form-group" id="passwordGroup" style="display: none;">
                        <label class="room-form-label" for="password">
                            <span class="icon">🔑</span> รหัสผ่าน:
                        </label>
                        <input id="password" class="room-form-input" placeholder="รหัสผ่าน 4 หลัก" maxlength="4" pattern="[0-9]*" inputmode="numeric">
                    </div>
                    </div>
                    </details>
                    </div>
                </div>
            `,
            background: 'transparent',
            showCancelButton: true,
            confirmButtonText: '✅ สร้างห้อง',
            cancelButtonText: '❌ ยกเลิก',
            focusConfirm: false,
            didOpen: () => {
                // Slider handlers
                const maxPlayersSlider = document.getElementById('maxPlayers');
                const maxPlayersValue = document.getElementById('maxPlayersValue');
                const roundTimeSlider = document.getElementById('roundTime');
                const roundTimeValue = document.getElementById('roundTimeValue');
                const roundTimeLabelText = document.getElementById('roundTimeLabelText');
                const createRoundTimeGroup = document.getElementById('createRoundTimeGroup');
                const roomNameInput = document.getElementById('roomName');
                const selectedGameModeInput = document.getElementById('selectedGameMode');
                const modeQuickPickGrid = document.getElementById('modeQuickPickGrid');
                const modeSpotlight = document.getElementById('modeSpotlight');
                const pokerTableGroup = document.getElementById('pokerTableGroup');
                const pokerTableLabel = document.getElementById('pokerTableLabel');
                const pokerTableHint = document.getElementById('pokerTableHint');
                const pokerAnteSlider = document.getElementById('pokerAnte');
                const pokerAnteValue = document.getElementById('pokerAnteValue');
                const werewolfWolfCountGroup = document.getElementById('werewolfWolfCountGroup');
                const createWolfCountSelector = document.getElementById('createWolfCountSelector');
                const modeConfigById = gameModes.reduce((result, mode) => {
                    result[mode.id] = mode;
                    return result;
                }, {});
                let selectedGameMode = selectedGameModeInput.value || 'insider';
                selectedGameModeInput.value = selectedGameMode;
                modeQuickPickGrid.dataset.selectedMode = selectedGameMode;

                // สองขั้น: เลือกเกม → ตั้งค่าห้อง (ปุ่มสร้างห้องโผล่เฉพาะขั้นที่ 2)
                const gamePickStep = document.getElementById('gamePickStep');
                const roomSetupStep = document.getElementById('roomSetupStep');
                const modeCategoryChips = document.getElementById('modeCategoryChips');
                function showCreateStep(step) {
                    const picking = step === 'pick';
                    gamePickStep.hidden = !picking;
                    roomSetupStep.hidden = picking;
                    Swal.getPopup().classList.toggle('is-picking', picking);
                    Swal.getTitle().textContent = picking ? '🎮 เลือกเกม' : '⚙️ ตั้งค่าห้อง';
                    Swal.getConfirmButton().style.display = picking ? 'none' : '';
                    Swal.resetValidationMessage();
                    const container = Swal.getHtmlContainer();
                    if (container) container.scrollTop = 0;
                    Swal.getPopup().scrollTop = 0;
                    if (picking) {
                        const current = modeQuickPickGrid.querySelector('.mode-quick-card.is-on');
                        if (current) current.focus({ preventScroll: true });
                    }
                }
                modeCategoryChips.addEventListener('click', function(event) {
                    const chip = event.target.closest('.gp-cat');
                    if (!chip) return;
                    const cat = chip.dataset.cat;
                    modeCategoryChips.querySelectorAll('.gp-cat').forEach(function(item) {
                        const active = item === chip;
                        item.classList.toggle('is-active', active);
                        item.setAttribute('aria-pressed', active ? 'true' : 'false');
                    });
                    let index = 0;
                    modeQuickPickGrid.querySelectorAll('.mode-quick-card').forEach(function(card) {
                        const show = cat === 'all' || (card.dataset.cats || '').split(' ').includes(cat);
                        card.hidden = !show;
                        if (show) card.style.setProperty('--i', String(index++));
                    });
                });
                roomSetupStep.addEventListener('click', function(event) {
                    if (event.target.closest('#modeChangeBtn')) showCreateStep('pick');
                });
                showCreateStep('pick');
                
                maxPlayersSlider.addEventListener('input', function() {
                    maxPlayersValue.textContent = this.value;
                    updateSliderBackground(this);
                });
                
                roundTimeSlider.addEventListener('input', function() {
                    roundTimeValue.textContent = this.value + ' นาที';
                    updateSliderBackground(this);
                });
                
                function updateSliderBackground(slider) {
                    const percent = ((slider.value - slider.min) / (slider.max - slider.min)) * 100;
                    slider.style.background = `linear-gradient(90deg, #e74c3c 0%, #e74c3c ${percent}%, #333 ${percent}%, #333 100%)`;
                }
                
                updateSliderBackground(maxPlayersSlider);
                updateSliderBackground(roundTimeSlider);
                if (pokerAnteSlider && pokerAnteValue) {
                    pokerAnteSlider.addEventListener('input', function() {
                        pokerAnteValue.textContent = this.value;
                        updateSliderBackground(this);
                    });
                    updateSliderBackground(pokerAnteSlider);
                }

                function syncModeQuickPick() {
                    modeSpotlight.innerHTML = buildModeSpotlightHtml(selectedGameMode, gameModes);
                    modeQuickPickGrid.querySelectorAll('.mode-quick-card').forEach(function(card) {
                        const selected = card.dataset.modeId === selectedGameMode;
                        card.classList.toggle('is-on', selected);
                        card.setAttribute('aria-pressed', selected ? 'true' : 'false');
                    });
                    selectedGameModeInput.value = selectedGameMode;
                    modeQuickPickGrid.dataset.selectedMode = selectedGameMode;
                }

                function applyModeAutofill(modeId) {
                    selectedGameMode = modeId;
                    selectedGameModeInput.value = modeId;
                    modeQuickPickGrid.dataset.selectedMode = modeId;
                    const preset = getModeAutofillPreset(modeId);
                    const modeConfig = modeConfigById[modeId] || { minPlayers: 3, maxPlayers: 10 };
                    const clampedPlayers = Math.min(Number(modeConfig.maxPlayers || 10), Math.max(Number(modeConfig.minPlayers || 3), Number(preset.maxPlayers || 5)));

                    roomNameInput.value = preset.roomName;
                    roomNameInput.dataset.autofilledMode = modeId;

                    maxPlayersSlider.value = String(clampedPlayers);
                    maxPlayersValue.textContent = maxPlayersSlider.value;
                    updateSliderBackground(maxPlayersSlider);

                    if (modeId !== 'werewolf') {
                        roundTimeSlider.value = String(preset.roundTime);
                        roundTimeValue.textContent = `${roundTimeSlider.value} นาที`;
                        updateSliderBackground(roundTimeSlider);
                    }
                }

                roomNameInput.addEventListener('input', function() {
                    if (roomNameInput.dataset.autofilledMode) {
                        delete roomNameInput.dataset.autofilledMode;
                    }
                });

                function updateWerewolfRoleVisibility() {
                    const selectedMode = selectedGameModeInput.value || selectedGameMode || modeQuickPickGrid.dataset.selectedMode || 'insider';
                    selectedGameMode = selectedMode;
                    const modeConfig = modeConfigById[selectedMode] || { minPlayers: 3, maxPlayers: 10 };
                    const isWerewolfMode = selectedMode === 'werewolf';
                    const isPokerMode = selectedMode === 'poker5' || selectedMode === 'poker4';
                    const isPoker4Mode = selectedMode === 'poker4';
                    if (pokerTableGroup) pokerTableGroup.style.display = isPokerMode ? 'block' : 'none';
                    if (pokerTableLabel) {
                        pokerTableLabel.innerHTML = isPoker4Mode
                            ? '<span class="icon">♦</span> แบบเล่น:'
                            : '<span class="icon">♠</span> แบบเล่น:';
                    }
                    if (pokerTableHint) {
                        pokerTableHint.textContent = isPoker4Mode
                            ? 'ทิ้ง 2 ลงชิปรอบนึง แล้วได้ใบที่ 3 หงายให้ดู · หมอบแล้วไม่ได้ใบที่ 3 · เล่นสนุกได้ชิป 10,000 ชนะเก็บยอด'
                            : 'ทิ้ง 2 ลงชิปรอบนึง แล้วเปิด 3 ใบเทียบ · ตาละวางกองก่อนแจก · เล่นสนุกได้ชิป 10,000 ชนะเก็บยอด';
                    }
                    werewolfWolfCountGroup.style.display = isWerewolfMode ? 'block' : 'none';
                    createRoundTimeGroup.style.display = isWerewolfMode ? 'none' : 'block';
                    if (selectedMode === 'pokdeng') createRoundTimeGroup.style.display = 'none';
                    if (document.getElementById('pokdengTableGroup')) document.getElementById('pokdengTableGroup').style.display = selectedMode === 'pokdeng' ? 'block' : 'none';
                    if (selectedMode === 'codenames') createRoundTimeGroup.style.display = 'none';
                    if (document.getElementById('codenamesTimerGroup')) document.getElementById('codenamesTimerGroup').style.display = selectedMode === 'codenames' ? 'block' : 'none';
                    if (selectedMode === 'wavelength') createRoundTimeGroup.style.display = 'none';
                    if (document.getElementById('wavelengthLapsGroup')) document.getElementById('wavelengthLapsGroup').style.display = selectedMode === 'wavelength' ? 'block' : 'none';
                    if (selectedMode === 'drawguess') createRoundTimeGroup.style.display = 'none';
                    if (document.getElementById('drawguessSettingsGroup')) document.getElementById('drawguessSettingsGroup').style.display = selectedMode === 'drawguess' ? 'block' : 'none';
                    if (selectedMode === 'colorcards') createRoundTimeGroup.style.display = 'none';
                    if (document.getElementById('colorcardsTableGroup')) document.getElementById('colorcardsTableGroup').style.display = selectedMode === 'colorcards' ? 'block' : 'none';
                    if (selectedMode === 'setthi') createRoundTimeGroup.style.display = 'none';
                    // Coup ใช้เวลาต่อตาเป็นวินาทีของตัวเอง — สไลเดอร์นาทีเดิมไม่มีผลกับเกมนี้
                    if (selectedMode === 'coup') createRoundTimeGroup.style.display = 'none';
                    if (document.getElementById('coupSettingsGroup')) document.getElementById('coupSettingsGroup').style.display = selectedMode === 'coup' ? 'block' : 'none';
                    if (document.getElementById('setthiSettingsGroup')) document.getElementById('setthiSettingsGroup').style.display = selectedMode === 'setthi' ? 'block' : 'none';
                    roundTimeLabelText.textContent = selectedMode === 'blackmarket'
                        ? 'เวลาเดินเกมต่อยก:'
                        : (selectedMode === 'coup' || selectedMode === 'liar' || selectedMode === 'poker5' || selectedMode === 'poker4' ? 'เวลาคิดต่อตา:'
                            : (isWerewolfMode ? 'เวลาต่อช่วงกลางวัน/กลางคืน:' : 'เวลาเล่นต่อรอบ:'));

                    const sliderMin = Number(modeConfig.minPlayers || 3);
                    const sliderMax = Number(modeConfig.maxPlayers || 10);
                    maxPlayersSlider.min = String(sliderMin);
                    maxPlayersSlider.max = String(sliderMax);

                    if (selectedMode === 'blackmarket' && !['4', '5', '6', '7'].includes(maxPlayersSlider.value)) {
                        maxPlayersSlider.value = '6';
                    }

                    if (selectedMode === 'spyfall' && !['4', '5', '6', '7', '8'].includes(maxPlayersSlider.value)) {
                        maxPlayersSlider.value = '6';
                    }

                    if (selectedMode === 'coup' && !['2', '3', '4', '5', '6'].includes(maxPlayersSlider.value)) {
                        maxPlayersSlider.value = '5';
                    }

                    if (selectedMode === 'avalon' && Number(maxPlayersSlider.value) < 5) {
                        maxPlayersSlider.value = '10';
                    }

                    if (selectedMode === 'liar' && !['3', '4', '5', '6', '7', '8'].includes(maxPlayersSlider.value)) {
                        maxPlayersSlider.value = '6';
                    }

                    if ((selectedMode === 'poker5' || selectedMode === 'poker4') && !['2', '3', '4', '5', '6', '7', '8', '9', '10'].includes(maxPlayersSlider.value)) {
                        maxPlayersSlider.value = '4';
                    }

                    if (Number(maxPlayersSlider.value) < sliderMin) {
                        maxPlayersSlider.value = String(sliderMin);
                    }
                    if (Number(maxPlayersSlider.value) > sliderMax) {
                        maxPlayersSlider.value = String(sliderMax);
                    }

                    if (selectedMode === 'blackmarket' && Number(maxPlayersSlider.value) < 6) {
                        maxPlayersSlider.value = '6';
                        maxPlayersValue.textContent = maxPlayersSlider.value;
                        updateSliderBackground(maxPlayersSlider);
                    }

                    if (selectedMode === 'spyfall' && Number(maxPlayersSlider.value) < 4) {
                        maxPlayersSlider.value = '4';
                        maxPlayersValue.textContent = maxPlayersSlider.value;
                        updateSliderBackground(maxPlayersSlider);
                    }

                    // คำใครไม่เหมือนจับเวลาเป็นช่วงในเกมเอง — ไม่ใช้เวลาต่อรอบ
                    if (selectedMode === 'undercover') {
                        createRoundTimeGroup.style.display = 'none';
                    }

                    maxPlayersValue.textContent = maxPlayersSlider.value;
                    updateSliderBackground(maxPlayersSlider);
                    syncModeQuickPick();
                }

                const urlMode = new URLSearchParams(window.location.search).get('mode');
                if (urlMode && modeConfigById[urlMode]) {
                    selectedGameMode = urlMode;
                    selectedGameModeInput.value = urlMode;
                    modeQuickPickGrid.dataset.selectedMode = urlMode;
                    updateWerewolfRoleVisibility();
                    applyModeAutofill(urlMode);
                    modeQuickPickGrid.dataset.chosen = '1';
                    showCreateStep('setup');
                } else {
                    updateWerewolfRoleVisibility();
                }

                modeQuickPickGrid.addEventListener('click', function(event) {
                    const card = event.target.closest('.mode-quick-card');
                    if (!card) {
                        return;
                    }

                    selectedGameMode = card.dataset.modeId;
                    selectedGameModeInput.value = card.dataset.modeId;
                    modeQuickPickGrid.dataset.selectedMode = card.dataset.modeId;
                    modeQuickPickGrid.dataset.chosen = '1';
                    updateWerewolfRoleVisibility();
                    applyModeAutofill(card.dataset.modeId);
                    showCreateStep('setup');
                });

                createWolfCountSelector.addEventListener('click', function(event) {
                    const btn = event.target.closest('.wolf-count-btn');
                    if (!btn) {
                        return;
                    }

                    createWolfCountSelector.querySelectorAll('.wolf-count-btn').forEach(function(item) {
                        const active = item === btn;
                        item.classList.toggle('active', active);
                        item.style.borderColor = active ? '#e74c3c' : 'rgba(255,255,255,0.12)';
                        item.style.background = active ? 'rgba(231,76,60,0.2)' : 'rgba(255,255,255,0.04)';
                    });
                });
                
                // Lock checkbox handler
                const lockedContainer = document.getElementById('lockedContainer');
                const lockedCheckbox = document.getElementById('locked');
                const passwordGroup = document.getElementById('passwordGroup');
                
                lockedContainer.addEventListener('click', function(event) {
                    if (event.target !== lockedCheckbox) lockedCheckbox.checked = !lockedCheckbox.checked;
                    this.classList.toggle('checked', lockedCheckbox.checked);
                    passwordGroup.style.display = lockedCheckbox.checked ? 'block' : 'none';
                    if (!lockedCheckbox.checked) {
                        document.getElementById('password').value = '';
                    }
                });
            },
            preConfirm: () => {
                const rawRoomName = document.getElementById('roomName').value.trim();
                const gameMode = resolveCreateGameMode();
                const roomName = rawRoomName || getAutofilledRoomName(gameMode);
                const maxPlayers = parseInt(document.getElementById('maxPlayers').value);
                const roundTime = parseInt(document.getElementById('roundTime').value);
                const locked = document.getElementById('locked').checked;
                const password = document.getElementById('password').value.trim();
                const activeWolfBtn = document.querySelector('#createWolfCountSelector .wolf-count-btn.active');
                const wolfCount = gameMode === 'werewolf' && activeWolfBtn
                    ? parseInt(activeWolfBtn.dataset.wolfCount, 10)
                    : undefined;
                const tableModeInput = document.querySelector('input[name="tableMode"]:checked');
                const tableMode = tableModeInput ? tableModeInput.value : 'inPerson';
                
                if (locked && (!password || !/^\d{4}$/.test(password))) {
                    Swal.showValidationMessage('กรุณากรอกรหัสผ่าน 4 หลัก (ตัวเลขเท่านั้น)');
                    return false;
                }
                
                return {
                    name: roomName,
                    gameMode: gameMode,
                    maxPlayers: maxPlayers,
                    roundTime: gameMode === 'werewolf' ? undefined : roundTime,
                    wolfCount: wolfCount,
                    werewolfNightSeconds: gameMode === 'werewolf' ? Number((document.getElementById('werewolfNightSeconds') || {}).value || 60) : undefined,
                    werewolfDaySeconds: gameMode === 'werewolf' ? Number((document.getElementById('werewolfDaySeconds') || {}).value || 180) : undefined,
                    werewolfVoteSeconds: gameMode === 'werewolf' ? Number((document.getElementById('werewolfVoteSeconds') || {}).value || 60) : undefined,
                    werewolfDeadSeeRoles: gameMode === 'werewolf' ? !!(document.getElementById('werewolfDeadSeeRoles') || { checked: true }).checked : undefined,
                    locked: locked,
                    password: locked ? password : null,
                    tableMode: tableMode,
                    pokerTableType: (gameMode === 'poker5' || gameMode === 'poker4')
                        ? ((document.querySelector('input[name="pokerTableType"]:checked') || {}).value || 'fun')
                        : 'fun',
                    pokerAnte: (gameMode === 'poker5' || gameMode === 'poker4')
                        ? (parseInt((document.getElementById('pokerAnte') || {}).value, 10) || 500)
                        : 500,
                    pokdengRotateDealer: gameMode === 'pokdeng'
                        && ((document.querySelector('input[name="pokdengDealer"]:checked') || {}).value === 'rotate'),
                    codenamesClueSeconds: gameMode === 'codenames' ? Number((document.getElementById('codenamesClueSeconds') || {}).value || 120) : undefined,
                    codenamesGuessSeconds: gameMode === 'codenames' ? Number((document.getElementById('codenamesGuessSeconds') || {}).value || 0) : undefined,
                    wavelengthLaps: gameMode === 'wavelength'
                        ? (parseInt((document.querySelector('input[name="wavelengthLaps"]:checked') || {}).value, 10) === 2 ? 2 : 1)
                        : 1,
                    drawguessRounds: gameMode === 'drawguess' ? Number((document.querySelector('input[name="drawguessRounds"]:checked') || {}).value || 3) : undefined,
                    drawguessSeconds: gameMode === 'drawguess' ? Number((document.querySelector('input[name="drawguessSeconds"]:checked') || {}).value || 80) : undefined,
                    drawguessCategory: gameMode === 'drawguess' ? ((document.getElementById('drawguessCategory') || {}).value || 'mixed') : undefined,
                    drawguessHints: gameMode === 'drawguess' ? Number((document.querySelector('input[name="drawguessHints"]:checked') || {}).value || 1) : undefined,
                    colorcardsTarget: gameMode === 'colorcards' ? Number((document.getElementById('colorcardsTarget') || {}).value || 0) : undefined,
                    colorcardsTurnSeconds: gameMode === 'colorcards' ? Number((document.getElementById('colorcardsTurnSeconds') || {}).value || 20) : undefined,
                    colorcardsStacking: gameMode === 'colorcards' && !!(document.getElementById('colorcardsStacking') || {}).checked,
                    setthiMinutes: gameMode === 'setthi' ? Number((document.getElementById('setthiMinutes') || {}).value || 30) : undefined,
                    coupActionSeconds: gameMode === 'coup' ? Number((document.getElementById('coupActionSeconds') || {}).value || 60) : undefined
                };
            }
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    const payload = Object.assign({}, result.value, { playerId: playerId });
                    fetch('/api/rooms', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        credentials: 'same-origin',
                        body: JSON.stringify(payload)
                    }).then(function(res) {
                        return res.json().catch(function() {
                            return { success: false, error: 'สร้างห้องไม่สำเร็จ' };
                        });
                    }).then(function(response) {
                        if (response && response.success && response.roomId) {
                            window.location.href = '/room/' + response.roomId + '?playerId=' + playerId;
                            return;
                        }
                        Swal.fire({
                            icon: 'error',
                            title: '❌ สร้างห้องไม่สำเร็จ',
                            text: (response && response.error) || 'ลองอีกครั้ง หรือตรวจการเชื่อมต่ออินเทอร์เน็ต',
                            background: '#1e1e1e',
                            color: '#fff',
                            confirmButtonColor: '#e74c3c'
                        });
                    }).catch(function() {
                        // Fallback to socket if HTTP create is unavailable
                        socket.emit('createRoom', payload, function(response) {
                            if (response && response.success && response.roomId) {
                                window.location.href = '/room/' + response.roomId + '?playerId=' + playerId;
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: '❌ สร้างห้องไม่สำเร็จ',
                                    text: (response && response.error) || 'ลองอีกครั้ง หรือตรวจการเชื่อมต่ออินเทอร์เน็ต',
                                    background: '#1e1e1e',
                                    color: '#fff',
                                    confirmButtonColor: '#e74c3c'
                                });
                            }
                        });
                    });
                }
            });
    });

    // Refresh room list
    $('#refreshBtn').on('click', function() {
        socket.emit('getRoomList', function(response) {
            if (response.success) {
                rooms = response.rooms;
                renderRoomList();
            }
        });
    });

    // Search room
    $('#searchRoomInput').on('keypress', function(e) {
        if (e.which === 13) { // Enter key
            const searchTerm = $(this).val().trim().toUpperCase();
            if (searchTerm) {
                const room = rooms.find(r => r.roomId.toUpperCase() === searchTerm);
                if (room) {
                    $('html, body').animate({
                        scrollTop: $(`.room-card[data-room-id="${room.roomId}"]`).offset().top - 100
                    }, 500);
                    $(`.room-card[data-room-id="${room.roomId}"]`).css('border-color', '#ff6b6b').animate({
                        'border-color': '#444'
                    }, 1000);
                } else {
                    Swal.fire({
                        icon: 'info',
                        title: 'ℹ️ ไม่พบห้อง',
                        text: 'ไม่พบห้องที่ต้องการ',
                        background: '#1e1e1e',
                        color: '#fff',
                        confirmButtonColor: '#3498db'
                    });
                }
            }
        }
    });

    // Socket event: Room list update
    socket.on('roomListUpdate', function(updatedRooms) {
        rooms = updatedRooms;
        renderRoomList();
    });

    // Listen for system broadcasts
    socket.on('systemBroadcast', function(data) {
        Swal.fire({
            icon: 'info',
            title: '📢 ประกาศจากระบบ',
            text: data.message,
            background: '#1e1e1e',
            color: '#fff',
            confirmButtonColor: '#e74c3c'
        });
    });


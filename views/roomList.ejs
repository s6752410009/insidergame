<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/pokerHands.css">
<style>
    :root {
        --room-bg: #09090b;
        --room-panel: rgba(18, 18, 20, 0.86);
        --room-panel-soft: rgba(255, 255, 255, 0.05);
        --room-line: rgba(255, 255, 255, 0.1);
        --room-gold: #f5c86b;
        --room-gold-soft: rgba(245, 200, 107, 0.2);
        --room-red: #b91c1c;
        --room-text: #f5efe3;
        --room-muted: #b8ada0;
        --room-shadow: 0 32px 100px rgba(0, 0, 0, 0.52);
    }

    body.content {
        background:
            radial-gradient(circle at 8% 10%, rgba(127, 29, 29, 0.42), transparent 18%),
            radial-gradient(circle at 92% 0%, rgba(180, 83, 9, 0.18), transparent 16%),
            linear-gradient(180deg, #09090b 0%, #110d0c 45%, #17110f 100%);
    }

    .room-list-container {
        position: relative;
        max-width: 1440px;
        margin: 20px auto 36px;
        padding: 20px;
        font-family: 'Rajdhani', sans-serif;
        color: var(--room-text);
    }

    .room-list-shell {
        position: relative;
        overflow: hidden;
        border-radius: 34px;
        border: 1px solid rgba(245, 200, 107, 0.16);
        background:
            linear-gradient(145deg, rgba(12, 12, 14, 0.98), rgba(26, 17, 15, 0.94)),
            var(--room-bg);
        box-shadow: var(--room-shadow);
        isolation: isolate;
    }

    .room-list-shell::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255,255,255,0.05) 0.7px, transparent 0.7px);
        background-size: 16px 16px;
        opacity: 0.18;
        pointer-events: none;
    }

    .room-list-shell::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(115deg, rgba(245, 200, 107, 0.06), transparent 18%, transparent 70%, rgba(116, 185, 255, 0.04)),
            radial-gradient(circle at top center, rgba(245, 200, 107, 0.08), transparent 32%);
        pointer-events: none;
        z-index: 0;
    }
    
    .room-list-header {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 24px 26px 22px;
        margin-bottom: 0;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--room-line);
        background:
            radial-gradient(circle at top left, rgba(127, 29, 29, 0.32), transparent 34%),
            linear-gradient(135deg, rgba(127, 29, 29, 0.22), rgba(17, 17, 17, 0.72));
    }

    .room-list-header::after {
        content: '';
        position: absolute;
        left: 26px;
        right: 26px;
        bottom: 0;
        height: 1px;
        background: linear-gradient(90deg, rgba(245, 200, 107, 0.24), transparent 32%, transparent 68%, rgba(245, 200, 107, 0.2));
    }

    .room-hero {
        display: grid;
        gap: 6px;
        max-width: 680px;
    }

    .room-kicker {
        color: var(--room-gold);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }
    
    /* กล่องดำหลักสำหรับลิสต์ห้อง (เหมือนกรอบโปรไฟล์ในรูปที่ 2) */
    .room-panel {
        position: relative;
        z-index: 1;
        margin: 22px;
        padding: 22px;
        border-radius: 28px;
        border: 1px solid var(--room-line);
        background:
            linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02)),
            var(--room-panel);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 18px 42px rgba(0,0,0,0.24);
        min-height: 260px;
    }

    /* Popup สร้างห้อง/แก้ไขห้อง - Modern Style */
    .room-popup {
        max-width: 480px !important;
        border-radius: 20px !important;
        border: 3px solid #333 !important;
        background: linear-gradient(145deg, #1a1a2e 0%, #16213e 100%) !important;
        box-shadow: 0 20px 60px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.05) inset !important;
        padding: 0 !important;
        overflow: hidden !important;
    }
    
    .room-popup .swal2-title {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        margin: 0 !important;
        padding: 20px 24px !important;
        font-family: 'Orbitron', sans-serif !important;
        font-size: 1.4em !important;
        font-weight: 700 !important;
        color: #fff !important;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .room-popup .swal2-html-container {
        margin: 0 !important;
        padding: 24px !important;
        overflow: visible !important;
    }
    
    .room-popup .swal2-actions {
        padding: 0 24px 24px !important;
        gap: 12px !important;
    }
    
    .room-form-group {
        margin-bottom: 20px;
    }
    
    .room-form-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        font-weight: 600;
        color: #aaa;
        font-size: 0.95em;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .room-form-label .icon {
        font-size: 1.1em;
    }
    
    .room-form-input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid #333;
        border-radius: 12px;
        background: #0d0d1a;
        color: #fff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.1em;
        font-weight: 600;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }
    
    .room-form-input:focus {
        outline: none;
        border-color: #e74c3c;
        box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.2);
    }
    
    .room-form-input::placeholder {
        color: #555;
        font-weight: 400;
    }
    
    /* Slider Style */
    .room-slider-container {
        position: relative;
        padding: 10px 0;
    }
    
    .room-slider {
        appearance: none;
        -webkit-appearance: none;
        width: 100%;
        height: 8px;
        border-radius: 4px;
        background: linear-gradient(90deg, #333 0%, #333 100%);
        outline: none;
        transition: all 0.3s;
    }
    
    .room-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        cursor: pointer;
        border: 3px solid #fff;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
        transition: all 0.2s;
    }
    
    .room-slider::-webkit-slider-thumb:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(231, 76, 60, 0.6);
    }
    
    .room-slider::-moz-range-thumb {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        cursor: pointer;
        border: 3px solid #fff;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
    }
    
    .room-slider-value {
        position: absolute;
        right: 0;
        top: -5px;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: #fff;
        padding: 6px 14px;
        border-radius: 20px;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1em;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
    }
    
    /* Checkbox Style */
    .room-checkbox-container {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        background: #0d0d1a;
        border: 2px solid #333;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s;
    }
    
    .room-checkbox-container:hover {
        border-color: #e74c3c;
        background: rgba(231, 76, 60, 0.1);
    }
    
    .room-checkbox-container.checked {
        border-color: #e74c3c;
        background: rgba(231, 76, 60, 0.15);
    }
    
    .room-checkbox {
        display: none;
    }
    
    .room-checkbox-custom {
        width: 24px;
        height: 24px;
        border: 2px solid #555;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
        font-size: 14px;
    }
    
    .room-checkbox-container.checked .room-checkbox-custom {
        background: #e74c3c;
        border-color: #e74c3c;
    }
    
    .room-checkbox-text {
        flex: 1;
        font-weight: 600;
        color: #fff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.05em;
    }
    
    /* Button Styles */
    .room-btn-confirm {
        padding: 14px 28px !important;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%) !important;
        border: none !important;
        border-radius: 12px !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 700 !important;
        font-size: 1.1em !important;
        cursor: pointer;
        transition: all 0.3s !important;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
    }
    
    .room-btn-confirm:hover {
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 25px rgba(231, 76, 60, 0.4) !important;
    }
    
    .room-btn-cancel {
        padding: 14px 28px !important;
        background: transparent !important;
        border: 2px solid #555 !important;
        border-radius: 12px !important;
        color: #aaa !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 700 !important;
        font-size: 1.1em !important;
        cursor: pointer;
        transition: all 0.3s !important;
    }
    
    .room-btn-cancel:hover {
        border-color: #888 !important;
        color: #fff !important;
        background: rgba(255,255,255,0.05) !important;
    }
    
    .room-list-header h1 {
        margin: 0;
        color: var(--room-text);
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        line-height: 1;
        text-shadow: 0 0 20px rgba(245, 200, 107, 0.12);
        letter-spacing: 0.06em;
    }

    .room-hero-copy {
        color: var(--room-muted);
        font-size: 1rem;
        max-width: 62ch;
    }

    .room-feature-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }

    .room-feature-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        font-weight: 700;
        color: var(--room-text);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }

    .room-feature-pill.highlight {
        border-color: rgba(245, 200, 107, 0.28);
        color: #fde68a;
    }
    
    .room-controls {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        max-width: 480px;
    }
    
    #searchRoomInput {
        padding: 12px 16px;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 16px;
        width: 280px;
        background: rgba(255,255,255,0.06);
        color: var(--room-text);
        font-family: 'Rajdhani', sans-serif;
        font-size: 1em;
        transition: all 0.3s;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }
    
    #searchRoomInput:focus {
        outline: none;
        border-color: rgba(245, 200, 107, 0.34);
        box-shadow: 0 0 0 3px rgba(245, 200, 107, 0.14);
    }
    
    #searchRoomInput::placeholder {
        color: #8f8377;
    }
    
    .btn-room {
        padding: 12px 20px;
        border: 1px solid transparent;
        border-radius: 16px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        font-size: 1em;
        cursor: pointer;
        transition: all 0.3s;
        letter-spacing: 0.06em;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }
    
    #refreshBtn {
        background: rgba(255,255,255,0.08);
        border-color: rgba(255,255,255,0.12);
        color: var(--room-text);
    }
    
    #refreshBtn:hover {
        background: rgba(255,255,255,0.12);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.24);
    }
    
    #createRoomBtn {
        background: linear-gradient(135deg, #9a3412, #7f1d1d);
        border-color: rgba(245, 200, 107, 0.16);
        color: #fff;
    }
    
    #createRoomBtn:hover {
        background: linear-gradient(135deg, #b45309, #991b1b);
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.28);
    }
    
    #roomList {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
    }
    
    .room-card {
        background:
            radial-gradient(circle at top right, rgba(245, 200, 107, 0.12), transparent 38%),
            linear-gradient(145deg, rgba(251,191,36,0.08), rgba(127,29,29,0.08));
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 24px;
        padding: 25px;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 18px 32px rgba(0,0,0,0.16);
        position: relative;
        overflow: hidden;
    }
    
    .room-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, rgba(245, 200, 107, 0.2), transparent);
        transform: scaleX(0);
        transition: transform 0.3s;
    }
    
    .room-card:hover {
        transform: translateY(-5px);
        border-color: rgba(245, 200, 107, 0.22);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 22px 36px rgba(0,0,0,0.2);
    }
    
    .room-card:hover::before {
        transform: scaleX(1);
    }
    
    .room-card-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 20px;
    }
    
    .room-card-title {
        flex: 1;
    }
    
    .room-card-title h3 {
        margin: 0 0 8px 0;
        color: var(--room-text);
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.3em;
    }
    
    .room-card-id {
        margin: 0;
        color: var(--room-muted);
        font-size: 0.9em;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .room-card-id strong {
        color: var(--room-gold);
        font-weight: 600;
    }
    
    .room-lock-icon {
        font-size: 2em;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    }
    
    .room-card-info {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    
    .room-info-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--room-text);
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.1em;
    }
    
    .room-info-item strong {
        color: #fff;
        font-weight: 600;
    }
    
    .room-info-icon {
        font-size: 1.3em;
    }
    
    #noRooms {
        text-align: center;
        padding: 60px 40px;
        color: var(--room-muted);
        display: none;
    }
    
    #noRooms p {
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.3em;
        margin: 10px 0;
    }
    
    #noRooms p:first-child {
        font-size: 1.6em;
        color: var(--room-text);
        font-weight: 600;
    }

    .page-footer-actionbar {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 12px;
    }

    .page-footer-actionbar a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        min-width: min(320px, calc(100vw - 32px));
        padding: 8px 20px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(255,255,255,0.08);
        color: var(--room-text);
        text-decoration: none;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
        font-weight: 700;
    }

    @media (max-width: 900px) {
        .room-list-header {
            align-items: flex-start;
        }

        .room-controls {
            justify-content: flex-start;
        }
    }

    @media (max-width: 640px) {
        .room-list-container {
            padding: 8px;
            margin-top: 8px;
        }

        .room-list-shell {
            border-radius: 24px;
        }

        .room-list-header,
        .room-panel {
            padding: 14px;
        }

        .room-panel {
            margin: 14px;
            padding-left: 14px;
            padding-right: 14px;
        }

        .page-footer-actionbar {
            padding: 0 max(12px, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(12px, env(safe-area-inset-left));
        }

        .page-footer-actionbar a {
            width: 100%;
            min-width: 0;
        }

        #searchRoomInput {
            width: 100%;
        }
    }
    
    /* SweetAlert2 Dark Theme */
    .swal2-popup {
        background: #1e1e1e !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
    }

    /* ---------- หน้าเลือกเกม (ขั้นที่ 1 ของการสร้างห้อง) ---------- */
    .room-popup.is-picking { max-width: 880px !important; }
    .gp {
        --gp-ink: oklch(0.97 0.01 280);
        --gp-muted: oklch(0.74 0.03 280);
        --gp-line: oklch(0.45 0.04 280 / 0.5);
        --gp-surface: oklch(0.23 0.035 275);
        --gp-gold: #f5c86b;
        font-family: 'Bai Jamjuree', 'Rajdhani', sans-serif;
        text-align: left;
        color: var(--gp-ink);
    }
    .gp-intro { margin: 0 0 14px; color: var(--gp-muted); font-size: 0.95rem; line-height: 1.5; }
    .gp-cats { display: flex; gap: 8px; margin: 0 0 14px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
    .gp-cats::-webkit-scrollbar { display: none; }
    .gp-cat {
        flex: 0 0 auto; min-height: 40px; padding: 0 14px;
        border-radius: 999px; border: 1px solid var(--gp-line);
        background: transparent; color: var(--gp-muted);
        font: inherit; font-size: 0.92rem; font-weight: 600; white-space: nowrap; cursor: pointer;
        transition: background-color .15s ease, color .15s ease, border-color .15s ease;
    }
    .gp-cat:hover { color: var(--gp-ink); border-color: oklch(0.6 0.04 280 / 0.7); }
    .gp-cat.is-active { background: var(--gp-gold); border-color: var(--gp-gold); color: #1a2332; }
    .gp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; }
    .mode-quick-card {
        position: relative;
        display: grid; grid-template-rows: auto 1fr;
        min-width: 0; padding: 0; overflow: hidden;
        border-radius: 16px; border: 1px solid var(--gp-line);
        background: var(--gp-surface); color: var(--gp-ink);
        font: inherit; text-align: left; cursor: pointer;
        transition: transform .2s cubic-bezier(0.22, 1, 0.36, 1), border-color .2s ease, box-shadow .2s ease;
        animation: gpIn .35s cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: calc(var(--i, 0) * 28ms);
    }
    .mode-quick-card[hidden] { display: none; }
    .mode-quick-card:hover { transform: translateY(-3px); border-color: var(--gp-accent, var(--gp-gold)); box-shadow: 0 14px 30px rgba(0,0,0,0.4); }
    .mode-quick-card:active { transform: scale(0.98); }
    .gp-grid[data-chosen] .mode-quick-card.is-on { border-color: var(--gp-gold); box-shadow: 0 0 0 2px var(--gp-gold); }
    .mq-art { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #1a2332; }
    .mq-art img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s cubic-bezier(0.22, 1, 0.36, 1); }
    .mode-quick-card:hover .mq-art img { transform: scale(1.05); }
    .mq-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(10, 12, 24, 0.55)); }
    .mq-players {
        position: absolute; right: 8px; bottom: 8px; z-index: 1;
        padding: 3px 8px; border-radius: 999px;
        background: rgba(10, 12, 24, 0.78); color: #fff;
        font-size: 0.75rem; font-weight: 700; white-space: nowrap;
    }
    .mq-new {
        position: absolute; left: 8px; top: 8px; z-index: 1;
        padding: 3px 9px; border-radius: 999px;
        background: var(--gp-gold); color: #1a2332;
        font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;
    }
    .mq-body { display: grid; align-content: start; gap: 3px; padding: 10px 12px 12px; min-width: 0; }
    .mq-title { font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-size: 1.06rem; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
    .mq-tag { color: var(--gp-muted); font-size: 0.84rem; line-height: 1.4; overflow-wrap: anywhere; }
    .gp-empty { padding: 28px 12px; color: var(--gp-muted); text-align: center; }
    @keyframes gpIn { from { opacity: 0; transform: translateY(8px); } }

    /* ขั้นที่ 2: เกมที่เลือก + ตั้งค่าห้อง */
    .mode-spotlight {
        display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 14px; align-items: start;
        margin-bottom: 20px; padding: 12px;
        border-radius: 16px; border: 1px solid var(--gp-line, rgba(255,255,255,0.14));
        background: oklch(0.23 0.035 275);
        font-family: 'Bai Jamjuree', 'Rajdhani', sans-serif; text-align: left; color: #f4f3fb;
        animation: gpIn .3s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .ms-art { width: 100%; aspect-ratio: 1; border-radius: 12px; object-fit: cover; background: #1a2332; display: block; }
    .ms-body { min-width: 0; display: grid; gap: 4px; }
    .ms-kicker { color: #f5c86b; font-size: 0.8rem; font-weight: 700; overflow-wrap: anywhere; }
    .ms-title { font-family: 'Chakra Petch', 'Bai Jamjuree', sans-serif; font-size: 1.3rem; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
    .ms-summary { margin: 0; color: oklch(0.8 0.025 280); font-size: 0.9rem; line-height: 1.5; overflow-wrap: anywhere; }
    .ms-bullets { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
    .ms-bullets li { display: inline-flex; width: auto; margin: 0; padding: 3px 9px; border-radius: 999px; background: rgba(255,255,255,0.07); font-size: 0.78rem; color: #e6e4f2; }
    .ms-change {
        grid-column: 1 / -1; justify-self: stretch; min-height: 44px;
        border-radius: 12px; border: 1px solid rgba(255,255,255,0.16);
        background: rgba(255,255,255,0.04); color: #f4f3fb;
        font: inherit; font-weight: 600; cursor: pointer;
    }
    .ms-change:hover { background: rgba(255,255,255,0.09); }
    .mode-quick-card:focus-visible, .gp-cat:focus-visible, .ms-change:focus-visible,
    .room-advanced-details > summary:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
    .room-advanced-details {
        margin-top:10px; border:1px solid rgba(255,255,255,0.12); border-radius:14px;
        background:rgba(255,255,255,0.035);
    }
    .room-advanced-details > summary { padding:11px 13px; cursor:pointer; color:#f5c86b; font-weight:700; text-align:left; }
    .room-advanced-body { padding:0 10px 10px; }
    @media (max-width: 520px) {
        .gp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
        .mq-body { padding: 8px 10px 10px; }
        .mq-title { font-size: 0.98rem; }
        .mq-tag { font-size: 0.78rem; }
        .mode-spotlight { grid-template-columns: 72px minmax(0, 1fr); gap: 12px; padding: 10px; }
        .ms-title { font-size: 1.12rem; }
        .ms-summary { font-size: 0.84rem; }
        .ms-bullets li { font-size: 0.74rem; padding: 2px 8px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .mode-quick-card, .mode-spotlight { animation: none; }
        .mode-quick-card, .mq-art img, .gp-cat { transition: none; }
        .mode-quick-card:hover { transform: none; }
        .mode-quick-card:hover .mq-art img { transform: none; }
    }
    
    .swal2-title {
        color: #fff !important;
        font-family: 'Orbitron', sans-serif !important;
        font-weight: 700 !important;
    }
    
    .swal2-content {
        color: #ddd !important;
    }
    
    .swal2-input, .swal2-select {
        background: #1a1a1a !important;
        border: 2px solid #444 !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
    }
    
    .swal2-input:focus, .swal2-select:focus {
        border-color: #e74c3c !important;
        box-shadow: 0 0 10px rgba(231, 76, 60, 0.3) !important;
    }
    
    .swal2-confirm {
        background: #e74c3c !important;
        border-color: #c0392b !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 600 !important;
    }
    
    .swal2-confirm:hover {
        background: #c0392b !important;
    }
    
    .swal2-cancel {
        background: #555 !important;
        border-color: #444 !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 600 !important;
    }
    
    .swal2-cancel:hover {
        background: #666 !important;
    }

    #howToPlayBtn {
        background: linear-gradient(135deg, #312e81, #1e1b4b);
        border-color: rgba(129, 140, 248, 0.3);
        color: #c7d2fe;
    }
    #howToPlayBtn:hover {
        background: linear-gradient(135deg, #3730a3, #312e81);
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(99, 102, 241, 0.28);
        border-color: rgba(129, 140, 248, 0.5);
        color: #e0e7ff;
    }

    /* ─── Guide popup styles ─── */
    .bm-guide-popup {
        max-width: min(520px, 96vw) !important;
        padding: 0 !important;
        overflow: hidden !important;
        background: #111 !important;
        border: 1px solid rgba(129, 140, 248, 0.25) !important;
        border-radius: 20px !important;
    }
    .bm-guide-popup .swal2-title {
        background: linear-gradient(135deg, #312e81, #111) !important;
        color: #c7d2fe !important;
        font-family: 'Orbitron', sans-serif !important;
        font-size: 1.05em !important;
        padding: 14px 16px !important;
        margin: 0 !important;
    }
    .bm-guide-popup .swal2-html-container {
        margin: 0 !important;
        padding: 0 !important;
        max-height: min(72vh, 600px);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }
    .bm-guide-popup .swal2-actions { margin: 0 !important; padding: 12px 16px 16px !important; }
    .bm-guide-inner { padding: 14px 16px 8px; color: #ddd; font-size: 0.92em; line-height: 1.5; text-align: left; }
    .bm-guide-lead { margin: 0 0 12px; color: #fde68a; font-weight: 700; }
    .bm-guide-section {
        margin-bottom: 12px; padding: 12px 14px; border-radius: 12px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(129,140,248,0.18);
    }
    .bm-guide-section h4 { margin: 0 0 8px; color: #fff; font-size: 0.98em; font-weight: 700; }
    .bm-guide-section ul, .bm-guide-section ol { margin: 6px 0 0; padding-left: 18px; }
    .bm-guide-section li { margin-bottom: 4px; }
    .bm-guide-muted { margin: 8px 0 0; color: #9aa3b2; font-size: 0.86em; }
    .bm-guide-role-grid { display: grid; gap: 8px; margin-top: 8px; }
    .bm-guide-role {
        padding: 10px 12px; border-radius: 10px;
        background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06);
    }
    .bm-guide-role strong { color: #fde68a; display: block; margin-bottom: 4px; }
    .bm-guide-role span { color: #ccc; font-size: 0.9em; }
    .bm-guide-actions { display: grid; gap: 6px; margin-top: 8px; }
    .bm-guide-action { display: flex; gap: 8px; align-items: flex-start; font-size: 0.9em; }
    .bm-guide-action b { color: #fff; min-width: 5.5em; flex-shrink: 0; }
    .global-guide-tabs { display: flex; gap: 6px; flex-wrap: wrap; padding: 12px 16px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .global-guide-tab-btn {
        border: none; padding: 8px 12px; border-radius: 8px 8px 0 0;
        color: #aaa; cursor: pointer; font-family: 'Rajdhani', sans-serif;
        font-weight: 700; font-size: 0.88em; background: transparent;
        transition: all 0.2s;
    }
    .global-guide-tab-btn.active { background: rgba(255,255,255,0.1); color: #fff; }
    .global-guide-pane { display: none; }
    .global-guide-pane.active { display: block; }
</style>


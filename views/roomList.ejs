            '<li>กดค้างปุ่มทอย ปล่อยตอนเข็มแรง = เดินไกล · ผ่านจุดเริ่มรับ ฿3,000 · ดับเบิลทอยอีก (3 ครั้งติด = เกาะร้าง)</li>',
            '<li>ตกเมืองว่าง: ซื้อที่ดิน + สร้างบ้าน/ตึก/โรงแรมได้ในแผ่นเดียว (รอบแรกถึงบ้าน) · มีโรงแรมแล้วตกซ้ำ = แลนด์มาร์ก</li>',
            '<li>ตกที่คนอื่น: จ่ายค่าผ่านทาง แล้วซื้อต่อได้ 2 เท่า (แลนด์มาร์ก/ท่องเที่ยวซื้อต่อไม่ได้)</li>',
            '<li>งานวัด ค่าผ่านทาง ×2 (เลือกซ้ำซ้อนถึง ×16) · ทัวร์ ตาหน้าแตะช่องไหนก็ได้ · เกาะร้าง ติดได้ 3 ตา</li>',
            '<li>เงินไม่พอ: ขายที่คืนครึ่งราคา · หมดทาง = ล้มละลาย</li>',
            '</ol></div>',
            '<div class="bm-guide-section"><h4>เวลา</h4><p>หัวห้องตั้งเวลา 20/30/45/60 นาทีหรือไม่จำกัด · หมดเวลาเล่นครบรอบแล้วนับทรัพย์สินรวม · เงินในเกม ไม่มีมูลค่าจริง</p></div>',
            '</div>'
        ].join('');
    }

    function buildPokerGuideHtml(variant) {
        if (window.pokerRankChart) return window.pokerRankChart.guideHtml(variant, pokerRankGuide);
        return '';
    }

    function showGlobalGameGuide() {
        const guides = [
            { id: 'insider',     label: '🎯 Insider',      html: INSIDER_GUIDE_HTML,           color: '#be123c' },
            { id: 'werewolf',    label: '🐺 Werewolf',     html: WEREWOLF_GUIDE_HTML,          color: '#1d4ed8' },
            { id: 'blackmarket', label: '🎩 Black Market', html: buildBlackMarketGuideHtml(),  color: '#b45309' },
            { id: 'spyfall',     label: '🕶️ Spyfall',     html: buildSpyfallGuideHtml(),      color: '#0f766e' },
            { id: 'avalon',      label: '🏰 อวาลอน',      html: buildAvalonGuideHtml(),       color: '#1d4ed8' },
            { id: 'undercover',  label: '🫥 คำใครไม่เหมือน', html: buildUndercoverGuideHtml(), color: '#b98a2c' },
            { id: 'liar',        label: '🃏 ไพ่โกหก',      html: buildLiarGuideHtml(),         color: '#b91c1c' },
            { id: 'poker5',      label: '♠ ไพ่ 5 ใบ', html: buildPokerGuideHtml('poker5'), color: '#166534' },
            { id: 'poker4',      label: '♦ สี่ใบเก',       html: buildPokerGuideHtml('poker4'), color: '#991b1b' },
            { id: 'codenames',   label: '🕵️ สายลับคำใบ้',  html: buildCodenamesGuideHtml(),     color: '#2563eb' },
            { id: 'pokdeng',     label: '🎴 ป๊อกเด้ง',     html: buildPokDengGuideHtml(),       color: '#b3262e' },
            { id: 'wavelength',  label: '📡 คลื่นความคิด', html: buildWavelengthGuideHtml(),    color: '#0f766e' },
            { id: 'drawguess',   label: '🎨 วาดแล้วทาย',   html: buildDrawGuessGuideHtml(),     color: '#0369a1' },
            { id: 'colorcards',  label: '🃏 ไพ่ทิ้งสี',     html: buildColorCardsGuideHtml(),    color: '#2563eb' },
            { id: 'setthi',      label: '💰 เศรษฐี',       html: buildSetthiGuideHtml(),        color: '#b8862b' }
        ];

        const tabsHtml = '<div class="global-guide-tabs">' +
            guides.map(function(g, i) {
                return '<button type="button" class="global-guide-tab-btn' + (i === 0 ? ' active' : '') +
                    '" data-guide-id="' + g.id + '">' + g.label + '</button>';
            }).join('') + '</div>';

        const panesHtml = guides.map(function(g, i) {
            return '<div class="global-guide-pane' + (i === 0 ? ' active' : '') + '" id="guide-pane-' + g.id + '">' + g.html + '</div>';
        }).join('');

        Swal.fire({
            title: '📖 วิธีเล่น',
            html: tabsHtml + panesHtml,
            background: '#111',
            color: '#fff',
            confirmButtonText: 'ปิด',
            confirmButtonColor: '#374151',
            customClass: {
                popup: 'bm-guide-popup',
                htmlContainer: 'bm-guide-popup-body'
            }
        });
    }

    $('#howToPlayBtn').on('click', function() {
        showGlobalGameGuide();
    });

    $(document).on('click', '.global-guide-tab-btn', function() {
        const id = $(this).data('guide-id');
        $('.global-guide-tab-btn').removeClass('active');
        $(this).addClass('active');
        $('.global-guide-pane').removeClass('active');
        $('#guide-pane-' + id).addClass('active');
    });

});
</script>

    function getModeAutofillPreset(modeId) {
        const modeConfig = gameModes.find(function(mode) { return mode.id === modeId; }) || {};
        const roomNames = {
            insider: 'เกมจับจอมบงการ',
            blackmarket: 'ตลาดมืดคืนนี้',
            werewolf: 'คืนล่าหมาป่า',
            spyfall: 'วงสายลับสถานที่',
            undercover: 'คำใครไม่เหมือน',
            coup: 'วงโค่นอำนาจ',
            avalon: 'อวาลอน',
            liar: 'ไพ่โกหก',
            poker5: 'ไพ่ 5 ใบ',
            poker4: 'สี่ใบเก',
            codenames: 'สายลับคำใบ้',
            pokdeng: 'ป๊อกเด้ง',
            wavelength: 'คลื่นความคิด',
            drawguess: 'วาดแล้วทาย',
            colorcards: 'ไพ่ทิ้งสี',
            setthi: 'เศรษฐี'
        };
        return {
            roomName: roomNames[modeId] || roomNames.insider,
            maxPlayers: Number(modeConfig.defaultMaxPlayers || modeConfig.maxPlayers || 6),
            roundTime: Number(modeConfig.defaultRoundTimeMinutes || 5)
        };
    }

    function getAutofilledRoomName(modeId) {
        return getModeAutofillPreset(modeId).roomName;
    }

    function resolveCreateGameMode() {
        const selectedInput = document.getElementById('selectedGameMode');
        const modeQuickPickGrid = document.getElementById('modeQuickPickGrid');
        const roomNameInput = document.getElementById('roomName');
        const fromInput = selectedInput && selectedInput.value;
        const fromGrid = modeQuickPickGrid && modeQuickPickGrid.dataset.selectedMode;
        const fromAutofill = roomNameInput && roomNameInput.dataset.autofilledMode;
        const rawRoomName = roomNameInput && roomNameInput.value.trim();
        let resolved = fromInput || fromGrid || fromAutofill || 'insider';

        gameModes.forEach(function(mode) {
            if (getModeAutofillPreset(mode.id).roomName === rawRoomName) {
                resolved = mode.id;
            }
        });

        return resolved;
    }

    // หมวดของแต่ละเกมในหน้าเลือกเกม (เกมหนึ่งอยู่ได้หลายหมวด) — เกมใหม่ไม่ใส่ก็ยังโผล่ในแท็บ "ทั้งหมด"
    const MODE_CATEGORIES = [
        { id: 'all', label: 'ทั้งหมด' },
        { id: 'word', label: '🗣️ ใบ้คำ · ทายคำ' },
        { id: 'bluff', label: '🎭 หักหลัง · จับโกหก' },
        { id: 'cards', label: '🃏 ไพ่' },
        { id: 'team', label: '🤝 เล่นเป็นทีม' },
        { id: 'board', label: '🎲 เกมกระดาน' }
    ];
    const MODE_CATEGORY_OF = {
        insider: ['word', 'bluff'],
        undercover: ['word', 'bluff'],
        spyfall: ['word', 'bluff'],
        drawguess: ['word'],
        codenames: ['word', 'team'],
        wavelength: ['word'],
        werewolf: ['bluff', 'team'],
        avalon: ['bluff', 'team'],
        blackmarket: ['bluff'],
        coup: ['bluff', 'cards'],
        liar: ['bluff', 'cards'],
        poker5: ['cards'],
        poker4: ['cards'],
        pokdeng: ['cards'],
        colorcards: ['cards'],
        setthi: ['board']
    };
    const NEW_MODE_IDS = ['drawguess', 'codenames', 'wavelength', 'colorcards'];
    NEW_MODE_IDS.push('setthi');

    function buildModeCategoryChipsHtml(modeItems) {
        const present = new Set();
        (modeItems || []).forEach(function(mode) { (MODE_CATEGORY_OF[mode.id] || []).forEach(function(cat) { present.add(cat); }); });
        return MODE_CATEGORIES
            .filter(function(cat) { return cat.id === 'all' || present.has(cat.id); })
            .map(function(cat, index) {
                return `<button type="button" class="gp-cat${index === 0 ? ' is-active' : ''}" data-cat="${cat.id}" aria-pressed="${index === 0}">${escapeHtml(cat.label)}</button>`;
            }).join('');
    }

    function buildModeQuickPickHtml(modeItems) {
        return (Array.isArray(modeItems) ? modeItems : []).map(function(mode, index) {
            const spotlight = getModeSpotlightMeta(mode.id);
            const cats = (MODE_CATEGORY_OF[mode.id] || []).join(' ');
            const isNew = NEW_MODE_IDS.includes(mode.id);
            return `
                <button type="button" class="mode-quick-card" data-mode-id="${escapeHtml(mode.id)}" data-cats="${escapeHtml(cats)}" aria-pressed="false" style="--i:${index}; --gp-accent:${spotlight.border};">
                    <span class="mq-art">
                        <img src="${escapeHtml(spotlight.cover || '')}" alt="" loading="lazy" decoding="async">
                        ${isNew ? '<span class="mq-new">ใหม่</span>' : ''}
                        <span class="mq-players">👥 ${Number(mode.minPlayers || 3)}–${Number(mode.maxPlayers || 10)}</span>
                    </span>
                    <span class="mq-body">
                        <strong class="mq-title">${escapeHtml(spotlight.title || mode.label)}</strong>
                        <span class="mq-tag">${escapeHtml(spotlight.badge || '')}</span>
                    </span>
                </button>
            `;
        }).join('');
    }

    function buildModeSpotlightHtml(modeId, modeItems) {
        const mode = (modeItems || []).find(function(item) { return item.id === modeId; }) || (modeItems || [])[0] || defaultGameModes[0];
        const spotlight = getModeSpotlightMeta(mode?.id);
        const bullets = (spotlight.bullets || []).map(function(item) { return `<li>${escapeHtml(item)}</li>`; }).join('');
        return `
            <div class="mode-spotlight">
                <img class="ms-art" src="${escapeHtml(spotlight.cover || '')}" alt="">
                <div class="ms-body">
                    <div class="ms-kicker">${escapeHtml(spotlight.badge || '')}</div>
                    <div class="ms-title">${escapeHtml(spotlight.title || mode?.label || '')}</div>
                    ${spotlight.summary ? `<p class="ms-summary">${escapeHtml(spotlight.summary)}</p>` : ''}
                </div>
                ${bullets ? `<ul class="ms-bullets">${bullets}</ul>` : ''}
                <button type="button" class="ms-change" id="modeChangeBtn">↺ เปลี่ยนเกม</button>
            </div>
        `;
    }
    const playerName = '<%= player.playerName %>';

    // Init player เพื่อให้ socket รับ events ได้
    socket.emit('initPlayer', playerId);
    socket.emit('leaveRoom', { playerId: playerId }, function() {
        socket.emit('getRoomList', function(response) {
            if (response && response.success) {
                rooms = response.rooms;
                renderRoomList();
            }
        });
    });

    let rooms = [];

    // แสดง message จาก URL param (ถ้ามี)
    const urlParams = new URLSearchParams(window.location.search);
    const msg = urlParams.get('msg');
    if (msg) {
        const messages = {
            'room_not_found': { icon: 'warning', title: 'ห้องไม่พบ', text: 'ห้องที่คุณต้องการเข้าไม่มีอยู่แล้ว' },
            'room_full': { icon: 'warning', title: 'ห้องเต็ม', text: 'ห้องนี้มีผู้เล่นครบแล้ว' },
            'room_locked': { icon: 'warning', title: 'ห้องล็อค', text: 'ห้องนี้ต้องการรหัสผ่าน' },
            'game_in_progress': { icon: 'info', title: 'เกมกำลังดำเนินอยู่', text: 'ไม่สามารถเข้าห้องได้ระหว่างเกม' },
            'join_failed': { icon: 'error', title: 'เข้าห้องไม่สำเร็จ', text: 'กรุณาลองใหม่อีกครั้ง' },
            'game_state_error': { icon: 'error', title: 'ข้อผิดพลาด', text: 'เกิดปัญหากับสถานะเกม กรุณาลองใหม่' },
            'kicked': { icon: 'warning', title: 'ถูกเตะออก', text: 'คุณถูกเตะออกจากห้อง' },
            'left_room': { icon: 'info', title: 'ออกจากห้องแล้ว', text: 'อยากกลับเข้า แตะห้องในรายการ' }
        };
        
        const msgConfig = messages[msg] || { icon: 'info', title: 'แจ้งเตือน', text: msg };
        Swal.fire({
            icon: msgConfig.icon,
            title: msgConfig.title,
            text: msgConfig.text,
            background: '#1e1e1e',
            color: '#fff',
            confirmButtonColor: '#e74c3c',
            timer: 4000,
            timerProgressBar: true
        });
        
        // ลบ param ออกจาก URL (ไม่ให้ popup ซ้ำเวลา refresh)
        // ไม่ใส่ playerId กลับเข้า URL — address bar ต้องสะอาดให้ก๊อปลิงก์แชร์ได้
        window.history.replaceState({}, document.title, '/rooms');
    }

    // Render room list
    function renderRoomList() {
        const $roomList = $('#roomList');
        const $noRooms = $('#noRooms');
        
        $roomList.empty();
        
        if (rooms.length === 0) {
            $noRooms.show();
            return;
        }
        
        $noRooms.hide();
        
        rooms.forEach(function(room) {
            const isLocked = room.locked;
            const isPlaying = room.gameStatus === 'playing';
            const isFinished = room.gameStatus === 'finished';
            const isStuck = room.isStuck || (isPlaying && (room.onlineCount || 0) === 0);
            const isJoinable = room.isJoinable !== false && (!isPlaying || room.gameMode === 'wavelength') && !isStuck;
            const isDualTraitor = room.settings && room.settings.dualTraitorMode && room.gameMode === 'insider';
            const onlineCount = room.onlineCount || 0;
            const playerPercentage = (onlineCount / room.maxPlayers) * 100;
            const statusText = isStuck
                ? 'ไม่มีคนออนไลน์ (อาจค้าง)'
                : (isPlaying ? 'กำลังดำเนินเกม' : (isFinished ? 'จบแล้ว / รอเริ่มใหม่' : 'กำลังรอผู้เล่น'));
            const statusColor = isStuck ? '#e74c3c' : (isPlaying ? '#e67e22' : (isFinished ? '#95a5a6' : '#2ecc71'));
            const gameModeLabel = room.gameModeLabel || (
                room.gameMode === 'werewolf' ? 'Werewolf'
                    : (room.gameMode === 'blackmarket' ? 'Black Market'
                        : (room.gameMode === 'spyfall' ? 'Spyfall' : room.gameMode === 'undercover' ? 'คำใครไม่เหมือน'
                            : (room.gameMode === 'coup' ? 'Coup'
                                : room.gameMode === 'avalon' ? 'อวาลอน'
                                : (room.gameMode === 'liar' ? 'ไพ่โกหก'
                                    : (room.gameMode === 'poker5' ? 'ไพ่ 5 ใบ'
                                        : (room.gameMode === 'poker4' ? 'สี่ใบเก'
                                            : (room.gameMode === 'pokdeng' ? 'ป๊อกเด้ง' : room.gameMode === 'wavelength' ? 'คลื่นความคิด' : room.gameMode === 'colorcards' ? 'ไพ่ทิ้งสี' : room.gameMode === 'setthi' ? 'เศรษฐี' : 'Insider')))))))
            );
            const modeBadgeStyle = room.gameMode === 'werewolf'
                ? 'background: linear-gradient(135deg, #34495e, #111827);'
                : (room.gameMode === 'blackmarket'
                    ? 'background: linear-gradient(135deg, #7f1d1d, #111111); color:#fde68a; border:1px solid rgba(251,191,36,0.35);'
                    : (room.gameMode === 'spyfall'
                        ? 'background: linear-gradient(135deg, #0f766e, #134e4a); color:#ccfbf1; border:1px solid rgba(94,234,212,0.35);'
                        : room.gameMode === 'undercover' ? 'background: #1a2332; color:#f5c86b; border:1px solid rgba(245,200,107,0.45);'
                        : room.gameMode === 'wavelength' ? 'background: #10233a; color:#99f6e4; border:1px solid rgba(94,234,212,0.45);'
                        : (room.gameMode === 'coup'
                            ? 'background: linear-gradient(135deg, #6d28d9, #3b0764); color:#f4ecff; border:1px solid rgba(196,141,255,0.35);'
                            : room.gameMode === 'avalon'
                            ? 'background: linear-gradient(135deg, #1d4ed8, #0f1a3a); color:#dbeafe; border:1px solid rgba(110,163,245,0.4);'
                            : (room.gameMode === 'liar'
                                ? 'background: linear-gradient(135deg, #991b1b, #450a0a); color:#fecaca; border:1px solid rgba(248,113,113,0.4);'
                                : (room.gameMode === 'poker5'
                                    ? 'background: linear-gradient(135deg, #166534, #052e16); color:#bbf7d0; border:1px solid rgba(74,222,128,0.4);'
                                    : (room.gameMode === 'poker4'
                                        ? 'background: linear-gradient(135deg, #991b1b, #1c1917); color:#fecaca; border:1px solid rgba(248,113,113,0.35);'
                                        : (room.gameMode === 'setthi'
                                            ? 'background: #1a2332; color:#f5c86b; border:1px solid rgba(245,200,107,0.6);'
                                            : room.gameMode === 'colorcards'
                                            ? 'background: #1a2332; color:#f5c86b; border:1px solid rgba(96,165,250,0.5);'
                                        : (room.gameMode === 'pokdeng'
                                            ? 'background: #5c1419; color:#fde68a; border:1px solid rgba(245,200,107,0.4);'
                                            : (room.gameMode === 'drawguess'
                                                ? 'background: #12324a; color:#bae6fd; border:1px solid rgba(125,211,252,0.45);'
                                                : 'background: linear-gradient(135deg, #e67e22, #d35400);')))))))));
            const roomCard = `
                <div class="room-card${isJoinable ? '' : ' room-card-disabled'}" data-room-id="${room.roomId}" data-joinable="${isJoinable ? '1' : '0'}" style="${isJoinable ? '' : 'opacity:0.72; cursor:not-allowed;'}">
                    <div class="room-card-header">
                        <div class="room-card-title">
                            <h3>${escapeHtml(room.name)}</h3>
                            <p class="room-card-id">Room ID: <strong>${room.roomId}</strong></p>
                        </div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <span style="${modeBadgeStyle} padding: 4px 10px; border-radius: 12px; font-size: 0.75em; font-weight: 700; white-space: nowrap;">${escapeHtml(gameModeLabel)}</span>
                            ${isDualTraitor ? '<span style="background: linear-gradient(135deg, #e74c3c, #c0392b); padding: 4px 10px; border-radius: 12px; font-size: 0.75em; font-weight: 700; white-space: nowrap;">🔴🔴 2 จอมบงการ</span>' : ''}
                            ${isLocked ? '<span class="room-lock-icon">🔒</span>' : ''}
                        </div>
                    </div>
                    <div class="room-card-info">
                        <div class="room-info-item">
                            <span class="room-info-icon">👥</span>
                            <span><strong>ผู้เล่น:</strong> ${onlineCount} / ${room.maxPlayers}</span>
                        </div>
                        <div class="room-info-item">
                            <span class="room-info-icon">${isStuck ? '⚠️' : (isPlaying ? '🎮' : '⏳')}</span>
                            <span><strong>สถานะ:</strong> <span style="color: ${statusColor}">${statusText}</span></span>
                        </div>
                        <div style="margin-top: 10px; height: 6px; background: #333; border-radius: 3px; overflow: hidden;">
                            <div style="height: 100%; background: linear-gradient(90deg, #e74c3c, #c0392b); width: ${playerPercentage}%; transition: width 0.3s;"></div>
                        </div>
                    </div>
                </div>
            `;
            $roomList.append(roomCard);
        });

        // Click handler for room cards
        $('.room-card').on('click', function() {
            const roomId = String($(this).attr('data-room-id') || '');
            const joinable = $(this).data('joinable') === 1 || $(this).data('joinable') === '1';
            const room = rooms.find(r => r.roomId === roomId);

            if (!joinable) {
                Swal.fire({
                    icon: 'info',
                    title: 'เข้าห้องนี้ไม่ได้',
                    text: room && room.gameStatus === 'playing'
                        ? 'เกมกำลังดำเนินอยู่ หรือไม่มีใครออนไลน์ — รอหัวหน้าห้องจบเกม/รีเซ็ต'
                        : 'ห้องนี้ยังไม่พร้อมรับผู้เล่นใหม่',
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c'
                });
                return;
            }
            
            if (room && room.locked && !isSiteAdminViewer) {
                // Prompt for password
                Swal.fire({
                    title: '🔒 ห้องนี้ถูกล็อค',
                    input: 'text',
                    inputLabel: 'กรอกรหัสผ่าน 4 หลัก',
                    inputPlaceholder: '0000',
                    inputAttributes: {
                        maxlength: 4,
                        pattern: '[0-9]*',
                        inputmode: 'numeric',
                        style: 'background: #1a1a1a; border: 2px solid #444; color: #fff; font-family: Rajdhani, sans-serif;'
                    },
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c',
                    cancelButtonColor: '#555',
                    showCancelButton: true,
                    confirmButtonText: '✅ เข้าร่วม',
                    cancelButtonText: '❌ ยกเลิก',
                    inputValidator: (value) => {
                        if (!value || !/^\d{4}$/.test(value)) {
                            return 'กรุณากรอกรหัสผ่าน 4 หลัก (ตัวเลขเท่านั้น)';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        joinRoom(roomId, result.value);
                    }
                });
            } else {
                joinRoom(roomId, null);
            }
        });
    }

    // Join room
    function joinRoom(roomId, password) {
        socket.emit('joinRoom', { roomId: roomId, password: password, playerId: playerId }, function(response) {
            if (response.success) {
                window.location.href = '/room/' + roomId + '?playerId=' + playerId;
            } else {
                Swal.fire({
                    icon: 'error',
                    title: '❌ เข้าห้องไม่สำเร็จ',
                    text: response.error || 'ลองอีกครั้ง หรือตรวจการเชื่อมต่ออินเทอร์เน็ต',
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c'
                });
            }
        });
    }


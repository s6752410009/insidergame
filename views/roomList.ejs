<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
    :root {
        --room-bg: #09090b;
        --room-panel: rgba(18, 18, 20, 0.86);
        --room-panel-soft: rgba(255, 255, 255, 0.05);
        --room-line: rgba(255, 255, 255, 0.1);
        --room-gold: #f5c86b;
        --room-gold-soft: rgba(245, 200, 107, 0.2);
        --room-red: #b91c1c;
        --room-text: #f5efe3;
        --room-muted: #b8ada0;
        --room-shadow: 0 32px 100px rgba(0, 0, 0, 0.52);
    }

    body.content {
        background:
            radial-gradient(circle at 8% 10%, rgba(127, 29, 29, 0.42), transparent 18%),
            radial-gradient(circle at 92% 0%, rgba(180, 83, 9, 0.18), transparent 16%),
            linear-gradient(180deg, #09090b 0%, #110d0c 45%, #17110f 100%);
    }

    .room-list-container {
        position: relative;
        max-width: 1440px;
        margin: 20px auto 36px;
        padding: 20px;
        font-family: 'Rajdhani', sans-serif;
        color: var(--room-text);
    }

    .room-list-shell {
        position: relative;
        overflow: hidden;
        border-radius: 34px;
        border: 1px solid rgba(245, 200, 107, 0.16);
        background:
            linear-gradient(145deg, rgba(12, 12, 14, 0.98), rgba(26, 17, 15, 0.94)),
            var(--room-bg);
        box-shadow: var(--room-shadow);
        isolation: isolate;
    }

    .room-list-shell::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255,255,255,0.05) 0.7px, transparent 0.7px);
        background-size: 16px 16px;
        opacity: 0.18;
        pointer-events: none;
    }

    .room-list-shell::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(115deg, rgba(245, 200, 107, 0.06), transparent 18%, transparent 70%, rgba(116, 185, 255, 0.04)),
            radial-gradient(circle at top center, rgba(245, 200, 107, 0.08), transparent 32%);
        pointer-events: none;
        z-index: 0;
    }
    
    .room-list-header {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 24px 26px 22px;
        margin-bottom: 0;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--room-line);
        background:
            radial-gradient(circle at top left, rgba(127, 29, 29, 0.32), transparent 34%),
            linear-gradient(135deg, rgba(127, 29, 29, 0.22), rgba(17, 17, 17, 0.72));
    }

    .room-list-header::after {
        content: '';
        position: absolute;
        left: 26px;
        right: 26px;
        bottom: 0;
        height: 1px;
        background: linear-gradient(90deg, rgba(245, 200, 107, 0.24), transparent 32%, transparent 68%, rgba(245, 200, 107, 0.2));
    }

    .room-hero {
        display: grid;
        gap: 6px;
        max-width: 680px;
    }

    .room-kicker {
        color: var(--room-gold);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }
    
    /* กล่องดำหลักสำหรับลิสต์ห้อง (เหมือนกรอบโปรไฟล์ในรูปที่ 2) */
    .room-panel {
        position: relative;
        z-index: 1;
        margin: 22px;
        padding: 22px;
        border-radius: 28px;
        border: 1px solid var(--room-line);
        background:
            linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02)),
            var(--room-panel);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 18px 42px rgba(0,0,0,0.24);
        min-height: 260px;
    }

    /* Popup สร้างห้อง/แก้ไขห้อง - Modern Style */
    .room-popup {
        max-width: 480px !important;
        border-radius: 20px !important;
        border: 3px solid #333 !important;
        background: linear-gradient(145deg, #1a1a2e 0%, #16213e 100%) !important;
        box-shadow: 0 20px 60px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.05) inset !important;
        padding: 0 !important;
        overflow: hidden !important;
    }
    
    .room-popup .swal2-title {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        margin: 0 !important;
        padding: 20px 24px !important;
        font-family: 'Orbitron', sans-serif !important;
        font-size: 1.4em !important;
        font-weight: 700 !important;
        color: #fff !important;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .room-popup .swal2-html-container {
        margin: 0 !important;
        padding: 24px !important;
        overflow: visible !important;
    }
    
    .room-popup .swal2-actions {
        padding: 0 24px 24px !important;
        gap: 12px !important;
    }
    
    .room-form-group {
        margin-bottom: 20px;
    }
    
    .room-form-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        font-weight: 600;
        color: #aaa;
        font-size: 0.95em;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .room-form-label .icon {
        font-size: 1.1em;
    }
    
    .room-form-input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid #333;
        border-radius: 12px;
        background: #0d0d1a;
        color: #fff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.1em;
        font-weight: 600;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }
    
    .room-form-input:focus {
        outline: none;
        border-color: #e74c3c;
        box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.2);
    }
    
    .room-form-input::placeholder {
        color: #555;
        font-weight: 400;
    }
    
    /* Slider Style */
    .room-slider-container {
        position: relative;
        padding: 10px 0;
    }
    
    .room-slider {
        appearance: none;
        -webkit-appearance: none;
        width: 100%;
        height: 8px;
        border-radius: 4px;
        background: linear-gradient(90deg, #333 0%, #333 100%);
        outline: none;
        transition: all 0.3s;
    }
    
    .room-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        cursor: pointer;
        border: 3px solid #fff;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
        transition: all 0.2s;
    }
    
    .room-slider::-webkit-slider-thumb:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(231, 76, 60, 0.6);
    }
    
    .room-slider::-moz-range-thumb {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        cursor: pointer;
        border: 3px solid #fff;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
    }
    
    .room-slider-value {
        position: absolute;
        right: 0;
        top: -5px;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: #fff;
        padding: 6px 14px;
        border-radius: 20px;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1em;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
    }
    
    /* Checkbox Style */
    .room-checkbox-container {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        background: #0d0d1a;
        border: 2px solid #333;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s;
    }
    
    .room-checkbox-container:hover {
        border-color: #e74c3c;
        background: rgba(231, 76, 60, 0.1);
    }
    
    .room-checkbox-container.checked {
        border-color: #e74c3c;
        background: rgba(231, 76, 60, 0.15);
    }
    
    .room-checkbox {
        display: none;
    }
    
    .room-checkbox-custom {
        width: 24px;
        height: 24px;
        border: 2px solid #555;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
        font-size: 14px;
    }
    
    .room-checkbox-container.checked .room-checkbox-custom {
        background: #e74c3c;
        border-color: #e74c3c;
    }
    
    .room-checkbox-text {
        flex: 1;
        font-weight: 600;
        color: #fff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.05em;
    }
    
    /* Button Styles */
    .room-btn-confirm {
        padding: 14px 28px !important;
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%) !important;
        border: none !important;
        border-radius: 12px !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 700 !important;
        font-size: 1.1em !important;
        cursor: pointer;
        transition: all 0.3s !important;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
    }
    
    .room-btn-confirm:hover {
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 25px rgba(231, 76, 60, 0.4) !important;
    }
    
    .room-btn-cancel {
        padding: 14px 28px !important;
        background: transparent !important;
        border: 2px solid #555 !important;
        border-radius: 12px !important;
        color: #aaa !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 700 !important;
        font-size: 1.1em !important;
        cursor: pointer;
        transition: all 0.3s !important;
    }
    
    .room-btn-cancel:hover {
        border-color: #888 !important;
        color: #fff !important;
        background: rgba(255,255,255,0.05) !important;
    }
    
    .room-list-header h1 {
        margin: 0;
        color: var(--room-text);
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        line-height: 1;
        text-shadow: 0 0 20px rgba(245, 200, 107, 0.12);
        letter-spacing: 0.06em;
    }

    .room-hero-copy {
        color: var(--room-muted);
        font-size: 1rem;
        max-width: 62ch;
    }

    .room-feature-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }

    .room-feature-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        font-weight: 700;
        color: var(--room-text);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }

    .room-feature-pill.highlight {
        border-color: rgba(245, 200, 107, 0.28);
        color: #fde68a;
    }
    
    .room-controls {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        max-width: 480px;
    }
    
    #searchRoomInput {
        padding: 12px 16px;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 16px;
        width: 280px;
        background: rgba(255,255,255,0.06);
        color: var(--room-text);
        font-family: 'Rajdhani', sans-serif;
        font-size: 1em;
        transition: all 0.3s;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }
    
    #searchRoomInput:focus {
        outline: none;
        border-color: rgba(245, 200, 107, 0.34);
        box-shadow: 0 0 0 3px rgba(245, 200, 107, 0.14);
    }
    
    #searchRoomInput::placeholder {
        color: #8f8377;
    }
    
    .btn-room {
        padding: 12px 20px;
        border: 1px solid transparent;
        border-radius: 16px;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        font-size: 1em;
        cursor: pointer;
        transition: all 0.3s;
        letter-spacing: 0.06em;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }
    
    #refreshBtn {
        background: rgba(255,255,255,0.08);
        border-color: rgba(255,255,255,0.12);
        color: var(--room-text);
    }
    
    #refreshBtn:hover {
        background: rgba(255,255,255,0.12);
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.24);
    }
    
    #createRoomBtn {
        background: linear-gradient(135deg, #9a3412, #7f1d1d);
        border-color: rgba(245, 200, 107, 0.16);
        color: #fff;
    }
    
    #createRoomBtn:hover {
        background: linear-gradient(135deg, #b45309, #991b1b);
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.28);
    }
    
    #roomList {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
    }
    
    .room-card {
        background:
            radial-gradient(circle at top right, rgba(245, 200, 107, 0.12), transparent 38%),
            linear-gradient(145deg, rgba(251,191,36,0.08), rgba(127,29,29,0.08));
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 24px;
        padding: 25px;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 18px 32px rgba(0,0,0,0.16);
        position: relative;
        overflow: hidden;
    }
    
    .room-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, rgba(245, 200, 107, 0.2), transparent);
        transform: scaleX(0);
        transition: transform 0.3s;
    }
    
    .room-card:hover {
        transform: translateY(-5px);
        border-color: rgba(245, 200, 107, 0.22);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 22px 36px rgba(0,0,0,0.2);
    }
    
    .room-card:hover::before {
        transform: scaleX(1);
    }
    
    .room-card-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 20px;
    }
    
    .room-card-title {
        flex: 1;
    }
    
    .room-card-title h3 {
        margin: 0 0 8px 0;
        color: var(--room-text);
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.3em;
    }
    
    .room-card-id {
        margin: 0;
        color: var(--room-muted);
        font-size: 0.9em;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .room-card-id strong {
        color: var(--room-gold);
        font-weight: 600;
    }
    
    .room-lock-icon {
        font-size: 2em;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
    }
    
    .room-card-info {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    
    .room-info-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--room-text);
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.1em;
    }
    
    .room-info-item strong {
        color: #fff;
        font-weight: 600;
    }
    
    .room-info-icon {
        font-size: 1.3em;
    }
    
    #noRooms {
        text-align: center;
        padding: 60px 40px;
        color: var(--room-muted);
        display: none;
    }
    
    #noRooms p {
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.3em;
        margin: 10px 0;
    }
    
    #noRooms p:first-child {
        font-size: 1.6em;
        color: var(--room-text);
        font-weight: 600;
    }

    .page-footer-actionbar {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 12px;
    }

    .page-footer-actionbar a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        min-width: min(320px, calc(100vw - 32px));
        padding: 8px 20px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(255,255,255,0.08);
        color: var(--room-text);
        text-decoration: none;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
        font-weight: 700;
    }

    @media (max-width: 900px) {
        .room-list-header {
            align-items: flex-start;
        }

        .room-controls {
            justify-content: flex-start;
        }
    }

    @media (max-width: 640px) {
        .room-list-container {
            padding: 8px;
            margin-top: 8px;
        }

        .room-list-shell {
            border-radius: 24px;
        }

        .room-list-header,
        .room-panel {
            padding: 14px;
        }

        .room-panel {
            margin: 14px;
            padding-left: 14px;
            padding-right: 14px;
        }

        .page-footer-actionbar {
            padding: 0 max(12px, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(12px, env(safe-area-inset-left));
        }

        .page-footer-actionbar a {
            width: 100%;
            min-width: 0;
        }

        #searchRoomInput {
            width: 100%;
        }
    }
    
    /* SweetAlert2 Dark Theme */
    .swal2-popup {
        background: #1e1e1e !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
    }
    
    .swal2-title {
        color: #fff !important;
        font-family: 'Orbitron', sans-serif !important;
        font-weight: 700 !important;
    }
    
    .swal2-content {
        color: #ddd !important;
    }
    
    .swal2-input, .swal2-select {
        background: #1a1a1a !important;
        border: 2px solid #444 !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
    }
    
    .swal2-input:focus, .swal2-select:focus {
        border-color: #e74c3c !important;
        box-shadow: 0 0 10px rgba(231, 76, 60, 0.3) !important;
    }
    
    .swal2-confirm {
        background: #e74c3c !important;
        border-color: #c0392b !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 600 !important;
    }
    
    .swal2-confirm:hover {
        background: #c0392b !important;
    }
    
    .swal2-cancel {
        background: #555 !important;
        border-color: #444 !important;
        color: #fff !important;
        font-family: 'Rajdhani', sans-serif !important;
        font-weight: 600 !important;
    }
    
    .swal2-cancel:hover {
        background: #666 !important;
    }

    #howToPlayBtn {
        background: linear-gradient(135deg, #312e81, #1e1b4b);
        border-color: rgba(129, 140, 248, 0.3);
        color: #c7d2fe;
    }
    #howToPlayBtn:hover {
        background: linear-gradient(135deg, #3730a3, #312e81);
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(99, 102, 241, 0.28);
        border-color: rgba(129, 140, 248, 0.5);
        color: #e0e7ff;
    }

    /* ─── Guide popup styles ─── */
    .bm-guide-popup {
        max-width: min(520px, 96vw) !important;
        padding: 0 !important;
        overflow: hidden !important;
        background: #111 !important;
        border: 1px solid rgba(129, 140, 248, 0.25) !important;
        border-radius: 20px !important;
    }
    .bm-guide-popup .swal2-title {
        background: linear-gradient(135deg, #312e81, #111) !important;
        color: #c7d2fe !important;
        font-family: 'Orbitron', sans-serif !important;
        font-size: 1.05em !important;
        padding: 14px 16px !important;
        margin: 0 !important;
    }
    .bm-guide-popup .swal2-html-container {
        margin: 0 !important;
        padding: 0 !important;
        max-height: min(72vh, 600px);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }
    .bm-guide-popup .swal2-actions { margin: 0 !important; padding: 12px 16px 16px !important; }
    .bm-guide-inner { padding: 14px 16px 8px; color: #ddd; font-size: 0.92em; line-height: 1.5; text-align: left; }
    .bm-guide-lead { margin: 0 0 12px; color: #fde68a; font-weight: 700; }
    .bm-guide-section {
        margin-bottom: 12px; padding: 12px 14px; border-radius: 12px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(129,140,248,0.18);
    }
    .bm-guide-section h4 { margin: 0 0 8px; color: #fff; font-size: 0.98em; font-weight: 700; }
    .bm-guide-section ul, .bm-guide-section ol { margin: 6px 0 0; padding-left: 18px; }
    .bm-guide-section li { margin-bottom: 4px; }
    .bm-guide-muted { margin: 8px 0 0; color: #9aa3b2; font-size: 0.86em; }
    .bm-guide-role-grid { display: grid; gap: 8px; margin-top: 8px; }
    .bm-guide-role {
        padding: 10px 12px; border-radius: 10px;
        background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06);
    }
    .bm-guide-role strong { color: #fde68a; display: block; margin-bottom: 4px; }
    .bm-guide-role span { color: #ccc; font-size: 0.9em; }
    .bm-guide-actions { display: grid; gap: 6px; margin-top: 8px; }
    .bm-guide-action { display: flex; gap: 8px; align-items: flex-start; font-size: 0.9em; }
    .bm-guide-action b { color: #fff; min-width: 5.5em; flex-shrink: 0; }
    .global-guide-tabs { display: flex; gap: 6px; flex-wrap: wrap; padding: 12px 16px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .global-guide-tab-btn {
        border: none; padding: 8px 12px; border-radius: 8px 8px 0 0;
        color: #aaa; cursor: pointer; font-family: 'Rajdhani', sans-serif;
        font-weight: 700; font-size: 0.88em; background: transparent;
        transition: all 0.2s;
    }
    .global-guide-tab-btn.active { background: rgba(255,255,255,0.1); color: #fff; }
    .global-guide-pane { display: none; }
    .global-guide-pane.active { display: block; }
</style>

<div class="room-list-container">
    <div class="room-list-shell">
        <div class="room-list-header">
            <div class="room-hero">
                <div class="room-kicker">🎲 รายชื่อห้อง</div>
                <h1>🎮 ห้องเกม</h1>
                <div class="room-hero-copy">เลือกห้องที่เปิดอยู่ หรือกดสร้างห้องใหม่แล้วรอคนเข้ามาครบ</div>
            </div>
            <div class="room-controls">
                <input type="text" id="searchRoomInput" placeholder="🔍 ค้นหาห้องด้วยเลข Room ID">
                <button id="howToPlayBtn" class="btn-room">📖 วิธีเล่น</button>
                <button id="refreshBtn" class="btn-room">🔄 รีเฟรช</button>
                <button id="createRoomBtn" class="btn-room">➕ สร้างห้อง</button>
            </div>
        </div>

        <div class="room-panel">
            <div id="roomList">
                <!-- skeleton ระหว่างรอรายชื่อห้องจาก socket — กันหน้าโล่งเปล่าตอนเปิด -->
                <div class="skeleton-card"><span class="skeleton-line w40"></span><span class="skeleton-line w70"></span></div>
                <div class="skeleton-card"><span class="skeleton-line w55"></span><span class="skeleton-line w65"></span></div>
                <div class="skeleton-card"><span class="skeleton-line w45"></span><span class="skeleton-line w75"></span></div>
            </div>

            <div id="noRooms">
                <p>ยังไม่มีห้องเปิดอยู่ตอนนี้</p>
                <p>กด "สร้างห้อง" เพื่อเปิดวงใหม่แล้วรอคนเข้ามาเล่น</p>
            </div>
        </div>
    </div>
</div>

<%- contentFor('footer') %>
<div class="page-footer-actionbar">
    <a href="/">← กลับหน้าหลัก</a>
</div>

<%- contentFor('script') %>
<script>
$(function() {
    const socket = window.appSocket || io();
    const playerId = '<%= player.playerId %>';
    const isSiteAdminViewer = <%= player.isSiteAdmin ? 'true' : 'false' %>;
    const defaultGameModes = [
        { id: 'insider', label: 'Insider', description: 'เกมจับจอมบงการและอ่านเกม', minPlayers: 3, maxPlayers: 10 },
        { id: 'blackmarket', label: 'Black Market', description: 'ตลาดมืด 4-7 คน กวาดของเถื่อน เปิดดีล และหักหลัง', minPlayers: 4, maxPlayers: 7 },
        { id: 'werewolf', label: 'Werewolf', description: 'เกมล่าหมาป่าที่มีบทพิเศษ กลางคืนใช้สกิล กลางวันคุยและโหวต', minPlayers: 3, maxPlayers: 10 },
        { id: 'spyfall', label: 'Spyfall', description: 'สายลับในสถานที่ 4–8 คน — แต่ละคนมีบทในที่นั้น สายลับไม่รู้ที่ ถามตอบแล้วโหวตจับ', minPlayers: 4, maxPlayers: 8 },
        { id: 'coup', label: 'Coup', description: 'เกมโค่นอำนาจ 2–6 คน — โกหกได้ ท้าได้ ใครเหลือการ์ดคนสุดท้ายชนะ', minPlayers: 2, maxPlayers: 6 }
    ];
    const serverModeDefaults = <%- safeJson(typeof gameModeDefaults !== 'undefined' ? gameModeDefaults : []) %>;
    const gameModes = defaultGameModes.reduce(function(result, fallbackMode) {
        const serverModes = <%- safeJson(typeof gameModes !== 'undefined' ? gameModes : []) %>;
        const matchedMode = serverModes.find(function(mode) { return mode.id === fallbackMode.id; });
        const adminDefaults = serverModeDefaults.find(function(mode) { return mode.id === fallbackMode.id; }) || {};
        result.push(Object.assign({}, fallbackMode, matchedMode || {}, adminDefaults));
        return result;
    }, []);
    const werewolfRoleOptions = <%- safeJson(typeof werewolfRoleOptions !== 'undefined' ? werewolfRoleOptions : []) %>;
    const werewolfRoleVisuals = {
        werewolf: { emoji: 'W', teamLabel: 'ฝั่งหมาป่า' },
        alphaWolf: { emoji: '👑', teamLabel: 'หมาป่านำทีม' },
        seer: { emoji: '🔮', teamLabel: 'สายอ่านเกม' },
        doctor: { emoji: '💉', teamLabel: 'สายช่วยทีม' },
        witch: { emoji: '🧪', teamLabel: 'สายพลิกเกม' },
        fool: { emoji: '🤪', teamLabel: 'บทเดี่ยว' },
        bodyguard: { emoji: '🛡️', teamLabel: 'สายกันตาย' },
        mayor: { emoji: '🎖️', teamLabel: 'สายคุมโหวต' },
        revealer: { emoji: '💥', teamLabel: 'สายเสี่ยงแตก' }
    };
    const werewolfRolePresets = [
        {
            id: 'classic-pack',
            name: 'คลาสสิก',
            tagline: 'อ่านง่าย เล่นลื่น',
            minPlayers: 6,
            roles: ['werewolf', 'seer', 'doctor', 'witch', 'bodyguard']
        },
        {
            id: 'mindgame-pack',
            name: 'อ่านใจ',
            tagline: 'โกหกกันมันขึ้น',
            minPlayers: 7,
            roles: ['werewolf', 'alphaWolf', 'seer', 'doctor', 'mayor', 'bodyguard', 'fool']
        },
        {
            id: 'chaos-pack',
            name: 'ปั่นจัด',
            tagline: 'เช้าละเรื่อง',
            minPlayers: 8,
            roles: ['werewolf', 'alphaWolf', 'seer', 'witch', 'fool', 'mayor', 'revealer', 'bodyguard']
        }
    ];

    function matchesWerewolfPreset(selectedRoleIds, preset) {
        const selected = [...(Array.isArray(selectedRoleIds) ? selectedRoleIds : [])].sort();
        const presetRoles = [...preset.roles].sort();
        return selected.length === presetRoles.length && presetRoles.every((roleId, index) => roleId === selected[index]);
    }

    function renderSelectedWerewolfRoleSummary(selectedRoleIds) {
        const selected = Array.isArray(selectedRoleIds) ? selectedRoleIds : [];
        const selectedRoles = werewolfRoleOptions.filter(role => selected.includes(role.id));
        const chips = selectedRoles.map(role => {
            const visual = werewolfRoleVisuals[role.id] || { emoji: '🎭', teamLabel: 'พิเศษ' };
            return `<span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; background:rgba(255,255,255,0.08); color:#fff; font-size:0.85em;">${visual.emoji} ${role.thaiName}</span>`;
        }).join('');

        if (!selectedRoles.length) {
            return '<div style="color:#f8d189; font-size:0.9em;">ยังไม่ได้ติ๊กบทพิเศษเพิ่ม ระบบจะเติมหมาป่าปกติให้เองถ้าจำเป็น</div>';
        }

        return `
            <div style="display:grid; gap:8px;">
                <div style="color:#8fd3ff; font-size:0.88em;">ตอนนี้เปิดอยู่ ${selectedRoles.length} บท ระบบจะเติมชาวบ้านให้ครบจำนวนคนอัตโนมัติ</div>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">${chips}</div>
            </div>
        `;
    }

    function syncWerewolfRolePicker(container) {
        if (!container) {
            return;
        }

        const selected = collectWerewolfRoleSelection(container);
        const summary = container.querySelector('.werewolf-role-summary');
        if (summary) {
            summary.innerHTML = renderSelectedWerewolfRoleSummary(selected);
        }

        container.querySelectorAll('.werewolf-role-preset').forEach(button => {
            const preset = werewolfRolePresets.find(item => item.id === button.dataset.presetId);
            button.classList.toggle('active', !!preset && matchesWerewolfPreset(selected, preset));
            button.style.borderColor = button.classList.contains('active') ? '#f39c12' : 'rgba(255,255,255,0.08)';
            button.style.background = button.classList.contains('active') ? 'linear-gradient(135deg, rgba(243,156,18,0.24), rgba(192,57,43,0.18))' : 'rgba(255,255,255,0.04)';
        });
    }

    function applyWerewolfRolePreset(container, presetId) {
        const preset = werewolfRolePresets.find(item => item.id === presetId);
        if (!container || !preset) {
            return;
        }

        container.querySelectorAll('.werewolf-role-option').forEach(option => {
            const checkbox = option.querySelector('input');
            const enabled = preset.roles.includes(option.dataset.roleId);
            if (checkbox) {
                checkbox.checked = enabled;
            }
            option.classList.toggle('checked', enabled);
        });
    }

    function buildWerewolfRoleSelectionHtml(selectedRoleIds) {
        const selected = Array.isArray(selectedRoleIds) ? selectedRoleIds : [];

        return `
            <div style="display:grid; gap:12px;">
                <div style="display:grid; gap:8px;">
                    <div style="color:#fff; font-weight:700;">เลือกแนวห้องเร็ว ๆ</div>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:8px;">
                        ${werewolfRolePresets.map(preset => `
                            <button type="button" class="werewolf-role-preset ${matchesWerewolfPreset(selected, preset) ? 'active' : ''}" data-preset-id="${preset.id}" data-min-players="${preset.minPlayers}" style="border:1px solid ${matchesWerewolfPreset(selected, preset) ? '#f39c12' : 'rgba(255,255,255,0.08)'}; border-radius:12px; background:${matchesWerewolfPreset(selected, preset) ? 'linear-gradient(135deg, rgba(243,156,18,0.24), rgba(192,57,43,0.18))' : 'rgba(255,255,255,0.04)'}; color:#fff; padding:10px 12px; text-align:left; cursor:pointer; font-family:Rajdhani, sans-serif;">
                                <div style="font-weight:700; font-size:1em;">${preset.name}</div>
                                <div style="color:#f8d189; font-size:0.82em;">${preset.tagline}</div>
                                <div style="color:#97a4bf; font-size:0.78em; margin-top:4px;">แนะนำ ${preset.minPlayers}+ คน</div>
                            </button>
                        `).join('')}
                    </div>
                </div>
                <div class="werewolf-role-summary" style="padding:12px; border-radius:12px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08);">
                    ${renderSelectedWerewolfRoleSummary(selected)}
                </div>
                <details style="padding:12px; border-radius:12px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
                    <summary style="cursor:pointer; color:#8fd3ff; font-weight:700;">ปรับบทเองทีละบท</summary>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:8px; margin-top:12px;">
                        ${werewolfRoleOptions.map(role => {
                            const visual = werewolfRoleVisuals[role.id] || { emoji: '🎭', teamLabel: 'พิเศษ' };
                            return `
                                <div class="room-checkbox-container werewolf-role-option ${selected.includes(role.id) ? 'checked' : ''}" data-role-id="${role.id}" style="margin-bottom:0; align-items:flex-start; gap:10px; padding:12px; border:1px solid rgba(255,255,255,0.08); border-radius:12px; background:rgba(255,255,255,0.03); justify-content:flex-start;">
                                    <input type="checkbox" class="room-checkbox" ${selected.includes(role.id) ? 'checked' : ''}>
                                    <div class="room-checkbox-custom">✓</div>
                                    <span class="room-checkbox-text" style="display:grid; gap:4px;">
                                        <strong>${visual.emoji} ${role.thaiName}</strong>
                                        <span style="color:#8fd3ff; font-size:0.8em;">${visual.teamLabel}</span>
                                        <span style="color:#aaa; font-size:0.85em; line-height:1.35;">${role.description}</span>
                                        ${role.winCondition ? `<span style="color:#a5b4fc; font-size:0.78em; line-height:1.35;">🏁 ${role.winCondition}</span>` : ''}
                                    </span>
                                </div>
                            `;
                        }).join('')}
                    </div>
                </details>
            </div>
        `;
    }

    function collectWerewolfRoleSelection(container) {
        return Array.from(container.querySelectorAll('.werewolf-role-option'))
            .filter(option => option.querySelector('input')?.checked)
            .map(option => option.dataset.roleId);
    }

    function buildGameModeOptionsHtml(modeItems) {
        return (Array.isArray(modeItems) ? modeItems : []).map(function(mode) {
            return `<option value="${escapeHtml(mode.id)}" data-min-players="${Number(mode.minPlayers || 3)}" data-max-players="${Number(mode.maxPlayers || 10)}">${escapeHtml(mode.label)} - ${escapeHtml(mode.description || '')}</option>`;
        }).join('');
    }

    function getModeSpotlightMeta(modeId) {
        const metaById = {
            insider: {
                tone: 'linear-gradient(135deg, rgba(230,126,34,0.22), rgba(192,57,43,0.12))',
                border: 'rgba(230,126,34,0.32)',
                badge: '🎯 ทายคำ จับคนโกง',
                title: 'Insider',
                summary: 'ทุกคนช่วยกันทายคำจากคำใบ้ แต่มี 1 คนรู้คำอยู่แล้วและแอบชี้นำ — ทายได้แล้วต้องหาให้เจอว่าใคร',
                bullets: ['3-10 คน', 'มีคนคุมเกม 1 คน', 'รอบละ 5 นาที', 'เหมาะกับมือใหม่']
            },
            blackmarket: {
                tone: 'linear-gradient(135deg, rgba(127,29,29,0.4), rgba(17,17,17,0.9))',
                border: 'rgba(245,200,107,0.34)',
                badge: '🎩 ซื้อขาย ต่อรอง',
                title: 'Black Market',
                summary: 'ซื้อของจากตลาดมืดมาสะสมแต้ม แต่ละคนมีบทลับและเป้าหมายต่างกัน ใครแต้มสูงสุดตอนจบชนะ',
                bullets: ['4-7 คน', 'มีบทลับ', 'ซื้อขาย–ต่อรอง', 'เกมยาวสุด']
            },
            werewolf: {
                tone: 'linear-gradient(135deg, rgba(52,73,94,0.26), rgba(17,24,39,0.9))',
                border: 'rgba(143,211,255,0.22)',
                badge: '🐺 ล่าหมาป่า',
                title: 'Werewolf',
                summary: 'เกมบทบาทซ่อนตัวสไตล์ปาร์ตี้ เล่นกลางวันคุย กลางคืนใช้สกิล',
                bullets: ['3-10 คน', 'มีสกิลกลางคืน', 'ชนะตามฝั่ง']
            },
            spyfall: {
                tone: 'linear-gradient(135deg, rgba(20,184,166,0.2), rgba(7,19,24,0.92))',
                border: 'rgba(94,234,212,0.28)',
                badge: '🕶️ สายลับ สถานที่',
                title: 'Spyfall',
                summary: 'ทุกคนรู้สถานที่และบทในที่นั้นยกเว้นสายลับ — คุยแล้วโหวตจับ',
                bullets: ['4-8 คน', 'บทในสถานที่คนละบท', 'รอบเดียวจบ', 'ไม่ต้องมีคนคุมเกม']
            },
            coup: {
                tone: 'linear-gradient(135deg, rgba(168,85,247,0.24), rgba(18,7,26,0.92))',
                border: 'rgba(196,141,255,0.32)',
                badge: '👑 โกหก ท้า โค่น',
                title: 'Coup',
                summary: 'ประกาศพลังของการ์ดที่ไม่มีก็ได้ — ใครไม่เชื่อก็ท้าได้ ใครเหลือการ์ดคนสุดท้ายชนะ',
                bullets: ['2-6 คน', 'โกหกได้ ท้าได้', 'จบใน 15 นาที', 'เล่น 2 คนก็ได้']
            }
        };

        return metaById[modeId] || metaById.insider;
    }

    function getModeAutofillPreset(modeId) {
        const modeConfig = gameModes.find(function(mode) { return mode.id === modeId; }) || {};
        const roomNames = {
            insider: 'เกมจับจอมบงการ',
            blackmarket: 'ตลาดมืดคืนนี้',
            werewolf: 'คืนล่าหมาป่า',
            spyfall: 'วงสายลับสถานที่',
            coup: 'วงโค่นอำนาจ'
        };
        return {
            roomName: roomNames[modeId] || roomNames.insider,
            maxPlayers: Number(modeConfig.defaultMaxPlayers || modeConfig.maxPlayers || 6),
            roundTime: Number(modeConfig.defaultRoundTimeMinutes || 5)
        };
    }

    function getAutofilledRoomName(modeId) {
        return getModeAutofillPreset(modeId).roomName;
    }

    function resolveCreateGameMode() {
        const selectedInput = document.getElementById('selectedGameMode');
        const modeQuickPickGrid = document.getElementById('modeQuickPickGrid');
        const roomNameInput = document.getElementById('roomName');
        const fromInput = selectedInput && selectedInput.value;
        const fromGrid = modeQuickPickGrid && modeQuickPickGrid.dataset.selectedMode;
        const fromAutofill = roomNameInput && roomNameInput.dataset.autofilledMode;
        const rawRoomName = roomNameInput && roomNameInput.value.trim();
        let resolved = fromInput || fromGrid || fromAutofill || 'insider';

        gameModes.forEach(function(mode) {
            if (getModeAutofillPreset(mode.id).roomName === rawRoomName) {
                resolved = mode.id;
            }
        });

        return resolved;
    }

    function buildModeQuickPickHtml(modeItems) {
        return (Array.isArray(modeItems) ? modeItems : []).map(function(mode) {
            const spotlight = getModeSpotlightMeta(mode.id);
            const badgeLabel = escapeHtml(spotlight.badge);
            const badgeColor = mode.id === 'werewolf' ? '#fff' : '#fde68a';

            return `
                <button type="button" class="mode-quick-card" data-mode-id="${escapeHtml(mode.id)}" style="cursor:pointer; border:1px solid ${spotlight.border}; border-radius:16px; background:${spotlight.tone}; color:#fff; padding:14px 14px 12px; text-align:left; font-family:Rajdhani, sans-serif; display:grid; gap:4px;">
                    <strong style="font-size:1.02rem; letter-spacing:0.02em; white-space:nowrap;">${escapeHtml(spotlight.title)}</strong>
                    <span style="justify-self:start; max-width:100%; padding:4px 9px; border-radius:999px; background:rgba(255,255,255,0.1); font-size:0.74em; font-weight:700; line-height:1.5; color:${badgeColor};">${badgeLabel}</span>
                    <div style="color:#aab3c5; font-size:0.8em;">${Number(mode.minPlayers || 3)}-${Number(mode.maxPlayers || 10)} คน</div>
                </button>
            `;
        }).join('');
    }

    function buildModeSpotlightHtml(modeId, modeItems) {
        const mode = (modeItems || []).find(function(item) { return item.id === modeId; }) || (modeItems || [])[0] || defaultGameModes[0];
        const spotlight = getModeSpotlightMeta(mode?.id);
        return `
            <div style="border:1px solid ${spotlight.border}; border-radius:18px; padding:16px; background:${spotlight.tone}; display:grid; gap:8px;">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
                    <div>
                        <div style="color:${mode?.id === 'blackmarket' ? '#fde68a' : '#8fd3ff'}; font-size:0.8em; font-weight:700; letter-spacing:0.08em; text-transform:uppercase;">${escapeHtml(spotlight.badge)}</div>
                        <div style="color:#fff; font-family:Orbitron, sans-serif; font-size:1.15rem; margin-top:4px;">${escapeHtml(spotlight.title)}</div>
                    </div>
                    <div style="padding:6px 10px; border-radius:999px; background:rgba(255,255,255,0.08); color:#fff; font-weight:700;">👥 ${Number(mode?.minPlayers || 3)}-${Number(mode?.maxPlayers || 10)} คน</div>
                </div>
            </div>
        `;
    }
    const playerName = '<%= player.playerName %>';

    // Init player เพื่อให้ socket รับ events ได้
    socket.emit('initPlayer', playerId);

    let rooms = [];

    // แสดง message จาก URL param (ถ้ามี)
    const urlParams = new URLSearchParams(window.location.search);
    const msg = urlParams.get('msg');
    if (msg) {
        const messages = {
            'room_not_found': { icon: 'warning', title: 'ห้องไม่พบ', text: 'ห้องที่คุณต้องการเข้าไม่มีอยู่แล้ว' },
            'room_full': { icon: 'warning', title: 'ห้องเต็ม', text: 'ห้องนี้มีผู้เล่นครบแล้ว' },
            'room_locked': { icon: 'warning', title: 'ห้องล็อค', text: 'ห้องนี้ต้องการรหัสผ่าน' },
            'game_in_progress': { icon: 'info', title: 'เกมกำลังดำเนินอยู่', text: 'ไม่สามารถเข้าห้องได้ระหว่างเกม' },
            'join_failed': { icon: 'error', title: 'เข้าห้องไม่สำเร็จ', text: 'กรุณาลองใหม่อีกครั้ง' },
            'game_state_error': { icon: 'error', title: 'ข้อผิดพลาด', text: 'เกิดปัญหากับสถานะเกม กรุณาลองใหม่' },
            'kicked': { icon: 'warning', title: 'ถูกเตะออก', text: 'คุณถูกเตะออกจากห้อง' }
        };
        
        const msgConfig = messages[msg] || { icon: 'info', title: 'แจ้งเตือน', text: msg };
        Swal.fire({
            icon: msgConfig.icon,
            title: msgConfig.title,
            text: msgConfig.text,
            background: '#1e1e1e',
            color: '#fff',
            confirmButtonColor: '#e74c3c',
            timer: 4000,
            timerProgressBar: true
        });
        
        // ลบ param ออกจาก URL (ไม่ให้ popup ซ้ำเวลา refresh)
        // ไม่ใส่ playerId กลับเข้า URL — address bar ต้องสะอาดให้ก๊อปลิงก์แชร์ได้
        window.history.replaceState({}, document.title, '/rooms');
    }

    // Render room list
    function renderRoomList() {
        const $roomList = $('#roomList');
        const $noRooms = $('#noRooms');
        
        $roomList.empty();
        
        if (rooms.length === 0) {
            $noRooms.show();
            return;
        }
        
        $noRooms.hide();
        
        rooms.forEach(function(room) {
            const isLocked = room.locked;
            const isPlaying = room.gameStatus === 'playing';
            const isFinished = room.gameStatus === 'finished';
            const isStuck = room.isStuck || (isPlaying && (room.onlineCount || 0) === 0);
            const isJoinable = room.isJoinable !== false && !isPlaying && !isStuck;
            const isDualTraitor = room.settings && room.settings.dualTraitorMode && room.gameMode === 'insider';
            const onlineCount = room.onlineCount || 0;
            const totalInRoom = room.totalPlayerCount != null ? room.totalPlayerCount : (room.playerCount || 0);
            const playerPercentage = (onlineCount / room.maxPlayers) * 100;
            const statusText = isStuck
                ? 'ไม่มีคนออนไลน์ (อาจค้าง)'
                : (isPlaying ? 'กำลังดำเนินเกม' : (isFinished ? 'จบแล้ว / รอเริ่มใหม่' : 'กำลังรอผู้เล่น'));
            const statusColor = isStuck ? '#e74c3c' : (isPlaying ? '#e67e22' : (isFinished ? '#95a5a6' : '#2ecc71'));
            const gameModeLabel = room.gameModeLabel || (
                room.gameMode === 'werewolf' ? 'Werewolf'
                    : (room.gameMode === 'blackmarket' ? 'Black Market'
                        : (room.gameMode === 'spyfall' ? 'Spyfall'
                            : (room.gameMode === 'coup' ? 'Coup' : 'Insider')))
            );
            const modeBadgeStyle = room.gameMode === 'werewolf'
                ? 'background: linear-gradient(135deg, #34495e, #111827);'
                : (room.gameMode === 'blackmarket'
                    ? 'background: linear-gradient(135deg, #7f1d1d, #111111); color:#fde68a; border:1px solid rgba(251,191,36,0.35);'
                    : (room.gameMode === 'spyfall'
                        ? 'background: linear-gradient(135deg, #0f766e, #134e4a); color:#ccfbf1; border:1px solid rgba(94,234,212,0.35);'
                        : (room.gameMode === 'coup'
                            ? 'background: linear-gradient(135deg, #6d28d9, #3b0764); color:#f4ecff; border:1px solid rgba(196,141,255,0.35);'
                            : 'background: linear-gradient(135deg, #e67e22, #d35400);')));
            const roomCard = `
                <div class="room-card${isJoinable ? '' : ' room-card-disabled'}" data-room-id="${room.roomId}" data-joinable="${isJoinable ? '1' : '0'}" style="${isJoinable ? '' : 'opacity:0.72; cursor:not-allowed;'}">
                    <div class="room-card-header">
                        <div class="room-card-title">
                            <h3>${escapeHtml(room.name)}</h3>
                            <p class="room-card-id">Room ID: <strong>${room.roomId}</strong></p>
                        </div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <span style="${modeBadgeStyle} padding: 4px 10px; border-radius: 12px; font-size: 0.75em; font-weight: 700; white-space: nowrap;">${escapeHtml(gameModeLabel)}</span>
                            ${isDualTraitor ? '<span style="background: linear-gradient(135deg, #e74c3c, #c0392b); padding: 4px 10px; border-radius: 12px; font-size: 0.75em; font-weight: 700; white-space: nowrap;">🔴🔴 2 จอมบงการ</span>' : ''}
                            ${isLocked ? '<span class="room-lock-icon">🔒</span>' : ''}
                        </div>
                    </div>
                    <div class="room-card-info">
                        <div class="room-info-item">
                            <span class="room-info-icon">👥</span>
                            <span><strong>ออนไลน์:</strong> ${onlineCount} / ${room.maxPlayers} <span style="color:#888;">(ในห้อง ${totalInRoom})</span></span>
                        </div>
                        <div class="room-info-item">
                            <span class="room-info-icon">${isStuck ? '⚠️' : (isPlaying ? '🎮' : '⏳')}</span>
                            <span><strong>สถานะ:</strong> <span style="color: ${statusColor}">${statusText}</span></span>
                        </div>
                        <div style="margin-top: 10px; height: 6px; background: #333; border-radius: 3px; overflow: hidden;">
                            <div style="height: 100%; background: linear-gradient(90deg, #e74c3c, #c0392b); width: ${playerPercentage}%; transition: width 0.3s;"></div>
                        </div>
                    </div>
                </div>
            `;
            $roomList.append(roomCard);
        });

        // Click handler for room cards
        $('.room-card').on('click', function() {
            const roomId = String($(this).attr('data-room-id') || '');
            const joinable = $(this).data('joinable') === 1 || $(this).data('joinable') === '1';
            const room = rooms.find(r => r.roomId === roomId);

            if (!joinable) {
                Swal.fire({
                    icon: 'info',
                    title: 'เข้าห้องนี้ไม่ได้',
                    text: room && room.gameStatus === 'playing'
                        ? 'เกมกำลังดำเนินอยู่ หรือไม่มีใครออนไลน์ — รอหัวหน้าห้องจบเกม/รีเซ็ต'
                        : 'ห้องนี้ยังไม่พร้อมรับผู้เล่นใหม่',
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c'
                });
                return;
            }
            
            if (room && room.locked && !isSiteAdminViewer) {
                // Prompt for password
                Swal.fire({
                    title: '🔒 ห้องนี้ถูกล็อค',
                    input: 'text',
                    inputLabel: 'กรอกรหัสผ่าน 4 หลัก',
                    inputPlaceholder: '0000',
                    inputAttributes: {
                        maxlength: 4,
                        pattern: '[0-9]*',
                        inputmode: 'numeric',
                        style: 'background: #1a1a1a; border: 2px solid #444; color: #fff; font-family: Rajdhani, sans-serif;'
                    },
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c',
                    cancelButtonColor: '#555',
                    showCancelButton: true,
                    confirmButtonText: '✅ เข้าร่วม',
                    cancelButtonText: '❌ ยกเลิก',
                    inputValidator: (value) => {
                        if (!value || !/^\d{4}$/.test(value)) {
                            return 'กรุณากรอกรหัสผ่าน 4 หลัก (ตัวเลขเท่านั้น)';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        joinRoom(roomId, result.value);
                    }
                });
            } else {
                joinRoom(roomId, null);
            }
        });
    }

    // Join room
    function joinRoom(roomId, password) {
        socket.emit('joinRoom', { roomId: roomId, password: password, playerId: playerId }, function(response) {
            if (response.success) {
                window.location.href = '/room/' + roomId + '?playerId=' + playerId;
            } else {
                Swal.fire({
                    icon: 'error',
                    title: '❌ เข้าห้องไม่สำเร็จ',
                    text: response.error || 'เกิดข้อผิดพลาด',
                    background: '#1e1e1e',
                    color: '#fff',
                    confirmButtonColor: '#e74c3c'
                });
            }
        });
    }

    // Create room popup
    $('#createRoomBtn').on('click', function() {
        Swal.fire({
            title: '⚙️ สร้างห้องใหม่',
            customClass: {
                popup: 'room-popup',
                confirmButton: 'room-btn-confirm',
                cancelButton: 'room-btn-cancel'
            },
            html: `
                <div style="font-family: 'Rajdhani', sans-serif;">
                    <div class="room-form-group">
                        <label class="room-form-label">
                            <span class="icon">🌙</span> เลือกแนวห้องเร็ว ๆ:
                        </label>
                        <div id="modeQuickPickGrid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(178px, 1fr)); gap:10px; margin-bottom:12px;">
                            ${buildModeQuickPickHtml(gameModes)}
                        </div>
                        <div id="modeSpotlight"></div>
                    </div>

                    <div class="room-form-group">
                        <label class="room-form-label">
                            <span class="icon">📝</span> ชื่อห้อง:
                        </label>
                        <input id="roomName" class="room-form-input" placeholder="ไม่กรอกได้ ระบบจะตั้งชื่อให้" maxlength="20">
                        <div style="margin-top:8px; color:#aaa; font-size:0.9em;">เลือกโหมดจากการ์ดด้านบนพอแล้ว ชื่อห้องปล่อยว่างได้</div>
                        <input id="selectedGameMode" type="hidden" value="insider">
                    </div>

                    <div class="room-form-group" id="werewolfWolfCountGroup" style="display:none;">
                        <label class="room-form-label">
                            <span class="icon">🐺</span> จำนวนหมาป่า:
                        </label>
                        <div id="createWolfCountSelector" style="display:flex; gap:8px; margin-top:4px;">
                            ${[1,2,3].map(function(n, index) {
                                const active = n === 2;
                                return `<button type="button" data-wolf-count="${n}" class="wolf-count-btn${active ? ' active' : ''}" style="flex:1; padding:10px 0; border-radius:10px; border:2px solid ${active ? '#e74c3c' : 'rgba(255,255,255,0.12)'}; background:${active ? 'rgba(231,76,60,0.2)' : 'rgba(255,255,255,0.04)'}; color:#fff; font-size:1.1em; cursor:pointer; font-family:Rajdhani,sans-serif; font-weight:700;">🐺 ${n} ตัว</button>`;
                            }).join('')}
                        </div>
                        <div style="margin-top:8px; color:#aaa; font-size:0.9em;">บทบาทอื่นสุ่มให้อัตโนมัติทั้งหมด และระบบจะปรับจำนวนหมาป่าสูงสุดตามจำนวนผู้เล่นให้เองถ้าตั้งเกิน</div>
                    </div>

                    <div class="room-form-group">
                        <label class="room-form-label">
                            <span class="icon">👥</span> จำนวนผู้เล่นสูงสุด:
                        </label>
                        <div class="room-slider-container">
                            <span class="room-slider-value" id="maxPlayersValue">5</span>
                            <input type="range" id="maxPlayers" class="room-slider" min="3" max="10" value="5">
                        </div>
                    </div>
                    
                    <div class="room-form-group" id="createRoundTimeGroup">
                        <label class="room-form-label">
                            <span class="icon" id="roundTimeLabelIcon">⏱️</span> <span id="roundTimeLabelText">เวลาเล่นต่อรอบ:</span>
                        </label>
                        <div class="room-slider-container">
                            <span class="room-slider-value" id="roundTimeValue">5 นาที</span>
                            <input type="range" id="roundTime" class="room-slider" min="1" max="10" value="5">
                        </div>
                    </div>
                    
                    <div class="room-form-group">
                        <label class="room-form-label">
                            <span class="icon">🔐</span> ความปลอดภัย:
                        </label>
                        <div class="room-checkbox-container" id="lockedContainer">
                            <input type="checkbox" id="locked" class="room-checkbox">
                            <div class="room-checkbox-custom">✓</div>
                            <span class="room-checkbox-text">🔒 ล็อคห้อง (ต้องใช้รหัสผ่าน)</span>
                        </div>
                    </div>

                    <div class="room-form-group">
                        <label class="room-form-label">
                            <span class="icon">🎮</span> รูปแบบการเล่น:
                        </label>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            <label style="flex:1; min-width:140px; display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:10px; border:2px solid rgba(245,200,107,0.45); background:rgba(245,200,107,0.08); cursor:pointer; color:#fff;">
                                <input type="radio" name="tableMode" value="inPerson" checked style="accent-color:#f5c86b;">
                                <span>🪑 เจอหน้า (ปิดจอได้)</span>
                            </label>
                            <label style="flex:1; min-width:140px; display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:10px; border:2px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.04); cursor:pointer; color:#ddd;">
                                <input type="radio" name="tableMode" value="remote" style="accent-color:#3498db;">
                                <span>📱 เล่นผ่านมือถือ</span>
                            </label>
                        </div>
                        <div style="margin-top:8px; color:#aaa; font-size:0.85em;">โหมดเจอหน้า: ปิดจอชั่วคราวได้ กลับมาภายใน ~2 นาทียังอยู่ที่เดิม ระบบล้างห้องค้างเร็วขึ้น</div>
                    </div>
                    
                    <div class="room-form-group" id="passwordGroup" style="display: none;">
                        <label class="room-form-label">
                            <span class="icon">🔑</span> รหัสผ่าน:
                        </label>
                        <input id="password" class="room-form-input" placeholder="รหัสผ่าน 4 หลัก" maxlength="4" pattern="[0-9]*" inputmode="numeric">
                    </div>
                </div>
            `,
            background: 'transparent',
            showCancelButton: true,
            confirmButtonText: '✅ สร้างห้อง',
            cancelButtonText: '❌ ยกเลิก',
            focusConfirm: false,
            didOpen: () => {
                // Slider handlers
                const maxPlayersSlider = document.getElementById('maxPlayers');
                const maxPlayersValue = document.getElementById('maxPlayersValue');
                const roundTimeSlider = document.getElementById('roundTime');
                const roundTimeValue = document.getElementById('roundTimeValue');
                const roundTimeLabelText = document.getElementById('roundTimeLabelText');
                const createRoundTimeGroup = document.getElementById('createRoundTimeGroup');
                const roomNameInput = document.getElementById('roomName');
                const selectedGameModeInput = document.getElementById('selectedGameMode');
                const modeQuickPickGrid = document.getElementById('modeQuickPickGrid');
                const modeSpotlight = document.getElementById('modeSpotlight');
                const werewolfWolfCountGroup = document.getElementById('werewolfWolfCountGroup');
                const createWolfCountSelector = document.getElementById('createWolfCountSelector');
                const modeConfigById = gameModes.reduce((result, mode) => {
                    result[mode.id] = mode;
                    return result;
                }, {});
                let selectedGameMode = selectedGameModeInput.value || 'insider';
                selectedGameModeInput.value = selectedGameMode;
                modeQuickPickGrid.dataset.selectedMode = selectedGameMode;
                
                maxPlayersSlider.addEventListener('input', function() {
                    maxPlayersValue.textContent = this.value;
                    updateSliderBackground(this);
                });
                
                roundTimeSlider.addEventListener('input', function() {
                    roundTimeValue.textContent = this.value + ' นาที';
                    updateSliderBackground(this);
                });
                
                function updateSliderBackground(slider) {
                    const percent = ((slider.value - slider.min) / (slider.max - slider.min)) * 100;
                    slider.style.background = `linear-gradient(90deg, #e74c3c 0%, #e74c3c ${percent}%, #333 ${percent}%, #333 100%)`;
                }
                
                updateSliderBackground(maxPlayersSlider);
                updateSliderBackground(roundTimeSlider);

                function syncModeQuickPick() {
                    modeSpotlight.innerHTML = buildModeSpotlightHtml(selectedGameMode, gameModes);
                    modeQuickPickGrid.querySelectorAll('.mode-quick-card').forEach(function(card) {
                        const active = card.dataset.modeId === selectedGameMode;
                        card.style.transform = active ? 'translateY(-1px)' : 'translateY(0)';
                        card.style.boxShadow = active ? '0 12px 28px rgba(0,0,0,0.24)' : 'none';
                        card.style.outline = active ? '2px solid rgba(245,200,107,0.55)' : 'none';
                    });
                    selectedGameModeInput.value = selectedGameMode;
                    modeQuickPickGrid.dataset.selectedMode = selectedGameMode;
                }

                function applyModeAutofill(modeId) {
                    selectedGameMode = modeId;
                    selectedGameModeInput.value = modeId;
                    modeQuickPickGrid.dataset.selectedMode = modeId;
                    const preset = getModeAutofillPreset(modeId);
                    const modeConfig = modeConfigById[modeId] || { minPlayers: 3, maxPlayers: 10 };
                    const clampedPlayers = Math.min(Number(modeConfig.maxPlayers || 10), Math.max(Number(modeConfig.minPlayers || 3), Number(preset.maxPlayers || 5)));

                    roomNameInput.value = preset.roomName;
                    roomNameInput.dataset.autofilledMode = modeId;

                    maxPlayersSlider.value = String(clampedPlayers);
                    maxPlayersValue.textContent = maxPlayersSlider.value;
                    updateSliderBackground(maxPlayersSlider);

                    if (modeId !== 'werewolf') {
                        roundTimeSlider.value = String(preset.roundTime);
                        roundTimeValue.textContent = `${roundTimeSlider.value} นาที`;
                        updateSliderBackground(roundTimeSlider);
                    }
                }

                roomNameInput.addEventListener('input', function() {
                    if (roomNameInput.dataset.autofilledMode) {
                        delete roomNameInput.dataset.autofilledMode;
                    }
                });

                function updateWerewolfRoleVisibility() {
                    const selectedMode = selectedGameModeInput.value || selectedGameMode || modeQuickPickGrid.dataset.selectedMode || 'insider';
                    selectedGameMode = selectedMode;
                    const modeConfig = modeConfigById[selectedMode] || { minPlayers: 3, maxPlayers: 10 };
                    const isWerewolfMode = selectedMode === 'werewolf';
                    werewolfWolfCountGroup.style.display = isWerewolfMode ? 'block' : 'none';
                    createRoundTimeGroup.style.display = isWerewolfMode ? 'none' : 'block';
                    roundTimeLabelText.textContent = selectedMode === 'blackmarket'
                        ? 'เวลาเดินเกมต่อยก:'
                        : (selectedMode === 'coup' ? 'เวลาคิดต่อตา:'
                            : (isWerewolfMode ? 'เวลาต่อช่วงกลางวัน/กลางคืน:' : 'เวลาเล่นต่อรอบ:'));

                    const sliderMin = Number(modeConfig.minPlayers || 3);
                    const sliderMax = Number(modeConfig.maxPlayers || 10);
                    maxPlayersSlider.min = String(sliderMin);
                    maxPlayersSlider.max = String(sliderMax);

                    if (selectedMode === 'blackmarket' && !['4', '5', '6', '7'].includes(maxPlayersSlider.value)) {
                        maxPlayersSlider.value = '6';
                    }

                    if (selectedMode === 'spyfall' && !['4', '5', '6', '7', '8'].includes(maxPlayersSlider.value)) {
                        maxPlayersSlider.value = '6';
                    }

                    if (selectedMode === 'coup' && !['2', '3', '4', '5', '6'].includes(maxPlayersSlider.value)) {
                        maxPlayersSlider.value = '5';
                    }

                    if (Number(maxPlayersSlider.value) < sliderMin) {
                        maxPlayersSlider.value = String(sliderMin);
                    }
                    if (Number(maxPlayersSlider.value) > sliderMax) {
                        maxPlayersSlider.value = String(sliderMax);
                    }

                    if (selectedMode === 'blackmarket' && Number(maxPlayersSlider.value) < 6) {
                        maxPlayersSlider.value = '6';
                        maxPlayersValue.textContent = maxPlayersSlider.value;
                        updateSliderBackground(maxPlayersSlider);
                    }

                    if (selectedMode === 'spyfall' && Number(maxPlayersSlider.value) < 4) {
                        maxPlayersSlider.value = '4';
                        maxPlayersValue.textContent = maxPlayersSlider.value;
                        updateSliderBackground(maxPlayersSlider);
                    }

                    maxPlayersValue.textContent = maxPlayersSlider.value;
                    updateSliderBackground(maxPlayersSlider);
                    syncModeQuickPick();
                }

                const urlMode = new URLSearchParams(window.location.search).get('mode');
                if (urlMode && modeConfigById[urlMode]) {
                    selectedGameMode = urlMode;
                    selectedGameModeInput.value = urlMode;
                    modeQuickPickGrid.dataset.selectedMode = urlMode;
                    updateWerewolfRoleVisibility();
                    applyModeAutofill(urlMode);
                } else {
                    updateWerewolfRoleVisibility();
                }

                modeQuickPickGrid.addEventListener('click', function(event) {
                    const card = event.target.closest('.mode-quick-card');
                    if (!card) {
                        return;
                    }

                    selectedGameMode = card.dataset.modeId;
                    selectedGameModeInput.value = card.dataset.modeId;
                    modeQuickPickGrid.dataset.selectedMode = card.dataset.modeId;
                    updateWerewolfRoleVisibility();
                    applyModeAutofill(card.dataset.modeId);
                });

                createWolfCountSelector.addEventListener('click', function(event) {
                    const btn = event.target.closest('.wolf-count-btn');
                    if (!btn) {
                        return;
                    }

                    createWolfCountSelector.querySelectorAll('.wolf-count-btn').forEach(function(item) {
                        const active = item === btn;
                        item.classList.toggle('active', active);
                        item.style.borderColor = active ? '#e74c3c' : 'rgba(255,255,255,0.12)';
                        item.style.background = active ? 'rgba(231,76,60,0.2)' : 'rgba(255,255,255,0.04)';
                    });
                });
                
                // Lock checkbox handler
                const lockedContainer = document.getElementById('lockedContainer');
                const lockedCheckbox = document.getElementById('locked');
                const passwordGroup = document.getElementById('passwordGroup');
                
                lockedContainer.addEventListener('click', function() {
                    lockedCheckbox.checked = !lockedCheckbox.checked;
                    this.classList.toggle('checked', lockedCheckbox.checked);
                    passwordGroup.style.display = lockedCheckbox.checked ? 'block' : 'none';
                    if (!lockedCheckbox.checked) {
                        document.getElementById('password').value = '';
                    }
                });
            },
            preConfirm: () => {
                const rawRoomName = document.getElementById('roomName').value.trim();
                const gameMode = resolveCreateGameMode();
                const roomName = rawRoomName || getAutofilledRoomName(gameMode);
                const maxPlayers = parseInt(document.getElementById('maxPlayers').value);
                const roundTime = parseInt(document.getElementById('roundTime').value);
                const locked = document.getElementById('locked').checked;
                const password = document.getElementById('password').value.trim();
                const activeWolfBtn = document.querySelector('#createWolfCountSelector .wolf-count-btn.active');
                const wolfCount = gameMode === 'werewolf' && activeWolfBtn
                    ? parseInt(activeWolfBtn.dataset.wolfCount, 10)
                    : undefined;
                const tableModeInput = document.querySelector('input[name="tableMode"]:checked');
                const tableMode = tableModeInput ? tableModeInput.value : 'inPerson';
                
                if (locked && (!password || !/^\d{4}$/.test(password))) {
                    Swal.showValidationMessage('กรุณากรอกรหัสผ่าน 4 หลัก (ตัวเลขเท่านั้น)');
                    return false;
                }
                
                return {
                    name: roomName,
                    gameMode: gameMode,
                    maxPlayers: maxPlayers,
                    roundTime: gameMode === 'werewolf' ? undefined : roundTime,
                    wolfCount: wolfCount,
                    locked: locked,
                    password: locked ? password : null,
                    tableMode: tableMode
                };
            }
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    const payload = Object.assign({}, result.value, { playerId: playerId });
                    fetch('/api/rooms', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        credentials: 'same-origin',
                        body: JSON.stringify(payload)
                    }).then(function(res) {
                        return res.json().catch(function() {
                            return { success: false, error: 'สร้างห้องไม่สำเร็จ' };
                        });
                    }).then(function(response) {
                        if (response && response.success && response.roomId) {
                            window.location.href = '/room/' + response.roomId + '?playerId=' + playerId;
                            return;
                        }
                        Swal.fire({
                            icon: 'error',
                            title: '❌ สร้างห้องไม่สำเร็จ',
                            text: (response && response.error) || 'เกิดข้อผิดพลาด',
                            background: '#1e1e1e',
                            color: '#fff',
                            confirmButtonColor: '#e74c3c'
                        });
                    }).catch(function() {
                        // Fallback to socket if HTTP create is unavailable
                        socket.emit('createRoom', payload, function(response) {
                            if (response && response.success && response.roomId) {
                                window.location.href = '/room/' + response.roomId + '?playerId=' + playerId;
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: '❌ สร้างห้องไม่สำเร็จ',
                                    text: (response && response.error) || 'เกิดข้อผิดพลาด',
                                    background: '#1e1e1e',
                                    color: '#fff',
                                    confirmButtonColor: '#e74c3c'
                                });
                            }
                        });
                    });
                }
            });
    });

    // Refresh room list
    $('#refreshBtn').on('click', function() {
        socket.emit('getRoomList', function(response) {
            if (response.success) {
                rooms = response.rooms;
                renderRoomList();
            }
        });
    });

    // Search room
    $('#searchRoomInput').on('keypress', function(e) {
        if (e.which === 13) { // Enter key
            const searchTerm = $(this).val().trim().toUpperCase();
            if (searchTerm) {
                const room = rooms.find(r => r.roomId.toUpperCase() === searchTerm);
                if (room) {
                    $('html, body').animate({
                        scrollTop: $(`.room-card[data-room-id="${room.roomId}"]`).offset().top - 100
                    }, 500);
                    $(`.room-card[data-room-id="${room.roomId}"]`).css('border-color', '#ff6b6b').animate({
                        'border-color': '#444'
                    }, 1000);
                } else {
                    Swal.fire({
                        icon: 'info',
                        title: 'ℹ️ ไม่พบห้อง',
                        text: 'ไม่พบห้องที่ต้องการ',
                        background: '#1e1e1e',
                        color: '#fff',
                        confirmButtonColor: '#3498db'
                    });
                }
            }
        }
    });

    // Socket event: Room list update
    socket.on('roomListUpdate', function(updatedRooms) {
        rooms = updatedRooms;
        renderRoomList();
    });

    // Listen for system broadcasts
    socket.on('systemBroadcast', function(data) {
        Swal.fire({
            icon: 'info',
            title: '📢 ประกาศจากระบบ',
            text: data.message,
            background: '#1e1e1e',
            color: '#fff',
            confirmButtonColor: '#e74c3c'
        });
    });

    // ถูกแบน - ส่งไปหน้า banned ทันที
    socket.on('banned', function(data) {
        Swal.fire({
            icon: 'error',
            title: '🚫 คุณถูกแบน!',
            html: `<p><strong>เหตุผล:</strong> ${data.reason}</p><p><strong>ระยะเวลา:</strong> ${data.durationHours === null ? 'ถาวร' : data.durationHours + ' ชั่วโมง'}</p>`,
            confirmButtonText: 'ตกลง',
            background: '#1e1e1e',
            color: '#fff',
            allowOutsideClick: false
        }).then(() => {
            window.location.href = '/banned?playerId=' + playerId;
        });
    });

    // Initial load
    socket.emit('getRoomList', function(response) {
        if (response.success) {
            rooms = response.rooms;
            renderRoomList();
        }
    });


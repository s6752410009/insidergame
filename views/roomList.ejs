                        <label for="drawguessCategory" style="display:block; color:#aaa; font-size:0.85em; margin:10px 0 4px;">หมวดคำ</label>
                        <select id="drawguessCategory" style="width:100%; min-height:48px; padding:8px 12px; border-radius:10px; border:1px solid rgba(125,211,252,0.35); background:#13202e; color:#fff; font-size:1rem;">

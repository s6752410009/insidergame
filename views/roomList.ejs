                        <div style="margin-top:10px;">
                            <label class="room-form-label" for="pokerAnte"><span class="icon">🪙</span> วางกองก่อนแจก:</label>
                            <div class="room-slider-container">
                                <span class="room-slider-value" id="pokerAnteValue">500</span>
                                <input type="range" id="pokerAnte" class="room-slider" min="100" max="2000" step="100" value="500">
                            </div>

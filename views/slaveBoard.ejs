<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link href="/static/css/slave.css?v=3" rel="stylesheet">
<link href="/static/css/slave-game.css?v=7" rel="stylesheet">
<link rel="preload" as="image" href="/static/img/slave/portraits-v1.jpg">
<script>document.documentElement.classList.add('slave-active');</script>
<main class="slave">
  <div class="sl-screen">
  <div class="sl-top">
    <div class="sl-brand"><span class="sl-brand-mark" aria-hidden="true">♛</span><div><h1>SLAVE <span>สลาฟ · <span id="slRound"></span></span></h1><div class="sl-meta">โต๊ะ #<%= room.roomId %> · STAGING <span id="slDebugUsed" hidden>· ทดสอบ /m</span></div></div></div>
    <div class="sl-tools"><button id="slSound" aria-pressed="false">เปิดเสียงเกม</button><button id="slMusic" aria-pressed="true">♫ เพลง เปิด</button><button id="slChat" aria-haspopup="dialog" aria-label="เปิดแชทห้อง">แชท <span id="slChatUnread" hidden></span></button><button id="slDebug" aria-controls="slDebugDock" aria-expanded="false" aria-pressed="false" hidden>/m</button><button id="slExit" aria-haspopup="dialog">ออกจากเกม</button></div>
  </div>
  <div id="slConnection" class="sl-alert" role="status"></div>
  <p id="slAudioHint" class="sl-audio-hint">แตะหน้าจอเพื่อเริ่มเสียงเกมและเพลง</p>
  <aside id="slDebugDock" class="sl-debug-dock" aria-label="เมนูทดสอบ /m" hidden>
    <div id="slDebugActions" class="sl-debug-actions">
      <label class="sl-peek"><input id="slPeekHands" type="checkbox"> เปิดหน้าไพ่</label>
      <div class="sl-debug-scroll" aria-label="คำสั่งทดสอบ" tabindex="0">
        <button data-sl-debug="auto">เดินตาให้</button><button data-sl-debug="finish">จบรอบอัตโนมัติ</button><button data-sl-debug="next">รอบถัดไป</button><button data-sl-debug="exchange">แลกไพ่ให้ครบ</button><button data-sl-debug="restart">แจกใหม่</button><button data-sl-debug="inspect">รีเฟรช</button>
        <button data-sl-cue="turn">เสียงถึงตา</button><button data-sl-cue="play">เสียงลงไพ่</button><button data-sl-cue="win">เสียงชนะ</button><button data-sl-cue="warning">เสียงเตือน</button>
      </div>
    </div>
    <span id="slDebugNote" class="sl-sr-only" role="status"></span><p id="slToolError" class="sl-tool-error" role="alert"></p>
    <button id="slDebugFold" aria-label="ย่อเมนู /m" title="ย่อเมนู · ไพ่ยังเปิดอยู่">−</button>
  </aside>
  <div id="slPlayArea" class="sl-play-area">
  <div class="sl-arena">
    <div class="sl-felt" aria-hidden="true"><div class="sl-table-print"><svg viewBox="0 0 100 60"><path d="M12 15 30 31 50 5 70 31 88 15 79 49H21Z" fill="currentColor"/><path d="M23 55H77" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><circle cx="12" cy="13" r="5" fill="currentColor"/><circle cx="50" cy="6" r="5" fill="currentColor"/><circle cx="88" cy="13" r="5" fill="currentColor"/></svg><strong>SLAVE</strong><small>♣ &nbsp; ♦ &nbsp; ♥ &nbsp; ♠</small></div></div>
    <section id="slSeats" class="sl-seats" aria-label="ผู้เล่นทั้งโต๊ะ"></section>
    <section class="sl-table" aria-label="กองกลาง"><div id="slPileText" class="sl-pile-label"></div><div id="slPile" class="sl-pile"></div><div id="slClock" class="sl-clock" role="timer"></div></section>
    <section id="slResults" class="sl-results" aria-label="ผลรอบนี้" hidden><div id="slResultEmblem" class="sl-result-crown"></div><h2 id="slResultTitle">จบรอบแล้ว!</h2><p id="slResultNext" class="sl-result-next"></p><div id="slRanks" class="sl-ranks"></div></section>
  </div>
  <section id="slPlayerZone" class="sl-player-zone" aria-label="พื้นที่เล่นของคุณ">
    <div class="sl-status-row"><div id="slStatus" class="sl-status" role="status" aria-live="polite"></div><div class="sl-hand-meta"><span id="slHandMeta"></span><span id="slHandClock" role="timer"></span></div></div>
    <div id="slTurnTrack" class="sl-turn-track" aria-hidden="true"><span></span></div>
    <div id="slError" class="sl-alert" role="alert"></div>
    <p id="slActionHelp" class="sl-action-help" role="status" aria-live="polite"></p>
    <div id="slHand" class="sl-hand" role="group" aria-label="ไพ่ในมือคุณ"></div>
    <div id="slActions" class="sl-actions"><button id="slHint">✧ เลือกชุดที่ลงได้</button><button id="slClear">ยกเลิกเลือก</button><button id="slPlay" class="primary" aria-describedby="slActionHelp">ลงไพ่</button><button id="slPass">ผ่าน</button><button id="slNext" class="primary" hidden>รอบถัดไป · แลกไพ่ ↻</button></div>
  </section>
  </div>
  </div>
  <div class="sl-under-table">
    <details><summary>กติกาโต๊ะนี้ ⌄</summary><div class="sl-help">4 คน คนละ 13 ใบ · 3 ต่ำสุด → 2 สูงสุด · ดอก ♣ &lt; ♦ &lt; ♥ &lt; ♠<br>ลงเดี่ยว / คู่ / ตอง / โฟร์หน้าเดียวกัน ต้องใหญ่กว่ากองเดิม · ตองตัดเดี่ยว · โฟร์ตัดคู่<br>ผ่านแล้วพักจนกองใหม่ ทุกคนผ่าน คนลงล่าสุดเปิดใหม่ ถ้าคนนั้นหมดมือ คนถัดไปที่ยังเล่นอยู่เริ่ม<br>รอบแรกเปิดด้วยชุดที่มี 3♣ · รอบต่อไปสลาฟเริ่ม<br>คิงเลือกคืน 2 ใบจากมือเดิมแลกกับไพ่สูงสุดของสลาฟ · ควีนเลือกคืน 1 ใบแลกกับรองสลาฟ<br>ไม่ใช้ไพ่เรียง / คิงตกชั้น / ปฏิวัติ · หมดเวลา 30 วิ ระบบลงหรือผ่านให้ · แลกไพ่ภายใน 60 วิ</div></details>
    <details><summary>บันทึกการลงไพ่ ⌄</summary><ol id="slHistory" class="sl-history"></ol></details>
    <div class="sl-short-rule">หมดมือก่อน เป็นคิง<br>3 → 2 &nbsp; · &nbsp; ♣ ♦ ♥ ♠</div>
  </div>
<dialog id="slChatDialog" class="sl-dialog" aria-labelledby="slChatTitle">
  <div class="sl-dialog-head"><h2 id="slChatTitle">แชทห้อง</h2><button data-sl-close="slChatDialog" aria-label="ปิดแชท">×</button></div>
  <ol id="slChatMessages" class="sl-chat-messages" role="log" aria-live="polite" aria-label="ข้อความในห้อง"></ol>
  <p id="slChatError" class="sl-tool-error" role="alert"></p>
  <form id="slChatForm" class="sl-chat-form"><label class="sl-sr-only" for="slChatInput">ข้อความแชท</label><textarea id="slChatInput" rows="2" maxlength="500" placeholder="คุยกับเพื่อน… หรือ /m เปิดเมนูทดสอบ"></textarea><button type="submit" class="primary">ส่ง</button></form>
</dialog>
<dialog id="slExitDialog" class="sl-dialog sl-confirm" aria-labelledby="slExitTitle">
  <h2 id="slExitTitle">ออกจากเกมไปห้องรอ?</h2><p id="slExitText"></p><p id="slExitError" class="sl-tool-error" role="alert"></p>
  <div class="sl-dialog-actions"><button data-sl-close="slExitDialog" autofocus>เล่นต่อ</button><button id="slConfirmExit" class="primary">ออกไปห้องรอ</button></div>
</dialog>
<dialog id="slRestartDialog" class="sl-dialog sl-confirm" aria-labelledby="slRestartTitle"><h2 id="slRestartTitle">แจกใหม่ทั้งโต๊ะ?</h2><p>ยกเลิกรอบนี้แล้วเริ่มรอบแรกใหม่ ทุกคนรับไพ่ใหม่ 13 ใบ</p><div class="sl-dialog-actions"><button data-sl-close="slRestartDialog" autofocus>ยกเลิก</button><button id="slConfirmRestart" class="primary">แจกใหม่</button></div></dialog>
</main>
<script src="/socket.io/socket.io.js"></script>
<script src="/static/js/slaveAudio.js?v=2"></script>
<script src="/static/js/slaveGuide.js?v=3"></script>
<script src="/static/js/slaveTools.js?v=7"></script>
<script src="/static/js/slaveBoard.js?v=7"></script>
<script>
document.addEventListener('DOMContentLoaded',function(){
  window.mountSlaveBoard({playerId:<%- safeJson(playerInfo.playerId) %>,roomId:<%- safeJson(room.roomId) %>,initial:<%- safeJson(slaveState) %>,canDebug:<%= typeof slaveDebugAllowed !== 'undefined' && slaveDebugAllowed ? 'true' : 'false' %>});
});
</script>

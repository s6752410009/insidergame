<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/home.css?v=1">
<%
    const homeGames = stats ? (stats.totalGames || 0) : 0;
    const homeWins = stats ? (stats.wins || 0) : 0;
    const homeRate = homeGames > 0 ? Math.round((homeWins / homeGames) * 100) : 0;
    const homeGoogleOn = typeof googleClientId !== 'undefined' && googleClientId;
    const homeGoogleLinked = typeof viewerGoogleLinked !== 'undefined' && viewerGoogleLinked;
%>

<main class="home" style="--me: <%= player.color %>;">
  <div class="home-layout">
    <div class="home-side">
        <!-- บัตรผู้เล่น -->
        <section class="home-pass" aria-label="ผู้เล่น">
            <div class="home-avatar" id="homeAvatar"
                 data-avatar="<%= player.avatar || '👤' %>"
                 data-frame="<%= player.avatarFrame || 'none' %>"
                 data-color="<%= player.color %>"><%= player.avatar || '👤' %></div>
            <div class="home-who">
                <p class="home-kicker">สวัสดี</p>
                <h1 class="home-name"><%= player.playerName %></h1>
                <% if (homeGoogleOn && homeGoogleLinked) { %>
                    <span class="home-tag"><i class="fab fa-google" aria-hidden="true"></i> บัญชีปลอดภัย</span>
                <% } %>
            </div>
            <dl class="home-tally">
                <div><dt>เกม</dt><dd><%= homeGames.toLocaleString('th-TH') %></dd></div>
                <div><dt>ชนะ</dt><dd class="is-win"><%= homeWins.toLocaleString('th-TH') %></dd></div>
                <div><dt>อัตราชนะ</dt><dd><%= homeRate %>%</dd></div>
            </dl>
            <% if (homeGoogleOn && !homeGoogleLinked) { %>
                <div class="home-signin">
                    <p>ล็อกอินด้วย Gmail เก็บถ้วยและสถิติไว้ ไม่หายแม้เปลี่ยนเครื่อง (ไม่บังคับ)</p>
                    <div data-google-signin></div>
                </div>
            <% } %>
        </section>

        <!-- ปุ่มหลักของหน้า -->
        <a href="/rooms?playerId=<%= player.playerId %>" class="ui-btn ui-btn--primary ui-btn--lg ui-btn--block home-play">🎮 เริ่มเกม</a>
        <p class="home-play-hint">เข้าห้องเพื่อน หรือสร้างห้องใหม่</p>

        <ul class="home-nav" aria-label="เมนู">
            <li><a href="/how-to-play" class="ui-btn"><span aria-hidden="true">📖</span> กฎการเล่น</a></li>
            <li><a href="/profile?playerId=<%= player.playerId %>" class="ui-btn"><span aria-hidden="true">👤</span> โปรไฟล์</a></li>
            <li><a href="/settings?playerId=<%= player.playerId %>" class="ui-btn"><span aria-hidden="true">⚙️</span> ตั้งค่า</a></li>
        </ul>
    </div>

    <% if (lastSeason) { %>
    <!-- ประกาศรีแรงค์ (ซ่อนไว้ ใช้เป็นเนื้อหาของ patch notes popup) -->
    <div id="seasonResetNotice" hidden>
        <div style="background: linear-gradient(135deg, rgba(255,215,0,0.18) 0%, rgba(255,140,0,0.12) 100%); padding: 14px; border-radius: 10px; border: 1px solid #ffd700; margin-bottom: 15px;">
            <h4 style="color: #ffd700; margin: 0 0 8px 0;">🔄 <%= lastSeason.name %> จบแล้ว — อันดับรีเซ็ตใหม่หมด</h4>
            <p style="margin: 0 0 10px 0; font-size: 0.9em; color: #ddd;">
                สถิติ <strong>เกม / ชนะ / แพ้</strong> ของทุกคนถูกล้างเป็น 0 เพื่อเริ่ม <strong style="color: #ffd700;"><%= currentSeason.name %></strong> — ทุกคนออกสตาร์ทพร้อมกันจากศูนย์ ชนะเกมแรกก็ขึ้นอันดับ 1 ได้เลย
            </p>
            <% if (lastSeason.topThree && lastSeason.topThree.length) { %>
            <p style="margin: 0 0 6px 0; font-size: 0.85em; color: #aaa;">🏅 แชมป์ <%= lastSeason.name %>:</p>
            <ul style="margin: 0 0 10px 0; padding-left: 20px; font-size: 0.9em; color: #ddd;">
                <% lastSeason.topThree.forEach(function(entry, index) { %>
                <li><%= ['🥇', '🥈', '🥉'][index] %> <strong><%= entry.playerName %></strong> — <%= entry.wins %> ชนะ จาก <%= entry.totalGames %> เกม (<%= entry.winRate %>%)</li>
                <% }); %>
            </ul>
            <% } %>
            <p style="margin: 0; font-size: 0.85em; color: #aaa;">
                📚 อันดับเก่าไม่หายไปไหน — กดแท็บ <strong style="color: #ffd700;"><%= lastSeason.name %></strong> ในตาราง Leaderboard ด้านล่างเพื่อดูย้อนหลัง
            </p>
        </div>
    </div>
    <% } %>

    <!-- Leaderboard -->
    <section class="home-main home-board" aria-labelledby="leaderboardTitle">
        <div class="home-board-head">
            <h2 class="home-h" id="leaderboardTitle">🏆 อันดับ</h2>
            <div class="leaderboard-meta" id="leaderboardMeta">กำลังโหลด...</div>
        </div>
        <div class="leaderboard-seasons" id="leaderboardSeasons"></div>
        <div class="leaderboard-modes" id="leaderboardModes" role="group" aria-label="เลือกโหมด"></div>
        <div class="leaderboard-season-note" id="leaderboardSeasonNote"></div>
        <div class="leaderboard-list" id="leaderboardList">
            <div class="skeleton-row"><span class="skeleton-circle"></span><span class="skeleton-line w60"></span><span class="skeleton-line w15"></span></div>
            <div class="skeleton-row"><span class="skeleton-circle"></span><span class="skeleton-line w50"></span><span class="skeleton-line w15"></span></div>
            <div class="skeleton-row"><span class="skeleton-circle"></span><span class="skeleton-line w65"></span><span class="skeleton-line w15"></span></div>
            <div class="skeleton-row"><span class="skeleton-circle"></span><span class="skeleton-line w55"></span><span class="skeleton-line w15"></span></div>
            <div class="skeleton-row"><span class="skeleton-circle"></span><span class="skeleton-line w45"></span><span class="skeleton-line w15"></span></div>
        </div>
        <div class="leaderboard-pagination" id="leaderboardPagination"></div>
    </section>
  </div>

    <!-- Bottom Links (Admin link hidden - access via /admin/login) -->
    <!-- <div class="bottom-links">
        <a href="/admin" class="bottom-link admin">🛠️ Admin Dashboard</a>
    </div> -->
</main>

<!-- ปุ่มลอย: ซ้อนแนวตั้งมุมขวาล่าง ขนาดเท่ากัน ไม่ทับกันเอง (หน้า .home เว้นที่ท้ายหน้าไว้ให้แล้ว) -->
<nav class="home-fabs" aria-label="ลิงก์เสริม">
    <button type="button" class="home-fab" onclick="showInstallGuide()" aria-label="ติดตั้งแอป" title="ติดตั้งแอป"><span aria-hidden="true">📲</span><span class="home-fab-label" aria-hidden="true">ติดตั้งแอป</span></button>
    <a class="home-fab" href="/support" aria-label="ติดต่อแอดมิน" title="ติดต่อแอดมิน"><span aria-hidden="true">✉️</span><span class="home-fab-label" aria-hidden="true">ติดต่อแอดมิน</span></a>
    <button type="button" class="home-fab is-donate" id="donateBtn" aria-label="Donate สนับสนุนผู้พัฒนา" title="Donate"><span aria-hidden="true">☕</span><span class="home-fab-label" aria-hidden="true">Donate</span></button>
</nav>


<!-- Donate Modal -->
<div id="donateModal" class="donate-modal">
    <div class="donate-modal-content">
        <button class="donate-close-btn" id="closeDonate">&times;</button>
        <h2>☕ Buy Me a Coffee</h2>
        <p>ช่วยสนับสนุนพัฒนาเกมให้ดีขึ้น</p>
        <div class="donate-qr-code">
            <img src="/static/image/qr.jpg" alt="Donate QR Code">
        </div>
        <p class="donate-footer-text">สแกน QR code เพื่อทำการโดเนท</p>
    </div>
</div>


<%- contentFor('footer') %>
<!-- No footer needed -->

<%- contentFor('script') %>
<script>
$(function() {
    // เก็บ playerId ใน sessionStorage สำหรับ tab นี้
    const playerId = '<%= player.playerId %>';
    sessionStorage.setItem('playerId', playerId);
    
    // Connect to socket for broadcast messages
    const socket = window.appSocket || io();
    
    // Listen for system broadcasts
    socket.on('systemBroadcast', function(data) {
        Swal.fire({
            icon: 'info',
            title: '📢 ประกาศจากระบบ',
            text: data.message,
            background: 'oklch(0.22 0.035 285)',
            color: '#fff',
            confirmButtonColor: '#e2493b'
        });
    });
    
    // Frame styles lookup
    // กรอบมาจาก /static/js/playerAvatar.js แหล่งเดียว จะได้ไม่หลุดกันระหว่างหน้า
    const frameStyles = window.PlayerAvatar.FRAME_STYLES;

    // รูปผู้เล่นบนบัตร — ใช้ตัว render กลางเหมือนหน้าโปรไฟล์ (มีกรอบด้วย)
    (function renderHomeAvatar() {
        var box = document.getElementById('homeAvatar');
        if (!box || !window.PlayerAvatar) return;
        box.innerHTML = window.PlayerAvatar.render({
            avatar: box.getAttribute('data-avatar') || '👤',
            avatarFrame: box.getAttribute('data-frame') || 'none',
            color: box.getAttribute('data-color')
        }, { size: 64 });
    })();

    const LEADERBOARD_PAGE_SIZE = 5;
    const CURRENT_SEASON_KEY = 'current';
    const LEADERBOARD_MODES = [
        { id: 'all', label: 'รวม' },
        { id: 'insider', label: 'Insider' },
        { id: 'werewolf', label: 'Werewolf' },
        { id: 'spyfall', label: 'Spyfall' },
        { id: 'coup', label: 'Coup' },
        { id: 'liar', label: 'ไพ่โกหก' },
        { id: 'poker5', label: 'ไพ่ 5 ใบ' },
        { id: 'poker4', label: 'สี่ใบเก' },
        { id: 'blackmarket', label: 'Black Market' }
    ];
    var leaderboardState = {
        entries: [],
        currentPage: 1,
        totalPages: 1,
        activeSeason: CURRENT_SEASON_KEY,   // 'current' หรือเลข season ที่ปิดไปแล้ว
        activeMode: 'all',
        currentSeasonName: 'ปัจจุบัน',
        seasonCache: {}                     // season:mode → { entries, note }
    };

    function leaderboardCacheKey(seasonKey, mode) {
        return String(seasonKey) + ':' + (mode || 'all');
    }

    function leaderboardModeLabel(mode) {
        var found = LEADERBOARD_MODES.find(function(item) { return item.id === mode; });
        return found ? found.label : 'รวม';
    }

    function renderLeaderboardEmpty(message) {
        $('#leaderboardList').html('<div class="leaderboard-empty">' + message + '</div>');
        $('#leaderboardMeta').text(message);
        $('#leaderboardPagination').empty();
    }

    function buildLeaderboardItem(entry) {
        const rankClass = entry.rank <= 3 ? 'rank-' + entry.rank : 'rank-other';
        const avatarHtml = window.PlayerAvatar
            ? window.PlayerAvatar.render({ avatar: entry.avatar, avatarFrame: entry.avatarFrame, color: entry.color, playerName: entry.playerName }, { size: 44 })
            : escapeHtml(entry.avatar || '👤');
        const isMe = entry.playerId === playerId;
        return `
            <div class="leaderboard-item${isMe ? ' is-me' : ''}" data-player-id="${escapeHtml(entry.playerId)}" role="button" tabindex="0" aria-label="ดูโปรไฟล์ ${escapeHtml(entry.playerName)} อันดับ ${entry.rank}">
                <div class="leaderboard-rank ${rankClass}">${entry.rank}</div>
                <div class="leaderboard-avatar">${avatarHtml}</div>
                <div class="leaderboard-info">
                    <div class="leaderboard-name" style="color: ${escapeHtml(entry.color)};">${escapeHtml(entry.playerName)}</div>
                    <div class="leaderboard-stats-mini"><span class="lb-wins-inline"><b>🏆 ${entry.wins} ชนะ</b> · </span>${entry.totalGames} เกม · ${entry.winRate}%</div>
                </div>
                <div class="leaderboard-wins">${entry.wins}<small>ชนะ</small></div>
            </div>
        `;
    }

    function buildLeaderboardPageList(currentPage, totalPages) {
        if (totalPages <= 7) {
            var allPages = [];
            for (var i = 1; i <= totalPages; i++) {
                allPages.push(i);
            }
            return allPages;
        }

        var pages = [];
        var lastAdded = 0;
        var pageIndex;

        for (pageIndex = 1; pageIndex <= totalPages; pageIndex++) {
            if (
                pageIndex === 1 ||
                pageIndex === totalPages ||
                (pageIndex >= currentPage - 1 && pageIndex <= currentPage + 1)
            ) {
                if (lastAdded && pageIndex - lastAdded === 2) {
                    pages.push(lastAdded + 1);
                } else if (lastAdded && pageIndex - lastAdded > 2) {
                    pages.push('ellipsis');
                }
                pages.push(pageIndex);
                lastAdded = pageIndex;
            }
        }

        return pages;
    }

    function renderLeaderboardPagination(totalPages) {
        var $pagination = $('#leaderboardPagination');
        var currentPage = leaderboardState.currentPage;
        var previousPage = currentPage - 1;
        var nextPage = currentPage + 1;
        var pageList;
        var pageToken;
        var pageNumber;
        var i;

        $pagination.empty();

        if (totalPages <= 1) {
            return;
        }

        $pagination.append(
            '<button type="button" class="leaderboard-page" data-page="' + previousPage + '"' +
            (currentPage === 1 ? ' disabled' : '') +
            '>ก่อนหน้า</button>'
        );

        pageList = buildLeaderboardPageList(currentPage, totalPages);
        for (i = 0; i < pageList.length; i++) {
            pageToken = pageList[i];

            if (pageToken === 'ellipsis') {
                $pagination.append('<span class="leaderboard-page-ellipsis" aria-hidden="true">…</span>');
                continue;
            }

            pageNumber = pageToken;
            if (pageNumber === currentPage) {
                $pagination.append(
                    '<button type="button" class="leaderboard-page leaderboard-page-num is-active" data-page="' +
                    pageNumber + '" disabled aria-current="page">' + pageNumber + '</button>'
                );
                continue;
            }

            $pagination.append(
                '<button type="button" class="leaderboard-page leaderboard-page-num" data-page="' +
                pageNumber + '" aria-label="หน้า ' + pageNumber + '">' + pageNumber + '</button>'
            );
        }

        $pagination.append(
            '<button type="button" class="leaderboard-page" data-page="' + nextPage + '"' +
            (currentPage === totalPages ? ' disabled' : '') +
            '>ถัดไป</button>'
        );

        $pagination.append(
            '<form class="leaderboard-page-jump" id="leaderboardPageJumpForm">' +
            '<label class="leaderboard-page-jump-label" for="leaderboardPageJumpInput">ไปหน้า</label>' +
            '<input id="leaderboardPageJumpInput" class="leaderboard-page-jump-input" type="number" min="1" max="' +
            totalPages + '" inputmode="numeric" placeholder="' + currentPage + '" aria-label="หมายเลขหน้า" />' +
            '<span class="leaderboard-page-jump-of">/ ' + totalPages + '</span>' +
            '<button type="submit" class="leaderboard-page leaderboard-page-jump-btn">ไป</button>' +
            '</form>'
        );
    }

    function jumpToLeaderboardPageFromInput() {
        var $input = $('#leaderboardPageJumpInput');
        var totalPages = leaderboardState.totalPages || 1;
        var raw = String($input.val() || '').trim();
        var page = parseInt(raw, 10);

        if (!raw || Number.isNaN(page)) {
            $input.addClass('is-invalid').focus();
            return;
        }

        page = Math.min(Math.max(page, 1), totalPages);
        $input.removeClass('is-invalid').val('');
        renderLeaderboardPage(page);
    }

    function renderLeaderboardPage(page) {
        var totalEntries = leaderboardState.entries.length;

        if (totalEntries === 0) {
            var emptyMessage;
            if (leaderboardState.activeSeason !== CURRENT_SEASON_KEY) {
                emptyMessage = 'season นี้ไม่มีใครติดอันดับ';
            } else if (leaderboardState.activeMode !== 'all') {
                emptyMessage = 'ยังไม่มีใครเล่น ' + leaderboardModeLabel(leaderboardState.activeMode) + ' season นี้';
            } else {
                emptyMessage = 'ยังไม่มีข้อมูล เล่นเกมเพื่อติดอันดับ!';
            }
            renderLeaderboardEmpty(emptyMessage);
            return;
        }

        var totalPages = Math.ceil(totalEntries / LEADERBOARD_PAGE_SIZE);
        leaderboardState.totalPages = totalPages;
        var safePage = Math.min(Math.max(page, 1), totalPages);
        var startIndex = (safePage - 1) * LEADERBOARD_PAGE_SIZE;
        var visibleEntries = leaderboardState.entries.slice(startIndex, startIndex + LEADERBOARD_PAGE_SIZE);
        var $list = $('#leaderboardList');

        leaderboardState.currentPage = safePage;
        $list.empty();

        for (var i = 0; i < visibleEntries.length; i++) {
            $list.append(buildLeaderboardItem(visibleEntries[i]));
        }

        var metaText = 'อันดับ ' + (startIndex + 1) + '-' + (startIndex + visibleEntries.length) +
            ' จาก ' + totalEntries + ' คน';
        if (leaderboardState.activeMode !== 'all') {
            metaText += ' · ' + leaderboardModeLabel(leaderboardState.activeMode);
        }
        $('#leaderboardMeta').text(metaText);

        renderLeaderboardPagination(totalPages);
    }
    
    function formatSeasonDate(isoDate) {
        if (!isoDate) return null;

        var date = new Date(isoDate);
        if (Number.isNaN(date.getTime())) return null;

        return date.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function buildSeasonNote(season) {
        var from = formatSeasonDate(season.startedAt);
        var to = formatSeasonDate(season.endedAt);
        var parts = [];

        if (from && to) {
            parts.push(from + ' – ' + to);
        } else if (to) {
            parts.push('ปิดเมื่อ ' + to);
        }

        parts.push(season.totalPlayers + ' คนติดอันดับ');

        return '📚 อันดับสุดท้ายของ ' + season.name + ' · ' + parts.join(' · ') +
            ' · season เก่าเก็บแค่รวมทุกโหมด';
    }

    function renderSeasonTabs(seasons) {
        var $tabs = $('#leaderboardSeasons');

        // มีแค่ season ปัจจุบัน = ยังไม่เคยรีแรงค์ ไม่ต้องโชว์แท็บ
        if (!seasons.archived.length) {
            $tabs.empty();
            return;
        }

        $tabs.empty();
        $tabs.append(buildSeasonTab(CURRENT_SEASON_KEY, leaderboardState.currentSeasonName));

        for (var i = 0; i < seasons.archived.length; i++) {
            $tabs.append(buildSeasonTab(seasons.archived[i].number, seasons.archived[i].name));
        }
    }

    function buildSeasonTab(key, label) {
        var isActive = String(leaderboardState.activeSeason) === String(key);

        return $('<button type="button" class="leaderboard-season-tab"></button>')
            .toggleClass('is-active', isActive)
            .attr('data-season', key)
            .attr('aria-pressed', isActive ? 'true' : 'false')
            .prop('disabled', isActive)
            .text(label);
    }

    function renderModeTabs() {
        var $tabs = $('#leaderboardModes');
        var isArchive = leaderboardState.activeSeason !== CURRENT_SEASON_KEY;

        $tabs.empty();
        LEADERBOARD_MODES.forEach(function(mode) {
            var isActive = leaderboardState.activeMode === mode.id;
            var disabled = isActive || (isArchive && mode.id !== 'all');

            $tabs.append(
                $('<button type="button" class="leaderboard-mode-tab"></button>')
                    .toggleClass('is-active', isActive)
                    .attr('data-mode', mode.id)
                    .attr('aria-pressed', isActive ? 'true' : 'false')
                    .prop('disabled', disabled)
                    .text(mode.label)
            );
        });
    }

    function showSeasonEntries(key, entries, note, mode) {
        leaderboardState.activeSeason = key;
        leaderboardState.activeMode = mode || 'all';
        leaderboardState.entries = Array.isArray(entries) ? entries : [];
        leaderboardState.currentPage = 1;
        leaderboardState.seasonCache[leaderboardCacheKey(key, leaderboardState.activeMode)] = {
            entries: leaderboardState.entries,
            note: note || ''
        };

        $('#leaderboardSeasonNote').text(note || '');
        $('#leaderboardSeasons .leaderboard-season-tab').each(function() {
            var isActive = String($(this).data('season')) === String(key);
            $(this).toggleClass('is-active', isActive)
                .attr('aria-pressed', isActive ? 'true' : 'false')
                .prop('disabled', isActive);
        });
        renderModeTabs();
        renderLeaderboardPage(1);
    }

    // โหลดตารางอันดับของ season ที่เลือก ('current' = อันดับสด)
    function loadLeaderboard(key, mode) {
        var seasonKey = key === undefined ? leaderboardState.activeSeason : key;
        var modeKey = mode === undefined ? leaderboardState.activeMode : mode;

        if (seasonKey !== CURRENT_SEASON_KEY) {
            modeKey = 'all';
        }

        var cached = leaderboardState.seasonCache[leaderboardCacheKey(seasonKey, modeKey)];

        if (cached) {
            showSeasonEntries(seasonKey, cached.entries, cached.note, modeKey);
            return;
        }

        var isCurrent = seasonKey === CURRENT_SEASON_KEY;
        var url = isCurrent
            ? (modeKey === 'all' ? '/api/leaderboard' : '/api/leaderboard?mode=' + encodeURIComponent(modeKey))
            : '/api/seasons/' + seasonKey + '/leaderboard';

        $.ajax({
            url: url,
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (isCurrent) {
                    showSeasonEntries(seasonKey, Array.isArray(data) ? data : [], '', modeKey);
                    return;
                }

                showSeasonEntries(seasonKey, data && data.entries, buildSeasonNote(data || {}), 'all');
            },
            error: function(xhr, status, error) {
                console.error('Leaderboard error:', error);
                renderLeaderboardEmpty('ไม่สามารถโหลดข้อมูลได้');
            }
        });
    }

    // โหลดรายชื่อ season เพื่อสร้างแท็บประวัติ
    function loadSeasonTabs() {
        $.ajax({
            url: '/api/seasons',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                var current = (data && data.current) || {};
                var archived = (data && Array.isArray(data.archived)) ? data.archived : [];

                leaderboardState.currentSeasonName = current.name
                    ? current.name + ' (ตอนนี้)'
                    : 'ปัจจุบัน';

                renderSeasonTabs({ current: current, archived: archived });
            },
            error: function(xhr, status, error) {

<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
    .lobby-container {
        max-width: 900px;
        margin: 30px auto;
        padding: 20px;
        font-family: 'Rajdhani', sans-serif;
    }
    
    /* Player Card */
    .player-card {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border: 3px solid #444;
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        position: relative;
        overflow: hidden;
    }
    
    .player-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, #e74c3c, #f39c12, #e74c3c);
    }
    
    .player-info {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    
    .player-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5em;
        border: 4px solid;
        box-shadow: 0 0 20px rgba(255,255,255,0.2);
    }
    
    .player-details h2 {
        margin: 0 0 5px 0;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.8em;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }
    
    .player-details p {
        margin: 0;
        color: #888;
        font-size: 0.9em;
    }
    
    .player-details p code {
        background: rgba(255,255,255,0.1);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85em;
    }
    
    /* Menu Grid */
    .menu-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .menu-item {
        background: linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 100%);
        border: 3px solid #444;
        border-radius: 16px;
        padding: 30px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }
    
    .menu-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
        transition: left 0.5s;
    }
    
    .menu-item:hover::before {
        left: 100%;
    }
    
    .menu-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    
    .menu-item.play {
        border-color: #e74c3c;
        grid-column: span 2;
    }
    
    .menu-item.play:hover {
        border-color: #ff6b6b;
        box-shadow: 0 10px 30px rgba(231, 76, 60, 0.4);
    }
    
    .menu-item.profile {
        border-color: #3498db;
    }
    
    .menu-item.profile:hover {
        border-color: #5dade2;
        box-shadow: 0 10px 30px rgba(52, 152, 219, 0.4);
    }
    
    .menu-item.settings {
        border-color: #f39c12;
    }
    
    .menu-item.settings:hover {
        border-color: #f1c40f;
        box-shadow: 0 10px 30px rgba(243, 156, 18, 0.4);
    }
    
    .menu-item.howto {
        border-color: #9b59b6;
        grid-column: span 2;
    }
    
    .menu-item.howto:hover {
        border-color: #a569bd;
        box-shadow: 0 10px 30px rgba(155, 89, 182, 0.4);
    }
    
    .menu-item.howto .menu-icon {
        font-size: 4em;
    }
    
    .menu-item.howto .menu-title {
        font-size: 1.8em;
    }
    
    .menu-icon {
        font-size: 3em;
        margin-bottom: 15px;
        display: block;
    }
    
    .menu-item.play .menu-icon {
        font-size: 4em;
    }
    
    .menu-title {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.4em;
        color: #fff;
        margin-bottom: 8px;
    }
    
    .menu-item.play .menu-title {
        font-size: 1.8em;
    }
    
    .menu-desc {
        color: #888;
        font-size: 0.95em;
    }
    
    /* Quick Stats */
    .quick-stats {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid #333;
    }
    
    .quick-stat {
        text-align: center;
    }
    
    .quick-stat-value {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.5em;
        font-weight: 700;
        color: #fff;
    }
    
    .quick-stat-label {
        color: #666;
        font-size: 0.85em;
    }
    
    /* Bottom Links */
    .bottom-links {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }
    
    .bottom-link {
        padding: 12px 24px;
        background: #333;
        border: 2px solid #444;
        border-radius: 8px;
        color: #aaa;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .bottom-link:hover {
        background: #444;
        color: #fff;
        border-color: #555;
    }
    
    .bottom-link.admin {
        border-color: #9b59b6;
        color: #9b59b6;
    }
    
    .bottom-link.admin:hover {
        background: #9b59b6;
        color: #fff;
    }

    @media (max-width: 600px) {
        .menu-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }
        
        .menu-item {
            padding: 20px 12px;
        }
        
        .menu-item .menu-icon {
            font-size: 2em;
        }
        
        .menu-item .menu-title {
            font-size: 1em;
        }
        
        .menu-item .menu-desc {
            font-size: 0.75em;
        }
        
        .menu-item.play {
            grid-column: span 2;
        }
        
        .player-info {
            flex-direction: column;
            text-align: center;
        }
        
        .quick-stats {
            flex-wrap: wrap;
        }
        
        .leaderboard-card {
            padding: 15px;
        }
        
        .leaderboard-header h3 {
            font-size: 1.1em;
        }
        
        .lobby-container {
            padding: 15px;
        }
        
        .lobby-container h1 {
            font-size: 1.8em;
        }
    }
    
    /* Leaderboard */
    .leaderboard-card {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border: 3px solid #444;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }
    
    .leaderboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #333;
    }
    
    .leaderboard-header h3 {
        margin: 0;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.4em;
        color: #ffd700;
    }

    .leaderboard-meta {
        color: #8ea6d9;
        font-size: 0.9em;
        font-weight: 600;
        text-align: right;
    }

    .leaderboard-modes,
    .leaderboard-seasons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

    .leaderboard-mode-tab {
        padding: 6px 14px;
        border: 2px solid #333;
        border-radius: 999px;
        background: rgba(255,255,255,0.03);
        color: #8ea6d9;
        font-family: inherit;
        font-size: 0.82em;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .leaderboard-mode-tab:hover:not(:disabled) {
        border-color: #38bdf8;
        color: #38bdf8;
    }

    .leaderboard-mode-tab.is-active {
        background: linear-gradient(135deg, #38bdf8 0%, #2563eb 100%);
        border-color: #38bdf8;
        color: #0b1220;
        cursor: default;
    }

    .leaderboard-mode-tab:disabled:not(.is-active) {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .leaderboard-season-tab {
        padding: 7px 16px;
        border: 2px solid #333;
        border-radius: 999px;
        background: rgba(255,255,255,0.03);
        color: #8ea6d9;
        font-family: inherit;
        font-size: 0.85em;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .leaderboard-season-tab:hover {
        border-color: #ffd700;
        color: #ffd700;
    }

    .leaderboard-season-tab.is-active {
        background: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%);
        border-color: #ffd700;
        color: #1a1a2e;
        cursor: default;
    }

    .leaderboard-season-note {
        color: #6f83ad;
        font-size: 0.82em;
        margin-bottom: 12px;
        line-height: 1.5;
    }

    .leaderboard-season-note:empty {
        display: none;
    }

    .leaderboard-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    
    .leaderboard-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px 15px;
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
        transition: all 0.3s;
        cursor: pointer;
    }
    
    .leaderboard-item:hover {
        background: rgba(255,255,255,0.08);
        transform: translateX(5px);
    }
    
    .leaderboard-rank {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 0.9em;
    }
    
    .leaderboard-rank.rank-1 { background: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%); color: #000; }
    .leaderboard-rank.rank-2 { background: linear-gradient(135deg, #c0c0c0 0%, #808080 100%); color: #000; }
    .leaderboard-rank.rank-3 { background: linear-gradient(135deg, #cd7f32 0%, #8b4513 100%); color: #fff; }
    .leaderboard-rank.rank-other { background: #333; color: #888; }
    
    .leaderboard-avatar {
        position: relative;
        width: 45px;
        height: 45px;
    }
    
    .leaderboard-avatar-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5em;
        border: 3px solid;
        position: relative;
        z-index: 2;
        background: #1a1a2e;
    }
    
    .leaderboard-avatar-frame {
        position: absolute;
        top: -4px;
        left: -4px;
        right: -4px;
        bottom: -4px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
    }
    
    .leaderboard-info {
        flex: 1;
    }
    
    .leaderboard-name {
        font-weight: 700;
        font-size: 1.1em;
        color: #fff;
    }
    
    .leaderboard-stats-mini {
        font-size: 0.85em;
        color: #888;
    }
    
    .leaderboard-wins {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        color: #2ecc71;
        font-size: 1.1em;
    }
    
    .leaderboard-empty {
        text-align: center;
        padding: 30px;
        color: #666;
    }

    .leaderboard-pagination {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
    }

    .leaderboard-page {
        min-width: 96px;
        height: 40px;
        padding: 0 16px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.05);
        color: #cdd8f6;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.9em;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .leaderboard-page-num {
        min-width: 40px;
        width: 40px;
        height: 40px;
        padding: 0;
        border-radius: 10px;
        font-size: 0.85em;
    }

    .leaderboard-page-num.is-active {
        background: linear-gradient(135deg, #ffd98b 0%, #ff9f43 100%);
        border-color: transparent;
        color: #1a1205;
        cursor: default;
        box-shadow: 0 4px 14px rgba(255, 159, 67, 0.35);
    }

    .leaderboard-page-num.is-active:hover {
        transform: none;
        background: linear-gradient(135deg, #ffd98b 0%, #ff9f43 100%);
        color: #1a1205;
    }

    .leaderboard-page:hover {
        background: rgba(255,255,255,0.12);
        color: #fff;
        transform: translateY(-1px);
    }

    .leaderboard-page:disabled {
        cursor: not-allowed;
        opacity: 0.45;
        transform: none;
        box-shadow: none;
    }

    .leaderboard-page-ellipsis {
        min-width: 28px;
        text-align: center;
        color: #8a96b8;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.9em;
        font-weight: 700;
        user-select: none;
    }

    .leaderboard-page-jump {
        flex: 0 0 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 6px;
    }

    .leaderboard-page-jump-label {
        color: #8a96b8;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.95em;
        font-weight: 600;
    }

    .leaderboard-page-jump-input {
        width: 72px;
        height: 40px;
        padding: 0 10px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(0,0,0,0.35);
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.9em;
        font-weight: 700;
        text-align: center;
        -moz-appearance: textfield;
    }

    .leaderboard-page-jump-input::-webkit-outer-spin-button,
    .leaderboard-page-jump-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .leaderboard-page-jump-input:focus {
        outline: none;
        border-color: rgba(255, 217, 139, 0.65);
        box-shadow: 0 0 0 2px rgba(255, 217, 139, 0.15);
    }

    .leaderboard-page-jump-input.is-invalid {
        border-color: #e74c3c;
        box-shadow: 0 0 0 2px rgba(231, 76, 60, 0.2);
    }

    .leaderboard-page-jump-of {
        color: #ffd98b;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.85em;
        font-weight: 700;
    }

    .leaderboard-page-jump-btn {
        min-width: 56px;
        height: 40px;
        padding: 0 14px;
    }

    @media (max-width: 768px) {
        .leaderboard-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .leaderboard-meta {
            text-align: left;
        }

        .leaderboard-item {
            gap: 12px;
            padding: 12px;
        }

        .leaderboard-page {
            min-width: 72px;
            height: 36px;
            padding: 0 10px;
            font-size: 0.82em;
        }

        .leaderboard-page-num {
            min-width: 34px;
            width: 34px;
            height: 34px;
            font-size: 0.78em;
        }

        .leaderboard-pagination {
            gap: 6px;
        }

        .leaderboard-page-jump-input,
        .leaderboard-page-jump-btn {
            height: 36px;
        }

        .leaderboard-page-jump-input {
            width: 64px;
            font-size: 0.82em;
        }
    }
    
    /* Profile Modal */
    .profile-modal-content {
        text-align: left;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .profile-modal-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 2px solid #333;
    }
    
    .profile-modal-avatar {
        position: relative;
        width: 80px;
        height: 80px;
    }
    
    .profile-modal-avatar-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5em;
        border: 4px solid;
        position: relative;
        z-index: 2;
        background: #1a1a2e;
    }
    
    .profile-modal-avatar-frame {
        position: absolute;
        top: -5px;
        left: -5px;
        right: -5px;
        bottom: -5px;
        border-radius: 50%;
        z-index: 1;
    }
    
    .profile-modal-name {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.5em;
        margin: 0;
    }
    
    .profile-modal-joined {
        color: #888;
        font-size: 0.9em;
    }
    
    .profile-modal-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }
    
    .profile-stat-box {
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 12px;
        text-align: center;
    }
    
    .profile-stat-value {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.5em;
    }
    
    .profile-stat-label {
        color: #888;
        font-size: 0.85em;
    }
    
    .profile-roles {
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 12px;
    }
    
    .profile-roles h4 {
        margin: 0 0 10px 0;
        color: #f39c12;
        font-size: 1em;
    }
    
    .profile-role-row {
        display: flex;
        justify-content: space-between;
        padding: 5px 0;
        border-bottom: 1px solid #333;
    }
    
    .profile-role-row:last-child {
        border-bottom: none;
    }

    .profile-history {
        margin-top: 16px;
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 12px;
    }

    .profile-history h4 {
        margin: 0 0 10px 0;
        color: #8fd3ff;
        font-size: 1em;
    }

    .profile-history-list {
        display: grid;
        gap: 8px;
        max-height: 220px;
        overflow-y: auto;
    }

    .profile-history-item {
        padding: 10px 12px;
        border-radius: 10px;
        background: rgba(255,255,255,0.04);
        border-left: 3px solid rgba(255,255,255,0.12);
    }

    .profile-history-item.won {
        border-left-color: #2ecc71;
    }

    .profile-history-item.lost {
        border-left-color: #e74c3c;
    }

    .profile-history-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 4px;
    }

    .profile-history-mode {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 0.75em;
        font-weight: 700;
        background: rgba(255,255,255,0.08);
    }

    .profile-history-mode.werewolf {
        color: #ffb4a8;
    }

    .profile-history-mode.blackmarket {
        color: #f6d365;
    }

    .profile-history-mode.spyfall {
        color: #7bedd6;
    }

    .profile-history-mode.insider {
        color: #8fd3ff;
    }

    .profile-history-mode.coup {
        color: #c4b5fd;
    }

    .profile-history-mode.liar {
        color: #fecaca;
    }

    .profile-history-meta {
        color: #aaa;
        font-size: 0.82em;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .profile-history-empty {
        color: #888;
        text-align: center;
        padding: 12px;
    }
</style>

<div class="lobby-container">
    <!-- Player Card -->
    <div class="player-card">
        <div class="player-info">
            <div class="player-avatar" style="background: <%= player.color %>20; border-color: <%= player.color %>; color: <%= player.color %>;">
                <%= player.avatar || '👤' %>
            </div>
            <div class="player-details">
                <h2 style="color: <%= player.color %>;"><%= player.playerName %></h2>
                <p>Player ID: <code><%= player.playerId.substring(0, 8) %>...</code></p>
            </div>
        </div>
        
        <div class="quick-stats">
            <div class="quick-stat">
                <div class="quick-stat-value" style="color: #3498db;"><%= stats ? stats.totalGames : 0 %></div>
                <div class="quick-stat-label">เกมที่เล่น</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-value" style="color: #2ecc71;"><%= stats ? stats.wins : 0 %></div>
                <div class="quick-stat-label">ชนะ</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-value" style="color: #f39c12;"><%= stats ? (stats.totalGames > 0 ? Math.round((stats.wins / stats.totalGames) * 100) : 0) : 0 %>%</div>
                <div class="quick-stat-label">Win Rate</div>
            </div>
        </div>
    </div>
    
    <!-- Menu Grid -->
    <div class="menu-grid">
        <a href="/rooms?playerId=<%= player.playerId %>" class="menu-item play">
            <span class="menu-icon">🎮</span>
            <div class="menu-title">เริ่มเกม</div>
            <div class="menu-desc">เข้าร่วมห้องหรือสร้างห้องใหม่</div>
        </a>
        
        <a href="/how-to-play" class="menu-item howto">
            <span class="menu-icon">📖</span>
            <div class="menu-title">กฎการเล่น</div>
            <div class="menu-desc">ดูวิธีเล่นและความต่างของทั้ง 5 โหมด</div>
        </a>
        
        <a href="/profile?playerId=<%= player.playerId %>" class="menu-item profile">
            <span class="menu-icon">👤</span>
            <div class="menu-title">โปรไฟล์</div>

</style>

<%- contentFor('footer') %>
<!-- No footer needed -->

<%- contentFor('script') %>
<script>
$(function() {
    // เก็บ playerId ใน sessionStorage สำหรับ tab นี้
    const playerId = '<%= player.playerId %>';
    sessionStorage.setItem('playerId', playerId);
    
    // Connect to socket for broadcast messages
    const socket = window.appSocket || io();
    
    // Listen for system broadcasts
    socket.on('systemBroadcast', function(data) {
        Swal.fire({
            icon: 'info',
            title: '📢 ประกาศจากระบบ',
            text: data.message,
            background: '#1e1e1e',
            color: '#fff',
            confirmButtonColor: '#e74c3c'
        });
    });
    
    // Frame styles lookup
    // กรอบมาจาก /static/js/playerAvatar.js แหล่งเดียว จะได้ไม่หลุดกันระหว่างหน้า
    const frameStyles = window.PlayerAvatar.FRAME_STYLES;

    const LEADERBOARD_PAGE_SIZE = 5;
    const CURRENT_SEASON_KEY = 'current';
    const LEADERBOARD_MODES = [
        { id: 'all', label: 'รวม' },
        { id: 'insider', label: 'Insider' },
        { id: 'werewolf', label: 'Werewolf' },
        { id: 'spyfall', label: 'Spyfall' },
        { id: 'coup', label: 'Coup' },
        { id: 'liar', label: 'ไพ่โกหก' },
        { id: 'poker5', label: 'ไพ่ 5 ใบ' },
        { id: 'poker4', label: 'สี่ใบเก' },
        { id: 'blackmarket', label: 'Black Market' }
    ];
    var leaderboardState = {
        entries: [],
        currentPage: 1,
        totalPages: 1,
        activeSeason: CURRENT_SEASON_KEY,   // 'current' หรือเลข season ที่ปิดไปแล้ว
        activeMode: 'all',
        currentSeasonName: 'ปัจจุบัน',
        seasonCache: {}                     // season:mode → { entries, note }
    };

    function leaderboardCacheKey(seasonKey, mode) {
        return String(seasonKey) + ':' + (mode || 'all');
    }

    function leaderboardModeLabel(mode) {
        var found = LEADERBOARD_MODES.find(function(item) { return item.id === mode; });
        return found ? found.label : 'รวม';
    }

    function renderLeaderboardEmpty(message) {
        $('#leaderboardList').html('<div class="leaderboard-empty">' + message + '</div>');
        $('#leaderboardMeta').text(message);
        $('#leaderboardPagination').empty();
    }

    function buildLeaderboardItem(entry) {
        const rankClass = entry.rank <= 3 ? 'rank-' + entry.rank : 'rank-other';
        const frameStyle = frameStyles[entry.avatarFrame] || 'none';

        return `
            <div class="leaderboard-item" data-player-id="${entry.playerId}">
                <div class="leaderboard-rank ${rankClass}">${entry.rank}</div>
                <div class="leaderboard-avatar">
                    <div class="leaderboard-avatar-inner" style="background: ${entry.color}20; border-color: ${entry.color};">
                        ${entry.avatar}
                    </div>
                    ${frameStyle !== 'none' ? '<div class="leaderboard-avatar-frame" style="background: ' + frameStyle + ';"></div>' : ''}
                </div>
                <div class="leaderboard-info">
                    <div class="leaderboard-name" style="color: ${entry.color};">${escapeHtml(entry.playerName)}</div>
                    <div class="leaderboard-stats-mini">${entry.totalGames} เกม · ${entry.winRate}% win</div>
                </div>
                <div class="leaderboard-wins">${entry.wins} 🏆</div>
            </div>
        `;
    }

    function buildLeaderboardPageList(currentPage, totalPages) {
        if (totalPages <= 7) {
            var allPages = [];
            for (var i = 1; i <= totalPages; i++) {
                allPages.push(i);
            }
            return allPages;
        }

        var pages = [];
        var lastAdded = 0;
        var pageIndex;

        for (pageIndex = 1; pageIndex <= totalPages; pageIndex++) {
            if (
                pageIndex === 1 ||
                pageIndex === totalPages ||
                (pageIndex >= currentPage - 1 && pageIndex <= currentPage + 1)
            ) {
                if (lastAdded && pageIndex - lastAdded === 2) {
                    pages.push(lastAdded + 1);
                } else if (lastAdded && pageIndex - lastAdded > 2) {
                    pages.push('ellipsis');
                }
                pages.push(pageIndex);
                lastAdded = pageIndex;
            }
        }

        return pages;
    }

    function renderLeaderboardPagination(totalPages) {
        var $pagination = $('#leaderboardPagination');
        var currentPage = leaderboardState.currentPage;
        var previousPage = currentPage - 1;
        var nextPage = currentPage + 1;
        var pageList;
        var pageToken;
        var pageNumber;
        var i;

        $pagination.empty();

        if (totalPages <= 1) {
            return;
        }

        $pagination.append(
            '<button type="button" class="leaderboard-page" data-page="' + previousPage + '"' +
            (currentPage === 1 ? ' disabled' : '') +
            '>ก่อนหน้า</button>'
        );

        pageList = buildLeaderboardPageList(currentPage, totalPages);
        for (i = 0; i < pageList.length; i++) {
            pageToken = pageList[i];

            if (pageToken === 'ellipsis') {
                $pagination.append('<span class="leaderboard-page-ellipsis" aria-hidden="true">…</span>');
                continue;
            }

            pageNumber = pageToken;
            if (pageNumber === currentPage) {
                $pagination.append(
                    '<button type="button" class="leaderboard-page leaderboard-page-num is-active" data-page="' +
                    pageNumber + '" disabled aria-current="page">' + pageNumber + '</button>'
                );
                continue;
            }

            $pagination.append(
                '<button type="button" class="leaderboard-page leaderboard-page-num" data-page="' +
                pageNumber + '" aria-label="หน้า ' + pageNumber + '">' + pageNumber + '</button>'
            );
        }

        $pagination.append(
            '<button type="button" class="leaderboard-page" data-page="' + nextPage + '"' +
            (currentPage === totalPages ? ' disabled' : '') +
            '>ถัดไป</button>'
        );

        $pagination.append(
            '<form class="leaderboard-page-jump" id="leaderboardPageJumpForm">' +
            '<label class="leaderboard-page-jump-label" for="leaderboardPageJumpInput">ไปหน้า</label>' +
            '<input id="leaderboardPageJumpInput" class="leaderboard-page-jump-input" type="number" min="1" max="' +
            totalPages + '" inputmode="numeric" placeholder="' + currentPage + '" aria-label="หมายเลขหน้า" />' +
            '<span class="leaderboard-page-jump-of">/ ' + totalPages + '</span>' +
            '<button type="submit" class="leaderboard-page leaderboard-page-jump-btn">ไป</button>' +
            '</form>'
        );
    }

    function jumpToLeaderboardPageFromInput() {
        var $input = $('#leaderboardPageJumpInput');
        var totalPages = leaderboardState.totalPages || 1;
        var raw = String($input.val() || '').trim();
        var page = parseInt(raw, 10);

        if (!raw || Number.isNaN(page)) {
            $input.addClass('is-invalid').focus();
            return;
        }

        page = Math.min(Math.max(page, 1), totalPages);
        $input.removeClass('is-invalid').val('');
        renderLeaderboardPage(page);
    }

    function renderLeaderboardPage(page) {
        var totalEntries = leaderboardState.entries.length;

        if (totalEntries === 0) {
            var emptyMessage;
            if (leaderboardState.activeSeason !== CURRENT_SEASON_KEY) {
                emptyMessage = 'season นี้ไม่มีใครติดอันดับ';
            } else if (leaderboardState.activeMode !== 'all') {
                emptyMessage = 'ยังไม่มีใครเล่น ' + leaderboardModeLabel(leaderboardState.activeMode) + ' season นี้';
            } else {
                emptyMessage = 'ยังไม่มีข้อมูล เล่นเกมเพื่อติดอันดับ!';
            }
            renderLeaderboardEmpty(emptyMessage);
            return;
        }

        var totalPages = Math.ceil(totalEntries / LEADERBOARD_PAGE_SIZE);
        leaderboardState.totalPages = totalPages;
        var safePage = Math.min(Math.max(page, 1), totalPages);
        var startIndex = (safePage - 1) * LEADERBOARD_PAGE_SIZE;
        var visibleEntries = leaderboardState.entries.slice(startIndex, startIndex + LEADERBOARD_PAGE_SIZE);
        var $list = $('#leaderboardList');

        leaderboardState.currentPage = safePage;
        $list.empty();

        for (var i = 0; i < visibleEntries.length; i++) {
            $list.append(buildLeaderboardItem(visibleEntries[i]));
        }

        var metaText = 'อันดับ ' + (startIndex + 1) + '-' + (startIndex + visibleEntries.length) +
            ' จาก ' + totalEntries + ' คน';
        if (leaderboardState.activeMode !== 'all') {
            metaText += ' · ' + leaderboardModeLabel(leaderboardState.activeMode);
        }
        $('#leaderboardMeta').text(metaText);

        renderLeaderboardPagination(totalPages);
    }
    
    function formatSeasonDate(isoDate) {
        if (!isoDate) return null;

        var date = new Date(isoDate);
        if (Number.isNaN(date.getTime())) return null;

        return date.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function buildSeasonNote(season) {
        var from = formatSeasonDate(season.startedAt);
        var to = formatSeasonDate(season.endedAt);
        var parts = [];

        if (from && to) {
            parts.push(from + ' – ' + to);
        } else if (to) {
            parts.push('ปิดเมื่อ ' + to);
        }

        parts.push(season.totalPlayers + ' คนติดอันดับ');

        return '📚 อันดับสุดท้ายของ ' + season.name + ' · ' + parts.join(' · ') +
            ' · season เก่าเก็บแค่รวมทุกโหมด';
    }

    function renderSeasonTabs(seasons) {
        var $tabs = $('#leaderboardSeasons');

        // มีแค่ season ปัจจุบัน = ยังไม่เคยรีแรงค์ ไม่ต้องโชว์แท็บ
        if (!seasons.archived.length) {
            $tabs.empty();
            return;
        }

        $tabs.empty();
        $tabs.append(buildSeasonTab(CURRENT_SEASON_KEY, leaderboardState.currentSeasonName));

        for (var i = 0; i < seasons.archived.length; i++) {
            $tabs.append(buildSeasonTab(seasons.archived[i].number, seasons.archived[i].name));
        }
    }

    function buildSeasonTab(key, label) {
        var isActive = String(leaderboardState.activeSeason) === String(key);

        return $('<button type="button" class="leaderboard-season-tab"></button>')
            .toggleClass('is-active', isActive)
            .attr('data-season', key)
            .attr('aria-pressed', isActive ? 'true' : 'false')
            .prop('disabled', isActive)
            .text(label);
    }

    function renderModeTabs() {
        var $tabs = $('#leaderboardModes');
        var isArchive = leaderboardState.activeSeason !== CURRENT_SEASON_KEY;

        $tabs.empty();
        LEADERBOARD_MODES.forEach(function(mode) {
            var isActive = leaderboardState.activeMode === mode.id;
            var disabled = isActive || (isArchive && mode.id !== 'all');

            $tabs.append(
                $('<button type="button" class="leaderboard-mode-tab"></button>')
                    .toggleClass('is-active', isActive)
                    .attr('data-mode', mode.id)
                    .attr('aria-pressed', isActive ? 'true' : 'false')
                    .prop('disabled', disabled)
                    .text(mode.label)
            );
        });
    }

    function showSeasonEntries(key, entries, note, mode) {
        leaderboardState.activeSeason = key;
        leaderboardState.activeMode = mode || 'all';
        leaderboardState.entries = Array.isArray(entries) ? entries : [];
        leaderboardState.currentPage = 1;
        leaderboardState.seasonCache[leaderboardCacheKey(key, leaderboardState.activeMode)] = {
            entries: leaderboardState.entries,
            note: note || ''
        };

        $('#leaderboardSeasonNote').text(note || '');
        $('#leaderboardSeasons .leaderboard-season-tab').each(function() {
            var isActive = String($(this).data('season')) === String(key);
            $(this).toggleClass('is-active', isActive)
                .attr('aria-pressed', isActive ? 'true' : 'false')
                .prop('disabled', isActive);
        });
        renderModeTabs();
        renderLeaderboardPage(1);
    }

    // โหลดตารางอันดับของ season ที่เลือก ('current' = อันดับสด)
    function loadLeaderboard(key, mode) {
        var seasonKey = key === undefined ? leaderboardState.activeSeason : key;
        var modeKey = mode === undefined ? leaderboardState.activeMode : mode;

        if (seasonKey !== CURRENT_SEASON_KEY) {
            modeKey = 'all';
        }

        var cached = leaderboardState.seasonCache[leaderboardCacheKey(seasonKey, modeKey)];

        if (cached) {
            showSeasonEntries(seasonKey, cached.entries, cached.note, modeKey);
            return;
        }

        var isCurrent = seasonKey === CURRENT_SEASON_KEY;
        var url = isCurrent
            ? (modeKey === 'all' ? '/api/leaderboard' : '/api/leaderboard?mode=' + encodeURIComponent(modeKey))
            : '/api/seasons/' + seasonKey + '/leaderboard';

        $.ajax({
            url: url,
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (isCurrent) {
                    showSeasonEntries(seasonKey, Array.isArray(data) ? data : [], '', modeKey);
                    return;
                }

                showSeasonEntries(seasonKey, data && data.entries, buildSeasonNote(data || {}), 'all');
            },
            error: function(xhr, status, error) {
                console.error('Leaderboard error:', error);
                renderLeaderboardEmpty('ไม่สามารถโหลดข้อมูลได้');
            }
        });
    }

    // โหลดรายชื่อ season เพื่อสร้างแท็บประวัติ
    function loadSeasonTabs() {
        $.ajax({
            url: '/api/seasons',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                var current = (data && data.current) || {};
                var archived = (data && Array.isArray(data.archived)) ? data.archived : [];

                leaderboardState.currentSeasonName = current.name
                    ? current.name + ' (ตอนนี้)'
                    : 'ปัจจุบัน';

                renderSeasonTabs({ current: current, archived: archived });
            },
            error: function(xhr, status, error) {
                console.error('Seasons error:', error);
            }
        });
    }

    // Load leaderboard on page load
    renderModeTabs();
    loadLeaderboard();
    loadSeasonTabs();

    $(document).on('click', '.leaderboard-mode-tab:not(:disabled)', function() {
        loadLeaderboard(CURRENT_SEASON_KEY, $(this).data('mode'));
    });

    $(document).on('click', '.leaderboard-season-tab:not(:disabled)', function() {
        var key = $(this).data('season');
        loadLeaderboard(key === CURRENT_SEASON_KEY ? CURRENT_SEASON_KEY : key);
    });

    // Click on leaderboard item to view profile
    $(document).on('click', '.leaderboard-item', function() {
        const targetPlayerId = $(this).data('player-id');
        showPlayerProfile(targetPlayerId);
    });

    $(document).on('click', '.leaderboard-page:not(:disabled)', function() {
        var page = parseInt($(this).data('page'), 10);

        if (!Number.isNaN(page)) {
            renderLeaderboardPage(page);
        }
    });

    $(document).on('submit', '#leaderboardPageJumpForm', function(event) {
        event.preventDefault();
        jumpToLeaderboardPageFromInput();
    });

    $(document).on('input', '#leaderboardPageJumpInput', function() {
        $(this).removeClass('is-invalid');
    });
    
    // Show player profile modal
    function showPlayerProfile(targetPlayerId) {
        const blackMarketRoleMeta = [
            { id: 'boss', icon: '🎩', label: 'เจ้าพ่อ' },
            { id: 'broker', icon: '🕴️', label: 'นายหน้า' },
            { id: 'smuggler', icon: '🚚', label: 'คนส่งของ' },
            { id: 'fixer', icon: '🧹', label: 'คนเคลียร์ทาง' },
            { id: 'hitman', icon: '🔫', label: 'มือเก็บงาน' },
            { id: 'mole', icon: '🕶️', label: 'สายข่าว' },
            { id: 'doubleAgent', icon: '🃏', label: 'สองหน้า' }
        ];

        $.get('/api/player/' + targetPlayerId + '/profile', function(data) {
            const frameStyle = frameStyles[data.avatarFrame] || 'none';
            const joinedDate = new Date(data.createdAt).toLocaleDateString('th-TH');
            const lastPlayed = data.stats?.lastPlayedAt ? new Date(data.stats.lastPlayedAt).toLocaleDateString('th-TH') : 'ยังไม่เคยเล่น';
            
            const stats = data.stats || {
                totalGames: 0,
                wins: 0,
                losses: 0,
                winRate: 0,
                roleStats: { gameMasterCount: 0, traitorCount: 0, citizenCount: 0 },
                winByRole: { winAsTraitor: 0, winAsCitizen: 0 },
                modeStats: {
                    insider: { games: 0, wins: 0, losses: 0 },
                    werewolf: { games: 0, wins: 0, losses: 0 },
                    blackmarket: { games: 0, wins: 0, losses: 0 },
                    spyfall: { games: 0, wins: 0, losses: 0 }
                }
            };
            const blackMarketRoleStats = blackMarketRoleMeta.filter(function(role) {
                return Number(stats.roleStats?.blackmarket?.[role.id] || 0) > 0;
            });
            const blackMarketRoleHtml = blackMarketRoleStats.length
                ? blackMarketRoleStats.map(function(role) {
                    return `
                        <div class="profile-role-row">
                            <span>${role.icon} ${role.label}</span>
                            <span>${stats.roleStats.blackmarket[role.id] || 0} ครั้ง (ชนะ ${stats.winByRole?.blackmarket?.[role.id] || 0})</span>
                        </div>
                    `;
                }).join('')
                : '<div class="profile-role-row"><span>🎩 บทตลาดมืด</span><span>ยังไม่มีสถิติ</span></div>';
            
            const history = Array.isArray(stats.gameHistory) ? stats.gameHistory.slice(0, 5) : [];
            const historyHtml = history.length > 0
                ? history.map(function(game) {
                    const mode = game.mode || 'insider';
                    const isWerewolf = mode === 'werewolf';
                    const isBlackMarket = mode === 'blackmarket';
                    const isSpyfall = mode === 'spyfall';
                    const isCoup = mode === 'coup';
                    const isLiar = mode === 'liar';
                    const isPoker5 = mode === 'poker5';
                    const isPoker4 = mode === 'poker4';
                    const modeLabel = isWerewolf ? '🐺 Werewolf'
                        : (isBlackMarket ? '🎩 Black Market'
                            : (isSpyfall ? '🕵️ Spyfall'
                                : (isCoup ? '👑 Coup'
                                    : (isLiar ? '🃏 ไพ่โกหก'
                                        : (isPoker5 ? '♠ ไพ่ 5 ใบ'
                                            : (isPoker4 ? '♦ สี่ใบเก' : '🎯 Insider'))))));
                    const modeClass = isWerewolf ? 'werewolf' : (isBlackMarket ? 'blackmarket' : (isSpyfall ? 'spyfall' : (isCoup ? 'coup' : (isLiar ? 'liar' : (isPoker5 || isPoker4 ? 'coup' : 'insider')))));
                    const detailPrimary = isWerewolf
                        ? 'ทีมชนะ: ' + escapeHtml(game.winnerLabel || (game.winner === 'werewolf' ? 'หมาป่า' : 'ชาวบ้าน'))
                        : (isBlackMarket
                            ? 'เจ้าโต๊ะ: ' + escapeHtml(game.winnerLabel || 'ไม่ทราบ')
                            : (isSpyfall
                                ? 'สถานที่: ' + escapeHtml(game.location || 'ไม่ทราบ')
                                : (isCoup || isLiar
                                    ? escapeHtml(game.resultText || ((game.winnerName || 'คนอื่น') + ' รอดเป็นคนสุดท้าย'))
                                    : 'จอมบงการ: ' + escapeHtml(game.traitor || 'ไม่ทราบ'))));
                    const detailSecondary = isWerewolf
                        ? (game.survived ? 'อยู่รอดจนจบ' : 'ไม่รอดจนจบ')
                        : (isBlackMarket
                            ? `👑 ${Number(game.influence || 0)} • 💵 ${Number(game.cash || 0)} • 🔥 ${Number(game.heat || 0)}`
                            : (isSpyfall
                                ? `สายลับ: ${escapeHtml(game.spyName || 'ไม่ทราบ')} • ${game.citizensWon ? 'พลเมืองชนะ' : 'สายลับรอด'}`
                                : (isCoup || isLiar ? '' : escapeHtml(game.word || 'ไม่ทราบคำ'))));
                    const gameDate = game.date
                        ? new Date(game.date).toLocaleString('th-TH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
                        : '-';

                    return `
                        <div class="profile-history-item ${game.won ? 'won' : 'lost'}">
                            <div class="profile-history-top">
                                <span>${game.won ? '🏆 ชนะ' : '💔 แพ้'} · ${escapeHtml(game.role || 'ไม่ทราบบท')}</span>
                                <span class="profile-history-mode ${modeClass}">${modeLabel}</span>
                            </div>
                            <div class="profile-history-meta">
                                <span>🏠 ${escapeHtml(game.roomName || 'ไม่ทราบห้อง')}</span>
                                <span>👥 ${game.playerCount || 0} คน</span>
                                <span>🕒 ${gameDate}</span>
                            </div>
                            <div class="profile-history-meta" style="margin-top: 4px;">
                                <span>${detailPrimary}</span>
                                <span>${detailSecondary}</span>
                            </div>
                        </div>
                    `;
                }).join('')
                : '<div class="profile-history-empty">ยังไม่มีประวัติให้ดู</div>';

            const html = `
                <div class="profile-modal-content">
                    <div class="profile-modal-header">
                        <div class="profile-modal-avatar">
                            <div class="profile-modal-avatar-inner" style="background: ${data.color}20; border-color: ${data.color};">
                                ${data.avatar}
                            </div>
                            ${frameStyle !== 'none' ? '<div class="profile-modal-avatar-frame" style="background: ' + frameStyle + ';"></div>' : ''}
                        </div>
                        <div>
                            <h2 class="profile-modal-name" style="color: ${data.color};">${escapeHtml(data.playerName)}</h2>
                            <p class="profile-modal-joined">เข้าร่วมเมื่อ: ${joinedDate}</p>
                        </div>
                    </div>
                    
                    <div class="profile-modal-stats">
                        <div class="profile-stat-box">
                            <div class="profile-stat-value" style="color: #3498db;">${stats.totalGames}</div>
                            <div class="profile-stat-label">เกมที่เล่น</div>
                        </div>
                        <div class="profile-stat-box">
                            <div class="profile-stat-value" style="color: #2ecc71;">${stats.wins}</div>
                            <div class="profile-stat-label">ชนะ</div>
                        </div>
                        <div class="profile-stat-box">
                            <div class="profile-stat-value" style="color: #f39c12;">${stats.winRate}%</div>
                            <div class="profile-stat-label">Win Rate</div>
                        </div>
                    </div>
                    
                    <div class="profile-roles">
                        <h4>🎭 สถิติบทบาท</h4>
                        <div class="profile-role-row">
                            <span>🟢 ผู้ดำเนินเกม</span>
                            <span>${stats.roleStats.gameMasterCount} ครั้ง</span>
                        </div>
                        <div class="profile-role-row">
                            <span>🔴 จอมบงการ</span>
                            <span>${stats.roleStats.traitorCount} ครั้ง (ชนะ ${stats.winByRole.winAsTraitor})</span>
                        </div>
                        <div class="profile-role-row">
                            <span>🔵 พลเมือง</span>
                            <span>${stats.roleStats.citizenCount} ครั้ง (ชนะ ${stats.winByRole.winAsCitizen})</span>
                        </div>
                        <div class="profile-role-row">
                            <span>🕐 เล่นล่าสุด</span>
                            <span>${lastPlayed}</span>
                        </div>
                        <div class="profile-role-row">
                            <span>🎯 Insider</span>
                            <span>${stats.modeStats?.insider?.games || 0} เกม</span>
                        </div>
                        <div class="profile-role-row">
                            <span>🐺 Werewolf</span>
                            <span>${stats.modeStats?.werewolf?.games || 0} เกม</span>
                        </div>
                        <div class="profile-role-row">
                            <span>🎩 Black Market</span>
                            <span>${stats.modeStats?.blackmarket?.games || 0} เกม · ชนะ ${stats.modeStats?.blackmarket?.wins || 0}</span>
                        </div>
                        <div class="profile-role-row">
                            <span>🕵️ Spyfall</span>
                            <span>${stats.modeStats?.spyfall?.games || 0} เกม · ชนะ ${stats.modeStats?.spyfall?.wins || 0}</span>
                        </div>
                        <div class="profile-role-row">
                            <span>👑 Coup</span>
                            <span>${stats.modeStats?.coup?.games || 0} เกม · ชนะ ${stats.modeStats?.coup?.wins || 0}</span>
                        </div>
                        <div class="profile-role-row">
                            <span>🃏 ไพ่โกหก</span>
                            <span>${stats.modeStats?.liar?.games || 0} เกม · ชนะ ${stats.modeStats?.liar?.wins || 0}</span>
                        </div>
                        <div class="profile-role-row">
                            <span>♠ ไพ่ 5 ใบ</span>
                            <span>${stats.modeStats?.poker5?.games || 0} เกม · ชนะ ${stats.modeStats?.poker5?.wins || 0}</span>
                        </div>
                        <div class="profile-role-row">
                            <span>♦ สี่ใบเก</span>
                            <span>${stats.modeStats?.poker4?.games || 0} เกม · ชนะ ${stats.modeStats?.poker4?.wins || 0}</span>
                        </div>
                        ${blackMarketRoleHtml}
                    </div>

                    <div class="profile-history">
                        <h4>📜 5 เกมล่าสุด</h4>
                        <div class="profile-history-list">${historyHtml}</div>
                    </div>
                </div>
            `;
            
            Swal.fire({
                title: '',
                html: html,
                background: '#1a1a2e',
                color: '#fff',
                showConfirmButton: true,
                confirmButtonText: 'ปิด',
                confirmButtonColor: '#e74c3c',
                width: 620
            });
        }).fail(function() {
            Swal.fire({
                icon: 'error',
                title: 'ไม่พบข้อมูล',
                text: 'ไม่สามารถโหลดโปรไฟล์ได้',
                background: '#1e1e1e',
                color: '#fff',
                confirmButtonColor: '#e74c3c'
            });
        });
    }
    
    // Escape HTML helper
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
    // Donate Button Handler
    $('#donateBtn').on('click', function() {
        $('#donateModal').addClass('show');
    });

    $('#closeDonate').on('click', function() {
        $('#donateModal').removeClass('show');
    });

    $('#donateModal').on('click', function(e) {
        if (e.target === this) {
            $(this).removeClass('show');
        }
    });
    

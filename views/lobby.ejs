            width: 500,
            customClass: {
                popup: 'patch-notes-popup'
            }
        }).then(() => {
            // Check if user ticked the checkbox
            const hideCheckbox = document.getElementById('hidePatchFor7Days');
            if (hideCheckbox && hideCheckbox.checked) {
                // Hide for 7 days
                const sevenDaysFromNow = Date.now() + (7 * 24 * 60 * 60 * 1000);
                localStorage.setItem(patchSeenKey, sevenDaysFromNow.toString());
            }
        });
    }


    const patchSeenKey = `hide_patch_${patchVersion}_s<%= currentSeason.number %>_${playerId}`;
    // ประกาศรีแรงค์เรนเดอร์เป็น HTML ไว้แล้ว (ชื่อผู้เล่นผ่าน escape ของ EJS) ค่อยหยิบมาใส่ popup

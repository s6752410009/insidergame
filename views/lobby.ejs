    border-radius: 16px;
    border: 2px solid #444;
    text-align: center;
    max-width: 400px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.8);
    position: relative;
}

.donate-modal-content h2 {
    color: #fff;
    font-size: 1.8em;
    margin-bottom: 20px;

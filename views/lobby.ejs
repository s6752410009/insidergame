<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
    .lobby-container {
        max-width: 900px;
        margin: 30px auto;
        padding: 20px;
        font-family: 'Rajdhani', sans-serif;
    }
    
    /* Player Card */
    .player-card {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border: 3px solid #444;
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        position: relative;
        overflow: hidden;
    }
    
    .player-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, #e74c3c, #f39c12, #e74c3c);
    }
    
    .player-info {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    
    .player-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5em;
        border: 4px solid;
        box-shadow: 0 0 20px rgba(255,255,255,0.2);
    }
    
    .player-details h2 {
        margin: 0 0 5px 0;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.8em;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }
    
    .player-details p {
        margin: 0;
        color: #888;
        font-size: 0.9em;
    }
    
    .player-details p code {
        background: rgba(255,255,255,0.1);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85em;
    }
    
    /* Menu Grid */
    .menu-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .menu-item {
        background: linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 100%);
        border: 3px solid #444;
        border-radius: 16px;
        padding: 30px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }
    
    .menu-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
        transition: left 0.5s;
    }
    
    .menu-item:hover::before {
        left: 100%;
    }
    
    .menu-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    
    .menu-item.play {
        border-color: #e74c3c;
        grid-column: span 2;
    }
    
    .menu-item.play:hover {
        border-color: #ff6b6b;
        box-shadow: 0 10px 30px rgba(231, 76, 60, 0.4);
    }
    
    .menu-item.profile {
        border-color: #3498db;
    }
    
    .menu-item.profile:hover {
        border-color: #5dade2;
        box-shadow: 0 10px 30px rgba(52, 152, 219, 0.4);
    }
    
    .menu-item.settings {
        border-color: #f39c12;
    }
    
    .menu-item.settings:hover {
        border-color: #f1c40f;
        box-shadow: 0 10px 30px rgba(243, 156, 18, 0.4);
    }
    
    .menu-item.howto {
        border-color: #9b59b6;
        grid-column: span 2;
    }
    
    .menu-item.howto:hover {
        border-color: #a569bd;
        box-shadow: 0 10px 30px rgba(155, 89, 182, 0.4);
    }
    
    .menu-item.howto .menu-icon {
        font-size: 4em;
    }
    
    .menu-item.howto .menu-title {
        font-size: 1.8em;
    }
    
    .menu-icon {
        font-size: 3em;
        margin-bottom: 15px;
        display: block;
    }
    
    .menu-item.play .menu-icon {
        font-size: 4em;
    }
    
    .menu-title {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.4em;
        color: #fff;
        margin-bottom: 8px;
    }
    
    .menu-item.play .menu-title {
        font-size: 1.8em;
    }
    
    .menu-desc {
        color: #888;
        font-size: 0.95em;
    }
    
    /* Quick Stats */
    .quick-stats {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid #333;
    }
    
    .quick-stat {
        text-align: center;
    }
    
    .quick-stat-value {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.5em;
        font-weight: 700;
        color: #fff;
    }
    
    .quick-stat-label {
        color: #666;
        font-size: 0.85em;
    }
    
    /* Bottom Links */
    .bottom-links {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }
    
    .bottom-link {
        padding: 12px 24px;
        background: #333;
        border: 2px solid #444;
        border-radius: 8px;
        color: #aaa;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .bottom-link:hover {
        background: #444;
        color: #fff;
        border-color: #555;
    }
    
    .bottom-link.admin {
        border-color: #9b59b6;
        color: #9b59b6;
    }
    
    .bottom-link.admin:hover {
        background: #9b59b6;
        color: #fff;
    }

    @media (max-width: 600px) {
        .menu-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }
        
        .menu-item {
            padding: 20px 12px;
        }
        
        .menu-item .menu-icon {
            font-size: 2em;
        }
        
        .menu-item .menu-title {
            font-size: 1em;
        }
        
        .menu-item .menu-desc {
            font-size: 0.75em;
        }
        
        .menu-item.play {
            grid-column: span 2;
        }
        
        .player-info {
            flex-direction: column;
            text-align: center;
        }
        
        .quick-stats {
            flex-wrap: wrap;
        }
        
        .leaderboard-card {
            padding: 15px;
        }
        
        .leaderboard-header h3 {
            font-size: 1.1em;
        }
        
        .lobby-container {
            padding: 15px;
        }
        
        .lobby-container h1 {
            font-size: 1.8em;
        }
    }
    
    /* Leaderboard */
    .leaderboard-card {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border: 3px solid #444;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }
    
    .leaderboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #333;
    }
    
    .leaderboard-header h3 {
        margin: 0;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.4em;
        color: #ffd700;
    }
    
    .leaderboard-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    
    .leaderboard-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px 15px;
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
        transition: all 0.3s;
        cursor: pointer;
    }
    
    .leaderboard-item:hover {
        background: rgba(255,255,255,0.08);
        transform: translateX(5px);
    }
    
    .leaderboard-rank {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 0.9em;
    }
    
    .leaderboard-rank.rank-1 { background: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%); color: #000; }
    .leaderboard-rank.rank-2 { background: linear-gradient(135deg, #c0c0c0 0%, #808080 100%); color: #000; }
    .leaderboard-rank.rank-3 { background: linear-gradient(135deg, #cd7f32 0%, #8b4513 100%); color: #fff; }
    .leaderboard-rank.rank-other { background: #333; color: #888; }
    
    .leaderboard-avatar {
        position: relative;
        width: 45px;
        height: 45px;
    }
    
    .leaderboard-avatar-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5em;
        border: 3px solid;
        position: relative;
        z-index: 2;
        background: #1a1a2e;
    }
    
    .leaderboard-avatar-frame {
        position: absolute;
        top: -4px;
        left: -4px;
        right: -4px;
        bottom: -4px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
    }
    
    .leaderboard-info {
        flex: 1;
    }
    
    .leaderboard-name {
        font-weight: 700;
        font-size: 1.1em;
        color: #fff;
    }
    
    .leaderboard-stats-mini {
        font-size: 0.85em;
        color: #888;
    }
    
    .leaderboard-wins {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        color: #2ecc71;
        font-size: 1.1em;
    }
    
    .leaderboard-empty {
        text-align: center;
        padding: 30px;
        color: #666;
    }
    
    /* Profile Modal */
    .profile-modal-content {
        text-align: left;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .profile-modal-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 2px solid #333;
    }
    
    .profile-modal-avatar {
        position: relative;
        width: 80px;
        height: 80px;
    }
    
    .profile-modal-avatar-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5em;
        border: 4px solid;
        position: relative;
        z-index: 2;
        background: #1a1a2e;
    }
    
    .profile-modal-avatar-frame {
        position: absolute;
        top: -5px;
        left: -5px;
        right: -5px;
        bottom: -5px;
        border-radius: 50%;
        z-index: 1;
    }
    
    .profile-modal-name {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.5em;
        margin: 0;
    }
    
    .profile-modal-joined {
        color: #888;
        font-size: 0.9em;
    }
    
    .profile-modal-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }
    
    .profile-stat-box {
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 12px;
        text-align: center;
    }
    
    .profile-stat-value {
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 1.5em;
    }
    
    .profile-stat-label {
        color: #888;
        font-size: 0.85em;
    }
    
    .profile-roles {
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 12px;
    }
    
    .profile-roles h4 {
        margin: 0 0 10px 0;
        color: #f39c12;
        font-size: 1em;
    }
    
    .profile-role-row {
        display: flex;
        justify-content: space-between;
        padding: 5px 0;
        border-bottom: 1px solid #333;
    }
    
    .profile-role-row:last-child {
        border-bottom: none;
    }
</style>

<div class="lobby-container">
    <!-- Player Card -->
    <div class="player-card">
        <div class="player-info">
            <div class="player-avatar" style="background: <%= player.color %>20; border-color: <%= player.color %>; color: <%= player.color %>;">
                <%= player.avatar || '👤' %>
            </div>
            <div class="player-details">
                <h2 style="color: <%= player.color %>;"><%= player.playerName %></h2>
                <p>Player ID: <code><%= player.playerId.substring(0, 8) %>...</code></p>
            </div>
        </div>
        
        <div class="quick-stats">
            <div class="quick-stat">
                <div class="quick-stat-value" style="color: #3498db;"><%= stats ? stats.totalGames : 0 %></div>
                <div class="quick-stat-label">เกมที่เล่น</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-value" style="color: #2ecc71;"><%= stats ? stats.wins : 0 %></div>
                <div class="quick-stat-label">ชนะ</div>
            </div>
            <div class="quick-stat">
                <div class="quick-stat-value" style="color: #f39c12;"><%= stats ? (stats.totalGames > 0 ? Math.round((stats.wins / stats.totalGames) * 100) : 0) : 0 %>%</div>
                <div class="quick-stat-label">Win Rate</div>
            </div>
        </div>
    </div>
    
    <!-- Menu Grid -->
    <div class="menu-grid">
        <a href="/rooms?playerId=<%= player.playerId %>" class="menu-item play">
            <span class="menu-icon">🎮</span>
            <div class="menu-title">เริ่มเกม</div>
            <div class="menu-desc">เข้าร่วมห้องหรือสร้างห้องใหม่</div>
        </a>
        
        <a href="#" class="menu-item howto" id="howToPlayBtn">
            <span class="menu-icon">📖</span>
            <div class="menu-title">กฎการเล่น</div>
            <div class="menu-desc">เรียนรู้วิธีเล่น Insider</div>
        </a>
        
        <a href="/profile?playerId=<%= player.playerId %>" class="menu-item profile">
            <span class="menu-icon">👤</span>
            <div class="menu-title">โปรไฟล์</div>
            <div class="menu-desc">ดูสถิติและแก้ไขข้อมูล</div>
        </a>
        
        <a href="/settings?playerId=<%= player.playerId %>" class="menu-item settings">
            <span class="menu-icon">⚙️</span>
            <div class="menu-title">ตั้งค่า</div>
            <div class="menu-desc">เสียง, แจ้งเตือน, อื่นๆ</div>
        </a>
    </div>
    
    <!-- Leaderboard -->
    <div class="leaderboard-card">
        <div class="leaderboard-header">
            <h3>🏆 Leaderboard</h3>
        </div>
        <div class="leaderboard-list" id="leaderboardList">
            <div class="leaderboard-empty">กำลังโหลด...</div>
        </div>
    </div>
    
    <!-- Bottom Links (Admin link hidden - access via /admin/login) -->
    <!-- <div class="bottom-links">
        <a href="/admin" class="bottom-link admin">🛠️ Admin Dashboard</a>
    </div> -->
</div>

<!-- Floating Donate Button -->
<button class="floating-donate-btn" id="donateBtn" title="Buy me a coffee!">
    <div>☕<br/>Donate</div>
</button>

<!-- Donate Modal -->
<div id="donateModal" class="donate-modal">
    <div class="donate-modal-content">
        <button class="donate-close-btn" id="closeDonate">&times;</button>
        <h2>☕ Buy Me a Coffee</h2>
        <p>ช่วยสนับสนุนพัฒนาเกมให้ดีขึ้น</p>
        <div class="donate-qr-code">
            <img src="/static/image/qr.png" alt="Donate QR Code">
        </div>
        <p class="donate-footer-text">สแกน QR code เพื่อทำการโดเนท</p>
    </div>
</div>

<style>
/* Floating Donate Button */
.floating-donate-btn {
    position: fixed;
    bottom: 80px;
    right: 30px;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
    border: 3px solid #fff;
    color: white;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(255, 107, 107, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    z-index: 9999;
    transition: all 0.3s ease;
    animation: donateFloat 3s ease-in-out infinite;
}

.floating-donate-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(255, 107, 107, 0.6);
    animation: none;
}

@keyframes donateFloat {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

/* Donate Modal */
.donate-modal {
    display: none;
    position: fixed;
    z-index: 10000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.7);
    align-items: center;
    justify-content: center;
}

.donate-modal.show {
    display: flex !important;
}

.donate-modal-content {
    background: linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 100%);
    padding: 40px;
    border-radius: 16px;
    border: 2px solid #444;
    text-align: center;
    max-width: 400px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.8);
    position: relative;
}

.donate-modal-content h2 {
    color: #fff;
    font-size: 1.8em;
    margin-bottom: 20px;
    font-family: 'Orbitron', sans-serif;
}

.donate-modal-content p {
    color: #ccc;
    margin-bottom: 20px;
    font-size: 1.1em;
}

.donate-qr-code {
    width: 100%;
    max-width: 300px;
    margin: 20px auto;
    border: 3px solid #444;
    border-radius: 8px;
    background: white;
    padding: 10px;
}

.donate-modal-content img {
    max-width: 100%;
}

.donate-close-btn {
    position: absolute;
    right: 20px;
    top: 15px;
    font-size: 28px;
    font-weight: bold;
    color: #888;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    line-height: 1;
}

.donate-close-btn:hover {
    color: #fff;
}

.donate-footer-text {
    color: #888;
    font-size: 0.9em;
    margin-top: 15px;
}

@media (max-width: 768px) {
    .floating-donate-btn {
        width: 60px;
        height: 60px;
        bottom: 75px;
        right: 20px;
        font-size: 12px;
    }
    
    .donate-modal-content {
        margin: 20px;
        padding: 30px;
    }
}
</style>

<%- contentFor('footer') %>
<!-- No footer needed -->

<%- contentFor('script') %>
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
$(function() {
    // เก็บ playerId ใน sessionStorage สำหรับ tab นี้
    const playerId = '<%= player.playerId %>';
    sessionStorage.setItem('playerId', playerId);
    
    // Connect to socket for broadcast messages
    const socket = io();
    
    // Listen for system broadcasts
    socket.on('systemBroadcast', function(data) {
        Swal.fire({
            icon: 'info',
            title: '📢 ประกาศจากระบบ',
            text: data.message,
            background: '#1e1e1e',
            color: '#fff',
            confirmButtonColor: '#e74c3c'
        });
    });
    
    // Frame styles lookup
    const frameStyles = {
        'none': 'none',
        'bronze': 'linear-gradient(135deg, #cd7f32 0%, #8b4513 100%)',
        'silver': 'linear-gradient(135deg, #c0c0c0 0%, #808080 100%)',
        'gold': 'linear-gradient(135deg, #ffd700 0%, #ff8c00 100%)',
        'diamond': 'linear-gradient(135deg, #b9f2ff 0%, #00bfff 100%)',
        'fire': 'linear-gradient(135deg, #ff4500 0%, #ff0000 100%)',
        'rainbow': 'linear-gradient(135deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #8b00ff)',
        'neon': 'linear-gradient(135deg, #00ff00 0%, #00ffff 50%, #ff00ff 100%)'
    };
    
    // Load Leaderboard
    function loadLeaderboard() {
        console.log('Loading leaderboard...');
        $.ajax({
            url: '/api/leaderboard?limit=5',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                console.log('Leaderboard data:', data);
                var $list = $('#leaderboardList');
                $list.empty();
                
                // ตรวจสอบว่า data เป็น array
                var leaderboardData = Array.isArray(data) ? data : [];
                
                if (leaderboardData.length === 0) {
                    $list.html('<div class="leaderboard-empty">ยังไม่มีข้อมูล เล่นเกมเพื่อติดอันดับ!</div>');
                    return;
                }
                
                for (var i = 0; i < leaderboardData.length; i++) {
                    var entry = leaderboardData[i];
                    const rankClass = entry.rank <= 3 ? 'rank-' + entry.rank : 'rank-other';
                    const frameStyle = frameStyles[entry.avatarFrame] || 'none';
                const frameBorder = frameStyle !== 'none' ? 'border-image: ' + frameStyle + ' 1;' : '';
                
                const html = `
                    <div class="leaderboard-item" data-player-id="${entry.playerId}">
                        <div class="leaderboard-rank ${rankClass}">${entry.rank}</div>
                        <div class="leaderboard-avatar">
                            <div class="leaderboard-avatar-inner" style="background: ${entry.color}20; border-color: ${entry.color};">
                                ${entry.avatar}
                            </div>
                            ${frameStyle !== 'none' ? '<div class="leaderboard-avatar-frame" style="background: ' + frameStyle + ';"></div>' : ''}
                        </div>
                        <div class="leaderboard-info">
                            <div class="leaderboard-name" style="color: ${entry.color};">${escapeHtml(entry.playerName)}</div>
                            <div class="leaderboard-stats-mini">${entry.totalGames} เกม · ${entry.winRate}% win</div>
                        </div>
                        <div class="leaderboard-wins">${entry.wins} 🏆</div>
                    </div>
                `;
                    $list.append(html);
                }
            },
            error: function(xhr, status, error) {

                    <label style="display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; color: #888; font-size: 0.85em;">
                        <input type="checkbox" id="hidePatchFor7Days" style="width: 16px; height: 16px; cursor: pointer;">
                        <span>ไม่แสดงอีก 7 วัน</span>
                    </label>
                </div>
            `,
            icon: 'info',
            confirmButtonText: '👍 เข้าใจแล้ว!',
            confirmButtonColor: '#2ecc71',
            background: '#1a1a2e',
            color: '#fff',
            width: 500,
            customClass: {
                popup: 'patch-notes-popup'
            }
        }).then(() => {
            // Check if user ticked the checkbox
            const hideCheckbox = document.getElementById('hidePatchFor7Days');
            if (hideCheckbox && hideCheckbox.checked) {
                // Hide for 7 days
                const sevenDaysFromNow = Date.now() + (7 * 24 * 60 * 60 * 1000);
                localStorage.setItem(patchSeenKey, sevenDaysFromNow.toString());
            }
        });
    }


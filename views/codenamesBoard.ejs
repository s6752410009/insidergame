<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/chatPanel.css">
<style>
  html.cn-active, html.cn-active body.content {
    overflow-x: hidden;
    margin: 0 !important;
    padding: 0 !important;
    background: oklch(0.17 0.03 255) !important;
  }
  html.cn-active .container-fluid > header,
  html.cn-active .footer,
  html.cn-active #music-controls { display: none !important; }
  html.cn-active .container-fluid { padding: 0 !important; margin: 0 !important; max-width: none !important; background: oklch(0.17 0.03 255) !important; background-image: none !important; min-height: 100vh; }
  html.cn-active .container-fluid > .row { margin: 0 !important; }
  html.cn-active .col-lg-12 { padding: 0 !important; }

  .cn {
    --cn-bg: oklch(0.17 0.03 255);
    --cn-surface: oklch(0.21 0.034 255);
    --cn-surface-2: oklch(0.26 0.04 255);
    --cn-sunken: oklch(0.14 0.026 255);
    --cn-line: oklch(0.45 0.04 255 / 0.45);
    --cn-line-soft: oklch(1 0 0 / 0.08);
    --cn-ink: oklch(0.96 0.01 90);
    --cn-soft: oklch(0.85 0.02 250);
    --cn-muted: oklch(0.72 0.03 250);
    --cn-gold: oklch(0.85 0.12 85);
    --cn-gold-ink: oklch(0.24 0.04 255);
    --cn-red: oklch(0.63 0.19 27);
    --cn-red-deep: oklch(0.5 0.17 27);
    --cn-red-ink: oklch(0.86 0.08 27);
    --cn-blue: oklch(0.64 0.15 255);
    --cn-blue-deep: oklch(0.48 0.14 258);
    --cn-blue-ink: oklch(0.87 0.06 255);
    --cn-paper: oklch(0.95 0.025 85);
    --cn-paper-2: oklch(0.9 0.035 82);
    --cn-paper-ink: oklch(0.24 0.04 255);
    --cn-neutral: oklch(0.83 0.05 80);
    --cn-neutral-ink: oklch(0.3 0.04 70);
    --cn-assassin: oklch(0.2 0.012 260);
    --cn-good: oklch(0.8 0.14 155);
    --cn-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --cn-display: 'Chakra Petch', 'Bai Jamjuree', sans-serif;
    --turn: var(--cn-gold);
    --turn-deep: var(--cn-gold);

    max-width: 1080px;
    margin: 0 auto;
    padding: 0 12px calc(var(--cn-dock-h, 120px) + 20px);
    color: var(--cn-ink);
    font-family: 'Bai Jamjuree', sans-serif;
    font-size: 1rem;
    line-height: 1.45;
    text-align: left;
  }
  .cn[data-turn="red"] { --turn: var(--cn-red); --turn-deep: var(--cn-red-deep); }
  .cn[data-turn="blue"] { --turn: var(--cn-blue); --turn-deep: var(--cn-blue-deep); }
  body.content { background: var(--cn-bg, oklch(0.17 0.03 255)); }
  .cn *, .cn *::before, .cn *::after { box-sizing: border-box; }
  .cn button, .cn input { font-family: inherit; }
  .cn h1, .cn h2, .cn h3, .cn p { overflow-wrap: anywhere; }

  /* ---------- top ---------- */
  .cn-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; padding: 10px 104px 6px 0; }
  .cn-top-copy { min-width: 0; }
  .cn-kicker { font-family: var(--cn-display); font-size: 0.76rem; font-weight: 600; letter-spacing: 0.1em; color: var(--cn-gold); }
  .cn-room { margin: 0; font-family: var(--cn-display); font-size: 1.12rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cn-tools { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 10px; }
  .cn-pill {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; min-width: 44px; padding: 0 12px;
    border-radius: 999px; border: 1px solid var(--cn-line); background: var(--cn-surface); color: var(--cn-soft);
    font-size: 0.86rem; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .cn-pill:hover { background: var(--cn-surface-2); color: var(--cn-ink); }
  .cn-pill.is-danger { color: oklch(0.82 0.1 25); }
  .cn-pill:focus-visible, .cn-card:focus-visible, .cn-btn:focus-visible, .cn-num:focus-visible { outline: 2px solid var(--cn-gold); outline-offset: 2px; }

  /* ---------- score ---------- */
  .cn-score { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: 8px; }
  .cn-team-pill {
    position: relative; display: flex; align-items: center; gap: 10px; min-width: 0; padding: 8px 12px; border-radius: 16px;
    border: 1px solid var(--cn-line-soft); background: var(--cn-surface);
    transition: box-shadow 0.25s var(--cn-ease), background-color 0.25s var(--cn-ease);
  }
  .cn-team-pill.is-blue { flex-direction: row-reverse; text-align: right; }
  .cn-team-pill .num { font-family: var(--cn-display); font-weight: 700; font-size: 1.9rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .cn-team-pill.is-red .num { color: var(--cn-red-ink); }
  .cn-team-pill.is-blue .num { color: var(--cn-blue-ink); }
  .cn-team-pill .meta { min-width: 0; display: grid; }
  .cn-team-pill .name { font-family: var(--cn-display); font-weight: 700; font-size: 0.9rem; white-space: nowrap; }
  .cn-team-pill .sub { font-size: 0.72rem; color: var(--cn-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cn-team-pill.is-red.is-turn { background: oklch(0.36 0.11 27 / 0.75); box-shadow: 0 0 0 2px var(--cn-red); }
  .cn-team-pill.is-blue.is-turn { background: oklch(0.34 0.1 258 / 0.75); box-shadow: 0 0 0 2px var(--cn-blue); }
  .cn-team-pill.is-turn .sub { color: var(--cn-ink); }
  .cn-vs { align-self: center; font-family: var(--cn-display); font-size: 0.72rem; color: var(--cn-muted); letter-spacing: 0.1em; }

  /* ---------- now bar ---------- */
  .cn-now {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 12px; margin-top: 10px;
    padding: 10px 14px; border-radius: 16px; background: var(--cn-surface); border: 1px solid var(--cn-line);
  }
  .cn-now.is-mine { background: color-mix(in oklch, var(--turn) 20%, var(--cn-surface)); border-color: var(--turn); }
  .cn-now-who { font-size: 0.74rem; font-weight: 600; color: var(--cn-muted); letter-spacing: 0.02em; }
  .cn-now-who b { color: var(--cn-gold); font-weight: 700; }
  .cn-now-title { margin: 0; font-family: var(--cn-display); font-size: 1.12rem; font-weight: 700; line-height: 1.3; }
  .cn-now-sub { margin: 0; color: var(--cn-soft); font-size: 0.88rem; }
  .cn-timer { position: relative; width: 52px; height: 52px; grid-column: 2; grid-row: 1 / span 3; }
  .cn-timer svg { width: 52px; height: 52px; transform: rotate(-90deg); }
  .cn-timer circle { fill: none; stroke-width: 5; }
  .cn-timer .track { stroke: var(--cn-sunken); }
  .cn-timer .bar { stroke: var(--turn); stroke-linecap: round; transition: stroke-dashoffset 0.25s linear; }
  .cn-timer.is-low .bar { stroke: oklch(0.7 0.2 30); }
  .cn-timer-num { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--cn-display); font-weight: 700; font-size: 1rem; font-variant-numeric: tabular-nums; }
  .cn-timer.is-idle { opacity: 0.35; }

  /* ---------- clue banner ---------- */
  .cn-clue {
    display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; margin-top: 10px; padding: 8px 12px;
    border-radius: 14px; background: var(--cn-sunken); border: 1px dashed var(--cn-line); text-align: center;
  }
  .cn-clue[hidden] { display: none; }
  .cn-clue-label { font-size: 0.74rem; color: var(--cn-muted); }
  .cn-clue-word { font-family: var(--cn-display); font-weight: 700; font-size: 1.45rem; line-height: 1.15; color: var(--cn-ink); max-width: 100%; overflow-wrap: anywhere; }
  .cn-clue-num { display: inline-grid; place-items: center; min-width: 38px; height: 38px; padding: 0 8px; border-radius: 10px; background: var(--turn); color: oklch(0.99 0 0); font-family: var(--cn-display); font-weight: 700; font-size: 1.3rem; }
  .cn-clue-left { font-size: 0.8rem; color: var(--cn-soft); }
  .cn-clue.is-pop { animation: cnPop 0.5s var(--cn-ease) both; }

  /* ---------- legend (หัวหน้า) ---------- */
  .cn-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 10px; font-size: 0.78rem; color: var(--cn-soft); }
  .cn-legend[hidden] { display: none; }
  .cn-legend .k { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .cn-legend .sw { width: 14px; height: 14px; border-radius: 4px; border: 1px solid oklch(1 0 0 / 0.25); }
  .cn-legend .sw.red { background: var(--cn-red-deep); }
  .cn-legend .sw.blue { background: var(--cn-blue-deep); }
  .cn-legend .sw.neutral { background: var(--cn-neutral); }
  .cn-legend .sw.assassin { background: var(--cn-assassin); border-color: oklch(0.7 0.2 25); }
  .cn-legend .note { flex-basis: 100%; color: var(--cn-gold); font-weight: 600; }

  /* ---------- board ---------- */
  .cn-boardwrap {
    position: relative; margin-top: 10px; padding: 8px; border-radius: 18px;
    background: var(--cn-sunken); box-shadow: 0 0 0 2px color-mix(in oklch, var(--turn) 55%, transparent), 0 18px 40px oklch(0.05 0.02 255 / 0.5);
    transition: box-shadow 0.35s var(--cn-ease);
  }
  .cn-board { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 5px; }
  .cn-card {
    position: relative; display: block; width: 100%; aspect-ratio: 5 / 4; padding: 0; border: 0; background: none;
    perspective: 700px; cursor: default; color: inherit; -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; touch-action: manipulation;
  }
  .cn-card.can-tap { cursor: pointer; }
  .cn-card-inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.6s var(--cn-ease); }
  .cn-card.is-revealed .cn-card-inner { transform: rotateY(180deg); }
  .cn-card.is-new .cn-card-inner { animation: cnFlip 0.75s var(--cn-ease) both; }
  .cn-face {
    position: absolute; inset: 0; border-radius: 9px; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    display: grid; place-items: center; padding: 4px;
  }
  .cn-front {
    background: linear-gradient(180deg, var(--cn-paper), var(--cn-paper-2)); color: var(--cn-paper-ink);
    box-shadow: inset 0 0 0 1px oklch(0.6 0.08 80 / 0.55), 0 2px 0 oklch(0.6 0.06 80 / 0.6);
    transition: transform 0.15s var(--cn-ease), box-shadow 0.2s var(--cn-ease);
  }
  .cn-card.can-tap:active .cn-front { transform: scale(0.96); }
  .cn-word {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    max-width: 100%; max-height: 2.3em; text-align: center; font-family: var(--cn-display); font-weight: 700;
    font-size: var(--fs, 15px); line-height: 1.15; word-break: normal; overflow-wrap: anywhere;
  }
  /* กุญแจของหัวหน้า: ทั้งใบเป็นสีของการ์ด */
  .cn-card.key-red .cn-front { background: linear-gradient(180deg, oklch(0.56 0.18 27), var(--cn-red-deep)); color: oklch(0.98 0.01 27); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.25); }
  .cn-card.key-blue .cn-front { background: linear-gradient(180deg, oklch(0.54 0.15 256), var(--cn-blue-deep)); color: oklch(0.98 0.01 255); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.25); }
  .cn-card.key-neutral .cn-front { background: linear-gradient(180deg, oklch(0.88 0.045 82), var(--cn-neutral)); color: var(--cn-neutral-ink); }
  .cn-card.key-assassin .cn-front { background: linear-gradient(180deg, oklch(0.27 0.015 260), var(--cn-assassin)); color: oklch(0.8 0.14 25); box-shadow: inset 0 0 0 2px oklch(0.62 0.2 25); }
  .cn-keymark { position: absolute; top: 3px; right: 4px; font-size: 0.62rem; line-height: 1; opacity: 0.85; }
  /* โหวต */
  .cn-votes { position: absolute; left: 4px; bottom: 3px; display: flex; gap: 2px; }
  .cn-votes i { width: 7px; height: 7px; border-radius: 50%; background: var(--turn); box-shadow: 0 0 0 1.5px oklch(1 0 0 / 0.85); }
  .cn-card.is-mine .cn-front { box-shadow: 0 0 0 3px var(--cn-gold), 0 6px 16px oklch(0.05 0.02 255 / 0.5); transform: translateY(-2px); }
  .cn-card.is-voted:not(.is-mine) .cn-front { box-shadow: 0 0 0 2px color-mix(in oklch, var(--turn) 80%, white); }
  /* ด้านหลัง (เปิดแล้ว) */
  .cn-back { transform: rotateY(180deg); padding: 0; place-items: stretch; }
  .cn-back.c-red { background: var(--cn-red-deep); }
  .cn-back.c-blue { background: var(--cn-blue-deep); }
  .cn-back.c-neutral { background: var(--cn-neutral); }
  .cn-back.c-assassin { background: var(--cn-assassin); }
  .cn-back img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 32%; pointer-events: none; }
  .cn-back-word {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 1px 3px 2px; font-size: 0.6rem; font-weight: 700; line-height: 1.2; text-align: center;
    color: oklch(0.98 0 0); background: oklch(0.12 0.02 255 / 0.72); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .cn-back.c-neutral .cn-back-word { background: oklch(0.3 0.04 70 / 0.75); }
  .cn-card.is-revealed.is-dim .cn-card-inner { opacity: 0.55; }
  .cn.is-finished .cn-card:not(.is-revealed) .cn-front { opacity: 0.8; }

  /* ---------- result ---------- */
  .cn-result { margin-top: 10px; padding: 16px; border-radius: 18px; text-align: center; border: 1px solid var(--cn-line); background: var(--cn-surface); }
  .cn-result[hidden] { display: none; }
  .cn-result.is-red { background: color-mix(in oklch, var(--cn-red) 22%, var(--cn-surface)); border-color: var(--cn-red); }
  .cn-result.is-blue { background: color-mix(in oklch, var(--cn-blue) 22%, var(--cn-surface)); border-color: var(--cn-blue); }
  .cn-result h2 { margin: 0; font-family: var(--cn-display); font-size: 1.6rem; }
  .cn-result p { margin: 4px 0 0; color: var(--cn-soft); }
  .cn-result .me { margin-top: 10px; font-family: var(--cn-display); font-weight: 700; font-size: 1.1rem; color: var(--cn-gold); }
  .cn-result-stats { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-top: 10px; font-size: 0.82rem; }
  .cn-result-stats span { padding: 4px 10px; border-radius: 999px; background: oklch(0 0 0 / 0.25); }

  /* ---------- side panels ---------- */
  .cn-side { display: grid; gap: 10px; margin-top: 12px; align-content: start; }
  .cn-panel { padding: 12px; border-radius: 16px; background: var(--cn-surface); border: 1px solid var(--cn-line-soft); min-width: 0; }
  .cn-panel h2, .cn-panel summary { margin: 0 0 8px; font-family: var(--cn-display); font-size: 0.92rem; font-weight: 700; color: var(--cn-gold); }
  .cn-panel summary { cursor: pointer; min-height: 32px; display: flex; align-items: center; margin: 0; }
  .cn-log { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .cn-log-col { min-width: 0; display: grid; gap: 6px; align-content: start; }
  .cn-log-head { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.04em; }
  .cn-log-col.is-red .cn-log-head { color: var(--cn-red-ink); }
  .cn-log-col.is-blue .cn-log-head { color: var(--cn-blue-ink); }
  .cn-log-item { padding: 6px 8px; border-radius: 10px; background: var(--cn-sunken); min-width: 0; }
  .cn-log-item.is-live { box-shadow: inset 0 0 0 1px var(--turn); }
  .cn-log-clue { display: flex; align-items: baseline; gap: 6px; min-width: 0; font-weight: 700; }
  .cn-log-clue .w { min-width: 0; overflow-wrap: anywhere; }
  .cn-log-clue .n { flex: 0 0 auto; font-family: var(--cn-display); color: var(--cn-gold); }
  .cn-log-picks { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 4px; }
  .cn-chip { display: inline-block; max-width: 100%; padding: 1px 6px; border-radius: 6px; font-size: 0.7rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cn-chip.c-red { background: var(--cn-red-deep); color: #fff; }
  .cn-chip.c-blue { background: var(--cn-blue-deep); color: #fff; }
  .cn-chip.c-neutral { background: var(--cn-neutral); color: var(--cn-neutral-ink); }
  .cn-chip.c-assassin { background: var(--cn-assassin); color: oklch(0.8 0.14 25); box-shadow: inset 0 0 0 1px oklch(0.62 0.2 25); }
  .cn-log-end { margin-top: 3px; font-size: 0.68rem; color: var(--cn-muted); }
  .cn-empty { font-size: 0.8rem; color: var(--cn-muted); }
  .cn-teams { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .cn-roster { min-width: 0; display: grid; gap: 3px; align-content: start; }
  .cn-roster h3 { margin: 0 0 2px; font-size: 0.8rem; font-family: var(--cn-display); }
  .cn-roster.is-red h3 { color: var(--cn-red-ink); }
  .cn-roster.is-blue h3 { color: var(--cn-blue-ink); }
  .cn-member { display: flex; align-items: center; gap: 6px; min-width: 0; font-size: 0.84rem; }
  .cn-member .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cn-member .dot { flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: var(--cn-good); }
  .cn-member.is-off { opacity: 0.5; }
  .cn-member.is-off .dot { background: var(--cn-muted); }
  .cn-member.is-me .nm { color: var(--cn-gold); font-weight: 700; }
  .cn-member .tag { flex: 0 0 auto; font-size: 0.66rem; padding: 0 5px; border-radius: 5px; background: oklch(0.85 0.12 85 / 0.18); color: var(--cn-gold); }
  .cn-spect { margin-top: 8px; font-size: 0.78rem; color: var(--cn-muted); overflow-wrap: anywhere; }
  .cn-feed { display: grid; gap: 4px; margin-top: 8px; }
  .cn-feed div { font-size: 0.8rem; color: var(--cn-soft); padding: 4px 8px; border-radius: 8px; background: var(--cn-sunken); }

  /* ---------- dock ---------- */
  .cn-dock {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    padding: 10px max(12px, calc((100vw - 1056px) / 2)) calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--cn-bg); border-top: 1px solid var(--cn-line); box-shadow: 0 -12px 30px oklch(0 0 0 / 0.45);
    max-height: 70vh; overflow-y: auto;
  }
  .cn-dock-inner { max-width: 640px; margin: 0 auto; display: grid; gap: 8px; }
  .cn-wait { text-align: center; color: var(--cn-soft); font-weight: 600; font-size: 0.92rem; padding: 4px 0; }
  .cn-hint { margin: 0; text-align: center; font-size: 0.76rem; color: var(--cn-muted); }
  .cn-row { display: flex; gap: 8px; }
  .cn-row > * { flex: 1 1 0; min-width: 0; }
  .cn-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 48px; padding: 0 14px;
    border-radius: 12px; border: 1px solid var(--cn-line); background: var(--cn-surface-2); color: var(--cn-ink);
    font-weight: 700; font-size: 0.98rem; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: background-color 0.15s ease-out, transform 0.08s ease-out;
  }
  .cn-btn:active { transform: scale(0.97); }
  .cn-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
  .cn-btn--primary { background: var(--cn-gold); color: var(--cn-gold-ink); border-color: transparent; font-family: var(--cn-display); font-size: 1.05rem; }
  .cn-btn--primary:hover:not(:disabled) { background: oklch(0.89 0.11 85); }
  .cn-btn--ghost { background: transparent; color: var(--cn-soft); }
  .cn-clueform { display: grid; gap: 8px; }
  .cn-input {
    width: 100%; min-height: 50px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--cn-line); background: var(--cn-sunken);
    color: var(--cn-ink); font-family: var(--cn-display); font-size: 1.2rem; font-weight: 700;
  }
  .cn-input:focus { outline: 2px solid var(--turn); outline-offset: 1px; }
  .cn-input.is-bad { border-color: oklch(0.7 0.2 30); }
  .cn-err { min-height: 1.2em; margin: -2px 0 0; font-size: 0.8rem; color: oklch(0.8 0.13 50); }
  .cn-clue-row { display: flex; gap: 8px; align-items: stretch; }
  .cn-stepper { display: flex; gap: 4px; flex: 0 0 auto; }
  .cn-stepper .cn-num { width: 44px; }
  .cn-stepper output { display: grid; place-items: center; min-width: 44px; min-height: 48px; border-radius: 10px; background: var(--turn); color: #fff; font-family: var(--cn-display); font-weight: 700; font-size: 1.3rem; }
  .cn-clue-row .cn-btn--primary { flex: 1 1 auto; min-width: 0; }
  .cn-preview { margin: 0; min-height: 1.2em; font-size: 0.8rem; color: var(--cn-muted); }
  .cn-num {
    min-height: 44px; border-radius: 10px; border: 1px solid var(--cn-line); background: var(--cn-surface);
    color: var(--cn-ink); font-family: var(--cn-display); font-size: 1.1rem; font-weight: 700; cursor: pointer;
  }
  .cn-num[aria-pressed="true"] { background: var(--turn); border-color: transparent; color: #fff; }

  /* ---------- toast / banner ---------- */
  .cn-banner {
    position: fixed; left: 50%; top: 38%; z-index: 11001; pointer-events: none; max-width: calc(100vw - 32px);
    padding: 12px 22px; border-radius: 18px; background: oklch(0.15 0.03 255 / 0.95); border: 2px solid var(--cn-gold);
    font-family: var(--cn-display); font-weight: 700; font-size: 1.25rem; text-align: center; color: oklch(0.97 0.01 90);
    opacity: 0; transform: translate(-50%, -50%); overflow-wrap: anywhere;
  }
  .cn-banner.is-on { animation: cnBanner 1.6s var(--cn-ease) both; }
  .cn-banner.c-red { border-color: oklch(0.63 0.19 27); }
  .cn-banner.c-blue { border-color: oklch(0.64 0.15 255); }
  .cn-banner.c-assassin { border-color: oklch(0.62 0.2 25); color: oklch(0.8 0.14 25); }
  .cn-banner.c-neutral { border-color: oklch(0.83 0.05 80); }
  .cn-conn { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); z-index: 10001; display: none; padding: 8px 14px; border-radius: 999px; background: oklch(0.3 0.08 30); color: #fff; font-size: 0.86rem; font-family: 'Bai Jamjuree', sans-serif; }

  .chat-box {
    --chat-accent: oklch(0.64 0.15 255); --chat-accent-dark: oklch(0.45 0.13 258);
    --chat-surface: oklch(0.19 0.032 255); --chat-border: oklch(0.85 0.12 85 / 0.24); --chat-bubble: oklch(0.25 0.04 255);
    font-family: 'Bai Jamjuree', sans-serif;
  }
  .chat-toggle { --chat-toggle-bg: oklch(0.3 0.06 255); border-radius: 999px; padding: 10px 16px; min-height: 44px; top: calc(10px + env(safe-area-inset-top, 0px)) !important; bottom: auto !important; }
  .btn-chat-send { --chat-send-bg: oklch(0.85 0.12 85); --chat-send-color: oklch(0.24 0.04 255); }

  .cn-guide { text-align: left; font-family: 'Bai Jamjuree', sans-serif; line-height: 1.55; font-size: 0.94rem; }
  .cn-guide h4 { margin: 12px 0 4px; font-family: 'Chakra Petch', sans-serif; color: oklch(0.85 0.12 85); font-size: 0.98rem; }
  .cn-guide p { margin: 0 0 6px; }
  .cn-guide-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin-top: 8px; text-align: center; font-size: 0.72rem; }
  .cn-guide-cards img { width: 100%; height: auto; border-radius: 8px; }

  @keyframes cnFlip {
    0% { transform: rotateY(0deg) scale(1); }
    45% { transform: rotateY(95deg) scale(1.08); }
    100% { transform: rotateY(180deg) scale(1); }
  }
  @keyframes cnPop {
    0% { opacity: 0; transform: scale(0.92); }
    60% { opacity: 1; transform: scale(1.03); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes cnBanner {
    0% { opacity: 0; transform: translate(-50%, -40%) scale(0.92); }
    15% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    80% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -60%) scale(0.98); }
  }

  /* จอกว้าง: กระดานซ้าย แผงข้างขวา */
  @media (min-width: 900px) {
    .cn-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 16px; align-items: start; }
    .cn-side { margin-top: 10px; position: sticky; top: 10px; }
    .cn-board { gap: 8px; }
    .cn-boardwrap { padding: 12px; }
    .cn-card { aspect-ratio: 16 / 10; }
    .cn-back-word { font-size: 0.74rem; }
  }
  /* มือถือแนวนอน: กระดานให้พอดีความสูงจอ แผงข้างไปขวา */
  @media (orientation: landscape) and (max-height: 520px) {
    .cn { --board-w: min(56vw, calc((100vh - 70px) * 1.62)); max-width: none; }
    .cn-head { display: flex; align-items: center; gap: 10px; padding-right: 110px; min-width: 0; }
    .cn-top { padding: 6px 0; min-width: 0; }
    .cn-room { display: none; }
    .cn-tools { margin: 0; flex-wrap: nowrap; }
    .cn-layout { display: block; }
    .cn-main { display: grid; grid-template-columns: var(--board-w) minmax(0, 1fr); column-gap: 12px; align-items: start; }
    .cn-main > * { grid-column: 2; }
    .cn-main > .cn-boardwrap { grid-column: 1; grid-row: 1 / span 6; margin-top: 0; position: sticky; top: 4px; padding: 6px; }
    .cn-main > .cn-score { margin-top: 0; }
    .cn-team-pill { padding: 6px 10px; }
    .cn-team-pill .num { font-size: 1.5rem; }
    .cn-card { aspect-ratio: 16 / 9; }
    .cn-side { margin-left: calc(var(--board-w) + 12px); }
    .cn-dock { left: auto; right: 0; width: calc(100vw - var(--board-w) - 24px); padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px)); border-left: 1px solid var(--cn-line); border-radius: 16px 0 0 0; max-height: 64vh; }
  }
  @media (max-width: 360px) {
    .cn { padding-left: 8px; padding-right: 8px; }
    .cn-board { gap: 4px; }
    .cn-team-pill { padding: 6px 8px; gap: 6px; }
    .cn-team-pill .num { font-size: 1.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cn-card-inner, .cn-front, .cn-team-pill, .cn-boardwrap, .cn-btn, .cn-timer .bar { transition: none !important; }
    .cn-card.is-new .cn-card-inner, .cn-clue.is-pop { animation: none !important; }
    .cn-banner.is-on { animation-duration: 2.2s; animation-name: cnFade; }
  }
  @keyframes cnFade { 0%, 100% { opacity: 0; } 10%, 85% { opacity: 1; } }
</style>

<div id="cnConn" class="cn-conn" role="status">กำลังเชื่อมต่อใหม่...</div>
<div id="cnBanner" class="cn-banner" aria-hidden="true"></div>

<div class="cn" id="cnRoot" data-turn="">

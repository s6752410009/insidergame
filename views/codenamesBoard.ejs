<%- contentFor('script') %>
<script src="/js/chatPanel.js"></script>
<script>
$(function() {
  document.documentElement.classList.add('cn-active');

  const socket = io({ reconnection: true, reconnectionAttempts: Infinity, transports: ['websocket', 'polling'] });
  const roomId = '<%= room.roomId %>';
  const playerId = '<%= player.playerId %>';
  const playerName = <%- JSON.stringify(String(player.name || '')) %>;
  const isRoomAdmin = <%= room.admin === true ? 'true' : 'false' %>;
  if (window.partyPlay) window.partyPlay.startSession('codenames', socket);

  let S = <%- JSON.stringify(typeof codenamesState !== 'undefined' && codenamesState ? codenamesState : {}).replace(/</g, '\\u003c') %>;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const TEAM = { red: 'ทีมแดง', blue: 'ทีมน้ำเงิน' };
  const COLOR_NAME = { red: 'สายลับทีมแดง', blue: 'สายลับทีมน้ำเงิน', neutral: 'คนเดินถนน', assassin: 'มือสังหาร' };
  const ART = { red: '/assets/games/codenames/agent-red.svg', blue: '/assets/games/codenames/agent-blue.svg', neutral: '/assets/games/codenames/bystander.svg', assassin: '/assets/games/codenames/assassin.svg' };
  const END_TEXT = { limit: 'ครบจำนวนแล้ว', neutral: 'เจอคนเดินถนน', wrong: 'เปิดผิดทีม', ended: 'กดจบเทิร์น', 'clue-timeout': 'หมดเวลาใบ้', 'guess-timeout': 'หมดเวลาทาย', 'no-operatives': 'ไม่มีลูกทีมออนไลน์', 'no-spymaster': 'ไม่มีหัวหน้า' };
  const WIN_TEXT = { words: 'เจอสายลับครบทุกคน', gift: 'อีกทีมเปิดคำสุดท้ายให้', assassin: 'อีกทีมเปิดเจอมือสังหาร', forfeit: 'อีกทีมไม่เหลือผู้เล่น', abandoned: 'ไม่เหลือลูกทีมให้ทาย' };
  const segmenter = window.Intl && Intl.Segmenter ? new Intl.Segmenter('th', { granularity: 'grapheme' }) : null;

  let allowNavigation = false;
  let firstRender = true;
  let seenFx = 0;
  let pending = false;
  let clockOffset = 0;
  let revealedBefore = new Set();
  let clueNumber = 1;
  let dockKey = '';

  // ---------- helpers ----------
  function esc(text) {
    return String(text == null ? '' : text).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c]);
  }
  function graphemes(text) {
    const value = String(text || '');
    return segmenter ? Array.from(segmenter.segment(value), s => s.segment) : Array.from(value);
  }
  function normalizeWord(text) {
    return String(text == null ? '' : text).normalize('NFC').replace(/[​-‍⁠﻿]/g, '').replace(/\s+/g, '')
      .replace(/ํ([่-๋]?)า/g, '$1ำ').toLowerCase();
  }
  function containsWord(hay, needle) {
    const h = graphemes(normalizeWord(hay));
    const n = graphemes(normalizeWord(needle));
    if (!n.length || n.length > h.length) return false;
    outer: for (let i = 0; i <= h.length - n.length; i += 1) {
      for (let j = 0; j < n.length; j += 1) if (h[i + j] !== n[j]) continue outer;
      return true;
    }
    return false;
  }
  // เหมือนฝั่งเซิร์ฟเวอร์ — เซิร์ฟเวอร์ตรวจซ้ำอีกครั้งเสมอ
  function clueError(raw) {
    const text = String(raw || '').normalize('NFC').replace(/[​-‍⁠﻿]/g, '').trim();
    if (!text) return 'พิมพ์คำใบ้ก่อน';
    if (/\s/.test(text)) return 'ใบ้ได้คำเดียว ห้ามเว้นวรรค';
    const word = normalizeWord(text);
    if (!/^[\p{L}\p{M}\p{N}]+$/u.test(word)) return 'คำใบ้ใช้ได้แค่ตัวอักษรหรือตัวเลข ห้ามมีสัญลักษณ์';
    if (graphemes(word).length > 24) return 'คำใบ้ยาวเกินไป';
    const hit = (S.board || []).find(c => !c.revealed && containsWord(word, c.word));
    if (hit) return normalizeWord(hit.word) === word ? '"' + hit.word + '" อยู่บนกระดาน ใช้เป็นคำใบ้ไม่ได้' : 'คำใบ้มีคำว่า "' + hit.word + '" ที่อยู่บนกระดาน ลองคำอื่น';
    return null;
  }
  function numText(n) { return n === 'inf' ? '∞' : String(n); }
  function me() { return S.self || {}; }
  function teamOf(id) {
    for (const team of ['red', 'blue']) {
      const m = (S.teams && S.teams[team] && S.teams[team].members || []).find(p => p.playerId === id);
      if (m) return m;
    }
    return null;
  }
  function now() { return Date.now() + clockOffset; }
  function haptic(pattern) { if (window.gameHaptic) window.gameHaptic(pattern); else if (navigator.vibrate) { try { navigator.vibrate(pattern); } catch (e) {} } }

  function banner(text, cls) {
    const el = document.getElementById('cnBanner');
    el.className = 'cn-banner' + (cls ? ' ' + cls : '');
    el.textContent = text;
    void el.offsetWidth;
    el.classList.add('is-on');
  }
  function toast(msg, icon) {
    Swal.fire({ toast: true, position: 'top', icon: icon || 'info', title: msg, showConfirmButton: false, timer: 2600, background: '#1a2332', color: '#fff' });
  }

  // ---------- render ----------
  function renderScore() {
    const html = ['red', 'blue'].map(team => {
      const t = (S.teams || {})[team] || { remaining: 0, total: 0 };
      const turn = S.status === 'playing' && S.currentTeam === team;
      const sm = t.spymaster;
      const sub = turn ? (S.phase === 'clue' ? 'กำลังคิดคำใบ้' : 'กำลังทาย') : (sm ? 'หัวหน้า ' + sm.name : 'ยังไม่มีหัวหน้า');
      return '<div class="cn-team-pill is-' + team + (turn ? ' is-turn' : '') + '">' +
        '<span class="num" aria-label="เหลือ ' + t.remaining + ' คำ">' + t.remaining + '</span>' +
        '<span class="meta"><span class="name">' + TEAM[team] + '</span><span class="sub">' + esc(sub) + '</span></span></div>';
    });
    $('#cnScore').html(html[0] + '<span class="cn-vs">เหลือ</span>' + html[1]);
  }

  function describeNow() {
    const self = me();
    const team = S.currentTeam;
    const tName = TEAM[team] || '';
    const sm = S.teams && S.teams[team] && S.teams[team].spymaster;
    if (S.phase === 'finished') {
      return { title: 'จบเกม — เปิดกุญแจทั้งกระดานแล้ว', sub: 'ดูว่าการ์ดไหนเป็นของใคร แล้วกลับห้องรอเล่นอีกตา', mine: false };
    }
    if (S.phase === 'clue') {
      if (self.canGiveClue) return { title: 'ตาคุณใบ้คำ', sub: 'พิมพ์คำเดียว + เลือกจำนวน ให้ลูกทีมเปิดการ์ดสี' + (team === 'red' ? 'แดง' : 'น้ำเงิน'), mine: true };
      if (self.team === team) return { title: 'รอหัวหน้าใบ้คำ', sub: (sm ? sm.name + ' ' : '') + 'กำลังคิด — คุยกันได้ แต่หัวหน้าห้ามบอกใบ้ทางอื่น', mine: false };
      return { title: tName + 'กำลังคิดคำใบ้', sub: self.role === 'spymaster' ? 'ดูกุญแจไว้ วางแผนเทิร์นถัดไป' : 'รอสักครู่ เดี๋ยวถึงตาทีมคุณ', mine: false };
    }
    const clue = S.clue || {};
    const left = clue.maxGuesses ? Math.max(0, clue.maxGuesses - (clue.guessesMade || 0)) : null;
    if (self.canGuess) {
      return { title: 'ตาคุณทาย', sub: left === null ? 'เปิดได้ไม่จำกัด จนกว่าจะพลาดหรือกดจบเทิร์น' : 'เปิดได้อีก ' + left + ' ใบ · แตะการ์ดเพื่อเสนอ', mine: true };
    }
    if (self.team === team && self.role === 'spymaster') return { title: 'ลูกทีมกำลังทาย', sub: 'ห้ามพูดใบ้เพิ่ม ห้ามทำท่า — นั่งลุ้นอย่างเดียว', mine: false };
    return { title: tName + 'กำลังทาย', sub: 'คำใบ้ "' + (clue.word || '') + '" ' + numText(clue.number), mine: false };
  }

  function renderNow() {
    const self = me();
    const d = describeNow();
    let who = 'คุณดูอย่างเดียว';
    if (self.team) {
      const roleName = self.role === 'spymaster' ? 'หัวหน้า' : (self.role === 'retired' ? 'อดีตหัวหน้า (ดูกุญแจได้)' : 'ลูกทีม');
      who = 'คุณ: <b>' + roleName + ' · ' + TEAM[self.team] + '</b>';
    }
    $('#cnNowWho').html(who);
    $('#cnNowTitle').text(d.title);
    $('#cnNowSub').text(d.sub);
    $('#cnNow').toggleClass('is-mine', !!d.mine);
    $('#cnTurnNo').text(S.phase === 'finished' ? 'จบเกม' : 'เทิร์น ' + (S.turnNumber || 1));
    if (d.mine && window.partyPlay) {
      window.partyPlay.pingTurn({
        key: S.phase + ':' + S.turnNumber,
        title: S.phase === 'clue' ? 'ถึงตาคุณใบ้คำ' : 'ถึงตาทีมคุณทาย',
        subtitle: S.phase === 'clue' ? 'คำเดียว + ตัวเลข' : 'คำใบ้ "' + ((S.clue || {}).word || '') + '"'
      });
    }
  }

  function renderClue() {
    const el = document.getElementById('cnClue');
    if (S.phase !== 'guess' || !S.clue) { el.hidden = true; el.dataset.key = ''; return; }
    const c = S.clue;
    const left = c.maxGuesses ? Math.max(0, c.maxGuesses - (c.guessesMade || 0)) : null;
    const key = S.turnNumber + ':' + c.word;
    el.hidden = false;
    el.innerHTML = '<span class="cn-clue-label">คำใบ้' + TEAM[c.team] + '</span>' +
      '<span class="cn-clue-word">' + esc(c.word) + '</span><span class="cn-clue-num">' + numText(c.number) + '</span>' +
      '<span class="cn-clue-left">' + (left === null ? 'เปิดไม่จำกัด' : 'เปิดได้อีก ' + left + ' ใบ') + (S.votesNeeded ? ' · ' + S.votesNeeded + ' เสียงเปิด' : '') + '</span>';
    if (el.dataset.key !== key && !firstRender && !reduceMotion) {
      el.classList.remove('is-pop'); void el.offsetWidth; el.classList.add('is-pop');
    }
    el.dataset.key = key;
  }

  function renderLegend() {
    const el = document.getElementById('cnLegend');
    if (!S.keyVisible || S.phase === 'finished') { el.hidden = true; return; }
    const count = color => (S.board || []).filter(c => c.color === color && !c.revealed).length;
    el.hidden = false;
    el.innerHTML = '<span class="note">🔑 กุญแจหัวหน้า — เห็นเฉพาะหัวหน้า ห้ามให้ลูกทีมเห็นจอ</span>' +
      '<span class="k"><span class="sw red"></span>แดง ' + count('red') + '</span>' +
      '<span class="k"><span class="sw blue"></span>น้ำเงิน ' + count('blue') + '</span>' +
      '<span class="k"><span class="sw neutral"></span>คนเดินถนน ' + count('neutral') + '</span>' +
      '<span class="k"><span class="sw assassin"></span>มือสังหาร</span>';
  }

  function baseFont(word) {
    const n = graphemes(word).length;
    const wide = window.innerWidth >= 900;
    if (n <= 3) return wide ? 21 : 16;
    if (n <= 5) return wide ? 19 : 14.5;
    if (n <= 7) return wide ? 17 : 13;
    return wide ? 15 : 12;
  }

  function renderBoard() {
    const self = me();
    const canGuess = !!self.canGuess;
    const newOnes = [];
    const html = (S.board || []).map(card => {
      const cls = ['cn-card'];
      const isNew = card.revealed && !revealedBefore.has(card.index) && !firstRender && !reduceMotion;
      if (card.revealed) {
        cls.push('is-revealed');
        if (isNew) { cls.push('is-new'); newOnes.push(card.index); }
        if (S.keyVisible && S.phase !== 'finished') cls.push('is-dim');
      } else {
        if (card.color) cls.push('key-' + card.color);
        if (canGuess) cls.push('can-tap');
        if (card.mine) cls.push('is-mine');
        if (card.votes && card.votes.length) cls.push('is-voted');
      }
      const votes = !card.revealed && card.votes && card.votes.length
        ? '<span class="cn-votes" aria-hidden="true">' + card.votes.map(() => '<i></i>').join('') + '</span>' : '';
      const keyMark = !card.revealed && card.color === 'assassin' ? '<span class="cn-keymark" aria-hidden="true">💀</span>' : '';
      const label = card.word + (card.revealed ? ' — ' + COLOR_NAME[card.color] : (card.color ? ' (กุญแจ: ' + COLOR_NAME[card.color] + ')' : '')) +
        (card.votes && card.votes.length ? ' · เสนอโดย ' + card.votes.join(', ') : '');
      return '<button type="button" class="' + cls.join(' ') + '" data-i="' + card.index + '" aria-label="' + esc(label) + '"' +
        (!canGuess || card.revealed ? ' aria-disabled="true"' : '') + (card.mine ? ' aria-pressed="true"' : '') + '>' +
        '<span class="cn-card-inner">' +
          '<span class="cn-face cn-front">' + keyMark + '<span class="cn-word" style="--fs:' + baseFont(card.word) + 'px">' + esc(card.word) + '</span>' + votes + '</span>' +
          (card.revealed ? '<span class="cn-face cn-back c-' + card.color + '"><img src="' + ART[card.color] + '" alt="" draggable="false"><span class="cn-back-word">' + esc(card.word) + '</span></span>' : '') +
        '</span></button>';
    }).join('');
    $('#cnBoard').html(html);
    revealedBefore = new Set((S.board || []).filter(c => c.revealed).map(c => c.index));
    fitWords();
    return newOnes;
  }

  // ย่อฟอนต์คำยาวให้พอดีการ์ด (ไม่เกิน 2 บรรทัด)
  function fitWords() {
    document.querySelectorAll('#cnBoard .cn-word').forEach(el => {
      let size = parseFloat(el.style.getPropertyValue('--fs')) || 14;
      const box = el.parentElement;
      let guard = 0;
      while (guard < 16 && size > 9 && (el.scrollHeight > el.clientHeight + 1 || el.scrollWidth > box.clientWidth - 6)) {
        size -= 0.5;
        el.style.setProperty('--fs', size + 'px');
        guard += 1;
      }
    });
  }

  function renderResult() {
    const el = document.getElementById('cnResult');
    $('#cnRoot').toggleClass('is-finished', S.phase === 'finished');
    if (S.phase !== 'finished') { el.hidden = true; return; }
    const self = me();
    const won = self.team && S.winner && self.team === S.winner;
    const mine = !self.team ? 'คุณดูอยู่ข้างสนาม' : (won ? '🎉 ทีมคุณชนะ!' : 'ทีมคุณแพ้ — แก้มือรอบหน้า');
    const t = S.teams || {};
    el.hidden = false;
    el.className = 'cn-result' + (S.winner ? ' is-' + S.winner : '');
    el.innerHTML = '<h2>' + (S.winner ? '🏆 ' + TEAM[S.winner] + 'ชนะ!' : 'จบเกม') + '</h2>' +
      '<p>' + esc(WIN_TEXT[S.winReason] || '') + '</p>' +
      '<div class="me">' + mine + '</div>' +
      '<div class="cn-result-stats"><span>🟥 เหลือ ' + ((t.red || {}).remaining || 0) + ' คำ</span><span>🟦 เหลือ ' + ((t.blue || {}).remaining || 0) + ' คำ</span><span>' + (S.turnNumber || 0) + ' เทิร์น</span></div>';
  }

  function renderLog() {
    const cols = ['red', 'blue'].map(team => {
      const items = (S.clueLog || []).filter(e => e.team === team).slice().reverse();
      const body = items.length ? items.map(e => {
        const live = S.phase === 'guess' && e.turn === S.turnNumber;
        return '<div class="cn-log-item' + (live ? ' is-live' : '') + '"><div class="cn-log-clue"><span class="w">' + esc(e.word) + '</span><span class="n">' + numText(e.number) + '</span></div>' +
          (e.picks && e.picks.length ? '<div class="cn-log-picks">' + e.picks.map(p => '<span class="cn-chip c-' + p.color + '" title="' + esc(COLOR_NAME[p.color]) + '">' + esc(p.word) + '</span>').join('') + '</div>' : '') +
          (e.endedBy && END_TEXT[e.endedBy] ? '<div class="cn-log-end">' + END_TEXT[e.endedBy] + '</div>' : '') + '</div>';
      }).join('') : '<div class="cn-empty">ยังไม่มีคำใบ้</div>';
      return '<div class="cn-log-col is-' + team + '"><div class="cn-log-head">' + TEAM[team] + '</div>' + body + '</div>';
    });
    $('#cnLog').html(cols.join(''));
  }

  function renderTeams() {
    const t = S.teams || {};
    $('#cnTeams').html(['red', 'blue'].map(team => {
      const members = ((t[team] || {}).members || []).filter(m => !m.left);
      members.sort((a, b) => (a.role === 'spymaster' ? -1 : 0) - (b.role === 'spymaster' ? -1 : 0));
      return '<div class="cn-roster is-' + team + '"><h3>' + TEAM[team] + '</h3>' + members.map(m =>
        '<div class="cn-member' + (m.online ? '' : ' is-off') + (m.playerId === playerId ? ' is-me' : '') + '"><span class="dot" aria-hidden="true"></span>' +
        '<span class="nm">' + esc(m.name) + '</span>' + (m.role === 'spymaster' ? '<span class="tag">หัวหน้า</span>' : '') + (m.online ? '' : '<span class="tag">หลุด</span>') + '</div>').join('') + '</div>';
    }).join(''));
    const spect = (S.spectators || []).filter(m => !m.left);
    $('#cnSpect').text(spect.length ? '👀 ผู้ชม: ' + spect.map(m => m.name).join(', ') : '');
  }

  function renderFeed() {
    $('#cnFeed').html((S.history || []).slice().reverse().slice(0, 20).map(h => '<div>' + esc((h.icon || '') + ' ' + (h.text || '')) + '</div>').join(''));
  }

  function renderDock() {
    const self = me();
    const inner = document.getElementById('cnDockInner');
    let key;
    if (S.phase === 'finished') key = 'fin';
    else if (self.canGiveClue) key = 'clue:' + S.turnNumber;
    else if (self.canGuess) key = 'guess:' + S.step;
    else key = 'wait:' + S.phase + ':' + S.currentTeam + ':' + self.role;

    if (key.startsWith('clue:')) {
      if (dockKey === key) { validateClueInput(); return; }
      dockKey = key;
      if (clueNumber !== 'inf' && !(clueNumber >= 0 && clueNumber <= 9)) clueNumber = 1;
      inner.innerHTML = '<form class="cn-clueform" id="cnClueForm" autocomplete="off">' +
        '<input id="cnClueWord" class="cn-input" type="text" inputmode="text" maxlength="30" placeholder="คำใบ้ 1 คำ เช่น ทะเล" aria-label="คำใบ้" enterkeyhint="send">' +
        '<div class="cn-clue-row">' +
          '<div class="cn-stepper" role="group" aria-label="ใบ้กี่ใบ">' +
            '<button type="button" class="cn-num" data-step="-1" aria-label="ลดจำนวน">−</button>' +
            '<output id="cnNumOut" aria-live="polite">' + numText(clueNumber) + '</output>' +
            '<button type="button" class="cn-num" data-step="1" aria-label="เพิ่มจำนวน">+</button>' +
            '<button type="button" class="cn-num" data-step="inf" aria-label="ไม่จำกัด" aria-pressed="' + (clueNumber === 'inf') + '">∞</button>' +
          '</div>' +
          '<button type="submit" id="cnClueSend" class="cn-btn cn-btn--primary">ส่งคำใบ้</button>' +
        '</div>' +
        '<p id="cnClueErr" class="cn-preview" aria-live="polite"></p>' +
        '</form>';
      validateClueInput();
      return;
    }
    dockKey = key;
    if (key === 'fin') {
      const endsAt = Number(S.returnLobbyEndsAt) || 0;
      inner.innerHTML = '<div class="cn-row"><button type="button" id="cnShareBtn" class="cn-btn">แชร์ผล</button>' +
        '<button type="button" id="cnBackBtn" class="cn-btn cn-btn--primary">กลับห้องรอ เล่นอีกตา</button></div>' +
        '<p class="cn-hint" id="cnBackRemain">' + (endsAt ? '' : 'ทุกคนกลับห้องรอพร้อมกัน · ทีมเดิมยังอยู่ สุ่มใหม่ได้') + '</p>';
      return;
    }
    if (self.canGuess) {
      const mineCard = (S.board || []).find(c => c.mine && !c.revealed);
      const made = (S.clue && S.clue.guessesMade) || 0;
      const need = S.votesNeeded;
      let status;
      if (mineCard) {
        status = 'คุณเสนอ "' + esc(mineCard.word) + '"' + (need ? ' · ' + mineCard.votes.length + '/' + need + ' เสียง' : '');
      } else {
        status = need ? 'แตะการ์ดเพื่อเสนอ — ได้ ' + need + ' เสียงเปิดเอง' : 'แตะการ์ดที่คิดว่าใช่ แล้วกด "เปิดเลย"';
      }
      inner.innerHTML = '<div class="cn-wait">' + status + '</div>' +
        '<div class="cn-row">' +
        '<button type="button" id="cnEndTurnBtn" class="cn-btn"' + (made > 0 ? '' : ' disabled') + '>จบเทิร์น</button>' +
        '<button type="button" id="cnRevealBtn" class="cn-btn cn-btn--primary"' + (mineCard ? ' data-i="' + mineCard.index + '"' : ' disabled') + '>' + (mineCard ? 'เปิด "' + esc(mineCard.word) + '" เลย' : 'เปิดเลย') + '</button>' +
        '</div><p class="cn-hint">กดค้างที่การ์ด = เปิดทันที' + (made > 0 ? '' : ' · ต้องเปิดอย่างน้อย 1 ใบก่อนจบเทิร์น') + '</p>';
      return;
    }
    const d = describeNow();
    inner.innerHTML = '<div class="cn-wait">' + esc(d.title) + '</div>' + (self.role === 'spymaster' && S.phase !== 'finished' ? '<p class="cn-hint">คุณเห็นกุญแจ — อย่าหันจอให้ใครเห็น</p>' : '');
  }

  function validateClueInput() {
    const input = document.getElementById('cnClueWord');
    if (!input) return;
    const value = input.value;
    const error = value.trim() ? clueError(value) : null;
    const ok = !!value.trim() && !error;
    $('#cnClueErr').toggleClass('cn-err', !!error)
      .text(error || (ok ? 'จะใบ้: "' + value.trim() + '" ' + numText(clueNumber) + (clueNumber === 'inf' || clueNumber === 0 ? ' · เปิดได้ไม่จำกัด' : ' · ลูกทีมเปิดได้ถึง ' + (clueNumber + 1) + ' ใบ') : 'เลือกจำนวนการ์ดที่คำนี้ใบ้ถึง ด้วย − / +'));
    input.classList.toggle('is-bad', !!error);
    $('#cnNumOut').text(numText(clueNumber));
    $('.cn-stepper [data-step="inf"]').attr('aria-pressed', clueNumber === 'inf' ? 'true' : 'false');
    $('#cnClueSend').prop('disabled', !ok || pending);
  }

  function syncDockHeight() {
    const dock = document.getElementById('cnDock');
    const fixed = dock && getComputedStyle(dock).position === 'fixed';
    document.documentElement.style.setProperty('--cn-dock-h', (fixed ? Math.round(dock.getBoundingClientRect().height) : 0) + 'px');
  }
  if (window.ResizeObserver) new ResizeObserver(syncDockHeight).observe(document.getElementById('cnDock'));

  // ---------- timer ----------
  let timerHandle = null;
  function tickTimer() {
    if (timerHandle) clearInterval(timerHandle);
    const circ = 138.2;
    function paint() {
      const wrap = document.getElementById('cnTimer');
      if (S.phase === 'finished') {
        const endsAt = Number(S.returnLobbyEndsAt) || 0;
        const remain = endsAt ? Math.max(0, Math.ceil((endsAt - Date.now()) / 1000)) : 0;
        $('#cnTimerNum').text(remain > 0 ? remain : '--');
        wrap.classList.toggle('is-idle', !remain);
        $('#cnTimerBar').attr('stroke-dashoffset', circ);
        $('#cnBackRemain').text(remain > 0 ? 'กลับห้องรอพร้อมกันใน ' + remain + ' วิ · ทีมเดิมยังอยู่' : 'ทุกคนกลับห้องรอพร้อมกัน');
        return;
      }
      const total = ((S.phase === 'clue' ? (S.settings || {}).clueSeconds : (S.settings || {}).guessSeconds) || 0) * 1000;
      if (!S.phaseEndsAt || !total) {
        $('#cnTimerNum').text('∞');
        wrap.classList.add('is-idle');
        wrap.classList.remove('is-low');
        $('#cnTimerBar').attr('stroke-dashoffset', 0);
        return;
      }
      wrap.classList.remove('is-idle');
      const ms = Math.max(0, S.phaseEndsAt - now());
      const remain = Math.ceil(ms / 1000);
      $('#cnTimerNum').text(remain);
      wrap.classList.toggle('is-low', remain <= 10);
      $('#cnTimerBar').attr('stroke-dashoffset', (circ * (1 - Math.max(0, Math.min(1, ms / total)))).toFixed(1));
    }
    paint();
    timerHandle = setInterval(paint, 250);
  }

  // ---------- fx ----------
  function consumeFx() {
    const list = S.fx || [];
    if (firstRender) { seenFx = list.reduce((m, f) => Math.max(m, f.id || 0), 0); return; }
    list.filter(f => (f.id || 0) > seenFx).forEach(f => {
      seenFx = Math.max(seenFx, f.id || 0);
      if (f.type === 'reveal') {
        const myTeam = me().team;
        if (f.color === 'assassin') { banner('💀 มือสังหาร!', 'c-assassin'); haptic([40, 60, 120]); }
        else if (f.color === f.team) { banner('✅ ' + COLOR_NAME[f.color], 'c-' + f.color); haptic(20); }
        else if (f.color === 'neutral') { banner('🚶 คนเดินถนน — จบเทิร์น', 'c-neutral'); haptic([20, 40, 20]); }
        else { banner('❌ ' + COLOR_NAME[f.color] + '!', 'c-' + f.color); haptic([20, 40, 20]); }
        if (myTeam && f.team !== myTeam && f.color === myTeam) haptic(15);
      } else if (f.type === 'clue') {
        banner('💬 "' + f.word + '" ' + numText(f.number), 'c-' + f.team);
      } else if (f.type === 'turn' && S.phase !== 'finished') {
        setTimeout(() => banner('ตา' + TEAM[f.team], 'c-' + f.team), 900);
      } else if (f.type === 'promote') {
        toast((f.playerId === playerId ? 'คุณ' : f.name) + ' เป็นหัวหน้า' + TEAM[f.team] + 'แทน' + (f.playerId === playerId ? ' — ตอนนี้คุณเห็นกุญแจ' : ''), 'info');
      } else if (f.type === 'finish') {
        const won = me().team && f.team === me().team;
        banner(f.team ? '🏆 ' + TEAM[f.team] + 'ชนะ!' : 'จบเกม', f.team ? 'c-' + f.team : '');
        haptic(won ? [30, 50, 30, 50, 80] : 40);
      }
    });
  }

  function render(state) {
    if (!state || !state.mode) return;
    S = state;
    if (S.serverNow) clockOffset = S.serverNow - Date.now();
    $('#cnRoot').attr('data-turn', S.phase === 'finished' ? (S.winner || '') : (S.currentTeam || ''));
    renderScore();
    renderNow();
    renderClue();
    renderLegend();
    renderBoard();
    renderResult();
    renderLog();
    renderTeams();
    renderFeed();
    renderDock();
    consumeFx();
    tickTimer();
    syncDockHeight();
    firstRender = false;
  }

  // ---------- commands ----------
  function send(eventName, payload, onOk) {
    if (pending) return;
    pending = true;
    socket.emit(eventName, Object.assign({ roomId: roomId, step: S.step }, payload || {}), function(res) {
      pending = false;
      if (res && res.success === false) {
        toast(res.error || 'ทำรายการไม่สำเร็จ', 'error');
        socket.emit('codenames_requestState', { roomId: roomId, playerId: playerId });
      } else if (onOk) onOk();
      validateClueInput();
    });
    setTimeout(function() { pending = false; }, 6000);
  }

  let pressTimer = null;
  let pressFired = false;
  function cardFromEvent(e) {
    const el = e.target.closest('.cn-card');
    if (!el || !me().canGuess || el.classList.contains('is-revealed')) return null;
    return el;
  }
  $('#cnBoard').on('pointerdown', '.cn-card', function(e) {
    const el = cardFromEvent(e);
    pressFired = false;
    if (!el) return;
    clearTimeout(pressTimer);
    pressTimer = setTimeout(function() {
      pressFired = true;
      haptic([15, 30, 40]);
      send('codenames_reveal', { index: Number(el.dataset.i) });
    }, 600);
  });
  $('#cnBoard').on('pointerup pointerleave pointercancel', '.cn-card', function() { clearTimeout(pressTimer); });
  $('#cnBoard').on('contextmenu', '.cn-card', function(e) { e.preventDefault(); });
  $('#cnBoard').on('click', '.cn-card', function(e) {
    const el = cardFromEvent(e);
    if (!el) return;
    if (pressFired) { pressFired = false; return; }
    haptic(8);
    send('codenames_propose', { index: Number(el.dataset.i) });
  });

  $(document).on('click', '#cnRevealBtn', function() {
    const i = Number(this.dataset.i);
    if (!Number.isInteger(i)) return;
    haptic([15, 30, 40]);
    send('codenames_reveal', { index: i });
  });
  $(document).on('click', '#cnEndTurnBtn', function() {
    Swal.fire({ title: 'จบเทิร์นเลยไหม?', text: 'ส่งตาให้อีกทีม', showCancelButton: true, confirmButtonText: 'จบเทิร์น', cancelButtonText: 'ทายต่อ', background: '#1a2332', color: '#fff', confirmButtonColor: '#d9443c' })
      .then(r => { if (r.isConfirmed) send('codenames_endTurn'); });
  });
  $(document).on('input', '#cnClueWord', validateClueInput);
  $(document).on('click', '.cn-stepper .cn-num', function() {
    const step = this.dataset.step;
    if (step === 'inf') clueNumber = clueNumber === 'inf' ? 1 : 'inf';
    else {
      const base = clueNumber === 'inf' ? 1 : clueNumber;
      clueNumber = Math.max(0, Math.min(9, base + Number(step)));
    }
    haptic(6);
    validateClueInput();
  });
  $(document).on('submit', '#cnClueForm', function(e) {
    e.preventDefault();
    const input = document.getElementById('cnClueWord');
    const word = (input.value || '').trim();
    const error = clueError(word);
    if (error) { $('#cnClueErr').text(error); input.classList.add('is-bad'); return; }
    haptic(12);
    send('codenames_clue', { word: word, number: clueNumber }, function() { input.value = ''; });
  });
  $(document).on('click', '#cnBackBtn', function() {
    allowNavigation = true;
    socket.emit('returnFinishedToLobby', { roomId: roomId }, function(res) {
      // ไม่ใช่หัวห้อง = server ไม่พาทั้งวงกลับ → กลับห้องเฉพาะตัวเอง
      if (res && res.canReturnSelf) { goLobby(); return; }
      if (res && res.success === false) { allowNavigation = false; toast(res.error || 'กลับห้องรอไม่สำเร็จ', 'error'); }
    });
  });
  $(document).on('click', '#cnShareBtn', function() {
    if (!window.partyPlay) return;
    const t = S.teams || {};
    window.partyPlay.shareResult({
      mode: 'สายลับคำใบ้',
      headline: S.winner ? TEAM[S.winner] + 'ชนะ!' : 'จบเกมสายลับคำใบ้',
      sub: (WIN_TEXT[S.winReason] || '') + ' · ' + (S.turnNumber || 0) + ' เทิร์น',
      lines: ['red', 'blue'].map(team => TEAM[team] + ': ' + ((t[team] || {}).members || []).filter(m => !m.left).map(m => m.name + (m.role === 'spymaster' ? ' (หัวหน้า)' : '')).join(', ')),
      accent: S.winner === 'blue' ? '#5b9cf0' : '#ec5f55',
      fileName: 'codenames-result'
    });
  });

  // ---------- guide / leave / end ----------
  function howToHtml() {
    return '<div class="cn-guide">' +
      '<h4>เป้าหมาย</h4><p>เปิดการ์ด<strong>สายลับของทีมตัวเอง</strong>ให้ครบก่อนอีกทีม · ทีมที่เริ่มก่อนมี 9 คำ อีกทีม 8 คำ</p>' +
      '<h4>หัวหน้า</h4><p>เห็นกุญแจว่าคำไหนสีอะไร ใบ้ <strong>คำเดียว + ตัวเลข</strong> เช่น "ทะเล 2" · ห้ามใช้คำบนกระดาน ห้ามใบ้ด้วยท่าทาง · 0 หรือ ∞ = เปิดได้ไม่จำกัด</p>' +
      '<h4>ลูกทีม</h4><p>แตะการ์ดเพื่อเสนอ ถ้าเกินครึ่งของลูกทีมที่ออนไลน์เลือกใบเดียวกันจะเปิดทันที หรือกด <strong>เปิดเลย</strong> (กดค้างที่การ์ดก็ได้) · เปิดได้ถึงตัวเลข + 1 ใบ</p>' +
      '<h4>พลาด</h4><p>เปิดเจอคนเดินถนนหรือสายลับอีกทีม = จบเทิร์น · เจอ<strong>มือสังหาร</strong> = แพ้ทันที</p>' +
      '<div class="cn-guide-cards"><div><img src="' + ART.red + '" alt="">แดง</div><div><img src="' + ART.blue + '" alt="">น้ำเงิน</div><div><img src="' + ART.neutral + '" alt="">คนเดินถนน</div><div><img src="' + ART.assassin + '" alt="">มือสังหาร</div></div>' +
      '</div>';
  }
  $('#cnHowBtn').on('click', function() {
    Swal.fire({ title: 'สายลับคำใบ้ เล่นยังไง', html: howToHtml(), background: '#1a2332', color: '#fff', confirmButtonText: 'เข้าใจแล้ว', confirmButtonColor: '#d9443c', width: 'min(520px, 94vw)' });
  });
  $('#cnLeaveBtn').on('click', function() {
    Swal.fire({ icon: 'question', title: 'ออกจากห้อง?', text: 'ทีมของคุณจะเล่นต่อโดยไม่มีคุณ', showCancelButton: true, confirmButtonText: 'ออก', cancelButtonText: 'อยู่ต่อ', background: '#1a2332', color: '#fff' })
      .then(r => {
        if (!r.isConfirmed) return;
        allowNavigation = true;
        socket.emit('leaveRoom', {}, function() { window.location.href = '/rooms?playerId=' + playerId; });
      });
  });
  $('#cnEndBtn').on('click', function() {
    Swal.fire({ icon: 'warning', title: 'จบเกมเลยไหม?', text: 'เกมนี้ไม่นับผล ทุกคนกลับห้องรอ', showCancelButton: true, confirmButtonText: 'จบเกม', cancelButtonText: 'เล่นต่อ', background: '#1a2332', color: '#fff', confirmButtonColor: '#d9443c' })
      .then(r => {
        if (!r.isConfirmed) return;
        allowNavigation = true;
        socket.emit('endTableSession', { roomId: roomId }, function(res) {
          if (res && res.success === false) { allowNavigation = false; toast(res.error || 'จบเกมไม่สำเร็จ', 'error'); }
        });
      });
  });
  window.addEventListener('beforeunload', function(e) { if (!allowNavigation && S.phase !== 'finished') e.preventDefault(); });
  let resizeTimer = null;
  window.addEventListener('resize', function() { clearTimeout(resizeTimer); resizeTimer = setTimeout(function() { if (S && S.board) { renderBoard(); syncDockHeight(); } }, 150); });

  // ---------- socket ----------
  function goLobby() { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; }
  socket.on('connect', function() {
    $('#cnConn').hide();
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId: roomId, playerId: playerId });
    socket.emit('codenames_requestState', { roomId: roomId, playerId: playerId });
  });
  socket.on('disconnect', function() { $('#cnConn').show(); });
  socket.on('codenamesState', render);
  socket.on('redirectToLobby', goLobby);
  socket.on('restartGame', goLobby);
  socket.on('returnToLobby', function(data) {
    S.returnLobbyEndsAt = Number(data && data.endsAt) || (Date.now() + (Number(data && data.countdown) || 10) * 1000);
    tickTimer();
  });
  socket.on('gameStarting', function() { allowNavigation = true; window.location.href = '/game/' + roomId + '?playerId=' + playerId; });
  socket.on('kickedFromRoom', function(data) {
    allowNavigation = true;
    Swal.fire({ icon: 'error', title: 'ถูกเตะออกจากห้อง', text: (data && (data.reason || data.message)) || '', background: '#1a2332', color: '#fff' })
      .then(() => { window.location.href = '/rooms?playerId=' + playerId; });
  });

  window.initChatPanel({ socket: socket, playerId: playerId, playerName: playerName });
  window.codenamesBoard = { fitWords: fitWords }; // ใช้ใน browser test ตรวจคำยาว

  if (S && S.mode) render(S);
});
</script>

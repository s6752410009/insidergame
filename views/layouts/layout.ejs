<!DOCTYPE html>
<html id="app-root" lang="th">
    <head>
        <%
            const seoData = (typeof seo !== 'undefined' && seo) ? seo : {};
            const pageTitle = seoData.title || 'Insider Game Thailand';
            const pageDescription = seoData.description || 'เว็บเกมปาร์ตี้ออนไลน์สำหรับเล่นกับเพื่อน';
            const pageKeywords = seoData.keywords || 'insider game, werewolf online, party game';
            const pageCanonical = seoData.canonical || 'https://insider-th.me/';
            const pageRobots = seoData.robots || 'index, follow';
            const ogType = seoData.ogType || 'website';
            const ogTitle = seoData.ogTitle || pageTitle;
            const ogDescription = seoData.ogDescription || pageDescription;
            const ogImage = seoData.ogImage || 'https://insider-th.me/static/image/title.jpg';
            const ogImageAlt = seoData.ogImageAlt || 'Insider Game Thailand';
            const siteName = seoData.siteName || 'Insider Game Thailand';
            const twitterCard = seoData.twitterCard || 'summary_large_image';
            const twitterTitle = seoData.twitterTitle || pageTitle;
            const twitterDescription = seoData.twitterDescription || pageDescription;
            const twitterImage = seoData.twitterImage || ogImage;
            const structuredData = Array.isArray(seoData.structuredData) ? seoData.structuredData : [];
        %>
        <meta charset="UTF-8">
        <title><%= pageTitle %></title>
        
        <!-- SEO Meta Tags -->
        <meta name="description" content="<%= pageDescription %>">
        <meta name="keywords" content="<%= pageKeywords %>">
        <meta name="author" content="Insider Game Thailand">
        <meta name="robots" content="<%= pageRobots %>">
        <meta name="googlebot" content="<%= pageRobots %>">
        <meta name="referrer" content="strict-origin-when-cross-origin">
        <link rel="canonical" href="<%= pageCanonical %>">
        <link rel="alternate" hreflang="th-TH" href="<%= pageCanonical %>">
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="<%= ogType %>">
        <meta property="og:url" content="<%= pageCanonical %>">
        <meta property="og:title" content="<%= ogTitle %>">
        <meta property="og:description" content="<%= ogDescription %>">
        <meta property="og:image" content="<%= ogImage %>">
        <meta property="og:image:alt" content="<%= ogImageAlt %>">
        <meta property="og:locale" content="th_TH">
        <meta property="og:site_name" content="<%= siteName %>">
        
        <!-- Twitter Card -->
        <meta name="twitter:card" content="<%= twitterCard %>">
        <meta name="twitter:url" content="<%= pageCanonical %>">
        <meta name="twitter:title" content="<%= twitterTitle %>">
        <meta name="twitter:description" content="<%= twitterDescription %>">
        <meta name="twitter:image" content="<%= twitterImage %>">
        <meta name="twitter:image:alt" content="<%= ogImageAlt %>">
        
        <!-- Structured Data / JSON-LD -->
        <% if (structuredData.length > 0) { %>
        <script type="application/ld+json"><%- JSON.stringify(structuredData, null, 2) %></script>
        <% } %>
        
        <script>
            // Theme Initialization - Apply immediately before CSS loads
            (function() {
                try {
                    var savedTheme = 'default';
                    var rawTheme = localStorage.getItem('currentTheme');
                    if (rawTheme) {
                        savedTheme = rawTheme.charAt(0) === '"' ? JSON.parse(rawTheme) : rawTheme;
                    } else {
                        var settings = localStorage.getItem('gameSettings');
                        if (settings) {
                            var parsed = JSON.parse(settings);
                            if (parsed && parsed.theme) savedTheme = parsed.theme;
                        }
                    }
                    if (savedTheme && savedTheme !== 'default') {
                        document.documentElement.classList.add('theme-' + savedTheme);
                    }
                } catch(e) {}
            })();
        </script>
        <!-- เปิด connection ล่วงหน้าไปยัง CDN ที่ยังใช้อยู่ ลด latency handshake บนมือถือ -->
        <link rel="preconnect" href="https://maxcdn.bootstrapcdn.com" crossorigin>
        <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="/static/css/style.css">
        <link rel="stylesheet" href="/static/css/form.css">
        <link rel="stylesheet" href="/static/css/mobile.css">
        <link rel="stylesheet" href="/static/css/game-icons.css">
        <link rel="stylesheet" href="/static/css/playerAvatar.css">
        <link rel="stylesheet" href="/static/css/uiFeedback.css">
        <link rel="stylesheet" href="/static/css/support.css">
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
        <link rel="stylesheet" href=
"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.9.0/css/all.css">
        <link rel="icon" type="image/png" sizes="32x32" href="/static/image/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="96x96" href="/static/image/favicon-96x96.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/static/image/favicon-16x16.png">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="insider-player-id" content="<%= typeof viewerPlayerId !== 'undefined' && viewerPlayerId ? viewerPlayerId : (typeof player !== 'undefined' && player && player.playerId ? player.playerId : '') %>">
        
        <!-- PWA Support -->
        <link rel="manifest" href="/static/manifest.json">
        <meta name="theme-color" content="#e74c3c">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content="Insider + Werewolf">
        <link rel="apple-touch-icon" href="/static/image/favicon-96x96.png">
    </head>
 
    <body class="content">
        
        <div class="container-fluid">
            <header>
                <img src="/static/image/title.jpg" alt="Insider Game" />
            </header>
            <div class="row">
                <div class="col-lg-12">
                    <%-defineContent('content')%>
                </div>
            </div>
        </div>

        <footer class="footer">
            <%-defineContent('footer')%>
        </footer>

        <!-- Audio Player และ Controls -->
        <!-- preload=none: ไฟล์ 8.5MB ห้ามให้เบราว์เซอร์แตะจนกว่าผู้เล่นจะกดเปิดเพลงเอง -->
        <audio id="background-music" src="/static/sound/bgm.mp3" loop preload="none"></audio>
        <div id="music-controls" style="position: fixed; top: 15px; left: 15px; z-index: 10001; background: rgba(255,255,255,0.7); border-radius: 5px; padding: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
            <img id="music-toggle-btn" src="/static/image/song.png" alt="Music Toggle" style="width: 30px; height: 30px; cursor: pointer; display: block;">
        </div>

        <a id="support-fab" class="support-fab" href="/support" aria-label="ส่งข้อความถึง Site Admin">
            <span aria-hidden="true">✉️</span><span>ติดต่อแอดมิน</span>
        </a>

        <!-- Javascript -->
        <!-- self-host + minified: เดิมโหลดตัว unminified 273KB จาก CDN ภายนอกทุกหน้า
             ตัวนี้เนื้อหาเวอร์ชันเดียวกันเป๊ะ (1.10.2) เหลือ ~33KB หลัง gzip และติด cache ของเรา -->
        <script src="/static/vendor/jquery-1.10.2.min.js"></script>
        <script src="/socket.io/socket.io.js"></script>
        <script src="/static/js/timer.js"></script>
        <!-- Player Identity System - ต้องโหลดก่อน scripts อื่น -->
        <script src="/static/js/playerIdentity.js"></script>
        <!-- ตัว render รูปผู้เล่น + กรอบ ใช้ร่วมกันทุกหน้า -->
        <script src="/static/js/playerAvatar.js"></script>
        <script>
            (function() {
                var button = document.getElementById('support-fab');
                if (!button) return;
                // Show contact shortcut on the home page only.
                if (location.pathname !== '/') {
                    button.hidden = true;
                    return;
                }
                var playerId = localStorage.getItem('insiderGamePlayerId');
                if (playerId) button.href = '/support?playerId=' + encodeURIComponent(playerId);
            })();
        </script>
        <!-- เพิ่ม SweetAlert2 CDN ที่นี่ -->
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <!-- จัดการปัญหา Back/Forward Cache: ถ้ากลับมาหน้าจากปุ่มย้อนกลับ ให้ reload ใหม่เพื่อ sync กับ server -->
        <script>
            (function() {
                function shouldForceReload(event) {
                    try {
                        if (event && event.persisted) return true; // bfcache
                        if (performance && performance.getEntriesByType) {
                            const navEntries = performance.getEntriesByType('navigation');
                            if (navEntries && navEntries[0] && navEntries[0].type === 'back_forward') {
                                return true;
                            }
                        }
                    } catch (e) {
                        // ignore
                    }
                    return false;
                }

                window.addEventListener('pageshow', function(event) {
                    if (shouldForceReload(event)) {
                        // ใช้ replace เพื่อไม่ให้เพิ่ม history ซ้อน
                        window.location.replace(window.location.href);
                    }
                });
                
                // Global socket listener สำหรับ playerDeleted event
                // จะทำงานเมื่อ socket เชื่อมต่อแล้ว
                if (typeof io !== 'undefined') {
                    window.appSocket = window.appSocket || io({
                        reconnection: true,
                        reconnectionAttempts: Infinity,
                        reconnectionDelay: 500,
                        reconnectionDelayMax: 5000,
                        transports: ['websocket', 'polling']
                    });
                    window.appSocket.on('playerDeleted', function(data) {
                        // ล้าง localStorage และ redirect ไปหน้าหลัก
                        localStorage.removeItem('insiderGamePlayerId');
                        alert(data.message || 'บัญชีของคุณถูกลบ กรุณาสร้างบัญชีใหม่');
                        window.location.href = '/';
                    });
                }
            })();
        </script>
    
        <script>
            // filepath: c:\Users\pc\Desktop\insider-game-master\views\layouts\layout.ejs
            // ฟังก์ชันนี้จำเป็นสำหรับ board.ejs และต้องเป็น global
            function formatCountdown(seconds) {
                const minutes = Math.floor(seconds / 60);
                const remainingSeconds = seconds % 60;
                return `${minutes.toString().padStart(2, '0')}:${remainingSeconds.toString().padStart(2, '0')}`;
            }

            $(document).ready(function() {
                const audio = $('#background-music')[0];
                const musicToggleButton = $('#music-toggle-btn');
                const playIcon = '/static/image/song.png';
                const muteIcon = '/static/image/mute.png';

                // ตรวจสอบสถานะ mute ที่บันทึกไว้ใน localStorage
                let isMuted = localStorage.getItem('isMusicMuted') === 'true';

                // กำหนดสถานะเริ่มต้น
                if (isMuted) {
                    audio.muted = true;
                    musicToggleButton.attr('src', muteIcon);
                } else {
                    audio.muted = false;
                    musicToggleButton.attr('src', playIcon);
                    // พยายามเล่นเพลงอัตโนมัติ แต่เบราว์เซอร์อาจบล็อก
                    // เราจะใช้การคลิกครั้งแรกของผู้ใช้เพื่อเริ่มเล่นหากถูกบล็อก
                    audio.play().catch(e => {
                        console.log("Autoplay was prevented:", e);
                        // ถ้า autoplay ถูกบล็อก ให้แสดงไอคอนเล่นเพลงไว้ ผู้ใช้จะต้องคลิกเอง
                        musicToggleButton.attr('src', playIcon);
                    });
                }

                // สลับสถานะเพลงเมื่อคลิกปุ่ม
                musicToggleButton.on('click', function() {
                    if (audio.muted) {
                        audio.muted = false;
                        isMuted = false;
                        // พยายามเล่นเพลงเฉพาะเมื่อเพลงหยุดอยู่ (เพื่อจัดการกับ autoplay ที่ถูกบล็อกในตอนแรก)
                        if (audio.paused) {
                            audio.play().catch(e => {
                                console.log("Play after user click was prevented:", e);
                                isMuted = true; // เปลี่ยนสถานะกลับถ้ายังถูกบล็อก
                                audio.muted = true; // ยังคง mute ไว้
                                musicToggleButton.attr('src', muteIcon);
                            });
                        }
                        musicToggleButton.attr('src', playIcon);
                    } else {
                        audio.muted = true;
                        isMuted = true;
                        musicToggleButton.attr('src', muteIcon);
                    }
                    localStorage.setItem('isMusicMuted', isMuted);
                });

                // แก้ไขปัญหา autoplay ที่เข้มงวด:
                // หากเพลงควรจะเล่นแต่ไม่ได้เล่น (เช่น เพราะนโยบาย autoplay)
                // ให้ลองเล่นเมื่อมีการโต้ตอบของผู้ใช้ครั้งแรกบนหน้าใดๆ
                $(document).one('click', function() {
                    if (!audio.muted && audio.paused && localStorage.getItem('isMusicMuted') !== 'true') {
                        audio.play().catch(e => console.log("First user interaction play prevented:", e));
                    }
                });
            });
        </script>
        
        <!-- PWA Service Worker -->
        <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function() {
                    navigator.serviceWorker.register('/static/service-worker.js')
                        .then(function(reg) { console.log('SW registered:', reg.scope); })
                        .catch(function(err) { console.log('SW failed:', err); });
                });
            }
        </script>
        
        <%-defineContent('script')%>
    </body>
</html>

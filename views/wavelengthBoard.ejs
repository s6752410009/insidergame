<%- contentFor('script') %>
<script src="/js/chatPanel.js"></script>
<script>
$(function() {
  document.documentElement.classList.add('wl-active');

  const socket = io({ reconnection: true, reconnectionAttempts: Infinity, transports: ['websocket', 'polling'] });
  const roomId = '<%= room.roomId %>';
  const playerId = '<%= player.playerId %>';
  const playerName = <%- JSON.stringify(String(player.name || player.playerName || '')) %>;
  if (window.partyPlay) window.partyPlay.startSession('wavelength', socket);

  let S = <%- JSON.stringify(typeof wavelengthState !== 'undefined' && wavelengthState ? wavelengthState : {}).replace(/</g, '\\u003c') %>;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const PHASE_LABEL = { clue: 'คิดคำใบ้', guess: 'หมุนเข็มทาย', reveal: 'เปิดเป้า', finished: 'จบเกม', lobby: 'รอเริ่ม' };
  const CX = 200, CY = 200;

  let allowNavigation = false;
  let firstRender = true;
  let seenFx = 0;
  let pending = false;
  let timerHandle = null;
  let bandsShown = false;
  let bandsRound = 0;
  let pinsShownRound = 0;
  let clueShownKey = '';
  let optionsKey = '';
  let draftClue = '';
  let draftRound = 0;
  let lastRevealRound = 0;
  let finalAnimated = false;
  // นาฬิกาเทียบเซิร์ฟเวอร์ — มือถือที่ตั้งเวลาเพี้ยนก็นับถอยหลังตรงกับคนอื่น
  let clockOffset = S && S.serverNow ? S.serverNow - Date.now() : 0;
  function now() { return Date.now() + clockOffset; }
  // ล็อกโดยยังไม่ขยับเข็ม = ถามก่อน 1 ครั้ง (กันกดพลาดแล้วได้ตรงกลาง)
  let touchedRound = 0;
  let centerWarnRound = 0;
  const DRAFT_KEY = 'wl-draft-' + '<%= room.roomId %>';
  function saveDraft() { try { sessionStorage.setItem(DRAFT_KEY, JSON.stringify({ round: S.round, text: draftClue })); } catch (e) { /* ignore */ } }
  function loadDraft(round) {
    try { const d = JSON.parse(sessionStorage.getItem(DRAFT_KEY) || 'null'); return d && d.round === round ? String(d.text || '') : ''; } catch (e) { return ''; }
  }

  // ---------- helpers ----------
  function esc(text) {
    return String(text == null ? '' : text).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c]);
  }
  function avatarHtml(p, size) {
    if (typeof window.renderPlayerAvatar === 'function') {
      return window.renderPlayerAvatar({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: p.color, playerName: p.name }, { size: size || 26 });
    }
    return '<span aria-hidden="true">' + esc(p.avatar || '👤') + '</span>';
  }
  function haptic(p) { if (typeof window.gameHaptic === 'function') window.gameHaptic(p); }
  function playerById(id) { return (S.players || []).find(p => p.playerId === id) || null; }
  function nameOf(id) { const p = playerById(id); return p ? p.name : ''; }
  function angleOf(v) { return (Number(v) - 50) * 1.8; }
  function polar(v, r) {
    const a = (180 - Number(v) * 1.8) * Math.PI / 180;
    return { x: CX + r * Math.cos(a), y: CY - r * Math.sin(a) };
  }
  const segmenter = window.Intl && Intl.Segmenter ? new Intl.Segmenter('th', { granularity: 'grapheme' }) : null;
  function glen(text) {
    if (!segmenter) return Array.from(String(text)).length;
    let n = 0; for (const _ of segmenter.segment(String(text))) n += 1; // eslint-disable-line no-unused-vars
    return n;
  }
  function compact(text) {
    return String(text || '').normalize('NFC').replace(/[​-‍⁠﻿­]/g, '').toLowerCase().replace(/[\sๆ.,!?'"“”‘’()\-_/\\:;~*]+/g, '');
  }
  function clueProblem(text, card) {
    const clean = String(text || '').replace(/\s+/g, ' ').trim();
    if (!clean) return 'พิมพ์คำใบ้ก่อน';
    if (glen(clean) > (S.maxClueLength || 40)) return 'ยาวเกิน ' + (S.maxClueLength || 40) + ' ตัวอักษร';
    if (/[0-9๐-๙]/.test(clean)) return 'ห้ามใช้ตัวเลข';
    if (card) {
      const c = compact(clean);
      const hit = [card.left, card.right].map(compact).some(w => w && (c.includes(w) || (glen(c) >= 2 && w.includes(c))));
      if (hit) return 'ห้ามใช้คำบนการ์ด';
    }
    return '';
  }

  // ---------- dial: static parts ----------
  (function buildTicks() {
    let html = '';
    for (let v = 0; v <= 100; v += 5) {
      const major = v % 25 === 0;
      const a = polar(v, 176), b = polar(v, major ? 160 : 167);
      html += '<line x1="' + a.x.toFixed(1) + '" y1="' + a.y.toFixed(1) + '" x2="' + b.x.toFixed(1) + '" y2="' + b.y.toFixed(1) + '" stroke="#cbd5e1" stroke-opacity="' + (major ? 0.55 : 0.28) + '" stroke-width="' + (major ? 2.2 : 1.4) + '" stroke-linecap="round"/>';
      html += '<line class="wl-tick-lit" data-tick="' + (v / 5) + '" x1="' + a.x.toFixed(1) + '" y1="' + a.y.toFixed(1) + '" x2="' + b.x.toFixed(1) + '" y2="' + b.y.toFixed(1) + '" stroke="#5eead4" stroke-width="3" stroke-linecap="round"/>';
    }
    document.getElementById('wlTicks').innerHTML = html;
  })();

  function wedge(halfUnits, r) {
    const a = polar(50 - halfUnits, r), b = polar(50 + halfUnits, r);
    return 'M' + CX + ' ' + CY + ' L' + a.x.toFixed(2) + ' ' + a.y.toFixed(2) + ' A' + r + ' ' + r + ' 0 0 1 ' + b.x.toFixed(2) + ' ' + b.y.toFixed(2) + ' Z';
  }
  function buildBands() {
    const bands = S.bands && S.bands.length ? S.bands : [{ points: 4, halfWidth: 4 }, { points: 3, halfWidth: 11 }, { points: 2, halfWidth: 18 }];
    const colors = { 2: '#f2c66d', 3: '#f08a5d', 4: '#5eead4' };
    const sorted = bands.slice().sort((x, y) => y.halfWidth - x.halfWidth);
    let html = '';
    sorted.forEach(b => { html += '<path d="' + wedge(b.halfWidth, 196) + '" fill="' + colors[b.points] + '"/>'; });
    // เส้นคั่นแถบ ให้อ่านง่ายบนจอมือถือ
    sorted.forEach(b => {
      [-b.halfWidth, b.halfWidth].forEach(u => {
        const p = polar(50 + u, 196);
        html += '<line x1="' + CX + '" y1="' + CY + '" x2="' + p.x.toFixed(1) + '" y2="' + p.y.toFixed(1) + '" stroke="#0f1a2b" stroke-opacity="0.55" stroke-width="1.5"/>';
      });
    });
    // ตัวเลขแต้มบนแถบ
    const inner = bands.find(b => b.points === 4) || { halfWidth: 4 };
    const mid = bands.find(b => b.points === 3) || { halfWidth: 11 };
    const out = bands.find(b => b.points === 2) || { halfWidth: 18 };
    const labels = [[0, 4], [-(inner.halfWidth + mid.halfWidth) / 2, 3], [(inner.halfWidth + mid.halfWidth) / 2, 3], [-(mid.halfWidth + out.halfWidth) / 2, 2], [(mid.halfWidth + out.halfWidth) / 2, 2]];
    labels.forEach(([u, pts]) => {
      const p = polar(50 + u, 150);
      html += '<text x="' + p.x.toFixed(1) + '" y="' + p.y.toFixed(1) + '" text-anchor="middle" dominant-baseline="central" font-family="Chakra Petch, sans-serif" font-weight="700" font-size="' + (pts === 4 ? 17 : 14) + '" fill="#0b1626" transform="rotate(' + (u * 1.8).toFixed(1) + ' ' + p.x.toFixed(1) + ' ' + p.y.toFixed(1) + ')">' + pts + '</text>';
    });
    document.getElementById('wlBands').innerHTML = html;
  }
  buildBands();

  // ---------- needle ----------
  const dialEl = document.getElementById('wlDial');
  const needleEl = document.getElementById('wlNeedle');
  const wobbleEl = document.getElementById('wlNeedleWobble');
  const knobEl = document.getElementById('wlKnobHit');
  let needleVal = 50;
  let needleTarget = 50;
  let needleRaf = null;
  let myPin = 50;
  let myPinRound = 0;
  let dragging = false;
  let lastTick = -1;
  let lastHapticAt = 0;
  let lastSentAt = 0;
  let sendTimer = null;
  let litTick = null;

  function applyNeedle() {
    needleEl.style.transform = 'rotate(' + angleOf(needleVal).toFixed(2) + 'deg)';
    knobEl.setAttribute('aria-valuenow', String(Math.round(needleVal)));
  }
  function stepNeedle() {
    needleRaf = null;
    const d = needleTarget - needleVal;
    if (Math.abs(d) < 0.04) { needleVal = needleTarget; applyNeedle(); return; }
    needleVal += d * (dragging ? 0.42 : 0.2);
    applyNeedle();
    needleRaf = requestAnimationFrame(stepNeedle);
  }
  function setNeedle(v, immediate) {
    needleTarget = Math.max(0, Math.min(100, Number(v)));
    if (immediate || reduceMotion) {
      if (needleRaf) { cancelAnimationFrame(needleRaf); needleRaf = null; }
      needleVal = needleTarget;
      applyNeedle();
      return;
    }
    if (!needleRaf) needleRaf = requestAnimationFrame(stepNeedle);
  }
  function lightTick(v) {
    const t = Math.round(v / 5);
    if (litTick && litTick.dataset.tick === String(t)) return;
    if (litTick) litTick.classList.remove('is-on');
    litTick = document.querySelector('.wl-tick-lit[data-tick="' + t + '"]');
    if (litTick) litTick.classList.add('is-on');
  }
  function clearTick() { if (litTick) litTick.classList.remove('is-on'); litTick = null; }

  function canDrag() { return !!(S.availableActions && S.availableActions.canGuess); }
  function valueFromEvent(e) {
    const rect = dialEl.getBoundingClientRect();
    const x = (e.clientX - rect.left) * 400 / rect.width;
    const y = (e.clientY - rect.top) * 214 / rect.height;
    let deg = Math.atan2(CY - y, x - CX) * 180 / Math.PI;
    if (y > CY) deg = x < CX ? 180 : 0;
    deg = Math.max(0, Math.min(180, deg));
    return Math.round(((180 - deg) / 1.8) * 10) / 10;
  }
  function onPinChange(v, fromDrag) {
    myPin = v;
    myPinRound = S.round;
    touchedRound = S.round;
    if (centerWarnRound === S.round) { centerWarnRound = 0; renderDock(); }
    setNeedle(v, false);
    lightTick(v);
    const tick = Math.floor(v / 5);
    const now = performance.now();
    if (fromDrag && tick !== lastTick && now - lastHapticAt > 35) { haptic(4); lastHapticAt = now; }
    lastTick = tick;
    queueSendPin();
  }
  function queueSendPin() {
    const now = Date.now();
    const wait = Math.max(0, 160 - (now - lastSentAt));
    clearTimeout(sendTimer);
    sendTimer = setTimeout(function() {
      lastSentAt = Date.now();
      if (!canDrag()) return;
      socket.emit('wavelength_pin', { value: myPin, round: S.round, phase: 'guess' });
    }, wait);
  }
  dialEl.addEventListener('pointerdown', function(e) {
    if (!canDrag()) return;
    e.preventDefault();
    dragging = true;
    dialEl.classList.add('is-dragging');
    try { dialEl.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
    onPinChange(valueFromEvent(e), true);
    haptic(8);
  });
  dialEl.addEventListener('pointermove', function(e) {
    if (!dragging) return;
    onPinChange(valueFromEvent(e), true);
  });
  function endDrag() {
    if (!dragging) return;
    dragging = false;
    dialEl.classList.remove('is-dragging');
    clearTick();
    queueSendPin();
  }
  dialEl.addEventListener('pointerup', endDrag);
  dialEl.addEventListener('pointercancel', endDrag);
  dialEl.addEventListener('lostpointercapture', endDrag);
  knobEl.addEventListener('keydown', function(e) {
    if (!canDrag()) return;
    const step = e.shiftKey ? 5 : 1;
    let v = myPin;
    if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') v -= step;
    else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') v += step;
    else if (e.key === 'Home') v = 0;
    else if (e.key === 'End') v = 100;
    else if (e.key === 'Enter') { lockNow(); e.preventDefault(); return; }
    else return;
    e.preventDefault();
    onPinChange(Math.max(0, Math.min(100, v)), false);
  });

  // ---------- dial: per-state ----------
  const bandsEl = document.getElementById('wlBands');
  const shutterEl = document.getElementById('wlShutter');
  const beamEl = document.getElementById('wlBeam');

  function setBands(target, animate) {
    bandsEl.style.display = '';
    if (!animate || reduceMotion) {
      bandsEl.classList.add('no-anim');
      bandsEl.style.transition = 'none';
      bandsEl.style.transform = 'rotate(' + angleOf(target).toFixed(2) + 'deg)';
      shutterEl.classList.add('no-anim');
      shutterEl.classList.add('is-open');
      void bandsEl.getBoundingClientRect();
      bandsEl.classList.remove('no-anim');
      shutterEl.classList.remove('no-anim');
      return;
    }
    // กวาดเข้ามาจากขอบซ้าย แล้วเด้งหยุดที่เป้า + ม่านหมุนเปิด + ลำแสงกวาด
    bandsEl.style.transition = 'none';
    bandsEl.style.transform = 'rotate(' + angleOf(-25).toFixed(2) + 'deg)';
    shutterEl.classList.add('no-anim');
    shutterEl.classList.remove('is-open');
    void bandsEl.getBoundingClientRect();
    shutterEl.classList.remove('no-anim');
    requestAnimationFrame(function() {
      bandsEl.style.transition = 'transform 1.25s cubic-bezier(0.25, 1.3, 0.4, 1) 0.12s';
      bandsEl.style.transform = 'rotate(' + angleOf(target).toFixed(2) + 'deg)';
      shutterEl.classList.add('is-open');
      beamEl.classList.remove('is-idle', 'is-sweep');
      void beamEl.getBoundingClientRect();
      beamEl.classList.add('is-sweep');
    });
  }
  function hideBands() {
    shutterEl.classList.remove('is-open');
    bandsEl.style.display = 'none';
  }

  function renderPins(animate) {
    const wrap = document.getElementById('wlPins');
    const lr = S.lastRound;
    if (!(S.phase === 'reveal' || S.phase === 'finished') || !lr || lr.skipped) { wrap.innerHTML = ''; pinsShownRound = 0; return; }
    if (pinsShownRound === lr.round && !animate) return;
    pinsShownRound = lr.round;
    const rows = (lr.results || []).filter(r => r.pin != null).slice().sort((a, b) => a.pin - b.pin);
    // วางป้ายชื่อตามแนวเข็ม ชนกันก็ขยับเข้าด้านใน · ไม่มีที่ว่างแล้ว = รวมเป็น "+N" ที่ป้ายใกล้สุด
    // (วงใหญ่ 12 คนทายกระจุกกัน ป้ายเคยซ้อนกันอ่านไม่ออก) · เช็กชนจากขนาดจริงบนจอ · ป้ายของเราวางก่อนเสมอ
    const rings = [128, 100, 72];
    const order = rows.filter(r => r.playerId === playerId).concat(rows.filter(r => r.playerId !== playerId));
    const labelHtml = function(r, more, i, pos) {
      const me = r.playerId === playerId;
      const title = [me ? 'คุณ' : r.name].concat(more || []).join(', ');
      return '<span class="wl-pin' + (me ? ' is-me' : '') + (animate && pos ? ' is-drop' : '') + '" title="' + esc(title) + '" style="' + (pos ? 'left:' + pos.left + '%; top:' + pos.top + '%; ' : 'visibility:hidden; ') + '--pin-color:' + esc(r.color || '#fff') + '; --d:' + (900 + i * 70) + 'ms">' +
        '<span class="wl-pin-dot" aria-hidden="true">' + esc(r.avatar || '') + '</span><span class="wl-pin-name">' + esc(me ? 'คุณ' : r.name) + '</span>' +
        (more && more.length ? '<span class="wl-pin-more">+' + more.length + '</span>' : '') + '</span>';
    };
    // วัดขนาดป้ายจริงก่อน (ซ่อนไว้)
    wrap.innerHTML = order.map((r, i) => labelHtml(r, null, i, null)).join('');
    const W = wrap.clientWidth || 1, H = wrap.clientHeight || 1;
    const sizes = Array.from(wrap.children).map(el => ({ w: el.offsetWidth, h: el.offsetHeight }));
    // pad = ที่เผื่อป้าย "+N" ต่อท้าย — ลองแบบไม่เผื่อก่อน ถ้าต้องรวมป้าย ค่อยจัดใหม่แบบเผื่อ
    function layout(pad) {
      const placed = [];
      let merged = 0;
      order.forEach(function(r, i) {
        for (let k = 0; k < rings.length; k += 1) {
          const lab = polar(r.pin, rings[k]);
          const box = { x: lab.x / 400 * W, y: lab.y / 214 * H, w: sizes[i].w + pad, h: sizes[i].h };
          const hit = placed.some(p => Math.abs(p.box.x - box.x) * 2 < p.box.w + box.w && Math.abs(p.box.y - box.y) * 2 < p.box.h + box.h);
          if (!hit) { placed.push({ r: r, lab: lab, box: box, more: [] }); return; }
        }
        merged += 1;
        const near = placed.slice().sort((a, b) => Math.abs(a.r.pin - r.pin) - Math.abs(b.r.pin - r.pin))[0];
        near.more.push(r.name);
      });
      return { placed: placed, merged: merged };
    }
    let fit = layout(0);
    if (fit.merged) fit = layout(24);
    const placed = fit.placed;
    const html = placed.sort((a, b) => a.r.pin - b.r.pin).map((p, i) =>
      labelHtml(p.r, p.more, i, { left: (p.lab.x / 4).toFixed(2), top: (p.lab.y / 2.14).toFixed(2) })).join('');
    wrap.innerHTML = html;
    // เข็มบางของทุกคนบนหน้าปัด (SVG)
    let lines = '';
    rows.forEach(function(r) {
      const tip = polar(r.pin, 180), base = polar(r.pin, 30);
      lines += '<line x1="' + base.x.toFixed(1) + '" y1="' + base.y.toFixed(1) + '" x2="' + tip.x.toFixed(1) + '" y2="' + tip.y.toFixed(1) + '" stroke="' + esc(r.color || '#fff') + '" stroke-width="' + (r.playerId === playerId ? 3.4 : 2.2) + '" stroke-linecap="round" opacity="0.95"/>' +
        '<circle cx="' + tip.x.toFixed(1) + '" cy="' + tip.y.toFixed(1) + '" r="' + (r.playerId === playerId ? 6 : 4.5) + '" fill="' + esc(r.color || '#fff') + '" stroke="#0f1a2b" stroke-width="1.5"/>';
    });
    let g = document.getElementById('wlPinLines');
    if (!g) {
      g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.id = 'wlPinLines';
      dialEl.insertBefore(g, document.getElementById('wlNeedle'));
    }
    g.innerHTML = lines;
    g.style.opacity = '0';
    g.style.transition = animate && !reduceMotion ? 'opacity 0.4s ease-out 0.9s' : 'none';
    requestAnimationFrame(function() { g.style.opacity = '1'; });
  }
  function clearPinLines() {
    const g = document.getElementById('wlPinLines');
    if (g) g.innerHTML = '';
  }

  function renderDial(revealAnim) {
    const self = S.self || {};
    const phase = S.phase;
    const showTarget = S.target != null;
    // แถบเป้า: ผู้ใบ้เห็นตลอดรอบ · คนอื่นเห็นตอนเปิดเท่านั้น (ไม่มีข้อมูลเป้าใน DOM ก่อนหน้านั้น)
    if (showTarget) {
      const key = S.round;
      if (!bandsShown || bandsRound !== key) {
        setBands(S.target, !firstRender && (revealAnim || phase === 'clue'));
      } else if (revealAnim) {
        setBands(S.target, true);
      }
      bandsShown = true;
      bandsRound = key;
    } else {
      if (bandsShown) hideBands();
      bandsShown = false;
    }
    // ลำแสงเรดาร์ตอนรอคำใบ้
    const idle = phase === 'clue' && !showTarget;
    if (idle && !beamEl.classList.contains('is-idle') && !reduceMotion) { beamEl.classList.remove('is-sweep'); beamEl.classList.add('is-idle'); }
    if (!idle) beamEl.classList.remove('is-idle');

    // เข็มของตัวเอง
    const guessing = phase === 'guess' && self.isGuesser;
    if (S.round !== myPinRound) {
      myPin = self.pin != null ? self.pin : 50;
      myPinRound = S.round;
      setNeedle(myPin, true);
    } else if (!dragging && self.pin != null && guessing && Math.abs(self.pin - myPin) > 0.05 && (S.availableActions || {}).canGuess === false) {
      myPin = self.pin;
      setNeedle(myPin, true);
    }
    needleEl.classList.toggle('is-hidden', !guessing);
    needleEl.classList.toggle('is-locked', !!self.locked);
    dialEl.classList.toggle('is-interactive', canDrag());
    knobEl.setAttribute('tabindex', canDrag() ? '0' : '-1');
    if (phase !== 'reveal' && phase !== 'finished') { document.getElementById('wlPins').innerHTML = ''; pinsShownRound = 0; clearPinLines(); }
    renderPins(revealAnim);

    let note = '';
    if (phase === 'clue' && self.isGiver) note = S.card ? 'เป้าลับของคุณ — คนอื่นมองไม่เห็น' : 'เป้าลับของคุณ — เลือกการ์ดก่อน';
    else if (phase === 'guess' && self.isGiver) note = 'คุณเห็นเป้า · รอทุกคนล็อก';
    else if (phase === 'guess' && self.isGuesser) note = self.locked ? 'ล็อกแล้ว — แก้ได้ก่อนหมดเวลา' : 'ลากเข็มไปตรงที่คิดว่าใช่';
    else if (phase === 'guess') note = 'ดูเพื่อนทาย — รอบหน้าคุณได้เล่น';
    document.getElementById('wlDialNote').textContent = note;
  }

  // ---------- render ----------
  function describeNow() {
    const self = S.self || {};
    const a = S.availableActions || {};
    const giver = S.giverName || 'ผู้ใบ้';
    switch (S.phase) {
      case 'clue':
        if (self.isGiver) return { text: S.card ? 'พิมพ์คำใบ้ที่อยู่ตรงเป้า' : 'ตาคุณใบ้! เลือกการ์ด 1 ใบ', mine: true };
        if (S.giverAway) return { text: giver + ' หลุด — รอสักครู่', mine: false };
        return { text: giver + ' กำลังคิดคำใบ้…', mine: false };
      case 'guess':
        if (a.canGuess) return { text: 'ลากเข็มแล้วกดล็อก', mine: true };
        if (self.isGuesser && self.locked) return { text: 'ล็อกแล้ว — รอคนอื่น', mine: false };
        if (self.isGiver) return { text: 'เพื่อนกำลังทายคำใบ้ของคุณ', mine: false };
        return { text: 'เพื่อนกำลังทาย — รอบหน้าคุณได้เล่น', mine: false };
      case 'reveal': {
        const lr = S.lastRound;
        if (lr && lr.skipped) return { text: 'ข้ามรอบนี้', mine: false };
        const mine = lr && (lr.results || []).find(r => r.playerId === playerId);
        if (mine) return { text: mine.points ? mine.label + ' +' + mine.points + ' แต้ม' : (mine.pin == null ? 'รอบนี้ไม่ได้ทาย' : 'พลาด — ไม่ได้แต้ม'), mine: mine.points > 0 };
        if (lr && lr.giverId === playerId) return { text: 'คุณได้ +' + lr.giverPoints + ' (เฉลี่ยของเพื่อน)', mine: lr.giverPoints > 0 };
        return { text: 'เปิดเป้าแล้ว', mine: false };
      }
      case 'finished': return { text: 'จบเกม — ดูอันดับด้านล่าง', mine: false };
      default: return { text: 'รอเริ่มเกม', mine: false };
    }
  }
  function timerHint() {
    switch (S.phase) {
      case 'clue': return S.giverAway ? 'ผู้ใบ้หลุด ไม่กลับ = ข้าม' : 'หมดเวลา = ข้ามรอบ';
      case 'guess': return 'หมดเวลา = ล็อกที่เข็มอยู่';
      case 'reveal': return 'หมดเวลา = รอบต่อไป';
      default: return '';
    }
  }
  function renderTop() {
    const total = Math.max(S.round || 0, S.roundsTotal || 0);
    $('#wlRoundNo').text(S.round ? 'รอบ ' + S.round + (total ? '/' + total : '') : 'เตรียมเกม');
    const now = describeNow();
    $('#wlNowPhase').text((PHASE_LABEL[S.phase] || '') + (S.round && S.phase !== 'finished' ? ' · รอบ ' + S.round : ''));
    $('#wlNowCopy').text(now.text);
    $('#wlNow').toggleClass('is-mine', !!now.mine);
    $('#wlNowHint').text(timerHint());
    const a = S.availableActions || {};
    $('#wlEndBtn').prop('hidden', !a.canEnd);
    // หัวห้อง: ข้ามผู้ใบ้ที่เงียบ / เปิดเป้าเมื่อมีคน AFK (ถ้าหัวห้องเป็นผู้ใบ้เอง ใช้ปุ่มข้ามตาในช่องคำใบ้แทน)
    const hostSkip = a.canHostSkip && !a.canSkipTurn;
    $('#wlSkipBtn').prop('hidden', !hostSkip).text(S.phase === 'guess' ? 'เปิดเป้าเลย' : 'ข้ามตานี้');
  }

  function renderSpectrum() {
    const card = S.card;
    $('#wlSpectrum').toggleClass('is-empty', !card)
      .css('display', S.phase === 'clue' && S.self && S.self.isGiver ? 'none' : ''); // ผู้ใบ้เห็นการ์ดที่เลือกในรายการด้านบนอยู่แล้ว
    $('#wlLeft').text(card ? card.left : (S.phase === 'clue' ? 'รอการ์ด' : '—'));
    $('#wlRight').text(card ? card.right : (S.phase === 'clue' ? 'รอการ์ด' : '—'));
    const clueBox = document.getElementById('wlClue');
    if (S.clue && (S.phase === 'guess' || S.phase === 'reveal')) {
      const key = S.round + ':' + S.clue;
      const fresh = key !== clueShownKey && !firstRender;
      clueShownKey = key;
      clueBox.hidden = false;
      clueBox.innerHTML = '<div class="wl-clue-label">คำใบ้จาก ' + esc(S.giverName || 'ผู้ใบ้') + '</div>' +
        '<div class="wl-clue-text' + (fresh ? ' is-in' : '') + '">“' + esc(S.clue) + '”</div>';
    } else if (S.phase === 'clue' && !(S.self && S.self.isGiver)) {
      clueShownKey = '';
      clueBox.hidden = false;
      clueBox.innerHTML = '<p class="wl-wait">' + (S.self && S.self.pending ? 'คุณเพิ่งเข้ามา — <strong>ได้ทายรอบนี้ด้วย</strong> · ' : '') +
        '📡 <strong>' + esc(S.giverName || 'ผู้ใบ้') + '</strong> กำลังเลือกการ์ดและคิดคำใบ้</p>';
    } else {
      clueBox.hidden = true;
      clueBox.innerHTML = '';
    }
  }

  function renderOptions() {
    const box = document.getElementById('wlOptions');
    const a = S.availableActions || {};
    if (!(S.phase === 'clue' && a.canPickCard)) { box.innerHTML = ''; optionsKey = ''; return; }
    const key = S.round + ':' + (S.options || []).map(c => c.id).join(',');
    const fresh = key !== optionsKey;
    optionsKey = key;
    box.innerHTML = '<div class="wl-options">' +
      '<div class="wl-options-head"><span class="wl-options-title">เลือกการ์ด 1 ใบ</span>' +
      (a.canReroll ? '<button type="button" id="wlRerollBtn" class="wl-btn wl-btn--ghost wl-btn--sm">สุ่มใหม่ (1 ครั้ง)</button>' : '<span class="wl-hint">สุ่มใหม่ไปแล้ว</span>') +
      '</div>' +
      (S.options || []).map(function(c, i) {
        const picked = S.card && S.card.id === c.id;
        return '<button type="button" class="wl-option' + (picked ? ' is-picked' : '') + (fresh && !firstRender ? ' is-in' : '') + '" data-index="' + i + '" style="--d:' + (i * 90) + 'ms" aria-pressed="' + (picked ? 'true' : 'false') + '">' +
          '<span class="wl-option-l">' + esc(c.left) + '</span><span class="wl-option-bar" aria-hidden="true"></span><span class="wl-option-r">' + esc(c.right) + '</span></button>';
      }).join('') + '</div>';
  }

  function renderLocks() {
    const box = document.getElementById('wlLocks');
    if (S.phase !== 'guess') { box.innerHTML = ''; return; }
    const guessers = (S.players || []).filter(p => p.isGuesser);
    box.innerHTML = guessers.map(p =>
      '<span class="wl-lock' + (p.locked ? ' is-locked' : '') + (p.online ? '' : ' is-off') + '" data-lock-id="' + esc(p.playerId) + '">' +
        avatarHtml(p, 22) + '<span class="wl-lock-name">' + esc(p.isSelf ? 'คุณ' : p.name) + '</span>' +
        '<span class="wl-lock-state" aria-label="' + (p.locked ? 'ล็อกแล้ว' : (p.online ? 'กำลังทาย' : 'หลุด')) + '">' + (p.locked ? '✓' : (p.online ? '' : 'หลุด')) + '</span></span>').join('');
  }

  function bandClass(points) { return points === 4 ? 'p4' : (points === 3 ? 'p3' : (points === 2 ? 'p2' : '')); }
  function renderResults(animate) {
    const box = document.getElementById('wlResults');
    const lr = S.lastRound;
    if (S.phase !== 'reveal' || !lr) { box.hidden = true; box.innerHTML = ''; return; }
    box.hidden = false;
    if (lr.skipped) {
      box.innerHTML = '<div class="wl-skip"><strong>ข้ามรอบ</strong><span>' + esc(lr.reason || '') + ' · ไม่มีใครได้แต้ม</span></div>';
      return;
    }
    const giver = playerById(lr.giverId) || { name: lr.giverName };
    const rows = (lr.results || []).map(function(r, i) {
      const sub = r.pin == null ? 'ไม่ได้ทาย' : (r.label + (r.auto ? ' · ล็อกอัตโนมัติ' : '') + ' · ห่างเป้า ' + Math.round(r.distance));
      return '<div class="wl-row' + (r.playerId === playerId ? ' is-me' : '') + '">' + avatarHtml(r, 28) +
        '<span class="wl-row-name">' + esc(r.playerId === playerId ? 'คุณ' : r.name) + '</span>' +
        '<span class="wl-pts ' + bandClass(r.points) + (animate ? ' is-pop' : '') + '" style="--d:' + (1300 + i * 110) + 'ms">+' + r.points + '</span>' +
        '<span class="wl-row-sub">' + esc(sub) + '</span></div>';
    }).join('');
    box.innerHTML = '<div class="wl-results-head"><h2>ผลรอบ ' + lr.round + '</h2><span class="wl-results-sub">เป้าอยู่ที่ ' + lr.target + '/100</span></div>' + rows +
      '<div class="wl-row' + (lr.giverId === playerId ? ' is-me' : '') + '">' + avatarHtml(giver, 28) +
        '<span class="wl-row-name">' + esc(lr.giverId === playerId ? 'คุณ' : (giver.name || 'ผู้ใบ้')) + ' (ผู้ใบ้)</span>' +
        '<span class="wl-pts giver' + (animate ? ' is-pop' : '') + '" style="--d:' + (1400 + (lr.results || []).length * 110) + 'ms">+' + lr.giverPoints + '</span>' +
        '<span class="wl-row-sub">เฉลี่ยแต้มของคนทาย</span></div>';
  }

  function renderBoard() {
    const rows = S.scoreboard || [];
    const lr = S.phase === 'reveal' ? S.lastRound : null;
    const gained = {};
    if (lr && !lr.skipped) {
      (lr.results || []).forEach(r => { gained[r.playerId] = r.points; });
      gained[lr.giverId] = lr.giverPoints;
    }
    let rank = 0, prev = null;
    const html = rows.map(function(r, i) {
      if (r.score !== prev) { rank = i + 1; prev = r.score; }
      const g = gained[r.playerId];
      return '<div class="wl-score' + (r.playerId === playerId ? ' is-me' : '') + (r.playerId === S.giverId && S.phase !== 'finished' ? ' is-giver' : '') + '">' +
        '<span class="wl-score-rank">' + (r.playerId === S.giverId && S.phase !== 'finished' ? '📡' : rank) + '</span>' + avatarHtml(r, 28) +
        '<span class="wl-score-name">' + esc(r.name) + (r.playerId === playerId ? ' <small>(คุณ)</small>' : '') + (r.left ? ' <small>· ออกแล้ว</small>' : '') + '</span>' +
        '<span class="wl-score-val">' + r.score + (g ? '<em>+' + g + '</em>' : '') + '</span></div>';
    }).join('');
    const pendingPlayers = (S.players || []).filter(p => !p.active);
    $('#wlBoard').html('<h2>คะแนน</h2>' + (html || '<p class="wl-hint" style="text-align:left">ยังไม่มีคะแนน</p>') +
      (pendingPlayers.length ? '<p class="wl-hint" style="text-align:left; margin:6px 0 0;">' + (S.phase === 'clue' ? 'เข้าร่วมเมื่อผู้ใบ้ส่งคำใบ้: ' : 'รอเข้าร่วมรอบหน้า: ') + pendingPlayers.map(p => esc(p.name)).join(', ') + '</p>' : ''));
  }

  function renderFinal(animate) {
    const box = document.getElementById('wlFinal');
    if (S.phase !== 'finished') { box.innerHTML = ''; return; }
    const st = S.standings || [];
    const winners = S.winners || [];
    const title = winners.length
      ? (winners.length > 1 ? 'ชนะร่วม! ' : '') + winners.map(w => esc(w.name)).join(', ') + ' · ' + winners[0].score + ' แต้ม'
      : 'จบเกม — ยังไม่มีใครทำแต้ม';
    const top = [st[1], st[0], st[2]];
    const cls = ['r2', 'r1', 'r3'];
    const podium = '<div class="wl-podium">' + top.map(function(r, i) {
      if (!r) return '<div class="wl-step ' + cls[i] + ' is-empty"></div>';
      return '<div class="wl-step ' + cls[i] + (animate ? ' is-rise' : '') + '" style="--d:' + ([300, 600, 0][i]) + 'ms">' +
        (r.rank === 1 && r.score > 0 ? '<span class="wl-crown" aria-hidden="true">👑</span>' : '') +
        avatarHtml(r, 40) + '<span class="wl-step-name">' + esc(r.playerId === playerId ? 'คุณ' : r.name) + '</span>' +
        '<span class="wl-step-score">' + r.score + ' แต้ม</span>' +
        '<div class="wl-step-block">' + r.rank + '</div></div>';
    }).join('') + '</div>';
    const list = st.map(r => '<div class="wl-score' + (r.playerId === playerId ? ' is-me' : '') + '">' +
      '<span class="wl-score-rank">' + r.rank + '</span>' + avatarHtml(r, 28) +
      '<span class="wl-score-name">' + esc(r.name) + (r.left ? ' <small>· ออกแล้ว</small>' : '') + (r.bullseyes ? ' <small>· เป๊ะ ' + r.bullseyes + ' ครั้ง</small>' : '') + '</span>' +
      '<span class="wl-score-val">' + r.score + '</span></div>').join('');
    const recap = (S.rounds || []).map(x =>
      '<div class="wl-recap-row"><strong>รอบ ' + x.round + '</strong> · ' + esc(x.giverName || 'ผู้ใบ้') + ' ใบ้ <strong>“' + esc(x.clue || '') + '”</strong>' +
        '<span class="wl-recap-meta">' + (x.card ? esc(x.card.left) + ' ↔ ' + esc(x.card.right) + ' · ' : '') + 'เป้า ' + x.target + ' · ผู้ใบ้ +' + x.giverPoints +
        (x.best && x.best.points ? ' · ใกล้สุด ' + esc(x.best.name) + ' +' + x.best.points : '') + '</span></div>').join('');
    box.innerHTML = '<p class="wl-final-title">' + title + '</p>' + podium + list +
      (recap ? '<details class="wl-recap"><summary>ย้อนดูทีละรอบ (' + (S.rounds || []).length + ')</summary>' + recap + '</details>' : '');
  }

  function renderDock() {
    const a = S.availableActions || {};
    const self = S.self || {};
    let html = '';
    if (S.phase === 'finished') {
      html = '<div class="wl-row-btns">' +
        '<button type="button" id="wlShareBtn" class="wl-btn">แชร์ผล</button>' +
        '<button type="button" id="wlBackBtn" class="wl-btn wl-btn--primary">กลับห้องรอ</button>' +
        '</div><div class="wl-hint" id="wlBackRemain" style="margin-top:6px;">ทุกคนกลับห้องรอพร้อมกัน</div>';
    } else if (S.phase === 'clue' && self.isGiver) {
      if (draftRound !== S.round) { draftRound = S.round; draftClue = loadDraft(S.round); }
      const problem = draftClue ? clueProblem(draftClue, S.card) : '';
      // พิมพ์ร่างได้ตั้งแต่ยังไม่เลือกการ์ด (คิดไปพร้อมกัน) — แต่ส่งได้เมื่อเลือกการ์ดแล้ว
      const msg = problem || (draftClue && !S.card ? 'เลือกการ์ดด้านบนก่อน แล้วค่อยส่ง' : '');
      html = '<div class="wl-clue-form">' +
        '<label class="wl-hint" for="wlClueInput" style="text-align:left;">' + (S.card ? 'คำใบ้ 1 คำหรือวลีสั้น ๆ (ห้ามคำบนการ์ด · ห้ามตัวเลข)' : 'เลือกการ์ดด้านบน 1 ใบ แล้วพิมพ์คำใบ้') + '</label>' +
        '<div class="wl-input-row"><input id="wlClueInput" class="wl-input' + (problem ? ' is-bad' : '') + '" type="text" autocomplete="off" enterkeyhint="send" maxlength="80" placeholder="เช่น ไอติม" value="' + esc(draftClue) + '">' +
        '<button type="button" id="wlClueBtn" class="wl-btn wl-btn--primary"' + (a.canSubmitClue && draftClue.trim() && !problem ? '' : ' disabled') + '>ส่งคำใบ้</button></div>' +
        '<div class="wl-clue-foot"><div id="wlClueMsg" class="wl-hint' + (msg ? ' is-error' : '') + '">' + (msg ? esc(msg) : '<span class="wl-counter">' + glen(draftClue.trim()) + '/' + (S.maxClueLength || 40) + '</span>') + '</div>' +
        (a.canSkipTurn ? '<button type="button" id="wlPassBtn" class="wl-btn wl-btn--ghost wl-btn--sm">คิดไม่ออก ข้ามตา</button>' : '') + '</div></div>';
    } else if (S.phase === 'guess' && self.isGuesser) {
      const done = (S.players || []).filter(p => p.isGuesser && p.locked).length;
      const total = (S.players || []).filter(p => p.isGuesser).length;
      const warn = centerWarnRound === S.round;
      html = a.canGuess
        ? '<div class="wl-guess-row">' +
            '<button type="button" class="wl-btn wl-nudge" data-step="-1" aria-label="ขยับเข็มไปทางซ้าย 1 ช่อง">‹</button>' +
            '<button type="button" id="wlLockBtn" class="wl-btn wl-btn--primary wl-btn--big' + (warn ? ' wl-btn--warn' : '') + '">' + (warn ? 'ล็อกตรงกลางเลย' : 'ล็อกคำตอบ') + '</button>' +
            '<button type="button" class="wl-btn wl-nudge" data-step="1" aria-label="ขยับเข็มไปทางขวา 1 ช่อง">›</button></div>' +
          '<div class="wl-hint' + (warn ? ' is-error' : '') + '" style="margin-top:6px;">' + (warn ? 'ยังไม่ได้ขยับเข็ม — ลากเข็มก่อน หรือกดอีกครั้งเพื่อล็อกตรงกลาง' : 'ล็อกแล้ว ' + done + '/' + total + ' คน · ‹ › ขยับทีละนิด') + '</div>'
        : '<div class="wl-row-btns"><div class="wl-dock-wait" style="flex:2 1 0;">ล็อกแล้ว ✓ รอเพื่อน ' + done + '/' + total + '</div>' +
          (a.canUnlock ? '<button type="button" id="wlUnlockBtn" class="wl-btn wl-btn--ghost wl-btn--sm">แก้คำตอบ</button>' : '') + '</div>';
    } else if (S.phase === 'reveal') {
      // ต้องพร้อมครบ = ทุกคนที่ออนไลน์ยกเว้นหัวห้อง (หัวห้องกด "รอบต่อไป" = ไปเลย)
      const needed = S.readyNeeded || [];
      const ready = (S.readyIds || []).filter(id => needed.includes(id)).length;
      const total = needed.length;
      if (a.canNext) html = '<button type="button" id="wlNextBtn" class="wl-btn wl-btn--primary wl-btn--big" style="width:100%;">รอบต่อไป</button>' +
        '<div class="wl-hint" style="margin-top:6px;">' + (total ? 'เพื่อนพร้อม ' + ready + '/' + total + ' คน · พร้อมครบ = ไปต่อเอง' : 'กดเมื่อทุกคนดูผลเสร็จ') + '</div>';
      else if (a.canReady) html = '<button type="button" id="wlReadyBtn" class="wl-btn wl-btn--primary wl-btn--big" style="width:100%;">พร้อมไปรอบต่อไป</button><div class="wl-hint" style="margin-top:6px;">พร้อมครบ ' + total + ' คน หรือหัวห้องกด = ไปต่อทันที · พร้อมแล้ว ' + ready + '/' + total + '</div>';
      else if (self.active) html = '<div class="wl-dock-wait">พร้อมแล้ว ✓ รอเพื่อน ' + ready + '/' + total + '</div>';
      else html = '<div class="wl-dock-wait">รอบหน้าคุณได้เล่นด้วย — รอเพื่อนดูผล</div>';
    } else if (S.phase === 'clue') {
      html = '<div class="wl-dock-wait">รอคำใบ้จาก ' + esc(S.giverName || 'ผู้ใบ้') + '…</div>';
    } else if (S.phase === 'guess') {
      html = '<div class="wl-dock-wait">' + (self.isGiver ? 'เพื่อนกำลังทาย — คุณได้แต้มตามค่าเฉลี่ย' : 'ดูเพื่อนทาย — รอบหน้าคุณได้เล่น') + '</div>';
    }
    const dock = document.getElementById('wlDock');
    const input = document.getElementById('wlClueInput');
    const hadFocus = input && document.activeElement === input;
    const caret = hadFocus ? input.selectionStart : null;
    dock.innerHTML = html;
    if (hadFocus) {
      const next = document.getElementById('wlClueInput');
      if (next && !next.disabled) { next.focus(); try { next.setSelectionRange(caret, caret); } catch (e) { /* ignore */ } }
    }
    const finished = S.phase === 'finished';
    $('#wlDock').toggleClass('is-static', finished);
    $('#wlRoot').toggleClass('is-finished', finished);
    if (finished && !$('#wlNow').next().is('#wlDock')) $('#wlDock').insertAfter('#wlNow');
    syncDockHeight();
  }

  function renderFeed() {
    $('#wlFeed').html((S.history || []).slice(0, 14).map(item =>
      '<div class="wl-feed-item">' + esc((item.icon || '') + ' ' + (item.text || '')) + '</div>').join(''));
  }

  function syncDockHeight() {
    const dock = document.getElementById('wlDock');
    const h = dock && !dock.classList.contains('is-static') && dock.innerHTML ? Math.round(dock.getBoundingClientRect().height) : 0;
    document.documentElement.style.setProperty('--wl-dock-h', h + 'px');
  }
  if (window.ResizeObserver) new ResizeObserver(syncDockHeight).observe(document.getElementById('wlDock'));
  // iOS: คีย์บอร์ดไม่ย่อ layout viewport — dock ที่ fixed ล่างจอจะจมใต้คีย์บอร์ด ยกขึ้นตาม visualViewport
  function syncKeyboard() {
    const vv = window.visualViewport;
    const dock = document.getElementById('wlDock');
    if (!vv || !dock) return;
    const overlap = dock.classList.contains('is-static') ? 0 : Math.max(0, Math.round(window.innerHeight - vv.height - vv.offsetTop));
    dock.style.transform = overlap > 40 ? 'translateY(' + (-overlap) + 'px)' : '';
  }
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', syncKeyboard);
    window.visualViewport.addEventListener('scroll', syncKeyboard);
  }

  // ---------- fx ----------
  function banner(text, tone) {
    const node = document.getElementById('wlBanner');
    node.textContent = text;
    node.className = 'wl-banner' + (tone ? ' is-' + tone : '');
    void node.offsetWidth;
    node.classList.add('is-on');
  }
  function consumeFx(initial) {
    const events = (S.fx || []).filter(e => e && e.seq > seenFx);
    if (!events.length) return { reveal: false };
    seenFx = events[events.length - 1].seq;
    if (initial) return { reveal: false };
    let reveal = false;
    events.forEach(function(e) {
      if (e.kind === 'round') {
        if (e.giverId === playerId) { banner('ตาคุณใบ้!', 'gold'); }
        else banner('รอบ ' + e.round + ' · ' + (nameOf(e.giverId) || 'ผู้ใบ้') + ' ใบ้');
      } else if (e.kind === 'clue') {
        haptic([10, 30, 10]);
      } else if (e.kind === 'lock') {
        const chip = document.querySelector('.wl-lock[data-lock-id="' + e.playerId + '"]');
        if (chip && !reduceMotion) { chip.classList.remove('is-pulse'); void chip.offsetWidth; chip.classList.add('is-pulse'); }
      } else if (e.kind === 'reveal') {
        reveal = true;
      } else if (e.kind === 'skip') {
        banner('ข้ามรอบ', 'coral');
      } else if (e.kind === 'finished') {
        banner('จบเกม!', 'gold');
        haptic([20, 50, 20, 50, 40]);
      }
    });
    return { reveal };
  }
  function revealCelebrate() {
    const lr = S.lastRound;
    if (!lr || lr.skipped) return;
    const mine = (lr.results || []).find(r => r.playerId === playerId);
    setTimeout(function() {
      if (mine) {
        if (mine.points === 4) { banner('เป๊ะ! +4', 'gold'); haptic([20, 40, 20, 40, 30]); }
        else if (mine.points > 0) { banner(mine.label + ' +' + mine.points); haptic([16, 30, 16]); }
        else { banner(mine.pin == null ? 'ไม่ได้ทาย' : 'พลาด', 'coral'); haptic(12); }
      } else if (lr.giverId === playerId) {
        banner('คุณได้ +' + lr.giverPoints, lr.giverPoints >= 3 ? 'gold' : '');
        haptic([16, 30, 16]);
      }
    }, reduceMotion ? 0 : 1500);
  }

  function pingNeed() {
    if (!window.partyPlay) return;
    const a = S.availableActions || {};
    if (S.phase === 'clue' && a.canPickCard) window.partyPlay.pingTurn({ key: 'wl-clue-' + S.round, title: 'ตาคุณใบ้', subtitle: 'เลือกการ์ด แล้วพิมพ์คำใบ้' });
  }

  function tickTimer() {
    if (timerHandle) clearInterval(timerHandle);
    const total = S.timers ? ({ clue: S.giverAway ? S.timers.grace : S.timers.clue, guess: S.timers.guess, reveal: (S.lastRound && S.lastRound.skipped) ? S.timers.skip : S.timers.reveal })[S.phase] : 0;
    function paint() {
      if (S.phase === 'finished') {
        const endsAt = Number(S.returnLobbyEndsAt) || 0;
        const remain = endsAt ? Math.max(0, Math.ceil((endsAt - now()) / 1000)) : 0;
        $('#wlNowSec').text(remain > 0 ? remain : '--');
        $('#wlNowHint').text(remain > 0 ? 'วิ แล้วกลับห้องรอ' : '');
        $('#wlBackRemain').text(remain > 0 ? 'กลับห้องรอพร้อมกันใน ' + remain + ' วิ' : 'ทุกคนกลับห้องรอพร้อมกัน');
        $('#wlNowBar').css('transform', 'scaleX(0)');
        return;
      }
      if (!S.phaseEndsAt) {
        $('#wlNowSec').text('--');
        $('#wlNowBar').css('transform', 'scaleX(0)');
        return;
      }
      const ms = Math.max(0, S.phaseEndsAt - now());
      const remain = Math.ceil(ms / 1000);
      $('#wlNowSec').text(remain);
      $('#wlNow').toggleClass('is-urgent', remain <= 10 && (S.phase === 'clue' || S.phase === 'guess') && !!describeNow().mine);
      const frac = total ? Math.max(0, Math.min(1, ms / total)) : 0;
      $('#wlNowBar').css('transform', 'scaleX(' + frac.toFixed(3) + ')');
    }
    paint();
    timerHandle = setInterval(paint, 250);
  }

  // เข้าเฟสทาย/เปิดเป้าแล้วหน้าปัดอยู่นอกจอ (แนวนอน/จอเตี้ย) — เลื่อนให้เห็นเอง ครั้งเดียวต่อเฟส
  let dialScrollKey = '';
  function revealDialIfHidden() {
    const key = S.round + ':' + S.phase;
    if (key === dialScrollKey) return;
    dialScrollKey = key;
    if (!(S.phase === 'guess' || S.phase === 'reveal')) return;
    const wrap = document.getElementById('wlDialWrap');
    const dock = document.getElementById('wlDock');
    const active = document.activeElement;
    if (!wrap || (active && active.tagName === 'INPUT')) return;
    // ให้เห็นคำใบ้ + หน้าปัดพร้อมกันถ้าพอ ไม่พอก็เอาหน้าปัด
    const d = wrap.getBoundingClientRect();
    const clue = document.getElementById('wlClue');
    const c = clue && !clue.hidden ? clue.getBoundingClientRect() : null;
    const limit = window.innerHeight - (dock && !dock.classList.contains('is-static') ? dock.getBoundingClientRect().height : 0);
    const r = c && d.bottom - c.top <= limit - 8 ? { top: c.top, bottom: d.bottom, height: d.bottom - c.top } : d;
    if (r.bottom <= limit + 1 && r.top >= 0) return;
    const delta = r.height > limit ? r.top - 8 : r.bottom - limit + 8;
    window.scrollBy({ top: delta, behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  function render(state) {
    if (!state || !state.mode) return;
    S = state;
    if (S.serverNow) clockOffset = S.serverNow - Date.now();
    const fx = consumeFx(firstRender);
    const revealAnim = fx.reveal && !firstRender && S.phase === 'reveal' && S.lastRound && !S.lastRound.skipped && lastRevealRound !== S.lastRound.round;
    if (S.phase === 'reveal' && S.lastRound) lastRevealRound = S.lastRound.round;
    renderTop();
    renderOptions();
    renderSpectrum();
    renderDial(revealAnim);
    renderLocks();
    renderResults(revealAnim);
    renderBoard();
    const finalAnim = !firstRender && !finalAnimated && S.phase === 'finished';
    if (S.phase === 'finished') finalAnimated = true;
    renderFinal(finalAnim);
    renderDock();
    renderFeed();
    tickTimer();
    pingNeed();
    revealDialIfHidden();
    if (revealAnim) revealCelebrate();
    firstRender = false;
  }

  // ---------- commands ----------
  function toastError(msg) {
    Swal.fire({ toast: true, position: 'top', icon: 'error', title: msg || 'ทำรายการไม่สำเร็จ', showConfirmButton: false, timer: 2400, background: '#13213a', color: '#fff' });
  }
  function send(eventName, payload, after) {
    if (pending) return;
    pending = true;
    $('#wlDock button, #wlOptions button').prop('disabled', true);
    socket.emit(eventName, Object.assign({ roomId: roomId, round: S.round, phase: S.phase }, payload || {}), function(res) {
      pending = false;
      if (res && !res.success) {
        toastError(res.error);
        socket.emit('wavelength_requestState', { roomId: roomId, playerId: playerId });
      } else if (typeof after === 'function') {
        after();
      }
      renderOptions();
      renderDock();
    });
    setTimeout(function() { pending = false; }, 6000);
  }
  function lockNow() {
    if (!canDrag()) return;
    const self = S.self || {};
    if (touchedRound !== S.round && self.pin == null && centerWarnRound !== S.round) {
      centerWarnRound = S.round;
      haptic(12);
      renderDock();
      return;
    }
    centerWarnRound = 0;
    clearTimeout(sendTimer);
    needleEl.classList.add('is-locked');
    if (!reduceMotion) { wobbleEl.classList.remove('is-clunk'); void wobbleEl.getBoundingClientRect(); wobbleEl.classList.add('is-clunk'); }
    haptic([12, 30, 18]);
    send('wavelength_lock', { value: myPin });
  }
  $(document).on('click', '.wl-option', function() {
    const idx = Number(this.getAttribute('data-index'));
    haptic(8);
    send('wavelength_pickCard', { index: idx });
  });
  $(document).on('click', '#wlRerollBtn', function() { send('wavelength_reroll'); });
  $(document).on('input', '#wlClueInput', function() {
    draftClue = this.value;
    saveDraft();
    const problem = draftClue ? clueProblem(draftClue, S.card) : '';
    const msg = problem || (draftClue && !S.card ? 'เลือกการ์ดด้านบนก่อน แล้วค่อยส่ง' : '');
    $(this).toggleClass('is-bad', !!problem);
    $('#wlClueBtn').prop('disabled', !draftClue.trim() || !!problem || !(S.availableActions || {}).canSubmitClue);
    $('#wlClueMsg').toggleClass('is-error', !!msg)
      .html(msg ? esc(msg) : '<span class="wl-counter">' + glen(draftClue.trim()) + '/' + (S.maxClueLength || 40) + '</span>');
  });
  function submitClue() {
    const text = (document.getElementById('wlClueInput') || {}).value || '';
    if (!S.card) { toastError('เลือกการ์ดด้านบนก่อน'); return; }
    const problem = clueProblem(text, S.card);
    if (problem) { toastError(problem); return; }
    send('wavelength_clue', { text: text }, function() { draftClue = ''; saveDraft(); });
  }
  $(document).on('click', '.wl-nudge', function() {
    if (!canDrag()) return;
    const step = Number(this.getAttribute('data-step')) || 0;
    onPinChange(Math.max(0, Math.min(100, Math.round(myPin) + step)), false);
    haptic(4);
  });
  function confirmSkip(title, text, confirmText) {
    Swal.fire({ icon: 'question', title: title, text: text, showCancelButton: true, confirmButtonText: confirmText, cancelButtonText: 'ยกเลิก', background: '#13213a', color: '#fff', confirmButtonColor: '#0f766e' })
      .then(r => { if (r.isConfirmed) send('wavelength_skip'); });
  }
  $(document).on('click', '#wlPassBtn', function() {
    confirmSkip('ข้ามตาใบ้ของคุณ?', 'รอบนี้จะไม่มีใครได้แต้ม แล้วไปผู้ใบ้คนถัดไป', 'ข้ามตา');
  });
  $('#wlSkipBtn').on('click', function() {
    if (S.phase === 'guess') {
      const done = (S.players || []).filter(p => p.isGuesser && p.locked).length;
      const total = (S.players || []).filter(p => p.isGuesser).length;
      confirmSkip('เปิดเป้าเลยไหม?', 'ล็อกแล้ว ' + done + '/' + total + ' คน · คนที่ยังไม่ล็อก จะล็อกตรงที่เข็มอยู่ตอนนี้', 'เปิดเป้า');
    } else {
      confirmSkip('ข้ามตา ' + (S.giverName || 'ผู้ใบ้') + '?', 'รอบนี้จะไม่มีใครได้แต้ม แล้วไปผู้ใบ้คนถัดไป', 'ข้ามตา');
    }
  });
  $(document).on('keydown', '#wlClueInput', function(e) { if (e.key === 'Enter') { e.preventDefault(); submitClue(); } });
  $(document).on('click', '#wlClueBtn', submitClue);
  $(document).on('click', '#wlLockBtn', lockNow);
  $(document).on('click', '#wlUnlockBtn', function() { send('wavelength_unlock'); });
  $(document).on('click', '#wlNextBtn, #wlReadyBtn', function() { haptic(8); send('wavelength_next'); });
  // ไม่ใช่หัวห้อง = server ไม่พาทั้งวงกลับ (canReturnSelf) → กลับห้องเฉพาะตัวเอง
  $(document).on('click', '#wlBackBtn', function() { socket.emit('returnFinishedToLobby', { roomId: roomId }, function(res) { if (res && res.canReturnSelf) { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; } }); });
  $(document).on('click', '#wlShareBtn', function() {
    if (!window.partyPlay || !S.standings) return;
    const w = S.winners || [];
    window.partyPlay.shareResult({
      mode: 'คลื่นความคิด',
      headline: w.length ? w.map(x => x.name).join(', ') + ' ชนะ' : 'จบเกมคลื่นความคิด',
      sub: S.round + ' รอบ · ' + (S.standings || []).length + ' คน',
      lines: S.standings.slice(0, 6).map(r => r.rank + '. ' + r.name + ' ' + r.score + ' แต้ม'),
      accent: '#5eead4',
      fileName: 'wavelength-result'
    });
  });
  $('#wlEndBtn').on('click', function() {
    Swal.fire({
      icon: 'warning', title: 'จบเกมเลยไหม?', text: 'สรุปคะแนนตอนนี้แล้วกลับห้องรอ',
      showCancelButton: true, confirmButtonText: 'จบเกม', cancelButtonText: 'เล่นต่อ', background: '#13213a', color: '#fff', confirmButtonColor: '#0f766e'
    }).then(r => { if (r.isConfirmed) send('wavelength_end'); });
  });

  // ---------- guide ----------
  function howToHtml() {
    return '<div class="wl-guide">' +
      '<h4>1. ผู้ใบ้เลือกการ์ด</h4><p>การ์ดเป็นคำตรงข้าม เช่น <b>ร้อน ↔ เย็น</b> เลือก 1 จาก 2 ใบ (สุ่มใหม่ได้ 1 ครั้ง) แล้วเห็นเป้าลับบนหน้าปัดคนเดียว</p>' +
      '<h4>2. ใบ้ 1 คำ</h4><p>พิมพ์คำที่อยู่ตรงเป้า เช่น เป้าค่อนไปทางเย็น → “ไอติม” · ห้ามใช้คำบนการ์ด ห้ามตัวเลข · 60 วิ ไม่ทัน = ข้ามรอบ · คิดไม่ออกกด <b>ข้ามตา</b> ได้</p>' +
      '<h4>3. หมุนเข็มทาย</h4><p>ลากเข็มของคุณไปตรงที่คิดว่าใช่ แล้วกด <b>ล็อกคำตอบ</b> (45 วิ) · ปุ่ม ‹ › ขยับทีละนิด · เพื่อนเห็นว่าคุณล็อกแล้ว แต่ไม่เห็นว่าล็อกตรงไหน · ล็อกครบทุกคน = เปิดเป้าทันที</p>' +
      '<h4>4. เปิดเป้า</h4><p>เป๊ะ 4 · ใกล้มาก 3 · เฉียด 2 แต้ม · ผู้ใบ้ได้ค่าเฉลี่ยแต้มของเพื่อน — ใบ้ดี ได้กันทั้งวง · ดูผลเสร็จกด <b>พร้อม</b> ครบทุกคน = ไปรอบต่อไปเลย</p>' +
      '<h4>ชนะ</h4><p>ทุกคนได้ใบ้ครบรอบโต๊ะ แล้วแต้มรวมสูงสุดชนะ (เสมอ = ชนะร่วม)</p>' +
      '</div>';
  }
  $('#wlHowBtn').on('click', function() {
    Swal.fire({ title: 'คลื่นความคิด เล่นยังไง', html: howToHtml(), background: '#13213a', color: '#fff', confirmButtonText: 'เข้าใจแล้ว', confirmButtonColor: '#0f766e', width: 'min(520px, 94vw)' });
  });

  // ---------- sidebar ----------
  function setSidebarOpen(open) {
    if (open && $('#chatBox').is(':visible')) $('#closeChat').trigger('click');
    $('#playerSidebar').toggleClass('open', open).attr('aria-hidden', open ? 'false' : 'true');
    $('#sidebarOverlay').toggle(open);
    $('#wlSidebarBtn').attr('aria-expanded', open ? 'true' : 'false');
    if (open) document.getElementById('closeSidebarBtn').focus();
  }
  $('#wlSidebarBtn').on('click', function() { setSidebarOpen(!$('#playerSidebar').hasClass('open')); });
  $('#closeSidebarBtn, #sidebarOverlay').on('click', function() { setSidebarOpen(false); });
  $(document).on('keydown', function(e) { if (e.key === 'Escape' && $('#playerSidebar').hasClass('open')) setSidebarOpen(false); });
  $('#leaveRoomBtn').on('click', function() {
    Swal.fire({ icon: 'question', title: 'ออกจากห้อง?', text: 'แต้มของคุณในเกมนี้จะหยุดนับ', showCancelButton: true, confirmButtonText: 'ออก', cancelButtonText: 'อยู่ต่อ', background: '#13213a', color: '#fff' })
      .then(r => {
        if (!r.isConfirmed) return;
        allowNavigation = true;
        socket.emit('leaveRoom', {}, function() { window.location.href = '/rooms?playerId=' + playerId; });
      });
  });
  window.addEventListener('beforeunload', function(e) { if (!allowNavigation) e.preventDefault(); });

  // ---------- socket ----------
  socket.on('connect', function() {
    $('#connectionStatus').hide();
    socket.emit('initPlayer', playerId);
    socket.emit('setRoom', { roomId: roomId, playerId: playerId });
    socket.emit('wavelength_requestState', { roomId: roomId, playerId: playerId });
  });
  socket.on('disconnect', function() { $('#connectionStatus').show(); });
  socket.on('wavelengthState', render);
  socket.on('roomUpdate', function(data) {
    if (!data || !data.players) return;
    $('#onlinePlayerList').html(data.players.map(p =>
      '<li style="display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid oklch(1 0 0 / 0.08); min-width:0;">' +
        avatarHtml({ avatar: p.avatar, avatarFrame: p.avatarFrame, color: p.color, name: p.displayName || p.playerName }, 26) +
        '<span style="color:' + esc(p.color || '#fff') + '; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">' + esc(p.displayName || p.playerName) + '</span>' +
        (p.online === false ? '<span style="margin-left:auto; font-size:0.78rem; color:oklch(0.74 0.03 250);">หลุด</span>' : '') +
      '</li>').join(''));
  });
  socket.on('redirectToLobby', function() { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; });
  socket.on('returnToLobby', function(data) {
    S.returnLobbyEndsAt = Number(data && data.endsAt) || (now() + (Number(data && data.countdown) || 10) * 1000);
    tickTimer();
  });
  socket.on('restartGame', function() { allowNavigation = true; window.location.href = '/room/' + roomId + '?playerId=' + playerId; });
  socket.on('gameStarting', function() { allowNavigation = true; window.location.href = '/game/' + roomId + '?playerId=' + playerId; });
  socket.on('kickedFromRoom', function(data) {
    allowNavigation = true;
    Swal.fire({ icon: 'error', title: 'ถูกเตะออกจากห้อง', text: (data && (data.reason || data.message)) || '', background: '#13213a', color: '#fff' })
      .then(() => { window.location.href = '/rooms?playerId=' + playerId; });
  });

  window.initChatPanel({ socket: socket, playerId: playerId, playerName: playerName });

  applyNeedle();
  if (S && S.mode) render(S);
});
</script>

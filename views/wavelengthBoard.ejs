<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@400;500;600;700&family=Chakra+Petch:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/chatPanel.css">
<style>
  html.wl-active,
  html.wl-active body.content {
    overflow-x: hidden;
    margin: 0 !important;
    padding: 0 !important;
    background: oklch(0.17 0.035 255) !important;
  }
  html.wl-active .container-fluid > header,
  html.wl-active .footer,
  html.wl-active #music-controls { display: none !important; }
  html.wl-active, html.wl-active .container-fluid, html.wl-active .container-fluid > .row { background: oklch(0.17 0.035 255) !important; background-image: none !important; }
  html.wl-active .container-fluid { padding: 0 !important; margin: 0 !important; max-width: none !important; }
  html.wl-active .container-fluid > .row { margin: 0 !important; }
  html.wl-active .col-lg-12 { padding: 0 !important; }

  .wl {
    --wl-bg: oklch(0.17 0.035 255);
    --wl-surface: oklch(0.21 0.04 255);
    --wl-surface-2: oklch(0.26 0.045 255);
    --wl-line: oklch(0.85 0.1 185 / 0.2);
    --wl-line-soft: oklch(1 0 0 / 0.09);
    --wl-ink: oklch(0.97 0.01 240);
    --wl-soft: oklch(0.86 0.02 240);
    --wl-muted: oklch(0.73 0.03 245);
    --wl-gold: oklch(0.84 0.13 85);
    --wl-teal: oklch(0.85 0.12 182);
    --wl-teal-deep: oklch(0.55 0.1 190);
    --wl-coral: oklch(0.75 0.15 32);
    --wl-band2: oklch(0.83 0.13 88);
    --wl-band3: oklch(0.73 0.15 40);
    --wl-band4: oklch(0.82 0.13 182);
    --wl-win: oklch(0.84 0.15 160);
    --wl-miss: oklch(0.72 0.05 250);
    --wl-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --wl-spring: cubic-bezier(0.25, 1.35, 0.4, 1);
    --wl-display: 'Chakra Petch', 'Bai Jamjuree', sans-serif;

    max-width: 760px;
    margin: 0 auto;
    padding: 8px 16px calc(var(--wl-dock-h, 160px) + 20px);
    color: var(--wl-ink);
    font-family: 'Bai Jamjuree', sans-serif;
    font-size: 1rem;
    line-height: 1.45;
    text-align: left;
  }
  body.content { background: var(--wl-bg, oklch(0.17 0.035 255)); }
  .wl *, .wl *::before, .wl *::after { box-sizing: border-box; }
  .wl button, .wl input { font-family: inherit; }
  .wl h1, .wl h2, .wl h3, .wl p { overflow-wrap: anywhere; }

  /* ---------- top ---------- */
  .wl-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px 12px; padding: 6px 0 10px; }
  .wl-top > :first-child { padding-right: 104px; min-width: 0; } /* เว้นที่ให้ปุ่มแชทมุมขวาบน */
  .wl-kicker { color: var(--wl-teal); font-family: var(--wl-display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; }
  .wl-title { margin: 0; font-family: var(--wl-display); font-weight: 700; font-size: clamp(1.1rem, 4.4vw, 1.5rem); line-height: 1.2; }
  .wl-tools { display: flex; flex-wrap: wrap; gap: 6px; }
  .wl-pill {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px;
    border-radius: 999px; border: 1px solid var(--wl-line); background: var(--wl-surface);
    color: var(--wl-ink); font-size: 0.86rem; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .wl-pill:hover { background: var(--wl-surface-2); }
  .wl-pill--danger { color: oklch(0.85 0.08 25); border-color: oklch(0.7 0.14 25 / 0.45); }
  .wl-pill:focus-visible, .wl-btn:focus-visible, .wl-option:focus-visible, .wl-input:focus-visible { outline: 2px solid var(--wl-gold); outline-offset: 2px; }

  /* ---------- now bar ---------- */
  .wl-now {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2px 12px;
    padding: 10px 14px 12px; border-radius: 16px; background: var(--wl-surface); border: 1px solid var(--wl-line-soft);
  }
  .wl-now.is-mine { background: oklch(0.3 0.06 185 / 0.55); border-color: var(--wl-teal); }
  .wl-now-phase { font-family: var(--wl-display); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; color: var(--wl-teal); }
  .wl-now-copy { grid-column: 1; font-size: 1.04rem; font-weight: 700; line-height: 1.3; min-width: 0; }
  .wl-now-timer { grid-column: 2; grid-row: 1 / span 2; text-align: right; }
  .wl-now-sec { font-family: var(--wl-display); font-size: 1.6rem; font-weight: 700; color: var(--wl-gold); font-variant-numeric: tabular-nums; line-height: 1; }
  .wl-now-hint { display: block; font-size: 0.7rem; color: var(--wl-muted); margin-top: 3px; max-width: 120px; }
  .wl-now-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--wl-teal); transform-origin: left center; transform: scaleX(0); }
  .wl-now.is-urgent .wl-now-bar { background: var(--wl-coral); }
  .wl-now.is-urgent .wl-now-sec { color: var(--wl-coral); }

  /* ---------- stage ---------- */
  .wl-stage {
    position: relative; margin-top: 10px; padding: 14px 12px 12px; border-radius: 26px;
    background:
      radial-gradient(ellipse 90% 70% at 50% 0%, oklch(0.3 0.06 210 / 0.55), transparent 70%),
      var(--wl-surface);
    border: 1px solid var(--wl-line-soft);
  }
  .wl-spectrum { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 8px; min-height: 48px; }
  .wl-end {
    display: flex; align-items: center; min-height: 44px; padding: 6px 12px; border-radius: 14px;
    font-family: var(--wl-display); font-weight: 700; font-size: 1rem; line-height: 1.2; min-width: 0;
  }
  .wl-end--left { background: oklch(0.85 0.12 182 / 0.14); color: var(--wl-teal); border: 1px solid oklch(0.85 0.12 182 / 0.35); justify-content: flex-start; }
  .wl-end--right { background: oklch(0.75 0.15 32 / 0.14); color: oklch(0.85 0.1 40); border: 1px solid oklch(0.75 0.15 32 / 0.4); justify-content: flex-end; text-align: right; }
  .wl-end span { overflow-wrap: anywhere; }
  .wl-arrow { color: var(--wl-muted); font-size: 1.1rem; }
  .wl-spectrum.is-empty .wl-end { opacity: 0.45; }

  .wl-clue { margin: 10px 0 2px; text-align: center; min-height: 0; }
  .wl-clue-label { font-size: 0.74rem; color: var(--wl-muted); letter-spacing: 0.08em; }
  .wl-clue-text {
    display: inline-block; max-width: 100%; margin-top: 2px; padding: 6px 18px; border-radius: 16px;
    font-family: var(--wl-display); font-weight: 700; font-size: clamp(1.35rem, 6.4vw, 1.9rem); line-height: 1.2;
    color: var(--wl-ink); background: oklch(0.13 0.03 255 / 0.65); border: 1px solid var(--wl-line);
    overflow-wrap: anywhere;
  }
  .wl-clue-text.is-in { animation: wlClueIn 0.55s var(--wl-spring) both; }
  .wl-wait { text-align: center; color: var(--wl-soft); font-weight: 600; margin: 10px 0 0; }
  .wl-wait strong { color: var(--wl-teal); }

  /* ---------- dial ---------- */
  .wl-dial-wrap { position: relative; width: 100%; max-width: 560px; margin: 8px auto 0; user-select: none; -webkit-user-select: none; }
  .wl-dial { display: block; width: 100%; height: auto; overflow: visible; }
  .wl-dial.is-interactive { touch-action: none; cursor: grab; }
  .wl-dial.is-dragging { cursor: grabbing; }
  .wl-dial g, .wl-dial path, .wl-dial line, .wl-dial circle { transform-box: view-box; }
  .wl-rot { transform-origin: 200px 200px; }
  .wl-bands { will-change: transform; }
  .wl-shutter { transition: transform 0.9s var(--wl-ease); will-change: transform; }
  .wl-shutter.is-open { transform: rotate(-180deg); }
  .wl-shutter.no-anim, .wl-bands.no-anim { transition: none !important; }
  .wl-beam { opacity: 0; }
  .wl-beam.is-idle { animation: wlBeamIdle 3.2s ease-in-out infinite alternate; }
  .wl-beam.is-sweep { animation: wlBeamSweep 1.15s var(--wl-ease) both; }
  .wl-tick-lit { opacity: 0; transition: opacity 0.12s ease-out; }
  .wl-tick-lit.is-on { opacity: 1; }
  .wl-needle { transition: opacity 0.25s ease-out; }
  .wl-needle.is-hidden { opacity: 0; pointer-events: none; }
  .wl-needle .wl-knob-ring { transform-origin: 200px 50px; transition: transform 0.18s var(--wl-spring); }
  .wl-dial.is-dragging .wl-knob-ring { transform: scale(1.22); }
  .wl-needle.is-locked .wl-knob-core { fill: var(--wl-teal); }
  .wl-needle.is-locked .wl-needle-line { stroke: var(--wl-teal); }
  .wl-needle-wobble { transform-origin: 200px 200px; }
  .wl-needle-wobble.is-clunk { animation: wlClunk 0.5s var(--wl-spring); }
  .wl-needle.is-ghost { opacity: 0.35; }
  .wl-knob-hit { cursor: grab; }
  .wl-knob-hit:focus { outline: none; }
  .wl-knob-hit:focus-visible + .wl-knob-ring { stroke: var(--wl-gold); }

  .wl-pins { position: absolute; inset: 0; pointer-events: none; }
  .wl-pin {
    position: absolute; left: 0; top: 0; display: flex; align-items: center; gap: 4px;
    max-width: 96px; padding: 2px 8px 2px 3px; border-radius: 999px;
    background: oklch(0.14 0.03 255 / 0.92); border: 1.5px solid var(--pin-color, #fff);
    font-size: 0.7rem; font-weight: 700; color: var(--wl-ink); white-space: nowrap;
    transform: translate(-50%, -50%);
  }
  .wl-pin-dot { flex: 0 0 auto; width: 16px; height: 16px; border-radius: 50%; display: grid; place-items: center; font-size: 10px; background: var(--pin-color, #fff); }
  .wl-pin-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .wl-pin.is-me { border-width: 2px; background: oklch(0.25 0.06 185 / 0.95); }
  .wl-pin.is-drop { animation: wlPinDrop 0.5s var(--wl-spring) both; animation-delay: var(--d, 0ms); }

  .wl-pin-more { flex: 0 0 auto; margin-left: 2px; padding: 0 5px; border-radius: 999px; background: var(--pin-color, #fff); color: oklch(0.18 0.03 255); font-size: 0.66rem; line-height: 1.5; }
  .wl-dial-note { text-align: center; font-size: 0.8rem; color: var(--wl-muted); margin: 4px 0 0; min-height: 1.2em; }

  /* ---------- giver card picks ---------- */
  .wl-options { display: grid; gap: 8px; margin-top: 4px; }
  .wl-options-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .wl-options-title { font-family: var(--wl-display); font-weight: 700; color: var(--wl-gold); font-size: 0.92rem; }
  .wl-option {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 54px minmax(0, 1fr); align-items: center; gap: 8px;
    min-height: 56px; padding: 8px 12px; border-radius: 16px; cursor: pointer; text-align: left;
    background: oklch(0.15 0.03 255 / 0.7); border: 1.5px solid var(--wl-line-soft); color: var(--wl-ink);
    transition: transform 0.12s var(--wl-ease), border-color 0.2s ease-out, background-color 0.2s ease-out;
  }
  .wl-option:active { transform: scale(0.98); }
  .wl-option.is-picked { border-color: var(--wl-teal); background: oklch(0.28 0.06 190 / 0.6); }
  .wl-option-l { font-weight: 700; color: var(--wl-teal); min-width: 0; overflow-wrap: anywhere; }
  .wl-option-r { font-weight: 700; color: oklch(0.85 0.1 40); text-align: right; min-width: 0; overflow-wrap: anywhere; }
  .wl-option-bar { height: 6px; border-radius: 999px; background: linear-gradient(90deg, var(--wl-teal), var(--wl-gold), var(--wl-coral)); }
  .wl-option.is-in { animation: wlOptionIn 0.45s var(--wl-spring) both; animation-delay: var(--d, 0ms); }

  /* ---------- lock chips ---------- */
  .wl-locks { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 10px; }
  .wl-lock {
    display: inline-flex; align-items: center; gap: 5px; max-width: 150px; min-height: 30px; padding: 2px 10px 2px 3px;
    border-radius: 999px; background: oklch(0.14 0.03 255 / 0.6); border: 1px solid var(--wl-line-soft);
    font-size: 0.78rem; color: var(--wl-soft); white-space: nowrap;
  }
  .wl-lock-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .wl-lock.is-locked { border-color: oklch(0.85 0.12 182 / 0.6); color: var(--wl-ink); background: oklch(0.3 0.06 185 / 0.45); }
  .wl-lock-state { flex: 0 0 auto; display: grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; border: 1.5px dashed oklch(0.75 0.03 250); font-size: 10px; font-weight: 700; line-height: 1; }
  .wl-lock.is-locked .wl-lock-state { border: 0; background: var(--wl-teal); color: oklch(0.2 0.05 200); }
  .wl-lock.is-off .wl-lock-state { width: auto; height: auto; border: 0; border-radius: 0; font-size: 0.72rem; font-weight: 600; }
  .wl-lock.is-off { opacity: 0.5; }
  .wl-lock.is-pulse { animation: wlPulse 0.45s var(--wl-spring); }

  /* ---------- results ---------- */
  .wl-results { margin-top: 12px; }
  .wl-results-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
  .wl-results h2 { margin: 0; font-family: var(--wl-display); font-size: 1rem; color: var(--wl-gold); }
  .wl-results-sub { font-size: 0.78rem; color: var(--wl-muted); }
  .wl-row { display: grid; grid-template-columns: 30px minmax(0, 1fr) auto; align-items: center; gap: 4px 10px; padding: 8px 0; border-top: 1px solid var(--wl-line-soft); }
  .wl-row:first-of-type { border-top: 0; }
  .wl-row.is-me { margin: 0 -8px; padding: 8px; border-radius: 12px; border-top-color: transparent; background: oklch(0.3 0.06 185 / 0.35); }
  .wl-row.is-me + .wl-row { border-top-color: transparent; }
  .wl-row-name { font-weight: 700; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wl-row-sub { grid-column: 2; font-size: 0.78rem; color: var(--wl-muted); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wl-pts {
    grid-column: 3; grid-row: 1 / span 2; display: inline-flex; align-items: center; justify-content: center; min-width: 52px; min-height: 30px; padding: 2px 10px;
    border-radius: 999px; font-family: var(--wl-display); font-weight: 700; font-size: 0.95rem; font-variant-numeric: tabular-nums;
    background: oklch(0.3 0.03 250 / 0.7); color: var(--wl-miss);
  }
  .wl-pts.p4 { background: var(--wl-band4); color: oklch(0.2 0.05 200); }
  .wl-pts.p3 { background: var(--wl-band3); color: oklch(0.18 0.05 40); }
  .wl-pts.p2 { background: var(--wl-band2); color: oklch(0.22 0.05 85); }
  .wl-pts.giver { background: oklch(0.84 0.13 85 / 0.18); color: var(--wl-gold); border: 1px solid oklch(0.84 0.13 85 / 0.5); }
  .wl-pts.is-pop { animation: wlPop 0.45s var(--wl-spring) both; animation-delay: var(--d, 0ms); }
  .wl-skip { text-align: center; padding: 6px 0 2px; }
  .wl-skip strong { display: block; font-family: var(--wl-display); font-size: 1.15rem; color: var(--wl-coral); }
  .wl-skip span { color: var(--wl-muted); font-size: 0.86rem; }

  /* ---------- scoreboard ---------- */
  .wl-board { margin-top: 12px; padding: 12px 14px; border-radius: 20px; background: var(--wl-surface); border: 1px solid var(--wl-line-soft); }
  .wl-board h2 { margin: 0 0 4px; font-family: var(--wl-display); font-size: 0.95rem; color: var(--wl-soft); }
  .wl-score { display: grid; grid-template-columns: 26px 30px minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 40px; }
  .wl-score-rank { font-family: var(--wl-display); font-weight: 700; color: var(--wl-muted); text-align: center; }
  .wl-score-name { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
  .wl-score-name small { color: var(--wl-muted); font-weight: 500; }
  .wl-score-val { font-family: var(--wl-display); font-weight: 700; font-variant-numeric: tabular-nums; color: var(--wl-ink); }
  .wl-score-val em { font-style: normal; color: var(--wl-teal); font-size: 0.8rem; margin-left: 4px; }
  .wl-score.is-me .wl-score-name { color: var(--wl-teal); }
  .wl-score.is-giver .wl-score-rank { color: var(--wl-gold); }

  /* ---------- dock ---------- */
  .wl-dock {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    padding: 10px max(16px, calc((100vw - 728px) / 2)) calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--wl-bg); border-top: 1px solid var(--wl-line);
    box-shadow: 0 -12px 30px oklch(0 0 0 / 0.45);
    max-height: 60vh; overflow-y: auto;
  }
  .wl-dock:empty { display: none; }
  .wl-dock.is-static { position: static; max-height: none; margin: 12px 0 0; padding: 14px; border: 1px solid var(--wl-line); border-radius: 20px; box-shadow: none; }
  .wl.is-finished { padding-bottom: 24px; }
  .wl.is-finished #wlSpectrum, .wl.is-finished #wlDialWrap, .wl.is-finished #wlDialNote, .wl.is-finished #wlBoard { display: none !important; }
  .wl-pill[hidden], .wl [hidden] { display: none !important; }
  .wl-actions { display: grid; gap: 8px; }
  .wl-row-btns { display: flex; gap: 8px; }
  .wl-row-btns > * { flex: 1 1 0; min-width: 0; }
  .wl-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 0 16px;
    border-radius: 14px; border: 1px solid var(--wl-line); background: var(--wl-surface-2); color: var(--wl-ink);
    font-weight: 700; font-size: 1.02rem; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    transition: transform 0.08s ease-out, background-color 0.18s ease-out;
  }
  .wl-btn:active { transform: scale(0.97); }
  .wl-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .wl-btn--primary { background: var(--wl-teal); color: oklch(0.2 0.05 200); border-color: transparent; font-family: var(--wl-display); font-size: 1.1rem; }
  .wl-btn--primary:hover { background: oklch(0.89 0.11 182); }
  .wl-btn--ghost { background: transparent; color: var(--wl-soft); }
  .wl-btn--big { min-height: 60px; font-size: 1.2rem; }
  .wl-btn--sm { min-height: 44px; font-size: 0.9rem; padding: 0 12px; }
  .wl-hint { font-size: 0.8rem; color: var(--wl-muted); text-align: center; }
  .wl-hint.is-error { color: var(--wl-coral); font-weight: 600; }
  .wl-dock-wait { text-align: center; color: var(--wl-soft); padding: 4px 0; font-weight: 600; }

  .wl-clue-form { display: grid; gap: 6px; }
  .wl-clue-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .wl-clue-foot .wl-hint { text-align: left; min-width: 0; }
  .wl-guess-row { display: flex; gap: 8px; }
  .wl-guess-row .wl-btn--primary { flex: 1 1 auto; min-width: 0; }
  .wl-nudge { flex: 0 0 56px; min-height: 60px; padding: 0; font-size: 1.5rem; line-height: 1; }
  .wl-btn--warn { background: var(--wl-gold); color: oklch(0.22 0.05 85); }
  .wl-btn--warn:hover { background: oklch(0.88 0.12 85); }
  .wl-input-row { display: flex; gap: 8px; }
  .wl-input {
    flex: 1 1 auto; min-width: 0; min-height: 52px; padding: 0 14px; border-radius: 14px;
    border: 1.5px solid var(--wl-line); background: oklch(0.13 0.03 255); color: var(--wl-ink); font-size: 1.05rem;
  }
  .wl-input::placeholder { color: oklch(0.6 0.03 250); }
  .wl-input.is-bad { border-color: var(--wl-coral); }
  .wl-input-row .wl-btn { flex: 0 0 auto; }
  .wl-counter { font-variant-numeric: tabular-nums; }

  /* ---------- finished ---------- */
  .wl-final-title { font-family: var(--wl-display); font-size: 1.3rem; font-weight: 700; margin: 0 0 6px; text-align: center; }
  .wl-podium { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: end; gap: 8px; margin: 10px 0 12px; }
  .wl-step { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 0; }
  .wl-step-name { max-width: 100%; font-weight: 700; font-size: 0.86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wl-step-score { font-family: var(--wl-display); font-weight: 700; color: var(--wl-gold); font-variant-numeric: tabular-nums; }
  .wl-step-block {
    width: 100%; display: grid; place-items: center; border-radius: 14px 14px 6px 6px;
    font-family: var(--wl-display); font-weight: 700; font-size: 1.4rem; color: oklch(0.2 0.05 220);
    transform-origin: bottom center;
  }
  .wl-step.r1 .wl-step-block { height: 96px; background: var(--wl-gold); }
  .wl-step.r2 .wl-step-block { height: 70px; background: var(--wl-teal); }
  .wl-step.r3 .wl-step-block { height: 52px; background: var(--wl-coral); }
  .wl-step.is-empty { visibility: hidden; }
  .wl-step.is-rise .wl-step-block { animation: wlRise 0.6s var(--wl-spring) both; animation-delay: var(--d, 0ms); }
  .wl-crown { font-size: 1.3rem; line-height: 1; }

  .wl-recap { margin-top: 14px; }
  .wl-recap summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-family: var(--wl-display); font-weight: 700; color: var(--wl-gold); }
  .wl-recap-row { padding: 8px 0; border-top: 1px solid var(--wl-line-soft); font-size: 0.86rem; color: var(--wl-soft); }
  .wl-recap-row strong { color: var(--wl-ink); }
  .wl-recap-meta { display: block; font-size: 0.78rem; color: var(--wl-muted); }

  /* ---------- history / sidebar ---------- */
  .wl-history { margin-top: 12px; }
  .wl-history summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--wl-soft); font-weight: 600; font-size: 0.88rem; }
  .wl-feed { display: grid; gap: 4px; }
  .wl-feed-item { font-size: 0.82rem; color: var(--wl-soft); padding: 5px 10px; background: var(--wl-surface); border-radius: 10px; }

  .wl-banner {
    position: fixed; left: 50%; top: 40%; z-index: 11001; pointer-events: none; max-width: calc(100vw - 32px);
    padding: 12px 22px; border-radius: 999px; background: oklch(0.15 0.035 255 / 0.95); border: 1.5px solid var(--wl-teal, #5eead4);
    color: #f1f5f9; font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 1.2rem; text-align: center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0; transform: translate(-50%, -50%);
  }
  .wl-banner.is-on { animation: wlBanner 1.8s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .wl-banner.is-gold { border-color: oklch(0.84 0.13 85); color: oklch(0.9 0.1 85); }
  .wl-banner.is-coral { border-color: oklch(0.75 0.15 32); }

  .wl-sidebar { position: fixed; top: 0; right: -320px; width: 300px; max-width: 86vw; height: 100%; background: oklch(0.21 0.04 255); border-left: 1px solid oklch(0.85 0.1 185 / 0.2); padding: 18px; z-index: 9000; transition: right 0.25s ease; overflow-y: auto; color: #f1f5f9; font-family: 'Bai Jamjuree', sans-serif; }
  .wl-sidebar.open { right: 0; }
  .wl-sidebar h4 { margin: 0 0 10px; font-family: 'Chakra Petch', sans-serif; }
  .wl-sidebar-overlay { display: none; position: fixed; inset: 0; background: oklch(0 0 0 / 0.55); z-index: 8999; }
  .wl-guide { text-align: left; font-family: 'Bai Jamjuree', sans-serif; line-height: 1.55; font-size: 0.94rem; }
  .wl-guide h4 { margin: 12px 0 4px; font-family: 'Chakra Petch', sans-serif; color: oklch(0.85 0.12 182); font-size: 0.98rem; }
  .wl-guide p { margin: 0 0 6px; }

  .chat-box {
    --chat-accent: oklch(0.78 0.12 182); --chat-accent-dark: oklch(0.5 0.1 190);
    --chat-surface: oklch(0.2 0.04 255); --chat-border: oklch(0.85 0.12 182 / 0.24); --chat-bubble: oklch(0.27 0.05 255);
    font-family: 'Bai Jamjuree', sans-serif;
  }
  .chat-toggle { --chat-toggle-bg: oklch(0.45 0.09 195); border-radius: 999px; padding: 10px 16px; min-height: 44px; top: calc(12px + env(safe-area-inset-top, 0px)) !important; bottom: auto !important; }
  .btn-chat-send { --chat-send-bg: oklch(0.85 0.12 182); --chat-send-color: oklch(0.2 0.05 200); }

  @keyframes wlClueIn { 0% { opacity: 0; transform: translateY(8px) scale(0.9); } 100% { opacity: 1; transform: none; } }
  @keyframes wlBeamIdle { 0% { opacity: 0.55; transform: rotate(-70deg); } 100% { opacity: 0.55; transform: rotate(70deg); } }
  @keyframes wlBeamSweep { 0% { opacity: 0; transform: rotate(-95deg); } 15% { opacity: 0.9; } 85% { opacity: 0.7; } 100% { opacity: 0; transform: rotate(95deg); } }
  @keyframes wlClunk { 0% { transform: rotate(0deg); } 30% { transform: rotate(-2.4deg); } 60% { transform: rotate(1.2deg); } 100% { transform: rotate(0deg); } }
  @keyframes wlPinDrop { 0% { opacity: 0; transform: translate(-50%, -150%) scale(0.6); } 100% { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
  @keyframes wlOptionIn { 0% { opacity: 0; transform: translateY(10px) scale(0.97); } 100% { opacity: 1; transform: none; } }
  @keyframes wlPulse { 0% { transform: scale(1); } 40% { transform: scale(1.12); } 100% { transform: scale(1); } }
  @keyframes wlPop { 0% { opacity: 0; transform: scale(0.5); } 70% { opacity: 1; transform: scale(1.15); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes wlRise { 0% { transform: scaleY(0.1); } 100% { transform: scaleY(1); } }
  @keyframes wlBanner {
    0% { opacity: 0; transform: translate(-50%, -38%) scale(0.92); }
    16% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    78% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -62%) scale(0.98); }
  }

  @media (min-width: 720px) {
    .wl-stage { padding: 18px 20px 16px; }
    .wl-pin { font-size: 0.78rem; max-width: 120px; }
  }
  /* แท็บเล็ต/มือถือแนวนอน: ปุ่มแชทลอยมุมขวาบนทับปุ่มเครื่องมือที่อยู่แถวเดียวกัน */
  @media (min-width: 520px) and (max-width: 1000px) {
    .wl-tools { margin-right: 104px; }
  }
  /* มือถือแนวนอน: จอเตี้ย หน้าปัดต้องพอดีช่องเหนือ dock */
  @media (orientation: landscape) and (max-height: 520px) {
    /* เผื่อที่ให้คำใบ้ (~100px) อยู่ในจอพร้อมหน้าปัด — 390px สูง ได้หน้าปัดกว้าง ~300px ใกล้เคียงแนวตั้ง */
    .wl-dial-wrap { max-width: min(560px, calc((100vh - var(--wl-dock-h, 120px) - 120px) * 1.87)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wl-shutter, .wl-bands, .wl-needle, .wl-tick-lit, .wl-option, .wl-btn, .wl-sidebar { transition: none !important; }
    .wl-beam.is-idle, .wl-beam.is-sweep, .wl-needle-wobble.is-clunk, .wl-pin.is-drop, .wl-option.is-in, .wl-lock.is-pulse,
    .wl-pts.is-pop, .wl-step.is-rise .wl-step-block, .wl-clue-text.is-in { animation: none !important; }
    .wl-banner.is-on { animation: none !important; opacity: 1; }
  }
</style>


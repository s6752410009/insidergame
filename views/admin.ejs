    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    }

    window.copySiteAdminLink = async function(playerId) {
        const joinUrl = `${window.location.origin}/rooms?playerId=${encodeURIComponent(playerId)}`;
        try {
            if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(joinUrl);
            } else {
                const temp = document.createElement('textarea');
                temp.value = joinUrl;
                document.body.appendChild(temp);
                temp.select();
                document.execCommand('copy');
                document.body.removeChild(temp);
            }
            Swal.fire({
                icon: 'success',
                title: 'คัดลอกลิงก์แล้ว',
                text: joinUrl,
                timer: 1800,
                showConfirmButton: false,
                background: '#1e1e1e',
                color: '#fff'
            });
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'คัดลอกไม่สำเร็จ', text: joinUrl, background: '#1e1e1e', color: '#fff' });
        }
    };
    

                    </select>
                    <select id="logModeFilter" class="search-box" style="width: auto;">
                        <option value="all">ทุกโหมด</option>
                        <option value="insider">Insider</option>
                        <option value="werewolf">Werewolf</option>
                        <option value="blackmarket">Black Market</option>
                        <option value="spyfall">Spyfall</option>

    function setAdminInboxBadge(count) {
        const safeCount = Math.max(0, Number(count) || 0);
        ['#adminInboxBadge', '#adminInboxTabBadge'].forEach(selector => {
            const badge = $(selector);
            badge.text(safeCount > 99 ? '99+' : safeCount);
            badge.toggleClass('has-unread', safeCount > 0);
        });
        $('#adminInboxBell').attr('aria-label', safeCount > 0
            ? `เปิดกล่องข้อความ มี ${safeCount} ข้อความที่ยังไม่ได้อ่าน`
            : 'เปิดกล่องข้อความ');
    }

    function formatInboxTime(value) {
        if (!value) return '';
        return new Intl.DateTimeFormat('th-TH', {
            dateStyle: 'short',
            timeStyle: 'short'
        }).format(new Date(value));
    }

    function renderAdminThreadList() {
        const list = $('#adminThreadList');
        if (!adminInboxThreads.length) {
            list.html('<div class="empty-message">ยังไม่มีข้อความจากผู้เล่น</div>');
            return;
        }

        list.html(adminInboxThreads.map(thread => {
            const unread = Number(thread.unreadForAdmin) || 0;
            const preview = thread.lastMessage?.body || '';
            return `
                <button type="button" class="admin-thread-item${thread.playerId === selectedInboxPlayerId ? ' is-active' : ''}" data-player-id="${escapeHtml(thread.playerId)}">
                    <strong>${escapeHtml(thread.playerName || 'Unknown')}</strong>
                    ${unread ? `<span class="admin-thread-unread">${unread > 99 ? '99+' : unread}</span>` : `<small>${escapeHtml(formatInboxTime(thread.lastMessageAt))}</small>`}
                    <span class="admin-thread-preview">${thread.lastMessage?.sender === 'admin' ? 'คุณ: ' : ''}${escapeHtml(preview)}</span>
                </button>
            `;
        }).join(''));

        list.find('.admin-thread-item').on('click', function() {
            openAdminThread($(this).data('player-id'));
        });
    }

    window.loadAdminInbox = async function() {
        if (!isAuthenticated) return;
        try {
            const response = await fetch('/admin/api/messages', {
                headers: { Accept: 'application/json' },
                cache: 'no-store'
            });
            const data = await response.json();
            if (!response.ok || !data.success) throw new Error(data.error || 'โหลดกล่องข้อความไม่สำเร็จ');
            adminInboxThreads = Array.isArray(data.threads) ? data.threads : [];
            setAdminInboxBadge(data.unreadCount);
            renderAdminThreadList();
        } catch (error) {
            console.error('[AdminInbox]', error);
            $('#adminThreadList').html(`<div class="empty-message">${escapeHtml(error.message)}</div>`);
        }
    };

    function renderAdminConversation(thread) {
        const messages = Array.isArray(thread.messages) ? thread.messages : [];
        $('#adminConversationHead').html(`
            <strong>${escapeHtml(thread.playerName || 'Unknown')}</strong>
            <span>${escapeHtml(thread.playerId)}</span>
        `);

        const body = $('#adminConversationBody');
        if (!messages.length) {
            body.html('<div class="empty-message">ยังไม่มีข้อความ</div>');
        } else {
            body.html(messages.map(message => {
                const isAdmin = message.sender === 'admin';
                let state = 'ผู้เล่นส่งมา';
                if (isAdmin) state = message.readAt ? 'ผู้เล่นอ่านแล้ว' : 'ส่งแล้ว ยังไม่ได้อ่าน';
                return `
                    <article class="admin-inbox-message${isAdmin ? ' is-admin' : ''}">
                        <p>${escapeHtml(message.body)}</p>
                        <small>${escapeHtml(formatInboxTime(message.createdAt))} · ${state}</small>
                    </article>
                `;
            }).join(''));
            body.scrollTop(body[0].scrollHeight);
        }

        $('#adminReplyInput').prop('disabled', false).attr('placeholder', 'ตอบผู้เล่นคนนี้…');
        $('#adminReplyButton').prop('disabled', false);
    }

    async function openAdminThread(playerId) {
        selectedInboxPlayerId = String(playerId || '');
        renderAdminThreadList();
        try {
            const response = await fetch(`/admin/api/messages/${encodeURIComponent(selectedInboxPlayerId)}`, {
                headers: { Accept: 'application/json' },
                cache: 'no-store'
            });
            const data = await response.json();
            if (!response.ok || !data.success) throw new Error(data.error || 'เปิดบทสนทนาไม่สำเร็จ');
            renderAdminConversation(data.thread);
            setAdminInboxBadge(data.unreadCount);
            loadAdminInbox();
        } catch (error) {
            $('#adminConversationBody').html(`<div class="empty-message">${escapeHtml(error.message)}</div>`);
        }
    }

    $('#adminReplyForm').on('submit', async function(event) {
        event.preventDefault();
        const message = $('#adminReplyInput').val().trim();
        if (!selectedInboxPlayerId || !message) return;

        $('#adminReplyButton').prop('disabled', true).text('กำลังส่ง…');
        try {
            const response = await fetch(`/admin/api/messages/${encodeURIComponent(selectedInboxPlayerId)}/reply`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ message })
            });
            const data = await response.json();
            if (!response.ok || !data.success) throw new Error(data.error || 'ตอบข้อความไม่สำเร็จ');
            $('#adminReplyInput').val('');
            renderAdminConversation(data.thread);
            loadAdminInbox();
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'ส่งไม่สำเร็จ', text: error.message, background: '#1e1e1e', color: '#fff' });
        } finally {
            $('#adminReplyButton').prop('disabled', false).text('ส่งคำตอบ');
        }
    });

    socket.on('adminInboxUpdate', function(update) {
        setAdminInboxBadge(update?.unreadCount);
        loadAdminInbox();
        if (selectedInboxPlayerId && update?.playerId === selectedInboxPlayerId && $('#tab-messages').hasClass('active')) {
            openAdminThread(selectedInboxPlayerId);
        }
    });

    // Listen for real-time events
    socket.on('admin_log', function(data) {
        serverLogs.unshift({
            timestamp: new Date().toISOString(),
            category: 'admin',
            type: data.type || 'info',
            message: data.message || ''
        });
        if (serverLogs.length > 2000) serverLogs.length = 2000;
        renderLogs();
    });

    updateSortIcons('.sortable:not(.room-sortable):not(.stats-sortable)', dashboardState.players.sortCol, dashboardState.players.sortDir);
    updateSortIcons('.room-sortable', dashboardState.rooms.sortCol, dashboardState.rooms.sortDir);
    updateSortIcons('.stats-sortable', dashboardState.stats.sortCol, dashboardState.stats.sortDir);

    function shouldPauseAutoRefresh() {
        const activeTag = document.activeElement ? document.activeElement.tagName : '';
        return Swal.isVisible() || activeTag === 'INPUT' || activeTag === 'TEXTAREA' || activeTag === 'SELECT';
    }

    setInterval(function() {
        if (!shouldPauseAutoRefresh()) {
            loadData();
            loadAdminInbox();
        }
    }, 15000);
    
    // Update server time every second
    setInterval(() => {
        $('#serverTime').text(new Date().toLocaleString('th-TH'));
    }, 1000);
});
</script>

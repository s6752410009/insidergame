<%- contentFor('content') %>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
    .admin-container {
        max-width: 1400px;
        margin: 30px auto;
        padding: 20px;
        font-family: 'Rajdhani', sans-serif;
    }
    
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }
    
    .admin-header h1 {
        margin: 0;
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 2.5em;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 15px;
        margin-bottom: 30px;
    }
    
    .stat-card {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border: 2px solid #444;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }
    
    .stat-card h3 {
        margin: 0 0 10px 0;
        color: #888;
        font-size: 0.85em;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    
    .stat-card .stat-value {
        font-size: 2.2em;
        font-weight: 700;
        color: #fff;
        font-family: 'Orbitron', sans-serif;
    }
    
    .stat-card.players .stat-value { color: #3498db; }
    .stat-card.rooms .stat-value { color: #2ecc71; }
    .stat-card.playing .stat-value { color: #e67e22; }
    .stat-card.banned .stat-value { color: #e74c3c; }
    .stat-card.games .stat-value { color: #9b59b6; }
    .stat-card.real .stat-value { color: #2ecc71; }
    .stat-card.ghost .stat-value { color: #f39c12; }
    
    .panel {
        background: linear-gradient(135deg, #151515 0%, #222 100%);
        border: 3px solid #444;
        border-radius: 18px;
        padding: 24px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.7);
    }
    
    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #333;
        flex-wrap: wrap;
        gap: 10px;
    }
    
    .panel-header h2 {
        margin: 0;
        color: #fff;
        font-family: 'Orbitron', sans-serif;
        font-size: 1.4em;
    }
    
    .panel-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    
    .btn-admin {
        padding: 8px 16px;
        border: 2px solid;
        border-radius: 8px;
        color: #fff;
        cursor: pointer;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        font-size: 0.9em;
        transition: all 0.3s;
        background: transparent;
    }
    
    .btn-admin:hover {
        transform: translateY(-2px);
    }
    
    .btn-refresh {
        border-color: #3498db;
        color: #3498db;
    }
    .btn-refresh:hover {
        background: #3498db;
        color: #fff;
    }
    
    .btn-danger {
        border-color: #e74c3c;
        color: #e74c3c;
    }
    .btn-danger:hover {
        background: #e74c3c;
        color: #fff;
    }
    
    .btn-warning {
        border-color: #f39c12;
        color: #f39c12;
    }
    .btn-warning:hover {
        background: #f39c12;
        color: #fff;
    }
    
    .btn-success {
        border-color: #2ecc71;
        color: #2ecc71;
    }
    .btn-success:hover {
        background: #2ecc71;
        color: #fff;
    }
    
    .btn-primary {
        border-color: #9b59b6;
        color: #9b59b6;
    }
    .btn-primary:hover {
        background: #9b59b6;
        color: #fff;
    }
    
    .table-container {
        overflow-x: auto;
    }
    
    table {
        width: 100%;
        border-collapse: collapse;
    }
    
    th, td {
        padding: 12px 15px;
        text-align: left;
        border-bottom: 1px solid #333;
    }
    
    th {
        background: #1a1a1a;
        color: #888;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8em;
        letter-spacing: 1px;
    }
    
    td {
        color: #ddd;
        font-size: 0.95em;
    }
    
    tr:hover td {
        background: rgba(255,255,255,0.05);
    }
    
    .player-color {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: inline-block;
        vertical-align: middle;
        margin-right: 8px;
        border: 2px solid rgba(255,255,255,0.3);
    }
    
    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8em;
        font-weight: 600;
    }
    
    .status-online { background: rgba(46, 204, 113, 0.2); color: #2ecc71; border: 1px solid #2ecc71; }
    .status-offline { background: rgba(231, 76, 60, 0.2); color: #e74c3c; border: 1px solid #e74c3c; }
    .status-waiting { background: rgba(52, 152, 219, 0.2); color: #3498db; border: 1px solid #3498db; }
    .status-playing { background: rgba(230, 126, 34, 0.2); color: #e67e22; border: 1px solid #e67e22; }
    .status-banned { background: rgba(231, 76, 60, 0.3); color: #ff6b6b; border: 1px solid #e74c3c; }

    .status-ghost { background: rgba(243, 156, 18, 0.2); color: #f39c12; border: 1px solid #f39c12; }
    .status-real { background: rgba(46, 204, 113, 0.2); color: #2ecc71; border: 1px solid #2ecc71; }
    .status-guest { background: rgba(52, 152, 219, 0.2); color: #5dade2; border: 1px solid #3498db; }
    
    .action-btn {
        padding: 5px 10px;
        border-radius: 5px;
        border: 1px solid;
        cursor: pointer;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        font-size: 0.85em;
        transition: all 0.2s;
        margin: 2px;
    }
    
    .action-btn.ban { border-color: #e74c3c; color: #e74c3c; background: transparent; }
    .action-btn.ban:hover { background: #e74c3c; color: #fff; }
    .action-btn.unban { border-color: #2ecc71; color: #2ecc71; background: transparent; }
    .action-btn.unban:hover { background: #2ecc71; color: #fff; }
    .action-btn.kick { border-color: #f39c12; color: #f39c12; background: transparent; }
    .action-btn.kick:hover { background: #f39c12; color: #fff; }
    .action-btn.delete { border-color: #c0392b; color: #c0392b; background: transparent; }
    .action-btn.delete:hover { background: #c0392b; color: #fff; }
    .action-btn.edit { border-color: #3498db; color: #3498db; background: transparent; }
    .action-btn.edit:hover { background: #3498db; color: #fff; }
    .action-btn.view { border-color: #9b59b6; color: #9b59b6; background: transparent; }
    .action-btn.view:hover { background: #9b59b6; color: #fff; }
    .action-btn.close { border-color: #e74c3c; color: #e74c3c; background: transparent; }
    .action-btn.close:hover { background: #e74c3c; color: #fff; }
    .action-btn.unlock { border-color: #2ecc71; color: #2ecc71; background: transparent; }
    .action-btn.unlock:hover { background: #2ecc71; color: #fff; }
    .action-btn.reset { border-color: #f39c12; color: #f39c12; background: transparent; }
    .action-btn.reset:hover { background: #f39c12; color: #fff; }
    
    .tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }
    
    .tab-btn {
        padding: 10px 20px;
        background: #333;
        border: 2px solid #444;
        border-radius: 8px;
        color: #fff;
        cursor: pointer;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .tab-btn.active {
        background: #e74c3c;
        border-color: #c0392b;
    }
    
    .tab-btn:hover:not(.active) {
        background: #444;
    }
    
    .tab-content {
        display: none;
    }
    
    .tab-content.active {
        display: block;
    }
    
    .search-box {
        padding: 10px 15px;
        border: 2px solid #444;
        border-radius: 8px;
        background: #1a1a1a;
        color: #fff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1em;
        width: 200px;
    }
    
    .search-box:focus {
        outline: none;
        border-color: #e74c3c;
    }
    
    .empty-message {
        text-align: center;
        padding: 40px;
        color: #888;
    }
    
    .room-players {
        font-size: 0.85em;
        color: #888;
    }
    
    .room-players span {
        display: inline-block;
        margin: 2px;
        padding: 2px 8px;
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
    }
    
    .last-seen {
        font-size: 0.85em;
        color: #666;
    }
    
    .broadcast-input {
        width: 100%;
        padding: 15px;
        border: 2px solid #444;
        border-radius: 8px;
        background: #1a1a1a;
        color: #fff;
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.1em;
        margin-bottom: 15px;
        resize: vertical;
        min-height: 80px;
    }
    
    .broadcast-input:focus {
        outline: none;
        border-color: #9b59b6;
    }
    
    .quick-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }
    
    .quick-action-btn {
        padding: 20px;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border: 2px solid #444;
        border-radius: 12px;
        color: #fff;
        cursor: pointer;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 600;
        font-size: 1em;
        transition: all 0.3s;
        text-align: center;
    }
    
    .quick-action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 20px rgba(0,0,0,0.4);
    }
    
    .quick-action-btn .icon {
        font-size: 2em;
        display: block;
        margin-bottom: 10px;
    }
    
    .quick-action-btn.danger { border-color: #e74c3c; }
    .quick-action-btn.danger:hover { background: rgba(231, 76, 60, 0.2); }
    .quick-action-btn.warning { border-color: #f39c12; }
    .quick-action-btn.warning:hover { background: rgba(243, 156, 18, 0.2); }
    .quick-action-btn.success { border-color: #2ecc71; }
    .quick-action-btn.success:hover { background: rgba(46, 204, 113, 0.2); }
    .quick-action-btn.primary { border-color: #9b59b6; }
    .quick-action-btn.primary:hover { background: rgba(155, 89, 182, 0.2); }

    .player-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .player-summary-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 14px 16px;
    }

    .player-summary-card h4 {
        margin: 0 0 8px 0;
        color: #888;
        font-size: 0.85em;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .player-summary-card .value {
        font-size: 1.8em;
        font-family: 'Orbitron', sans-serif;
        color: #fff;
    }

    .cleanup-note {
        color: #888;
        font-size: 0.9em;
        margin-top: 10px;
    }

    .filters-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    .filters-row .search-box,
    .filters-row select {
        min-width: 160px;
    }

    .table-meta {
        margin-bottom: 12px;
        color: #777;
        font-size: 0.9em;
    }

    .sortable.active {
        color: #fff;
    }

    .table-container table {
        min-width: 920px;
    }

    .compact-table table {
        min-width: 1040px;
    }

    .table-scroll-hint {
        display: none;
        margin: 0 0 8px;
        padding: 8px 12px;
        border-radius: 8px;
        background: rgba(52, 152, 219, 0.12);
        color: #8fd3ff;
        font-size: 0.85em;
    }

    @media (max-width: 900px) {
        .admin-container {
            margin: 8px auto 20px;
            padding: 10px;
        }

        .panel {
            padding: 14px;
            border-radius: 14px;
        }

        .admin-header {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .admin-header h1 {
            font-size: 1.45em;
        }

        .admin-header-actions {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .admin-header-actions .btn-admin {
            margin-left: 0 !important;
            text-align: center;
            display: block;
        }

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .stat-card {
            padding: 10px 8px;
        }

        .stat-card h3 {
            font-size: 0.68em;
            margin-bottom: 4px;
        }

        .stat-card .stat-value {
            font-size: 1.35em;
        }

        .player-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .tabs {
            flex-wrap: nowrap;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            gap: 8px;
        }

        .tabs::-webkit-scrollbar {
            display: none;
        }

        .tab-btn {
            flex: 0 0 auto;
            white-space: nowrap;
            padding: 8px 12px;
            font-size: 0.88em;
        }

        .panel-header {
            flex-direction: column;
            align-items: stretch;
        }

        .panel-actions,
        .filters-row {
            width: 100%;
        }

        .filters-row .search-box,
        .filters-row select,
        .panel-actions .search-box {
            width: 100% !important;
            min-width: 0;
        }

        .panel-actions .btn-admin {
            width: 100%;
            justify-content: center;
        }

        .quick-actions {
            grid-template-columns: 1fr;
        }

        .table-scroll-hint {
            display: block;
        }

        .table-container {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border: 1px solid #333;
            border-radius: 10px;
        }

        .table-container table {
            min-width: 760px;
        }

        .table-container.compact-table table {
            min-width: 960px;
        }

        .table-container th,
        .table-container td {
            padding: 8px 10px;
            font-size: 0.86em;
        }

        .table-container .action-btn {
            padding: 4px 8px;
            font-size: 0.78em;
        }

        #logsContainer {
            max-height: min(60vh, 420px);
            font-size: 0.8em;
        }
    }
</style>

<!-- ===== Modern admin dashboard theme (override layer, keeps all existing classes/ids) ===== -->
<style>
    :root {
        --ad-bg-0: #0a0c14;
        --ad-bg-1: #0f1220;
        --ad-surface: rgba(22, 26, 42, 0.72);
        --ad-surface-2: rgba(30, 35, 56, 0.6);
        --ad-border: rgba(255, 255, 255, 0.08);
        --ad-border-strong: rgba(255, 255, 255, 0.14);
        --ad-text: #e8ecf6;
        --ad-text-dim: #9aa6c0;
        --ad-text-mute: #6b7794;
        --ad-blue: #4aa3ff;
        --ad-green: #34d399;
        --ad-orange: #fb923c;
        --ad-red: #f87171;
        --ad-purple: #a78bfa;
        --ad-amber: #fbbf24;
        --ad-radius: 16px;
        --ad-radius-sm: 10px;
        --ad-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
        --ad-shadow-sm: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    body {
        background:
            radial-gradient(1100px 700px at 12% -8%, rgba(74, 163, 255, 0.12), transparent 55%),
            radial-gradient(900px 600px at 100% 0%, rgba(167, 139, 250, 0.12), transparent 55%),
            linear-gradient(160deg, var(--ad-bg-0), var(--ad-bg-1) 60%, #0a0c14);
        background-attachment: fixed;
        color: var(--ad-text);
    }

    .admin-container {
        max-width: 1440px;
        padding: 26px 22px 60px;
    }

    /* Header */
    .admin-header {
        margin-bottom: 26px;
        padding: 20px 24px;
        background: var(--ad-surface);
        border: 1px solid var(--ad-border);
        border-radius: var(--ad-radius);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: var(--ad-shadow-sm);
    }

    .admin-header h1 {
        font-size: 2.1em;
        letter-spacing: 0.5px;
        background: linear-gradient(120deg, #fff 10%, #9ec5ff 55%, #c4b5fd 95%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: none;
    }

    /* Stat cards */
    .stats-grid {
        gap: 14px;
        margin-bottom: 26px;
    }

    .stat-card {
        position: relative;
        background: var(--ad-surface);
        border: 1px solid var(--ad-border);
        border-radius: var(--ad-radius);
        padding: 18px 18px 16px;
        text-align: left;
        overflow: hidden;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: var(--ad-blue);
        opacity: 0.9;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: var(--ad-border-strong);
        box-shadow: var(--ad-shadow);
    }

    .stat-card h3 {
        color: var(--ad-text-dim);
        font-size: 0.78em;
        letter-spacing: 0.6px;
    }

    .stat-card .stat-value {
        font-size: 2.1em;
        line-height: 1.1;
    }

    .stat-card.players::before { background: var(--ad-blue); }
    .stat-card.rooms::before { background: var(--ad-green); }
    .stat-card.playing::before { background: var(--ad-orange); }
    .stat-card.banned::before { background: var(--ad-red); }
    .stat-card.games::before { background: var(--ad-purple); }
    .stat-card.real::before { background: var(--ad-green); }
    .stat-card.ghost::before { background: var(--ad-amber); }
    .stat-card.players .stat-value { color: var(--ad-blue); }
    .stat-card.rooms .stat-value { color: var(--ad-green); }
    .stat-card.playing .stat-value { color: var(--ad-orange); }
    .stat-card.banned .stat-value { color: var(--ad-red); }
    .stat-card.games .stat-value { color: var(--ad-purple); }
    .stat-card.real .stat-value { color: var(--ad-green); }
    .stat-card.ghost .stat-value { color: var(--ad-amber); }

    /* Panels */
    .panel {
        background: var(--ad-surface);
        border: 1px solid var(--ad-border);
        border-radius: var(--ad-radius);
        padding: 22px 24px;
        box-shadow: var(--ad-shadow-sm);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    .panel-header {
        border-bottom: 1px solid var(--ad-border);
        padding-bottom: 16px;
    }

    .panel-header h2 {
        font-size: 1.25em;
        letter-spacing: 0.3px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Tabs */
    .tabs {
        gap: 8px;
        padding: 8px;
        background: var(--ad-surface-2);
        border: 1px solid var(--ad-border);
        border-radius: 14px;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .tab-btn {
        background: transparent;
        border: 1px solid transparent;
        border-radius: 10px;
        color: var(--ad-text-dim);
        padding: 9px 16px;
    }

    .tab-btn:hover:not(.active) {
        background: rgba(255, 255, 255, 0.06);
        color: var(--ad-text);
    }

    .tab-btn.active {
        background: linear-gradient(120deg, #4aa3ff, #7c5cff);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 6px 18px rgba(74, 163, 255, 0.35);
    }

    /* Buttons */
    .btn-admin {
        border-radius: 10px;
        border-width: 1px;
        padding: 9px 15px;
        background: rgba(255, 255, 255, 0.03);
        transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
    }

    .btn-admin:hover {
        transform: translateY(-2px);
        box-shadow: var(--ad-shadow-sm);
    }

    .btn-refresh { border-color: rgba(74, 163, 255, 0.6); color: var(--ad-blue); }
    .btn-refresh:hover { background: var(--ad-blue); color: #07121f; }
    .btn-danger { border-color: rgba(248, 113, 113, 0.6); color: var(--ad-red); }
    .btn-danger:hover { background: var(--ad-red); color: #1a0606; }
    .btn-warning { border-color: rgba(251, 146, 60, 0.6); color: var(--ad-orange); }
    .btn-warning:hover { background: var(--ad-orange); color: #1c0e02; }
    .btn-success { border-color: rgba(52, 211, 153, 0.6); color: var(--ad-green); }
    .btn-success:hover { background: var(--ad-green); color: #05140d; }
    .btn-primary { border-color: rgba(167, 139, 250, 0.6); color: var(--ad-purple); }
    .btn-primary:hover { background: var(--ad-purple); color: #11061f; }

    /* Tables */
    .table-container {
        border: 1px solid var(--ad-border);
        border-radius: var(--ad-radius-sm);
        overflow: auto;
    }


    window.addExistingSiteAdmin = function() {
        const candidates = (allData.players || []).filter(function(player) {
            return !player.isSiteAdmin;
        });

        if (!candidates.length) {
            Swal.fire({ icon: 'info', title: 'ไม่มีผู้เล่นให้เพิ่ม', text: 'ตอนนี้ผู้เล่นทั้งหมดเป็น site admin อยู่แล้ว', background: '#1e1e1e', color: '#fff' });
            return;
        }

        const options = candidates.map(function(player) {
            const label = `${player.displayName || player.playerName} (${player.playerId.slice(0, 8)}...)`;
            return `<option value="${escapeHtml(player.playerId)}">${escapeHtml(label)}</option>`;
        }).join('');

        Swal.fire({
            title: '➕ เพิ่ม Site Admin',
            html: `
                <select id="existingSiteAdminSelect" class="swal2-input" style="width:85%; background:#111; color:#fff; border:1px solid #444;">
                    <option value="">เลือกผู้เล่น...</option>
                    ${options}
                </select>
            `,
            showCancelButton: true,
            confirmButtonText: 'เพิ่มสิทธิ์',
            cancelButtonText: 'ยกเลิก',
            background: '#1e1e1e',
            color: '#fff',
            preConfirm: function() {
                const value = document.getElementById('existingSiteAdminSelect').value;
                if (!value) {
                    Swal.showValidationMessage('กรุณาเลือกผู้เล่น');
                    return false;
                }
                return value;
            }
        }).then((result) => {
            if (!result.isConfirmed) return;
            const selectedPlayer = candidates.find(function(player) {
                return player.playerId === result.value;
            });
            window.setSiteAdmin(result.value, true, selectedPlayer?.displayName || selectedPlayer?.playerName || 'ผู้เล่น');
        });
    };


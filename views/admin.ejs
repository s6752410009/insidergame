    // ========== Logs Functions ==========
    let serverLogs = [];
    const LOG_MODE_BADGE_STYLES = {
        insider: { badgeBg: 'rgba(52,152,219,0.18)', badgeColor: '#d6ebff' },
        werewolf: { badgeBg: 'rgba(192,57,43,0.2)', badgeColor: '#ffd5d0' },
        blackmarket: { badgeBg: 'rgba(246,211,101,0.18)', badgeColor: '#fde68a' },
        spyfall: { badgeBg: 'rgba(26,188,156,0.18)', badgeColor: '#7bedd6' },
        coup: { badgeBg: 'rgba(124,58,237,0.2)', badgeColor: '#ddd6fe' },
        liar: { badgeBg: 'rgba(220,38,38,0.2)', badgeColor: '#fecaca' },
        poker5: { badgeBg: 'rgba(22,101,52,0.2)', badgeColor: '#bbf7d0' },
        poker4: { badgeBg: 'rgba(153,27,27,0.2)', badgeColor: '#fecaca' }
    };
    const ROOM_MODE_LABELS = {
        insider: '🎯 Insider',
        werewolf: '🐺 Werewolf',
        blackmarket: '🎩 Black Market',
        spyfall: '🕵️ Spyfall',
        coup: '👑 Coup',
        liar: '🃏 ไพ่โกหก',
        poker5: '♠ ไพ่ 5 ใบ',
        poker4: '♦ สี่ใบเก'
    };
    const ROOM_MODE_STATUS_CLASS = {
        insider: 'status-online',
        werewolf: 'status-banned',
        blackmarket: 'status-playing',
        spyfall: 'status-online',
        coup: 'status-waiting',
        liar: 'status-banned',
        poker5: 'status-playing',
        poker4: 'status-banned'
    };

    function formatRoomModeLabel(gameMode) {
        return ROOM_MODE_LABELS[gameMode] || gameMode || ROOM_MODE_LABELS.insider;
    }

    function formatRoomModeBadgeHtml(gameMode) {
        const mode = gameMode || 'insider';
        const statusClass = ROOM_MODE_STATUS_CLASS[mode] || 'status-online';
        return `<span class="status-badge ${statusClass}">${formatRoomModeLabel(mode)}</span>`;
    }

    function formatLogModeBadge(log) {
        if (!log.gameMode) {
            return '';
        }
        const style = LOG_MODE_BADGE_STYLES[log.gameMode] || { badgeBg: 'rgba(255,255,255,0.1)', badgeColor: '#fff' };
        const label = log.gameModeLabel || log.gameMode;
        return `<span style="display:inline-flex; align-items:center; gap:4px; margin-right:6px; padding:1px 7px; border-radius:999px; background:${style.badgeBg}; color:${style.badgeColor}; font-size:0.75em; font-weight:700;">${escapeHtml(label)}</span>`;
    }

    function formatLogMeta(log) {
        if (!log.meta || typeof log.meta !== 'object') {
            return '';
        }
        const parts = Object.entries(log.meta)
            .filter(([, value]) => value !== null && value !== undefined && value !== '')
            .map(([key, value]) => `${key}=${value}`);
        return parts.length ? `<span style="color:#777; font-size:0.78em;"> (${parts.join(' · ')})</span>` : '';
    }
    
    // Load existing logs from server
    function getFilteredLogs() {
        const filter = $('#logFilter').val();
        const modeFilter = $('#logModeFilter').val();
        return serverLogs.filter(function(log) {
            const matchesCategory = filter === 'all' || log.category === filter;
            const matchesMode = modeFilter === 'all' || log.gameMode === modeFilter;
            return matchesCategory && matchesMode;
        });
    }

    function loadLogs() {
        const filter = $('#logFilter').val();
        const modeFilter = $('#logModeFilter').val();
        socket.emit('admin_getLogs', { filter: filter, gameMode: modeFilter, limit: 1000 }, function(response) {
            if (response.success) {
                serverLogs = response.logs || [];
                renderLogs();
            }
        });
    }
    
    // Receive new log entries in real-time
    socket.on('adminLog', function(logEntry) {
        serverLogs.unshift(logEntry);
        if (serverLogs.length > 2000) serverLogs.length = 2000;
        renderLogs();
    });
    
    function renderLogs() {
        const filtered = getFilteredLogs();
        
        const $container = $('#logsContainer');
        if (filtered.length === 0) {
            $container.html('<div class="empty-message">ไม่มี Logs</div>');
            return;
        }
        
        const colors = {
            'join': '#2ecc71',
            'leave': '#e74c3c', 
            'game': '#3498db',
            'admin': '#9b59b6',
            'error': '#ff6b6b',
            'chat': '#f39c12',
            'system': '#95a5a6'
        };
        const typeColors = {
            'info': '#3498db',
            'success': '#2ecc71',
            'warning': '#f39c12',
            'error': '#e74c3c'
        };
        const icons = {
            'join': '➡️',
            'leave': '⬅️',
            'game': '🎮',
            'admin': '👑',
            'error': '❌',
            'chat': '💬',
            'system': '⚙️'
        };
        
        $container.html(filtered.map(log => {
            const dt = new Date(log.timestamp);
            const pad = (n) => String(n).padStart(2, '0');
            const dateStr = `${pad(dt.getDate())}/${pad(dt.getMonth() + 1)}/${dt.getFullYear()}`;
            const timeStr = dt.toLocaleTimeString('th-TH', { hour12: false });
            const time = `${dateStr} ${timeStr}`;
            
            const color = typeColors[log.type] || colors[log.category] || '#fff';
            const icon = icons[log.category] || '•';
            const roomInfo = log.roomName ? `<span style="color: #888;">[${escapeHtml(log.roomName)}]</span> ` : '';
            const modeBadge = formatLogModeBadge(log);
            const metaInfo = formatLogMeta(log);
            return `<div style="margin-bottom: 6px; padding: 4px 8px; border-left: 3px solid ${color}; background: rgba(255,255,255,0.03); font-size: 0.88rem; line-height: 1.4;">
                <span style="color: #888; font-family: monospace; font-size: 0.82rem; margin-right: 6px;">[${time}]</span> ${icon} ${modeBadge}${roomInfo}<span style="color: ${color};">${escapeHtml(log.message)}</span>${metaInfo}
            </div>`;
        }).join(''));
        
        // Auto scroll to top (newest)
        $container.scrollTop(0);
    }
    
    $('#logFilter, #logModeFilter').on('change', function() {
        renderLogs();
    });
    
    window.clearLogs = function() {
        Swal.fire({
            title: '🗑️ ล้าง Logs',
            text: 'ต้องการล้าง Logs ทั้งหมด?',
            showCancelButton: true,
            confirmButtonText: 'ล้าง',
            cancelButtonText: 'ยกเลิก',
            confirmButtonColor: '#e74c3c',
            background: '#1e1e1e',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                socket.emit('admin_clearLogs', function(response) {
                    if (response.success) {
                        serverLogs = [];
                        renderLogs();
                        Swal.fire({ icon: 'success', title: 'ล้าง Logs สำเร็จ', timer: 1000, showConfirmButton: false, background: '#1e1e1e', color: '#fff' });
                    }
                });
            }
        });
    };
    
    window.exportLogs = function() {
        const filtered = getFilteredLogs();
        if (filtered.length === 0) {
            Swal.fire({ icon: 'warning', title: 'ไม่มี Logs', background: '#1e1e1e', color: '#fff' });
            return;
        }
        const logsText = filtered.map(l => {
            const time = new Date(l.timestamp).toLocaleString('th-TH');
            const modeLabel = l.gameModeLabel ? `[${l.gameModeLabel}] ` : (l.gameMode ? `[${l.gameMode}] ` : '');
            const metaLabel = l.meta ? ` ${JSON.stringify(l.meta)}` : '';
            return `[${time}] [${l.category.toUpperCase()}] ${modeLabel}${l.roomName ? '[' + l.roomName + '] ' : ''}${l.message}${metaLabel}`;
        }).join('\n');
        const blob = new Blob([logsText], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'server_logs_' + new Date().toISOString().slice(0,10) + '.txt';
        a.click();
    };
    
    // Load logs after authentication
    socket.on('connect', function() {
        if (isAuthenticated) {
            authenticateAdminSocket({ silent: true });
        }
    });
    
    // ========== Settings Functions ==========
    let adminGameSettingsPayload = null;
    const MODE_SETTING_META = {
        insider: { emoji: '🎯', title: 'Insider', accent: '#3498db' },
        werewolf: { emoji: '🐺', title: 'Werewolf', accent: '#e74c3c' },
        blackmarket: { emoji: '🎩', title: 'Black Market', accent: '#f39c12' },
        spyfall: { emoji: '🕵️', title: 'Spyfall', accent: '#1abc9c' }
    };

    function renderGameSettingsModeCards() {
        const $container = $('#gameSettingsModeCards');
        if (!$container.length || !adminGameSettingsPayload) {
            return;
        }
        const stored = adminGameSettingsPayload.settings?.modes || {};
        const cards = (adminGameSettingsPayload.modeDefaults || []).map(function(mode) {
            const meta = MODE_SETTING_META[mode.id] || { emoji: '🎮', title: mode.label, accent: '#888' };
            const modeStored = stored[mode.id] || {};
            const maxVal = mode.defaultMaxPlayers != null ? mode.defaultMaxPlayers : mode.maxPlayers;
            let extraFields = '';
            if (mode.id !== 'werewolf') {
                const roundVal = modeStored.defaultRoundTimeMinutes != null
                    ? modeStored.defaultRoundTimeMinutes
                    : mode.defaultRoundTimeMinutes;
                const roundLabel = mode.id === 'spyfall' ? 'เวลาคุย (นาที)' : 'เวลารอบ (นาที)';
                extraFields += `
                    <label style="color:#888; font-size:0.85em; display:block; margin-bottom:4px;">${roundLabel}</label>
                    <input type="number" class="search-box mode-round-time" data-mode="${mode.id}" style="width:100%; margin-bottom:10px;" min="1" max="60" step="${mode.id === 'spyfall' ? '1' : '1'}" value="${roundVal}">
                `;
            }
            if (mode.id === 'spyfall') {
                const voteVal = modeStored.defaultVoteTimeMinutes != null
                    ? modeStored.defaultVoteTimeMinutes
                    : mode.defaultVoteTimeMinutes;
                extraFields += `
                    <label style="color:#888; font-size:0.85em; display:block; margin-bottom:4px;">เวลาโหวต (นาที)</label>
                    <input type="number" class="search-box mode-vote-time" data-mode="${mode.id}" style="width:100%; margin-bottom:10px;" min="0.5" max="10" step="0.5" value="${voteVal}">
                `;
            }
            if (mode.id === 'insider') {
                extraFields += `
                    <label style="display:flex; align-items:center; gap:8px; color:#ddd; font-size:0.9em; margin-bottom:8px; cursor:pointer;">
                        <input type="checkbox" class="mode-traitor-optional" data-mode="insider" ${modeStored.traitorOptional !== false ? 'checked' : ''}>
                        จอมบงการไม่บังคับ
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; color:#ddd; font-size:0.9em; cursor:pointer;">
                        <input type="checkbox" class="mode-dual-traitor" data-mode="insider" ${modeStored.dualTraitorDefault ? 'checked' : ''}>
                        เปิด 2 จอมบงการเป็นค่าเริ่มต้น
                    </label>
                `;
            }
            if (mode.id === 'werewolf') {
                extraFields += `<p style="color:#777; font-size:0.82em; margin:0;">Werewolf ใช้เวลาเฟสใน engine คงที่ — ปรับได้แค่จำนวนคนสูงสุด</p>`;
            }
            return `
                <div style="background:rgba(255,255,255,0.04); border:1px solid ${meta.accent}33; border-radius:12px; padding:14px;">
                    <div style="font-weight:700; color:${meta.accent}; margin-bottom:10px;">${meta.emoji} ${meta.title}</div>
                    <p style="color:#777; font-size:0.8em; margin:0 0 10px;">เล่นได้ ${mode.minPlayers}–${mode.maxPlayers} คน</p>
                    <label style="color:#888; font-size:0.85em; display:block; margin-bottom:4px;">ผู้เล่นสูงสุด (ค่าเริ่มต้น)</label>
                    <input type="number" class="search-box mode-max-players" data-mode="${mode.id}" style="width:100%; margin-bottom:10px;" min="${mode.minPlayers}" max="${mode.maxPlayers}" value="${maxVal}">
                    ${extraFields}
                </div>
            `;
        });
        $container.html(cards.join(''));
    }

    function collectGameSettingsForm() {
        const modes = {};
        $('.mode-max-players').each(function() {
            const modeId = $(this).data('mode');
            modes[modeId] = modes[modeId] || {};
            modes[modeId].defaultMaxPlayers = parseInt($(this).val(), 10);
        });
        $('.mode-round-time').each(function() {
            const modeId = $(this).data('mode');
            modes[modeId] = modes[modeId] || {};
            modes[modeId].defaultRoundTimeMinutes = parseFloat($(this).val());
        });
        $('.mode-vote-time').each(function() {
            const modeId = $(this).data('mode');
            modes[modeId] = modes[modeId] || {};
            modes[modeId].defaultVoteTimeMinutes = parseFloat($(this).val());
        });
        modes.insider = modes.insider || {};
        modes.insider.traitorOptional = $('.mode-traitor-optional').is(':checked');
        modes.insider.dualTraitorDefault = $('.mode-dual-traitor').is(':checked');
        return {
            modes: modes,
            insider: { wordFile: $('#insiderWordFile').val() },
            security: {
                banSystemEnabled: $('#enableBanSystem').is(':checked'),
                profanityFilterEnabled: $('#enableProfanityFilter').is(':checked'),
                requireNewPlayerApproval: $('#requireApproval').is(':checked')
            }
        };
    }

    function applyGameSettingsPayload(payload) {
        adminGameSettingsPayload = payload;
        const security = payload.settings?.security || {};
        $('#enableBanSystem').prop('checked', security.banSystemEnabled !== false);
        $('#enableProfanityFilter').prop('checked', !!security.profanityFilterEnabled);
        $('#requireApproval').prop('checked', !!security.requireNewPlayerApproval);
        const $wordSelect = $('#insiderWordFile');
        $wordSelect.empty();
        (payload.wordFiles || []).forEach(function(file) {
            $wordSelect.append(`<option value="${escapeHtml(file.id)}">${escapeHtml(file.filename)}</option>`);
        });
        $wordSelect.val(payload.settings?.insider?.wordFile || 'famille');
        $('#insiderWordCountBadge').text(`📚 ${payload.insiderWordCount || 0} คำในไฟล์ที่เลือก`);
        renderGameSettingsModeCards();
    }

    function loadGameSettingsTab() {
        socket.emit('admin_getGameSettings', {}, function(res) {
            if (res.success) {
                applyGameSettingsPayload(res);
            }
        });
    }


                    </div>
                    <button class="btn-admin btn-warning" onclick="resetSeason()" id="resetSeasonBtn" style="display:none;">🏆 ปิด Season / รีแรงค์</button>
                    <button class="btn-admin btn-primary" onclick="openImportSeason()">🗂️ นำเข้า Season ย้อนหลัง</button>
                    <button class="btn-admin btn-danger" onclick="clearAllStats()" id="clearAllStatsBtn" style="display:none;">🗑️ ลบทั้งหมด</button>
                    <button class="btn-admin btn-warning" onclick="deleteSelectedStats()" id="deleteSelectedBtn" style="display:none;">🗑️ ลบที่เลือก (<span id="selectedStatsCount">0</span>)</button>
                    <button class="btn-admin btn-primary" onclick="exportStats()">📥 Export CSV</button>
                    <button class="btn-admin btn-refresh" onclick="loadData()">🔄 รีเฟรช</button>
                </div>
            </div>
            <div class="table-meta" id="statsTableMeta">กำลังโหลดข้อมูลสถิติ...</div><p class="table-scroll-hint">← เลื่อนซ้าย–ขวาเพื่อดูตารางทั้งหมด →</p>
            
            <div class="table-container compact-table">
                <table>
                    <thead>
                        <tr>
                            <th style="width:40px;"><input type="checkbox" id="selectAllStats" onchange="toggleSelectAllStats(this)"></th>
                            <th class="sortable stats-sortable" data-sort="name" style="cursor:pointer;" onclick="setStatsSort('name')">ผู้เล่น <span class="sort-icon"></span></th>
                            <th class="sortable stats-sortable" data-sort="games" style="cursor:pointer;" onclick="setStatsSort('games')">เกม <span class="sort-icon"></span></th>
                            <th class="sortable stats-sortable" data-sort="wins" style="cursor:pointer;" onclick="setStatsSort('wins')">ชนะ <span class="sort-icon"></span></th>
                            <th class="sortable stats-sortable" data-sort="losses" style="cursor:pointer;" onclick="setStatsSort('losses')">แพ้ <span class="sort-icon"></span></th>
                            <th class="sortable stats-sortable" data-sort="winRate" style="cursor:pointer;" onclick="setStatsSort('winRate')">Win% <span class="sort-icon"></span></th>
                            <th>แยกตามโหมด</th>
                            <th>Insider</th>

    // ปิด season ปัจจุบัน: เก็บอันดับเป็นประวัติ แล้วรีเซ็ตสถิติทุกคน
    // กู้ season ที่ archive หายไปกับดิสก์ Render — admin รวบรวมจาก screenshot แล้ววางที่นี่
    window.openImportSeason = function() {
        Swal.fire({
            title: '🗂️ นำเข้า Season ย้อนหลัง',
            html:
                '<div style="text-align:left; color:#ccc; font-size:0.9em;">' +
                '<p style="margin:0 0 8px;">วางรายชื่อ <b>บรรทัดละคน</b> รูปแบบ: <code>ชื่อ, ชนะ, เกมทั้งหมด</code> (เกมไม่ใส่ก็ได้)</p>' +
                '<div style="display:flex; gap:8px; margin-bottom:8px;">' +
                '<input id="impSeasonNum" type="number" min="1" value="1" class="swal2-input" style="width:110px; margin:0;" placeholder="เลข season">' +
                '<input id="impSetCurrent" type="number" min="2" value="2" class="swal2-input" style="width:150px; margin:0;" placeholder="season ปัจจุบัน">' +
                '</div>' +
                '<textarea id="impEntries" class="swal2-textarea" style="margin:0; width:100%; height:220px; font-family:monospace; font-size:0.85em;" placeholder="Mark, 2000, 3500\nกี้, 150, 300\n..."></textarea>' +
                '<p style="margin:8px 0 0; color:#888; font-size:0.85em;">เลขซ้ำ = ทับของเดิม แก้ไขซ้ำได้จนกว่าจะพอใจ · ช่อง "season ปัจจุบัน" จะตั้งเลข season ที่กำลังเล่นให้ถูกต้อง (เว้นว่างถ้าไม่ต้องการ)</p>' +
                '</div>',
            width: 620,
            background: '#1e1e1e', color: '#fff',
            showCancelButton: true,
            confirmButtonText: 'พรีวิว',
            cancelButtonText: 'ยกเลิก',
            preConfirm: function() {
                const lines = ($('#impEntries').val() || '').split('\n').map(l => l.trim()).filter(Boolean);
                const entries = [];
                const bad = [];
                lines.forEach(function(line, i) {
                    const parts = line.split(/[,\t]/).map(x => x.trim());
                    const wins = Number(parts[1]);
                    if (!parts[0] || !Number.isFinite(wins)) { bad.push(i + 1); return; }
                    entries.push({ playerName: parts[0], wins: wins, totalGames: Number(parts[2]) || 0 });
                });
                if (bad.length) { Swal.showValidationMessage('บรรทัดที่อ่านไม่ได้: ' + bad.join(', ')); return false; }
                if (!entries.length) { Swal.showValidationMessage('ยังไม่มีข้อมูล'); return false; }
                return { number: Number($('#impSeasonNum').val()) || 1, setCurrentNumber: Number($('#impSetCurrent').val()) || undefined, entries: entries };
            }
        }).then(function(result) {
            if (!result.isConfirmed || !result.value) return;
            const p = result.value;
            const top = p.entries.slice().sort((a, b) => b.wins - a.wins).slice(0, 5)
                .map((e, i) => `${i + 1}. ${escapeHtml(e.playerName)} — ${e.wins} ชนะ`).join('<br>');
            Swal.fire({
                title: `ยืนยันนำเข้า Season ${p.number}?`,
                html: `<div style="text-align:left; color:#ccc;"><p>${p.entries.length} คน · top 5:</p><p style="font-family:monospace;">${top}</p>` +
                      (p.setCurrentNumber ? `<p>และตั้ง season ปัจจุบัน = Season ${p.setCurrentNumber}</p>` : '') + '</div>',
                background: '#1e1e1e', color: '#fff',
                showCancelButton: true, confirmButtonText: 'นำเข้าเลย', cancelButtonText: 'กลับไปแก้'
            }).then(function(confirm2) {
                if (!confirm2.isConfirmed) return;
                socket.emit('admin_importSeason', p, function(res) {
                    if (res && res.success) {
                        Swal.fire({ icon: 'success', title: `นำเข้า ${res.archived.name} แล้ว (${res.archived.totalPlayers} คน)`,
                            text: 'season ปัจจุบัน: ' + res.current.name, background: '#1e1e1e', color: '#fff' });
                    } else {
                        Swal.fire({ icon: 'error', title: 'นำเข้าไม่สำเร็จ', text: (res && res.error) || 'เกิดข้อผิดพลาด', background: '#1e1e1e', color: '#fff' });
                    }
                });
            });
        });
    };

    window.resetSeason = function() {
        socket.emit('admin_seasonPreview', function(info) {
            if (!info || !info.success) {
                Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: (info && info.error) || 'ดึงข้อมูล season ไม่ได้', background: '#1e1e1e', color: '#fff' });
                return;
            }

            if (!info.rankedCount) {
                Swal.fire({ icon: 'info', title: 'ยังไม่มีใครติดอันดับ', text: 'ต้องมีคนเล่นอย่างน้อย 1 เกมก่อนถึงจะปิด season ได้', background: '#1e1e1e', color: '#fff' });
                return;
            }

            const seasonName = info.season.name;
            const topThree = Array.isArray(info.topThree) ? info.topThree : [];
            const medals = ['🥇', '🥈', '🥉'];
            const topList = topThree.length
                ? '<ul style="text-align:left; margin:8px 0 12px 0; padding-left:22px; color:#ddd; font-size:0.9em;">' +
                  topThree.map((entry, index) =>
                      `<li>${medals[index]} <strong>${escapeHtml(entry.playerName)}</strong> — ${entry.wins} ชนะ / ${entry.totalGames} เกม</li>`
                  ).join('') + '</ul>'
                : '';

            Swal.fire({
                title: '🏆 ปิด ' + escapeHtml(seasonName),
                html:
                    '<div style="text-align:left; color:#ccc; font-size:0.92em;">' +
                    `<p style="margin:0 0 10px 0;">จะเก็บอันดับ <strong style="color:#ffd700;">${info.rankedCount} คน</strong> ไว้เป็นประวัติ ` +
                    `แล้ว<strong style="color:#e74c3c;">ล้างสถิติของทุกคน (${info.totalPlayers} คน) เป็น 0</strong> เพื่อเริ่ม season ถัดไป</p>` +
                    (topList ? `<p style="margin:0 0 4px 0; color:#aaa;">แชมป์ที่จะถูกบันทึก:</p>${topList}` : '') +
                    '<p style="margin:0 0 10px 0; color:#888; font-size:0.9em;">ผู้เล่นจะเห็นประกาศรีแรงค์ในหน้าแรก และดูอันดับเก่าได้จากแท็บ season บน leaderboard</p>' +
                    `<p style="margin:0; color:#e74c3c;">พิมพ์ <strong>${escapeHtml(seasonName)}</strong> เพื่อยืนยัน</p>` +
                    '</div>',
                input: 'text',
                inputPlaceholder: seasonName,
                inputAttributes: { autocapitalize: 'off', autocorrect: 'off' },
                showCancelButton: true,
                confirmButtonText: 'ปิด season และรีแรงค์',
                cancelButtonText: 'ยกเลิก',
                confirmButtonColor: '#e67e22',
                background: '#1e1e1e',
                color: '#fff',
                preConfirm: (typed) => {
                    if (String(typed || '').trim().toLowerCase() !== seasonName.toLowerCase()) {
                        Swal.showValidationMessage(`ต้องพิมพ์ "${seasonName}" ให้ตรง`);
                        return false;
                    }
                    return String(typed).trim();
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                socket.emit('admin_resetSeason', { confirmName: result.value }, function(res) {
                    if (res && res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: `เริ่ม ${res.currentName} แล้ว`,
                            html:
                                `เก็บอันดับ ${res.archivedCount} คนไว้เป็น "${escapeHtml(res.archivedName)}"<br>` +
                                `รีเซ็ตสถิติ ${res.resetCount} คน` +
                                (res.backupFile ? `<br><span style="color:#888; font-size:0.85em;">สำรองไว้ที่ ${escapeHtml(res.backupFile)}</span>` : ''),
                            background: '#1e1e1e',
                            color: '#fff'
                        });
                        loadData();
                    } else {
                        Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: (res && res.error) || 'รีแรงค์ไม่สำเร็จ', background: '#1e1e1e', color: '#fff' });
                    }
                });
            });
        });
    };


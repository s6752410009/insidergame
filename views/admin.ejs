    <!-- System Tab -->
    <div class="tab-content" id="tab-system">
        <div class="panel">
            <div class="panel-header">
                <h2>📢 ประกาศ (Broadcast)</h2>
            </div>
            <textarea class="broadcast-input" id="broadcastMessage" placeholder="พิมพ์ข้อความที่ต้องการประกาศให้ทุกคน..."></textarea>
            <button class="btn-admin btn-primary" onclick="sendBroadcast()" style="width: 100%; padding: 15px; font-size: 1.1em;">📢 ส่งประกาศ</button>
        </div>
        
        <div class="panel">
            <div class="panel-header">
                <h2>⚡ Quick Actions</h2>
            </div>
            <div class="quick-actions">
                <button class="quick-action-btn warning" onclick="clearEmptyRooms()">
                    <span class="icon">🧹</span>
                    ล้างห้องว่าง
                </button>
                <button class="quick-action-btn danger" onclick="clearAllRooms()">
                    <span class="icon">💥</span>
                    ล้างห้องทั้งหมด
                </button>
                <button class="quick-action-btn success" onclick="exportAllData()">
                    <span class="icon">📥</span>
                    Export ข้อมูลทั้งหมด
                </button>
                <button class="quick-action-btn primary" onclick="loadData()">
                    <span class="icon">🔄</span>
                    รีเฟรชข้อมูล
                </button>
            </div>
        </div>
        
        <div class="panel">
            <div class="panel-header">
                <h2>ℹ️ ข้อมูลระบบ</h2>
            </div>
            <div style="color: #aaa; line-height: 2;">
                <p>📦 <strong>Version:</strong> <%= appVersion %> <span style="background: #e74c3c; color: #fff; padding: 2px 8px; border-radius: 10px; font-size: 0.8em; margin-left: 10px;">LIVE</span></p>
                <p>🖥️ <strong>Server:</strong> Node.js + Express + Socket.IO</p>
                <p>💾 <strong>Data Storage:</strong> JSON Files (players.json, playerStats.json, bannedPlayers.json)</p>
                <p>🕐 <strong>Server Time:</strong> <span id="serverTime">-</span></p>
                <p>⏱️ <strong>Uptime:</strong> <span id="uptime">-</span></p>
            </div>
            <div style="margin-top: 20px; padding-top: 15px; border-top: 1px solid #444;">
                <h4 style="color: #f39c12; margin-bottom: 10px;">🆕 What's New in v<%= appVersion %></h4>
                <ul style="color: #888; line-height: 1.8; padding-left: 20px;">
                    <li>ไอคอน SVG ประจำเกมครบทุกโหมด (บทบาท/ไอเทม/สถานที่) + แก้บัคกติกา 20 จุดจากการ audit</li>
                    <li>Spyfall: สายลับออกกลางเกม = จบเกมพลเมืองชนะ, เลิกสุ่มโหวตแทนคนไม่โหวต</li>
                    <li>Werewolf: ยิงกลางคืนเคารพการป้องกัน, เกณฑ์โหวตตรงจริง, ตัวตลกนับเป็นตัวโหวต</li>
                    <li>Black Market: กันยิงเป้าที่ตาย, พาสปลอมติดตัวถาวร, ตายหมู่เกมจบทันที</li>
                    <li>เสถียรภาพ: kick/leave/ban กลางเกม resync ทันที, restart ไม่ resolve รวด, กันปุ่มกดรัว</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<%- contentFor('script') %>
<script>
$(function() {
    const socket = window.appSocket || io();
    let allData = {};
    let isAuthenticated = false;
    let selectedInboxPlayerId = null;
    let adminInboxThreads = [];
    const dashboardState = {
        players: {
            search: '',
            typeFilter: 'all',
            statusFilter: 'all',
            sortCol: 'lastSeen',
            sortDir: 'desc',
            selectedIds: new Set()
        },
        rooms: {
            search: '',
            modeFilter: 'all',
            statusFilter: 'all',
            sortCol: 'players',
            sortDir: 'desc'
        },
        stats: {
            search: '',
            modeFilter: 'all',
            sortCol: 'games',
            sortDir: 'desc',
            selectedIds: new Set()
        }
    };
    const WEREWOLF_ROLE_META = [
        { id: 'villager', label: 'ชาวบ้าน', emoji: '🙂' },
        { id: 'werewolf', label: 'หมาป่า', emoji: '🐺' },
        { id: 'alphaWolf', label: 'อัลฟ่าหมาป่า', emoji: '👑' },
        { id: 'seer', label: 'ผู้หยั่งรู้', emoji: '🔮' },
        { id: 'doctor', label: 'หมอ', emoji: '💉' },
        { id: 'witch', label: 'แม่มด', emoji: '🧪' },
        { id: 'bodyguard', label: 'บอดี้การ์ด', emoji: '🛡️' },
        { id: 'mayor', label: 'นายก', emoji: '🎖️' },
        { id: 'revealer', label: 'จอมเปิดโปง', emoji: '💥' },
        { id: 'fool', label: 'คนบ้า', emoji: '🤪' }
    ];
    const BLACKMARKET_ROLE_META = [
        { id: 'boss', label: 'เจ้าพ่อ', emoji: '🎩' },
        { id: 'broker', label: 'นายหน้า', emoji: '🕴️' },
        { id: 'smuggler', label: 'คนส่งของ', emoji: '🚚' },
        { id: 'fixer', label: 'คนเคลียร์ทาง', emoji: '🧹' },
        { id: 'hitman', label: 'มือเก็บงาน', emoji: '🔫' },
        { id: 'mole', label: 'สายข่าว', emoji: '🕶️' },
        { id: 'doubleAgent', label: 'สองหน้า', emoji: '🃏' }
    ];

    function renderModeSummary(modeStats) {
        const insider = modeStats?.insider || {};
        const werewolf = modeStats?.werewolf || {};
        const blackmarket = modeStats?.blackmarket || {};
        const spyfall = modeStats?.spyfall || {};
        const coup = modeStats?.coup || {};
        const liar = modeStats?.liar || {};
        const poker5 = modeStats?.poker5 || {};
        const poker4 = modeStats?.poker4 || {};
        return `
            <div style="display:grid; gap:6px; min-width:170px;">
                <div style="display:flex; flex-wrap:wrap; gap:6px;"><span class="status-badge status-playing">🎯 Insider ${insider.games || 0} เกม</span><span class="status-badge status-online">🏆 ${insider.wins || 0}W</span><span class="status-badge status-offline">💀 ${insider.losses || 0}L</span></div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;"><span class="status-badge status-waiting">🐺 Werewolf ${werewolf.games || 0} เกม</span><span class="status-badge status-online">🏆 ${werewolf.wins || 0}W</span><span class="status-badge status-offline">💀 ${werewolf.losses || 0}L</span></div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;"><span class="status-badge status-banned">🎩 Black Market ${blackmarket.games || 0} เกม</span><span class="status-badge status-online">🏆 ${blackmarket.wins || 0}W</span><span class="status-badge status-offline">💀 ${blackmarket.losses || 0}L</span></div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;"><span class="status-badge status-online">🕵️ Spyfall ${spyfall.games || 0} เกม</span><span class="status-badge status-online">🏆 ${spyfall.wins || 0}W</span><span class="status-badge status-offline">💀 ${spyfall.losses || 0}L</span></div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;"><span class="status-badge status-waiting">👑 Coup ${coup.games || 0} เกม</span><span class="status-badge status-online">🏆 ${coup.wins || 0}W</span><span class="status-badge status-offline">💀 ${coup.losses || 0}L</span></div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;"><span class="status-badge status-banned">🃏 ไพ่โกหก ${liar.games || 0} เกม</span><span class="status-badge status-online">🏆 ${liar.wins || 0}W</span><span class="status-badge status-offline">💀 ${liar.losses || 0}L</span></div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;"><span class="status-badge status-playing">♠ ไพ่ 5 ใบ ${poker5.games || 0} เกม</span><span class="status-badge status-online">🏆 ${poker5.wins || 0}W</span><span class="status-badge status-offline">💀 ${poker5.losses || 0}L</span></div>
                <div style="display:flex; flex-wrap:wrap; gap:6px;"><span class="status-badge status-banned">♦ สี่ใบเก ${poker4.games || 0} เกม</span><span class="status-badge status-online">🏆 ${poker4.wins || 0}W</span><span class="status-badge status-offline">💀 ${poker4.losses || 0}L</span></div>
            </div>
        `;
    }

    function renderInsiderRoleSummary(roleStats) {
        return `
            <div style="display:flex; flex-wrap:wrap; gap:6px; min-width:150px;">
                <span class="status-badge status-playing">👑 GM ${roleStats?.gameMasterCount || 0}</span>
                <span class="status-badge status-banned">🔴 ทรยศ ${roleStats?.traitorCount || 0}</span>
                <span class="status-badge status-online">🔵 พลเมือง ${roleStats?.citizenCount || 0}</span>
            </div>
        `;
    }

    function renderWerewolfRoleSummary(roleStats) {
        const nonZeroRoles = WEREWOLF_ROLE_META.filter(role => Number(roleStats?.werewolf?.[role.id] || 0) > 0);
        if (!nonZeroRoles.length) {
            return '<span style="color:#888;">ยังไม่มีสถิติ Werewolf</span>';
        }

        return `<div style="display:flex; flex-wrap:wrap; gap:6px; min-width:220px;">${nonZeroRoles.map(role => `<span class="status-badge status-guest">${role.emoji} ${role.label} ${roleStats.werewolf[role.id] || 0}</span>`).join('')}</div>`;
    }

    function renderBlackMarketRoleSummary(roleStats, winByRole) {
        const nonZeroRoles = BLACKMARKET_ROLE_META.filter(role => Number(roleStats?.blackmarket?.[role.id] || 0) > 0);
        if (!nonZeroRoles.length) {
            return '<span style="color:#888;">ยังไม่มีสถิติ Black Market</span>';
        }

        return `<div style="display:flex; flex-wrap:wrap; gap:6px; min-width:240px;">${nonZeroRoles.map(role => `<span class="status-badge status-banned">${role.emoji} ${role.label} ${roleStats.blackmarket[role.id] || 0} <small style="opacity:0.85;">W${winByRole?.blackmarket?.[role.id] || 0}</small></span>`).join('')}</div>`;
    }
    
    // Admin token จาก server (ใช้ re-authenticate ได้ภายใน 60 วินาที)
    const adminToken = '<%= adminToken %>';

    function authenticateAdminSocket(options) {
        const silent = Boolean(options?.silent);
        socket.emit('admin_authenticate', { token: adminToken }, function(response) {
            if (response.success) {
                isAuthenticated = true;
                loadData();
                loadLogs();
                loadGameSettingsTab();
                loadAdminInbox();
            } else if (!silent) {
                console.error('[Admin] Authentication failed:', response.error);
                Swal.fire({
                    icon: 'error',
                    title: 'Authentication Failed',
                    text: response.error || 'กรุณา login ใหม่',
                    confirmButtonText: 'Login ใหม่'
                }).then(() => {
                    window.location.href = '/admin/login';
                });
            }
        });
    }

    authenticateAdminSocket();
    
    // Tab switching
    $('.tab-btn').on('click', function() {
        const tab = $(this).data('tab');
        $('.tab-btn').removeClass('active');
        $(this).addClass('active');
        $('.tab-content').removeClass('active');
        $('#tab-' + tab).addClass('active');
        if (tab === 'settings') {
            loadGameSettingsTab();
        }
        if (tab === 'messages') {
            loadAdminInbox();
        }
    });

    $('#adminInboxBell').on('click', function() {
        $('.tab-btn[data-tab="messages"]').trigger('click');
        document.querySelector('.tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    
    // Search players
    $('#searchPlayers').on('input', function() {
        dashboardState.players.search = $(this).val() || '';
        updatePlayersTable(allData.players || [], allData.bannedPlayers || []);
    });

    $('#playerTypeFilter').on('change', function() {
        dashboardState.players.typeFilter = $(this).val() || 'all';
        updatePlayersTable(allData.players || [], allData.bannedPlayers || []);
    });

    $('#playerStatusFilter').on('change', function() {
        dashboardState.players.statusFilter = $(this).val() || 'all';
        updatePlayersTable(allData.players || [], allData.bannedPlayers || []);
    });

    $('#searchRooms').on('input', function() {
        dashboardState.rooms.search = $(this).val() || '';
        updateRoomsTable(allData.rooms || []);
    });

    $('#roomModeFilter').on('change', function() {
        dashboardState.rooms.modeFilter = $(this).val() || 'all';
        updateRoomsTable(allData.rooms || []);
    });

    $('#roomStatusFilter').on('change', function() {
        dashboardState.rooms.statusFilter = $(this).val() || 'all';
        updateRoomsTable(allData.rooms || []);
    });

    $('#searchStats').on('input', function() {
        dashboardState.stats.search = $(this).val() || '';
        updateStatsTable(allData.playerStats || []);
    });

    $('#statsModeFilter').on('change', function() {
        dashboardState.stats.modeFilter = $(this).val() || 'all';
        updateStatsTable(allData.playerStats || []);
    });

    function updateSortIcons(selector, activeCol, dir) {
        $(`${selector} .sort-icon`).html('');
        $(selector).removeClass('active');
        $(`${selector}[data-sort="${activeCol}"]`).addClass('active').find('.sort-icon').html(dir === 'asc' ? '↑' : '↓');
    }

    window.setSort = function(col) {
        if (dashboardState.players.sortCol === col) {
            dashboardState.players.sortDir = dashboardState.players.sortDir === 'asc' ? 'desc' : 'asc';
        } else {
            dashboardState.players.sortCol = col;
            dashboardState.players.sortDir = col === 'name' || col === 'category' || col === 'id' ? 'asc' : 'desc';
        }
        updateSortIcons('.sortable:not(.room-sortable):not(.stats-sortable)', dashboardState.players.sortCol, dashboardState.players.sortDir);
        updatePlayersTable(allData.players || [], allData.bannedPlayers || []);
    };

    window.setRoomSort = function(col) {
        if (dashboardState.rooms.sortCol === col) {
            dashboardState.rooms.sortDir = dashboardState.rooms.sortDir === 'asc' ? 'desc' : 'asc';
        } else {
            dashboardState.rooms.sortCol = col;
            dashboardState.rooms.sortDir = col === 'name' || col === 'id' || col === 'mode' ? 'asc' : 'desc';
        }
        updateSortIcons('.room-sortable', dashboardState.rooms.sortCol, dashboardState.rooms.sortDir);
        updateRoomsTable(allData.rooms || []);
    };

    window.setStatsSort = function(col) {
        if (dashboardState.stats.sortCol === col) {
            dashboardState.stats.sortDir = dashboardState.stats.sortDir === 'asc' ? 'desc' : 'asc';
        } else {
            dashboardState.stats.sortCol = col;
            dashboardState.stats.sortDir = col === 'name' ? 'asc' : 'desc';
        }
        updateSortIcons('.stats-sortable', dashboardState.stats.sortCol, dashboardState.stats.sortDir);
        updateStatsTable(allData.playerStats || []);
    };
    
    // Load data from server
    window.loadData = function() {
        if (!isAuthenticated) {
            return;
        }
        socket.emit('admin_getData', function(response) {
            if (response.success) {
                allData = response;
                updateStats(response);
                updatePlayersTable(response.players, response.bannedPlayers);
                updateSiteAdminsTable(response.siteAdmins || []);
                updateRoomsTable(response.rooms);
                updateBannedTable(response.bannedPlayers);
                updateStatsTable(response.playerStats);
            } else if (response.error === 'Unauthorized - กรุณา login ก่อน') {
                // Token หมดอายุ หรือยังไม่ได้ authenticate
                Swal.fire({
                    icon: 'warning',
                    title: 'Session หมดอายุ',
                    text: 'กรุณา login ใหม่',
                    confirmButtonText: 'Login'
                }).then(() => {
                    window.location.href = '/admin/login';
                });
            }
        });
    };
    
    function updateStats(data) {
        $('#totalPlayers').text(data.players.length);
        $('#totalRooms').text(data.rooms.length);
        $('#playingRooms').text(data.rooms.filter(r => r.gameStatus === 'playing').length);
        $('#bannedPlayers').text(data.bannedPlayers ? data.bannedPlayers.length : 0);
        const totalGames = data.playerStats.reduce((sum, p) => sum + (p.totalGames || 0), 0) / 2;
        $('#totalGames').text(Math.floor(totalGames));
        $('#realPlayers').text(data.playerSummary?.realPlayers || 0);
        $('#ghostPlayers').text(data.playerSummary?.cleanupCandidates || 0);
        $('#summaryRealPlayers').text(data.playerSummary?.realPlayers || 0);
        $('#summaryGuestActivePlayers').text(data.playerSummary?.guestActivePlayers || 0);
        $('#summaryGuestIdlePlayers').text(data.playerSummary?.guestIdlePlayers || 0);
        $('#summaryCleanupCandidates').text(data.playerSummary?.cleanupCandidates || 0);
        $('#cleanupSummaryText').text(`cleanup candidate = guest อัตโนมัติที่ไม่เคยเล่น, ไม่อยู่ในห้อง, ไม่ถูกแบน, และใช้โปรไฟล์ default อยู่ จำนวนล่าสุด ${data.cleanupCandidates ? data.cleanupCandidates.length : 0} คน`);
        $('#siteAdminsMeta').text(`site admin ทั้งหมด ${data.siteAdmins ? data.siteAdmins.length : 0} คน`);
        $('#serverTime').text(new Date().toLocaleString('th-TH'));
    }

    function isPlayerRecent(player) {
        return Boolean(player.lastSeen) && (Date.now() - new Date(player.lastSeen).getTime()) < 5 * 60 * 1000;
    }

    function getPlayerStatusKey(player, bannedIds) {
        if (bannedIds.includes(player.playerId)) return 'banned';
        if (player.isCleanupCandidate) return 'cleanup';
        return isPlayerRecent(player) ? 'online' : 'offline';
    }

    function compareValues(valA, valB, dir) {
        if (valA < valB) return dir === 'asc' ? -1 : 1;
        if (valA > valB) return dir === 'asc' ? 1 : -1;
        return 0;
    }

    function pruneSelection(selectedIds, validIds) {
        Array.from(selectedIds).forEach(function(id) {
            if (!validIds.has(id)) {
                selectedIds.delete(id);
            }
        });
    }

    function updatePlayersTable(players, bannedPlayers) {
        const $table = $('#playersTable');
        $table.empty();

        const playerList = Array.isArray(players) ? [...players] : [];
        pruneSelection(dashboardState.players.selectedIds, new Set(playerList.map(player => player.playerId)));
        if (playerList.length === 0) {
            $table.html('<tr><td colspan="8" class="empty-message">ไม่มีผู้เล่น</td></tr>');
            $('#playersTableMeta').text('ไม่มีผู้เล่น');
            $('#selectAllPlayers').prop('checked', false);
            updateSelectedPlayersCount();
            return;
        }

        const bannedIds = (bannedPlayers || []).map(b => b.playerId);

        playerList.sort((a, b) => {
            let valA, valB;
            switch(dashboardState.players.sortCol) {
                case 'name':
                    valA = (a.playerName || '').toLowerCase();
                    valB = (b.playerName || '').toLowerCase();
                    break;
                case 'category':
                    valA = a.category || '';
                    valB = b.category || '';
                    break;
                case 'id':
                    valA = a.playerId || '';
                    valB = b.playerId || '';
                    break;
                case 'status':
                    const getStatusScore = p => {
                        const key = getPlayerStatusKey(p, bannedIds);
                        if (key === 'online') return 3;
                        if (key === 'offline') return 2;
                        if (key === 'cleanup') return 1;
                        return 0;
                    };
                    valA = getStatusScore(a);
                    valB = getStatusScore(b);
                    break;
                case 'games':
                    valA = a.totalGames || 0;
                    valB = b.totalGames || 0;
                    break;
                case 'lastSeen':
                default:
                    valA = a.lastSeen ? new Date(a.lastSeen).getTime() : 0;
                    valB = b.lastSeen ? new Date(b.lastSeen).getTime() : 0;
                    break;
            }
            return compareValues(valA, valB, dashboardState.players.sortDir)
                || compareValues((a.playerName || '').toLowerCase(), (b.playerName || '').toLowerCase(), 'asc');
        });

        const filteredPlayers = playerList.filter(function(player) {
            const search = dashboardState.players.search.trim().toLowerCase();
            const typeFilter = dashboardState.players.typeFilter;
            const statusFilter = dashboardState.players.statusFilter;
            const text = `${player.playerName || ''} ${player.playerId || ''} ${player.category || ''}`.toLowerCase();
            const statusKey = getPlayerStatusKey(player, bannedIds);
            const matchesSearch = !search || text.includes(search);
            const matchesType = typeFilter === 'all' || (player.category || 'unknown') === typeFilter;
            const matchesStatus = statusFilter === 'all' || statusKey === statusFilter;
            return matchesSearch && matchesType && matchesStatus;
        });

        if (filteredPlayers.length === 0) {
            $table.html('<tr><td colspan="8" class="empty-message">ไม่พบผู้เล่นที่ตรงเงื่อนไข</td></tr>');
            $('#playersTableMeta').text(`แสดง 0 จาก ${playerList.length} คน`);
            $('#selectAllPlayers').prop('checked', false);
            updateSelectedPlayersCount();
            return;
        }

        filteredPlayers.forEach(function(player) {
            const lastSeen = player.lastSeen ? new Date(player.lastSeen).toLocaleString('th-TH') : '-';
            const isBanned = bannedIds.includes(player.playerId);
            const isRecent = isPlayerRecent(player);
            const categoryClass = player.category === 'ghost'
                ? 'status-ghost'
                : (player.category === 'real' ? 'status-real' : 'status-guest');
            
            const statusBadge = isBanned 
                ? '<span class="status-badge status-banned">แบน</span>'
                : (player.isPendingApproval
                    ? '<span class="status-badge status-playing">รออนุมัติ</span>'
                    : (player.isCleanupCandidate
                    ? '<span class="status-badge status-ghost">cleanup</span>'
                    : (isRecent ? '<span class="status-badge status-online">ออนไลน์</span>' : '<span class="status-badge status-offline">ออฟไลน์</span>')));
            const categoryBadge = `<span class="status-badge ${categoryClass}">${escapeHtml(player.categoryLabel || player.category || 'unknown')}</span>`;
            
            const actions = isBanned 
                ? `<button class="action-btn unban" onclick="unbanPlayer('${player.playerId}')">ปลดแบน</button>`
                : `<button class="action-btn ban" onclick="banPlayer('${player.playerId}', '${escapeHtml(player.playerName)}')">แบน</button>`;
            const approvalAction = player.isPendingApproval
                ? `<button class="action-btn success" onclick="setPlayerApproval('${player.playerId}', true, '${escapeHtml(player.playerName)}')">อนุมัติ</button>`
                : (player.approved === false
                    ? `<button class="action-btn success" onclick="setPlayerApproval('${player.playerId}', true, '${escapeHtml(player.playerName)}')">อนุมัติ</button>`
                    : '');
            const displayName = escapeHtml(player.displayName || player.playerName);
            const siteAdminBadge = player.isSiteAdmin ? '<span class="status-badge status-banned" style="margin-left:8px;">Site Admin</span>' : '';
            const siteAdminAction = player.isSiteAdmin
                ? `<button class="action-btn unlock" onclick="setSiteAdmin('${player.playerId}', false, '${escapeHtml(player.playerName)}')">ถอด admin</button>`
                : `<button class="action-btn view" onclick="setSiteAdmin('${player.playerId}', true, '${escapeHtml(player.playerName)}')">ตั้ง admin</button>`;
            
            const row = `
                <tr data-player-id="${player.playerId}" data-player-category="${escapeHtml(player.category || 'unknown')}">
                    <td><input type="checkbox" class="player-checkbox" data-player-id="${player.playerId}" data-player-name="${escapeHtml(player.playerName)}" ${dashboardState.players.selectedIds.has(player.playerId) ? 'checked' : ''}></td>
                    <td>
                        <span class="player-color" style="background: ${player.color}"></span>
                        ${displayName}
                        ${siteAdminBadge}
                        ${player.isCleanupCandidate ? '<div class="last-seen" style="color:#f39c12;">candidate for cleanup</div>' : ''}
                    </td>
                    <td>${categoryBadge}</td>
                    <td><code style="font-size: 0.8em; color: #888;">${player.playerId.substring(0, 8)}...</code></td>
                    <td>${statusBadge}</td>
                    <td>${player.totalGames || 0}</td>
                    <td class="last-seen">${lastSeen}</td>
                    <td>
                        ${actions}
                        ${approvalAction}
                        ${siteAdminAction}
                        <button class="action-btn edit" onclick="editPlayerName('${player.playerId}', '${escapeHtml(player.playerName)}')">แก้ไข</button>
                        <button class="action-btn delete" onclick="deletePlayer('${player.playerId}', '${escapeHtml(player.playerName)}')">ลบ</button>
                    </td>
                </tr>
            `;
            $table.append(row);
        });

        $('#playersTableMeta').text(`แสดง ${filteredPlayers.length} จาก ${playerList.length} คน`);
        $('#playersTable .player-checkbox').on('change', function() {
            const playerId = $(this).data('player-id');
            if ($(this).is(':checked')) {
                dashboardState.players.selectedIds.add(playerId);
            } else {
                dashboardState.players.selectedIds.delete(playerId);
            }
            updateSelectedPlayersCount();
        });
        updateSelectedPlayersCount();
        const visibleCheckboxes = $('#playersTable .player-checkbox');
        $('#selectAllPlayers').prop('checked', visibleCheckboxes.length > 0 && visibleCheckboxes.filter(':checked').length === visibleCheckboxes.length);
    }

    function updateSiteAdminsTable(siteAdmins) {

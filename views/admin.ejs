    </div>
    
    <!-- Game Settings Tab -->
    <div class="tab-content" id="tab-settings">
        <div class="panel" style="border: 1px solid rgba(46, 204, 113, 0.25);">
            <div class="panel-header" style="flex-wrap: wrap; gap: 12px;">
                <div>
                    <h2>⚙️ ตั้งค่าเกม (ทุกโหมด)</h2>
                    <p style="color: #888; margin: 6px 0 0; font-size: 0.9em;">ค่าเริ่มต้นเมื่อสร้างห้องใหม่ — แต่ละห้องยังปรับใน Lobby ได้</p>
                </div>
                <button class="btn-admin btn-success" onclick="saveGameSettings()">💾 บันทึกทั้งหมด</button>
            </div>
            <div id="gameSettingsModeCards" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;"></div>
        </div>
        
                <div class="panel">

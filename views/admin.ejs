    function updateRoomsTable(rooms) {
        const $table = $('#roomsTable');
        $table.empty();

        const roomList = Array.isArray(rooms) ? [...rooms] : [];
        if (roomList.length === 0) {
            $table.html('<tr><td colspan="7" class="empty-message">ไม่มีห้อง</td></tr>');
            $('#roomsTableMeta').text('ไม่มีห้อง');
            return;
        }

        roomList.sort(function(a, b) {
            let valA;
            let valB;
            switch (dashboardState.rooms.sortCol) {
                case 'name':
                    valA = (a.name || '').toLowerCase();
                    valB = (b.name || '').toLowerCase();
                    break;
                case 'id':
                    valA = (a.roomId || '').toLowerCase();
                    valB = (b.roomId || '').toLowerCase();
                    break;
                case 'mode':
                    valA = (a.gameMode || 'insider').toLowerCase();
                    valB = (b.gameMode || 'insider').toLowerCase();
                    break;
                case 'status':
                    valA = a.gameStatus === 'playing' ? 1 : 0;
                    valB = b.gameStatus === 'playing' ? 1 : 0;
                    break;
                case 'locked':
                    valA = a.locked ? 1 : 0;
                    valB = b.locked ? 1 : 0;
                    break;
                case 'players':
                default:
                    valA = Number(a.playerCount || 0);
                    valB = Number(b.playerCount || 0);
                    break;
            }
            return compareValues(valA, valB, dashboardState.rooms.sortDir)
                || compareValues((a.name || '').toLowerCase(), (b.name || '').toLowerCase(), 'asc');
        });

        const filteredRooms = roomList.filter(function(room) {
            const search = dashboardState.rooms.search.trim().toLowerCase();
            const modeFilter = dashboardState.rooms.modeFilter;
            const statusFilter = dashboardState.rooms.statusFilter;
            const mode = room.gameMode || 'insider';
            const status = room.gameStatus === 'playing' ? 'playing' : 'waiting';
            const lockStatus = room.locked ? 'locked' : 'unlocked';
            const haystack = `${room.name || ''} ${room.roomId || ''} ${mode} ${(room.playerNames || []).join(' ')}`.toLowerCase();
            const matchesSearch = !search || haystack.includes(search);
            const matchesMode = modeFilter === 'all' || mode === modeFilter;
            const matchesStatus = statusFilter === 'all' || status === statusFilter || lockStatus === statusFilter;
            return matchesSearch && matchesMode && matchesStatus;
        });

        if (filteredRooms.length === 0) {
            $table.html('<tr><td colspan="7" class="empty-message">ไม่พบห้องที่ตรงเงื่อนไข</td></tr>');
            $('#roomsTableMeta').text(`แสดง 0 จาก ${roomList.length} ห้อง`);
            return;
        }

        filteredRooms.forEach(function(room) {
            const statusClass = room.gameStatus === 'playing' ? 'status-playing' : 'status-waiting';
            const statusText = room.gameStatus === 'playing' ? 'กำลังเล่น' : 'รอผู้เล่น';
            const roomMode = room.gameMode || 'insider';
            const modeBadge = formatRoomModeBadgeHtml(roomMode);
            
            const row = `
                <tr>
                    <td>${escapeHtml(room.name)}</td>
                    <td><code style="font-size: 0.85em; color: #888;">${room.roomId}</code></td>
                    <td>${modeBadge}</td>
                    <td>${room.playerCount} / ${room.maxPlayers}</td>
                    <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                    <td>${room.locked ? '🔒' : '🔓'}</td>
                    <td>
                        <button class="action-btn view" onclick="viewRoomDetails('${room.roomId}', '${escapeHtml(room.name)}')">👁️ ดู</button>
                        ${room.locked ? `<button class="action-btn unlock" onclick="unlockRoom('${room.roomId}')">ปลดล็อค</button>` : ''}
                        <button class="action-btn reset" onclick="resetRoom('${room.roomId}')">รีเซ็ต</button>
                        <button class="action-btn close" onclick="closeRoom('${room.roomId}', '${escapeHtml(room.name)}')">ปิดห้อง</button>
                    </td>
                </tr>
            `;
            $table.append(row);
        });

        $('#roomsTableMeta').text(`แสดง ${filteredRooms.length} จาก ${roomList.length} ห้อง`);
    }

    function updateBannedTable(bannedPlayers) {
        const $table = $('#bannedTable');
        $table.empty();
        
        if (!bannedPlayers || bannedPlayers.length === 0) {
            $table.html('<tr><td colspan="7" class="empty-message">ไม่มีผู้เล่นที่ถูกแบน</td></tr>');
            return;
        }
        
        bannedPlayers.forEach(function(ban) {
            const bannedAt = new Date(ban.bannedAt).toLocaleString('th-TH');
            
            // คำนวณระยะเวลาที่เหลือ
            let durationText = '';
            let remainingText = '';
            
            if (ban.isPermanent || !ban.expiresAt) {
                durationText = '<span style="color: #e74c3c;">ถาวร ♾️</span>';
                remainingText = '<span style="color: #e74c3c;">-</span>';
            } else {
                const expiresAt = new Date(ban.expiresAt);
                const now = new Date();
                const remainingMs = expiresAt - now;
                
                if (remainingMs <= 0) {
                    durationText = `${ban.durationHours} ชม.`;
                    remainingText = '<span style="color: #2ecc71;">หมดอายุแล้ว</span>';
                } else {
                    const hours = Math.floor(remainingMs / (1000 * 60 * 60));
                    const minutes = Math.floor((remainingMs % (1000 * 60 * 60)) / (1000 * 60));
                    durationText = `${ban.durationHours} ชม.`;
                    remainingText = hours > 0 ? `${hours} ชม. ${minutes} น.` : `${minutes} นาที`;
                }
            }
            
            const row = `
                <tr>
                    <td>${escapeHtml(ban.playerName)}</td>
                    <td><code style="font-size: 0.8em; color: #888;">${ban.playerId.substring(0, 8)}...</code></td>
                    <td>${escapeHtml(ban.reason)}</td>
                    <td>${durationText}</td>
                    <td style="color: #f39c12;">${remainingText}</td>
                    <td>${escapeHtml(ban.bannedBy)}</td>
                    <td>
                        <button class="action-btn unban" onclick="unbanPlayer('${ban.playerId}')">ปลดแบน</button>
                    </td>
                </tr>
            `;
            $table.append(row);
        });
    }
    
    function updateStatsTable(stats) {
        const $table = $('#statsTable');
        $table.empty();

        const statList = Array.isArray(stats) ? [...stats] : [];
        pruneSelection(dashboardState.stats.selectedIds, new Set(statList.map(stat => stat.playerId)));
        // แสดง/ซ่อนปุ่ม Clear All และปุ่มปิด Season
        if (statList.length > 0) {
            $('#clearAllStatsBtn').show();
            $('#resetSeasonBtn').show();
        } else {
            $('#clearAllStatsBtn').hide();
            $('#resetSeasonBtn').hide();
        }
        
        if (statList.length === 0) {
            $table.html('<tr><td colspan="11" class="empty-message">ไม่มีข้อมูลสถิติ</td></tr>');
            $('#statsTableMeta').text('ไม่มีข้อมูลสถิติ');
            $('#selectAllStats').prop('checked', false);
            updateSelectedStatsCount();
            return;
        }

        statList.sort(function(a, b) {
            const winRateA = a.totalGames > 0 ? Math.round((a.wins / a.totalGames) * 100) : 0;
            const winRateB = b.totalGames > 0 ? Math.round((b.wins / b.totalGames) * 100) : 0;
            let valA;
            let valB;
            switch (dashboardState.stats.sortCol) {
                case 'name':
                    valA = (a.playerName || '').toLowerCase();
                    valB = (b.playerName || '').toLowerCase();
                    break;
                case 'wins':
                    valA = Number(a.wins || 0);
                    valB = Number(b.wins || 0);
                    break;
                case 'losses':
                    valA = Number(a.losses || 0);
                    valB = Number(b.losses || 0);
                    break;
                case 'winRate':
                    valA = winRateA;
                    valB = winRateB;
                    break;
                case 'games':
                default:
                    valA = Number(a.totalGames || 0);
                    valB = Number(b.totalGames || 0);
                    break;
            }
            return compareValues(valA, valB, dashboardState.stats.sortDir)
                || compareValues((a.playerName || '').toLowerCase(), (b.playerName || '').toLowerCase(), 'asc');
        });

        const filteredStats = statList.filter(function(stat) {
            const search = dashboardState.stats.search.trim().toLowerCase();
            const modeFilter = dashboardState.stats.modeFilter;
            const haystack = `${stat.playerName || ''} ${stat.playerId || ''}`.toLowerCase();
            const hasInsider = Number(stat.modeStats?.insider?.games || 0) > 0;
            const hasWerewolf = Number(stat.modeStats?.werewolf?.games || 0) > 0;
            const hasBlackMarket = Number(stat.modeStats?.blackmarket?.games || 0) > 0;
            const hasSpyfall = Number(stat.modeStats?.spyfall?.games || 0) > 0;
            const hasCoup = Number(stat.modeStats?.coup?.games || 0) > 0;
            const hasLiar = Number(stat.modeStats?.liar?.games || 0) > 0;
            const hasPoker5 = Number(stat.modeStats?.poker5?.games || 0) > 0;
            const hasPoker4 = Number(stat.modeStats?.poker4?.games || 0) > 0;
            const matchesSearch = !search || haystack.includes(search);
            const matchesMode = modeFilter === 'all'
                || (modeFilter === 'has-insider' && hasInsider)
                || (modeFilter === 'has-werewolf' && hasWerewolf)
                || (modeFilter === 'has-blackmarket' && hasBlackMarket)
                || (modeFilter === 'has-spyfall' && hasSpyfall)
                || (modeFilter === 'has-coup' && hasCoup)
                || (modeFilter === 'has-liar' && hasLiar)
                || (modeFilter === 'has-poker5' && hasPoker5)
                || (modeFilter === 'has-poker4' && hasPoker4);
            return matchesSearch && matchesMode;
        });

        if (filteredStats.length === 0) {
            $table.html('<tr><td colspan="11" class="empty-message">ไม่พบข้อมูลสถิติที่ตรงเงื่อนไข</td></tr>');
            $('#statsTableMeta').text(`แสดง 0 จาก ${statList.length} รายการ`);
            $('#selectAllStats').prop('checked', false);
            updateSelectedStatsCount();
            return;
        }

        filteredStats.forEach(function(stat) {
            const winRate = stat.totalGames > 0 ? Math.round((stat.wins / stat.totalGames) * 100) : 0;
            const row = `
                <tr data-player-id="${stat.playerId}">
                    <td><input type="checkbox" class="stat-checkbox" data-player-id="${stat.playerId}" data-player-name="${escapeHtml(stat.playerName || 'Unknown')}" ${dashboardState.stats.selectedIds.has(stat.playerId) ? 'checked' : ''}></td>
                    <td>${escapeHtml(stat.playerName || 'Unknown')}</td>
                    <td>${stat.totalGames || 0}</td>
                    <td style="color: #2ecc71;">${stat.wins || 0}</td>
                    <td style="color: #e74c3c;">${stat.losses || 0}</td>

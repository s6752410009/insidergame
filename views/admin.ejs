                    </select>
                    <button class="btn-admin btn-danger" onclick="clearLogs()">🗑️ ล้าง Logs</button>
                    <button class="btn-admin btn-success" onclick="exportLogs()">📥 Export</button>
                </div>
            </div>
            <div id="logsContainer" style="max-height: 500px; overflow-y: auto; background: #0a0a0a; border-radius: 8px; padding: 15px; font-family: 'Consolas', monospace; font-size: 0.85em;">
                <div class="empty-message">Logs จะแสดงที่นี่เมื่อมีกิจกรรม...</div>
            </div>

    // ========== Room Chat (admin spectator) ==========
    // Holds the transcript of the room whose details modal is currently open,
    // so live `adminRoomChat` events can be appended without a refetch.
    const openRoomChat = { roomId: null, messages: [], filter: 'all' };
    const CHAT_TYPE_STYLES = {
        'player':    { color: '#e8e8e8', badge: null },
        'wolf-team': { color: '#ffb3ab', badge: '🐺 หมาป่า' },
        'presence':  { color: '#7f8c8d', badge: null },
        'admin':     { color: '#bb8fce', badge: '👑' },
        'phase':     { color: '#5dade2', badge: null },
        'system':    { color: '#95a5a6', badge: null }
    };

    function isChatFromPlayer(entry) {
        return entry.messageType === 'player' || entry.messageType === 'wolf-team';
    }

    // Player messages are HTML-escaped server-side before storage. Decode once so
    // the admin reads the original text; escapeHtml() re-escapes it at render time.
    function decodeChatMessage(raw) {
        return String(raw || '')
            .replace(/&lt;/g, '<')
            .replace(/&gt;/g, '>')
            .replace(/&quot;/g, '"')
            .replace(/&#0?39;/g, "'")
            .replace(/&amp;/g, '&');
    }

    function getFilteredRoomChat() {
        if (openRoomChat.filter === 'players') {
            return openRoomChat.messages.filter(isChatFromPlayer);
        }
        if (openRoomChat.filter === 'system') {
            return openRoomChat.messages.filter(entry => !isChatFromPlayer(entry));
        }
        return openRoomChat.messages;
    }

    function formatRoomChatEntry(entry) {
        const style = CHAT_TYPE_STYLES[entry.messageType] || CHAT_TYPE_STYLES.system;
        const isWolfChannel = entry.channel === 'werewolf';
        const name = escapeHtml(entry.displayName || entry.playerName || '?');
        const nameColor = isChatFromPlayer(entry) ? (entry.color || '#e8e8e8') : style.color;
        const badge = style.badge
            ? `<span style="margin-left:6px; padding:0 6px; border-radius:999px; font-size:0.72em; background:rgba(231,76,60,0.18); color:#ffb3ab;">${style.badge}</span>`
            : '';
        const replyTo = entry.replyTo
            ? `<div style="border-left:2px solid #555; padding-left:6px; margin:2px 0 3px; color:#888; font-size:0.78em;">↩ ${escapeHtml(entry.replyTo.playerName || '')}: ${escapeHtml(decodeChatMessage(entry.replyTo.message))}</div>`
            : '';

        return `
            <div style="padding:6px 8px; border-radius:6px; margin-bottom:4px; background:${isWolfChannel ? 'rgba(192,57,43,0.12)' : '#222'};">
                <div style="display:flex; align-items:center; gap:6px; font-size:0.8em; color:#888;">
                    <span>${escapeHtml(entry.avatar || '👤')}</span>
                    <strong style="color:${nameColor};">${name}</strong>
                    ${entry.isSiteAdmin ? '<span title="Site Admin">👑</span>' : ''}
                    ${badge}
                    <span style="margin-left:auto;">${escapeHtml(entry.timestamp || '')}</span>
                </div>
                ${replyTo}
                <div style="color:${style.color}; font-size:0.92em; word-break:break-word; white-space:pre-wrap;">${escapeHtml(decodeChatMessage(entry.message))}</div>
            </div>
        `;
    }

    function renderRoomChat(keepScroll = false) {
        const container = document.getElementById('adminRoomChatBody');
        if (!container) return;

        const wasNearBottom = !keepScroll
            || (container.scrollHeight - container.scrollTop - container.clientHeight) < 60;
        const filtered = getFilteredRoomChat();

        container.innerHTML = filtered.length
            ? filtered.map(formatRoomChatEntry).join('')
            : '<div style="color:#888; text-align:center; padding:12px;">ยังไม่มีข้อความในห้องนี้</div>';

        if (wasNearBottom) {
            container.scrollTop = container.scrollHeight;
        }

        const counter = document.getElementById('adminRoomChatCount');
        if (counter) counter.textContent = `${filtered.length} ข้อความ`;
    }

    window.setRoomChatFilter = function(filter, btn) {
        openRoomChat.filter = filter;
        document.querySelectorAll('.room-chat-filter').forEach(el => {
            el.style.background = el === btn ? '#8e7cff' : '#333';
            el.style.color = el === btn ? '#fff' : '#bbb';
        });
        renderRoomChat();
    };

    // Live feed: append messages for the room whose modal is open
    socket.on('adminRoomChat', function(entry) {
        if (!entry || entry.roomId !== openRoomChat.roomId) return;
        openRoomChat.messages.push(entry);
        if (openRoomChat.messages.length > 300) openRoomChat.messages.shift();
        renderRoomChat(true);
    });

    // ========== Room Details ==========
    window.viewRoomDetails = function(roomId, roomName) {
        socket.emit('admin_getRoomDetails', { roomId }, function(res) {
            if (res.success) {
                const room = res.room;
                openRoomChat.roomId = roomId;
                openRoomChat.messages = Array.isArray(room.chatHistory) ? room.chatHistory.slice() : [];
                openRoomChat.filter = 'all';
                const playersHtml = room.players.length > 0 
                    ? room.players.map(p => `
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px; background: #222; border-radius: 6px; margin-bottom: 5px;">
                            <span>
                                <span style="display: inline-block; width: 12px; height: 12px; background: ${p.color}; border-radius: 50%; margin-right: 8px;"></span>
                                ${escapeHtml(p.name)}
                                ${p.isAdmin ? ' 👑' : ''}
                                ${p.role ? ` <small style="color: #888;">(${p.role})</small>` : ''}
                            </span>
                            <button class="action-btn kick" onclick="kickPlayerFromRoom('${roomId}', '${p.id}', '${escapeHtml(p.name)}')">เตะ</button>
                        </div>
                    `).join('') 
                    : '<div style="color: #888; text-align: center;">ไม่มีผู้เล่น</div>';
                
                Swal.fire({
                    title: `🏠 ${roomName}`,
                    html: `
                        <div style="text-align: left; color: #ddd;">

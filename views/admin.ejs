                        <select id="statsModeFilter" class="search-box" style="width: auto;">
                            <option value="all">ทุกโหมด</option>
                            <option value="has-insider">มี Insider</option>
                            <option value="has-werewolf">มี Werewolf</option>
                            <option value="has-blackmarket">มี Black Market</option>
                            <option value="has-spyfall">มี Spyfall</option>
                            <option value="has-coup">มี Coup</option>
                            <option value="has-liar">มีไพ่โกหก</option>

        const message = $('#broadcastMessage').val().trim();
        if (!message) {
            Swal.fire({ icon: 'warning', title: 'กรุณาพิมพ์ข้อความ', background: '#1e1e1e', color: '#fff' });
            return;
        }
        
        socket.emit('admin_broadcast', { message }, function(res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: 'ส่งประกาศสำเร็จ', timer: 1500, showConfirmButton: false, background: '#1e1e1e', color: '#fff' });
                $('#broadcastMessage').val('');
            }
        });
    };
    
    window.exportStats = function() {
        if (!allData.playerStats) return;
        
        const roleHeaders = WEREWOLF_ROLE_META.map(role => `${role.label} Count`).join(',');
        let csv = `Player Name,Total Games,Wins,Losses,Win Rate,Insider Games,Insider Wins,Insider Losses,Werewolf Games,Werewolf Wins,Werewolf Losses,GM Count,Traitor Count,Citizen Count,${roleHeaders}\n`;
        allData.playerStats.forEach(s => {
            const winRate = s.totalGames > 0 ? Math.round((s.wins / s.totalGames) * 100) : 0;
            const werewolfCounts = WEREWOLF_ROLE_META.map(role => s.roleStats?.werewolf?.[role.id] || 0).join(',');
            csv += `"${s.playerName}",${s.totalGames || 0},${s.wins || 0},${s.losses || 0},${winRate}%,${s.modeStats?.insider?.games || 0},${s.modeStats?.insider?.wins || 0},${s.modeStats?.insider?.losses || 0},${s.modeStats?.werewolf?.games || 0},${s.modeStats?.werewolf?.wins || 0},${s.modeStats?.werewolf?.losses || 0},${s.roleStats?.gameMasterCount || 0},${s.roleStats?.traitorCount || 0},${s.roleStats?.citizenCount || 0},${werewolfCounts}\n`;
        });
        
        downloadCSV(csv, 'player_stats.csv');
    };
    
    window.exportAllData = function() {
        const dataStr = JSON.stringify(allData, null, 2);
        const blob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'insider_game_data_' + new Date().toISOString().slice(0,10) + '.json';
        a.click();
    };
    
    function downloadCSV(csv, filename) {
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
    }
    
    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return String(text).replace(/[&<>"']/g, m => map[m]);
    }
    
    // ========== Bulk Selection Functions ==========
    
    window.toggleSelectAllPlayers = function(checkbox) {
        $('.player-checkbox').prop('checked', checkbox.checked);
        updateSelectedPlayersCount();
    };
    
    window.updateSelectedPlayersCount = function() {
        const selectedCount = $('.player-checkbox:checked').length;
        $('#selectedPlayerCount').text(selectedCount);
        
        if (selectedCount > 0) {
            $('#btnDeleteSelected').show();
        } else {
            $('#btnDeleteSelected').hide();
        }
    };
    
    window.deleteSelectedPlayers = function() {
        const selectedCheckboxes = $('.player-checkbox:checked');
        const count = selectedCheckboxes.length;
        
        if (count === 0) {
            Swal.fire({ icon: 'warning', title: 'กรุณาเลือกผู้เล่น', background: '#1e1e1e', color: '#fff' });
            return;
        }
        
        const playerIds = [];
        const playerNames = [];
        selectedCheckboxes.each(function() {
            playerIds.push($(this).data('player-id'));
            playerNames.push($(this).data('player-name'));
        });
        
        Swal.fire({
            title: '🗑️ ลบผู้เล่นที่เลือก',
            html: `ต้องการลบ <strong>${count}</strong> คน?<br><br>
                   <div style="max-height: 150px; overflow-y: auto; text-align: left; background: #111; padding: 10px; border-radius: 8px; font-size: 0.9em;">
                   ${playerNames.map(n => `• ${n}`).join('<br>')}
                   </div>
                   <br><small style="color:#e74c3c;">การดำเนินการนี้ไม่สามารถย้อนกลับได้!</small>`,
            showCancelButton: true,
            confirmButtonText: `ลบ ${count} คน`,
            cancelButtonText: 'ยกเลิก',
            confirmButtonColor: '#e74c3c',
            background: '#1e1e1e',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                socket.emit('admin_bulkDeletePlayers', { playerIds }, function(res) {
                    if (res.success) {
                        Swal.fire({ 
                            icon: 'success', 
                            title: `ลบสำเร็จ ${res.deletedCount} คน`, 
                            timer: 2000, 
                            showConfirmButton: false, 
                            background: '#1e1e1e', 
                            color: '#fff' 
                        });
                        loadData();
                    } else {
                        Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
                    }
                });
            }
        });
    };

    function filterPlayersTable() {
        const search = ($('#searchPlayers').val() || '').toLowerCase();
        const typeFilter = $('#playerTypeFilter').val() || 'all';
        let visibleCount = 0;

        $('#playersTable tr').each(function() {
            const $row = $(this);
            const text = $row.text().toLowerCase();
            const category = $row.data('player-category');
            const matchesSearch = text.includes(search);
            const matchesType = typeFilter === 'all' || category === typeFilter;
            const isVisible = matchesSearch && matchesType;

            $row.toggle(isVisible);
            if (isVisible) visibleCount++;
        });

        if (visibleCount === 0 && $('#playersTable tr').length > 0) {
            if ($('#playersTable tr.filter-empty-row').length === 0) {
                $('#playersTable').append('<tr class="filter-empty-row"><td colspan="8" class="empty-message">ไม่พบผู้เล่นที่ตรงเงื่อนไข</td></tr>');
            }
        } else {
            $('#playersTable tr.filter-empty-row').remove();
        }
    }

    function askCleanupAgeHours(defaultValue) {
        return Swal.fire({
            title: 'กำหนดอายุขั้นต่ำของ ghost',
            html: `
                <p style="color:#aaa;">ระบบจะลบเฉพาะ guest อัตโนมัติที่ไม่เคยเล่น, ไม่อยู่ในห้อง, ไม่ถูกแบน และใช้โปรไฟล์ default</p>
                <select id="cleanupAgeHours" class="swal2-select" style="width:100%; padding:10px; border-radius:5px; background:#1a1a1a; color:#fff; border:1px solid #444;">
                    <option value="24" ${defaultValue === 24 ? 'selected' : ''}>เก่ากว่า 24 ชั่วโมง</option>
                    <option value="72" ${defaultValue === 72 ? 'selected' : ''}>เก่ากว่า 3 วัน</option>
                    <option value="168" ${defaultValue === 168 ? 'selected' : ''}>เก่ากว่า 7 วัน</option>
                    <option value="720" ${defaultValue === 720 ? 'selected' : ''}>เก่ากว่า 30 วัน</option>
                </select>
            `,
            showCancelButton: true,
            confirmButtonText: 'ต่อไป',
            cancelButtonText: 'ยกเลิก',
            background: '#1e1e1e',
            color: '#fff',
            preConfirm: () => parseInt(document.getElementById('cleanupAgeHours').value, 10)
        });
    }

    window.previewGhostCleanup = async function() {
        const result = await askCleanupAgeHours(24);
        if (!result.isConfirmed) return;

        socket.emit('admin_cleanupGhostPlayers', { minAgeHours: result.value, dryRun: true }, function(res) {
            if (!res.success) {
                Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
                return;
            }

            const candidates = res.candidates || [];
            const previewHtml = candidates.length > 0
                ? `<div style="max-height:220px; overflow-y:auto; text-align:left; background:#111; padding:10px; border-radius:8px;">${candidates.slice(0, 50).map(player => `<div style="padding:6px 0; border-bottom:1px solid #222;"><strong>${escapeHtml(player.playerName)}</strong> <span style="color:#666;">(${player.playerId.substring(0, 8)}...)</span><br><small style="color:#888;">lastSeen ${player.lastSeen ? new Date(player.lastSeen).toLocaleString('th-TH') : '-'} | อายุประมาณ ${Math.floor(player.ageHours || 0)} ชม.</small></div>`).join('')}</div>`
                : '<div style="color:#2ecc71;">ไม่พบ ghost player ที่เข้าเกณฑ์</div>';

            Swal.fire({
                title: `พรีวิว cleanup (${candidates.length} คน)`,
                html: previewHtml,
                confirmButtonText: 'ปิด',
                background: '#1e1e1e',
                color: '#fff',
                width: 640
            });
        });
    };

    window.runGhostCleanup = async function() {
        const ageResult = await askCleanupAgeHours(72);
        if (!ageResult.isConfirmed) return;

        Swal.fire({
            title: 'ยืนยัน cleanup ghost players',
            html: `จะลบ ghost/auto-generated player ที่เก่ากว่า <strong>${ageResult.value}</strong> ชั่วโมง และยังไม่เคยเล่นเกม`,
            showCancelButton: true,
            confirmButtonText: 'ลบเลย',
            cancelButtonText: 'ยกเลิก',
            confirmButtonColor: '#e74c3c',
            background: '#1e1e1e',
            color: '#fff'
        }).then((confirmResult) => {
            if (!confirmResult.isConfirmed) return;

            socket.emit('admin_cleanupGhostPlayers', { minAgeHours: ageResult.value, dryRun: false }, function(res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: `ล้าง ghost สำเร็จ ${res.deletedCount} คน`,
                        timer: 1800,
                        showConfirmButton: false,
                        background: '#1e1e1e',
                        color: '#fff'
                    });
                    loadData();
                } else {
                    Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
                }
            });
        });
    };
    
    window.deleteAllPlayers = function() {
        const totalPlayers = (allData.players || []).length;
        
        Swal.fire({
            title: '💥 ลบผู้เล่นทั้งหมด',
            html: `<span style="color:#e74c3c; font-size: 1.2em;">⚠️ คำเตือน!</span><br><br>
                   ต้องการลบผู้เล่นทั้งหมด <strong>${totalPlayers}</strong> คน?<br><br>
                   <small style="color:#e74c3c;">การดำเนินการนี้ไม่สามารถย้อนกลับได้!<br>ข้อมูลทั้งหมดจะหายไป!</small>`,
            showCancelButton: true,
            confirmButtonText: '💥 ยืนยันลบทั้งหมด',
            cancelButtonText: 'ยกเลิก',
            confirmButtonColor: '#e74c3c',
            background: '#1e1e1e',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                socket.emit('admin_deleteAllPlayers', {}, function(res) {
                    if (res.success) {
                        Swal.fire({ 
                            icon: 'success', 
                            title: `ลบทั้งหมด ${res.deletedCount} คน`, 
                            timer: 2000, 
                            showConfirmButton: false, 
                            background: '#1e1e1e', 
                            color: '#fff' 
                        });
                        loadData();
                    } else {
                        Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
                    }
                });
            }
        });
    };
    
    // ========== Room Details ==========
    window.viewRoomDetails = function(roomId, roomName) {
        socket.emit('admin_getRoomDetails', { roomId }, function(res) {
            if (res.success) {
                const room = res.room;
                const playersHtml = room.players.length > 0 
                    ? room.players.map(p => `
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px; background: #222; border-radius: 6px; margin-bottom: 5px;">
                            <span>
                                <span style="display: inline-block; width: 12px; height: 12px; background: ${p.color}; border-radius: 50%; margin-right: 8px;"></span>
                                ${escapeHtml(p.name)}
                                ${p.isAdmin ? ' 👑' : ''}
                                ${p.role ? ` <small style="color: #888;">(${p.role})</small>` : ''}
                            </span>
                            <button class="action-btn kick" onclick="kickPlayerFromRoom('${roomId}', '${p.id}', '${escapeHtml(p.name)}')">เตะ</button>
                        </div>
                    `).join('') 
                    : '<div style="color: #888; text-align: center;">ไม่มีผู้เล่น</div>';
                
                Swal.fire({
                    title: `🏠 ${roomName}`,
                    html: `
                        <div style="text-align: left; color: #ddd;">
                            <p><strong>Room ID:</strong> <code>${roomId}</code></p>
                            <p><strong>โหมด:</strong> ${(room.gameMode || room.settings?.gameMode) === 'werewolf' ? '🐺 Werewolf' : '🎯 Insider'}</p>
                            <p><strong>สถานะ:</strong> ${room.gameStatus === 'playing' ? '🎮 กำลังเล่น' : '⏳ รอผู้เล่น'}</p>
                            <p><strong>Phase:</strong> ${room.gamePhase || '-'}</p>
                            <p><strong>ล็อค:</strong> ${room.locked ? '🔒 ล็อค' : '🔓 ไม่ล็อค'}</p>
                            <p><strong>คำปัจจุบัน:</strong> ${room.currentWord || '-'}</p>
                            <hr style="border-color: #444; margin: 15px 0;">
                            <p><strong>ผู้เล่น (${room.players.length}/${room.maxPlayers}):</strong></p>
                            <div style="max-height: 200px; overflow-y: auto;">
                                ${playersHtml}
                            </div>
                        </div>
                    `,
                    width: 500,
                    background: '#1e1e1e',
                    color: '#fff',
                    showConfirmButton: true,
                    confirmButtonText: 'ปิด'
                });
            } else {
                Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
            }
        });
    };
    
    window.kickPlayerFromRoom = function(roomId, playerId, playerName) {
        socket.emit('admin_kickPlayerFromRoom', { roomId, playerId }, function(res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: `เตะ ${playerName} สำเร็จ`, timer: 1500, showConfirmButton: false, background: '#1e1e1e', color: '#fff' });
                // Refresh room details
                Swal.close();
                loadData();
            } else {
                Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
            }
        });
    };
    
    // ========== Logs Functions ==========
    let serverLogs = [];
    
    // Load existing logs from server
    function loadLogs() {
        const filter = $('#logFilter').val();
        socket.emit('admin_getLogs', { filter: filter, limit: 200 }, function(response) {
            if (response.success) {
                serverLogs = response.logs || [];
                renderLogs();
            }
        });
    }
    
    // Receive new log entries in real-time
    socket.on('adminLog', function(logEntry) {
        serverLogs.unshift(logEntry);
        if (serverLogs.length > 500) serverLogs.length = 500;
        renderLogs();
    });
    
    function renderLogs() {
        const filter = $('#logFilter').val();
        const filtered = filter === 'all' ? serverLogs : serverLogs.filter(l => l.category === filter);
        
        const $container = $('#logsContainer');
        if (filtered.length === 0) {
            $container.html('<div class="empty-message">ไม่มี Logs</div>');
            return;
        }
        
        const colors = {
            'join': '#2ecc71',
            'leave': '#e74c3c', 
            'game': '#3498db',
            'admin': '#9b59b6',
            'error': '#ff6b6b',
            'chat': '#f39c12',
            'system': '#95a5a6'
        };
        const typeColors = {
            'info': '#3498db',
            'success': '#2ecc71',
            'warning': '#f39c12',
            'error': '#e74c3c'
        };
        const icons = {
            'join': '➡️',
            'leave': '⬅️',
            'game': '🎮',
            'admin': '👑',
            'error': '❌',
            'chat': '💬',
            'system': '⚙️'
        };
        
        $container.html(filtered.map(log => {
            const time = new Date(log.timestamp).toLocaleTimeString('th-TH');
            const color = typeColors[log.type] || colors[log.category] || '#fff';
            const icon = icons[log.category] || '•';
            const roomInfo = log.roomName ? `<span style="color: #888;">[${log.roomName}]</span> ` : '';
            const modeBadge = log.gameMode
                ? `<span style="display:inline-flex; align-items:center; gap:4px; margin-right:6px; padding:1px 7px; border-radius:999px; background:${log.gameMode === 'werewolf' ? 'rgba(192,57,43,0.2)' : 'rgba(52,152,219,0.18)'}; color:${log.gameMode === 'werewolf' ? '#ffd5d0' : '#d6ebff'}; font-size:0.75em; font-weight:700;">${log.gameMode === 'werewolf' ? '🐺 Werewolf' : '🎯 Insider'}</span>`
                : '';
            return `<div style="margin-bottom: 6px; padding: 4px 8px; border-left: 3px solid ${color}; background: rgba(255,255,255,0.03);">
                <span style="color: #666;">[${time}]</span> ${icon} ${modeBadge}${roomInfo}<span style="color: ${color};">${log.message}</span>
            </div>`;
        }).join(''));
        
        // Auto scroll to top (newest)
        $container.scrollTop(0);
    }
    
    $('#logFilter').on('change', function() {
        loadLogs();
    });
    
    window.clearLogs = function() {
        Swal.fire({
            title: '🗑️ ล้าง Logs',
            text: 'ต้องการล้าง Logs ทั้งหมด?',
            showCancelButton: true,
            confirmButtonText: 'ล้าง',
            cancelButtonText: 'ยกเลิก',
            confirmButtonColor: '#e74c3c',
            background: '#1e1e1e',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                socket.emit('admin_clearLogs', function(response) {
                    if (response.success) {
                        serverLogs = [];
                        renderLogs();
                        Swal.fire({ icon: 'success', title: 'ล้าง Logs สำเร็จ', timer: 1000, showConfirmButton: false, background: '#1e1e1e', color: '#fff' });
                    }
                });
            }
        });
    };
    
    window.exportLogs = function() {
        if (serverLogs.length === 0) {
            Swal.fire({ icon: 'warning', title: 'ไม่มี Logs', background: '#1e1e1e', color: '#fff' });
            return;
        }
        const logsText = serverLogs.map(l => {
            const time = new Date(l.timestamp).toLocaleString('th-TH');
            const modeLabel = l.gameMode ? `[${l.gameMode.toUpperCase()}] ` : '';
            return `[${time}] [${l.category.toUpperCase()}] ${modeLabel}${l.roomName ? '[' + l.roomName + '] ' : ''}${l.message}`;
        }).join('\n');
        const blob = new Blob([logsText], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'server_logs_' + new Date().toISOString().slice(0,10) + '.txt';
        a.click();
    };
    
    // Load logs after authentication
    socket.on('connect', function() {
        if (isAuthenticated) {
            loadLogs();
        }
    });
    
    // ========== Settings Functions ==========
    window.saveGameSettings = function() {
        const settings = {
            defaultTimer: parseInt($('#defaultTimer').val()),
            minPlayers: parseInt($('#minPlayers').val()),
            maxPlayers: parseInt($('#maxPlayers').val()),
            wordCategory: $('#wordCategory').val()
        };
        
        socket.emit('admin_saveSettings', settings, function(res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: 'บันทึกการตั้งค่าสำเร็จ', timer: 1500, showConfirmButton: false, background: '#1e1e1e', color: '#fff' });
            } else {
                Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
            }
        });
    };
    
    window.addWords = function() {
        const wordsText = $('#newWords').val().trim();
        if (!wordsText) {
            Swal.fire({ icon: 'warning', title: 'กรุณาพิมพ์คำที่ต้องการเพิ่ม', background: '#1e1e1e', color: '#fff' });
            return;
        }
        
        const words = wordsText.split(',').map(w => w.trim()).filter(w => w);
        socket.emit('admin_addWords', { words }, function(res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: `เพิ่ม ${res.addedCount} คำสำเร็จ`, timer: 1500, showConfirmButton: false, background: '#1e1e1e', color: '#fff' });
                $('#newWords').val('');
            } else {
                Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
            }
        });
    };
    
    window.viewWords = function() {
        socket.emit('admin_getWords', {}, function(res) {
            if (res.success) {
                Swal.fire({
                    title: '📝 คำในเกมทั้งหมด',
                    html: `
                        <div style="max-height: 400px; overflow-y: auto; text-align: left; background: #111; padding: 15px; border-radius: 8px;">
                            <p style="color: #888; margin-bottom: 10px;">รวม ${res.words.length} คำ</p>
                            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                ${res.words.map(w => `<span style="background: #333; padding: 4px 10px; border-radius: 15px; font-size: 0.9em;">${escapeHtml(w)}</span>`).join('')}
                            </div>
                        </div>
                    `,
                    width: 600,
                    background: '#1e1e1e',
                    color: '#fff',
                    showConfirmButton: true,
                    confirmButtonText: 'ปิด'
                });
            } else {
                Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.error, background: '#1e1e1e', color: '#fff' });
            }
        });
    };
    
    // Listen for real-time events
    socket.on('admin_log', function(data) {
        addLog(data.type, data.message);
    });
    
    // Load initial data
    loadData();
    
    // Auto refresh every 15 seconds
    setInterval(loadData, 15000);
    
    // Update server time every second
    setInterval(() => {
        $('#serverTime').text(new Date().toLocaleString('th-TH'));
    }, 1000);
});
</script>

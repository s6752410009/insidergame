        $('#statsTableMeta').text(`แสดง ${filteredStats.length} จาก ${statList.length} รายการ`);
        $('#statsTable .stat-checkbox').on('change', function() {
            const playerId = $(this).data('player-id');
            if ($(this).is(':checked')) {
                dashboardState.stats.selectedIds.add(playerId);
            } else {
                dashboardState.stats.selectedIds.delete(playerId);
            }
            updateSelectedStatsCount();
        });
        updateSelectedStatsCount();
        const visibleCheckboxes = $('#statsTable .stat-checkbox');
        $('#selectAllStats').prop('checked', visibleCheckboxes.length > 0 && visibleCheckboxes.filter(':checked').length === visibleCheckboxes.length);
    }
    

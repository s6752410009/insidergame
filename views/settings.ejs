<%- contentFor('script') %>
<script>
$(function() {
    // Safe localStorage wrapper
    const Storage = {
        get(key, defaultValue = {}) {
            try {
                const item = localStorage.getItem(key);
                return item ? JSON.parse(item) : defaultValue;
            } catch (e) {
                console.warn('localStorage read error:', e);
                return defaultValue;
            }
        },
        set(key, value) {
            try {
                localStorage.setItem(key, JSON.stringify(value));
                return true;
            } catch (e) {
                console.warn('localStorage write error:', e);
                return false;
            }
        }
    };

    const toastEl = document.getElementById('stToast');
    let toastTimer = null;
    function toast(text) {
        toastEl.textContent = text;
        toastEl.classList.add('is-on');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function() { toastEl.classList.remove('is-on'); }, 1600);
    }

    let selectedTheme = Storage.get('gameSettings', {}).theme || 'default';

    function normalizeTheme(theme) {
        const allowed = ['default', 'dark', 'red', 'white'];
        return allowed.includes(theme) ? theme : 'default';
    }

    // Load settings from localStorage
    function loadSettings() {
        const settings = Storage.get('gameSettings', {});
        $('#confirmLeaveToggle').prop('checked', settings.confirmLeave !== false);
        selectedTheme = normalizeTheme(settings.theme || 'default');
        updateThemeUI();
        applyTheme(selectedTheme);
    }

    // Save settings to localStorage (same shape as before: { confirmLeave, theme })
    function saveSettings() {
        const ok = Storage.set('gameSettings', {
            confirmLeave: $('#confirmLeaveToggle').is(':checked'),
            theme: selectedTheme
        });
        applyTheme(selectedTheme);
        toast(ok ? '✓ บันทึกแล้ว' : 'บันทึกไม่ได้ (เบราว์เซอร์บล็อกที่เก็บข้อมูล)');
    }

    // Apply theme to page (use documentElement for html tag)
    function applyTheme(theme) {
        const normalized = normalizeTheme(theme);
        document.documentElement.classList.remove('theme-default', 'theme-dark', 'theme-red', 'theme-white');
        if (normalized !== 'default') {
            document.documentElement.classList.add('theme-' + normalized);
        }
        try {
            localStorage.setItem('currentTheme', normalized);
        } catch (e) {
            console.warn('currentTheme write error:', e);
        }
    }

    function updateThemeUI() {
        $('.theme-option').each(function() {
            const on = $(this).data('theme') === selectedTheme;
            $(this).toggleClass('active', on).find('input').prop('checked', on);
        });
    }

    $('.theme-option input').on('change', function() {
        selectedTheme = normalizeTheme(this.value);
        updateThemeUI();
        saveSettings();
    });

    $('#confirmLeaveToggle').on('change', saveSettings);

    // Reset settings
    $('#resetSettings').on('click', function() {
        Swal.fire({
            title: 'รีเซ็ตการตั้งค่า?',
            text: 'คืนค่าทุกอย่างเป็นค่าเริ่มต้น',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e2493b',
            cancelButtonColor: '#666',
            confirmButtonText: 'รีเซ็ต',
            cancelButtonText: 'ยกเลิก',
            background: '#1e1e1e',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                try {
                    localStorage.removeItem('gameSettings');
                    localStorage.removeItem('currentTheme');
                } catch (e) {}
                selectedTheme = 'default';
                loadSettings();
                toast('✓ คืนค่าเริ่มต้นแล้ว');
            }
        });
    });

    // Copy Line ID
    $('#copyLineBtn').on('click', function() {
        const id = this.getAttribute('data-line');
        const done = function() { toast('คัดลอก Line ID: ' + id + ' แล้ว'); };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(id).then(done, function() { toast('Line ID: ' + id); });
        } else {
            toast('Line ID: ' + id);
        }
    });

    // Sync settings across tabs
    $(window).on('storage', function(e) {
        if (e.originalEvent.key === 'gameSettings') {
            loadSettings();
        }
    });

    loadSettings();
});
</script>
